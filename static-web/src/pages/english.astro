---
import Base from '../layouts/Base.astro';
import { loadWritingLearningProjection } from '../lib/englishWritingLearning.mjs';
const writingGuide = loadWritingLearningProjection();
if(writingGuide.status !== 'ready') throw new Error('CURRENT_WRITING_GUIDE_NOT_READY');
import SiteResume from '../components/SiteResume.astro';
const base = import.meta.env.BASE_URL;
---
<Base
  title="English"
  objectId="english:performance-home"
  active="english"
>
  <section class="englishHub" data-english-hub data-base={base}>
    <SiteResume subject="english" />

    <div class="englishEntryFamilies">
      <section data-capability="objective"><h2>Objective</h2><p>全文与完整题组</p><nav><a href={`${base}reading/`}>Reading A →</a><a href={`${base}cloze/`}>Cloze →</a><a href={`${base}reading-b/`}>Part B →</a></nav><a class="guideLink" href={`${base}objective-learn/`}>Objective Guide</a></section>
      <section data-capability="translation"><h2>Translation</h2><p>原文与完整译文工作区</p><nav><a href={`${base}translation/`}>开始翻译 →</a></nav><a class="guideLink" href={`${base}translation-learn/`}>Translation Guide</a></section>
      <section data-capability="writing"><h2>Writing</h2><p>Small / Big · Direct / optional Plan</p><nav><a href={`${base}writing/`}>开始写作 →</a></nav><a class="guideLink" href={`${base}writing-learn/`}>Writing Guide</a></section>
    </div>
    <p class="englishLexicalEntry"><a href={`${base}vocabulary/`}>Lexical 查词 →</a></p>
  </section>
</Base>
