---
import Base from '../layouts/Base.astro';
import { loadWritingLearningProjection } from '../lib/englishWritingLearning.mjs';
const writingGuide = loadWritingLearningProjection();
if(writingGuide.status !== 'ready') throw new Error('CURRENT_WRITING_GUIDE_NOT_READY');
import SiteResume from '../components/SiteResume.astro';
const base = import.meta.env.BASE_URL;
---
<Base
  title="English"
  objectId="english:performance-home"
  active="english"
  showLead={false}
>
  <section class="englishHub englishHomeShell" id="english-home" data-english-hub data-base={base}>
    <header class="englishHomeHero">
      <div class="englishHomeHeroCopy">
        <span class="englishHomeEyebrow">EnglishOS · Current</span>
        <h1>English</h1>
        <p>Objective · Translation · Writing。完整任务几何保留；遇到真实问题再进入更深帮助。</p>
      </div>
      <aside class="englishHomeHeroMeta">
        <span>当前学习域</span>
        <strong>3 个任务族</strong>
        <small>Lexical 独立进入</small>
      </aside>
    </header>

    <nav class="englishHomeTabs" aria-label="English 学习导航">
      <a class="active" href="#english-home">总览</a>
      <a href="#objective">Objective</a>
      <a href="#translation">Translation</a>
      <a href="#writing">Writing</a>
    </nav>

    <div class="englishHomeGrid">
      <main class="englishHomeMain">
        <section class="englishHomePanel englishHomeContinue">
          <header>
            <div><span>继续学习</span><h2>返回未完成任务</h2></div>
            <small>只显示真实 Resume</small>
          </header>
          <SiteResume subject="english" />
          <p class="englishHomeResumeEmpty">当前没有需要 Resume 的 English 任务；直接从下方任务族进入。</p>
        </section>

        <div class="englishEntryFamilies">
          <section id="objective" data-capability="objective">
            <div class="englishEntryCopy"><span>01 · 客观题</span><h2>Objective</h2><p>全文与完整题组</p></div>
            <nav aria-label="Objective 入口"><a href={`${base}reading/`}>Reading A →</a><a href={`${base}cloze/`}>Cloze →</a><a href={`${base}reading-b/`}>Part B →</a></nav>
            <a class="guideLink" href={`${base}objective-learn/`}>Objective Guide</a>
          </section>
          <section id="translation" data-capability="translation">
            <div class="englishEntryCopy"><span>02 · 翻译</span><h2>Translation</h2><p>原文与完整译文工作区</p></div>
            <nav aria-label="Translation 入口"><a href={`${base}translation/`}>开始翻译 →</a></nav>
            <a class="guideLink" href={`${base}translation-learn/`}>Translation Guide</a>
          </section>
          <section id="writing" data-capability="writing">
            <div class="englishEntryCopy"><span>03 · 写作</span><h2>Writing</h2><p>Small / Big · Direct / optional Plan</p></div>
            <nav aria-label="Writing 入口"><a href={`${base}writing/`}>开始写作 →</a></nav>
            <a class="guideLink" href={`${base}writing-learn/`}>Writing Guide</a>
          </section>
        </div>
      </main>

      <aside class="englishHomeSide">
        <section class="englishHomeSidePanel">
          <header><div><span>学习参考</span><h2>Guides</h2></div></header>
          <div class="englishHomeGuideList">
            <a href={`${base}objective-learn/`}><span>01</span><div><b>Objective Guide</b><small>Reading A · Cloze · Part B</small></div><em>→</em></a>
            <a href={`${base}translation-learn/`}><span>02</span><div><b>Translation Guide</b><small>翻译方法与完整参考</small></div><em>→</em></a>
            <a href={`${base}writing-learn/`}><span>03</span><div><b>Writing Guide</b><small>Small / Big · Direct / Plan</small></div><em>→</em></a>
          </div>
        </section>

        <section class="englishHomeSidePanel englishHomeLexical">
          <header><div><span>LexicalOS</span><h2>查词与词汇 Repair</h2></div></header>
          <div class="englishHomeLexicalBody">
            <p>English 任务内只做 Current Lexical 的只读查阅；词汇 Repair、证据与记忆状态仍由 LexicalOS 自己负责。</p>
            <p class="englishLexicalEntry"><a href={`${base}vocabulary/`}>进入 Lexical →</a></p>
          </div>
        </section>
      </aside>
    </div>
  </section>
</Base>