---
import Base from '../layouts/Base.astro';
import { inspectReadingSources } from '../lib/current.mjs';
import { inspectTranslationSources } from '../lib/englishTranslation.mjs';
import { loadWritingLearningProjection } from '../lib/englishWritingLearning.mjs';
import { inspectWritingSyntheticTasks } from '../lib/englishWritingSynthetic.mjs';

const base = import.meta.env.BASE_URL;
const reading = inspectReadingSources();
const translation = inspectTranslationSources();
const writingLearning = loadWritingLearningProjection();
const writingRuntime = inspectWritingSyntheticTasks();

const statusLabel = (status) => status === 'ready' ? 'Ready' : status === 'invalid' ? 'Blocked' : 'Partial';
---
<Base
  title="English"
  kicker="English · Performance Runtime"
  description="English 只负责三条考试表现能力：Reading family / Translation / Writing。LexicalOS 是独立一级板块，通过最小 handoff 为 English 供能。"
  objectId="english:performance-home"
  active="english"
>
  <section class="englishHub" data-english-hub data-base={base}>
    <header class="englishOverview">
      <div>
        <span>Target · English I 80–85+</span>
        <h2>先把分拿到，再决定什么值得复盘。</h2>
        <p>主线是新任务上的稳定表现。一次失误只有在会影响未来正确率、速度或稳定性时，才值得升级成 repair / transfer debt。</p>
      </div>
      <aside>
        <span>Score map</span>
        <strong>60 · 10 · 30</strong>
        <small>Reading family · Translation · Writing</small>
      </aside>
    </header>

    <section class="englishResume" data-english-resume hidden>
      <div>
        <span>Highest-value next action</span>
        <strong data-english-resume-title></strong>
        <small data-english-resume-meta></small>
      </div>
      <a class="primaryLink" data-english-resume-link href={`${base}english/`}>继续 →</a>
    </section>

    <div class="englishCapabilityLayout">
      <main class="englishCapabilityMap">
        <header>
          <div><span>Performance map</span><h2>三条 English scoring lanes</h2></div>
          <p>题型不是一级导航；不同题型只有在认知对象不同、值得专门训练时才保留独立 workspace。</p>
        </header>

        <section class="englishCapabilityGroup" data-capability="reading">
          <div class="englishCapabilityLead">
            <span>01 · Reading family · 60 pts</span>
            <h3>把输入变成正确判断</h3>
            <p>representation → decisive evidence / constraints → judgment → execution</p>
          </div>
          <div class="englishCapabilityRoutes">
            <a href={`${base}reading/`}>
              <span>Primary</span><strong>Reading A</strong><small>{reading.readingA.ready} ready · 40 pts</small>
            </a>
            <a href={`${base}cloze/`}>
              <span>Trainer</span><strong>Cloze</strong><small>{reading.cloze.ready} ready · 10 pts</small>
            </a>
            <a href={`${base}reading-b/`}>
              <span>Trainer</span><strong>Part B</strong><small>{reading.readingB.ready} ready · 10 pts</small>
            </a>
          </div>
        </section>

        <section class="englishCapabilityGroup" data-capability="translation">
          <div class="englishCapabilityLead">
            <span>02 · Translation · 10 pts</span>
            <h3>理解以后，关系不丢地重建成中文</h3>
            <p>representation → relation preservation → reconstruction</p>
          </div>
          <div class="englishCapabilityRoutes one">
            <a href={`${base}translation/`}>
              <span>{statusLabel(translation.status)}</span><strong>Translation Runtime</strong><small>{translation.ready} ready · {translation.total} total</small>
            </a>
          </div>
        </section>

        <section class="englishCapabilityGroup" data-capability="writing">
          <div class="englishCapabilityLead">
            <span>03 · Writing · 30 pts</span>
            <h3>从任务约束主动生成可得分输出</h3>
            <p>task → content → structure → realization → control → timed delivery</p>
          </div>
          <div class="englishCapabilityRoutes one">
            <a href={`${base}writing/`}>
              <span>{statusLabel(writingRuntime.status)}</span><strong>Writing Runtime</strong><small>{writingRuntime.ready} synthetic tasks · learning {writingLearning.status}</small>
            </a>
          </div>
        </section>
      </main>

      <aside class="englishContextRail">
        <section class="englishContextCard lexicalSupply">
          <span>Independent supply lane</span>
          <strong>LexicalOS</strong>
          <p>词汇不是 English 的“第 4 条能力”。遇到真实 sense / construction / confusable 瓶颈时最小跳转，修完立即回原任务。</p>
          <a href={`${base}vocabulary/`}>进入 Vocabulary →</a>
        </section>

        <section class="englishContextCard">
          <span>Runtime rule</span>
          <strong>Perform → Triage → Exit / Repair</strong>
          <p>稳定就走；偶发且已理解的错不制造债。只有 recurring / high-cost / high-value failure 才升级深复盘。</p>
        </section>

        <section class="englishContextCard">
          <span>Review budget</span>
          <strong>复盘必须比错误更值钱</strong>
          <p>错因标签、证据片段、repair check、transfer claim 都只是升级工具，不是每题必须完成的流程。</p>
        </section>

        <details class="englishFirstLearning">
          <summary>First Learning / targeted intervention</summary>
          <div>
            <a href={`${base}objective-learn/`}><strong>Reading family</strong><span>只在真实表现暴露稳定缺口时调用</span></a>
            <a href={`${base}translation-learn/`}><strong>Translation</strong><span>representation / relation / reconstruction</span></a>
            <a href={`${base}writing-learn/`}><strong>Writing</strong><span>content / structure / generation</span></a>
          </div>
        </details>
      </aside>
    </div>
  </section>
</Base>

<script>
  const root = document.querySelector('[data-english-hub]');
  if (root instanceof HTMLElement) {
    const base = root.getAttribute('data-base') || '/';
    const resume = root.querySelector('[data-english-resume]');
    const title = root.querySelector('[data-english-resume-title]');
    const meta = root.querySelector('[data-english-resume-meta]');
    const link = root.querySelector('[data-english-resume-link]');

    const read = (key) => {
      try { return JSON.parse(localStorage.getItem(key) || 'null'); }
      catch { return null; }
    };
    const timestamp = (value) => Date.parse(value || '') || 0;
    const entries = [];

    const readingLast = read('kianos-reading-last-location-v1');
    if (readingLast?.id) {
      const attempt = read(`kianos-reading-attempt-v1:${readingLast.id}`) || {};
      const results = attempt.results || {};
      const uncertain = new Set(attempt.uncertain || []);
      const problems = Object.keys(results).filter((id) => ['wrong', 'unanswered'].includes(results[id]) || uncertain.has(id)).length;
      if (!attempt.submitted) {
        entries.push({ priority: 100, time: timestamp(readingLast.updatedAt || attempt.startedAt), title: readingLast.title || 'Reading A · unfinished attempt', meta: 'Reading · 继续 clean attempt', href: `${base}reading/${encodeURIComponent(readingLast.id)}/` });
      } else if (problems > 0 && attempt.reviewUnlocked !== false) {
        entries.push({ priority: 82, time: timestamp(attempt.submittedAt || readingLast.updatedAt), title: readingLast.title || 'Reading A · review', meta: `Reading · ${problems} 个真实 problem 等待 triage`, href: `${base}reading/${encodeURIComponent(readingLast.id)}/` });
      }
    }

    const translationLast = read('kianos-translation-last-location-v1');
    if (translationLast?.id) {
      const state = String(translationLast.stage || translationLast.state || '').toUpperCase();
      const priorities = {
        ATTEMPT: 100,
        DECISION: 86,
        DIAGNOSIS: 92,
        RECONSTRUCT: 96,
        TRANSFER_PENDING: 35
      };
      const priority = priorities[state] || 0;
      if (priority) entries.push({
        priority,
        time: timestamp(translationLast.updatedAt),
        title: translationLast.title || 'Translation',
        meta: state === 'TRANSFER_PENDING' ? 'Translation · later validation（低于当前 repair）' : `Translation · ${state.toLowerCase().replaceAll('_', ' ')}`,
        href: translationLast.href || `${base}translation/${encodeURIComponent(translationLast.id)}/`
      });
    }

    const writingLast = read('kianos-writing-last-location-v1');
    if (writingLast?.id) {
      const state = String(writingLast.state || '').toUpperCase();
      const priorities = {
        ATTEMPT: 100,
        REVIEW_PENDING: 90,
        REPAIR_NEEDED: 96,
        REPAIR_CHECK_PENDING: 86,
        TRANSFER_PENDING: 35
      };
      const priority = priorities[state] || 0;
      if (priority) entries.push({
        priority,
        time: timestamp(writingLast.updatedAt),
        title: writingLast.title || 'Writing',
        meta: state === 'TRANSFER_PENDING' ? 'Writing · later validation（不抢占当前 performance）' : `Writing · ${state.toLowerCase().replaceAll('_', ' ')}`,
        href: writingLast.href || `${base}writing/${encodeURIComponent(writingLast.id)}/`
      });
    }

    entries.sort((a, b) => b.priority - a.priority || b.time - a.time);
    const best = entries[0];
    if (best && resume && title && meta && link) {
      resume.hidden = false;
      title.textContent = best.title;
      meta.textContent = best.meta;
      link.href = best.href;
    }
  }
</script>