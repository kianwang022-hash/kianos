---
import Base from '../../../layouts/Base.astro';
import PoliticsChapterRuntime from '../../../components/PoliticsChapterRuntime.astro';
import PoliticsCognitiveWorkspace from '../../../components/PoliticsCognitiveWorkspace.astro';
import PoliticsCognitiveWorkspaceBridge from '../../../components/PoliticsCognitiveWorkspaceBridge.astro';
import PoliticsRepairEnhancer from '../../../components/PoliticsRepairEnhancer.astro';
import PoliticsUnitReturnEnhancer from '../../../components/PoliticsUnitReturnEnhancer.astro';
import { listPoliticsChapterPathsCurrent, loadPoliticsChapterCurrent } from '../../../lib/politicsCurrent.mjs';
import { enrichPoliticsChapterCurrent } from '../../../lib/politicsRepairMemory.mjs';

export function getStaticPaths() {
  return listPoliticsChapterPathsCurrent()
    .map((row) => ({ params: { subject: row.subject, chapter: row.chapter }, props: row }));
}

const { subject, chapter } = Astro.props;
const data = enrichPoliticsChapterCurrent(loadPoliticsChapterCurrent(subject, chapter));
const base = import.meta.env.BASE_URL;
const useCognitiveWorkspace = subject === 'marxism'
  && chapter === 'ch00'
  && data.units.some((unit) => unit?.raw?.learning_semantics?.schema === 'kianos.politics.learning_semantics.v1');
---
<Base
  title={data.title}
  kicker={`${data.subjectMeta.label} · ${data.subjectMeta.shape}`}
  description={data.subjectMeta.description}
  sourcePath={data.sourcePath}
  sourceHash={data.sourceHash}
  objectId={data.objectId}
  active="politics"
  showLead={!useCognitiveWorkspace}
>
  {useCognitiveWorkspace
    ? <PoliticsCognitiveWorkspace chapter={data} base={base} />
    : <PoliticsChapterRuntime chapter={data} base={base} />}
  {useCognitiveWorkspace && <PoliticsCognitiveWorkspaceBridge />}
  <PoliticsRepairEnhancer chapter={data} />
  <PoliticsUnitReturnEnhancer chapter={data} />
</Base>
