---
import PoliticsLayout from '../../../layouts/PoliticsLayout.astro';
import {
  loadPoliticsCompiledPresentation,
  loadPoliticsCompiledChapterContext
} from '../../../lib/politicsCompiledPresentation.mjs';
import PoliticsChapterPresentation from '../../../components/PoliticsChapterPresentation.astro';
import PoliticsChapterRuntime from '../../../components/PoliticsChapterRuntime.astro';
import PoliticsCognitiveWorkspace from '../../../components/PoliticsCognitiveWorkspace.astro';
import PoliticsVisibleTypeFloor from '../../../components/PoliticsVisibleTypeFloor.astro';
import PoliticsRepairEnhancer from '../../../components/PoliticsRepairEnhancer.astro';
import PoliticsUnitReturnEnhancer from '../../../components/PoliticsUnitReturnEnhancer.astro';
import PoliticsPracticeBridge from '../../../components/PoliticsPracticeBridge.astro';
import PoliticsEvidenceEnhancer from '../../../components/PoliticsEvidenceEnhancer.astro';
import { listPoliticsChapterPathsCurrent, loadPoliticsChapterCurrent } from '../../../lib/politicsCurrent.mjs';
import { enrichPoliticsChapterCurrent } from '../../../lib/politicsRepairMemory.mjs';

export function getStaticPaths() {
  return listPoliticsChapterPathsCurrent()
    .map((row) => ({ params: { subject: row.subject, chapter: row.chapter }, props: row }));
}

const { subject, chapter } = Astro.props;
const data = enrichPoliticsChapterCurrent(loadPoliticsChapterCurrent(subject, chapter));
const base = import.meta.env.BASE_URL;
const compiled = loadPoliticsCompiledPresentation(subject, chapter);
const chapterContext = loadPoliticsCompiledChapterContext(subject, chapter);
const useCognitiveWorkspace = subject === 'marxism' && chapter === 'ch00';
---
<style is:global>
  /* Existing accepted C00 calibration; visual redesign stays behind Human Gate. */
  .politicsCognitiveWorkspace.directReasoningWorkspace[data-subject="marxism"][data-chapter="ch00"] [data-stage="ORIENT"] > h2 {
    font-size: clamp(32px, 2.45vw, 39px) !important;
  }
</style>

<PoliticsLayout
  title={data.title}
  kicker={`${data.subjectMeta.label} · ${data.subjectMeta.shape}`}
  description={data.subjectMeta.description}
  sourcePath={data.sourcePath}
  sourceHash={data.sourceHash}
  objectId={data.objectId}
  active="politics"
  showLead={false}
>
  <PoliticsPracticeBridge chapter={data} base={base} />

  <script is:inline>
    (() => {
      try {
        const key = 'kianos-politics-last-location-v1';
        const last = JSON.parse(localStorage.getItem(key) || 'null');
        if (!last?.href || !(last.unit_id || last.question_id || last.action)) return;
        const url = new URL(last.href, window.location.origin);
        if (url.pathname === window.location.pathname) window.__kianosPoliticsResumeSnapshot = last;
      } catch {}
    })();
  </script>

  {useCognitiveWorkspace
    ? <PoliticsCognitiveWorkspace chapter={data} base={base} compiled={compiled} chapterContext={chapterContext} />
    : <PoliticsChapterRuntime chapter={data} base={base} compiled={compiled} chapterContext={chapterContext} />}

  {useCognitiveWorkspace && <PoliticsVisibleTypeFloor />}

  <script is:inline>
    (() => {
      const snapshot = window.__kianosPoliticsResumeSnapshot;
      if (!snapshot) return;
      try {
        localStorage.setItem('kianos-politics-last-location-v1', JSON.stringify(snapshot));
      } catch {}
      delete window.__kianosPoliticsResumeSnapshot;
    })();
  </script>

  <PoliticsRepairEnhancer chapter={data} compiled={compiled} />
  <PoliticsUnitReturnEnhancer chapter={data} compiled={compiled} />
  {['mao', 'xi', 'ethics_law'].includes(subject) && <PoliticsEvidenceEnhancer chapter={data} />}
  {!useCognitiveWorkspace && <PoliticsChapterPresentation />}
</PoliticsLayout>
