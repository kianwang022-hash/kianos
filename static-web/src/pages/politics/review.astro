---
import Base from '../../layouts/Base.astro';
import { politicsProductCatalog } from '../../lib/productCatalog.mjs';
import '../../styles/product-closure.css';
const base = import.meta.env.BASE_URL;
const catalog = politicsProductCatalog(base);
---
<Base title="政治 · 今日回访" active="politics" showLead={false}>
  <section class="politicsReviewPage" data-politics-review data-base={base}>
    <script type="application/json" data-review-catalog set:html={JSON.stringify(catalog).replace(/</g, '\\u003c')} />
    <header class="reviewPageHeader"><div><p class="pageKicker">POLITICS · REVIEW</p><h1>今日回访</h1><p>只处理已经暴露的问题。回源、再试，然后回到主线。</p></div><a href={`${base}politics/`}>回五科总览 →</a></header>
    <nav class="reviewNavigation" aria-label="政治学习"><a href={`${base}politics/`}>总览</a><a href={`${base}politics/practice/`}>肖1000</a><a href={`${base}politics/review/`} aria-current="page">回访</a></nav>
    <section class="reviewResume" data-review-resume hidden><div><span>上次还在这里</span><strong data-review-resume-title></strong><p data-review-resume-detail></p></div><a data-review-resume-link class="examPrimary">继续 →</a></section>
    <div class="reviewActionStrip"><nav aria-label="回访范围"><button data-review-filter="all" aria-pressed="true">待处理</button><button data-review-filter="today" aria-pressed="false">今天产生</button><button data-review-filter="discussion" aria-pressed="false">留给讨论</button></nav><select data-review-subject aria-label="选择科目"><option value="all">全部五科</option>{catalog.subjects.map(s => <option value={s.id}>{s.label}</option>)}</select><button data-review-copy class="examQuiet">复制回访学习包</button></div>
    <p data-review-error class="examError" role="alert" hidden></p>
    <section class="reviewMainAction" data-review-action hidden><div><h2>把错题与不确定再过一遍</h2><p data-review-count></p></div><a data-review-start class="examPrimary" href={`${base}politics/practice/?review=problems`}>开始回访 →</a></section>
    <p class="reviewEmpty" data-review-empty>正在读取本机记录…</p>
    <div class="reviewGroups" data-review-groups></div>
    <footer class="reviewFoot"><p>同一道题的修正不覆盖首答，也不代表长期掌握。没有到期债务；稳定内容不强制重做。</p><a href={`${base}politics/`}>继续学新的内容 →</a></footer>
  </section>
</Base>
<script>
  import { initPoliticsReview } from '../../lib/politicsReviewClient.mjs';
  initPoliticsReview(document.querySelector('[data-politics-review]'));
</script>
