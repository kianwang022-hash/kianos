---
import Base from '../../layouts/Base.astro';
import { politicsProductCatalog } from '../../lib/productCatalog.mjs';
import '../../styles/product-closure.css';
import '../../styles/politics-review-workspace.css';

const base = import.meta.env.BASE_URL;
const catalog = politicsProductCatalog(base);
---
<Base title="政治 · 复习" active="politics" showLead={false}>
  <section class="politicsReviewPage politicsReviewV2" data-politics-review data-base={base}>
    <script type="application/json" data-review-catalog set:html={JSON.stringify(catalog).replace(/</g, '\\u003c')} />

    <header class="reviewPageHeader">
      <div>
        <span class="reviewEyebrow">复习</span>
        <h1>只回收真正暴露的问题</h1>
        <p>错题、不确定和留给讨论的题目留在这里；稳定内容不额外制造复习负担。</p>
      </div>
    </header>

    <section class="reviewResume" data-review-resume hidden>
      <div>
        <span>上次还在这里</span>
        <strong data-review-resume-title></strong>
        <p data-review-resume-detail></p>
      </div>
      <a data-review-resume-link class="examPrimary">继续 →</a>
    </section>

    <div class="reviewActionStrip">
      <nav aria-label="复习范围">
        <button data-review-filter="all" aria-pressed="true">待处理</button>
        <button data-review-filter="today" aria-pressed="false">今天产生</button>
        <button data-review-filter="discussion" aria-pressed="false">留给讨论</button>
      </nav>
      <select data-review-subject aria-label="选择科目">
        <option value="all">全部五科</option>
        {catalog.subjects.map(s => <option value={s.id}>{s.label}</option>)}
      </select>
      <button data-review-copy class="examQuiet">复制学习包</button>
    </div>

    <p data-review-error class="examError" role="alert" hidden></p>

    <details class="reviewChatReturn" data-review-return>
      <summary>导入 Chat 返回</summary>
      <div class="reviewChatReturnBody">
        <p>只接受从本页同一批次导出的结构化返回；旧批次、错误题号、冲突重放都会被拒绝。</p>
        <textarea data-review-return-text rows="8" spellcheck="false" placeholder="把 Chat 返回的 kianos.politics.chat-return.v1 JSON 粘贴到这里"></textarea>
        <div class="reviewChatReturnActions">
          <button data-review-return-apply class="examQuiet" type="button">核对并导入</button>
          <p data-review-return-status aria-live="polite"></p>
        </div>
        <div data-review-return-result class="reviewReturnResult"></div>
      </div>
    </details>

    <section class="reviewMainAction" data-review-action hidden>
      <div>
        <span>当前待处理</span>
        <h2>把错题与不确定再过一遍</h2>
        <p data-review-count></p>
      </div>
      <a data-review-start class="examPrimary" href={`${base}politics/practice/?review=problems`}>开始复习 →</a>
    </section>

    <p class="reviewEmpty" data-review-empty>正在读取本机记录…</p>
    <div class="reviewGroups" data-review-groups></div>

    <footer class="reviewFoot">
      <p>只复习已经暴露的问题；稳定题不会被强制拉回来。</p>
      <a href={`${base}politics/learn/`}>继续学新的内容 →</a>
    </footer>
  </section>
</Base>

<script>
  import { initPoliticsReview } from '../../lib/politicsReviewClient.mjs';
  initPoliticsReview(document.querySelector('[data-politics-review]'));
</script>
