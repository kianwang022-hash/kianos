---
import Base from '../../layouts/Base.astro';
import PoliticsPracticeWorkbench from '../../components/PoliticsPracticeWorkbench.astro';
import { buildPoliticsPracticeCatalogCurrent } from '../../lib/politicsPractice.mjs';

const base = import.meta.env.BASE_URL;
const catalog = buildPoliticsPracticeCatalogCurrent(base);
---
<Base
  title="政治 · 肖1000训练"
  kicker="Current Workbench"
  description="按 Current Question Truth 训练；保留 first attempt、标记、返回和来源边界。"
  active="politics"
  showLead={false}
>
  <PoliticsPracticeWorkbench catalog={catalog} base={base} />
</Base>
