---
import Base from '../../layouts/Base.astro';
import PoliticsHomeTools from '../../components/PoliticsHomeTools.astro';
import { listPoliticsSubjectsCurrent } from '../../lib/politicsCurrent.mjs';

const base = import.meta.env.BASE_URL;
const subjects = listPoliticsSubjectsCurrent();

const chapterCount = subjects.reduce((sum, subject) => sum + subject.chapters.length, 0);
const firstSubject = subjects[0];
const firstChapter = firstSubject?.chapters?.[0];
const firstHref = firstSubject && firstChapter ? `${base}politics/${firstSubject.subject}/${firstChapter.code}/` : `${base}politics/`;
const firstLabel = firstChapter ? `${firstSubject.label} · ${firstChapter.title}` : '开始政治学习';
---
<Base
  title="政治"
  active="politics"
>
  <PoliticsHomeTools firstHref={firstHref} firstLabel={firstLabel} />

  <section class="politicsSubjects">
    {subjects.map((subject) => (
      <article class="politicsSubjectCard">
        <header>
          <div><span>{subject.shape}</span><h2>{subject.label}</h2></div>
          
        </header>
        <p>{subject.description}</p>
        <a class="subjectEntry" href={`${base}politics/${subject.subject}/${subject.chapters[0].code}/`}>进入 →</a>
        <details><summary>章节跳转</summary><nav>
          {subject.chapters.map((chapter, index) => (
            <a href={`${base}politics/${subject.subject}/${chapter.code}/`}>
              <span>{String(index + 1).padStart(2,'0')}</span>
              <strong>{chapter.title}</strong>
              <b>→</b>
            </a>
          ))}
        </nav></details>
      </article>
    ))}
  </section>
</Base>

<style>
.politicsSubjects{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:24px;margin-top:32px;border-top:1px solid var(--study-line);padding-top:26px}.politicsSubjectCard h2{font-size:24px;margin:6px 0}.politicsSubjectCard header span{font-size:14px;color:var(--study-muted)}.politicsSubjectCard p{font-size:16px;line-height:1.7;color:var(--study-muted)}.subjectEntry{display:inline-block;font-size:17px;color:var(--study-green);margin:8px 0 20px}.politicsSubjectCard summary{font-size:14px;cursor:pointer;color:var(--study-muted)}.politicsSubjectCard nav{display:grid;gap:10px;margin-top:15px}.politicsSubjectCard nav a{display:flex;gap:7px;color:inherit;text-decoration:none;font-size:15px;line-height:1.5}.politicsSubjectCard nav a span{color:var(--study-faint)}.politicsSubjectCard nav a b{margin-left:auto}
@media(max-width:1100px){.politicsSubjects{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:700px){.politicsSubjects{grid-template-columns:1fr 1fr}}@media(max-width:440px){.politicsSubjects{grid-template-columns:1fr}}
</style>
