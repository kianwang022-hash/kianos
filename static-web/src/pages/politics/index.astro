---
import '../../styles/product-closure.css';
import '../../styles/politics-home-workspace.css';
import Base from '../../layouts/PoliticsBase.astro';
import PoliticsHomeTools from '../../components/PoliticsHomeTools.astro';

const base = import.meta.env.BASE_URL;
const firstHref = `${base}politics/learn/`;
const firstLabel = '选择科目和章节';
---
<Base title="政治" active="politics" showLead={false}>
  <section class="politicsHomeV3" data-politics-home-v3>
    <header class="politicsHomeHeader">
      <div>
        <span>政治</span>
        <h1>接着上次的位置学</h1>
      </div>
      <p>学习、做题和回看都从真实记录继续，不另外制造一套进度。</p>
    </header>

    <PoliticsHomeTools firstHref={firstHref} firstLabel={firstLabel} />
  </section>
</Base>
