---
import Base from '../../layouts/Base.astro';
import '../../styles/english-translation-vertical.css';
import TranslationWorkspace from '../../components/TranslationWorkspace.astro';
import TranslationEvidenceGuard from '../../components/TranslationEvidenceGuard.astro';
import TranslationPersistenceGuard from '../../components/TranslationPersistenceGuard.astro';
import TranslationReferenceLoader from '../../components/TranslationReferenceLoader.astro';
import {
  listTranslationSets,
  loadTranslationById
} from '../../lib/englishTranslationSourceTruth.mjs';

export function getStaticPaths() {
  return listTranslationSets().map((item) => ({
    params: { id: item.id },
    props: { translationId: item.id }
  }));
}

const { translationId } = Astro.props;
const translation = loadTranslationById(translationId);
const base = import.meta.env.BASE_URL;
const reference = {
  availableCount: translation.referenceCoverage?.available || 0,
  totalCount: translation.referenceCoverage?.total || translation.prompts?.length || 0,
  missingCount: translation.referenceCoverage?.missing || 0,
  references: []
};
const referenceUrl = `${base}translation-reference/${encodeURIComponent(translationId)}.json`;
---
<Base
  title={translation.title}
  kicker="English · Translation Current"
  description="Clean production first; delayed reference comparison; focused repair; learner reconstruction."
  sourcePath={translation.sourcePaths.sourceTruth || translation.sourcePaths.questions}
  sourceHash={translation.sourceHashes.renderedObject}
  objectId={translation.objectId}
  active="home"
>
  <TranslationPersistenceGuard />
  <TranslationWorkspace translation={translation} reference={reference} />
  <TranslationEvidenceGuard />
  <TranslationReferenceLoader referenceUrl={referenceUrl} />

  <script>
    // Projection guard: pending transfer labels are useful only after the
    // current task's complete first attempt is frozen. Revealing them during
    // Clean Attempt would cue the very demand that fresh evidence should test.
    const root = document.querySelector('[data-translation-runtime]');
    if (root instanceof HTMLElement) {
      const attempt = root.querySelector('[data-stage="attempt"]');
      const pending = root.querySelector('[data-pending-panel]');
      if (attempt instanceof HTMLElement && pending instanceof HTMLElement) {
        const protectCleanAttempt = () => {
          if (!attempt.hidden && !pending.hidden) pending.hidden = true;
        };
        const observer = new MutationObserver(protectCleanAttempt);
        observer.observe(attempt, { attributes: true, attributeFilter: ['hidden'] });
        observer.observe(pending, { attributes: true, attributeFilter: ['hidden'] });
        protectCleanAttempt();
      }
    }
  </script>
</Base>
