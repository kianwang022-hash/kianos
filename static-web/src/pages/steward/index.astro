---
import '../../styles/steward-workspace.css';
import Base from '../../layouts/Base.astro';
---
<Base title="Steward" active="steward" showLead={false}>
  <section class="stewardWorkspace" data-steward-workspace>
    <header class="stewardHeader">
      <div class="stewardHeaderCopy">
        <span>Steward</span>
        <h1 data-steward-header-title>今天怎么过</h1>
        <p data-steward-header-description>时间安排、实际执行、饮食、训练和恢复。</p>
      </div>
      <nav class="stewardViewTabs" aria-label="Steward 时间视图">
        <button type="button" class="active" data-steward-view="today">今日</button>
        <button type="button" data-steward-view="week">周</button>
        <button type="button" data-steward-view="month">月</button>
      </nav>
    </header>

    <section class="stewardViewPanel active" data-steward-view-panel="today">
      <div class="stewardTodayFrame">
        <aside class="stewardTodayAside" aria-label="今日辅助信息">
          <section class="stewardAsideSection" data-steward-task-section>
            <header class="stewardAsideHead">
              <h2>今日事项</h2>
              <span>无固定时点</span>
            </header>
            <div class="stewardTaskList" data-steward-tasks></div>
          </section>

          <section class="stewardAsideSection stewardWeightSection" aria-label="晨重">
            <header class="stewardAsideHead">
              <h3>晨重</h3>
              <span>跨日观察</span>
            </header>
            <div class="stewardWeightValue">— <small>kg</small></div>
            <div class="stewardWeightMeta">未记录</div>
          </section>

          <nav class="stewardModeTabs" aria-label="今日工作区">
            <button type="button" class="active" data-steward-mode="schedule">日程</button>
            <button type="button" data-steward-mode="nutrition">饮食与营养</button>
            <button type="button" data-steward-mode="training">训练</button>
          </nav>
        </aside>

        <section class="stewardTodayMain">

          <section class="stewardModePanel active" data-steward-mode-panel="schedule">
            <header class="stewardModeHead">
              <div>
                <h2>今日时间轴</h2>
                <p>计划 · 实际 · 状态</p>
              </div>
              <span class="stewardPlanState" data-steward-plan-state>读取安排…</span>
            </header>
            <div class="stewardTimelineViewport" data-steward-timeline-viewport>
              <div class="stewardTimeline" data-steward-timeline></div>
            </div>
          </section>

          <section class="stewardModePanel" data-steward-mode-panel="nutrition">
            <div class="stewardUnavailable" data-steward-nutrition-unavailable>
              <h2>今天还没有营养安排</h2>
              <p>Steward 只展示当前计划明确投影的餐食与营养信息；没有安排时不自行生成。</p>
            </div>
            <div class="stewardNutritionWorkspace" data-steward-nutrition-workspace hidden>
              <div class="stewardSubToolbar">
                <div class="stewardNutritionContext"><strong>今天</strong><span>按推荐份量开始，可随手改</span></div>
                <div class="stewardSubStatus" data-steward-nutrition-target></div>
              </div>
              <div class="stewardNutritionGrid">
                <aside class="stewardChoiceRail">
                  <header><h3>常用组合</h3></header>
                  <div data-steward-meal-list></div>
                </aside>
                <section class="stewardMealEditor" data-steward-meal-editor>
                  <header>
                    <div><span>当前餐</span><h2 data-steward-meal-title>—</h2></div>
                    <div class="stewardMealActions">
                      <button type="button" data-steward-meal-half>全部减半</button>
                      <button type="button" data-steward-meal-uncertain>份量不确定</button>
                      <button type="button" data-steward-meal-reset>恢复推荐</button>
                    </div>
                  </header>
                  <div class="stewardMealRows" data-steward-meal-rows></div>
                </section>
                <aside class="stewardMacroPanel">
                  <header><span>当前估算</span></header>
                  <div class="stewardMacroBigGrid">
                    <div><span>热量</span><strong data-steward-macro="kcal">—</strong></div>
                    <div><span>蛋白质</span><strong data-steward-macro="protein">—</strong></div>
                    <div><span>碳水</span><strong data-steward-macro="carb">—</strong></div>
                    <div><span>脂肪</span><strong data-steward-macro="fat">—</strong></div>
                  </div>
                  <section class="stewardTopupSection">
                    <header><strong>补缺</strong><span>只用今日允许项</span></header>
                    <div data-steward-topup-list></div>
                  </section>
                  <section class="stewardQuickAddSection">
                    <header><strong>快速添加</strong><span>单品</span></header>
                    <div data-steward-quick-add></div>
                  </section>
                  <p>选择与克数只记录实际；不自动改变营养策略或明天的目标。</p>
                </aside>
              </div>
            </div>
          </section>

          <section class="stewardModePanel" data-steward-mode-panel="training">
            <div class="stewardUnavailable" data-steward-training-unavailable>
              <h2>今天还没有训练安排</h2>
              <p>训练动作与剂量由 Steward / Chat 决定；页面只执行、替换已授权动作并记录实际。</p>
            </div>
            <div class="stewardTrainingWorkspace" data-steward-training-workspace hidden>
              <div class="stewardTrainingGrid">
                <section class="stewardTrainingEditor">
                  <header>
                    <div><span>今日推荐</span><h2 data-steward-training-title>—</h2></div>
                    <p data-steward-training-duration></p>
                  </header>
                  <div class="stewardExerciseCards" data-steward-exercise-list></div>
                  <div class="stewardTrainingEffect">
                    <span>训练后</span>
                    <button type="button" data-steward-training-effect="BETTER">很好</button>
                    <button type="button" data-steward-training-effect="SAME">正常</button>
                    <button type="button" data-steward-training-effect="TIRED">累</button>
                    <input type="text" data-steward-training-note placeholder="备注（可选）">
                  </div>
                </section>
                <aside class="stewardTrainingSummary">
                  <header><span>Apple Watch</span><strong>训练数据</strong></header>
                  <dl>
                    <div><dt>训练记录</dt><dd>—</dd></div>
                    <div><dt>时长</dt><dd>—</dd></div>
                    <div><dt>活动能量</dt><dd>— kcal</dd></div>
                    <div><dt>平均心率</dt><dd>—</dd></div>
                  </dl>
                  <p>同步后用于训练记录与恢复判断；不会直接改变饮食额度或自动加量。</p>
                </aside>
              </div>
            </div>
          </section>
        </section>

        <aside class="stewardNowRail" aria-label="当前学习与最近记录">
          <section class="stewardAsideSection">
            <span class="stewardNowLabel">现在</span>
            <strong class="stewardNowSubject" data-steward-now-subject>读取中…</strong>
            <b class="stewardNowElapsed" data-steward-now-elapsed>—</b>
            <dl class="stewardNowMeta">
              <dt>计划</dt><dd data-steward-now-plan>—</dd>
              <dt>下一项</dt><dd data-steward-next>—</dd>
            </dl>
          </section>
          <section class="stewardAsideSection">
            <header class="stewardAsideHead">
              <h3>今日学习</h3>
            </header>
            <div class="stewardSubjectTotals">
              <div class="stewardSubjectTotal"><span>西综</span><strong data-steward-total="xizong">0m</strong></div>
              <div class="stewardSubjectTotal"><span>English</span><strong data-steward-total="english">0m</strong></div>
              <div class="stewardSubjectTotal"><span>政治</span><strong data-steward-total="politics">0m</strong></div>
            </div>
          </section>
          <section class="stewardAsideSection" data-steward-capacity-section hidden>
            <header class="stewardAsideHead">
              <h3>执行策略</h3>
              <span data-steward-capacity-state></span>
            </header>
            <p class="stewardCapacitySummary" data-steward-capacity-summary></p>
            <dl class="stewardCapacityMeta">
              <div data-steward-capacity-load-row hidden><dt>负荷</dt><dd data-steward-capacity-load></dd></div>
              <div data-steward-capacity-action-row hidden><dt>现在</dt><dd data-steward-capacity-action></dd></div>
              <div data-steward-capacity-recheck-row hidden><dt>再判断</dt><dd data-steward-capacity-recheck></dd></div>
            </dl>
            <p class="stewardCapacityRecovery" data-steward-capacity-recovery hidden></p>
          </section>
          <section class="stewardAsideSection">
            <header class="stewardAsideHead">
              <h3>最近记录</h3>
            </header>
            <div class="stewardRealityList" data-steward-reality></div>
          </section>
        </aside>
      </div>
    </section>

    <section class="stewardViewPanel" data-steward-view-panel="week">
      <div class="stewardPeriodToolbar">
        <button type="button" data-steward-week-prev aria-label="上一周">‹</button>
        <strong data-steward-week-label></strong>
        <button type="button" data-steward-week-next aria-label="下一周">›</button>
        <button type="button" data-steward-week-now>本周</button>
      </div>
      <div class="stewardWeekShell">
        <div class="stewardWeekGrid" data-steward-week-grid></div>
      </div>
    </section>

    <section class="stewardViewPanel" data-steward-view-panel="month">
      <div class="stewardPeriodToolbar">
        <button type="button" data-steward-month-prev aria-label="上一月">‹</button>
        <strong data-steward-month-label></strong>
        <button type="button" data-steward-month-next aria-label="下一月">›</button>
        <button type="button" data-steward-month-now>本月</button>
      </div>
      <div class="stewardMonthShell">
        <div class="stewardMonthGrid" data-steward-month-grid></div>
        <div class="stewardMonthDetail" data-steward-month-detail>选择一天查看安排。</div>
      </div>
    </section>
  </section>
</Base>

<script>
  import { initStewardWorkspace } from '../../lib/stewardWorkspaceClient.mjs';
  import { learnerWriterReady } from '../../lib/browserLearnerWriter.mjs';

  void learnerWriterReady.then(() => {
    initStewardWorkspace(document.querySelector('[data-steward-workspace]'));
  });
</script>
