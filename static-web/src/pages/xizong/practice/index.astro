---
import Base from '../../../layouts/Base.astro';
import { listProjectableXizongSystems, loadXizongSystem } from '../../../lib/xizong.mjs';
import { loadXizongSystemQuestionSweep, listXizongPaperSummaries } from '../../../lib/xizongQuestions.mjs';
import '../../../styles/xizong-practice-workspace.css';

const base = import.meta.env.BASE_URL;
const scopes = listProjectableXizongSystems()
  .map((row) => {
    const system = loadXizongSystem(row.systemId);
    const sweep = loadXizongSystemQuestionSweep(system);
    return sweep ? {
      systemId: system.systemId,
      canonicalId: system.canonicalId,
      title: system.title,
      count: sweep.questionCount,
      years: sweep.years
    } : null;
  })
  .filter(Boolean);
const papers = listXizongPaperSummaries();
---
<Base title="西综训练" active="xizong" showLead={false}>
  <section class="xzpLanding">
    <header>
      <div>
        <span>PRACTICE</span>
        <h1>训练</h1>
      </div>
      <p>同一个题目工作台，只改变训练范围。System、二轮回收、整卷和后期训练共用同一套作答与解析逻辑。</p>
    </header>

    <section class="xzpRetainedEntry" data-retained-entry data-retained-base={base}>
      <div class="xzpLandingLabel">
        <span>回收</span>
        <small>跨 System 汇总本机最近仍需回收的题；不复制题库</small>
      </div>
      <div class="xzpRetainedScopes">
        <button type="button" data-retained-mode="WU" disabled>
          <span>Wrong / Uncertain</span>
          <strong>错题 / 不确定 <b data-retained-count="WU">0</b></strong>
          <small>只保留最近一次仍为 Wrong / Uncertain 的题；后来已经 Stable 的会自动退出。</small>
          <em>进入回收 →</em>
        </button>
        <button type="button" data-retained-mode="MARKED" disabled>
          <span>Marked</span>
          <strong>已标记 <b data-retained-count="MARKED">0</b></strong>
          <small>由你主动标记；在任何训练范围取消后都会全局生效。</small>
          <em>进入回收 →</em>
        </button>
      </div>
      <p class="xzpRetainedStatus" data-retained-status>正在读取本机做题记录…</p>
    </section>

    <section>
      <div class="xzpLandingLabel">
        <span>按 System</span>
        <small>当前已接受精确题目范围</small>
      </div>
      <nav class="xzpScopeList" aria-label="按 System 训练">
        {scopes.map((scope) => (
          <a href={`${base}xizong/practice/${scope.systemId}/`}>
            <b>{scope.canonicalId}</b>
            <strong>{scope.title}</strong>
            <span>{scope.count} 题</span>
            <em>进入训练 →</em>
          </a>
        ))}
      </nav>
    </section>

    <section class="xzpPaperEntry">
      <div class="xzpLandingLabel">
        <span>整卷</span>
        <small>按当年真实题量 / 分值执行；作答中隐藏结果，交卷后统一出分</small>
      </div>
      <nav class="xzpPaperYears" aria-label="Whole paper years">
        {papers.map((paper) => (
          <a href={`${base}xizong/practice/paper/${paper.year}/`}>
            <strong>{paper.year}</strong>
            <span>{paper.questionCount} 题</span>
            <b>{paper.maxScore} 分</b>
          </a>
        ))}
      </nav>
    </section>

    <section class="xzpChatSetEntry">
      <details data-chat-set-import data-chat-set-import-base={base}>
        <summary>
          <div>
            <span>Chat 自选题</span>
            <strong>让 Chat 直接挑题，网页按给定顺序执行</strong>
          </div>
          <em>导入 →</em>
        </summary>
        <div class="xzpChatSetImportBody">
          <p>粘贴 Chat 生成的西综题单。题目顺序按 Chat 原样执行；网页不会补题、猜题或扩大范围。</p>
          <textarea rows="9" data-chat-set-text placeholder="粘贴 Chat 生成的西综题单 JSON"></textarea>
          <div>
            <button type="button" data-chat-set-start>导入并开始</button>
            <small data-chat-set-status>题单只保存在本机，不上传。</small>
          </div>
        </div>
      </details>
    </section>

    <section class="xzpLandingFuture">
      <div>
        <span>统一训练</span>
        <p>System、回收、整卷和 Chat 自选题都使用同一套作答、标记与复盘操作。</p>
      </div>
    </section>
  </section>
</Base>

<script>
  import {
    XIZONG_RETAINED_SET_KEY,
    XIZONG_QUESTION_PREFERENCES_KEY,
    collectXizongRetainedEvidence,
    buildXizongRetainedSet,
    xizongQuestionMarkOverrides
  } from '../../../lib/xizongRetainedPractice.mjs';

  document.querySelectorAll('[data-retained-entry]').forEach((root) => {
    const status = root.querySelector('[data-retained-status]');
    const base = root.getAttribute('data-retained-base') || '/';
    const readJson = (key, fallback) => {
      try { return JSON.parse(localStorage.getItem(key) || '') || fallback; } catch { return fallback; }
    };
    const entries = [];
    try {
      for (let index = 0; index < localStorage.length; index += 1) {
        const key = localStorage.key(index);
        if (key) entries.push([key, localStorage.getItem(key)]);
      }
    } catch {}

    const holdoutYears = readJson('kianos:xizong:full-paper-holdout-years:v1', []);
    const preferences = readJson(XIZONG_QUESTION_PREFERENCES_KEY, {});
    const evidence = collectXizongRetainedEvidence(entries, {
      holdoutYears,
      markOverrides: xizongQuestionMarkOverrides(preferences)
    });

    const counts = {
      WU: evidence.wrongUncertainIds.length,
      MARKED: evidence.markedIds.length
    };
    root.querySelectorAll('[data-retained-mode]').forEach((button) => {
      const mode = String(button.getAttribute('data-retained-mode') || '');
      const count = counts[mode] || 0;
      const countNode = root.querySelector(`[data-retained-count="${mode}"]`);
      if (countNode) countNode.textContent = String(count);
      if (button instanceof HTMLButtonElement) button.disabled = count === 0;
      button.addEventListener('click', () => {
        try {
          const set = buildXizongRetainedSet(mode, evidence, { studyPhase: 'SECOND_PASS' });
          localStorage.setItem(XIZONG_RETAINED_SET_KEY, JSON.stringify(set));
          window.location.href = `${base}xizong/practice/retained/`;
        } catch {
          if (status) status.textContent = '当前没有可执行的回收题。';
        }
      });
    });

    if (status) {
      const held = Array.isArray(holdoutYears) && holdoutYears.length ? ` · 已避开整卷保留年份 ${holdoutYears.join('、')}` : '';
      status.textContent = `待回收 ${counts.WU} · 已标记 ${counts.MARKED}${held}`;
    }
  });

  document.querySelectorAll('[data-chat-set-import]').forEach((root) => {
    const input = root.querySelector('[data-chat-set-text]');
    const status = root.querySelector('[data-chat-set-status]');
    const button = root.querySelector('[data-chat-set-start]');
    const base = root.getAttribute('data-chat-set-import-base') || '/';

    button?.addEventListener('click', () => {
      try {
        const parsed = JSON.parse(input?.value || '');
        const ids = Array.isArray(parsed?.question_ids) ? parsed.question_ids.map(String) : [];
        const validPhase = ['FIRST_PASS','SECOND_PASS','LATE_REVIEW'].includes(String(parsed?.study_phase || ''));
        const validSpeed = ['normal','fast'].includes(String(parsed?.speed || 'normal'));
        if (parsed?.schema !== 'kianos.xizong.chat_set.v1') throw new Error('schema');
        if (!String(parsed?.set_id || '').trim()) throw new Error('set_id');
        if (!ids.length || ids.some((id) => !/^xizong-official-\d{4}-n\d{3}$/.test(id))) throw new Error('question_ids');
        if (new Set(ids).size !== ids.length) throw new Error('duplicate');
        if (!validPhase) throw new Error('study_phase');
        if (String(parsed?.result_visibility || 'immediate') !== 'immediate') throw new Error('result_visibility');
        if (!validSpeed) throw new Error('speed');

        localStorage.setItem('kianos:xizong:chat-set:v1', JSON.stringify({
          schema: 'kianos.xizong.chat_set.v1',
          set_id: String(parsed.set_id),
          label: String(parsed.label || 'Chat 自选题'),
          study_phase: String(parsed.study_phase),
          result_visibility: 'immediate',
          speed: String(parsed.speed || 'normal'),
          allow_holdout: parsed.allow_holdout === true,
          question_ids: ids
        }));
        if (status) status.textContent = `已接收 ${ids.length} 题，正在开始…`;
        window.location.href = `${base}xizong/practice/chat-set/`;
      } catch (error) {
        if (status) status.textContent = '无法导入：请让 Chat 重新生成标准西综题单；当前自选题只支持即时反馈。';
      }
    });
  });
</script>
