---
import Base from '../../../../layouts/Base.astro';
import XizongPracticeWorkbench from '../../../../components/XizongPracticeWorkbench.astro';
import { listXizongPaperSummaries, loadXizongWholePaper } from '../../../../lib/xizongQuestions.mjs';
import '../../../../styles/xizong-practice-workspace.css';

export function getStaticPaths() {
  return listXizongPaperSummaries().map((row) => ({
    params: { year: String(row.year) },
    props: { year: row.year }
  }));
}

const { year } = Astro.props;
const sweep = loadXizongWholePaper(year);
const system = {
  systemId: sweep.systemId,
  canonicalId: sweep.canonicalId,
  title: sweep.title
};
---

<Base title={`${year} 整卷 · 西综训练`} active="xizong" showLead={false} objectId={`xizong:practice:paper:${year}`}>
  <XizongPracticeWorkbench system={system} sweep={sweep} scopeKind="PAPER" />
</Base>
