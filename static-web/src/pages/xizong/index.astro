---
import Base from '../../layouts/Base.astro';
import SiteResume from '../../components/SiteResume.astro';
import { listProjectableXizongSystems } from '../../lib/xizong.mjs';
const base = import.meta.env.BASE_URL;
const systems = listProjectableXizongSystems();
---
<Base title="西医综合" kicker="System → Block → Recall" active="xizong">
  <SiteResume subject="xizong" />
  <div class="subjectEntries">
    {systems.map(system => <section><span>{system.canonicalId}</span><h2><a href={`${base}xizong/${system.systemId}/`}>{system.title} →</a></h2><p>{system.blocks.length} Blocks · 讲义连续学习，回来提取与闭合</p><nav>{system.blocks.map(block => <a href={`${base}xizong/${system.systemId}/${block.slug}/`}><b>{block.label}</b> {block.title}</a>)}</nav></section>)}
  </div>
</Base>
