---
import Base from '../../layouts/XizongBase.astro';
import XizongHomeTools from '../../components/XizongHomeTools.astro';
import { listXizongMacroDomainProjection, xizongLearnerSystemSummary, xizongLearnerSystemTitle } from '../../lib/xizongDomains.mjs';
import { projectLearnerText } from '../../lib/xizongProjection.mjs';
import '../../styles/xizong-home-workspace.css';

const base = import.meta.env.BASE_URL;
const domains = listXizongMacroDomainProjection();
const systems = domains.flatMap((domain) => domain.systems.map((system) => ({
  ...system,
  learnerTitle: xizongLearnerSystemTitle(system.canonicalId, system.title),
  learnerSummary: projectLearnerText(xizongLearnerSystemSummary(system)),
  blocks: system.blocks.map((block) => ({ ...block, title: projectLearnerText(block.title) }))
})));
const firstSystem = systems[0];
const firstHref = firstSystem ? `${base}xizong/${firstSystem.systemId}/` : `${base}xizong/`;
const firstLabel = firstSystem ? `${firstSystem.canonicalId} · ${firstSystem.learnerTitle}` : '开始西综学习';
const resumeIndex = systems.map((system) => ({
  systemId: system.systemId,
  canonicalId: system.canonicalId,
  title: system.learnerTitle,
  blocks: system.blocks.map((block) => ({
    blockId: block.blockId,
    slug: block.slug,
    label: block.label,
    title: block.title,
    kpCount: block.kpCount
  }))
}));
const systemIdentity = (system) => system.learnerSummary || '';
---

<Base title="西医综合" active="xizong" showLead={false}>
  <section class="xzHome" data-xizong-home-workspace>
    <header class="xzHomeHeader">
      <h1>西医综合</h1>
      <p>机制理解 · 主动重建 · 真题应用</p>
    </header>

    <XizongHomeTools firstHref={firstHref} firstLabel={firstLabel} resumeIndex={resumeIndex} />

    <section class="xzHomeSection xzHomeCurrentSystems">
      <header class="xzHomeSectionHead">
        <span>SYSTEMS</span>
      </header>
      <nav class="xzHomeSystemGrid" aria-label="西综系统">
        {systems.map((system) => (
          <a
            href={`${base}xizong/${system.systemId}/`}
            class="xzHomeSystemEntry"
            data-xizong-system-entry={system.systemId}
          >
            <span class="xzHomeSystemCode">{system.canonicalId}</span>
            <h2>{system.learnerTitle}</h2>
            <p>{systemIdentity(system)}</p>
            <b data-xizong-system-action>进入系统 →</b>
          </a>
        ))}
      </nav>
    </section>

    <section class="xzHomeSection xzHomeAttention" data-xizong-home-attention hidden>
      <header class="xzHomeSectionHead">
        <span>NEEDS ATTENTION</span>
      </header>
      <div class="xzHomeAttentionGrid">
        <a href={`${base}xizong/memory/`} data-xizong-attention-memory hidden>
          <span>Memory</span>
          <strong><b data-xizong-attention-memory-count>0</b> 个当前需要回收</strong>
          <em>进入 Memory →</em>
        </a>
        <a href={`${base}xizong/memory/`} data-xizong-attention-marked hidden>
          <span>Marked</span>
          <strong><b data-xizong-attention-marked-count>0</b> 个主动标记</strong>
          <em>查看 Marked →</em>
        </a>
        <a href={`${base}xizong/memory/`} data-xizong-attention-repair hidden>
          <span>Repair</span>
          <strong><b data-xizong-attention-repair-count>0</b> 个待返回任务</strong>
          <em>继续 Repair →</em>
        </a>
      </div>
    </section>

    <section class="xzHomeSection xzHomeKnowledgeMap">
      <header class="xzHomeSectionHead">
        <span>KNOWLEDGE MAP</span>
      </header>
      <div class="xzHomeKnowledgeGrid">
        {domains.map((domain) => (
          <div class:list={['xzHomeKnowledgeItem', domain.projectable ? 'is-current' : 'is-unavailable']} data-domain={domain.domainId}>
            <b>{domain.domainId}</b>
            <span>{domain.title}</span>
            {domain.systems.length > 0 ? (
              <div class="xzHomeKnowledgeLinks" aria-label={`${domain.domainId} systems`}>
                {domain.systems.map((system) => (
                  <a href={`${base}xizong/${system.systemId}/`}>
                    {system.canonicalId} · {xizongLearnerSystemTitle(system.canonicalId, system.title)}
                  </a>
                ))}
              </div>
            ) : (
              <small>尚未接入学习界面</small>
            )}
          </div>
        ))}
      </div>
    </section>
  </section>
</Base>
