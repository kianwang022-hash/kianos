---
import Base from '../../layouts/Base.astro';
import XizongHomeTools from '../../components/XizongHomeTools.astro';
import { listXizongMacroDomainProjection } from '../../lib/xizongDomains.mjs';
import '../../styles/xizong-peripheral-workspaces.css';

const base = import.meta.env.BASE_URL;
const domains = listXizongMacroDomainProjection();
const systems = domains.flatMap((domain) => domain.systems);
const firstSystem = systems[0];
const firstHref = firstSystem ? `${base}xizong/${firstSystem.systemId}/` : `${base}xizong/`;
const firstLabel = firstSystem ? `${firstSystem.canonicalId} · ${firstSystem.title}` : '开始西综学习';
const domainCount = domains.length;
---
<Base title="西医综合" active="xizong" showLead={false}>
  <header class="xzOverviewHeader"><div><p class="pageKicker">XIZONG · LEARNING WORKSPACE</p><h1>西医综合</h1><p>先建立系统，再进入学习节；原讲义、主动回忆与应用各归其位。</p></div><span>{systems.length} 个可进入的 System</span></header>
  <XizongHomeTools firstHref={firstHref} firstLabel={firstLabel} />
  <div class="xzOverviewLayout">
    <main class="xzSystemWorkbench">
      <header><h2>进入系统</h2><span>System → Block → 学习节</span></header>
      {domains.filter(d=>d.projectable || d.decomposed).map(domain=><section class="xzOpenDomain" data-domain={domain.domainId}>
        <div class="xzOpenDomainHeading"><span>{domain.domainId}</span><div><h2>{domain.title}</h2>{domain.note&&<p>{domain.note}</p>}</div></div>
        <nav class="xzSystemRows">
          {domain.systems.map(system=><a href={`${base}xizong/${system.systemId}/`} class="xzSystemRow"><span>{system.canonicalId}</span><div><h3>{system.title}</h3><p>{system.blocks.length} Blocks · {system.blocks.reduce((sum,block)=>sum+block.kpCount,0)} KP</p></div><b>进入系统 <i>→</i></b></a>)}
        </nav>
      </section>)}
    </main>
    <aside class="xzOverviewCompanion">
      <section><p class="pageKicker">学习主线</p><h2>理解、回忆、应用。</h2><ol class="xzLearnerChain"><li><strong>System / Block</strong><span>建立位置与主机制</span></li><li><strong>学习节 / 原讲义</strong><span>在 iPad 连续学完整关系</span></li><li><strong>KP Recall / 闭合</strong><span>主动重建，再看完整 Core</span></li><li><strong>题目 / 最小修复</strong><span>用实际作答发现缺口</span></li></ol></section>
      {domains.some(d=>!d.projectable&&!d.decomposed)&&<section class="xzFutureMap"><p class="pageKicker">完整知识地图</p><h2>后续学习域</h2><div>{domains.filter(d=>!d.projectable&&!d.decomposed).map(d=><div class="xzFutureRow"><b>{d.domainId}</b><span>{d.title}</span></div>)}</div><small>保留全局位置；不产生待办或学习债务。</small></section>}
    </aside>
  </div>
</Base>
