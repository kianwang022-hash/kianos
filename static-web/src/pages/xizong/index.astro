---
import Base from '../../layouts/Base.astro';
import XizongHomeTools from '../../components/XizongHomeTools.astro';
import { listProjectableXizongSystems } from '../../lib/xizong.mjs';

const base = import.meta.env.BASE_URL;
const systems = listProjectableXizongSystems();
const firstSystem = systems[0];
const firstHref = firstSystem ? `${base}xizong/${firstSystem.systemId}/` : `${base}xizong/`;
const firstLabel = firstSystem ? `${firstSystem.canonicalId} · ${firstSystem.title}` : '开始西综学习';
---
<Base title="西医综合" kicker="Xizong · Current" description="先看清整个系统怎样运行，再进入 Block、学习节与 KP；讲义负责连续学习，网页负责定位、Recall 与修补。" active="xizong">
  <section class="homeCurrentStrip">
    <div>
      <p class="pageKicker">Learning map</p>
      <h2>System → Block → Logic Group → KP</h2>
      <p>先建立系统母模型和判断轴，再按 Block 主线进入讲义学习。网页不替代原讲义，只在需要定位、主动回忆、错题修补和系统收口时出现。</p>
    </div>
    <aside>
      <strong>{systems.length} systems ready</strong>
      <span>学习进度仅保存在本机</span>
      <span>可自由进入，也可继续上次位置</span>
    </aside>
  </section>

  <XizongHomeTools firstHref={firstHref} firstLabel={firstLabel} />

  <section class="homeGrid">
    {systems.map((system) => <a class="homeLane" href={`${base}xizong/${system.systemId}/`}>
      <div><span>{system.canonicalId} · Ready</span><h2>{system.title}</h2></div>
      <p>{system.blocks.length} Blocks · {system.blocks.reduce((sum, block) => sum + block.kpCount, 0)} KP。先看 System 框架，再按学习节进入对应讲义与 Recall。</p>
      <footer><span>System learning map</span><b>进入 →</b></footer>
    </a>)}
  </section>
</Base>