---
import Base from '../../../layouts/XizongBase.astro';
import XizongSystemWorkspace from '../../../components/XizongSystemWorkspace.astro';
import XizongLastLocation from '../../../components/XizongLastLocation.astro';
import XizongRuntimeStageGuard from '../../../components/XizongRuntimeStageGuard.astro';
import { listProjectableXizongSystems, loadXizongSystem } from '../../../lib/xizong.mjs';
import { loadXizongBeginnerGuide } from '../../../lib/xizongGuide.mjs';
import { loadXizongPathways } from '../../../lib/xizongPathways.mjs';
import { xizongLearnerSystemSummary, xizongLearnerSystemTitle } from '../../../lib/xizongDomains.mjs';
import { projectLearnerText } from '../../../lib/xizongProjection.mjs';
import '../../../styles/xizong-system-workspace.css';

export function getStaticPaths() {
  return listProjectableXizongSystems().map((system) => ({
    params: { system: system.systemId },
    props: { systemId: system.systemId }
  }));
}

const { systemId } = Astro.props;
const base = import.meta.env.BASE_URL;
const system = loadXizongSystem(systemId);
const learnerSystem = {
  ...system,
  title: xizongLearnerSystemTitle(system.canonicalId, system.title),
  mission: projectLearnerText(xizongLearnerSystemSummary(system)),
  blocks: system.blocks.map((block) => ({ ...block, title: projectLearnerText(block.title) }))
};
const guide = loadXizongBeginnerGuide(system);
const pathways = loadXizongPathways(system);
---

<Base
  title={learnerSystem.title}
  kicker={`西医综合 · ${system.canonicalId} · 系统学习`}
  description={learnerSystem.mission}
  sourcePath={system.sourcePath}
  sourceHash={system.sourceHash}
  objectId={`xizong:${system.systemId}`}
  active="xizong"
  showLead={false}
>
  <XizongLastLocation system={learnerSystem} />
  <XizongSystemWorkspace system={learnerSystem} pathways={pathways} guide={guide} />

  <section class="xzSystemRecallEntry" data-xizong-system-recall-entry hidden>
    <div>
      <span>下一步 · System Recall</span>
      <strong>整个 System 已完成，进入系统级闭卷重建。</strong>
      <small>Recall 是独立工作区；完成后再进入训练。</small>
    </div>
    <a href={`${base}xizong/${system.systemId}/recall/`}>进入 System Recall</a>
  </section>

  <XizongRuntimeStageGuard system={system} />
</Base>
