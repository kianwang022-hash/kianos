---
import Base from '../../../layouts/Base.astro';
import XizongSystemV6 from '../../../components/XizongSystemV6.astro';
import XizongSystemExitRuntime from '../../../components/XizongSystemExitRuntime.astro';
import XizongQuestionCrosswalkConsumer from '../../../components/XizongQuestionCrosswalkConsumer.astro';
import XizongSystemRepairReturn from '../../../components/XizongSystemRepairReturn.astro';
import XizongSystemEvidenceGuard from '../../../components/XizongSystemEvidenceGuard.astro';
import XizongLastLocation from '../../../components/XizongLastLocation.astro';
import XizongRuntimeStageGuard from '../../../components/XizongRuntimeStageGuard.astro';
import { listProjectableXizongSystems, loadXizongSystem } from '../../../lib/xizong.mjs';
import { loadXizongPathways } from '../../../lib/xizongPathways.mjs';
import { loadXizongSystemQuestionSweep } from '../../../lib/xizongQuestions.mjs';
import '../../../styles/xizong-system-workspace.css';
import '../../../styles/xizong-peripheral-workspaces.css';

export function getStaticPaths() {
  return listProjectableXizongSystems().map((system) => ({ params: { system: system.systemId }, props: { systemId: system.systemId } }));
}

const { systemId } = Astro.props;
const system = loadXizongSystem(systemId);
const pathways = loadXizongPathways(system);
const questionSweep = loadXizongSystemQuestionSweep(system);
---
<Base title={system.title} kicker={`西医综合 · ${system.canonicalId} · System Learn`} description={system.mission} sourcePath={system.sourcePath} sourceHash={system.sourceHash} objectId={`xizong:${system.systemId}`} active="xizong" showLead={false}>
  <XizongLastLocation system={system} />
  <XizongSystemV6 system={system} pathways={pathways} />
  {questionSweep && (
    <details class="xizongLaterStage" data-xizong-later-stage="system-exit">
      <summary>
        <span>后面阶段 · System Exit</span>
        <strong>学完整个系统后，再做 System Recall + 系统真题</strong>
        <small>{questionSweep.questionCount} 道系统真题已准备好；现在不用占注意力。</small>
      </summary>
      <XizongSystemExitRuntime system={system} sweep={questionSweep} />
      <XizongQuestionCrosswalkConsumer system={system} />
      <XizongSystemRepairReturn system={system} />
      <XizongSystemEvidenceGuard system={system} sweep={questionSweep} />
    </details>
  )}
  <XizongRuntimeStageGuard system={system} />

  <script>
    // Presentation/integration fallback only. XizongSystemExitRuntime remains the
    // owner of Recall state, reveal/completion, holdout and official-question flow.
    // If its direct button listener already opened the dialog, this is a no-op.
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const button = target.closest('[data-xizong-system-exit] [data-start-recall]');
      if (!(button instanceof HTMLElement)) return;
      const root = button.closest('[data-xizong-system-exit]');
      const dialog = root?.querySelector('[data-recall-dialog]');
      if (!(dialog instanceof HTMLDialogElement) || dialog.open) return;
      const front = dialog.querySelector('[data-recall-front]');
      const reveal = dialog.querySelector('[data-recall-reveal]');
      if (front instanceof HTMLElement) front.hidden = false;
      if (reveal instanceof HTMLElement) reveal.hidden = true;
      try {
        dialog.showModal();
      } catch {
        dialog.setAttribute('open', '');
      }
    });
  </script>
</Base>

<style is:global>
  /* System Recall belongs after the System has actually been learned. The full
     recall surface remains available inside the later System Exit workspace. */
  .xv6SystemContext .xv6RecallCompact{display:none}
  .xv6SystemContext .xv6SystemKeys p:last-child{display:none}

  .xizongLaterStage{margin-top:14px;border:1px solid var(--study-line,#d9dde5);border-radius:14px;background:#fff;overflow:hidden}
  .xizongLaterStage>summary{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:6px 14px;align-items:center;padding:12px 15px;cursor:pointer;list-style:none}
  .xizongLaterStage>summary::-webkit-details-marker{display:none}
  .xizongLaterStage>summary::before{content:'›';grid-row:1 / span 2;color:var(--study-green,#286c57);font-size:18px;font-weight:900;transition:transform .15s ease}
  .xizongLaterStage[open]>summary::before{transform:rotate(90deg)}
  .xizongLaterStage>summary span{color:var(--study-green,#286c57);font-size:15px;font-weight:850;letter-spacing:.02em}
  .xizongLaterStage>summary strong{font-size:16px}
  .xizongLaterStage>summary small{grid-column:3;color:var(--study-muted,#6d7873);font-size:15px}
  .xizongLaterStage[open]>summary{border-bottom:1px solid var(--study-line,#d9dde5);background:#f7faf8}
  .xizongLaterStage>.xse{margin:12px}
  @media(max-width:760px){.xizongLaterStage>summary{grid-template-columns:auto minmax(0,1fr)}.xizongLaterStage>summary small{grid-column:2}}
</style>
