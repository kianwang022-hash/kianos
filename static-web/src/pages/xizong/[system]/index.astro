---
import Base from '../../../layouts/Base.astro';
import XizongSystemV6 from '../../../components/XizongSystemV6.astro';
import { listProjectableXizongSystems, loadXizongSystem } from '../../../lib/xizong.mjs';
import { loadXizongPathways } from '../../../lib/xizongPathways.mjs';

export function getStaticPaths() {
  return listProjectableXizongSystems().map((system) => ({ params: { system: system.systemId }, props: { systemId: system.systemId } }));
}

const { systemId } = Astro.props;
const system = loadXizongSystem(systemId);
const pathways = loadXizongPathways(system);
---
<Base title={system.title} kicker={`西医综合 · ${system.canonicalId} · System Learn`} description={system.mission} sourcePath={system.sourcePath} sourceHash={system.sourceHash} objectId={`xizong:${system.systemId}`} active="xizong">
  <XizongSystemV6 system={system} pathways={pathways} />
</Base>