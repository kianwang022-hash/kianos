---
import Base from '../../../layouts/Base.astro';
import XizongSystemWorkspace from '../../../components/XizongSystemWorkspace.astro';
import XizongSystemExitRuntime from '../../../components/XizongSystemExitRuntime.astro';
import XizongQuestionCrosswalkConsumer from '../../../components/XizongQuestionCrosswalkConsumer.astro';
import XizongSystemRepairReturn from '../../../components/XizongSystemRepairReturn.astro';
import XizongSystemEvidenceGuard from '../../../components/XizongSystemEvidenceGuard.astro';
import XizongLastLocation from '../../../components/XizongLastLocation.astro';
import XizongRuntimeStageGuard from '../../../components/XizongRuntimeStageGuard.astro';
import { listProjectableXizongSystems, loadXizongSystem } from '../../../lib/xizong.mjs';
import { loadXizongPathways } from '../../../lib/xizongPathways.mjs';
import { loadXizongSystemQuestionSweep } from '../../../lib/xizongQuestions.mjs';
import '../../../styles/xizong-system-workspace.css';

export function getStaticPaths() {
  return listProjectableXizongSystems().map((system) => ({ params: { system: system.systemId }, props: { systemId: system.systemId } }));
}

const { systemId } = Astro.props;
const system = loadXizongSystem(systemId);
const pathways = loadXizongPathways(system);
const questionSweep = loadXizongSystemQuestionSweep(system);
---
<Base title={system.title} kicker={`西医综合 · ${system.canonicalId} · System Learn`} description={system.mission} sourcePath={system.sourcePath} sourceHash={system.sourceHash} objectId={`xizong:${system.systemId}`} active="xizong" showLead={false}>
  <XizongLastLocation system={system} />
  <XizongSystemWorkspace system={system} pathways={pathways} />
  {questionSweep && (
    <details class="xizongLaterStage" data-xizong-later-stage="system-exit">
      <summary>
        <span>后面阶段 · System Exit</span>
        <strong>学完整个系统后，再做 System Recall + 系统真题</strong>
        <small>{questionSweep.questionCount} 道系统真题已准备好；现在不用占注意力。</small>
      </summary>
      <XizongSystemExitRuntime system={system} sweep={questionSweep} />
      <XizongQuestionCrosswalkConsumer system={system} />
      <XizongSystemRepairReturn system={system} />
      <XizongSystemEvidenceGuard system={system} sweep={questionSweep} />
    </details>
  )}
  <XizongRuntimeStageGuard system={system} />
</Base>
