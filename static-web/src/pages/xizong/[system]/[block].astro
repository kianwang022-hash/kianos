---
import { marked } from 'marked';
import Base from '../../../layouts/Base.astro';
import XizongBlockV6 from '../../../components/XizongBlockV6.astro';
import XizongQuestionCrosswalkReverse from '../../../components/XizongQuestionCrosswalkReverse.astro';
import XizongConnectionCues from '../../../components/XizongConnectionCues.astro';
import XizongPrecisionVisualCues from '../../../components/XizongPrecisionVisualCues.astro';
import XizongExtensionAssets from '../../../components/XizongExtensionAssets.astro';
import XizongStudyEnhancer from '../../../components/XizongStudyEnhancer.astro';
import XizongMemoryReviewV6 from '../../../components/XizongMemoryReviewV6.astro';
import XizongBlockEvidenceGuard from '../../../components/XizongBlockEvidenceGuard.astro';
import XizongRepairInboxBridge from '../../../components/XizongRepairInboxBridge.astro';
import XizongLastLocation from '../../../components/XizongLastLocation.astro';
import XizongRuntimeStageGuard from '../../../components/XizongRuntimeStageGuard.astro';
import { listProjectableXizongSystems, loadXizongBlock, loadXizongSystem } from '../../../lib/xizong.mjs';
import { loadXizongQuestionCrosswalkForBlock } from '../../../lib/xizongQuestionCrosswalk.mjs';
import { loadXizongPathways, pathwaysForBlock } from '../../../lib/xizongPathways.mjs';
import { loadXizongLearningCues, learningCuesForBlock } from '../../../lib/xizongLearningCues.mjs';
import { projectBlockLearn, projectKpCore, projectVisualGate } from '../../../lib/xizongProjection.mjs';
import { buildXizongProductionBlock } from '../../../lib/xizongProductionProjection.mjs';

export function getStaticPaths() {
  return listProjectableXizongSystems().flatMap((system) => system.blocks.map((block) => ({
    params: { system: system.systemId, block: block.slug },
    props: { systemId: system.systemId, blockSlug: block.slug }
  })));
}

const { systemId, blockSlug } = Astro.props;
const canonicalBlock = loadXizongBlock(systemId, blockSlug);
const system = loadXizongSystem(systemId);
const productionBlock = buildXizongProductionBlock(canonicalBlock);
const crosswalk = loadXizongQuestionCrosswalkForBlock(canonicalBlock);
const pathways = loadXizongPathways(system);
const blockPathways = pathwaysForBlock(pathways, canonicalBlock.blockId);
const learningCues = loadXizongLearningCues(system);
const blockLearningCues = learningCuesForBlock(learningCues, canonicalBlock);
const projection = {
  ...productionBlock,
  pathways: blockPathways,
  learningCues: blockLearningCues,
  blockLearnHtml: marked.parse(projectBlockLearn(canonicalBlock.blockLearnMarkdown), { gfm: true }),
  visualGateHtml: canonicalBlock.visualGateMarkdown ? marked.parse(projectVisualGate(canonicalBlock.visualGateMarkdown), { gfm: true }) : '',
  kpRecords: productionBlock.kpRecords.map((kp) => ({ ...kp, detailHtml: marked.parse(projectKpCore(kp.detailMarkdown), { gfm: true }) }))
};
const block = projection;
---
<Base title={`${canonicalBlock.label} · ${canonicalBlock.title}`} kicker={`西医综合 · ${canonicalBlock.systemCanonicalId} · ${canonicalBlock.label}`} description={canonicalBlock.centerQuestion} sourcePath={canonicalBlock.sourcePath} sourceHash={canonicalBlock.sourceHash} objectId={canonicalBlock.objectId} active="xizong">
  <XizongLastLocation system={system} block={canonicalBlock} />
  <XizongBlockV6 block={projection} />
  <XizongQuestionCrosswalkReverse crosswalk={crosswalk} />
  <XizongRuntimeStageGuard system={system} block={block} />
  <XizongConnectionCues block={projection} />
  <XizongPrecisionVisualCues block={projection} />
  <XizongExtensionAssets block={projection} />
  <XizongStudyEnhancer block={projection} />
  <XizongMemoryReviewV6 block={projection} />
  <XizongBlockEvidenceGuard block={projection} />
  <XizongRepairInboxBridge block={projection} />
</Base>
