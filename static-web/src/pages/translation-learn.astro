---
import fs from 'node:fs';
import crypto from 'node:crypto';
import { marked } from 'marked';
import EnglishBase from '../layouts/EnglishBase.astro';

const sourcePath = 'content/english/modules/translation/learning.md';
const sourceUrl = new URL(`../../../${sourcePath}`, import.meta.url);
const markdown = fs.readFileSync(sourceUrl, 'utf8');
const sourceHash = crypto.createHash('sha256').update(markdown).digest('hex');
const base = import.meta.env.BASE_URL;

const chunks = markdown.split(/(?=^# [A-H](?:\d)?｜)/gm);
const intro = chunks.shift() || '';
const chunkMap = new Map();
for (const chunk of chunks) {
  const match = chunk.match(/^# ([A-H](?:\d)?)｜/m);
  if (match) chunkMap.set(match[1], chunk);
}

const nav = [
  ['A', '整体方法'],
  ['B1', 'B1 · Representation'],
  ['B3', 'B3 · Reconstruction'],
  ['B4', 'B4 · Execution'],
  ['B5', 'Integrated Walkthrough'],
  ['F', 'How You Learn It'],
  ['G', '第一次学习出口']
];
const coreKeys = ['A', 'B', 'B1', 'B3', 'B4', 'B5', 'F', 'G'];
const diagnosticKeys = ['B2', 'C', 'D'];
const runtimeKeys = ['E', 'H'];

async function renderChunk(key) {
  const source = chunkMap.get(key) || '';
  return source ? await marked.parse(source, { gfm: true, breaks: false }) : '';
}

const introHtml = await marked.parse(intro, { gfm: true, breaks: false });
const coreSections = await Promise.all(coreKeys.map(async (key) => ({ key, html: await renderChunk(key) })));
const diagnosticSections = await Promise.all(diagnosticKeys.map(async (key) => ({ key, html: await renderChunk(key) })));
const runtimeSections = await Promise.all(runtimeKeys.map(async (key) => ({ key, html: await renderChunk(key) })));
---
<EnglishBase
  title="Translation Guide"
  kicker="English · Translation · Guide"
  description="理解英文 → 忠实重建 → 考场表达；会的直接跳，卡住再回来。"
  sourcePath={sourcePath}
  sourceHash={sourceHash}
  objectId="english:translation-first-learning"
  active="home"
>
  <section class="translationLearnShell">
    <aside class="translationLearnNav">
      <span>学习框架</span>
      <strong>三块主干，够用就进真题</strong>
      <p>先看懂整体方法，再只补当前不稳的能力。已经会的直接跳；进阶内容不是待办清单。</p>
      <nav aria-label="Translation First Learning navigation">
        {nav.map(([key, label]) => <a href={`#translation-${key.toLowerCase()}`}>{label}</a>)}
      </nav>
      <a class="runtimeLink" href={`${base}translation/`}>直接进入 Translation →</a>
    </aside>

    <main class="translationLearnMain">
      <section class="translationLearnIntro markdownBody" set:html={introHtml}></section>

      <section class="translationPathStrip" aria-label="Translation learning path">
        <span>REPRESENT</span><b>→</b><span>RECONSTRUCT <em>faithfully</em></span><b>→</b><span>DELIVER</span>
      </section>

      {coreSections.map((section) => section.html && (
        <section id={`translation-${section.key.toLowerCase()}`} class="translationLearnContent markdownBody" set:html={section.html}></section>
      ))}

      <details class="translationReferenceSection">
        <summary>
          <div><span>按需展开</span><strong>忠实度检查 + 进阶技巧</strong></div>
          <small>只有真实失真或反复出错时才回来；这里只是参考，不要求一次学完。</small>
        </summary>
        <div class="translationReferenceBody">
          {diagnosticSections.map((section) => section.html && (
            <section id={`translation-${section.key.toLowerCase()}`} class="markdownBody" set:html={section.html}></section>
          ))}
        </div>
      </details>

      <details class="translationReferenceSection runtimeReference">
        <summary>
          <div><span>深入参考</span><strong>材料选择与练习方式</strong></div>
          <small>这些内容只在需要理解练习方式或和 Chat 深挖时展开。</small>
        </summary>
        <div class="translationReferenceBody">
          {runtimeSections.map((section) => section.html && (
            <section id={`translation-${section.key.toLowerCase()}`} class="markdownBody" set:html={section.html}></section>
          ))}
        </div>
      </details>

      <a class="translationExit" href={`${base}translation/`}>
        <span>回到练习</span>
        <strong>能稳定读准 → 重建 → 表达，就进入真实 Translation</strong>
        <p>真实完整翻译才是主线；只有反复影响表现的问题才值得回来深挖。</p>
      </a>
    </main>
  </section>
</EnglishBase>

<style>
  .translationLearnShell{max-width:86rem;margin:0 auto;display:grid;grid-template-columns:17rem minmax(0,1fr);gap:16px;align-items:start}.translationLearnNav{position:sticky;top:76px;display:grid;gap:9px;padding:16px;border:1px solid var(--study-line);border-radius:14px;background:#fff;box-shadow:var(--study-shadow)}.translationLearnNav>span,.translationReferenceSection summary span,.translationExit>span{color:var(--study-green);font-size:9px;font-weight:850;letter-spacing:.08em;text-transform:uppercase}.translationLearnNav>strong{font-size:14px}.translationLearnNav>p{margin:0;color:var(--study-muted);font-size:10px;line-height:1.6}.translationLearnNav nav{display:grid;gap:2px;padding:8px 0;border-top:1px solid var(--study-line);border-bottom:1px solid var(--study-line)}.translationLearnNav nav a{padding:6px 7px;border-radius:7px;color:inherit;font-size:10px;font-weight:750;text-decoration:none}.translationLearnNav nav a:hover{background:var(--study-green-soft);color:var(--study-green)}.runtimeLink{color:var(--study-green);font-size:10px;font-weight:850;text-decoration:none}.translationLearnMain{display:grid;gap:12px;min-width:0}.translationLearnIntro,.translationLearnContent,.translationReferenceSection,.translationExit{padding:28px 34px;border:1px solid var(--study-line);border-radius:16px;background:#fff;box-shadow:var(--study-shadow)}.translationLearnIntro{padding-bottom:18px}.translationPathStrip{display:flex;align-items:center;justify-content:center;gap:9px;padding:12px;border:1px solid #cfe2d8;border-radius:12px;background:var(--study-green-soft);color:var(--study-green);font-size:10px;font-weight:850;letter-spacing:.04em}.translationPathStrip b{color:var(--study-faint)}.translationPathStrip em{font-style:normal;font-weight:650;opacity:.72}.translationReferenceSection{padding:0;overflow:hidden}.translationReferenceSection summary{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:18px 22px;cursor:pointer;list-style:none}.translationReferenceSection summary::-webkit-details-marker{display:none}.translationReferenceSection summary>div{display:grid;gap:3px}.translationReferenceSection summary strong{font-size:14px}.translationReferenceSection summary small{max-width:34rem;color:var(--study-muted);font-size:10px;line-height:1.5;text-align:right}.translationReferenceBody{display:grid;gap:0;padding:0 28px 26px;border-top:1px solid var(--study-line)}.translationReferenceBody>.markdownBody{padding-top:22px}.runtimeReference{background:#fbfdfc}.translationExit{display:grid;gap:4px;color:inherit;text-decoration:none;border-color:#bdd8c8;background:var(--study-green-soft)}.translationExit strong{font-size:18px}.translationExit p{margin:0;color:var(--study-muted);font-size:11px;line-height:1.55}
  .markdownBody :global(h1){margin:2.5rem 0 .9rem;padding-top:.2rem;font-size:27px;line-height:1.28;letter-spacing:-.02em;scroll-margin-top:90px}.translationLearnContent :global(h1:first-child),.translationReferenceBody .markdownBody :global(h1:first-child){margin-top:0}.markdownBody :global(h2){margin:2rem 0 .7rem;font-size:19px;line-height:1.35}.markdownBody :global(h3){margin:1.45rem 0 .5rem;font-size:15px}.markdownBody :global(p),.markdownBody :global(li){font-size:13.5px;line-height:1.86;color:#26352f}.markdownBody :global(p){margin:.62rem 0}.markdownBody :global(ul),.markdownBody :global(ol){padding-left:1.4rem}.markdownBody :global(blockquote){margin:1rem 0;padding:10px 14px;border-left:3px solid var(--study-green);background:var(--study-green-soft);border-radius:0 9px 9px 0;color:#1e3129}.markdownBody :global(blockquote p){margin:.25rem 0;color:inherit}.markdownBody :global(strong){color:#16251f}.markdownBody :global(pre){overflow:auto;margin:1rem 0;padding:14px 16px;border:1px solid var(--study-line);border-radius:11px;background:#f7f9f7;font-size:12px;line-height:1.6}.markdownBody :global(code){font-size:.92em}.markdownBody :global(hr){border:0;border-top:1px solid var(--study-line);margin:2.2rem 0}
  @media(max-width:920px){.translationLearnShell{grid-template-columns:1fr}.translationLearnNav{position:static}.translationLearnNav nav{grid-template-columns:repeat(2,minmax(0,1fr))}.translationLearnIntro,.translationLearnContent{padding:22px 20px}.translationReferenceSection summary{align-items:flex-start;flex-direction:column}.translationReferenceSection summary small{text-align:left}.translationReferenceBody{padding:0 20px 22px}}@media(max-width:560px){.translationLearnNav nav{grid-template-columns:1fr}.translationPathStrip{flex-wrap:wrap}.translationLearnIntro,.translationLearnContent{padding:18px 14px}.translationReferenceBody{padding:0 14px 18px}.markdownBody :global(h1){font-size:23px}.markdownBody :global(h2){font-size:18px}.markdownBody :global(p),.markdownBody :global(li){font-size:13px;line-height:1.78}}
</style>