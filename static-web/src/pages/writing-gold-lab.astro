---
import { marked } from 'marked';
import Base from '../layouts/Base.astro';
import { loadWritingLearningProjection } from '../lib/englishWritingLearning.mjs';

const projection = loadWritingLearningProjection();
if (projection.status !== 'ready') throw new Error(`WRITING_LEARNING_PROJECTION_NOT_READY:${projection.issues.join(',')}`);
const base = import.meta.env.BASE_URL;
const render = async (markdown) => await marked.parse(markdown, { gfm: true, breaks: false });
const blocks = await Promise.all(projection.blocks.map(async (block) => ({ ...block, html: await render(block.markdown) })));
const views = [
  { id: 'global-map', code: 'MAP', title: 'Global Map', subtitle: '先看整条生成链', html: `${await render(projection.globalMap)}${await render(projection.coreIntro)}` },
  ...blocks.map((block, index) => ({ id: block.id, code: `B${index + 1}`, title: block.title.replace(/^B\d+｜/, ''), subtitle: ['Task / Genre','Content','Development','English','Register / Error','Execution'][index], html: block.html })),
  { id: 'modes', code: 'MODES', title: 'Small / Big Writing', subtitle: '同一主干的任务分叉', html: await render(projection.modeSpecializations) },
  { id: 'practice', code: 'ENTRY', title: 'Practice / Entry', subtitle: '需要时校准，再回真实 Writing', html: `${await render(projection.syntheticPractice)}${await render(projection.trueExamEntryGate)}` }
];
const chain = [['TASK','任务'],['GENERATE','内容'],['ORGANIZE','推进'],['REALIZE','实现'],['CONTROL','控制'],['DELIVER','交付']];
---
<Base title="Writing Gold Lab" kicker="KianOS UI Productization · Gold Surface 01" description="同一份 Current Writing Content 的三种结构实现。比较信息架构与空间关系，不比较换皮。" sourcePath={projection.sourcePath} sourceHash={projection.sourceHash} objectId="ui:writing:gold-lab" active="home">
  <section class="goldLab" data-gold-lab>
    <header class="goldLabTopbar">
      <div><span>Writing Gold Lab</span><h1>同一份知识，三种工作空间。</h1><p>这里只比较 Projection：什么同时出现、什么退到背景、怎么定位、怎么继续。学习语义和 Content 不变。</p></div>
      <nav aria-label="Gold variants"><button type="button" class="active" data-gold-variant="editorial"><b>A</b><span>Editorial Spine</span></button><button type="button" data-gold-variant="canvas"><b>B</b><span>Cognitive Canvas</span></button><button type="button" data-gold-variant="focus"><b>C</b><span>Focused Workspace</span></button></nav>
    </header>

    <section class="goldVariant editorial" data-gold-surface="editorial">
      <aside class="editorialRail"><a class="goldBack" href={`${base}writing-learn/`}>← 当前 Writing</a><div class="railTitle"><span>生成主干</span><strong>从任务到交付</strong></div><div class="railChain">{chain.map(([code,label],index)=><div><i>{index+1}</i><span><b>{code}</b><small>{label}</small></span></div>)}</div><nav aria-label="Editorial route">{views.map((view)=><button type="button" data-gold-route={view.id}><b>{view.code}</b><span>{view.title}</span></button>)}</nav></aside>
      <main class="editorialMain"><header class="editorialHeader"><span>Variant A · Editorial Spine</span><strong>像一本会导航的教材，但不把知识切成卡片。</strong><p>持续阅读是主体验；左侧只负责位置和主轴。适合长内容、连续理解、低疲劳。</p></header>{views.map((view,index)=><article class="goldContent editorialContent" data-gold-panel={view.id} hidden={index!==0}><header><span>{view.code}</span><div><h2>{view.title}</h2><p>{view.subtitle}</p></div></header><div class="goldMarkdown" set:html={view.html}></div></article>)}</main>
      <aside class="editorialInspector"><span>Return path</span><strong>学到够用，就回真实 Writing。</strong><p>这不是一门必须刷完的课。稳定 primitive 可以跳过；真正卡住再回来。</p><a href={`${base}writing/`}>进入 Writing Runtime →</a><div><small>当前定位</small><b data-gold-current-label>Global Map</b></div></aside>
    </section>

    <section class="goldVariant canvas" data-gold-surface="canvas" hidden>
      <header class="canvasMap"><div class="canvasIdentity"><span>Variant B · Cognitive Canvas</span><strong>先看关系，再下钻当前 primitive。</strong></div><div class="canvasChain" aria-label="Writing generation chain">{chain.map(([code,label],index)=><button type="button" data-gold-route={`b${index+1}`}><i>{index+1}</i><span><b>{code}</b><small>{label}</small></span></button>)}</div></header>
      <div class="canvasWorkspace"><nav class="canvasRoute" aria-label="Canvas route">{views.map((view)=><button type="button" data-gold-route={view.id}><b>{view.code}</b><span>{view.title}</span><small>{view.subtitle}</small></button>)}</nav><main class="canvasStage">{views.map((view,index)=><article class="goldContent canvasContent" data-gold-panel={view.id} hidden={index!==0}><header><span>{view.code}</span><h2>{view.title}</h2><p>{view.subtitle}</p></header><div class="goldMarkdown" set:html={view.html}></div></article>)}</main><aside class="canvasInspector"><span>Context</span><strong data-gold-current-label>Global Map</strong><p>右侧只保留当前真正有用的定位与下一动作，不做第二份教材。</p><div class="canvasDecision"><small>如果这里已经稳定</small><a href={`${base}writing/`}>直接去写 →</a></div><div class="canvasDecision muted"><small>如果只是想换 primitive</small><span>从左侧 Route 或上方主轴切换</span></div></aside></div>
    </section>

    <section class="goldVariant focus" data-gold-surface="focus" hidden>
      <header class="focusBar"><a href={`${base}writing-learn/`}>Writing</a><div><span>Variant C · Focused Workspace</span><b data-gold-current-label>Global Map</b></div><a class="focusRuntime" href={`${base}writing/`}>去写 →</a></header>
      <nav class="focusRoute" aria-label="Focused route">{views.map((view)=><button type="button" data-gold-route={view.id}><b>{view.code}</b><span>{view.title}</span></button>)}</nav>
      <main class="focusStage">{views.map((view,index)=><article class="goldContent focusContent" data-gold-panel={view.id} hidden={index!==0}><header><span>{view.code}</span><h2>{view.title}</h2><p>{view.subtitle}</p></header><div class="goldMarkdown" set:html={view.html}></div></article>)}</main>
      <footer class="focusControls"><button type="button" data-gold-prev>← 上一块</button><span>只让当前 primitive 占据主舞台。其余信息通过位置条和路由保持可见。</span><button type="button" data-gold-next>下一块 →</button></footer>
    </section>

    <footer class="goldLabFooter"><span>比较重点：第一眼主轴｜阅读负担｜切换摩擦｜是否把逻辑画出来｜是否愿意长期用</span><a href={`${base}writing-learn/`}>回到当前 Functional First 页面</a></footer>
  </section>
</Base>

<script>
  const root=document.querySelector('[data-gold-lab]');
  if(root instanceof HTMLElement){
    const variants=[...root.querySelectorAll('[data-gold-surface]')],variantButtons=[...root.querySelectorAll('[data-gold-variant]')],routeButtons=[...root.querySelectorAll('[data-gold-route]')],panels=[...root.querySelectorAll('[data-gold-panel]')],labels=[...root.querySelectorAll('[data-gold-current-label]')];
    const routeIds=[...new Set(panels.map((panel)=>panel.getAttribute('data-gold-panel')).filter(Boolean))],variantIds=variants.map((variant)=>variant.getAttribute('data-gold-surface')).filter(Boolean),routeTitle=new Map();
    routeButtons.forEach((button)=>{const id=button.getAttribute('data-gold-route'),title=button.querySelector('span')?.textContent?.trim()||id;if(id&&!routeTitle.has(id))routeTitle.set(id,title)});
    const variantKey='kianos:ui:writing-gold:variant:v1',routeKey='kianos:ui:writing-gold:route:v1';let activeVariant='editorial',activeRoute='global-map';
    const updateHash=()=>history.replaceState(null,'',`#${activeVariant}/${activeRoute}`);
    const renderState=({scroll=false}={})=>{variants.forEach((variant)=>{variant.hidden=variant.getAttribute('data-gold-surface')!==activeVariant});variantButtons.forEach((button)=>button.classList.toggle('active',button.getAttribute('data-gold-variant')===activeVariant));panels.forEach((panel)=>{panel.hidden=panel.getAttribute('data-gold-panel')!==activeRoute});routeButtons.forEach((button)=>button.classList.toggle('active',button.getAttribute('data-gold-route')===activeRoute));labels.forEach((label)=>{label.textContent=routeTitle.get(activeRoute)||activeRoute});try{localStorage.setItem(variantKey,activeVariant);localStorage.setItem(routeKey,activeRoute)}catch{}updateHash();if(scroll)root.querySelector(`[data-gold-surface="${activeVariant}"] [data-gold-panel="${activeRoute}"]`)?.scrollIntoView({behavior:'smooth',block:'start'})};
    variantButtons.forEach((button)=>button.addEventListener('click',()=>{const next=button.getAttribute('data-gold-variant')||'editorial';if(variantIds.includes(next))activeVariant=next;renderState()}));
    routeButtons.forEach((button)=>button.addEventListener('click',()=>{const next=button.getAttribute('data-gold-route')||'global-map';if(routeIds.includes(next))activeRoute=next;renderState({scroll:true})}));
    root.querySelector('[data-gold-prev]')?.addEventListener('click',()=>{const index=Math.max(0,routeIds.indexOf(activeRoute));activeRoute=routeIds[Math.max(0,index-1)]||routeIds[0];renderState({scroll:true})});
    root.querySelector('[data-gold-next]')?.addEventListener('click',()=>{const index=Math.max(0,routeIds.indexOf(activeRoute));activeRoute=routeIds[Math.min(routeIds.length-1,index+1)]||routeIds[0];renderState({scroll:true})});
    const [hashVariant,hashRoute]=location.hash.replace(/^#/,'').split('/');let savedVariant='',savedRoute='';try{savedVariant=localStorage.getItem(variantKey)||'';savedRoute=localStorage.getItem(routeKey)||''}catch{}activeVariant=variantIds.includes(hashVariant)?hashVariant:variantIds.includes(savedVariant)?savedVariant:'editorial';activeRoute=routeIds.includes(hashRoute)?hashRoute:routeIds.includes(savedRoute)?savedRoute:'global-map';renderState();
  }
</script>

<style>
.goldLab{max-width:92rem;margin:0 auto;display:grid;gap:16px;color:#17251f}.goldLabTopbar{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(28rem,.8fr);gap:24px;align-items:end;padding:4px 2px 16px;border-bottom:1px solid var(--study-line)}.goldLabTopbar>div{display:grid;gap:7px}.goldLabTopbar>div>span,.goldVariant>header span,.goldContent>header>span,.editorialInspector>span,.canvasInspector>span{font-size:11px;font-weight:850;letter-spacing:.07em;text-transform:uppercase;color:var(--study-green)}.goldLabTopbar h1{margin:0;font-size:34px;line-height:1.08;letter-spacing:-.03em}.goldLabTopbar p{max-width:56rem;margin:0;font-size:15px;line-height:1.65;color:#53635b}.goldLabTopbar nav{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.goldLabTopbar nav button{display:grid;gap:3px;padding:11px 12px;border:1px solid transparent;border-radius:10px;background:transparent;text-align:left;color:inherit;cursor:pointer}.goldLabTopbar nav button b{font-size:11px}.goldLabTopbar nav button span{font-size:12px;color:#65746c}.goldLabTopbar nav button.active{border-color:var(--study-line);background:#fff;box-shadow:var(--study-shadow)}.goldVariant[hidden],.goldContent[hidden]{display:none!important}.goldVariant{min-height:70vh}
.editorial{display:grid;grid-template-columns:14.5rem minmax(0,1fr) 17rem;gap:28px;align-items:start}.editorialRail{position:sticky;top:72px;display:grid;gap:18px;padding:14px 0}.goldBack{font-size:12px;font-weight:750;color:var(--study-green);text-decoration:none}.railTitle{display:grid;gap:2px}.railTitle span{font-size:10px;color:#7a8a81}.railTitle strong{font-size:18px}.railChain{display:grid;gap:0}.railChain>div{position:relative;display:grid;grid-template-columns:24px 1fr;gap:9px;padding:5px 0}.railChain>div:not(:last-child)::after{content:'';position:absolute;left:11px;top:28px;bottom:-4px;width:1px;background:#ccd7d1}.railChain i{display:grid;place-items:center;width:22px;height:22px;border:1px solid #becbc4;border-radius:50%;font-size:10px;font-style:normal}.railChain span{display:grid}.railChain b{font-size:10px;letter-spacing:.04em}.railChain small{font-size:10px;color:#74837b}.editorialRail nav{display:grid;border-top:1px solid var(--study-line)}.editorialRail nav button{display:grid;grid-template-columns:3.2rem 1fr;gap:8px;padding:9px 2px;border:0;border-bottom:1px solid #eef2ef;background:transparent;color:inherit;text-align:left;cursor:pointer}.editorialRail nav button b{font-size:10px;color:#77867e}.editorialRail nav button span{font-size:12px}.editorialRail nav button.active,.editorialRail nav button.active b{color:var(--study-green)}.editorialMain{min-width:0;display:grid;gap:18px}.editorialHeader{display:grid;gap:5px;padding:8px 0 18px;border-bottom:1px solid var(--study-line)}.editorialHeader strong{font-size:20px}.editorialHeader p{max-width:48rem;margin:0;font-size:13px;line-height:1.65;color:#66756d}.editorialContent{padding:4px 0 40px}.editorialContent>header{display:grid;grid-template-columns:4.5rem 1fr;gap:12px;margin-bottom:22px}.editorialContent h2{margin:0;font-size:26px}.editorialContent header p{margin:3px 0 0;color:#697970;font-size:12px}.editorialInspector{position:sticky;top:86px;display:grid;gap:10px;padding:17px 0 17px 18px;border-left:1px solid var(--study-line)}.editorialInspector strong{font-size:16px;line-height:1.35}.editorialInspector p{margin:0;font-size:12px;line-height:1.65;color:#65756d}.editorialInspector a{font-size:12px;font-weight:850;color:var(--study-green);text-decoration:none}.editorialInspector>div{display:grid;gap:3px;margin-top:14px;padding-top:12px;border-top:1px solid #e4ebe7}.editorialInspector small{font-size:10px;color:#819087}.editorialInspector b{font-size:12px}
.canvas{display:grid;gap:14px}.canvasMap{display:grid;gap:14px;padding:16px 18px;border:1px solid var(--study-line);border-radius:14px;background:#fff;box-shadow:var(--study-shadow)}.canvasIdentity{display:flex;align-items:baseline;justify-content:space-between;gap:20px}.canvasIdentity strong{font-size:16px}.canvasChain{display:grid;grid-template-columns:repeat(6,1fr)}.canvasChain button{position:relative;display:grid;grid-template-columns:26px 1fr;gap:7px;align-items:center;padding:8px 9px;border:0;background:transparent;color:inherit;text-align:left;cursor:pointer}.canvasChain button:not(:last-child)::after{content:'→';position:absolute;right:-3px;color:#9ba9a1}.canvasChain button i{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:#eef4f0;font-size:10px;font-style:normal}.canvasChain button span{display:grid}.canvasChain button b{font-size:10px}.canvasChain button small{font-size:9px;color:#76857d}.canvasChain button.active i{background:var(--study-green);color:#fff}.canvasChain button.active b{color:var(--study-green)}.canvasWorkspace{display:grid;grid-template-columns:15rem minmax(0,1fr) 18rem;gap:12px;align-items:start}.canvasRoute,.canvasInspector,.canvasStage{border:1px solid var(--study-line);border-radius:14px;background:#fff;box-shadow:var(--study-shadow)}.canvasRoute{position:sticky;top:72px;display:grid;overflow:hidden}.canvasRoute button{display:grid;grid-template-columns:3.5rem 1fr;grid-template-areas:'code title' 'code note';gap:1px 8px;padding:11px 12px;border:0;border-bottom:1px solid #edf1ef;background:transparent;color:inherit;text-align:left;cursor:pointer}.canvasRoute b{grid-area:code;align-self:start;font-size:10px;color:#89978f}.canvasRoute span{grid-area:title;font-size:12px;font-weight:750}.canvasRoute small{grid-area:note;font-size:9px;color:#84928a}.canvasRoute button.active{background:var(--study-green-soft)}.canvasRoute button.active b,.canvasRoute button.active span{color:var(--study-green)}.canvasStage{min-width:0;padding:24px 30px}.canvasContent>header{display:grid;grid-template-columns:auto 1fr;grid-template-areas:'code title' 'code note';column-gap:12px;padding-bottom:15px;margin-bottom:15px;border-bottom:1px solid var(--study-line)}.canvasContent>header>span{grid-area:code;padding-top:4px}.canvasContent h2{grid-area:title;margin:0;font-size:24px}.canvasContent header p{grid-area:note;margin:2px 0 0;font-size:11px;color:#74837a}.canvasInspector{position:sticky;top:72px;display:grid;gap:9px;padding:16px}.canvasInspector>strong{font-size:18px}.canvasInspector>p{margin:0 0 8px;font-size:11px;line-height:1.6;color:#718077}.canvasDecision{display:grid;gap:3px;padding-top:11px;border-top:1px solid #e5ebe8}.canvasDecision small{font-size:9px;color:#7c8a82}.canvasDecision a,.canvasDecision span{font-size:11px;font-weight:750;color:var(--study-green);text-decoration:none}.canvasDecision.muted span{color:#66756d;font-weight:600}
.focus{display:grid;grid-template-rows:auto auto minmax(32rem,auto) auto;gap:10px}.focusBar{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:9px 2px;border-bottom:1px solid var(--study-line)}.focusBar>a{font-size:12px;font-weight:750;color:var(--study-green);text-decoration:none}.focusBar>div{display:flex;gap:8px;align-items:center;justify-content:center}.focusBar>div span{font-size:10px!important}.focusBar>div b{font-size:12px}.focusRuntime{justify-self:end}.focusRoute{display:flex;gap:2px;justify-content:center;flex-wrap:wrap;padding:4px}.focusRoute button{display:flex;gap:6px;align-items:center;padding:7px 9px;border:0;border-radius:7px;background:transparent;color:inherit;cursor:pointer}.focusRoute button b{font-size:9px;color:#849189}.focusRoute button span{font-size:10px}.focusRoute button.active{background:var(--study-green-soft);color:var(--study-green)}.focusStage{display:grid;place-items:start center;padding:26px 0}.focusContent{width:min(70rem,100%)}.focusContent>header{max-width:52rem;margin:0 auto 22px;text-align:center}.focusContent h2{margin:4px 0 3px;font-size:30px}.focusContent header p{margin:0;color:#6e7d75;font-size:12px}.focusContent .goldMarkdown{max-width:58rem;margin:0 auto}.focusControls{position:sticky;bottom:10px;display:grid;grid-template-columns:auto 1fr auto;gap:16px;align-items:center;padding:9px 10px;border:1px solid var(--study-line);border-radius:12px;background:rgba(255,255,255,.96);box-shadow:var(--study-shadow);backdrop-filter:blur(12px)}.focusControls button{padding:7px 10px;border:0;border-radius:7px;background:var(--study-green-soft);color:var(--study-green);font:inherit;font-size:11px;font-weight:800;cursor:pointer}.focusControls span{text-align:center;font-size:9px;color:#738179}
.goldMarkdown :global(h1){font-size:25px}.goldMarkdown :global(h2){margin-top:1.8rem;font-size:20px}.goldMarkdown :global(h3){margin-top:1.4rem;font-size:16px}.goldMarkdown :global(p),.goldMarkdown :global(li){font-size:15px;line-height:1.78;color:#26352f}.goldMarkdown :global(blockquote){margin:1rem 0;padding:10px 14px;border-left:3px solid var(--study-green);background:var(--study-green-soft)}.goldMarkdown :global(pre){overflow:auto;padding:14px 16px;border:0;border-left:2px solid #c9d6cf;background:#f7faf8;font-size:13px;line-height:1.65}.goldMarkdown :global(table){width:100%;border-collapse:collapse;margin:1.2rem 0}.goldMarkdown :global(th),.goldMarkdown :global(td){padding:9px 10px;border-bottom:1px solid var(--study-line);text-align:left;font-size:13px;line-height:1.55}.goldMarkdown :global(strong){color:#17251f}.goldLabFooter{display:flex;justify-content:space-between;gap:20px;padding:15px 2px;border-top:1px solid var(--study-line);font-size:10px;color:#74837b}.goldLabFooter a{color:var(--study-green);font-weight:750;text-decoration:none}
@media(max-width:1100px){.goldLabTopbar{grid-template-columns:1fr}.editorial{grid-template-columns:12rem minmax(0,1fr)}.editorialInspector{display:none}.canvasWorkspace{grid-template-columns:12rem minmax(0,1fr)}.canvasInspector{display:none}.canvasChain{grid-template-columns:repeat(3,1fr)}}@media(max-width:760px){.goldLabTopbar nav{grid-template-columns:1fr}.editorial,.canvasWorkspace{grid-template-columns:1fr}.editorialRail,.canvasRoute{position:static}.railChain{grid-template-columns:repeat(3,1fr)}.railChain>div:not(:last-child)::after{display:none}.editorialRail nav{grid-template-columns:repeat(3,1fr)}.editorialRail nav button{grid-template-columns:1fr}.canvasChain{grid-template-columns:repeat(2,1fr)}.canvasStage{padding:18px 15px}.focusBar{grid-template-columns:1fr auto}.focusBar>div{display:none}.focusControls{grid-template-columns:1fr 1fr}.focusControls span{display:none}.goldMarkdown :global(p),.goldMarkdown :global(li){font-size:14px}.goldLabFooter{flex-direction:column}}
</style>
