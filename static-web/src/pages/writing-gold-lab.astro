---
import { marked } from 'marked';
import Base from '../layouts/Base.astro';
import { loadWritingLearningProjection } from '../lib/englishWritingLearning.mjs';
import { listWritingRuntimeTasks, loadWritingRuntimeTask } from '../lib/englishWritingRuntimeTask.mjs';

const projection = loadWritingLearningProjection();
if (projection.status !== 'ready') throw new Error(`WRITING_LEARNING_PROJECTION_NOT_READY:${projection.issues.join(',')}`);
const taskSummary = listWritingRuntimeTasks()[0];
if (!taskSummary?.id) throw new Error('WRITING_GOLD_SYNTHETIC_TASK_MISSING');
const task = loadWritingRuntimeTask(taskSummary.id);
const base = import.meta.env.BASE_URL;
const coach = await Promise.all(projection.blocks.map(async (block, index) => ({
  id: block.id,
  code: `B${index + 1}`,
  title: block.title.replace(/^B\d+｜/, ''),
  short: ['Task / Genre','Content','Development','English','Register / Error','Execution'][index],
  html: await marked.parse(block.markdown, { gfm: true, breaks: false })
})));
const taskHref = `${base}writing/${encodeURIComponent(task.id)}/`;
const isSmall = task.kind === 'small';
---
<Base title="Writing Gold Lab" kicker="KianOS UI Productization · English Workbook" description="Task first. Attempt first. Coaching appears only when useful." sourcePath={task.sourcePath} sourceHash={task.sourceHash} objectId="ui:writing:gold-lab" active="home">
  <section class="goldLab" data-gold-lab data-task-id={task.id}>
    <header class="goldTop">
      <div><span>Writing Gold Lab · Logic-corrected</span><h1>先写，再在需要时叫出教练。</h1><p>English 不是知识浏览站。这里用同一个真实 synthetic Writing Task 比较三种 workbook composition；Prompt 和你的输出始终是主角，六个 primitive 只作为按需 repair reservoir。</p></div>
      <nav aria-label="Gold variants">
        <button type="button" class="active" data-gold-variant="split"><b>A</b><span>Split Workbook</span></button>
        <button type="button" data-gold-variant="desk"><b>B</b><span>Writing Desk</span></button>
        <button type="button" data-gold-variant="focus"><b>C</b><span>Focus + Drawer</span></button>
      </nav>
    </header>

    <section class="goldVariant split" data-gold-surface="split">
      <aside class="taskPane">
        <div class="paneLabel"><span>Task</span><b>{isSmall ? 'Small Writing' : 'Big Writing'} · {task.targetWords} words</b></div>
        {isSmall ? <><dl><div><dt>Role</dt><dd>{task.learnerTask.role}</dd></div><div><dt>Audience</dt><dd>{task.learnerTask.audience}</dd></div></dl><p>{task.learnerTask.background}</p><blockquote>{task.learnerTask.directions}</blockquote>{task.learnerTask.facts?.length ? <ul>{task.learnerTask.facts.map((fact) => <li>{fact}</li>)}</ul> : null}{task.learnerTask.register_hint && <small>{task.learnerTask.register_hint}</small>}</> : <><p class="visualScenario">{task.learnerTask.visual_scenario}</p><blockquote>{task.learnerTask.directions}</blockquote><small>{task.learnerTask.observation_boundary}</small></>}
        <a href={taskHref}>打开 Current Runtime →</a>
      </aside>
      <main class="workPane">
        <header><span>Attempt</span><h2>先留下自己的东西</h2><p>这里不提前展示框架答案。已经会写时直接 Draft；需要短计划时才写 Plan。</p></header>
        <label><span>Compact plan <small>optional</small></span><textarea rows="6" data-gold-plan placeholder="Task / core message / content atoms / order…"></textarea></label>
        <label class="draftField"><span>First draft</span><textarea rows="20" data-gold-draft placeholder="在这里完成整篇第一版…"></textarea></label>
      </main>
      <aside class="coachPane">
        <header><span>Coach</span><strong>哪里卡住，才打开哪里。</strong><p>六个 primitive 是诊断坐标，不是六章课程。</p></header>
        <nav>{coach.map((item) => <button type="button" data-coach-open={item.id}><b>{item.code}</b><span>{item.short}</span></button>)}</nav>
        <section class="coachContent"><p data-coach-empty>默认保持安静。写不下去、推进不动或表达失控时再调用。</p>{coach.map((item) => <article data-coach-panel={item.id} hidden><header><span>{item.code}</span><h3>{item.title}</h3></header><div class="coachMarkdown" set:html={item.html}></div><button type="button" data-coach-close>收起 Coach</button></article>)}</section>
      </aside>
    </section>

    <section class="goldVariant desk" data-gold-surface="desk" hidden>
      <header class="taskStrip"><div><span>{isSmall ? 'Small Writing' : 'Big Writing'} · {task.targetWords}</span><strong>{task.title}</strong></div><button type="button" data-desk-prompt>展开 / 收起 Prompt</button></header>
      <section class="deskPrompt" data-desk-prompt-body>{isSmall ? <><p>{task.learnerTask.background}</p><blockquote>{task.learnerTask.directions}</blockquote></> : <><p>{task.learnerTask.visual_scenario}</p><blockquote>{task.learnerTask.directions}</blockquote></>}</section>
      <div class="deskBody">
        <main class="paper"><label><span>Plan <small>optional</small></span><textarea rows="5" data-gold-plan placeholder="短计划；会写时可以直接跳到正文。"></textarea></label><label class="draftField"><span>Draft</span><textarea rows="23" data-gold-draft placeholder="像在真正答题纸上完成这一篇…"></textarea></label></main>
        <aside class="coachDock"><span>Need help?</span>{coach.map((item) => <button type="button" data-coach-open={item.id}><b>{item.code}</b><small>{item.short}</small></button>)}<section class="coachContent"><p data-coach-empty>Coach 不常驻正文。只有真实卡点出现时才占空间。</p>{coach.map((item) => <article data-coach-panel={item.id} hidden><header><span>{item.code}</span><h3>{item.title}</h3></header><div class="coachMarkdown" set:html={item.html}></div><button type="button" data-coach-close>收起</button></article>)}</section></aside>
      </div>
    </section>

    <section class="goldVariant focus" data-gold-surface="focus" hidden>
      <header class="focusBar"><button type="button" data-focus-prompt>Task</button><div><span>Focus Writing</span><strong>{task.title}</strong></div><button type="button" data-focus-coach>Coach</button></header>
      <aside class="focusPrompt" data-focus-prompt-body hidden>{isSmall ? <><p>{task.learnerTask.background}</p><blockquote>{task.learnerTask.directions}</blockquote></> : <><p>{task.learnerTask.visual_scenario}</p><blockquote>{task.learnerTask.directions}</blockquote></>}</aside>
      <main class="focusPaper"><label class="focusPlan"><span>Plan <small>optional</small></span><textarea rows="4" data-gold-plan placeholder="需要时才计划…"></textarea></label><label class="draftField"><span>First draft</span><textarea rows="26" data-gold-draft placeholder="当前屏幕只做一件事：把这篇写出来。"></textarea></label></main>
      <aside class="focusCoach" data-focus-coach-body hidden><header><span>Coach Drawer</span><strong>不要先学；遇到问题再叫出来。</strong></header><nav>{coach.map((item) => <button type="button" data-coach-open={item.id}><b>{item.code}</b><span>{item.short}</span></button>)}</nav><section class="coachContent"><p data-coach-empty>选择一个真实卡点。</p>{coach.map((item) => <article data-coach-panel={item.id} hidden><header><span>{item.code}</span><h3>{item.title}</h3></header><div class="coachMarkdown" set:html={item.html}></div><button type="button" data-coach-close>收起</button></article>)}</section></aside>
    </section>

    <footer class="goldFoot"><span>比较重点：Task 是否始终是主角｜写作区域是否稳定｜Coach 是否只在需要时变重｜长期写 20–30 分钟会不会累</span><a href={taskHref}>去 Current Writing Runtime →</a></footer>
  </section>
</Base>

<script>
  const root=document.querySelector('[data-gold-lab]');
  if(root instanceof HTMLElement){
    const variants=[...root.querySelectorAll('[data-gold-surface]')],variantButtons=[...root.querySelectorAll('[data-gold-variant]')];
    const taskId=root.getAttribute('data-task-id')||'task';
    const variantKey='kianos:ui:writing-gold:variant:v2',draftKey=`kianos:ui:writing-gold:draft:${taskId}`,planKey=`kianos:ui:writing-gold:plan:${taskId}`;
    let active='split';
    const renderVariant=()=>{variants.forEach((node)=>node.hidden=node.getAttribute('data-gold-surface')!==active);variantButtons.forEach((button)=>button.classList.toggle('active',button.getAttribute('data-gold-variant')===active));try{localStorage.setItem(variantKey,active)}catch{}history.replaceState(null,'',`#${active}`)};
    variantButtons.forEach((button)=>button.addEventListener('click',()=>{active=button.getAttribute('data-gold-variant')||'split';renderVariant()}));
    const syncFields=(selector,key)=>{const fields=[...root.querySelectorAll(selector)].filter((node)=>node instanceof HTMLTextAreaElement);let saved='';try{saved=localStorage.getItem(key)||''}catch{}fields.forEach((field)=>field.value=saved);fields.forEach((field)=>field.addEventListener('input',()=>{fields.forEach((other)=>{if(other!==field)other.value=field.value});try{localStorage.setItem(key,field.value)}catch{}}))};
    syncFields('[data-gold-plan]',planKey);syncFields('[data-gold-draft]',draftKey);
    const setCoach=(id='')=>{root.querySelectorAll('[data-coach-panel]').forEach((panel)=>panel.hidden=panel.getAttribute('data-coach-panel')!==id);root.querySelectorAll('[data-coach-empty]').forEach((node)=>node.hidden=Boolean(id));root.querySelectorAll('[data-coach-open]').forEach((button)=>button.classList.toggle('active',button.getAttribute('data-coach-open')===id))};
    root.querySelectorAll('[data-coach-open]').forEach((button)=>button.addEventListener('click',()=>setCoach(button.getAttribute('data-coach-open')||'')));root.querySelectorAll('[data-coach-close]').forEach((button)=>button.addEventListener('click',()=>setCoach('')));
    root.querySelector('[data-desk-prompt]')?.addEventListener('click',()=>{const body=root.querySelector('[data-desk-prompt-body]');if(body instanceof HTMLElement)body.hidden=!body.hidden});
    root.querySelector('[data-focus-prompt]')?.addEventListener('click',()=>{const body=root.querySelector('[data-focus-prompt-body]');if(body instanceof HTMLElement)body.hidden=!body.hidden});
    root.querySelector('[data-focus-coach]')?.addEventListener('click',()=>{const body=root.querySelector('[data-focus-coach-body]');if(body instanceof HTMLElement)body.hidden=!body.hidden});
    const hash=location.hash.replace(/^#/,'');let saved='';try{saved=localStorage.getItem(variantKey)||''}catch{}active=['split','desk','focus'].includes(hash)?hash:['split','desk','focus'].includes(saved)?saved:'split';renderVariant();
  }
</script>

<style>
.goldLab{max-width:94rem;margin:0 auto;display:grid;gap:16px;color:#17241e}.goldTop{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(30rem,.8fr);gap:28px;align-items:end;padding:2px 2px 16px;border-bottom:1px solid var(--study-line)}.goldTop>div{display:grid;gap:7px}.goldTop>div>span,.paneLabel>span,.workPane>header>span,.coachPane header>span,.coachDock>span,.focusBar span,.focusCoach header>span{font-size:11px;font-weight:850;letter-spacing:.07em;text-transform:uppercase;color:var(--study-green)}.goldTop h1{margin:0;font-size:34px;line-height:1.08;letter-spacing:-.03em}.goldTop p{max-width:62rem;margin:0;font-size:15px;line-height:1.65;color:#59685f}.goldTop nav{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.goldTop nav button{display:grid;gap:3px;padding:11px 12px;border:1px solid transparent;border-radius:10px;background:transparent;text-align:left;color:inherit;cursor:pointer}.goldTop nav button b{font-size:11px}.goldTop nav button span{font-size:12px;color:#66756d}.goldTop nav button.active{border-color:var(--study-line);background:#fff;box-shadow:var(--study-shadow)}.goldVariant[hidden],[data-coach-panel][hidden],[data-focus-prompt-body][hidden],[data-focus-coach-body][hidden]{display:none!important}.goldVariant{min-height:72vh}.split{display:grid;grid-template-columns:minmax(17rem,.75fr) minmax(34rem,1.55fr) minmax(17rem,.72fr);gap:22px;align-items:start}.taskPane,.coachPane{position:sticky;top:76px;display:grid;gap:14px;padding:17px 18px;border:1px solid var(--study-line);border-radius:14px;background:#fff}.taskPane dl{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:0}.taskPane dl div{display:grid;gap:2px}.taskPane dt,.taskPane small{font-size:10px;color:#718077}.taskPane dd{margin:0;font-size:12px;font-weight:750}.taskPane p,.taskPane li,.taskPane blockquote{font-size:13px;line-height:1.65}.taskPane blockquote{margin:0;padding:10px 12px;border-left:3px solid var(--study-green);background:var(--study-green-soft)}.taskPane a,.goldFoot a{color:var(--study-green);font-size:12px;font-weight:850;text-decoration:none}.paneLabel{display:grid;gap:3px}.paneLabel b{font-size:15px}.workPane{display:grid;gap:16px;padding:4px 0}.workPane header{display:grid;gap:4px}.workPane h2{margin:0;font-size:25px}.workPane header p{margin:0;color:#627169;font-size:13px}.workPane label,.paper label,.focusPaper label{display:grid;gap:7px}.workPane label>span,.paper label>span,.focusPaper label>span{font-size:12px;font-weight:850}.workPane label small,.paper label small,.focusPaper label small{font-weight:500;color:#849188}.workPane textarea,.paper textarea,.focusPaper textarea{width:100%;box-sizing:border-box;resize:vertical;border:1px solid #cbd6d0;border-radius:11px;background:#fff;color:inherit;padding:14px 16px;font:inherit;font-size:15px;line-height:1.7;outline:none}.workPane textarea:focus,.paper textarea:focus,.focusPaper textarea:focus{border-color:var(--study-green);box-shadow:0 0 0 3px var(--study-green-soft)}.coachPane header{display:grid;gap:4px}.coachPane header p,.coachDock p{margin:0;font-size:11px;line-height:1.55;color:#718077}.coachPane nav,.coachDock{display:grid;gap:5px}.coachPane nav button,.coachDock>button,.focusCoach nav button{display:grid;grid-template-columns:2.6rem 1fr;gap:7px;padding:8px 9px;border:0;border-radius:8px;background:transparent;text-align:left;color:inherit;cursor:pointer}.coachPane nav button:hover,.coachDock>button:hover,.focusCoach nav button:hover,.coachPane nav button.active,.coachDock>button.active,.focusCoach nav button.active{background:var(--study-green-soft);color:var(--study-green)}.coachPane nav button b,.coachDock>button b,.focusCoach nav button b{font-size:10px}.coachPane nav button span,.coachDock>button small,.focusCoach nav button span{font-size:11px}.coachContent{min-width:0}.coachContent>[data-coach-empty]{font-size:11px;line-height:1.55;color:#7b8981}.coachContent article{display:grid;gap:9px;padding-top:12px;border-top:1px solid var(--study-line)}.coachContent article header{display:grid;gap:2px}.coachContent h3{margin:0;font-size:15px}.coachContent article>button{justify-self:start;border:0;background:transparent;color:var(--study-green);font-weight:800;cursor:pointer}.coachMarkdown{max-height:46vh;overflow:auto;padding-right:5px}.coachMarkdown :global(h1){font-size:18px}.coachMarkdown :global(h2){font-size:16px}.coachMarkdown :global(h3){font-size:14px}.coachMarkdown :global(p),.coachMarkdown :global(li){font-size:12px;line-height:1.65}.coachMarkdown :global(pre){white-space:pre-wrap;font-size:11px}.desk{display:grid;gap:14px}.taskStrip{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:11px 14px;border-bottom:1px solid var(--study-line)}.taskStrip>div{display:grid;gap:2px}.taskStrip span{font-size:10px;color:var(--study-green);font-weight:850}.taskStrip strong{font-size:15px}.taskStrip button,.focusBar button{border:1px solid var(--study-line);border-radius:8px;background:#fff;padding:8px 10px;font:inherit;font-size:11px;cursor:pointer}.deskPrompt{max-width:62rem;padding:12px 16px;border-left:3px solid var(--study-green);background:var(--study-green-soft);font-size:13px;line-height:1.65}.deskBody{display:grid;grid-template-columns:minmax(0,1fr) 17rem;gap:26px;align-items:start}.paper{display:grid;gap:15px;max-width:58rem;margin:0 auto;width:100%;padding:24px 28px 34px;border:1px solid var(--study-line);background:#fff;box-shadow:var(--study-shadow)}.coachDock{position:sticky;top:78px;padding:8px 0}.coachDock .coachContent{margin-top:8px}.focus{position:relative;display:grid;gap:12px;max-width:76rem;margin:0 auto}.focusBar{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center;padding:8px 0;border-bottom:1px solid var(--study-line)}.focusBar>div{display:grid;text-align:center}.focusBar strong{font-size:14px}.focusPrompt{padding:13px 16px;border-left:3px solid var(--study-green);background:var(--study-green-soft);font-size:13px;line-height:1.65}.focusPaper{display:grid;gap:14px;max-width:58rem;margin:0 auto;width:100%;padding:8px 0 28px}.focusCoach{position:fixed;z-index:20;right:24px;top:94px;bottom:24px;width:min(30rem,36vw);overflow:auto;padding:18px;border:1px solid var(--study-line);border-radius:14px;background:#fff;box-shadow:0 20px 55px rgba(28,45,36,.18)}.focusCoach header{display:grid;gap:4px;margin-bottom:10px}.focusCoach nav{display:grid;grid-template-columns:repeat(2,1fr);gap:5px;margin-bottom:12px}.goldFoot{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:13px 2px;border-top:1px solid var(--study-line);font-size:11px;color:#68776f}@media(max-width:1050px){.goldTop{grid-template-columns:1fr}.split{grid-template-columns:1fr}.taskPane,.coachPane{position:static}.deskBody{grid-template-columns:1fr}.coachDock{position:static}.focusCoach{width:min(36rem,80vw)}}@media(max-width:680px){.goldTop nav{grid-template-columns:1fr}.paper{padding:18px 14px}.goldFoot{align-items:flex-start;flex-direction:column}.focusCoach{left:12px;right:12px;width:auto}}
</style>
