---
import Base from '../../layouts/Base.astro';
import { inspectWritingExamRuntimeSources, listWritingExamRuntimeTasks } from '../../lib/englishWritingExamRuntime.mjs';
import { listWritingSyntheticTasks } from '../../lib/englishWritingSynthetic.mjs';

const base = import.meta.env.BASE_URL;
const source = inspectWritingExamRuntimeSources();
const tasks = listWritingExamRuntimeTasks();
const syntheticIds = listWritingSyntheticTasks().map((task) => task.id);
const small = tasks.filter((task) => task.kind === 'small');
const big = tasks.filter((task) => task.kind === 'big');
const syntheticPayload = JSON.stringify(syntheticIds).replace(/</g, '\\u003c');
---
<Base
  title="Writing True-Exam Catalog"
  kicker="English · Writing · Post-Synthetic"
  description="Protected Current true-exam Writing catalog. Availability is shared source truth; which task the learner opens remains private learner state."
  active="home"
>
  <section class="writingExamCatalog" data-writing-exam-catalog>
    <section class="writingExamCatalogLock" data-exam-catalog-lock>
      <span>Protected true exam · locked</span>
      <h1>真题在 full synthetic 之后再开。</h1>
      <p>这里不会用“页面已经做好了”来推断你已经学到真题。只有本机 Small + Big 两篇 synthetic whole-essay Runtime 都完成后，目录才会显示。</p>
      <div><a href={`${base}writing-learn/`}>First Learning</a><a href={`${base}writing/`}>Synthetic Runtime</a></div>
    </section>

    <section data-exam-catalog-content hidden>
      <header class="writingExamCatalogHero">
        <div>
          <span>Post-Synthetic · Clean True-Exam Attempt</span>
          <h1>选择一篇真题，先锁 first evidence。</h1>
          <p>这里列的是 Current Source availability，不是个人 holdout 计划，也不会自动“消耗”任何年份。只有你主动打开某篇 prompt 才进入 clean attempt。</p>
        </div>
        <aside>
          <strong>{source.status === 'ready' ? `${tasks.length} clean tasks` : source.status}</strong>
          <span>{small.length} Small · {big.length} Big</span>
          <span>formal answers / analysis excluded</span>
          <span>whole-essay Runtime reused</span>
        </aside>
      </header>

      {source.status !== 'ready' ? (
        <section class="writingExamSourceBlocked"><strong>Current Writing Source blocked</strong><p>{source.issues.join(' · ')}</p></section>
      ) : (
        <div class="writingExamSections">
          <section>
            <header><span>Part A</span><h2>Small Writing</h2><p>2005–2026 · {small.length} prompts</p></header>
            <div class="writingExamGrid">
              {small.map((task) => (
                <a href={`${base}writing/exam/${encodeURIComponent(task.id)}/`}>
                  <span>{task.year}</span><strong>{task.title}</strong><small>Clean attempt →</small>
                </a>
              ))}
            </div>
          </section>
          <section>
            <header><span>Part B</span><h2>Big Writing</h2><p>2000–2026 · {big.length} prompts</p></header>
            <div class="writingExamGrid">
              {big.map((task) => (
                <a href={`${base}writing/exam/${encodeURIComponent(task.id)}/`}>
                  <span>{task.year}</span><strong>{task.title}</strong><small>Clean attempt →</small>
                </a>
              ))}
            </div>
          </section>
        </div>
      )}

      <section class="writingExamCatalogRule">
        <strong>Shared availability ≠ private study plan</strong>
        <p>仓库只维护 49 个 Current clean task objects 和统一 Runtime。个人保留哪些年份、哪天做哪篇、哪些已经见过，都不能写回 shared Current。</p>
      </section>
    </section>

    <script type="application/json" data-writing-synthetic-ids set:html={syntheticPayload}></script>
  </section>
</Base>

<script>
  const root = document.querySelector('[data-writing-exam-catalog]');
  if (root instanceof HTMLElement) {
    let syntheticIds = [];
    try { syntheticIds = JSON.parse(root.querySelector('[data-writing-synthetic-ids]')?.textContent || '[]'); } catch {}
    const finalStates = new Set(['PASS_ACCEPTABLE', 'REPAIR_COMPLETE', 'TRANSFER_PENDING']);
    const passed = Array.isArray(syntheticIds) && syntheticIds.length >= 2 && syntheticIds.every((id) => {
      try {
        const saved = JSON.parse(localStorage.getItem(`kianos-writing-runtime-v1:${id}`) || 'null');
        return finalStates.has(saved?.state);
      } catch { return false; }
    });
    const lock = root.querySelector('[data-exam-catalog-lock]');
    const content = root.querySelector('[data-exam-catalog-content]');
    if (lock instanceof HTMLElement) lock.hidden = passed;
    if (content instanceof HTMLElement) content.hidden = !passed;
  }
</script>

<style>
  .writingExamCatalog{max-width:78rem;margin:0 auto;display:grid;gap:12px}.writingExamCatalogLock{max-width:50rem;margin:34px auto;padding:24px 26px;border:1px solid var(--study-line);border-radius:16px;background:#fffdf8;box-shadow:var(--study-shadow)}.writingExamCatalogLock>span,.writingExamCatalogHero>div>span,.writingExamSections>section>header>span{font-size:9px;font-weight:850;letter-spacing:.08em;text-transform:uppercase;color:var(--study-green)}.writingExamCatalogLock h1,.writingExamCatalogHero h1{margin:5px 0 8px;font-size:26px}.writingExamCatalogLock p,.writingExamCatalogHero p{margin:0;color:var(--study-muted);font-size:12px;line-height:1.7}.writingExamCatalogLock>div{display:flex;gap:8px;margin-top:14px}.writingExamCatalogLock a{padding:8px 10px;border:1px solid var(--study-line);border-radius:9px;background:#fff;color:var(--study-green);font-size:10px;font-weight:800;text-decoration:none}
  .writingExamCatalogHero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px;align-items:end;padding:22px 24px;border:1px solid var(--study-line);border-radius:16px;background:#fff;box-shadow:var(--study-shadow)}.writingExamCatalogHero aside{display:grid;gap:3px;padding-left:18px;border-left:1px solid var(--study-line)}.writingExamCatalogHero aside strong{color:var(--study-green)}.writingExamCatalogHero aside span{font-size:9px;color:var(--study-faint)}
  .writingExamSections{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:12px}.writingExamSections>section{padding:18px;border:1px solid var(--study-line);border-radius:14px;background:#fff;box-shadow:var(--study-shadow)}.writingExamSections h2{margin:3px 0;font-size:18px}.writingExamSections header p{margin:0;color:var(--study-faint);font-size:9px}.writingExamGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;margin-top:12px}.writingExamGrid a{display:grid;gap:3px;padding:10px;border:1px solid var(--study-line);border-radius:9px;color:inherit;text-decoration:none;background:#fcfdfc}.writingExamGrid a:hover{border-color:#b8d7c8;background:var(--study-green-soft)}.writingExamGrid span{font-size:9px;color:var(--study-green);font-weight:800}.writingExamGrid strong{font-size:10px}.writingExamGrid small{font-size:8px;color:var(--study-faint)}
  .writingExamCatalogRule,.writingExamSourceBlocked{margin-top:12px;padding:15px 17px;border:1px solid var(--study-line);border-radius:12px;background:#fff}.writingExamCatalogRule strong,.writingExamSourceBlocked strong{font-size:11px}.writingExamCatalogRule p,.writingExamSourceBlocked p{margin:5px 0 0;font-size:9px;line-height:1.6;color:var(--study-muted)}
  @media(max-width:820px){.writingExamCatalogHero,.writingExamSections{grid-template-columns:1fr}.writingExamCatalogHero aside{padding:10px 0 0;border-left:0;border-top:1px solid var(--study-line)}}@media(max-width:560px){.writingExamGrid{grid-template-columns:1fr}}
</style>
