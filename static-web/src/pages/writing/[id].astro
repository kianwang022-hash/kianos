---
import Base from '../../layouts/Base.astro';
import EnglishExamTaskBridge from '../../components/EnglishExamTaskBridge.astro';
import '../../styles/english-writing-vertical.css';
import WritingWorkspace from '../../components/WritingWorkspace.astro';
import WritingEvidencePanel from '../../components/WritingEvidencePanel.astro';
import WritingProtectedExamGate from '../../components/WritingProtectedExamGate.astro';
import { listWritingSyntheticTasks } from '../../lib/englishWritingSynthetic.mjs';
import { listWritingRuntimeTasks, loadWritingRuntimeTask } from '../../lib/englishWritingRuntimeSourceTruth.mjs';

export function getStaticPaths() {
  return listWritingRuntimeTasks().map((task) => ({
    params: { id: task.id },
    props: { writingId: task.id }
  }));
}

const { writingId } = Astro.props;
const task = loadWritingRuntimeTask(writingId);
const syntheticGateIds = listWritingSyntheticTasks().map((item) => item.id);
const isExam = task.sourceKind === 'exam';
---
<Base
  title={task.title}
  kicker="English · Writing"
  description="先完整写出自己的第一版；稳定就结束，有问题再做最小修改。"
  sourcePath={task.sourcePath}
  sourceHash={task.sourceHash}
  objectId={task.id}
  active="home"
>
  <EnglishExamTaskBridge task="writing" objectId={task.id} taskObject={task} />
  {isExam ? (
    <WritingProtectedExamGate task={task} syntheticGateIds={syntheticGateIds}>
      <WritingWorkspace task={task} />
      <WritingEvidencePanel task={task} />
    </WritingProtectedExamGate>
  ) : (
    <>
      <WritingWorkspace task={task} />
      <WritingEvidencePanel task={task} />
    </>
  )}
</Base>
