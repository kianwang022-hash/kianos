---
import EnglishBase from '../../layouts/EnglishBase.astro';
import '../../styles/english-cloze-vertical.css';
import ClozeWorkspace from '../../components/ClozeWorkspace.astro';
import ObjectiveAnswerGate from '../../components/ObjectiveAnswerGate.astro';
import ObjectiveHandoff from '../../components/ObjectiveHandoff.astro';
import ObjectiveTransferClaims from '../../components/ObjectiveTransferClaims.astro';
import ObjectiveNavigator from '../../components/ObjectiveNavigator.astro';
import EnglishExamTaskBridge from '../../components/EnglishExamTaskBridge.astro';
import { listClozeSets, loadClozeById } from '../../lib/englishObjectiveSourceTruth.mjs';

export function getStaticPaths() {
  return listClozeSets().map((item) => ({
    params: { id: item.id },
    props: { objectId: item.id }
  }));
}

const item = loadClozeById(Astro.props.objectId);
---
<EnglishBase
  title={item.title}
  kicker="English · Cloze"
  description="Slot Demand → Constraints → Candidate Contrast → Best Fit"
  sourcePath={item.sourcePaths.sourceTruth || item.sourcePaths.questions}
  sourceHash={item.sourceHashes.renderedObject}
  objectId={item.objectId}
  active="cloze"
>
  <EnglishExamTaskBridge task="cloze" objectId={item.objectId} />
  <ClozeWorkspace item={item} />
  <ObjectiveAnswerGate task="cloze" answerRoute="cloze-answer" />
  <ObjectiveHandoff />
  <ObjectiveTransferClaims task="cloze" />
  <ObjectiveNavigator task="cloze" route="cloze" item={item} />
</EnglishBase>