---
import Base from '../layouts/Base.astro';
import VocabularyBrowser from '../components/VocabularyBrowser.astro';
import VocabularyWordRuntime from '../components/VocabularyWordRuntime.astro';
import { loadAnswer } from '../lib/current.mjs';

const answer = loadAnswer();
---
<Base title="Vocabulary" kicker="LexicalOS · Current" sourcePath={answer.sourcePath} sourceHash={answer.sourceHash} objectId={answer.objectId} active="lexical">
  <VocabularyBrowser answer={answer} />
  <VocabularyWordRuntime answer={answer} />
</Base>
