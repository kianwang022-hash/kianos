---
import Base from '../layouts/EnglishBase.astro';
import { inspectTranslationSources, listTranslationSets } from '../lib/englishTranslationSourceTruth.mjs';

const base = import.meta.env.BASE_URL;
const state = inspectTranslationSources();
const sets = listTranslationSets();
const first = sets[0] || null;
const payload = JSON.stringify(sets).replace(/</g, '\u003c');
---
<Base
  title="Translation"
  kicker="English · Productive Lane"
  description="完整翻译一套；稳定就继续，有真实问题再做最小修复。"
  active="home"
>
  <section class="translationHome" data-translation-home data-base={base}>
    <section class="translationHero">
      <div>
        <span>Translation</span>
        <h2>完整翻译，稳定就继续。</h2>
        <p>每次完成一整套。先保留自己的第一版；没有影响得分的问题就直接进入下一套，真正卡住时再做针对性修复。</p>
      </div>
      <aside>
        <strong>{state.status === 'ready' ? `${sets.length} 套` : '暂不可用'}</strong>
        {state.status === 'ready' && <span>参考译文完整 {state.completeReferenceSetCount} / {sets.length}</span>}
        {state.status === 'ready' && state.referenceGaps?.length > 0 && <span>{state.referenceGaps.length} 个句子暂缺参考译文</span>}
        <span>作答记录保存在本机</span>
      </aside>
    </section>

    <a class="translationLearn" href={`${base}translation-learn/`}>
      <div><span>学习框架</span><strong>理解英文 → 忠实重建 → 考场表达</strong></div>
      <p>先把三件事分清：读准原文、忠实转成中文、在考试时间内完成。已经稳定的部分可以跳，哪里反复出错再回哪里。</p>
      <b>学习框架 →</b>
    </a>

    {state.status !== 'ready' ? (
      <section class="translationGate">
        <strong>Translation 暂时不可用</strong>
        <p>当前题库没有完整载入，请稍后再试。</p>
      </section>
    ) : (
      <section class="translationHomeGrid">
        <a class="translationContinue" data-translation-continue href={first ? `${base}translation/${encodeURIComponent(first.id)}/` : `${base}translation/`}>
          <span>Continue</span>
          <strong data-translation-continue-title>{first?.title || '开始 Translation'}</strong>
          <p data-translation-continue-meta>{first ? `第 1 / ${sets.length} 套 · 参考译文 ${first.referenceCoverage?.available || 0}/${first.referenceCoverage?.total || 0}` : 'Translation 暂不可用'}</p>
        </a>

        <section class="translationBrowse">
          <header>
            <div><span>全部练习</span><strong>Translation</strong></div>
            <input type="search" data-translation-search placeholder="搜索年份 / 标题" />
          </header>
          <div data-translation-results></div>
        </section>
      </section>
    )}

    {state.status === 'ready' && state.referenceGaps?.length > 0 && (
      <details class="translationSourceGaps">
        <summary>部分参考译文暂缺 · {state.referenceGaps.length}</summary>
        <p>这些句子仍可正常练习；需要对照时，网页只显示已经核验过的参考译文。</p>
      </details>
    )}

    <section class="translationContractNote">
      <strong>使用方式</strong>
      <p>先独立完成整套。稳定就继续；有明显错误或不确定时再让 Chat 帮你定位问题，随后回到网页自己重译。</p>
    </section>

    <script type="application/json" data-translation-catalog set:html={payload}></script>
  </section>
</Base>

<script>
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(() => {

  const root = document.querySelector('[data-translation-home]');
  if (root instanceof HTMLElement) {
    const base = root.getAttribute('data-base') || '/';
    let sets = [];
    try { sets = JSON.parse(root.querySelector('[data-translation-catalog]')?.textContent || '[]'); } catch {}
    const hrefFor = (id) => `${base}translation/${encodeURIComponent(id)}/`;
    const coverageText = (item) => {
      const coverage = item?.referenceCoverage || {};
      return coverage.complete ? `参考译文 ${coverage.available}/${coverage.total}` : `参考译文 ${coverage.available}/${coverage.total} · 部分可用`;
    };
    const stageText = (stage) => ({
      attempt: '第一次作答',
      decision: '完成 / 复盘',
      diagnosis: '待复盘',
      reconstruct: '重新翻译',
      passed: '已完成',
      repaired: '已修复',
      transfer_pending: '已修复'
    })[stage] || '';

    let last = null;
    try { last = JSON.parse(localStorage.getItem('kianos-translation-last-location-v1') || 'null'); } catch {}
    const continueLink = root.querySelector('[data-translation-continue]');
    if (last?.id && continueLink instanceof HTMLAnchorElement && sets.some((item) => item.id === last.id)) {
      const current = sets.find((item) => item.id === last.id);
      let taskState = null;
      try {
        taskState = JSON.parse(localStorage.getItem(`kianos-translation-attempt-v2:${last.id}`) || 'null');
      } catch {}
      continueLink.href = hrefFor(last.id);
      const title = root.querySelector('[data-translation-continue-title]');
      const meta = root.querySelector('[data-translation-continue-meta]');
      if (title) title.textContent = last.title || last.id;
      if (meta) {
        const stage = stageText(taskState?.stage);
        meta.textContent = `${last.paperId || 'Translation'} · 第 ${last.position || '?'} / ${last.total || sets.length} 套 · ${coverageText(current)}${stage ? ` · ${stage}` : ''}`;
      }
    }

    const results = root.querySelector('[data-translation-results]');
    const render = (query = '') => {
      if (!results) return;
      const q = String(query || '').trim().toLowerCase();
      const visible = sets.filter((item) => {
        if (!q) return true;
        return [item.id, item.title, item.paperId, item.year].some((value) => String(value || '').toLowerCase().includes(q));
      }).slice(0, q ? 50 : 20);
      results.replaceChildren();
      visible.forEach((item) => {
        const link = document.createElement('a');
        link.href = hrefFor(item.id);
        const copy = document.createElement('div');
        const title = document.createElement('strong'); title.textContent = item.title || item.id;
        const meta = document.createElement('span'); meta.textContent = `${item.paperId || 'English I'} · ${coverageText(item)}`;
        copy.append(title, meta);
        const pos = document.createElement('small'); pos.textContent = `${item.position} / ${item.total}`;
        link.append(copy, pos);
        results.appendChild(link);
      });
      if (!visible.length) {
        const empty = document.createElement('p'); empty.textContent = '没有匹配的 Translation 练习。'; results.appendChild(empty);
      }
    };
    root.querySelector('[data-translation-search]')?.addEventListener('input', (event) => render(event.currentTarget.value || ''));
    render();
  }

  });
</script>

<style>
  .translationHome{max-width:76rem;margin:0 auto;display:grid;gap:12px}.translationHero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px;align-items:end;padding:24px 26px;border:1px solid var(--study-line);border-radius:16px;background:#fff;box-shadow:var(--study-shadow)}.translationHero>div>span,.translationBrowse header span,.translationContinue>span,.translationLearn span{color:var(--study-green);font-size:9px;font-weight:850;letter-spacing:.08em;text-transform:uppercase}.translationHero h2{margin:5px 0 8px;font-size:27px}.translationHero p{max-width:76ch;margin:0;color:var(--study-muted);font-size:13px;line-height:1.7}.translationHero aside{display:grid;gap:3px;padding-left:20px;border-left:1px solid var(--study-line)}.translationHero aside strong{color:var(--study-green)}.translationHero aside span{color:var(--study-faint);font-size:10px}
  .translationLearn{display:grid;grid-template-columns:minmax(220px,.8fr) minmax(0,1.3fr) auto;gap:18px;align-items:center;padding:14px 18px;border:1px solid #cfe2d8;border-radius:13px;background:var(--study-green-soft);color:inherit;text-decoration:none}.translationLearn>div{display:grid;gap:3px}.translationLearn strong{font-size:14px}.translationLearn p{margin:0;color:var(--study-muted);font-size:11px;line-height:1.55}.translationLearn b{color:var(--study-green);font-size:11px;white-space:nowrap}
  .translationHomeGrid{display:grid;grid-template-columns:minmax(260px,.72fr) minmax(0,1.28fr);gap:12px}.translationContinue,.translationBrowse,.translationContractNote,.translationGate,.translationSourceGaps{padding:20px;border:1px solid var(--study-line);border-radius:14px;background:#fff;color:inherit}.translationContinue{display:grid;align-content:start;gap:6px;text-decoration:none}.translationContinue strong{font-size:22px;line-height:1.35}.translationContinue p{margin:0;color:var(--study-muted);font-size:12px;line-height:1.6}.translationBrowse header{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-bottom:12px}.translationBrowse header>div{display:grid;gap:3px}.translationBrowse header input{width:min(300px,50%);padding:8px 10px;border:1px solid var(--study-line);border-radius:9px;font:inherit}.translationBrowse [data-translation-results]{display:grid;gap:5px}.translationBrowse [data-translation-results]>a{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:9px 10px;border-radius:9px;color:inherit;text-decoration:none}.translationBrowse [data-translation-results]>a:hover{background:var(--study-green-soft)}.translationBrowse [data-translation-results] div{display:grid;gap:2px;min-width:0}.translationBrowse [data-translation-results] strong{font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.translationBrowse [data-translation-results] span,.translationBrowse [data-translation-results] small{color:var(--study-faint);font-size:9px}
  .translationBrowse [data-translation-results]>p,.translationContractNote p,.translationGate p,.translationSourceGaps p{margin:5px 0 0;color:var(--study-muted);font-size:10px;line-height:1.55}.translationContractNote strong,.translationGate strong{font-size:11px}.translationGate{border-color:#e2c4ad;background:#fff9f3}.translationGate code,.translationSourceGaps code{display:block;margin-top:6px;color:var(--study-faint);font-size:9px;overflow-wrap:anywhere}.translationSourceGaps summary{cursor:pointer;font-size:11px;font-weight:800}.translationSourceGaps{background:#fffdf8}
  @media(max-width:820px){.translationHero,.translationHomeGrid,.translationLearn{grid-template-columns:1fr}.translationHero aside{padding:12px 0 0;border-left:0;border-top:1px solid var(--study-line)}.translationBrowse header{align-items:stretch;flex-direction:column}.translationBrowse header input{width:100%;box-sizing:border-box}}
</style>
