---
import { marked } from 'marked';
import EnglishBase from '../layouts/EnglishBase.astro';
import { loadWritingLearningProjection } from '../lib/englishWritingLearning.mjs';

const projection = loadWritingLearningProjection();
if (projection.status !== 'ready') {
  throw new Error(`WRITING_LEARNING_PROJECTION_NOT_READY:${projection.issues.join(',')}`);
}

const base = import.meta.env.BASE_URL;
const render = async (markdown) => await marked.parse(markdown, { gfm: true, breaks: false });
const globalHtml = await render(projection.globalMap);
const coreIntroHtml = await render(projection.coreIntro);
const modesHtml = await render(projection.modeSpecializations);
const skillMapHtml = await render(projection.skillMap);
const practiceHtml = await render(projection.syntheticPractice);
const trueExamGateHtml = await render(projection.trueExamEntryGate);
const blocks = await Promise.all(projection.blocks.map(async (block) => ({
  ...block,
  html: await render(block.markdown)
})));

const layerCards = [
  ['TASK', 'Task / Genre', '完成真实任务'],
  ['GENERATE', 'Content', '产生可展开内容'],
  ['ORGANIZE', 'Development', '让信息持续推进'],
  ['REALIZE', 'English', '用可控英语实现'],
  ['CONTROL', 'Register / Error', '压住高价值风险'],
  ['DELIVER', 'Execution', '在时间里完整交付']
];
---
<EnglishBase
  title="Writing Guide"
  kicker="English · Writing · Guide"
  description="先看完整写作链；已经稳定的直接跳过，哪里不稳再补哪里。"
  sourcePath={projection.sourcePath}
  sourceHash={projection.sourceHash}
  objectId="english:writing:first-learning"
  active="home"
>
  <section class="writingLearnShell" data-writing-learning>
    <header class="writingHero">
      <div class="writingHeroCopy">
        <span class="writingEyebrow">学习框架</span>
        <h1>从任务到成文，不从模板开始。</h1>
        <p>先看整条生成链。不会的能力再进入；已经稳定的直接跳过。这里的目的不是完成一门课程，而是尽快回到完整 Writing。</p>
      </div>
      <aside class="writingHeroRule">
        <strong>使用方式</strong>
        <span>整体方法 → 补薄弱能力 → 完整写作</span>
        <small>Small / Big 是两种任务模式；练习只是练习，不是额外课程。</small>
        <a href={`${base}writing/`}>直接进入 Writing →</a>
      </aside>
    </header>

    <div class="writingLayerChain" aria-label="Writing global generation chain">
      {layerCards.map(([code, label, note], index) => (
        <div class="writingLayerCard">
          <span>{index + 1}</span>
          <strong>{code}</strong>
          <b>{label}</b>
          <small>{note}</small>
        </div>
      ))}
    </div>

    <nav class="writingRoute" aria-label="Writing first learning route">
      <button type="button" class="isActive" data-writing-route="global-map"><strong>Map</strong><span>先看全局</span></button>
      {blocks.map((block) => (
        <button type="button" data-writing-route={block.id}><strong>{block.id.toUpperCase()}</strong><span>{block.title.replace(/^B\d+｜/, '')}</span></button>
      ))}
      <button type="button" data-writing-route="modes"><strong>Modes</strong><span>Small / Big</span></button>
      <button type="button" data-writing-route="practice"><strong>练习</strong><span>起步 / 真题入口</span></button>
    </nav>

    <main class="writingStage">
      <section class="writingPanel" data-writing-panel="global-map">
        <div class="writingPanelHeader">
          <div><span>Orientation</span><h2>先建立整张地图</h2></div>
          <p>看懂六个核心能力的关系即可。它们不是六个必须打卡的阶段。</p>
        </div>
        <article class="markdownBody" set:html={globalHtml}></article>
        <article class="markdownBody coreIntro" set:html={coreIntroHtml}></article>
        <footer class="writingPanelActions">
          <span>会的可以跳；哪里不稳就进入哪里。</span>
          <button type="button" data-writing-route="b1">查看 B1 →</button>
        </footer>
      </section>

      {blocks.map((block, index) => {
        const previous = index === 0 ? 'global-map' : blocks[index - 1].id;
        const next = index === blocks.length - 1 ? 'modes' : blocks[index + 1].id;
        return (
          <section class="writingPanel" data-writing-panel={block.id} hidden>
            <div class="writingPanelHeader compact">
              <div><span>核心能力 · {index + 1}/6</span><h2>{block.title}</h2></div>
              <p>只学到能返回完整 Writing。需要更深的例子或小练习时再展开参考内容或问 Chat。</p>
            </div>
            <article class="markdownBody writingSegment" set:html={block.html}></article>
            <footer class="writingPanelActions">
              <button type="button" class="secondary" data-writing-route={previous}>← 上一块</button>
              <a href={`${base}writing/`}>已经够用 → 去写</a>
              <button type="button" data-writing-route={next}>{index === blocks.length - 1 ? '看任务模式 →' : '下一能力 →'}</button>
            </footer>
          </section>
        );
      })}

      <section class="writingPanel" data-writing-panel="modes" hidden>
        <div class="writingPanelHeader">
          <div><span>任务模式</span><h2>Small / Big：同一主干的两种任务模式</h2></div>
          <p>这里只看两种题型真正不同的地方，不重复学习六个公共能力。</p>
        </div>
        <article class="markdownBody" set:html={modesHtml}></article>
        <footer class="writingPanelActions">
          <button type="button" class="secondary" data-writing-route="b6">← 回 B6</button>
          <a href={`${base}writing/`}>进入 Writing →</a>
          <button type="button" data-writing-route="practice">看练习 / 真题入口 →</button>
        </footer>
      </section>

      <section class="writingPanel" data-writing-panel="practice" hidden>
        <div class="writingPanelHeader">
          <div><span>练习 / 真题入口</span><h2>需要时练，再进入真实 Writing</h2></div>
          <p>起步练习只用来建立完整输出和修正明显问题，不是长期题库；是否完成以真实写作为准。</p>
        </div>
        <article class="markdownBody syntheticGate" set:html={practiceHtml}></article>

        <details class="writingLaterAsset">
          <summary>Skill Map · 后续卡住时再用</summary>
          <article class="markdownBody" set:html={skillMapHtml}></article>
        </details>

        <details class="writingLaterAsset" data-true-exam-gate>
          <summary>首篇真题 · 保持未见材料</summary>
          <article class="markdownBody" set:html={trueExamGateHtml}></article>
        </details>

        <footer class="writingPanelActions">
          <button type="button" class="secondary" data-writing-route="modes">← 回 Modes</button>
          <span>起步练习是否完成，以真实写作记录为准。</span>
          <a href={`${base}writing/`}>进入 Writing →</a>
        </footer>
      </section>
    </main>
  </section>
</EnglishBase>

<script>
  const root = document.querySelector('[data-writing-learning]');
  if (root) {
    const panels = [...root.querySelectorAll('[data-writing-panel]')];
    const routeButtons = [...root.querySelectorAll('button[data-writing-route]')];
    const routeIds = panels.map((panel) => panel.getAttribute('data-writing-panel')).filter(Boolean);
    const positionKey = 'kianos:writing:first-learning:position:v2';

    function showPanel(id, { updateHash = true } = {}) {
      const target = routeIds.includes(id) ? id : 'global-map';
      panels.forEach((panel) => {
        panel.hidden = panel.getAttribute('data-writing-panel') !== target;
      });
      routeButtons.forEach((button) => {
        button.classList.toggle('isActive', button.getAttribute('data-writing-route') === target);
      });
      try { localStorage.setItem(positionKey, target); } catch {}
      if (updateHash) history.replaceState(null, '', `#${target}`);
      root.querySelector(`[data-writing-panel="${target}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    routeButtons.forEach((button) => {
      button.addEventListener('click', () => showPanel(button.getAttribute('data-writing-route') || 'global-map'));
    });

    const fromHash = location.hash.replace(/^#/, '');
    let saved = '';
    try { saved = localStorage.getItem(positionKey) || ''; } catch {}
    showPanel(routeIds.includes(fromHash) ? fromHash : routeIds.includes(saved) ? saved : 'global-map', { updateHash: false });
  }
</script>

<style>
  .writingLearnShell{max-width:82rem;margin:0 auto;display:grid;gap:14px}
  .writingHero{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(15rem,.7fr);gap:14px;padding:24px 26px;border:1px solid var(--study-line);border-radius:18px;background:#fff;box-shadow:var(--study-shadow)}
  .writingHeroCopy{display:grid;gap:8px}.writingEyebrow{font-size:10px;font-weight:900;letter-spacing:.09em;text-transform:uppercase;color:var(--study-green)}
  .writingHero h1{margin:0;font-size:30px;line-height:1.15;letter-spacing:-.025em}.writingHero p{max-width:54rem;margin:0;color:#42544c;font-size:13px;line-height:1.75}
  .writingHeroRule{display:grid;align-content:start;gap:6px;padding:15px 16px;border-radius:13px;background:var(--study-green-soft);border:1px solid var(--study-line)}
  .writingHeroRule strong{font-size:11px;color:var(--study-green)}.writingHeroRule span{font-size:13px;font-weight:850;line-height:1.45}.writingHeroRule small{font-size:10px;line-height:1.55;color:var(--study-muted)}.writingHeroRule a{margin-top:4px;color:var(--study-green);font-size:11px;font-weight:850;text-decoration:none}
  .writingLayerChain{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:7px}.writingLayerCard{min-width:0;display:grid;gap:3px;padding:11px 12px;border:1px solid var(--study-line);border-radius:12px;background:#fff}.writingLayerCard>span{font-size:9px;color:var(--study-faint)}.writingLayerCard>strong{font-size:10px;color:var(--study-green);letter-spacing:.05em}.writingLayerCard>b{font-size:11px}.writingLayerCard>small{font-size:9px;line-height:1.4;color:var(--study-muted)}
  .writingRoute{position:sticky;top:68px;z-index:4;display:grid;grid-template-columns:repeat(9,minmax(0,1fr));gap:5px;padding:7px;border:1px solid var(--study-line);border-radius:13px;background:rgba(255,255,255,.96);box-shadow:var(--study-shadow);backdrop-filter:blur(10px)}.writingRoute button{min-width:0;display:grid;gap:2px;padding:8px 7px;border:0;border-radius:8px;background:transparent;color:inherit;font:inherit;cursor:pointer}.writingRoute button strong{font-size:10px}.writingRoute button span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:8px;color:var(--study-faint)}.writingRoute button.isActive{background:var(--study-green-soft);color:var(--study-green)}
  .writingStage{display:grid}.writingPanel{display:grid;gap:14px;padding:26px 30px;border:1px solid var(--study-line);border-radius:16px;background:#fff;box-shadow:var(--study-shadow)}.writingPanel[hidden]{display:none}.writingPanelHeader{display:flex;align-items:end;justify-content:space-between;gap:22px;padding-bottom:13px;border-bottom:1px solid var(--study-line)}.writingPanelHeader>div{display:grid;gap:3px}.writingPanelHeader span{font-size:9px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;color:var(--study-green)}.writingPanelHeader h2{margin:0;font-size:21px}.writingPanelHeader p{max-width:34rem;margin:0;color:var(--study-muted);font-size:10px;line-height:1.55;text-align:right}
  .writingPanelActions{display:flex;align-items:center;justify-content:space-between;gap:10px;padding-top:12px;border-top:1px solid var(--study-line)}.writingPanelActions span{color:var(--study-muted);font-size:9px;line-height:1.5}.writingPanelActions button,.writingPanelActions a{padding:8px 11px;border:1px solid var(--study-green);border-radius:8px;background:var(--study-green);color:#fff;font:inherit;font-size:10px;font-weight:850;text-decoration:none;cursor:pointer}.writingPanelActions .secondary{border-color:var(--study-line);background:#fff;color:inherit}
  .writingLaterAsset{border:1px solid var(--study-line);border-radius:11px;background:#fbfdfc}.writingLaterAsset summary{padding:12px 14px;cursor:pointer;font-size:11px;font-weight:850}.writingLaterAsset>.markdownBody{padding:0 18px 18px;border-top:1px solid var(--study-line)}
  .markdownBody :global(h1){font-size:25px}.markdownBody :global(h2){margin-top:1.8rem;font-size:18px}.markdownBody :global(h3){margin-top:1.35rem;font-size:14px}.markdownBody :global(p),.markdownBody :global(li){font-size:13px;line-height:1.82;color:#26352f}.markdownBody :global(blockquote){margin:1rem 0;padding:9px 13px;border-left:3px solid var(--study-green);background:var(--study-green-soft)}.markdownBody :global(pre){overflow:auto;padding:13px 15px;border:1px solid var(--study-line);border-radius:10px;background:#f7f9f7;font-size:11px;line-height:1.6}
  @media(max-width:900px){.writingHero{grid-template-columns:1fr}.writingLayerChain{grid-template-columns:repeat(3,minmax(0,1fr))}.writingRoute{position:static;grid-template-columns:repeat(3,minmax(0,1fr))}.writingPanelHeader{align-items:flex-start;flex-direction:column}.writingPanelHeader p{text-align:left}.writingPanelActions{align-items:stretch;flex-direction:column}.writingPanelActions button,.writingPanelActions a{text-align:center}}
  @media(max-width:560px){.writingHero,.writingPanel{padding:18px 14px}.writingLayerChain{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
