---
import Base from '../layouts/Base.astro';
import ObjectiveHome from '../components/ObjectiveHome.astro';
import EnglishObjectiveLocalNav from '../components/EnglishObjectiveLocalNav.astro';
import { inspectObjectiveTask, listReadingBSets } from '../lib/englishObjectiveSourceTruth.mjs';

const sourceState = inspectObjectiveTask('reading_b');
const sets = sourceState.status === 'ready' ? listReadingBSets() : [];
const base = import.meta.env.BASE_URL;
const pendingDescription = sourceState.status === 'invalid'
  ? 'Reading B Current section 无法被唯一、安全识别；Runtime 保持 fail-closed。'
  : 'English Current 依赖缺失；补齐当前依赖并通过 gate 后自动启用。';
---
<Base
  title="Reading B"
  kicker={sourceState.status === 'ready' ? 'English · Objective' : 'English · Current gate'}
  description={sourceState.status === 'ready' ? 'Discourse Skeleton → Required Role → Candidate Fit → Global Reconciliation.' : pendingDescription}
  sourcePath="content/english/manifest.json"
  objectId="english:reading-b-home"
  active="reading_b"
  showLead={sourceState.status !== 'ready'}
>
  <EnglishObjectiveLocalNav active="part-b" />
  {sourceState.status === 'ready' ? (
    <ObjectiveHome
      sets={sets}
      route="reading-b"
      label="Part B"
      learnerLabel="新题型"
      headline="按整组完成真题"
      description="先把整组材料和候选关系做完整，再统一提交；复盘时回到篇章结构判断。"
      unitLabel="套"
      lastLocationKey="kianos-reading-b-last-location-v1"
      learningHref={`${base}objective-learn/#reading-b`}
      learningSummary="第一次系统学习时，先把篇章骨架、位置需求、候选作用和全局核对的做题链学清楚。"
    />
  ) : (
    <section class="migrationPending">
      <span>Fail-closed · {sourceState.status}</span>
      <h2>Reading B Current 暂未安全解锁</h2>
      <p>不猜 section，不回退 legacy。只有 Current section / stable ID 证据能安全识别时才投影训练页面。</p>
      {sourceState.issues.length > 0 && <div class="migrationPendingList"><strong>Issues</strong>{sourceState.issues.map((item) => <code>{item}</code>)}</div>}
      {sourceState.availableSections.length > 0 && <div class="migrationPendingList"><strong>Available Current sections</strong>{sourceState.availableSections.map((item) => <code>{item.section} · {item.setCount} sets</code>)}</div>}
    </section>
  )}
</Base>