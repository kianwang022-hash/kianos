---
import Base from '../layouts/Base.astro';
import ReadingHome from '../components/ReadingHome.astro';
import EnglishObjectiveLocalNav from '../components/EnglishObjectiveLocalNav.astro';
import { inspectReadingSources, listReadingSets } from '../lib/englishReadingSourceTruth.mjs';

const sourceState = inspectReadingSources();
const sets = sourceState.status === 'ready' ? listReadingSets() : [];
const base = import.meta.env.BASE_URL;
const pendingDescription = sourceState.status === 'invalid'
  ? 'English Current 已落仓，但来源完整性检查未通过；Runtime 保持 fail-closed。'
  : 'English Current 依赖缺失；补齐当前依赖并通过 hash gate 后自动启用。';
---
<Base
  title="Reading"
  kicker={sourceState.status === 'ready' ? 'English · Current' : 'English · Current gate'}
  description={sourceState.status === 'ready' ? 'Continue / Navigate / clean attempt. 具体复盘与 Handoff 在 passage runtime 完成。' : pendingDescription}
  sourcePath="content/english/manifest.json"
  objectId="english:reading-home"
  active="reading"
>
  <EnglishObjectiveLocalNav active="reading" />
  {sourceState.status === 'ready' ? (
    <ReadingHome sets={sets} learningHref={`${base}objective-learn/#reading-a`} />
  ) : (
    <section class="migrationPending">
      <span>Fail-closed · {sourceState.status}</span>
      <h2>{sourceState.status === 'invalid' ? 'Reading source 未通过完整性检查' : 'Reading Current 依赖缺失'}</h2>
      <p>新仓库只读取 `content/english/` Current，不回退 legacy，也不使用历史版本补洞。</p>
      {sourceState.missing.length > 0 && (
        <div class="migrationPendingList">
          <strong>Missing Current</strong>
          {sourceState.missing.map((item) => <code>{item}</code>)}
        </div>
      )}
      {sourceState.issues.length > 0 && (
        <div class="migrationPendingList">
          <strong>Integrity issues</strong>
          {sourceState.issues.map((item) => <code>{item}</code>)}
        </div>
      )}
      <code>Current source → hash gate → Reading Workspace</code>
    </section>
  )}
</Base>