---
import Base from '../layouts/Base.astro';
import '../styles/reading.css';
import '../styles/reading-interaction.css';
import '../styles/reading-repair.css';
import '../styles/reading-navigation.css';
import ReadingWorkspace from '../components/ReadingWorkspace.astro';
import ReadingPassageNavigator from '../components/ReadingPassageNavigator.astro';
import ReadingDeferredReviewShield from '../components/ReadingDeferredReviewShield.astro';
import ReadingRepairCoach from '../components/ReadingRepairCoach.astro';
import ReadingReviewSignals from '../components/ReadingReviewSignals.astro';
import ReadingSessionHandoff from '../components/ReadingSessionHandoff.astro';
import { inspectReadingSources } from '../lib/current.mjs';
import { loadDefaultReading } from '../lib/englishReading.mjs';

const sourceState = inspectReadingSources();
const reading = sourceState.status === 'ready' ? loadDefaultReading() : null;
const pendingDescription = sourceState.status === 'invalid'
  ? 'English Current 已落仓，但来源完整性检查未通过；Runtime 保持 fail-closed。'
  : 'English Current 依赖缺失；补齐当前依赖并通过 hash gate 后自动启用。';
---
<Base
  title={reading?.title || 'Reading'}
  kicker={reading ? 'English · Current' : 'English · Current gate'}
  description={reading ? '' : pendingDescription}
  sourcePath={reading?.sourcePaths.passage}
  sourceHash={reading?.sourceHashes.renderedObject}
  objectId={reading?.objectId}
  active="reading"
>
  {reading ? (
    <>
      <ReadingWorkspace reading={reading} />
      <ReadingPassageNavigator reading={reading} />
      <ReadingDeferredReviewShield />
      <ReadingRepairCoach />
      <ReadingReviewSignals />
      <ReadingSessionHandoff />
    </>
  ) : (
    <section class="migrationPending">
      <span>Fail-closed · {sourceState.status}</span>
      <h2>{sourceState.status === 'invalid' ? 'Reading source 未通过完整性检查' : 'Reading Current 依赖缺失'}</h2>
      <p>新仓库只读取 `content/english/` Current，不回退 legacy，也不使用历史版本补洞。</p>
      {sourceState.missing.length > 0 && (
        <div class="migrationPendingList">
          <strong>Missing Current</strong>
          {sourceState.missing.map((item) => <code>{item}</code>)}
        </div>
      )}
      {sourceState.issues.length > 0 && (
        <div class="migrationPendingList">
          <strong>Integrity issues</strong>
          {sourceState.issues.map((item) => <code>{item}</code>)}
        </div>
      )}
      <code>Current source → hash gate → Reading Workspace</code>
    </section>
  )}
</Base>
