---
import Base from '../../layouts/Base.astro';
import VocabularyWordRuntime from '../../components/VocabularyWordRuntime.astro';
import VocabularyEvidenceBridge from '../../components/VocabularyEvidenceBridge.astro';
import { listLexicalOrdinals, loadLexicalWordByOrdinal } from '../../lib/lexical.mjs';
export function getStaticPaths(){return listLexicalOrdinals().map((ordinal)=>({params:{ordinal:String(ordinal)},props:{ordinal}}));}
const { ordinal }=Astro.props;const answer=loadLexicalWordByOrdinal(Number(ordinal));const total=listLexicalOrdinals().length;const previousOrdinal=answer.ordinal>1?answer.ordinal-1:null;const nextOrdinal=answer.ordinal<total?answer.ordinal+1:null;const base=import.meta.env.BASE_URL;const nextHref=nextOrdinal?`${base}vocabulary/${nextOrdinal}/`:`${base}vocabulary/`;
---
<Base title={answer.record.word} kicker={`LexicalOS · Study · ${answer.ordinal} / ${total}`} description="先做整词 Known/Fuzzy/Unknown routing；需要时进入 Recall → Reveal。Reveal 后只对真正值得未来 attention 的具体分支按 +；整卡 Depth 本身不会制造 Repair。" sourcePath={answer.sourcePath} sourceHash={answer.sourceHash} objectId={answer.objectId} active="lexical" showLead={false}>
  <nav class="lexicalStudyNav" data-lexical-study-nav data-ordinal={answer.ordinal}><a href={`${base}vocabulary/`}>Vocabulary</a><span>{answer.ordinal} / {total}</span><div>{previousOrdinal?<a href={`${base}vocabulary/${previousOrdinal}/`}>← Prev</a>:<span>← Prev</span>}{nextOrdinal?<a class="next" data-lexical-next href={`${base}vocabulary/${nextOrdinal}/`}>Next →</a>:<a class="next" data-lexical-next href={`${base}vocabulary/`}>Finish</a>}</div></nav>
  <VocabularyWordRuntime answer={answer}/><VocabularyEvidenceBridge nextHref={nextHref}/>
  <nav class="lexicalStudyNav lexicalStudyNavBottom"><a href={`${base}vocabulary/`}>Back to Vocabulary</a><div>{previousOrdinal&&<a href={`${base}vocabulary/${previousOrdinal}/`}>← Prev</a>}{nextOrdinal?<a class="next" href={`${base}vocabulary/${nextOrdinal}/`}>Next →</a>:<a class="next" href={`${base}vocabulary/`}>Finish</a>}</div></nav>
</Base>
<script>
  const nav=document.querySelector('[data-lexical-study-nav]');if(nav instanceof HTMLElement){const ordinal=Number(nav.getAttribute('data-ordinal')||0);if(Number.isInteger(ordinal)&&ordinal>0){try{localStorage.setItem('kianos-vocabulary-last-ordinal',String(ordinal))}catch{}}}
  document.addEventListener('keydown',(event)=>{if(event.defaultPrevented||event.code!=='Space')return;const target=event.target;if(target instanceof HTMLElement&&target.closest('input,textarea,select,button,a,[contenteditable="true"]'))return;const details=document.querySelector('[data-local-port="vocabulary"] [data-vocab-details]');if(!(details instanceof HTMLElement)||details.hidden)return;const next=nav?.querySelector('[data-lexical-next]');if(!(next instanceof HTMLAnchorElement))return;event.preventDefault();window.location.href=next.href});
</script>
<style>
.lexicalStudyNav{max-width:72rem;margin:0 auto 1rem;padding:.75rem .9rem;border:1px solid var(--line,#d7d7d7);border-radius:.85rem;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:.8rem;background:var(--panel,#fff)}.lexicalStudyNav>span{font-size:.82rem;opacity:.58}.lexicalStudyNav>div{justify-self:end;display:flex;gap:.5rem}.lexicalStudyNav a{color:inherit;text-decoration:none;padding:.38rem .55rem;border-radius:.55rem}.lexicalStudyNav a.next{font-weight:700}.lexicalStudyNavBottom{margin-top:1rem;margin-bottom:0;grid-template-columns:1fr auto}@media(max-width:640px){.lexicalStudyNav{grid-template-columns:1fr auto}.lexicalStudyNav>span{display:none}}
</style>
<style is:global>
/* Kian visual calibration: keep the editorial sense grammar, but lower pressure on both lanes. */
body#kianos-workspace.uiWordStudy .lexicalSenseRow{column-gap:22px;padding:16px 24px 17px;}
body#kianos-workspace.uiWordStudy .lexicalSenseRow>header{gap:7px;padding-top:2px;}
body#kianos-workspace.uiWordStudy .lexicalSenseMeaning>p{line-height:1.5;}
body#kianos-workspace.uiWordStudy .lexicalSenseMeaning>strong{margin-top:4px;line-height:1.55;}
body#kianos-workspace.uiWordStudy .lexicalSenseNote{margin-top:7px;line-height:1.5;}
body#kianos-workspace.uiWordStudy .lexicalSenseUsage{gap:6px 18px;}
body#kianos-workspace.uiWordStudy .lexicalSenseUsage li{padding:3px 28px 6px 0;}
body#kianos-workspace.uiWordStudy .lexicalSenseUsage li>b{line-height:1.45;}
body#kianos-workspace.uiWordStudy .lexicalSenseUsage li>span{line-height:1.45;margin-top:2px;}

/* Restore the earlier companion-card hierarchy; the rail itself stays visually quiet. */
body#kianos-workspace.uiWordStudy .portedVocabEvidenceColumn{padding:12px;background:#f4f7f5;border-left:1px solid #dde6de;}
body#kianos-workspace.uiWordStudy .lexicalExpansionSection{padding:17px 18px 18px;margin:0 0 10px;border:1px solid #dce5df;border-radius:8px;background:#fff;}
body#kianos-workspace.uiWordStudy .lexicalExpansionSection:last-child{margin-bottom:0;}
body#kianos-workspace.uiWordStudy .lexicalExpansionSection>header{margin-bottom:11px;}
body#kianos-workspace.uiWordStudy .portedVocabEvidenceList{gap:2px;}
body#kianos-workspace.uiWordStudy .portedVocabEvidenceList>article{padding:10px 29px 11px 0;}
body#kianos-workspace.uiWordStudy .portedVocabEvidenceList>article>b{line-height:1.48;}
body#kianos-workspace.uiWordStudy .portedVocabEvidenceList>article>p{line-height:1.56;margin-top:4px;}
body#kianos-workspace.uiWordStudy .portedVocabEvidenceList>article>small{line-height:1.5;margin-top:3px;}
body#kianos-workspace.uiWordStudy .lexicalFormVariants{gap:8px;}
body#kianos-workspace.uiWordStudy .lexicalFormVariants article{padding:10px 11px;}
body#kianos-workspace.uiWordStudy .lexicalFamilyRows{gap:8px 14px;}

/* When structured pronunciation variants already carry the distinction, don't repeat the long audit-style boundary sentence. */
body#kianos-workspace.uiWordStudy .lexicalFormSection:has(.lexicalFormVariants) .lexicalFormBoundary{display:none;}
body#kianos-workspace.uiWordStudy .lexicalFormSection:not(:has(.lexicalFormVariants)) .lexicalFormBoundary{font-size:12px;line-height:1.5;color:#859389;}

@media(max-width:1180px){
  body#kianos-workspace.uiWordStudy .lexicalSenseRow{column-gap:17px;padding:14px 19px 15px;}
  body#kianos-workspace.uiWordStudy .portedVocabEvidenceColumn{padding:10px;}
  body#kianos-workspace.uiWordStudy .lexicalExpansionSection{padding:15px 16px 16px;}
}
@media(max-width:900px){
  body#kianos-workspace.uiWordStudy .portedVocabEvidenceColumn{padding:10px;border-left:0;}
  body#kianos-workspace.uiWordStudy .lexicalExpansionSection{margin:0 0 10px;border-right:1px solid #dce5df;}
}
</style>
