---
import Base from '../../layouts/Base.astro';
import VocabularyWordRuntime from '../../components/VocabularyWordRuntime.astro';
import VocabularyLegacyPresentation from '../../components/VocabularyLegacyPresentation.astro';
import { listLexicalOrdinals, loadLexicalWordByOrdinal } from '../../lib/lexical.mjs';

export function getStaticPaths() {
  return listLexicalOrdinals().map((ordinal) => ({ params: { ordinal: String(ordinal) }, props: { ordinal } }));
}

const { ordinal } = Astro.props;
const answer = loadLexicalWordByOrdinal(Number(ordinal));
const total = listLexicalOrdinals().length;
const previousOrdinal = answer.ordinal > 1 ? answer.ordinal - 1 : null;
const nextOrdinal = answer.ordinal < total ? answer.ordinal + 1 : null;
const base = import.meta.env.BASE_URL;
---
<Base
  title={answer.record.word}
  kicker={`LexicalOS · Study · ${answer.ordinal} / ${total}`}
  description="先看 Recall Map 深搜；Space Reveal。Reveal 后只对真正慢、模糊、漏掉或需要产出的具体分支按 +；Space 直接下一词。"
  sourcePath={answer.sourcePath}
  sourceHash={answer.sourceHash}
  objectId={answer.objectId}
  active="lexical"
  showLead={false}
>
  <nav class="lexicalStudyNav" data-lexical-study-nav data-ordinal={answer.ordinal}>
    <a href={`${base}vocabulary/`}>Vocabulary</a>
    <span>{answer.ordinal} / {total}</span>
    <div>
      {previousOrdinal ? <a href={`${base}vocabulary/${previousOrdinal}/`}>← Prev</a> : <span>← Prev</span>}
      {nextOrdinal
        ? <a class="next" data-lexical-next href={`${base}vocabulary/${nextOrdinal}/`}>Next →</a>
        : <a class="next" data-lexical-next href={`${base}vocabulary/`}>Finish</a>}
    </div>
  </nav>

  <VocabularyWordRuntime answer={answer} />
  <VocabularyLegacyPresentation answer={answer} />

  <nav class="lexicalStudyNav lexicalStudyNavBottom">
    <a href={`${base}vocabulary/`}>Back to Vocabulary</a>
    <div>
      {previousOrdinal && <a href={`${base}vocabulary/${previousOrdinal}/`}>← Prev</a>}
      {nextOrdinal ? <a class="next" href={`${base}vocabulary/${nextOrdinal}/`}>Next →</a> : <a class="next" href={`${base}vocabulary/`}>Finish</a>}
    </div>
  </nav>
</Base>

<script>
  const nav = document.querySelector('[data-lexical-study-nav]');
  if (nav instanceof HTMLElement) {
    const ordinal = Number(nav.getAttribute('data-ordinal') || 0);
    if (Number.isInteger(ordinal) && ordinal > 0) {
      try { localStorage.setItem('kianos-vocabulary-last-ordinal', String(ordinal)); } catch {}
    }
  }

  document.addEventListener('keydown', (event) => {
    if (event.defaultPrevented || event.code !== 'Space') return;
    const target = event.target;
    if (target instanceof HTMLElement && target.closest('input,textarea,select,button,a,[contenteditable="true"]')) return;
    const details = document.querySelector('[data-local-port="vocabulary"] [data-vocab-details]');
    if (!(details instanceof HTMLElement) || details.hidden) return;
    const next = nav?.querySelector('[data-lexical-next]');
    if (!(next instanceof HTMLAnchorElement)) return;
    event.preventDefault();
    window.location.href = next.href;
  });
</script>

<style>
  .lexicalStudyNav { max-width: 72rem; margin: 0 auto 1rem; padding: .75rem .9rem; border: 1px solid var(--line, #d7d7d7); border-radius: .85rem; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: .8rem; background: var(--panel, #fff); }
  .lexicalStudyNav > span { font-size: .82rem; opacity: .58; }
  .lexicalStudyNav > div { justify-self: end; display: flex; gap: .5rem; }
  .lexicalStudyNav a { color: inherit; text-decoration: none; padding: .38rem .55rem; border-radius: .55rem; }
  .lexicalStudyNav a.next { font-weight: 700; }
  .lexicalStudyNavBottom { margin-top: 1rem; margin-bottom: 0; grid-template-columns: 1fr auto; }
  @media (max-width: 640px) {
    .lexicalStudyNav { grid-template-columns: 1fr auto; }
    .lexicalStudyNav > span { display: none; }
  }
</style>

<style is:global>
  /* Word study is an immersive task surface. Vocabulary Home keeps the OS rail;
     an opened word keeps its own Back/Prev/Next context and uses the Mac width. */
  @media (min-width: 1001px) {
    body.surfaceBody-lexical:has(#main-content.noPageLead .portedVocabRuntime) .legacyProductShell {
      grid-template-columns: minmax(0, 1fr);
    }

    body.surfaceBody-lexical:has(#main-content.noPageLead .portedVocabRuntime) .legacyOsRail {
      display: none;
    }
  }

  /* Legacy positive reference: one sense is a two-owner row.
     Left = POS / governing pattern / full definition.
     Right = fixed structures / common collocations. */
  :root body.surfaceBody-lexical #main-content .portedVocabSenseList > section.portedVocabSenseRow {
    grid-template-columns: minmax(0, .94fr) minmax(430px, 1.06fr);
    grid-template-rows: auto minmax(0, 1fr);
  }

  :root body.surfaceBody-lexical #main-content .portedVocabSenseRow > .portedVocabSenseHeading {
    grid-column: 1;
    grid-row: 1;
    padding: 10px 12px 0;
  }

  :root body.surfaceBody-lexical #main-content .portedVocabSenseRow > .portedVocabSenseMeaning {
    grid-column: 1;
    grid-row: 2;
    padding: 6px 12px 12px;
  }

  :root body.surfaceBody-lexical #main-content .portedVocabSenseRow > .portedVocabSenseFacts {
    grid-column: 2;
    grid-row: 1 / 3;
    align-content: center;
    min-width: 0;
    border-top: 0;
    border-left: 1px solid #e1e2dc;
  }

  :root body.surfaceBody-lexical #main-content .portedVocabSenseRow .portedVocabSenseDefinition {
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
  }

  :root body.surfaceBody-lexical #main-content .portedVocabSenseRow .portedVocabSenseEn {
    order: 1;
  }

  :root body.surfaceBody-lexical #main-content .portedVocabSenseRow .portedVocabSenseCn {
    order: 2;
  }

  @media (max-width: 820px) {
    :root body.surfaceBody-lexical #main-content .portedVocabSenseList > section.portedVocabSenseRow {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto auto;
    }

    :root body.surfaceBody-lexical #main-content .portedVocabSenseRow > .portedVocabSenseHeading,
    :root body.surfaceBody-lexical #main-content .portedVocabSenseRow > .portedVocabSenseMeaning,
    :root body.surfaceBody-lexical #main-content .portedVocabSenseRow > .portedVocabSenseFacts {
      grid-column: 1;
      grid-row: auto;
    }

    :root body.surfaceBody-lexical #main-content .portedVocabSenseRow > .portedVocabSenseFacts {
      border-top: 1px solid #e1e2dc;
      border-left: 0;
    }
  }
</style>
