---
import Base from '../../layouts/LexicalBase.astro';
import VocabularyIdentityLineageBridge from '../../components/VocabularyIdentityLineageBridge.astro';
import VocabularyWordRuntime from '../../components/VocabularyWordRuntime.astro';
import VocabularyEvidenceBridge from '../../components/VocabularyEvidenceBridge.astro';
import { listLexicalOrdinals, loadLexicalWordByOrdinal } from '../../lib/lexical.mjs';
export function getStaticPaths(){return listLexicalOrdinals().map((ordinal)=>({params:{ordinal:String(ordinal)},props:{ordinal}}));}
const { ordinal }=Astro.props;const answer=loadLexicalWordByOrdinal(Number(ordinal));const total=listLexicalOrdinals().length;const previousOrdinal=answer.ordinal>1?answer.ordinal-1:null;const nextOrdinal=answer.ordinal<total?answer.ordinal+1:null;const base=import.meta.env.BASE_URL;const nextHref=nextOrdinal?`${base}vocabulary/${nextOrdinal}/`:`${base}vocabulary/`;
---
<Base title={answer.record.word} kicker={`LexicalOS · Study · ${answer.ordinal} / ${total}`} description="先做整词 Known/Fuzzy/Unknown routing；需要时进入 Recall → Reveal。Reveal 后只对真正值得未来 attention 的具体分支按 +；整卡 Depth 本身不会制造 Repair。" sourcePath={answer.sourcePath} sourceHash={answer.sourceHash} objectId={answer.objectId} active="lexical" showLead={false}>
  <nav class="lexicalStudyNav" data-lexical-study-nav data-ordinal={answer.ordinal}><a href={`${base}vocabulary/`}>‹ 返回词汇</a><span>Coverage · {answer.ordinal} / {total}</span><div>{previousOrdinal?<a href={`${base}vocabulary/${previousOrdinal}/`} aria-label="上一词">←</a>:<span aria-hidden="true">←</span>}{nextOrdinal?<a class="next" data-lexical-next href={`${base}vocabulary/${nextOrdinal}/`} aria-label="下一词">→</a>:<a class="next" data-lexical-next href={`${base}vocabulary/`}>完成</a>}</div></nav>
  <VocabularyIdentityLineageBridge lineage={answer.senseLineage}/>
  <VocabularyWordRuntime answer={answer}/><VocabularyEvidenceBridge nextHref={nextHref}/>
  <nav class="lexicalStudyNav lexicalStudyNavBottom"><a href={`${base}vocabulary/`}>Back to Vocabulary</a><div>{previousOrdinal&&<a href={`${base}vocabulary/${previousOrdinal}/`}>← Prev</a>}{nextOrdinal?<a class="next" href={`${base}vocabulary/${nextOrdinal}/`}>Next →</a>:<a class="next" href={`${base}vocabulary/`}>Finish</a>}</div></nav>
</Base>
<script>
  const nav=document.querySelector('[data-lexical-study-nav]');
  const root=document.querySelector('[data-local-port="vocabulary"]');
  const requestedMode=new URLSearchParams(location.search).get('mode');
  const mode=['lookup','repair'].includes(String(requestedMode||''))?String(requestedMode):'study';
  if(root instanceof HTMLElement) root.dataset.vocabMode=mode;
  if(nav instanceof HTMLElement){
    nav.dataset.lexicalMode=mode;
    const center=nav.querySelector(':scope>span');
    if(center) center.textContent=mode==='lookup'?'Lookup':mode==='repair'?'Repair':center.textContent;
    const ordinal=Number(nav.getAttribute('data-ordinal')||0);
    if(mode==='study'&&Number.isInteger(ordinal)&&ordinal>0){
      try{localStorage.setItem('kianos-vocabulary-last-ordinal',String(ordinal))}catch{}
    }
  }
  document.body.dataset.lexicalMode=mode;
</script>
