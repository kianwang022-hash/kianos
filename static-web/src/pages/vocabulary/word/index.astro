---
import Base from '../../../layouts/LexicalBase.astro';
import VocabularyIdentityLineageBridge from '../../../components/VocabularyIdentityLineageBridge.astro';
import VocabularyWordRuntime from '../../../components/VocabularyWordRuntime.astro';
import VocabularyEvidenceBridge from '../../../components/VocabularyEvidenceBridge.astro';
import { lexicalRuntimeManifest } from '../../../lib/lexical.mjs';

const base = import.meta.env.BASE_URL;
const runtimeManifest = lexicalRuntimeManifest();
const total = runtimeManifest.object_count;
const runtimeManifestPayload = JSON.stringify(runtimeManifest).replace(/</g, '\\u003c');
---
<Base
  title="Vocabulary"
  kicker="LexicalOS · Word Runtime"
  description=""
  sourcePath="content/lexical/learner/final/manifest.json"
  objectId="lexical:vocabulary-word-runtime"
  active="lexical"
  showLead={false}
>
  <nav class="lexicalStudyNav" data-lexical-study-nav data-ordinal="">
    <a href={base + 'vocabulary/'}>‹ 返回词汇</a>
    <span data-vocab-runtime-position>Coverage</span>
    <div>
      <a data-vocab-runtime-prev aria-label="上一词">←</a>
      <a class="next" data-vocab-runtime-next aria-label="下一词">→</a>
    </div>
  </nav>

  <div data-vocab-runtime-host data-base={base} data-total={total} aria-busy="true">
    <p class="lexicalEmpty">正在载入词汇…</p>
  </div>
  <script type="application/json" data-lexical-runtime-manifest set:html={runtimeManifestPayload}></script>

  <VocabularyIdentityLineageBridge />
  <VocabularyWordRuntime />
  <VocabularyEvidenceBridge total={total} />
</Base>

<script>
  import {
    lexicalRevisitContext,
    lexicalStudyNeighbors,
    lexicalLegacyDisplayHref,
    lexicalWordOrdinal,
    lexicalWordRuntimeHref
  } from '../../../lib/lexicalRuntimeRoute.mjs';

  import { localLexicalDay } from '../../../lib/lexicalSettings.mjs';
  import { learnerWriterReady } from '../../../lib/browserLearnerWriter.mjs';

  const initialHost = document.querySelector('[data-vocab-runtime-host]');
  const manifestNode = document.querySelector('[data-lexical-runtime-manifest]');
  const nav = document.querySelector('[data-lexical-study-nav]');
  const releaseSha = document.querySelector('[data-kianos-release-sha]')?.getAttribute('data-kianos-release-sha') || '';
  const transportTextCache = new Map();
  const transportTextLimit = 5;
  const parsedShardCache = new Map();
  const parsedShardLimit = 3;
  let currentRoot = null;
  let navigationToken = 0;

  if (!(initialHost instanceof HTMLElement) || !(manifestNode instanceof HTMLScriptElement)) {
    throw new Error('LEXICAL_RUNTIME_BOOTSTRAP_MISSING');
  }

  const base = initialHost.getAttribute('data-base') || '/';
  let manifest;
  try { manifest = JSON.parse(manifestNode.textContent || '{}'); }
  catch { manifest = null; }
  const total = Number(manifest?.object_count || initialHost.getAttribute('data-total') || 0);
  const shards = Array.isArray(manifest?.shards) ? manifest.shards : [];

  const modeFromLocation = () => {
    const requested = new URLSearchParams(location.search).get('mode');
    return ['lookup', 'repair'].includes(String(requested || '')) ? String(requested) : 'study';
  };

  const shardForOrdinal = (ordinal) => shards.find(
    (row) => Number(row?.start) <= ordinal && ordinal <= Number(row?.end)
  ) || null;

  const transportUrl = (shard) => new URL(
    base + 'vocabulary-data/' + encodeURIComponent(shard.key) + '/',
    location.origin
  ).href;

  const fetchTransport = async (shard) => {
    const response = await fetch(transportUrl(shard), { cache: 'no-store' });
    if (!response.ok) throw new Error('LEXICAL_RUNTIME_FRAGMENT_UNAVAILABLE');
    const servedRelease = String(response.headers.get('x-kianos-release-sha') || '').trim();
    if (releaseSha && servedRelease && servedRelease !== releaseSha) {
      location.reload();
      throw new Error('LEXICAL_RUNTIME_RELEASE_CHANGED');
    }
    return response;
  };

  const rememberTransportText = (key, promise) => {
    if (transportTextCache.has(key)) transportTextCache.delete(key);
    transportTextCache.set(key, promise);
    while (transportTextCache.size > transportTextLimit) {
      const oldest = transportTextCache.keys().next().value;
      transportTextCache.delete(oldest);
    }
  };

  const loadTransportText = async (shard) => {
    const key = String(shard?.key || '');
    if (!key) throw new Error('LEXICAL_RUNTIME_SHARD_MISSING');
    const existing = transportTextCache.get(key);
    if (existing) {
      rememberTransportText(key, existing);
      return existing;
    }
    const pending = (async () => {
      const response = await fetchTransport(shard);
      return response.text();
    })();
    rememberTransportText(key, pending);
    try { return await pending; }
    catch (error) {
      if (transportTextCache.get(key) === pending) transportTextCache.delete(key);
      throw error;
    }
  };

  const rememberParsedShard = (key, promise) => {
    if (parsedShardCache.has(key)) parsedShardCache.delete(key);
    parsedShardCache.set(key, promise);
    while (parsedShardCache.size > parsedShardLimit) {
      const oldest = parsedShardCache.keys().next().value;
      parsedShardCache.delete(oldest);
    }
  };

  const loadShard = async (shard) => {
    const key = String(shard?.key || '');
    if (!key) throw new Error('LEXICAL_RUNTIME_SHARD_MISSING');
    const existing = parsedShardCache.get(key);
    if (existing) {
      rememberParsedShard(key, existing);
      return existing;
    }
    const pending = (async () => {
      const html = await loadTransportText(shard);
      return new DOMParser().parseFromString(html, 'text/html');
    })();
    rememberParsedShard(key, pending);
    try { return await pending; }
    catch (error) {
      if (parsedShardCache.get(key) === pending) parsedShardCache.delete(key);
      throw error;
    }
  };

  const displayHref = (ordinal, mode, routeLocation) => {
    const current = new URLSearchParams(routeLocation.search);
    const display = new URL(current.has('revisit')
      ? lexicalWordRuntimeHref(base, ordinal, mode)
      : lexicalLegacyDisplayHref(base, ordinal, mode), location.origin);
    for (const [key, value] of current.entries()) {
      if (key !== 'o' && key !== 'mode') display.searchParams.set(key, value);
    }
    return display.pathname + display.search + display.hash;
  };

  const updateHistory = (ordinal, mode, action, routeLocation) => {
    const href = displayHref(ordinal, mode, routeLocation);
    const state = { lexicalOrdinal: ordinal, lexicalMode: mode };
    if (action === 'push') history.pushState(state, '', href);
    else if (action === 'replace') history.replaceState(state, '', href);
  };

  const fail = (message) => {
    if (currentRoot instanceof HTMLElement) {
      console.error(message);
      return;
    }
    if (!initialHost.isConnected) return;
    initialHost.replaceChildren();
    const note = document.createElement('p');
    note.className = 'lexicalEmpty';
    note.textContent = message;
    initialHost.appendChild(note);
    initialHost.setAttribute('aria-busy', 'false');
  };

  const updateNav = (ordinal, mode, revisit) => {
    const neighbors = lexicalStudyNeighbors(ordinal, total, revisit);
    if (!(nav instanceof HTMLElement)) return;
    nav.dataset.ordinal = String(ordinal);
    nav.dataset.lexicalMode = mode;
    const center = nav.querySelector('[data-vocab-runtime-position]');
    if (center) center.textContent = mode === 'lookup'
      ? 'Lookup'
      : mode === 'repair'
        ? 'Repair'
        : (revisit ? '同日待重学' : 'Coverage') + ' · ' + neighbors.position + ' / ' + neighbors.count;
    const previous = nav.querySelector('[data-vocab-runtime-prev]');
    const next = nav.querySelector('[data-vocab-runtime-next]');
    if (previous instanceof HTMLAnchorElement) {
      if (neighbors.previous) previous.href = lexicalWordRuntimeHref(base, neighbors.previous, mode, revisit);
      else previous.removeAttribute('href');
    }
    if (next instanceof HTMLAnchorElement) {
      next.href = neighbors.next
        ? lexicalWordRuntimeHref(base, neighbors.next, mode, revisit)
        : base + 'vocabulary/';
      next.textContent = neighbors.next ? '→' : '完成';
    }
  };

  const prefetchAdjacent = (shard) => {
    const index = shards.indexOf(shard);
    for (const neighbor of [shards[index - 1], shards[index + 1]]) {
      if (neighbor?.key) void loadTransportText(neighbor).catch(() => {});
    }
  };

  const loadWord = async (ordinal, mode = modeFromLocation(), historyAction = 'push', routeLocation = location) => {
    const revisit = lexicalRevisitContext(routeLocation, total, localLexicalDay());
    if ((revisit && mode !== 'study') || lexicalStudyNeighbors(ordinal, total, revisit).invalid) {
      location.assign(base + 'vocabulary/');
      return;
    }
    if (!Number.isInteger(ordinal) || ordinal < 1 || ordinal > total) {
      location.assign(base + 'vocabulary/');
      return;
    }
    const shard = shardForOrdinal(ordinal);
    if (!shard?.key) { fail('当前词汇数据不可用。'); return; }

    const token = ++navigationToken;
    try {
      const doc = await loadShard(shard);
      if (token !== navigationToken) return;
      const root = doc.querySelector('[data-vocab-ordinal="' + ordinal + '"]');
      if (!(root instanceof HTMLElement)) throw new Error('LEXICAL_RUNTIME_WORD_MISSING');
      const imported = document.importNode(root, true);
      const previousRoot = currentRoot instanceof HTMLElement
        ? currentRoot
        : document.querySelector('[data-local-port="vocabulary"]');

      if (previousRoot instanceof HTMLElement) {
        window.dispatchEvent(new CustomEvent('kianos:vocabulary-root-dispose', {
          detail: { root: previousRoot }
        }));
        previousRoot.replaceWith(imported);
      } else if (initialHost.isConnected) {
        initialHost.replaceWith(imported);
      } else {
        throw new Error('LEXICAL_RUNTIME_MOUNT_MISSING');
      }
      currentRoot = imported;

      if (historyAction === 'push' || historyAction === 'replace') {
        updateHistory(ordinal, mode, historyAction, routeLocation);
      }
      window.dispatchEvent(new CustomEvent('kianos:runtime-route-changed', {
        detail: { source: 'vocabulary', ordinal, mode }
      }));
      imported.dataset.vocabMode = mode;
      updateNav(ordinal, mode, revisit);

      const word = imported.getAttribute('data-vocab-word') || 'Vocabulary';
      document.body.dataset.lexicalMode = mode;
      document.title = word + ' · KianOS';
      if (mode === 'study' && !revisit) {
        try { localStorage.setItem('kianos-vocabulary-last-ordinal', String(ordinal)); } catch {}
      }
      document.querySelector('.kianosShellMain > .productCanvas')?.scrollTo({ top: 0, behavior: 'instant' });

      window.dispatchEvent(new CustomEvent('kianos:vocabulary-root-ready', {
        detail: { ordinal, word, mode }
      }));
      window.dispatchEvent(new CustomEvent('kianos:runtime-route-changed', {
        detail: { source: 'lexical', ordinal, mode, pathname: location.pathname }
      }));
      prefetchAdjacent(shard);
    } catch (error) {
      console.error(error);
      fail('当前词汇加载失败，请返回 Vocabulary 后重试。');
    }
  };

  window.addEventListener('kianos:vocabulary-navigate', (event) => {
    const detail = event instanceof CustomEvent ? event.detail || {} : {};
    const ordinal = Number(detail.ordinal || 0);
    const mode = ['lookup', 'repair'].includes(String(detail.mode || ''))
      ? String(detail.mode)
      : 'study';
    if (!Number.isInteger(ordinal) || ordinal < 1 || ordinal > total) return;
    let routeLocation = location;
    if (detail.href) {
      const target = new URL(detail.href, location.origin);
      if (target.origin !== location.origin) return;
      routeLocation = target;
    }
    void loadWord(ordinal, mode, detail.history === 'replace' ? 'replace' : 'push', routeLocation);
  });

  nav?.addEventListener('click', (event) => {
    const target = event.target instanceof Element
      ? event.target.closest('[data-vocab-runtime-prev],[data-vocab-runtime-next]')
      : null;
    if (!(target instanceof HTMLAnchorElement) || !target.hasAttribute('href')) return;
    let url;
    try { url = new URL(target.href, location.origin); } catch { return; }
    const ordinal = lexicalWordOrdinal(url);
    if (!Number.isInteger(ordinal) || ordinal < 1 || ordinal > total) return;
    event.preventDefault();
    void loadWord(ordinal, modeFromLocation(), 'push', url);
  });

  window.addEventListener('popstate', () => {
    const ordinal = lexicalWordOrdinal(location);
    if (!Number.isInteger(ordinal) || ordinal < 1 || ordinal > total) return;
    void loadWord(ordinal, modeFromLocation(), 'none');
  });

  const initialOrdinal = lexicalWordOrdinal(location);
  const initialMode = modeFromLocation();
  void learnerWriterReady.then(() => loadWord(initialOrdinal, initialMode, 'replace'));
</script>
