---
import '../styles/home-workbench.css';
import ExamOrchestratorHome from '../components/ExamOrchestratorHome.astro';
import HomeSubjectProjection from '../components/HomeSubjectProjection.astro';
import Base from '../layouts/Base.astro';
import { buildHomeSubjectProjections } from '../lib/homeSubjectProjection.mjs';

const base = import.meta.env.BASE_URL;
const subjects = buildHomeSubjectProjections(base);
---
<Base title="Home" active="home" showLead={false}>
  <div class="homeWorkbench" data-home-workbench data-base={base}>
    <header class="homeCommandHead">
      <div class="homeCommandMeta">
        <span>HOME</span>
        <time data-home-day>—</time>
      </div>

      <div class="homeCommandLine">
        <div class="homePhaseSummary">
          <strong data-home-phase data-exam-phase>一轮收口</strong>
          <span data-home-gate data-exam-gate>按本轮时间线定位</span>
        </div>

        <dl class="homeCapacitySummary" aria-label="今日学习容量">
          <div><dt>今日</dt><dd data-home-capacity-day>—</dd></div>
          <div><dt>已学</dt><dd data-home-capacity-actual>—</dd></div>
          <div><dt>剩余</dt><dd data-home-capacity-remaining>—</dd></div>
        </dl>
      </div>
    </header>

    <main class="homeToday" aria-labelledby="home-today-title">
      <header class="homeTodayHead">
        <div>
          <h1 id="home-today-title">今天</h1>
          <p>按真实可用时间滚动安排；实际推进会更新剩余，不补昨天的欠账。</p>
        </div>

        <div class="homeSchedulerRuntime" aria-label="今日安排工具">
          <ExamOrchestratorHome />
        </div>
      </header>

      <section class="homeNextStrip" aria-label="下一步">
        <span>下一步</span>
        <a data-home-next-link href={`${base}xizong/`}>
          <strong data-home-next-title>等待今日安排</strong>
          <b aria-hidden="true">→</b>
        </a>
      </section>

      <div class="homeSubjectList" aria-label="三科今日安排">
        {subjects.map((subject) => <HomeSubjectProjection subject={subject} />)}
      </div>

      <section class="homePlanAttention" data-home-plan-attention hidden>
        <p data-home-plan-attention-text></p>
        <button type="button" data-home-plan-attention-action>为什么？</button>
      </section>
    </main>
  </div>
</Base>

<script>
  import { initHomeResumeSurfaces } from '../lib/homeResumeClient.mjs';
  import { initHomeScheduler } from '../lib/homeSchedulerClient.mjs';

  initHomeResumeSurfaces(document);
  initHomeScheduler(document);
</script>