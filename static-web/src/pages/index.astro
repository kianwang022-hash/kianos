---
import Base from '../layouts/Base.astro';
import { buildRevision, inspectReadingSources } from '../lib/current.mjs';
import { inspectLexicalSources } from '../lib/lexical.mjs';
import { listProjectableXizongSystems } from '../lib/xizong.mjs';
import { listPoliticsSubjectsCurrent, politicsCurrentHealth } from '../lib/politicsCurrent.mjs';
import { loadWritingLearningProjection } from '../lib/englishWritingLearning.mjs';
import { inspectWritingSyntheticTasks } from '../lib/englishWritingSynthetic.mjs';
import { inspectTranslationSources } from '../lib/englishTranslation.mjs';

const base = import.meta.env.BASE_URL;
const xizongSystems = listProjectableXizongSystems();
const xizongBlocks = xizongSystems.reduce((sum, system) => sum + system.blocks.length, 0);
const xizongKp = xizongSystems.reduce((sum, system) => sum + system.blocks.reduce((blockSum, block) => blockSum + block.kpCount, 0), 0);
const lexicalState = inspectLexicalSources();
const readingState = inspectReadingSources();
const readingReady = readingState.status === 'ready';
const translationState = inspectTranslationSources();
const politicsSubjects = listPoliticsSubjectsCurrent();
const politicsHealth = politicsCurrentHealth();
const politicsChapters = politicsSubjects.reduce((sum, subject) => sum + subject.chapters.length, 0);
const writingLearning = loadWritingLearningProjection();
const writingRuntime = inspectWritingSyntheticTasks();
const englishReady = readingReady
  && translationState.status === 'ready'
  && writingLearning.status === 'ready'
  && writingRuntime.status === 'ready';
---
<Base title="学习工作台" kicker="KianOS · Current learner runtime" description="Chat 维护 GitHub Current 内容；Astro 把它变成低摩擦学习动作。" active="home">
  <section class="homeCurrentStrip">
    <div>
      <p class="pageKicker">Runtime contract</p>
      <h2>Current 内容层 + Astro</h2>
      <p>内容更新与 UI 功能已经分层。学习反馈先改正确的内容或互动，再由 Astro 直接投影。</p>
    </div>
    <aside><strong>Current connected</strong><span>build {buildRevision.slice(0, 12)}</span><span>private interaction state only when useful</span></aside>
  </section>

  <section class="homeGrid">
    <a class="homeLane" href={`${base}xizong/`}>
      <div><span>西医综合 · {xizongSystems.length ? 'v6 Ready' : 'Blocked'}</span><h2>System Runtime</h2></div>
      <p>{xizongSystems.length
        ? `${xizongSystems.length} 个 Current System · ${xizongBlocks} Blocks · ${xizongKp} KP；System → Block → Logic Group → KP。`
        : '尚无满足 Current system owner + Logic Group gate 的系统；Runtime 保持 fail-closed。'}</p>
      <footer><span>main@HEAD</span><b>{xizongSystems.length ? '进入 →' : '查看 →'}</b></footer>
    </a>
    <a class="homeLane" href={`${base}politics/`}>
      <div><span>政治 · {politicsHealth.status === 'ready' ? 'Ready' : 'Partial'}</span><h2>Politics</h2></div>
      <p>{politicsSubjects.length} 科 · {politicsChapters} 个 Current 学习章节；定位 → 乘风 → 小闭合 → 肖1000 → 错题最小回源。</p>
      <footer><span>content-first</span><b>进入 →</b></footer>
    </a>
    <a class="homeLane" href={`${base}vocabulary/`}>
      <div><span>LexicalOS · Ready</span><h2>Vocabulary</h2></div>
      <p>{lexicalState.wordCount} 个 Current Word · {lexicalState.relationCount} 个 Relation Owner；Continue / Search / Repair Review → Depth Scan → Challenge。</p>
      <footer><span>shared lexical supply</span><b>进入 →</b></footer>
    </a>
    <a class="homeLane" href={`${base}english/`}>
      <div><span>English · {englishReady ? 'Ready' : 'Partial'}</span><h2>Capability Runtime</h2></div>
      <p>Reading / Translation / Writing 三条任务能力 + Lexical shared supply；Cloze 与 Part B 作为专项 trainer，先继续真实能力，再按需回 First Learning。</p>
      <footer><span>capability-first</span><b>进入 English →</b></footer>
    </a>
  </section>
</Base>

<style>
  .homeGrid{grid-template-columns:repeat(2,minmax(0,1fr))}
  @media(max-width:760px){.homeGrid{grid-template-columns:1fr}}
</style>