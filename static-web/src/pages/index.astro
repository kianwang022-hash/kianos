---

import '../styles/product-closure.css';
import '../styles/home-workbench.css';
import ExamOrchestratorHome from '../components/ExamOrchestratorHome.astro';
import Base from '../layouts/Base.astro';
import HomeSubjectRouteBridge from '../components/HomeSubjectRouteBridge.astro';
import { inspectReadingSources } from '../lib/current.mjs';
import { inspectLexicalSources } from '../lib/lexical.mjs';
import { listProjectableXizongSystems, loadXizongBlock } from '../lib/xizong.mjs';
import { buildXizongProductionBlock } from '../lib/xizongProductionProjection.mjs';
import { listPoliticsSubjectsCurrent, politicsCurrentHealth } from '../lib/politicsCurrent.mjs';
import { loadWritingLearningProjection } from '../lib/englishWritingLearning.mjs';
import { inspectWritingSyntheticTasks } from '../lib/englishWritingSynthetic.mjs';
import { inspectTranslationSources } from '../lib/englishTranslation.mjs';

const base = import.meta.env.BASE_URL;
const xizongSystems = listProjectableXizongSystems();
const lexicalState = inspectLexicalSources();
const readingState = inspectReadingSources();
const readingReady = readingState.status === 'ready';
const translationState = inspectTranslationSources();
const politicsSubjects = listPoliticsSubjectsCurrent();
const politicsHealth = politicsCurrentHealth();
const politicsChapters = politicsSubjects.reduce((sum, subject) => sum + subject.chapters.length, 0);
const writingLearning = loadWritingLearningProjection();
const writingRuntime = inspectWritingSyntheticTasks();
const englishReady = readingReady
  && translationState.status === 'ready'
  && writingLearning.status === 'ready'
  && writingRuntime.status === 'ready';
const firstSystem = xizongSystems[0];
const firstSubject = politicsSubjects[0];
const firstChapter = firstSubject?.chapters?.[0];
const xizongResumeIndex = xizongSystems.map((system) => ({
  systemId: system.systemId,
  canonicalId: system.canonicalId,
  title: system.title,
  blocks: system.blocks.map((block) => ({
    blockId: block.blockId,
    slug: block.slug,
    label: block.label,
    title: block.title,
    kpCount: block.kpCount
  }))
}));
const xizongPacketIndex = xizongSystems.flatMap((system) => system.blocks.map((blockRef) => {
  const canonical = loadXizongBlock(system.systemId, blockRef.slug);
  const production = buildXizongProductionBlock(canonical);
  return {
    systemId: system.systemId,
    slug: blockRef.slug,
    blockId: canonical.blockId,
    blockLabel: canonical.label,
    packetMeta: {
      objectId: canonical.objectId,
      systemId: system.systemId,
      canonicalId: system.canonicalId,
      blockId: canonical.blockId,
      blockLabel: canonical.label,
      blockTitle: canonical.title,
      sourcePath: canonical.sourcePath,
      sourceHash: canonical.sourceHash,
      sourceContactMode: String(production?.sourceContact?.mode || ''),
      sourcePerGroup: production?.sourceContact?.logicGroupIsAutomaticSourceChunk === true,
      reserveItems: []
    },
    kpRows: production.kpRecords.map((kp) => ({
      kpId: kp.kpId,
      displayId: kp.displayId,
      title: kp.title,
      groupId: kp.groupId,
      groupLabel: kp.groupLabel,
      sourceLocator: kp.sourceLocator || '',
      prompt: kp.prompt || ''
    }))
  };
}));
const xizongHref = firstSystem ? `${base}xizong/${firstSystem.systemId}/` : `${base}xizong/`;
const politicsHref = firstSubject && firstChapter ? `${base}politics/${firstSubject.subject}/${firstChapter.code}/` : `${base}politics/`;

---
<Base title="学习工作台" active="home" showLead={false}>
  <header class="homeL3Header">
    <div class="homeL3HeaderCopy">
      <p class="pageKicker" data-exam-phase>一轮收口 · 总目标 425+</p>
      <h1>学习工作台</h1>
      <p class="homeL3Subtitle">按今天的安排，回到正在做的事。</p>
    </div>
    <div class="homeL3Gate examGate">
      <span>下个关键节点</span>
      <strong data-exam-gate>按本轮时间线定位</strong>
    </div>
  </header>

  <HomeSubjectRouteBridge
    xizongFirstHref={xizongHref}
    xizongFirstLabel={firstSystem ? `${firstSystem.canonicalId} · ${firstSystem.title}` : '选择西综学习位置'}
    xizongResumeIndex={xizongResumeIndex}
    politicsFirstHref={politicsHref}
    politicsFirstLabel={firstChapter ? `${firstSubject.label} · ${firstChapter.title}` : '选择政治学习位置'}
  />

  <div class="homeL3Grid">
    <section class="homeL3Subjects" aria-label="三科状态与备用入口">
      <header class="homeL3SectionHead">
        <h2>三科状态</h2>
        <span>正常按右侧「下一步」执行；这里用于查看科内状态</span>
      </header>

      <article class="homeL3Subject" data-home-subject="xizong">
        <header class="homeL3SubjectHead">
          <div class="homeL3SubjectIdentity">
            <div class="homeL3SubjectTitle"><h2>西医综合</h2></div>
          </div>
          <a class="homeL3OverviewLink" href={`${base}xizong/`}>西综 Home →</a>
        </header>
        <p class="homeL3Meta">原讲义连续学习 · 框架定位 · 主动回忆</p>
      </article>

      <article class="homeL3Subject" data-home-subject="english">
        <header class="homeL3SubjectHead">
          <div class="homeL3SubjectIdentity">
            <div class="homeL3SubjectTitle"><h2>English</h2></div>
          </div>
          <a class="homeL3OverviewLink" href={`${base}english/`}>英语 Home →</a>
        </header>
        <p class="homeL3Meta">完整任务优先 · 阅读、翻译与写作</p>
      </article>

      <article class="homeL3Subject" data-home-subject="politics">
        <header class="homeL3SubjectHead">
          <div class="homeL3SubjectIdentity">
            <div class="homeL3SubjectTitle"><h2>政治</h2></div>
          </div>
          <a class="homeL3OverviewLink" href={`${base}politics/`}>政治 Home →</a>
        </header>
        <p class="homeL3Meta">乘风原讲义 → 肖1000 验证 → 精准回源</p>
      </article>
    </section>

    <aside class="homeL3Support" aria-label="今日安排与学习支持">
      <ExamOrchestratorHome xizongPacketIndex={xizongPacketIndex} />
    </aside>
  </div>
</Base>