---
import Base from '../layouts/Base.astro';
import { buildRevision, inspectReadingSources, loadAnswer } from '../lib/current.mjs';
import { listProjectableXizongSystems } from '../lib/xizong.mjs';

const base = import.meta.env.BASE_URL;
const xizongSystems = listProjectableXizongSystems();
const xizongBlocks = xizongSystems.reduce((sum, system) => sum + system.blocks.length, 0);
const xizongKp = xizongSystems.reduce((sum, system) => sum + system.blocks.reduce((blockSum, block) => blockSum + block.kpCount, 0), 0);
const answer = loadAnswer();
const readingState = inspectReadingSources();
const readingReady = readingState.status === 'ready';
---
<Base title="学习工作台" kicker="KianOS · Current learner runtime" description="Chat 维护 GitHub Current 内容；Astro 负责 learner-facing UI / 功能；动态学习状态只留在本地。" active="home">
  <section class="homeCurrentStrip">
    <div>
      <p class="pageKicker">Runtime contract</p>
      <h2>Current 内容层 + Astro</h2>
      <p>内容更新与 UI 功能已经分层。普通内容升级只改 GitHub Current；Astro 按同一 canonical object 重新投影。</p>
    </div>
    <aside><strong>Current connected</strong><span>build {buildRevision.slice(0, 12)}</span><span>learner-state · browser local</span></aside>
  </section>

  <section class="homeGrid">
    <a class="homeLane" href={`${base}xizong/`}>
      <div><span>西医综合 · {xizongSystems.length ? 'v6 Ready' : 'Blocked'}</span><h2>System Runtime</h2></div>
      <p>{xizongSystems.length
        ? `${xizongSystems.length} 个 Current System · ${xizongBlocks} Blocks · ${xizongKp} KP；System → Block → Logic Group → KP。`
        : '尚无满足 Current system owner + Logic Group gate 的系统；Runtime 保持 fail-closed。'}</p>
      <footer><span>main@HEAD</span><b>{xizongSystems.length ? '进入 →' : '查看 →'}</b></footer>
    </a>
    <a class="homeLane" href={`${base}answer/`}>
      <div><span>LexicalOS · Ready</span><h2>{answer.record.word}</h2></div>
      <p>L0-first Study Card + Queue / Dictionary / History 入口；当前代表页只读取明确绑定的 Current 词条对象。</p>
      <footer><span>current-bound</span><b>进入 →</b></footer>
    </a>
    <a class="homeLane" href={`${base}reading/`}>
      <div><span>English · {readingReady ? 'Ready' : 'Blocked'}</span><h2>Reading</h2></div>
      <p>{readingReady
        ? 'Reading A Workspace · Attempt / Uncertain / History / Problem Record / 二刷；内容只来自 Current Exam Source。'
        : 'Current source 未通过读取条件；Runtime 保持 fail-closed，不回退 legacy 或历史版本。'}</p>
      <footer><span>{readingReady ? 'ready' : 'source-gated'}</span><b>{readingReady ? '进入 →' : '查看 →'}</b></footer>
    </a>
  </section>
</Base>
