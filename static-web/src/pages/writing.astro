---
import Base from '../layouts/Base.astro';
import { inspectWritingSyntheticTasks, listWritingSyntheticTasks } from '../lib/englishWritingSynthetic.mjs';
import { inspectWritingTrueExamEntry } from '../lib/englishWritingRuntimeSourceTruth.mjs';

const base = import.meta.env.BASE_URL;
const state = inspectWritingSyntheticTasks();
const tasks = listWritingSyntheticTasks();
const trueExam = inspectWritingTrueExamEntry();
const payload = JSON.stringify({ tasks, trueExam: trueExam.firstExam }).replace(/</g, '\\u003c');
---
<Base
  title="Writing"
  kicker="English · Productive Lane"
  description="Whole-essay productive runtime: preserve first evidence, use semantic review during calibration, repair only meaningful failures, and return to writing."
  active="home"
>
  <section class="writingHome" data-writing-home data-base={base}>
    <section class="writingHomeHero">
      <div>
        <span>Writing · Whole-Essay Runtime</span>
        <h2>Generate → Review → PASS / Repair → Continue</h2>
        <p>先用 synthetic 完整输出建立真实生成能力。first planning/content evidence 和 first draft 保存在本机；calibration 阶段用 Chat 做 semantic judgment，稳定后只让真正影响未来表现的问题进入 repair。</p>
      </div>
      <aside>
        <strong>{state.status === 'ready' ? `${tasks.length} synthetic tasks` : state.status}</strong>
        <span>whole essay = learner-facing attempt / review unit</span>
        <span>first evidence stays private on-device</span>
        <span>protected true exam stays hidden until entry condition is met</span>
      </aside>
    </section>

    <a class="writingLearnLink" href={`${base}writing-learn/`}>
      <div><span>First Learning</span><strong>Global Map → targeted primitive → real Writing</strong></div>
      <p>六个 primitive 是能力 owner，不是必须完成的课程。Small / Big 是 specialization；会的直接跳过，卡住再回来。</p>
      <b>学习框架 →</b>
    </a>

    {state.status !== 'ready' ? (
      <section class="writingHomeGate">
        <strong>Writing synthetic runtime source not ready</strong>
        <p>{state.issues.join(' · ') || 'Unknown runtime source issue.'}</p>
      </section>
    ) : (
      <section class="writingTaskGrid">
        {tasks.map((task) => (
          <a class="writingTaskCard" data-writing-task-card={task.id} href={`${base}writing/${encodeURIComponent(task.id)}/`}>
            <span>{task.kind === 'small' ? 'Small Writing' : 'Big Writing'} · synthetic</span>
            <strong>{task.title}</strong>
            <p>{task.kind === 'small' ? task.learnerTask.directions : task.learnerTask.visual_scenario}</p>
            <div><small>Target · {task.targetWords} words</small><b data-task-state={task.id}>未开始</b></div>
          </a>
        ))}
      </section>
    )}

    <section class="writingTrueExamShield" data-true-exam-shield>
      <div>
        <span>Protected true exam</span>
        <strong data-true-exam-title>现在不展示真题目录</strong>
      </div>
      <p data-true-exam-copy>Cold-start mechanics 和第一次完整输出先用 synthetic material。两种模式都有真实完整输出后，只释放第一篇 clean 真题来检查 synthetic skill 是否迁移到真实 prompt；不会为了工程验收消耗真题。</p>
      <a class="writingTrueExamEntry" data-true-exam-entry hidden href={`${base}writing/${encodeURIComponent(trueExam.firstExam.id)}/`}>
        开始第一篇 clean 真题 →
      </a>
    </section>

    <section class="writingRuntimeBoundary">
      <strong>Runtime boundary</strong>
      <p>浏览器保存 first evidence 与 unfinished state；Chat 在需要 semantic judgment 时做 whole-essay review。PASS 是出口；repair 只处理 smallest meaningful failure。只有可复用高价值问题才建立后台 transfer target，pending target 不在首页制造 learner attention debt。</p>
    </section>

    <script type="application/json" data-writing-catalog set:html={payload}></script>
  </section>
</Base>

<script>
  const root = document.querySelector('[data-writing-home]');
  if (root instanceof HTMLElement) {
    let catalog = { tasks: [], trueExam: null };
    try { catalog = JSON.parse(root.querySelector('[data-writing-catalog]')?.textContent || '{}'); } catch {}
    const tasks = Array.isArray(catalog?.tasks) ? catalog.tasks : [];
    const finalStates = new Set(['PASS_ACCEPTABLE', 'REPAIR_COMPLETE', 'TRANSFER_PENDING']);
    const stageText = (state) => ({
      ATTEMPT: '进行中 · Clean Attempt',
      REVIEW_PENDING: '待 semantic review',
      PASS_ACCEPTABLE: 'PASS / ACCEPTABLE',
      REPAIR_NEEDED: '需要最小 repair',
      REPAIR_CHECK_PENDING: 'repair 尚未确认',
      REPAIR_COMPLETE: 'Repair Complete',
      TRANSFER_PENDING: 'Repair Complete'
    })[state] || '未开始';

    let completed = 0;
    tasks.forEach((task) => {
      let saved = null;
      try { saved = JSON.parse(localStorage.getItem(`kianos-writing-runtime-v1:${task.id}`) || 'null'); } catch {}
      const taskState = saved?.state || '';
      if (finalStates.has(taskState)) completed += 1;
      const label = root.querySelector(`[data-task-state="${task.id}"]`);
      if (label) label.textContent = stageText(taskState);
      const card = root.querySelector(`[data-writing-task-card="${task.id}"]`);
      if (card instanceof HTMLElement) card.dataset.complete = finalStates.has(taskState) ? 'true' : 'false';
    });

    const qualified = completed === tasks.length && tasks.length === 2;
    const shield = root.querySelector('[data-true-exam-shield]');
    const examEntry = root.querySelector('[data-true-exam-entry]');
    const examTitle = root.querySelector('[data-true-exam-title]');
    const examCopy = root.querySelector('[data-true-exam-copy]');
    if (shield instanceof HTMLElement) shield.dataset.syntheticComplete = qualified ? 'true' : 'false';
    if (examEntry instanceof HTMLElement) examEntry.hidden = !qualified;
    if (qualified) {
      if (examTitle) examTitle.textContent = '第一篇 clean 真题已解锁';
      if (examCopy) examCopy.textContent = '只释放这一篇 official task；进入前仍不展示范文、解析、主题总结或针对该题的写作思路。第一次真题的 first draft 会成为比 synthetic 更强的迁移证据。';
    }
  }
</script>

<style>
  .writingHome{max-width:78rem;margin:0 auto;display:grid;gap:12px}.writingHomeHero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px;align-items:end;padding:24px 26px;border:1px solid var(--study-line);border-radius:16px;background:#fff;box-shadow:var(--study-shadow)}.writingHomeHero>div>span,.writingLearnLink span,.writingTaskCard>span,.writingTrueExamShield span{font-size:9px;font-weight:850;letter-spacing:.08em;text-transform:uppercase;color:var(--study-green)}.writingHomeHero h2{margin:5px 0 8px;font-size:27px}.writingHomeHero p{max-width:76ch;margin:0;color:var(--study-muted);font-size:13px;line-height:1.7}.writingHomeHero aside{display:grid;gap:3px;padding-left:20px;border-left:1px solid var(--study-line)}.writingHomeHero aside strong{color:var(--study-green)}.writingHomeHero aside span{font-size:10px;color:var(--study-faint)}
  .writingLearnLink{display:grid;grid-template-columns:minmax(220px,.8fr) minmax(0,1.3fr) auto;gap:18px;align-items:center;padding:14px 18px;border:1px solid #cfe2d8;border-radius:13px;background:var(--study-green-soft);color:inherit;text-decoration:none}.writingLearnLink>div{display:grid;gap:3px}.writingLearnLink strong{font-size:14px}.writingLearnLink p{margin:0;color:var(--study-muted);font-size:11px;line-height:1.55}.writingLearnLink b{font-size:11px;color:var(--study-green)}
  .writingTaskGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.writingTaskCard{display:grid;gap:7px;padding:20px;border:1px solid var(--study-line);border-radius:14px;background:#fff;color:inherit;text-decoration:none;box-shadow:var(--study-shadow)}.writingTaskCard[data-complete="true"]{border-color:#b8d7c8;background:#fbfdfc}.writingTaskCard strong{font-size:18px}.writingTaskCard p{margin:0;color:var(--study-muted);font-size:11px;line-height:1.6}.writingTaskCard>div{display:flex;justify-content:space-between;gap:10px;padding-top:8px;border-top:1px solid var(--study-line)}.writingTaskCard small{font-size:9px;color:var(--study-faint)}.writingTaskCard b{font-size:9px;color:var(--study-green)}
  .writingTrueExamShield,.writingRuntimeBoundary,.writingHomeGate{padding:18px 20px;border:1px solid var(--study-line);border-radius:14px;background:#fff}.writingTrueExamShield{background:#fffdf8}.writingTrueExamShield[data-synthetic-complete="true"]{background:#fbfdfc;border-color:#cfe2d8}.writingTrueExamShield>div{display:grid;gap:3px}.writingTrueExamShield strong,.writingRuntimeBoundary strong,.writingHomeGate strong{font-size:12px}.writingTrueExamShield p,.writingRuntimeBoundary p,.writingHomeGate p{margin:7px 0 0;color:var(--study-muted);font-size:10px;line-height:1.6}.writingTrueExamEntry{display:inline-flex;margin-top:12px;padding:9px 12px;border-radius:9px;background:var(--study-green);color:#fff;text-decoration:none;font-size:10px;font-weight:850}.writingTrueExamEntry[hidden]{display:none}
  @media(max-width:820px){.writingHomeHero,.writingLearnLink,.writingTaskGrid{grid-template-columns:1fr}.writingHomeHero aside{padding:12px 0 0;border-left:0;border-top:1px solid var(--study-line)}}
</style>
