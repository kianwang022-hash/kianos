---
import SkillsBase from '../../../layouts/SkillsBase.astro';
import { listSkills, loadSkill, skillAssetHref } from '../../../lib/skills.mjs';

export function getStaticPaths() {
  return listSkills().map((skill) => ({ params: { skill: skill.id } }));
}

const base = import.meta.env.BASE_URL;
const skillId = Astro.params.skill;
const skill = loadSkill(skillId);
const assetMap = Object.fromEntries(skill.assets.map((asset) => [asset.id, asset]));
const guide = skill.assets.find((asset) => asset.stage === 'orientation' || asset.kind === 'guide');
const referenceAssets = skill.assets.filter((asset) => asset.stage === 'reference');
const unitRows = (skill.units || []).map((unit, index) => {
  const learn = assetMap[unit.assets?.learn];
  return { unit, index, learn };
}).filter((row) => row.learn);
const defaultAsset = guide || unitRows[0]?.learn || skill.assets[0];

const stateLabel = skill.portfolioState === 'CORE'
  ? '核心能力'
  : skill.portfolioState === 'CORE_SUPPORT'
    ? '长期支撑'
    : skill.portfolioState === 'CORE_OPTION'
      ? '可选方向'
      : '能力';

const configJson = JSON.stringify({
  skill_id: skill.id,
  default_asset: defaultAsset?.id || '',
  assets: skill.assets.map((asset) => ({
    id: asset.id,
    title: asset.title,
    label: asset.label,
    unit_id: asset.unit_id,
    href: skillAssetHref(base, skill.id, asset.id)
  }))
}).replace(/</g, '\u003c');
---
<SkillsBase title={skill.title} kicker={skill.manifest.kicker || 'Skill'} description={skill.manifest.description || skill.subtitle}>
  <nav class="skillBreadcrumb skillBreadcrumbTop" aria-label="Skill navigation">
    <a href={base + 'skills/'}>Skills</a>
    <span>›</span>
    <strong>{skill.title}</strong>
  </nav>

  <header class="skillHomeHero">
    <div class="skillHomeHeroCopy">
      <p class="skillEyebrow">{stateLabel} · {unitRows.length} 个单元</p>
      <h1>{skill.title}</h1>
      <p>{skill.manifest.demand}</p>
    </div>

    {defaultAsset && (
      <aside class="skillHomeResume" data-skill-resume>
        <span data-resume-kicker>推荐入口</span>
        <strong data-resume-title>{defaultAsset.title}</strong>
        <p data-resume-label>{defaultAsset.label}</p>
        <a
          class="skillPrimaryAction"
          href={skillAssetHref(base, skill.id, defaultAsset.id)}
          data-skill-continue={skill.id}
        >开始阅读 <span aria-hidden="true">→</span></a>
      </aside>
    )}
  </header>

  <section class="skillCognitionRoute">
    <header class="skillSectionHead">
      <div>
        <span>Learning Map</span>
        <h2>从整张地图到 {unitRows.length} 个能力单元</h2>
      </div>
      <p>先看总览，再按真实需求进入 Unit；网站只保存阅读位置，不把阅读完成冒充能力掌握。</p>
    </header>

    <div class="skillUnitStack">
      {guide && (
        <article class="skillUnitCard skillUnitCardGuide" data-guide-card>
          <div class="skillUnitIdentity">
            <span>00</span>
            <div><strong>总览</strong><small>先建立整张地图</small></div>
            <em data-unit-progress-label hidden>上次停在这里</em>
          </div>
          <div class="skillStageTrack">
            <a href={skillAssetHref(base, skill.id, guide.id)}>
              <span>阅读</span><small>{guide.label}</small>
            </a>
          </div>
        </article>
      )}

      {unitRows.map(({unit,index,learn}) => (
        <article class="skillUnitCard" data-unit-id={unit.id}>
          <div class="skillUnitIdentity">
            <span>U{index + 1}</span>
            <div>
              <strong>{unit.title.replace(/^U\d+\s*·\s*/, '')}</strong>
              <small>{unit.capability.replace(/^C\d+\s*/, '')}</small>
            </div>
            <em data-unit-progress-label hidden>上次停在这里</em>
          </div>
          <div class="skillStageTrack">
            <a href={skillAssetHref(base, skill.id, learn.id)}>
              <span>学习</span><small>{learn.label}</small>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  {referenceAssets.length > 0 && (
    <section class="skillCrossCut">
      <header><span>Reference</span><h2>需要时再看</h2></header>
      <div>
        {referenceAssets.map((asset) => (
          <a href={skillAssetHref(base, skill.id, asset.id)}>
            <strong>{asset.title}</strong>
            <p>{asset.label}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <aside class="skillDiscussionNote">
    <span>Chat 是深入学习入口</span>
    <p>看到不懂、想联系现实、需要验证或想继续升级时，直接回 Chat；网站本身不要求你完成任何互动流程。</p>
  </aside>

  <script type="application/json" id="skill-reading-config" set:html={configJson}></script>
</SkillsBase>

<script>
  import { learnerWriterReady } from '../../../lib/browserLearnerWriter.mjs';
  import { skillProgressFor } from '../../../lib/skillRuntimeClient.mjs';

  void learnerWriterReady.then(() => {
    const raw = document.getElementById('skill-reading-config')?.textContent || '{}';
    const config = JSON.parse(raw);
    const progress = skillProgressFor(config.skill_id || '');
    const assets = config.assets || [];
    const defaultAsset = assets.find((asset) => asset.id === config.default_asset);
    const lastAsset = assets.find((asset) => asset.id === progress.last_asset);
    const target = lastAsset || defaultAsset;

    const link = document.querySelector('[data-skill-continue]');
    if (link instanceof HTMLAnchorElement && target?.href) {
      link.href = target.href;
      if (lastAsset) link.firstChild && (link.firstChild.textContent = '继续上次位置 ');
    }

    const kicker = document.querySelector('[data-resume-kicker]');
    const title = document.querySelector('[data-resume-title]');
    const label = document.querySelector('[data-resume-label]');
    if (lastAsset) {
      if (kicker instanceof HTMLElement) kicker.textContent = '最近阅读';
      if (title instanceof HTMLElement) title.textContent = lastAsset.title || '上次阅读位置';
      if (label instanceof HTMLElement) label.textContent = lastAsset.label || '从上次停下的位置继续';
    }

    if (lastAsset?.unit_id) {
      const unitCard = document.querySelector('[data-unit-id="' + CSS.escape(lastAsset.unit_id) + '"]');
      if (unitCard instanceof HTMLElement) {
        unitCard.dataset.current = 'true';
        const progressLabel = unitCard.querySelector('[data-unit-progress-label]');
        if (progressLabel instanceof HTMLElement) progressLabel.hidden = false;
      }
    } else if (lastAsset && lastAsset.id === config.default_asset) {
      const guideCard = document.querySelector('[data-guide-card]');
      if (guideCard instanceof HTMLElement) {
        guideCard.dataset.current = 'true';
        const progressLabel = guideCard.querySelector('[data-unit-progress-label]');
        if (progressLabel instanceof HTMLElement) progressLabel.hidden = false;
      }
    }
  });
</script>
