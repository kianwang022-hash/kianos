---
import Base from '../layouts/LexicalBase.astro';
import VocabularyWordRuntime from '../components/VocabularyWordRuntime.astro';
import VocabularyChallengeRuntime from '../components/VocabularyChallengeRuntime.astro';
import { loadLexicalWordByOrdinal } from '../lib/lexical.mjs';

const validationOrdinals = [40, 70, 761, 1655, 1920, 2652, 2931, 3752, 4763, 4941];
const batch = validationOrdinals.map((ordinal) => loadLexicalWordByOrdinal(ordinal));
const batchHash = batch.map((item) => item.sourceHash.slice(0, 8)).join('-');
---
<Base title="Lexical Validation 02" kicker="LexicalOS · Familiar Depth Batch 02" sourcePath="content/lexical/continuation.json" sourceHash={batchHash} objectId="lexical:validation:batch-02" active="lexical">
  <section class="lexicalValidationIntro">
    <span>Depth Validation · Batch 02</span>
    <h1>高频熟词深扫</h1>
    <p>这一批专门检查“看着会、实际可能漏深义或结构”的熟词。Recall Map 只算 active learner senses + 真正独立的 hidden branch；后台重复包装不会再制造假的 +1。</p>
    <nav>
      {batch.map((item) => <a href={`#lexical-${item.ordinal}`}>{item.record.word}</a>)}
    </nav>
  </section>

  {batch.map((answer) => (
    <section id={`lexical-${answer.ordinal}`} class="lexicalValidationCard">
      <VocabularyWordRuntime answer={answer} />
    </section>
  ))}

  <VocabularyChallengeRuntime />
</Base>

<style>
  .lexicalValidationIntro { max-width: 72rem; margin: 0 auto 1.5rem; padding: 1.2rem; }
  .lexicalValidationIntro h1 { margin: .25rem 0 .6rem; }
  .lexicalValidationIntro p { max-width: 58rem; line-height: 1.6; }
  .lexicalValidationIntro nav { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: .9rem; }
  .lexicalValidationIntro nav a { padding: .35rem .6rem; border: 1px solid currentColor; border-radius: 999px; text-decoration: none; }
  .lexicalValidationCard { max-width: 72rem; margin: 0 auto 1.4rem; scroll-margin-top: 1rem; }
</style>
