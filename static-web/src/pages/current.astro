---
import Base from '../layouts/Base.astro';
import { buildMissionControlSnapshot } from '../lib/missionControl.mjs';
import { GATES, REFRESH_WINDOWS, examDay, dayDistance } from '../lib/examOrchestrator.mjs';

const snapshot = buildMissionControlSnapshot();
const today = examDay();
const upcomingGates = GATES.filter(gate => gate.date >= today).slice(0, 4);
const upcomingRefresh = REFRESH_WINDOWS.filter(window => window.end >= today).slice(0, 4);
const compact = value => String(value || '').replace(/\s+/g, ' ').trim();
const friendlyBlocker = value => !value || value.toLowerCase() === 'none' ? '无' : value;
---
<Base
  title="任务与进度"
  kicker="KianOS · Mission Control"
  description="这里不另存一份进度，只把各科 Current、总调度和持续更新整理成你能直接看的状态。"
  active="home"
>
  <section class="missionProject">
    <div>
      <span>当前项目任务</span>
      <h2>{compact(snapshot.project.active)}</h2>
      <p>{compact(snapshot.project.next)}</p>
    </div>
    <dl>
      <div><dt>阶段</dt><dd>{compact(snapshot.project.stage) || '按 Current 继续'}</dd></div>
      <div><dt>卡点</dt><dd>{friendlyBlocker(snapshot.project.blocker)}</dd></div>
    </dl>
  </section>

  <section class="missionSection">
    <header><div><span>SUBJECTS</span><h2>各科现在到哪</h2></div><p>工程状态和真实学习进度分开看。</p></header>
    <div class="missionLanes">
      {snapshot.lanes.map(lane => (
        <article class="missionLane">
          <div class="missionLaneName"><strong>{lane.label}</strong><span>{friendlyBlocker(lane.blocker) === '无' ? '可继续' : '有卡点'}</span></div>
          <div><small>现在</small><p>{compact(lane.active)}</p></div>
          <div><small>工程</small><p>{compact(lane.engineering) || '按局部 Current 推进'}</p></div>
          <div><small>学习</small><p>{compact(lane.learner) || '只认真实 learner evidence'}</p></div>
          <div class="missionLaneNext"><small>下一步</small><p>{compact(lane.next) || '按该科 Current 继续'}</p></div>
        </article>
      ))}
    </div>
  </section>

  <section class="missionTwoCol">
    <section class="missionSection missionCompact">
      <header><div><span>GATES</span><h2>接下来几个关键节点</h2></div></header>
      <div class="missionRows">
        {upcomingGates.map(gate => (
          <div class="missionRow">
            <time>{gate.date.slice(5).replace('-', '/')}</time>
            <strong>{gate.label}</strong>
            <span>{dayDistance(today, gate.date) === 0 ? '今天' : `${dayDistance(today, gate.date)} 天后`}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="missionSection missionCompact">
      <header><div><span>UPDATES</span><h2>需要持续留意的资料</h2></div></header>
      <div class="missionRows">
        {upcomingRefresh.map(window => (
          <div class="missionUpdate">
            <time>{window.start.slice(5).replace('-', '/')}–{window.end.slice(5).replace('-', '/')}</time>
            <p>{window.label}</p>
          </div>
        ))}
      </div>
    </section>
  </section>

  <p class="missionBoundary">这里显示的是项目与学习入口状态，不会把“网页做完了”当成“你已经学会了”。</p>
</Base>

<style>
  .missionProject{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,.42fr);gap:36px;padding:26px 0 24px;border-top:1px solid var(--study-line);border-bottom:1px solid var(--study-line)}
  .missionProject span,.missionSection header span{font-size:10px;font-weight:850;letter-spacing:.09em;color:var(--study-green)}
  .missionProject h2{margin:6px 0 8px;font-size:28px;line-height:1.15}.missionProject p{margin:0;max-width:78ch;color:var(--study-muted);font-size:14px;line-height:1.65}
  .missionProject dl{display:grid;gap:9px;margin:0}.missionProject dl>div{display:grid;grid-template-columns:54px 1fr;gap:12px;padding:8px 0;border-bottom:1px solid var(--study-line)}.missionProject dt{font-size:11px;color:var(--study-faint)}.missionProject dd{margin:0;font-size:12px;line-height:1.5}
  .missionSection{margin-top:28px}.missionSection>header{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:10px}.missionSection h2{margin:4px 0 0;font-size:21px}.missionSection header p{margin:0;color:var(--study-faint);font-size:11px}
  .missionLanes{border-top:1px solid var(--study-line)}.missionLane{display:grid;grid-template-columns:110px minmax(150px,.8fr) minmax(190px,1fr) minmax(170px,.9fr) minmax(240px,1.3fr);gap:18px;align-items:start;padding:17px 4px;border-bottom:1px solid var(--study-line)}.missionLaneName{display:grid;gap:5px}.missionLaneName strong{font-size:17px}.missionLaneName span{width:max-content;padding:2px 7px;border-radius:999px;background:var(--study-green-soft);font-size:9px;font-weight:800;color:var(--study-green)}.missionLane small{display:block;margin-bottom:5px;font-size:9px;font-weight:800;letter-spacing:.07em;color:var(--study-faint)}.missionLane p{margin:0;font-size:12px;line-height:1.55}.missionLaneNext p{font-weight:650}
  .missionTwoCol{display:grid;grid-template-columns:1fr 1fr;gap:34px;margin-top:12px}.missionCompact{min-width:0}.missionRows{border-top:1px solid var(--study-line)}.missionRow{display:grid;grid-template-columns:70px 1fr auto;gap:14px;align-items:center;padding:11px 0;border-bottom:1px solid var(--study-line)}.missionRow time,.missionUpdate time{font-size:11px;color:var(--study-faint)}.missionRow strong{font-size:12px}.missionRow span{font-size:10px;color:var(--study-muted)}.missionUpdate{display:grid;grid-template-columns:110px 1fr;gap:14px;padding:11px 0;border-bottom:1px solid var(--study-line)}.missionUpdate p{margin:0;font-size:12px;line-height:1.55}
  .missionBoundary{margin:26px 0 0;padding-top:14px;border-top:1px solid var(--study-line);color:var(--study-faint);font-size:11px}
  @media(max-width:1050px){.missionLane{grid-template-columns:90px 1fr 1fr}.missionLaneNext{grid-column:2 / -1}.missionTwoCol{grid-template-columns:1fr}}
  @media(max-width:720px){.missionProject{grid-template-columns:1fr}.missionLane{grid-template-columns:1fr}.missionLaneNext{grid-column:auto}.missionSection>header{align-items:start;flex-direction:column}.missionTwoCol{gap:8px}}
</style>
