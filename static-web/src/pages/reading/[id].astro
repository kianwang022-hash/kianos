---
import Base from '../../layouts/Base.astro';
import '../../styles/reading.css';
import '../../styles/reading-interaction.css';
import '../../styles/reading-repair.css';
import '../../styles/reading-navigation.css';
import '../../styles/english-reading-vertical.css';
import ReadingWorkspace from '../../components/ReadingWorkspace.astro';
import ReadingAnswerGate from '../../components/ReadingAnswerGate.astro';
import ReadingPassageNavigator from '../../components/ReadingPassageNavigator.astro';
import ReadingDeferredReviewShield from '../../components/ReadingDeferredReviewShield.astro';
import ObjectiveTransferClaims from '../../components/ObjectiveTransferClaims.astro';
import ReadingPassageHandoff from '../../components/ReadingPassageHandoff.astro';
import ReadingSessionHandoff from '../../components/ReadingSessionHandoff.astro';
import ReadingLastLocation from '../../components/ReadingLastLocation.astro';
import { listReadingSets, loadReadingById } from '../../lib/englishReadingSourceTruth.mjs';

export function getStaticPaths() {
  return listReadingSets().map((item) => ({
    params: { id: item.id },
    props: { readingId: item.id }
  }));
}

const { readingId } = Astro.props;
const reading = loadReadingById(readingId);
---
<Base
  title={reading.title}
  kicker="English · Current"
  description=""
  sourcePath={reading.sourcePaths.sourceTruth || reading.sourcePaths.passage}
  sourceHash={reading.sourceHashes.renderedObject}
  objectId={reading.objectId}
  active="reading"
>
  <ReadingLastLocation reading={reading} />
  <ReadingWorkspace reading={reading} />
  <ReadingAnswerGate />
  <ReadingPassageNavigator reading={reading} />
  <ReadingDeferredReviewShield />
  <ReadingPassageHandoff />
  <ObjectiveTransferClaims task="reading_a" />
  <ReadingSessionHandoff />
</Base>