---
import VocabularyWordMarkup from '../../components/VocabularyWordMarkup.astro';
import { lexicalRuntimeManifest, loadLexicalWordByOrdinal } from '../../lib/lexical.mjs';

export function getStaticPaths() {
  return lexicalRuntimeManifest().shards.map((shard) => ({
    params: { key: shard.key },
    props: { start: shard.start, end: shard.end }
  }));
}

const { start, end } = Astro.props;
const answers = [];
for (let ordinal = Number(start); ordinal <= Number(end); ordinal += 1) {
  answers.push(loadLexicalWordByOrdinal(ordinal));
}
---
<div data-lexical-runtime-fragment data-start={start} data-end={end}>
  {answers.map((answer) => <VocabularyWordMarkup answer={answer} />)}
</div>
