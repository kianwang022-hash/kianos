---
import '../styles/global.css';
import '../styles/shared-visual-foundation.css';
import '../styles/runtime.css';
import '../styles/english.css';
import '../styles/visual-convergence.css';
import '../styles/shared-workspace-composition.css';
import '../styles/lexical-presentation.css';
import '../styles/english-presentation.css';
import '../styles/shared-shell.css';
import '../styles/study-timer.css';
import VocabularyEnglishEvidenceBridge from '../components/VocabularyEnglishEvidenceBridge.astro';
import EnglishProductiveConvergence from '../components/EnglishProductiveConvergence.astro';
import EnglishLexicalLookupBridge from '../components/EnglishLexicalLookupBridge.astro';
import StudyTimerDock from '../components/StudyTimerDock.astro';
import {
  globalNavigation,
  isEnglishFamily,
  isEnglishRuntime,
  localRoute,
  resolveGlobalActive,
  subjectShell
} from '../lib/sharedNavigation.mjs';

const {
  title,
  kicker = 'KianOS · Current',
  description = '',
  sourcePath,
  sourceHash,
  objectId,
  active = 'home',
  showLead = true
} = Astro.props;

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const localPath = localRoute(pathname, base);
const englishFamily = isEnglishFamily(localPath);
const englishRuntime = isEnglishRuntime(localPath);
const navActive = resolveGlobalActive(localPath, active);
const navItems = globalNavigation(base);
const subjectNav = subjectShell(localPath, base);
const isHub = ['', 'english', 'vocabulary', 'politics', 'xizong'].includes(localPath);
const isWordStudy = /^vocabulary\/\d+$/.test(localPath);
const isVocabularyRoute = localPath === 'vocabulary' || localPath.startsWith('vocabulary/');
const stageOne = englishFamily || ['lexical', 'politics', 'xizong'].includes(active) || localPath === '';
const currentStatusUrl = `${base}__kianos-current.json`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="KianOS learning workspace" />
    <title>{title} · KianOS</title>
    <style is:global>
      [hidden] { display: none !important; }
      body.surfaceBody-xizong .sourceDock,
      body.surfaceBody-xizong .portedSourceFoot { display: none !important; }
      body.uiEnglishFamily .kianosCurrentDock { display: none !important; }
    </style>
  </head>
  <body id="kianos-workspace" data-current-status-url={currentStatusUrl} data-kianos-rail="expanded" class={`surfaceBody-${active}${stageOne ? ' uiStageOne' : ''}${isHub ? ' uiHub' : ''}${isWordStudy ? ' uiWordStudy' : ''}${englishRuntime ? ' uiEnglish' : ''}${englishFamily ? ' uiEnglishFamily' : ''}`}>
    <div class="kianosShellFrame" data-kianos-shell-frame>
      <aside class="kianosGlobalRail" data-kianos-global-rail aria-label="KianOS 全局导航">
        <button type="button" class="kianosRailToggle" data-kianos-rail-toggle aria-expanded="true" aria-label="展开或收起全局导航">
          <span class="kianosRailMark">K</span>
          <span class="kianosRailBrandCopy"><strong>KianOS</strong><span>Personal workspace</span></span>
        </button>
        <nav class="kianosRailNav" aria-label="一级学习模块">
          {navItems.map((item) => (
            <a class={`kianosRailItem ${navActive === item.key ? 'active' : ''}`} href={item.href} aria-current={navActive === item.key ? 'page' : undefined} title={item.label}>
              <svg class="kianosRailIcon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon} /></svg>
              <span class="kianosRailLabel">{item.label}</span>
            </a>
          ))}
        </nav>
      </aside>

      <div class="kianosShellMain">
        {subjectNav && (
          <header class="kianosSubjectBar" data-kianos-subject-bar={subjectNav.key}>
            <div class="kianosSubjectIdentity">{subjectNav.label}</div>
            <nav class="kianosSubjectNav" aria-label={`${subjectNav.label} 内部导航`}>
              {subjectNav.items.map((item) => <a class={subjectNav.active === item.key ? 'active' : ''} href={item.href} aria-current={subjectNav.active === item.key ? 'page' : undefined}>{item.label}</a>)}
            </nav>
          </header>
        )}

        <main class={`productCanvas surface-${active}${englishRuntime ? ' englishCanvas' : ''}`}>
          {showLead && (
            <section class="pageLead">
              <p class="pageKicker">{kicker}</p>
              <div><h1>{title}</h1>{description && <p class="pageDescription">{description}</p>}</div>
            </section>
          )}
          <slot />
          {englishRuntime && <EnglishProductiveConvergence />}
          {englishRuntime && <VocabularyEnglishEvidenceBridge />}
          {(englishRuntime || isVocabularyRoute) && <EnglishLexicalLookupBridge />}
        </main>
      </div>
    </div>
    <StudyTimerDock />
  </body>
</html>
<script>
  (() => {
    const body = document.body;
    const toggle = document.querySelector('[data-kianos-rail-toggle]');
    if (!(toggle instanceof HTMLButtonElement)) return;
    const key = 'kianos-global-rail-expanded-v1';
    const apply = (expanded) => {
      body.dataset.kianosRail = expanded ? 'expanded' : 'compact';
      toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      toggle.title = expanded ? '收起全局导航' : '展开全局导航';
    };
    let expanded = !window.matchMedia('(max-width: 1180px)').matches;
    try {
      const saved = localStorage.getItem(key);
      if (saved === '1' || saved === '0') expanded = saved === '1';
    } catch {}
    apply(expanded);
    toggle.addEventListener('click', () => {
      expanded = body.dataset.kianosRail !== 'expanded';
      apply(expanded);
      try { localStorage.setItem(key, expanded ? '1' : '0'); } catch {}
    });
  })();

  import { createCurrentRefreshPolicy } from '../lib/currentRefreshPolicy.mjs';

  (() => {
    if (!['127.0.0.1', 'localhost'].includes(window.location.hostname)) return;
    const url = document.body?.dataset.currentStatusUrl;
    if (!url) return;

    const refreshPolicy = createCurrentRefreshPolicy();
    let reloading = false;

    const reloadIfPending = () => {
      if (reloading) return;
      const decision = refreshPolicy.onForegroundReturn();
      if (!decision.reload) return;
      reloading = true;
      window.location.reload();
    };

    const pollCurrent = async () => {
      if (reloading) return;
      try {
        const response = await fetch(`${url}?t=${Date.now()}`, { cache: 'no-store' });
        if (!response.ok) return;
        const status = await response.json();
        if (status?.state !== 'synced' || typeof status?.sha !== 'string' || !status.sha) return;
        refreshPolicy.observe(status.sha);
      } catch {}
    };

    void pollCurrent();
    window.setInterval(() => void pollCurrent(), 3000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState !== 'visible') return;
      reloadIfPending();
      if (!reloading) void pollCurrent();
    });
  })();
</script>
<script>
  import { initStudyTimerRuntime } from '../lib/studyTimerClient.mjs';
  import { initStudyTimerDock } from '../lib/studyTimerDockClient.mjs';
  import {
    initPrivateCheckpointAutosave,
    restoreSharedControlFromPrivate
  } from '../lib/privateCheckpointRuntime.mjs';

  void (async () => {
    let restored = null;
    try {
      restored = await restoreSharedControlFromPrivate(localStorage);
    } catch {}

    if (restored?.status === 'restored') {
      window.location.reload();
      return;
    }

    const timer = initStudyTimerRuntime();
    const dock = document.querySelector('[data-study-timer-dock]');
    if (dock instanceof HTMLElement) initStudyTimerDock(dock, timer);
    initPrivateCheckpointAutosave(localStorage);
  })();
</script>
