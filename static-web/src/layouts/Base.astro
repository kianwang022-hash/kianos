---
import '../styles/global.css';
import '../styles/runtime.css';

const {
  title,
  kicker = 'KianOS · Current',
  description = '',
  sourcePath,
  sourceHash,
  objectId,
  active = 'home'
} = Astro.props;

const base = import.meta.env.BASE_URL;
const navItems = [
  { key: 'xizong', label: '西综', href: `${base}b1/` },
  { key: 'lexical', label: 'Vocabulary', href: `${base}answer/` },
  { key: 'reading', label: 'Reading', href: `${base}reading/` }
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="KianOS Current learner runtime" />
    <title>{title} · KianOS</title>
  </head>
  <body>
    <header class="productBar">
      <a class="productBrand" href={base} aria-label="KianOS Home">
        <span class="productBrandMark">K</span>
        <span class="productBrandCopy"><strong>KianOS</strong><small>Learning Runtime</small></span>
      </a>
      <nav class="productNav" aria-label="学习模块">
        {navItems.map((item) => <a class={`productNavItem ${active === item.key ? 'active' : ''}`} href={item.href}>{item.label}</a>)}
      </nav>
      <details class="sourceDock">
        <summary><span class="sourcePulse"></span>Current</summary>
        <div class="sourcePopover">
          <span>Canonical projection</span>
          {objectId && <strong>{objectId}</strong>}
          {sourcePath && <code>{sourcePath}</code>}
          {sourceHash && <code title={sourceHash}>sha256:{String(sourceHash).slice(0, 16)}</code>}
          <small>canonical read-only · learner state browser-local</small>
        </div>
      </details>
    </header>
    <main class={`productCanvas surface-${active}`}>
      <section class="pageLead">
        <p class="pageKicker">{kicker}</p>
        <div><h1>{title}</h1>{description && <p class="pageDescription">{description}</p>}</div>
      </section>
      <slot />
    </main>
  </body>
</html>
