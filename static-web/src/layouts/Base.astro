---
import '../styles/global.css';
import '../styles/runtime.css';
import '../styles/xizong-dense-calm.css';
import '../styles/english.css';
import '../styles/visual-convergence.css';
import '../styles/politics-presentation.css';
import '../styles/xizong-presentation.css';
import '../styles/stage-one-composition.css';
import '../styles/viewport-workspaces.css';
import '../styles/lexical-presentation.css';
import '../styles/site-visual-tuning.css';
import '../styles/english-cloze-polish.css';
import '../styles/english-objective-convergence.css';
import '../styles/english-productive-convergence.css';
import '../styles/english-family-coherence.css';
import '../styles/english-workbench-polish.css';
import '../styles/english-workbench-qa-fixes.css';
import VocabularyEnglishEvidenceBridge from '../components/VocabularyEnglishEvidenceBridge.astro';
import EnglishProductiveConvergence from '../components/EnglishProductiveConvergence.astro';
import EnglishLexicalLookupBridge from '../components/EnglishLexicalLookupBridge.astro';

const {
  title,
  kicker = 'KianOS · Current',
  description = '',
  sourcePath,
  sourceHash,
  objectId,
  active = 'home',
  showLead = true
} = Astro.props;

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
// English is one learner-facing capability lane. Task-specific routes keep
// their own workspaces but inherit the shared English navigation/context shell.
const englishPrefixes = [
  'english',
  'reading',
  'reading-answer',
  'reading-review',
  'reading-b',
  'reading-b-answer',
  'cloze',
  'cloze-answer',
  'objective-learn',
  'translation',
  'translation-learn',
  'translation-reference',
  'writing',
  'writing-learn'
];
const isEnglishRoute = englishPrefixes.some((segment) => {
  const route = `${base}${segment}`.replace(/\/+/g, '/');
  return pathname === route || pathname === `${route}/` || pathname.startsWith(`${route}/`);
});
const navActive = isEnglishRoute ? 'english' : active;
const localPath = pathname.slice(base.length).replace(/^\/+|\/+$/g, '');
const isHub = ['', 'english', 'vocabulary', 'politics', 'xizong'].includes(localPath);
const isWordStudy = /^vocabulary\/\d+$/.test(localPath);
const isVocabularyRoute = localPath === 'vocabulary' || localPath.startsWith('vocabulary/');
const stageOne = isEnglishRoute || ['lexical', 'politics', 'xizong'].includes(active) || localPath === '';
const currentStatusUrl = `${base}__kianos-current.json`;
const navIcons = {
  home: 'M3 10 12 3l9 7M5 9v11h5v-6h4v6h5V9',
  xizong: 'M12 3v18M3 12h18M6 6l12 12M6 18 18 6',
  politics: 'M4 20h16M6 17V8m6 9V8m6 9V8M3 6l9-3 9 3H3Z',
  lexical: 'M5 4h13a2 2 0 0 1 2 2v15H7a3 3 0 0 1-3-3V5a1 1 0 0 1 1-1ZM4 17h16M8 8h8M8 11h6',
  english: 'M4 5h7a4 4 0 0 1 4 4v11a4 4 0 0 0-4-3H4V5Zm11 4a4 4 0 0 1 4-4h2v12h-2a4 4 0 0 0-4 3'
};
const navItems = [
  { key: 'home', label: 'Home', href: base },
  { key: 'xizong', label: '西综', href: `${base}xizong/` },
  { key: 'politics', label: '政治', href: `${base}politics/` },
  { key: 'lexical', label: 'Vocabulary', href: `${base}vocabulary/` },
  { key: 'english', label: 'English', href: `${base}english/` }
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="KianOS Current learner runtime" />
    <title>{title} · KianOS</title>
    <style is:global>
      [hidden] { display: none !important; }
      /* Xizong learning surfaces stay learner-facing. Provenance remains in
         canonical owners/validators instead of occupying the study chrome. */
      body.surfaceBody-xizong .sourceDock,
      body.surfaceBody-xizong .portedSourceFoot { display: none !important; }
    </style>
  </head>
  <body id="kianos-workspace" data-current-status-url={currentStatusUrl} class={`surfaceBody-${active}${stageOne ? ' uiStageOne' : ''}${isHub ? ' uiHub' : ''}${isWordStudy ? ' uiWordStudy' : ''}${isEnglishRoute ? ' uiEnglish' : ''}`}>
    <header class="productBar">
      <a class="productBrand" href={base} aria-label="KianOS Home">
        <span class="productBrandMark">K</span>
        <span class="productBrandCopy"><strong>KianOS</strong><small>Personal workspace</small></span>
      </a>
      <nav class="productNav" aria-label="学习模块">
        {navItems.map((item) => <a class={`productNavItem ${navActive === item.key ? 'active' : ''}`} href={item.href} aria-current={navActive === item.key ? 'page' : undefined}><svg class="productNavIcon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={navIcons[item.key]} /></svg><span>{item.label}</span></a>)}
      </nav>
      <details class="sourceDock">
        <summary><span class="sourcePulse"></span>Current</summary>
        <div class="sourcePopover">
          <span>Canonical projection</span>
          {objectId && <strong>{objectId}</strong>}
          {sourcePath && <code>{sourcePath}</code>}
          {sourceHash && <code title={sourceHash}>sha256:{String(sourceHash).slice(0, 16)}</code>}
          <small>canonical read-only · learner state browser-local</small>
          <a href={`${base}current/`} style="margin-top:.35rem;color:inherit;font-weight:800;text-decoration:none;">System Current →</a>
        </div>
      </details>
    </header>
    <main class={`productCanvas surface-${active}${isEnglishRoute ? ' englishCanvas' : ''}`}>
      {showLead && (
        <section class="pageLead">
          <p class="pageKicker">{kicker}</p>
          <div><h1>{title}</h1>{description && <p class="pageDescription">{description}</p>}</div>
        </section>
      )}
      <slot />
      {isEnglishRoute && <EnglishProductiveConvergence />}
      {isEnglishRoute && <VocabularyEnglishEvidenceBridge />}
      {(isEnglishRoute || isVocabularyRoute) && <EnglishLexicalLookupBridge />}
    </main>
  </body>
</html>
<script>
  /*
   * The dedicated Mac Current mirror writes a tiny localhost-only status file.
   * Polling it makes an already-open learner page follow a newly synced main SHA
   * even when the changed canonical asset lives outside Astro/Vite's watch graph.
   * Normal branch previews/deployments simply receive a 404 and do nothing.
   */
  (() => {
    if (!['127.0.0.1', 'localhost'].includes(window.location.hostname)) return;
    const url = document.body?.dataset.currentStatusUrl;
    if (!url) return;

    let baselineSha = null;
    let reloading = false;

    const pollCurrent = async () => {
      if (reloading) return;
      try {
        const response = await fetch(`${url}?t=${Date.now()}`, { cache: 'no-store' });
        if (!response.ok) return;
        const status = await response.json();
        if (status?.state !== 'synced' || typeof status?.sha !== 'string' || !status.sha) return;
        if (baselineSha === null) {
          baselineSha = status.sha;
          return;
        }
        if (status.sha !== baselineSha) {
          reloading = true;
          window.location.reload();
        }
      } catch {
        // A short restart/network gap should leave the last usable page intact.
      }
    };

    void pollCurrent();
    window.setInterval(() => void pollCurrent(), 3000);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') void pollCurrent();
    });
  })();
</script>