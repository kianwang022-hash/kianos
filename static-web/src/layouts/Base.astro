---
import '../styles/global.css';
import EnglishLexicalBridge from '../components/EnglishLexicalBridge.astro';
import ObjectiveResumeTracker from '../components/ObjectiveResumeTracker.astro';
import EnglishGuideBridge from '../components/EnglishGuideBridge.astro';
import '../styles/runtime.css';
import '../styles/xizong-dense-calm.css';
import '../styles/english.css';
import '../styles/frame-integration.css';
import '../styles/politics-readable.css';
import '../styles/english-readable.css';
import '../styles/xizong-readable.css';
import '../styles/legacy-product-finish.css';

const {
  title,
  kicker = 'KianOS · Study',
  description = '',
  sourcePath,
  sourceHash,
  objectId,
  active = 'home',
  showLead = true
} = Astro.props;

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
// English is one learner-facing capability lane. Task-specific routes keep
// their own workspaces but inherit the shared English navigation/context shell.
const englishPrefixes = [
  'english',
  'reading',
  'reading-answer',
  'reading-review',
  'reading-b',
  'reading-b-answer',
  'cloze',
  'cloze-answer',
  'objective-learn',
  'translation',
  'translation-learn',
  'translation-reference',
  'writing',
  'writing-learn'
];
const isEnglishRoute = englishPrefixes.some((segment) => {
  const route = `${base}${segment}`.replace(/\/+/g, '/');
  return pathname === route || pathname === `${route}/` || pathname.startsWith(`${route}/`);
});
const navActive = isEnglishRoute ? 'english' : active;
const navItems = [
  { key: 'xizong', label: '西综', href: `${base}xizong/` },
  { key: 'politics', label: '政治', href: `${base}politics/` },
  { key: 'english', label: 'English', href: `${base}english/` },
  { key: 'lexical', label: 'Lexical', href: `${base}vocabulary/` }
];
const railItems = [
  { key: 'home', label: 'Home', href: base },
  ...navItems
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="KianOS Current learner runtime" />
    <title>{title} · KianOS</title>
    <style is:global>
      [hidden] { display: none !important; }
      /* Xizong learning surfaces stay learner-facing. Provenance remains in
         canonical owners/validators instead of occupying the study chrome. */
      body.surfaceBody-xizong .sourceDock,
      body.surfaceBody-xizong .portedSourceFoot { display: none !important; }
    </style>
  </head>
  <body class={`surfaceBody-${active}`}>
    <div class="legacyProductShell">
      <aside class="legacyOsRail" aria-label="KianOS 学习导航">
        <a class="legacyOsBrand" href={base} aria-label="KianOS Home">
          <span class="legacyOsBrandMark">K</span>
          <span class="legacyOsBrandCopy"><strong>KianOS</strong><small>Study Runtime</small></span>
        </a>
        <nav class="legacyOsNav" aria-label="学习区域">
          <a class={`legacyOsNavItem ${navActive === 'home' ? 'active' : ''}`} href={base}><span>Home</span></a>
          <span class="legacyOsGroupLabel">学习区域</span>
          {navItems.map((item) => <a class={`legacyOsNavItem ${navActive === item.key ? 'active' : ''}`} href={item.href}><span>{item.label}</span></a>)}
        </nav>
        <div class="legacyOsRailFooter" aria-label="Current runtime">
          <i aria-hidden="true"></i><strong>Current</strong><small>learner runtime</small>
        </div>
      </aside>

      <section class="legacyProductWorkspace">
        <header class="productBar">
          <a class="productBrand" href={base} aria-label="KianOS Home">
            <span class="productBrandMark">K</span>
            <span class="productBrandCopy"><strong>KianOS</strong></span>
          </a>
          <nav class="productNav" aria-label="学习模块">
            {navItems.map((item) => <a class={`productNavItem ${navActive === item.key ? 'active' : ''}`} href={item.href}>{item.label}</a>)}
          </nav>
          <details class="sourceDock">
            <summary><span class="sourcePulse"></span>Current</summary>
            <div class="sourcePopover">
              <span>Canonical projection</span>
              {objectId && <strong>{objectId}</strong>}
              {sourcePath && <code>{sourcePath}</code>}
              {sourceHash && <code title={sourceHash}>sha256:{String(sourceHash).slice(0, 16)}</code>}
              <small>canonical read-only · learner state browser-local</small>
              <a href={`${base}current/`} style="margin-top:.35rem;color:inherit;font-weight:800;text-decoration:none;">System Current →</a>
            </div>
          </details>
        </header>
        <a class="skipLink" href="#main-content">跳到学习内容</a>
        <main id="main-content" class={`productCanvas surface-${active}${isEnglishRoute ? ' englishCanvas' : ''} ${showLead ? 'hasPageLead' : 'noPageLead'}`}>
          {showLead && (
            <section class="pageLead">
              <p class="pageKicker">{kicker}</p>
              <div><h1>{title}</h1>{description && <p class="pageDescription">{description}</p>}</div>
            </section>
          )}
          {isEnglishRoute && <EnglishGuideBridge base={base} />}
          <slot />
          {isEnglishRoute && <><ObjectiveResumeTracker /><EnglishLexicalBridge /></>}
        </main>
      </section>
    </div>
  </body>
</html>
