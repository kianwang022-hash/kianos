<span data-reading-session-handoff-root hidden></span>

<script>
  const readingRoot = document.querySelector('[data-local-port="reading"]');

  if (readingRoot && !new URLSearchParams(location.search).has('exam_session')) {
    const readingKey = readingRoot.getAttribute('data-reading-object') || 'reading';
    const continuousKey = 'kianos-reading-continuous-session-v1';
    const resultSummary = readingRoot.querySelector('.portedReadingResultSummary');
    let handoff = null;

    const readJson = (key, fallback) => {
      try { return JSON.parse(localStorage.getItem(key) || 'null') || fallback; }
      catch { return fallback; }
    };
    const readSession = () => {
      const value = readJson(continuousKey, {});
      return {
        active: Boolean(value.active),
        reviewing: Boolean(value.reviewing),
        startedAt: value.startedAt || '',
        items: Array.isArray(value.items) ? value.items : [],
        reviewIds: Array.isArray(value.reviewIds) ? value.reviewIds : [],
        lastSummary: value.lastSummary || null
      };
    };

    const ensureHandoff = () => {
      if (handoff || !resultSummary) return handoff;
      handoff = document.createElement('div');
      handoff.className = 'portedReadingSessionHandoff';
      handoff.hidden = true;

      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = '比较本次跨篇问题';
      button.setAttribute('data-reading-session-copy-chat', '');

      const status = document.createElement('small');
      status.setAttribute('data-reading-session-copy-status', '');
      status.textContent = '只有多篇都出问题、值得找重复模式时才用。';

      handoff.append(button, status);
      resultSummary.appendChild(handoff);
      return handoff;
    };

    const isRelevant = (session) => Boolean(
      session.reviewIds.length >= 2 && (
        (session.reviewing && session.reviewIds.includes(readingKey)) ||
        session.lastSummary?.lastId === readingKey
      )
    );

    const buildPacket = (session) => {
      const problemPassages = session.items.filter((item) => session.reviewIds.includes(item?.id));
      const lines = [
        'Reading A cross-passage review',
        `Session started: ${session.startedAt || '—'}`,
        `Passages submitted: ${session.items.length}`,
        `Problem passages: ${problemPassages.length}`,
        '',
        'Compare only where evidence supports a recurring pattern. A one-off error stays local.'
      ];

      problemPassages.forEach((item, index) => {
        const passageId = item?.id || '';
        if (!passageId) return;
        const attempt = readJson(`kianos-reading-attempt-v1:${passageId}`, {});
        const uncertain = new Set(attempt.uncertain || []);
        const problemIds = Object.keys(attempt.results || {}).filter((id) =>
          ['wrong', 'unanswered'].includes(attempt.results?.[id]) || uncertain.has(id)
        );

        lines.push('');
        lines.push(`Problem passage ${index + 1}: ${passageId}`);
        lines.push(`Score: ${item.score}/${item.total} · Time: ${item.durationSec || 0}s · Problems: ${problemIds.length}`);

        problemIds.forEach((id) => {
          const path = (attempt.trajectory?.[id] || []).map((step) => step?.answer).filter(Boolean).join(' → ') || '—';
          const localNote = attempt.causes?.[id] || '未标';
          lines.push(`- ${id}: ${attempt.results?.[id] || 'uncertain'} · answer ${attempt.answers?.[id] || '未答'} · uncertain ${uncertain.has(id) ? 'yes' : 'no'} · optional note ${localNote} · path ${path}`);
        });
      });

      lines.push(
        '',
        'REVIEW INSTRUCTION',
        'Resolve canonical question/evidence/option context from GitHub Current by the passage/question IDs. First ask whether two or more passages really share one failure mechanism. Merge only evidence-supported recurring patterns. Do not create one weakness label per wrong question and do not manufacture a cross-passage claim when the misses are independent.',
        'If one recurring high-value failure is supported, choose the smallest repair that could change future performance. Otherwise leave each error local and return the learner to new Reading performance.'
      );
      return lines.join('\n');
    };

    const sync = () => {
      const node = ensureHandoff();
      if (!node) return;
      const session = readSession();
      node.hidden = !isRelevant(session);
    };

    ensureHandoff()?.querySelector('[data-reading-session-copy-chat]')?.addEventListener('click', async () => {
      const session = readSession();
      if (!isRelevant(session)) return;
      const status = handoff?.querySelector('[data-reading-session-copy-status]');
      try {
        await navigator.clipboard.writeText(buildPacket(session));
        if (status) status.textContent = '已复制跨篇最小证据包；只找真正重复的 failure。';
      } catch {
        if (status) status.textContent = '复制失败，请稍后再试。';
      }
    });

    readingRoot.addEventListener('click', () => window.setTimeout(sync, 0));
    sync();
  }
</script>