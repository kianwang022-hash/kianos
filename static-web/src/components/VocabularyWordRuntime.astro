---
const { answer } = Astro.props;
const card = answer.record || {};
const wordFeel = card.word_feel && typeof card.word_feel === 'object' ? card.word_feel : null;
const senses = Array.isArray(card.senses) ? card.senses : [];
const secondarySenses = Array.isArray(card.secondary_senses) ? card.secondary_senses : [];
const constructions = Array.isArray(card.constructions) ? card.constructions : [];
const reference = card.reference && typeof card.reference === 'object' ? card.reference : {};
const confusables = Array.isArray(reference.confusables) ? reference.confusables : [];
const semanticRelations = Array.isArray(reference.relations) ? reference.relations : [];
const form = reference.form && typeof reference.form === 'object' ? reference.form : null;
const family = Array.isArray(reference.family) ? reference.family : [];
const recallMap = card.recall_map && typeof card.recall_map === 'object' ? card.recall_map : {};
const recallParts = Array.isArray(recallMap.parts) ? recallMap.parts : [];
const recallDensity = String(recallMap.density || 'light');

const referenceModuleCount = [
  confusables.length > 0,
  semanticRelations.length > 0,
  Boolean(form),
  family.length > 0
].filter(Boolean).length;
const hasReferenceRail = referenceModuleCount > 0;
const referenceWeight = referenceModuleCount >= 3 ? 'rich' : referenceModuleCount === 1 ? 'light' : 'standard';

const posCode = (value = '') => {
  const pos = String(value).toLowerCase();
  if (pos.startsWith('verb') || pos === 'v') return 'V';
  if (pos.startsWith('adj') || pos === 'a') return 'A';
  if (pos.startsWith('noun') || pos === 'n') return 'N';
  if (pos.startsWith('adv')) return 'ADV';
  if (pos.startsWith('prep')) return 'PREP';
  if (pos.startsWith('interj')) return 'INTJ';
  if (pos.startsWith('numeral')) return 'NUM';
  return String(value || 'S').toUpperCase();
};

const repair = (value) => value && typeof value === 'object' ? value : {};
const identityOverlay = (sense) => sense?.identity_overlay && typeof sense.identity_overlay === 'object'
  ? sense.identity_overlay
  : null;
---
<section class="portedVocabRuntime portedVocabRuntimeV2" data-local-port="vocabulary" data-vocab-mode="study" data-vocab-revealed="false" data-vocab-word={card.word} data-vocab-object={answer.objectId} data-vocab-ordinal={answer.ordinal} data-vocab-source-hash={answer.sourceHash}>
  <header class="portedVocabPreviewBar" aria-hidden="true">
    <a href="/">‹ Vocabulary</a>
    <div><span>Study · Depth</span><b>{card.word}</b><small data-vocab-state-label>Ready</small></div>
    <div class="portedVocabPreviewActions">
      <button type="button" data-vocab-speak="en-US" aria-label="美式发音">US</button>
      <button type="button" data-vocab-speak="en-GB" aria-label="英式发音">UK</button>
    </div>
  </header>

  <section class="portedVocabStudySheet">
    <section class="portedVocabWordFront" data-vocab-front data-recall-density={recallDensity}>
      <h2>{card.word}</h2>
      <div class="lexicalFrontPronunciation" aria-label="Pronunciation">
        <button type="button" data-vocab-default-speak data-vocab-speak="en-US">美音 · 点击播放</button>
        <span class="lexicalPronunciationToggle"><button type="button" data-vocab-speak="en-GB">英</button><button type="button" data-vocab-speak="en-US">美</button></span>
      </div>
      <div class="portedVocabRecallMap">
        <strong>{recallParts.length ? recallParts.join(' · ') : 'Core'}</strong>
        <small>当前 active 词义</small>
      </div>
      <p>点击任意空白处，或按 ← / ↑ / Space 查看完整词义</p>
    </section>

    <div data-vocab-details hidden>
      <header class="portedVocabWordHeader">
        <div class="lexicalWordIdentity">
          <span>Coverage · Word Study</span>
          <h2>{card.word}</h2>
          <div class="lexicalDepthPronunciation">
            <button type="button" data-vocab-default-speak data-vocab-speak="en-US">美音 · 点击播放</button>
            <span><button type="button" data-vocab-speak="en-GB">英</button><button type="button" data-vocab-speak="en-US">美</button></span>
          </div>
        </div>

        {wordFeel && (
          <section class="lexicalCoreHeadline" data-vocab-target-row aria-label="Word Feel and Core">
            <span>WORD FEEL / CORE</span>
            <p>{wordFeel.summary_cn}</p>
            {wordFeel.decision_cn && (
              <div class="lexicalCoreDecision">
                <small>怎么判断</small>
                <b>{wordFeel.decision_cn}</b>
              </div>
            )}
            <button
              type="button"
              data-vocab-repair
              data-target-kind={repair(wordFeel.repair).target_kind || 'core'}
              data-target-id={repair(wordFeel.repair).target_id || ''}
              data-target-locator={repair(wordFeel.repair).target_locator || ''}
              data-target-label={repair(wordFeel.repair).target_label || wordFeel.summary_cn || card.word}
              aria-pressed="false"
            >+</button>
          </section>
        )}
      </header>

      <div class="portedVocabBody" data-vocab-body data-has-reference={hasReferenceRail ? 'true' : 'false'} data-reference-weight={referenceWeight}>
        <main class="portedVocabMeaningColumn">
          <div class="portedVocabSenseList" data-vocab-repair-list>
            {senses.map((sense) => {
              const target = repair(sense.repair);
              const overlay = identityOverlay(sense);
              return (
                <section class="lexicalSenseRow" data-vocab-target-row>
                  <header>
                    <span>{posCode(sense.pos)}</span>
                    {sense.governing_pattern && <small>{sense.governing_pattern}</small>}
                    <button
                      type="button"
                      data-vocab-repair
                      data-target-kind={target.target_kind || 'sense'}
                      data-target-id={target.target_id || sense.id || ''}
                      data-target-locator={target.target_locator || sense.source_locator || ''}
                      data-target-label={target.target_label || sense.definition_cn || sense.definition_en || card.word}
                      aria-pressed="false"
                    >+</button>
                  </header>

                  <div class="lexicalSenseMeaning">
                    <p>{sense.definition_cn || '—'}</p>
                    <strong>{sense.definition_en || '—'}</strong>
                    {sense.note && <small class="lexicalSenseNote">{sense.note}</small>}
                    {overlay?.text && (
                      <article class="portedVocabIdentityOverlay" data-vocab-target-row>
                        <b>{overlay.text}</b>
                        <button
                          type="button"
                          data-vocab-repair
                          data-target-kind={repair(overlay.repair).target_kind || 'form_identity'}
                          data-target-id={repair(overlay.repair).target_id || ''}
                          data-target-locator={repair(overlay.repair).target_locator || ''}
                          data-target-label={repair(overlay.repair).target_label || overlay.text}
                          aria-pressed="false"
                        >+</button>
                      </article>
                    )}
                  </div>

                  {Array.isArray(sense.usage) && sense.usage.length > 0 && (
                    <ul class="lexicalSenseUsage">
                      {sense.usage.map((item) => {
                        const usageRepair = repair(item.repair);
                        const isFixed = item.kind === 'fixed_pattern';
                        return (
                          <li class={isFixed ? 'isFixedPattern' : 'isUsageExample'} data-vocab-target-row={item.repair ? '' : undefined}>
                            <b>{item.phrase}</b>
                            {item.meaning_cn && <span>{item.meaning_cn}</span>}
                            {item.repair && (
                              <button
                                type="button"
                                data-vocab-repair
                                data-target-kind={usageRepair.target_kind || 'collocation'}
                                data-target-id={usageRepair.target_id || item.id || ''}
                                data-target-locator={usageRepair.target_locator || item.source_locator || ''}
                                data-target-label={usageRepair.target_label || item.phrase || card.word}
                                aria-pressed="false"
                              >+</button>
                            )}
                          </li>
                        );
                      })}
                    </ul>
                  )}
                </section>
              );
            })}

            {secondarySenses.map((sense) => {
              const target = repair(sense.repair);
              return (
                <section class="lexicalSenseRow lexicalSecondarySenseRow" data-vocab-target-row>
                  <header>
                    <span>{posCode(sense.pos)}+</span>
                    <button
                      type="button"
                      data-vocab-repair
                      data-target-kind={target.target_kind || 'secondary_sense'}
                      data-target-id={target.target_id || sense.id || ''}
                      data-target-locator={target.target_locator || sense.source_locator || ''}
                      data-target-label={target.target_label || sense.definition_cn || sense.definition_en || card.word}
                      aria-pressed="false"
                    >+</button>
                  </header>
                  <div class="lexicalSenseMeaning">
                    <p>{sense.definition_cn || '—'}</p>
                    <strong>{sense.definition_en || '—'}</strong>
                    {sense.note && <small class="lexicalSenseNote">{sense.note}</small>}
                  </div>
                  {sense.pattern && <div class="lexicalSenseUsage lexicalSecondaryUsage"><code>{sense.pattern}</code></div>}
                </section>
              );
            })}
          </div>

          {constructions.length > 0 && (
            <section class="lexicalWordPatterns" aria-label="Word-level patterns and constructions">
              <header>
                <span>PATTERNS / CONSTRUCTIONS</span>
                <small>Word-owned 可复用结构</small>
              </header>
              <div class="lexicalPatternList">
                {constructions.map((item) => {
                  const target = repair(item.repair);
                  return (
                    <article data-vocab-target-row>
                      <b>{item.pattern}</b>
                      <div class="lexicalPatternText">
                        {(Array.isArray(item.lines) ? item.lines : []).map((line) => (
                          <span class={line.lang === 'cn' ? 'is-cn' : 'is-en'}>{line.text}</span>
                        ))}
                      </div>
                      <button
                        type="button"
                        data-vocab-repair
                        data-target-kind={target.target_kind || 'construction'}
                        data-target-id={target.target_id || item.id || ''}
                        data-target-locator={target.target_locator || item.source_locator || ''}
                        data-target-label={target.target_label || item.pattern || card.word}
                        aria-pressed="false"
                      >+</button>
                    </article>
                  );
                })}
              </div>
            </section>
          )}
        </main>

        {hasReferenceRail && (
          <aside class="portedVocabEvidenceColumn" aria-label="Cross-sense lexical reference">
            {confusables.length > 0 && (
              <section class="lexicalExpansionSection lexicalRelationSection">
                <header><span>易混辨析</span><small>Confusable</small></header>
                <div class="portedVocabEvidenceList">
                  {confusables.map((item) => {
                    const target = repair(item.repair);
                    return (
                      <article data-vocab-target-row>
                        <b>{item.title}</b>
                        <div class="lexicalRelationText">
                          {(Array.isArray(item.lines) ? item.lines : []).map((line) => (
                            <p class={line.lang === 'cn' ? 'is-cn' : 'is-en'}>{line.text}</p>
                          ))}
                        </div>
                        {Array.isArray(item.differences) && item.differences.length > 0 && (
                          <dl class="lexicalRelationDecision">
                            {item.differences.map((row) => <div><dt>{row.key}</dt><dd>{row.value}</dd></div>)}
                          </dl>
                        )}
                        <button
                          type="button"
                          data-vocab-repair
                          data-target-kind={target.target_kind || 'relation'}
                          data-target-id={target.target_id || item.id || ''}
                          data-target-locator={target.target_locator || ''}
                          data-target-label={target.target_label || item.title || card.word}
                          aria-pressed="false"
                        >+</button>
                      </article>
                    );
                  })}
                </div>
              </section>
            )}

            {semanticRelations.length > 0 && (
              <section class="lexicalExpansionSection lexicalRelationSection">
                <header><span>语义关系</span><small>Relation</small></header>
                <div class="portedVocabEvidenceList">
                  {semanticRelations.map((item) => {
                    const target = repair(item.repair);
                    return (
                      <article data-vocab-target-row>
                        <b>{item.title}</b>
                        <div class="lexicalRelationText">
                          {(Array.isArray(item.lines) ? item.lines : []).map((line) => (
                            <p class={line.lang === 'cn' ? 'is-cn' : 'is-en'}>{line.text}</p>
                          ))}
                        </div>
                        {Array.isArray(item.differences) && item.differences.length > 0 && (
                          <dl class="lexicalRelationDecision">
                            {item.differences.map((row) => <div><dt>{row.key}</dt><dd>{row.value}</dd></div>)}
                          </dl>
                        )}
                        <button
                          type="button"
                          data-vocab-repair
                          data-target-kind={target.target_kind || 'relation'}
                          data-target-id={target.target_id || item.id || ''}
                          data-target-locator={target.target_locator || ''}
                          data-target-label={target.target_label || item.title || card.word}
                          aria-pressed="false"
                        >+</button>
                      </article>
                    );
                  })}
                </div>
              </section>
            )}

            {form && (
              <section class="lexicalExpansionSection lexicalFormSection" data-vocab-target-row>
                <header><span>词形 / 发音</span><small>Form / Pronunciation</small></header>
                {form.boundary && <p class="lexicalFormBoundary">{form.boundary}</p>}
                {Array.isArray(form.boundaries) && form.boundaries.length > 0 && (
                  <div class="lexicalFormVariants">
                    {form.boundaries.map((boundary) => (
                      <article>
                        <b>{boundary.surface || boundary.condition}</b>
                        {boundary.condition && boundary.surface && <span>{boundary.condition}</span>}
                        {boundary.note && <small>{boundary.note}</small>}
                      </article>
                    ))}
                  </div>
                )}
                {Array.isArray(form.variants) && form.variants.length > 0 && (
                  <div class="lexicalFormVariants">
                    {form.variants.map((variant) => (
                      <article>
                        <small class="lexicalFormPos">{Array.isArray(variant.pos) ? variant.pos.join(' / ') : ''}</small>
                        <div class="lexicalFormReading">
                          <b>{variant.reading}</b>
                          {variant.stress && <small>{variant.stress}</small>}
                        </div>
                        {variant.ipa && <span class="lexicalFormIpa">{variant.ipa}</span>}
                      </article>
                    ))}
                  </div>
                )}
                <button
                  type="button"
                  data-vocab-repair
                  data-target-kind={repair(form.repair).target_kind || 'form_identity'}
                  data-target-id={repair(form.repair).target_id || ''}
                  data-target-locator={repair(form.repair).target_locator || 'record.form_identity'}
                  data-target-label={repair(form.repair).target_label || card.word}
                  aria-pressed="false"
                >+</button>
              </section>
            )}

            {family.length > 0 && (
              <section class="lexicalExpansionSection lexicalFamilySection">
                <header><span>词族</span><small>Word Family</small></header>
                <div class="lexicalFamilyRows">
                  {family.map((item) => (
                    <article>
                      <b>{item.target_word}</b>
                      <div>
                        {(Array.isArray(item.lines) ? item.lines : []).map((line) => (
                          <span class={line.lang === 'cn' ? 'is-cn' : 'is-en'}>{line.text}</span>
                        ))}
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            )}
          </aside>
        )}
      </div>

      <section class="portedVocabLocalNote">
        <div><b>Repair</b><p data-vocab-repair-summary>当前没有加入 Repair 的分支。</p></div>
      </section>
    </div>

    <footer class="portedVocabFoot">
      <span>J / K 选择局部对象 · + 加入/移出 Repair · S 发音</span>
      <details data-vocab-debug-source hidden><summary>Source</summary><code>{answer.sourcePath}</code><code>sha256:{String(answer.sourceHash).slice(0, 16)}</code></details>
    </footer>
  </section>

  <footer class="lexicalActionDock" data-vocab-action-dock aria-label="Vocabulary actions">
    <button type="button" class="dockReveal" data-vocab-reveal>
      <span>◉</span><b>查看词义</b><small>← / ↑ / Space</small>
    </button>
    <button type="button" class="dockUnknown" data-vocab-route="unknown">
      <span>←</span><b>不认识</b><small>Unknown</small>
    </button>
    <button type="button" class="dockFuzzy" data-vocab-route="fuzzy">
      <span>↑</span><b>模糊</b><small>Fuzzy</small>
    </button>
    <button type="button" class="dockKnown" data-vocab-route="known">
      <span>→</span><b>熟练</b><small>继续下一词</small>
    </button>
    <button type="button" class="dockMastered" data-vocab-route="mastered">
      <span>↓</span><b>已掌握</b><small>稳定快速离开</small>
    </button>
    <button type="button" class="dockUndo" data-vocab-undo disabled>
      <span>↶</span><b>Undo</b><small>Backspace</small>
    </button>
    <button type="button" class="dockNote" data-vocab-note>
      <span>✎</span><b>+笔记</b><small>个人学习备注</small>
    </button>
  </footer>

  <section class="lexicalNoteDrawer" data-vocab-note-drawer hidden>
    <label><span>{card.word} · Note</span><textarea rows="5" data-vocab-note-input placeholder="只记对后续学习有用的个人备注。"></textarea></label>
    <div><button type="button" data-vocab-note-cancel>取消</button><button type="button" class="primary" data-vocab-note-save>保存并返回词卡</button></div>
  </section>
</section>

<script>
  import { LEXICAL_LEDGER_STORAGE_KEY, appendEvidenceEvent, compileRepairTargets, legacyEventId } from '../lib/lexicalEvidence.mjs';
  import { DEFAULT_PRONUNCIATION, LEXICAL_SETTINGS_STORAGE_KEY, normalizeLexicalSettings } from '../lib/lexicalSettings.mjs';
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  import { readBrowserLexicalLedger, writeBrowserLexicalLedger, lexicalBrowserStateReadable } from '../lib/lexicalBrowserState.mjs';
  void learnerWriterReady.then(() => {
  if (!lexicalBrowserStateReadable()) return;


  const initializeVocabularyRoot = (root) => {
    if (!(root instanceof HTMLElement) || root.dataset.vocabInitialized === 'true') return;
    root.dataset.vocabInitialized = 'true';

    const word = root.getAttribute('data-vocab-word') || '';
    const objectId = root.getAttribute('data-vocab-object') || word;
    const ordinal = Number(root.getAttribute('data-vocab-ordinal') || 0);
    const sourceHash = root.getAttribute('data-vocab-source-hash') || '';
    const requestedMode = new URLSearchParams(location.search).get('mode');
    const mode = ['lookup', 'repair'].includes(String(requestedMode || '')) ? String(requestedMode) : 'study';
    const readOnlyLookup = mode === 'lookup';
    root.dataset.vocabMode = mode;
    const storageKey = `kianos-vocabulary-astro-v2:${objectId}`;
    const front = root.querySelector('[data-vocab-front]');
    const details = root.querySelector('[data-vocab-details]');
    const reveal = root.querySelector('[data-vocab-reveal]');
    const stateLabel = root.querySelector('[data-vocab-state-label]');
    const modeLabel = root.querySelector('.lexicalWordIdentity>span');
    if (modeLabel && mode !== 'study') modeLabel.textContent = mode === 'lookup' ? 'Lookup' : 'Repair';
    const repairSummary = root.querySelector('[data-vocab-repair-summary]');
    const repairButtons = [...root.querySelectorAll('[data-vocab-repair]')];
    const noteKey = `kianos-lexical-note-v1:${objectId}`;
    const noteDrawer = root.querySelector('[data-vocab-note-drawer]');
    const noteInput = root.querySelector('[data-vocab-note-input]');
    const localStudyDay = () => new Date().toLocaleDateString('en-CA');
    const debugMode = new URLSearchParams(location.search).get('debug') === '1';
    root.querySelectorAll('[data-vocab-debug-source]').forEach((node) => { if (node instanceof HTMLElement) node.hidden = !debugMode; });
    const readJson = (key, fallback) => { try { return JSON.parse(localStorage.getItem(key) || 'null') || fallback; } catch { return fallback; } };
    const saveJson = (key, value) => { try { localStorage.setItem(key, JSON.stringify(value)); } catch {} };
    const lexicalSettings = () => normalizeLexicalSettings(readJson(LEXICAL_SETTINGS_STORAGE_KEY, { default_pronunciation: DEFAULT_PRONUNCIATION }));
    const defaultPronunciation = () => lexicalSettings().default_pronunciation;
    const pronunciationLabel = (lang) => lang === 'en-GB' ? '英音 · 点击播放' : '美音 · 点击播放';
    const syncPronunciationPreference = () => {
      const preferred = defaultPronunciation();
      root.querySelectorAll('[data-vocab-default-speak]').forEach((button) => {
        button.setAttribute('data-vocab-speak', preferred);
        button.textContent = pronunciationLabel(preferred);
        if (button.hasAttribute('aria-label')) {
          button.setAttribute('aria-label', preferred === 'en-GB' ? '英式发音' : '美式发音');
        }
      });
      root.querySelectorAll('.lexicalPronunciationToggle [data-vocab-speak], .lexicalDepthPronunciation span [data-vocab-speak]').forEach((button) => {
        button.classList.toggle('active', button.getAttribute('data-vocab-speak') === preferred);
      });
    };
    const readLedger = () => readBrowserLexicalLedger();
    const saveLedger = (ledger) => writeBrowserLexicalLedger(ledger);
    let selectedIndex = -1;
    let state = { revealed: false, repairTargets: {}, lastSeenAt: '', meta: { word_id: objectId, ordinal, word, source_hash: sourceHash } };

    state = { ...state, ...(readJson(storageKey, null) || {}) };
    if (!state.repairTargets || typeof state.repairTargets !== 'object') state.repairTargets = {};
    state.meta = { word_id: objectId, ordinal, word, source_hash: sourceHash };

    const previousTargets = { ...state.repairTargets };
    let ledger = readLedger();
    if (!readOnlyLookup) {
      for (const target of Object.values(previousTargets)) {
        if (!target || typeof target !== 'object' || target.source === 'evidence_reducer') continue;
        const migration = {
          word_id: objectId,
          ordinal,
          word,
          target_kind: target.target_kind || 'lexical',
          target_id: target.target_id || null,
          target_locator: target.target_locator || null,
          target_revision: target.target_id ? null : (target.target_revision || sourceHash || null),
          source: 'depth_plus',
          outcome: 'ADDED',
          observed_at: target.observed_at || state.lastSeenAt || new Date().toISOString()
        };
        migration.event_id = `migration:${legacyEventId(migration)}`;
        ledger = appendEvidenceEvent(ledger, migration).ledger;
      }
      saveLedger(ledger);
    }
    const activeTargets = compileRepairTargets(ledger).filter((target) => target.word_id === objectId);
    state.repairTargets = Object.fromEntries(activeTargets.map((target) => {
      const key = target.target_id || `${target.target_kind}:${target.target_locator || ''}`;
      const previous = previousTargets[key] || {};
      return [key, {
        target_kind: target.target_kind,
        target_id: target.target_id || null,
        target_locator: target.target_locator || null,
        target_revision: target.target_revision || null,
        label: previous.label || target.word || word,
        source: 'evidence_reducer',
        outcome: 'ADDED',
        observed_at: target.last_evidence_at || target.activated_at || new Date().toISOString()
      }];
    }));

    if (mode !== 'study') state.revealed = true;

    const targetFromButton = (button) => {
      const kind = button.getAttribute('data-target-kind') || 'lexical';
      const id = button.getAttribute('data-target-id') || '';
      const locator = button.getAttribute('data-target-locator') || '';
      const label = button.getAttribute('data-target-label') || '';
      const key = id || `${kind}:${locator}`;
      return { key, kind, id, locator, label };
    };

    const save = (explicitMutation = false) => {
      if (readOnlyLookup && !explicitMutation) return;
      state.lastSeenAt = new Date().toISOString();
      state.meta = { word_id: objectId, ordinal, word, source_hash: sourceHash };
      saveJson(storageKey, state);
    };

    const render = () => {
      root.dataset.vocabRevealed = String(Boolean(state.revealed));
      if (front) front.hidden = Boolean(state.revealed);
      if (details) details.hidden = !state.revealed;
      repairButtons.forEach((button, index) => {
        const target = targetFromButton(button);
        const active = Boolean(state.repairTargets[target.key]);
        button.classList.toggle('selected', active);
        button.setAttribute('aria-pressed', String(active));
        button.textContent = active ? '✓' : '+';
        const row = button.closest('[data-vocab-target-row]');
        row?.classList.toggle('keyboard-target', index === selectedIndex);
        row?.classList.toggle('repair-selected', active);
      });
      const count = Object.keys(state.repairTargets).length;
      if (stateLabel) stateLabel.textContent = mode === 'lookup'
        ? 'Lookup'
        : mode === 'repair'
          ? (count ? `${count} Repair` : 'Repair')
          : state.revealed ? (count ? `${count} Repair` : 'Scanned') : 'Ready';
      if (repairSummary) repairSummary.textContent = count ? `${count} 个具体分支处于 Repair 状态；已记录到当前学习状态。` : '当前没有加入 Repair 的分支。';
    };

    const openCard = () => { state.revealed = true; save(false); render(); };
    reveal?.addEventListener('click', openCard);
    front?.addEventListener('click', (event) => {
      if (mode !== 'study' || state.revealed) return;
      const target = event.target;
      if (target instanceof HTMLElement && target.closest('button,a,input,textarea,select')) return;
      openCard();
    });

    const openNote = () => {
      if (!(noteDrawer instanceof HTMLElement) || !(noteInput instanceof HTMLTextAreaElement)) return;
      noteInput.value = localStorage.getItem(noteKey) || '';
      noteDrawer.hidden = false;
      requestAnimationFrame(() => noteInput.focus({ preventScroll: true }));
    };
    const closeNote = () => { if (noteDrawer instanceof HTMLElement) noteDrawer.hidden = true; };
    root.querySelector('[data-vocab-note]')?.addEventListener('click', openNote);
    root.querySelector('[data-vocab-note-cancel]')?.addEventListener('click', closeNote);
    root.querySelector('[data-vocab-note-save]')?.addEventListener('click', () => {
      if (noteInput instanceof HTMLTextAreaElement) {
        try { localStorage.setItem(noteKey, noteInput.value.trim()); } catch {}
      }
      closeNote();
    });

    const speak = (lang = 'en-US') => {
      if (!('speechSynthesis' in window) || !word) return;
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(word);
      utterance.lang = lang;
      utterance.rate = 0.86;
      window.speechSynthesis.speak(utterance);
    };
    root.querySelectorAll('[data-vocab-speak]').forEach((button) => button.addEventListener('click', () => speak(button.getAttribute('data-vocab-speak') || 'en-US')));

    const setRepair = (button, active) => {
      if (!lexicalBrowserStateReadable()) return;
      const target = targetFromButton(button);
      if (active) {
        state.repairTargets[target.key] = {
          target_kind: target.kind,
          target_id: target.id || null,
          target_locator: target.locator || null,
          target_revision: target.id ? null : (sourceHash || null),
          label: target.label,
          source: 'depth_plus',
          outcome: 'ADDED',
          study_day: localStudyDay(),
          observed_at: new Date().toISOString()
        };
      } else {
        delete state.repairTargets[target.key];
      }
      save(true);
      render();
    };

    repairButtons.forEach((button, index) => button.addEventListener('click', () => {
      selectedIndex = index;
      const target = targetFromButton(button);
      setRepair(button, !state.repairTargets[target.key]);
    }));

    const selectByDelta = (delta) => {
      if (!repairButtons.length) return;
      selectedIndex = selectedIndex < 0 ? (delta > 0 ? 0 : repairButtons.length - 1) : (selectedIndex + delta + repairButtons.length) % repairButtons.length;
      repairButtons[selectedIndex]?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      render();
    };

    const activeRepairButton = () => selectedIndex >= 0 ? repairButtons[selectedIndex] : null;
    root.addEventListener('click', () => {
      document.querySelectorAll('[data-local-port="vocabulary"]').forEach((candidate) => candidate.removeAttribute('data-vocab-keyboard-active'));
      root.setAttribute('data-vocab-keyboard-active', 'true');
    });

    const onKeydown = (event) => {
      if (document.querySelector('[data-vocab-challenge-runtime][data-challenge-active="true"]')) return;
      const roots = [...document.querySelectorAll('[data-local-port="vocabulary"]')];
      const activeRoot = document.querySelector('[data-local-port="vocabulary"][data-vocab-keyboard-active="true"]') || roots[0];
      if (activeRoot !== root) return;
      const target = event.target;
      if (target instanceof HTMLElement && target.closest('input,textarea,select,[contenteditable="true"]')) return;
      if (event.key.toLowerCase() === 's') { event.preventDefault(); speak(defaultPronunciation()); return; }
      if (!state.revealed && (event.code === 'Space' || event.key === 'ArrowLeft' || event.key === 'ArrowUp')) {
        event.preventDefault(); openCard(); return;
      }
      if (!state.revealed) return;
      if (event.key.toLowerCase() === 'j') { event.preventDefault(); selectByDelta(1); return; }
      if (event.key.toLowerCase() === 'k') { event.preventDefault(); selectByDelta(-1); return; }
      if (event.key === '+') {
        const button = activeRepairButton();
        if (button) { event.preventDefault(); button.click(); }
      }
    };
    document.addEventListener('keydown', onKeydown);

    syncPronunciationPreference();
    window.addEventListener('kianos:lexical-settings-changed', syncPronunciationPreference);
    window.addEventListener('storage', (event) => {
      if (event.key === LEXICAL_SETTINGS_STORAGE_KEY) syncPronunciationPreference();
    });
    save();
    render();
  };

  document.querySelectorAll('[data-local-port="vocabulary"]').forEach(initializeVocabularyRoot);

  });
</script>
