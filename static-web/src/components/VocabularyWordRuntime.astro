---
const { answer } = Astro.props;
const card = answer?.learnerObject || {};
const core = card.core || {};
const senses = Array.isArray(card.senses) ? card.senses : [];
const secondarySenses = Array.isArray(card.secondarySenses) ? card.secondarySenses : [];
const expansion = card.expansion || {};
const constructions = Array.isArray(expansion.constructions) ? expansion.constructions : [];
const relations = Array.isArray(expansion.relations) ? expansion.relations : [];
const formIdentity = expansion.formIdentity || null;
const family = Array.isArray(expansion.family) ? expansion.family : [];
const recallParts = Array.isArray(card?.recall?.parts) ? card.recall.parts : [];
const recallPatterns = Array.isArray(card?.recall?.patterns) ? card.recall.patterns : [];
const hasImportantExpansion = expansion.hasImportant === true;
const expansionWeight = expansion.weight || 'standard';
const t = (value = {}) => ({
  kind: value?.kind || 'lexical',
  id: value?.id || '',
  locator: value?.locator || '',
  label: value?.label || ''
});
---
<section class="portedVocabRuntime portedVocabRuntimeV2" data-local-port="vocabulary" data-vocab-word={card.word} data-vocab-object={answer.objectId} data-vocab-ordinal={answer.ordinal} data-vocab-source-hash={answer.sourceHash}>
  <header class="portedVocabPreviewBar">
    <a href="/">‹ Vocabulary</a>
    <div><span>Study · Depth</span><b>{card.word}</b><small data-vocab-state-label>Ready</small></div>
    <div class="portedVocabPreviewActions">
      <button type="button" data-vocab-speak="en-US" aria-label="美式发音">US</button>
      <button type="button" data-vocab-speak="en-GB" aria-label="英式发音">UK</button>
    </div>
  </header>

  <section class="portedVocabStudySheet">
    <section class="portedVocabWordFront" data-vocab-front>
      <span>Recall Map</span>
      <h2>{card.word}</h2>
      <div class="portedVocabRecallMap">
        <strong>{recallParts.length ? recallParts.join(' · ') : 'Core'}</strong>
        {card?.recall?.hasDeepBranches && <small>+ = 高价值深层分支</small>}
        {recallPatterns.map((pattern) => <code>{pattern}</code>)}
      </div>
      <p>先把你能想到的高价值含义和结构在脑中搜一遍，再翻开核对。</p>
      <button type="button" class="portedPrimaryAction" data-vocab-reveal>Reveal</button>
    </section>

    <div data-vocab-details hidden>
      <header class="portedVocabWordHeader">
        <div class="lexicalWordIdentity">
          <span>Depth Reveal</span>
          <h2>{card.word}</h2>
        </div>
        <div class="lexicalCoreHeadline" data-vocab-target-row>
          <p>{core.primaryCn || '—'}</p>
          {core.secondaryCn && <b>{core.secondaryCn}</b>}
          {core.english && <small>{core.english}</small>}
          <button type="button" data-vocab-repair data-target-kind={t(core.target).kind} data-target-id={t(core.target).id} data-target-locator={t(core.target).locator} data-target-label={t(core.target).label} aria-pressed="false">+</button>
        </div>
        <aside>
          <b>{recallParts.length ? recallParts.join(' · ') : 'Core'}</b>
          <small>会的扫过；慢 / 模糊 / 漏掉的具体分支按 +</small>
        </aside>
      </header>

      <div class="portedVocabBody" data-vocab-body data-has-expansion={hasImportantExpansion ? 'true' : 'false'} data-expansion-weight={expansionWeight}>
        <main class="portedVocabMeaningColumn">
          <div class="portedVocabSenseList" data-vocab-repair-list>
            {senses.map((sense) => (
              <section class="lexicalSenseRow" data-vocab-target-row>
                <header>
                  <span>{sense.posCode}</span>
                  {sense.governingPattern && <small>{sense.governingPattern}</small>}
                  <button type="button" data-vocab-repair data-target-kind={t(sense.target).kind} data-target-id={t(sense.target).id} data-target-locator={t(sense.target).locator} data-target-label={t(sense.target).label} aria-pressed="false">+</button>
                </header>
                <div class="lexicalSenseMeaning">
                  <p>{sense.definitionCn || '—'}</p>
                  <strong>{sense.definitionEn || '—'}</strong>
                  {sense.usageNote && <small class="lexicalSenseNote">{sense.usageNote}</small>}
                  {sense.identityOverlay && (
                    <article class="portedVocabIdentityOverlay" data-vocab-target-row>
                      <small>FORM / IDENTITY</small>
                      <b>{sense.identityOverlay.text}</b>
                      <button type="button" data-vocab-repair data-target-kind={t(sense.identityOverlay.target).kind} data-target-id={t(sense.identityOverlay.target).id} data-target-locator={t(sense.identityOverlay.target).locator} data-target-label={t(sense.identityOverlay.target).label} aria-pressed="false">+</button>
                    </article>
                  )}
                </div>
                {sense.collocations.length > 0 && (
                  <ul class="lexicalSenseUsage">
                    {sense.collocations.map((item) => (
                      <li class={item.fixedPattern ? 'isFixedPattern' : 'isUsageExample'} data-vocab-target-row={item.fixedPattern ? '' : undefined}>
                        <b>{item.phrase}</b>
                        {item.meaningCn && <span>{item.meaningCn}</span>}
                        {item.fixedPattern && item.target && <button type="button" data-vocab-repair data-target-kind={t(item.target).kind} data-target-id={t(item.target).id} data-target-locator={t(item.target).locator} data-target-label={t(item.target).label} aria-pressed="false">+</button>}
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            ))}

            {secondarySenses.map((branch) => (
              <section class="lexicalSenseRow lexicalSecondarySenseRow" data-vocab-target-row>
                <header>
                  <span>{branch.posCode}+</span>
                  <button type="button" data-vocab-repair data-target-kind={t(branch.target).kind} data-target-id={t(branch.target).id} data-target-locator={t(branch.target).locator} data-target-label={t(branch.target).label} aria-pressed="false">+</button>
                </header>
                <div class="lexicalSenseMeaning">
                  <p>{branch.definitionCn || '—'}</p>
                  <strong>{branch.definitionEn || '—'}</strong>
                </div>
                {branch.pattern && <div class="lexicalSenseUsage lexicalSecondaryUsage"><code>{branch.pattern}</code></div>}
              </section>
            ))}
          </div>
        </main>

        {hasImportantExpansion && <aside class="portedVocabEvidenceColumn" aria-label="Important lexical expansion">
          {constructions.length > 0 && <section class="lexicalExpansionSection lexicalConstructionSection">
            <header><span>Constructions</span><small>独立构式 / 固定表达</small></header>
            <div class="portedVocabEvidenceList">
              {constructions.map((item) => (
                <article data-vocab-target-row>
                  <p class="lexicalExpansionCn">{item.meaningCn || '—'}</p>
                  <b>{item.label}</b>
                  {item.definitionEn && <small>{item.definitionEn}</small>}
                  <button type="button" data-vocab-repair data-target-kind={t(item.target).kind} data-target-id={t(item.target).id} data-target-locator={t(item.target).locator} data-target-label={t(item.target).label} aria-pressed="false">+</button>
                </article>
              ))}
            </div>
          </section>}

          {relations.length > 0 && <section class="lexicalExpansionSection lexicalRelationSection">
            <header><span>Contrast / Confusable</span><small>只保留会改变判断的边界</small></header>
            <div class="portedVocabEvidenceList">
              {relations.map((relation) => (
                <article data-vocab-target-row>
                  <b>{relation.targetExpression || 'contrast'}</b>
                  {relation.lead && <p>{relation.lead}</p>}
                  {relation.extraBoundaries.map((boundary) => <small class="lexicalRelationNote">{boundary}</small>)}
                  {relation.differences.length > 0 && <dl class="lexicalRelationDecision">{relation.differences.map((row) => <div><dt>{row.key}</dt><dd>{row.value}</dd></div>)}</dl>}
                  <button type="button" data-vocab-repair data-target-kind={t(relation.target).kind} data-target-id={t(relation.target).id} data-target-locator={t(relation.target).locator} data-target-label={t(relation.target).label} aria-pressed="false">+</button>
                </article>
              ))}
            </div>
          </section>}

          {formIdentity && <section class="lexicalExpansionSection lexicalFormSection" data-vocab-target-row>
            <header><span>Form / Pronunciation</span><small>形式会改变读取时才显示</small></header>
            {formIdentity.boundary && <p class="lexicalFormBoundary">{formIdentity.boundary}</p>}
            {formIdentity.boundaries.length > 0 && <div class="lexicalFormVariants">{formIdentity.boundaries.map((boundary) => <article><b>{boundary.surface || boundary.condition || 'Form boundary'}</b>{boundary.condition && boundary.surface && <span>{boundary.condition}</span>}{boundary.note && <small>{boundary.note}</small>}</article>)}</div>}
            {formIdentity.variants.length > 0 && <div class="lexicalFormVariants">{formIdentity.variants.map((variant) => <article><b>{variant.learnerKey}</b>{variant.ipa && <span>{variant.ipa}</span>}{variant.pos.length > 0 && <small>{variant.pos.join(' / ')}</small>}</article>)}</div>}
            <button type="button" data-vocab-repair data-target-kind={t(formIdentity.target).kind} data-target-id={t(formIdentity.target).id} data-target-locator={t(formIdentity.target).locator} data-target-label={t(formIdentity.target).label} aria-pressed="false">+</button>
          </section>}

          {family.length > 0 && <section class="lexicalExpansionSection lexicalFamilySection">
            <header><span>Word Family</span><small>有压缩价值才跟随 Depth</small></header>
            <div class="lexicalFamilyRows">{family.map((item) => <article><b>{item.targetWord}</b>{item.boundary && <span>{item.boundary}</span>}</article>)}</div>
          </section>}
        </aside>}
      </div>

      <section class="portedVocabLocalNote">
        <div><b>Repair</b><p data-vocab-repair-summary>当前没有加入 Repair 的分支。</p></div>
        <button type="button" data-vocab-copy-packet>Copy Return Packet</button>
      </section>
    </div>

    <footer class="portedVocabFoot">
      <span>Space Reveal · ↑↓ 选择拓展 · → / + 加入 Repair · ← 撤销 · S 发音</span>
      <details><summary>Source</summary><code>{answer.sourcePath}</code><code>sha256:{String(answer.sourceHash).slice(0, 16)}</code></details>
    </footer>
  </section>
</section>

<script>
  import { LEXICAL_LEDGER_STORAGE_KEY, appendEvidenceEvent, compileRepairTargets, emptyLexicalLedger, exportReturnEvents, legacyEventId, normalizeLexicalLedger } from '../lib/lexicalEvidence.mjs';

  const initializeVocabularyRoot = (root) => {
    if (!(root instanceof HTMLElement) || root.dataset.vocabInitialized === 'true') return;
    root.dataset.vocabInitialized = 'true';

    const word = root.getAttribute('data-vocab-word') || '';
    const objectId = root.getAttribute('data-vocab-object') || word;
    const ordinal = Number(root.getAttribute('data-vocab-ordinal') || 0);
    const sourceHash = root.getAttribute('data-vocab-source-hash') || '';
    const storageKey = `kianos-vocabulary-astro-v2:${objectId}`;
    const front = root.querySelector('[data-vocab-front]');
    const details = root.querySelector('[data-vocab-details]');
    const reveal = root.querySelector('[data-vocab-reveal]');
    const stateLabel = root.querySelector('[data-vocab-state-label]');
    const repairSummary = root.querySelector('[data-vocab-repair-summary]');
    const repairButtons = [...root.querySelectorAll('[data-vocab-repair]')];
    const localStudyDay = () => new Date().toLocaleDateString('en-CA');
    const eventLocalDay = (iso) => { const date = new Date(iso); return Number.isNaN(date.getTime()) ? '' : date.toLocaleDateString('en-CA'); };
    const readJson = (key, fallback) => { try { return JSON.parse(localStorage.getItem(key) || 'null') || fallback; } catch { return fallback; } };
    const saveJson = (key, value) => { try { localStorage.setItem(key, JSON.stringify(value)); } catch {} };
    const readLedger = () => normalizeLexicalLedger(readJson(LEXICAL_LEDGER_STORAGE_KEY, emptyLexicalLedger()));
    const saveLedger = (ledger) => saveJson(LEXICAL_LEDGER_STORAGE_KEY, ledger);
    let selectedIndex = -1;
    let state = { revealed: false, repairTargets: {}, lastSeenAt: '', meta: { word_id: objectId, ordinal, word, source_hash: sourceHash } };

    state = { ...state, ...(readJson(storageKey, null) || {}) };
    if (!state.repairTargets || typeof state.repairTargets !== 'object') state.repairTargets = {};
    state.meta = { word_id: objectId, ordinal, word, source_hash: sourceHash };

    const previousTargets = { ...state.repairTargets };
    let ledger = readLedger();
    for (const target of Object.values(previousTargets)) {
      if (!target || typeof target !== 'object' || target.source === 'evidence_reducer') continue;
      const migration = {
        word_id: objectId,
        ordinal,
        word,
        target_kind: target.target_kind || 'lexical',
        target_id: target.target_id || null,
        target_locator: target.target_locator || null,
        target_revision: target.target_id ? null : (target.target_revision || sourceHash || null),
        source: 'depth_plus',
        outcome: 'ADDED',
        observed_at: target.observed_at || state.lastSeenAt || new Date().toISOString()
      };
      migration.event_id = `migration:${legacyEventId(migration)}`;
      ledger = appendEvidenceEvent(ledger, migration).ledger;
    }
    saveLedger(ledger);
    const activeTargets = compileRepairTargets(ledger).filter((target) => target.word_id === objectId);
    state.repairTargets = Object.fromEntries(activeTargets.map((target) => {
      const key = target.target_id || `${target.target_kind}:${target.target_locator || ''}`;
      const previous = previousTargets[key] || {};
      return [key, {
        target_kind: target.target_kind,
        target_id: target.target_id || null,
        target_locator: target.target_locator || null,
        target_revision: target.target_revision || null,
        label: previous.label || target.word || word,
        source: 'evidence_reducer',
        outcome: 'ADDED',
        observed_at: target.last_evidence_at || target.activated_at || new Date().toISOString()
      }];
    }));

    const targetFromButton = (button) => {
      const kind = button.getAttribute('data-target-kind') || 'lexical';
      const id = button.getAttribute('data-target-id') || '';
      const locator = button.getAttribute('data-target-locator') || '';
      const label = button.getAttribute('data-target-label') || '';
      const key = id || `${kind}:${locator}`;
      return { key, kind, id, locator, label };
    };

    const save = () => {
      state.lastSeenAt = new Date().toISOString();
      state.meta = { word_id: objectId, ordinal, word, source_hash: sourceHash };
      saveJson(storageKey, state);
    };

    const render = () => {
      if (front) front.hidden = Boolean(state.revealed);
      if (details) details.hidden = !state.revealed;
      repairButtons.forEach((button, index) => {
        const target = targetFromButton(button);
        const active = Boolean(state.repairTargets[target.key]);
        button.classList.toggle('selected', active);
        button.setAttribute('aria-pressed', String(active));
        button.textContent = active ? '✓' : '+';
        const row = button.closest('[data-vocab-target-row]');
        row?.classList.toggle('keyboard-target', index === selectedIndex);
        row?.classList.toggle('repair-selected', active);
      });
      const count = Object.keys(state.repairTargets).length;
      if (stateLabel) stateLabel.textContent = state.revealed ? (count ? `${count} Repair` : 'Scanned') : 'Ready';
      if (repairSummary) repairSummary.textContent = count ? `${count} 个具体分支处于 Repair 状态；当天新增项会进入 Return Packet。` : '当前没有加入 Repair 的分支。';
    };

    const openCard = () => { state.revealed = true; save(); render(); };
    reveal?.addEventListener('click', openCard);

    const speak = (lang = 'en-US') => {
      if (!('speechSynthesis' in window) || !word) return;
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(word);
      utterance.lang = lang;
      utterance.rate = 0.86;
      window.speechSynthesis.speak(utterance);
    };
    root.querySelectorAll('[data-vocab-speak]').forEach((button) => button.addEventListener('click', () => speak(button.getAttribute('data-vocab-speak') || 'en-US')));

    const setRepair = (button, active) => {
      const target = targetFromButton(button);
      if (active) {
        state.repairTargets[target.key] = {
          target_kind: target.kind,
          target_id: target.id || null,
          target_locator: target.locator || null,
          target_revision: target.id ? null : (sourceHash || null),
          label: target.label,
          source: 'depth_plus',
          outcome: 'ADDED',
          study_day: localStudyDay(),
          observed_at: new Date().toISOString()
        };
      } else {
        delete state.repairTargets[target.key];
      }
      save();
      render();
    };

    repairButtons.forEach((button, index) => button.addEventListener('click', () => {
      selectedIndex = index;
      const target = targetFromButton(button);
      setRepair(button, !state.repairTargets[target.key]);
    }));

    const selectByDelta = (delta) => {
      if (!repairButtons.length) return;
      selectedIndex = selectedIndex < 0 ? (delta > 0 ? 0 : repairButtons.length - 1) : (selectedIndex + delta + repairButtons.length) % repairButtons.length;
      repairButtons[selectedIndex]?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      render();
    };

    const activeRepairButton = () => selectedIndex >= 0 ? repairButtons[selectedIndex] : null;
    const buildReturnPacket = () => {
      const studyDay = localStudyDay();
      return { schema: 'kianos.lexical.return_packet.v1', study_day: studyDay, exported_at: new Date().toISOString(), events: exportReturnEvents(readLedger(), studyDay, eventLocalDay) };
    };

    root.querySelector('[data-vocab-copy-packet]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget;
      const packet = JSON.stringify(buildReturnPacket(), null, 2);
      try { await navigator.clipboard.writeText(packet); button.textContent = 'Copied'; }
      catch { window.prompt('Copy Return Packet', packet); }
      window.setTimeout(() => { button.textContent = 'Copy Return Packet'; }, 1200);
    });

    root.addEventListener('click', () => {
      document.querySelectorAll('[data-local-port="vocabulary"]').forEach((candidate) => candidate.removeAttribute('data-vocab-keyboard-active'));
      root.setAttribute('data-vocab-keyboard-active', 'true');
    });

    const onKeydown = (event) => {
      if (document.querySelector('[data-vocab-challenge-runtime][data-challenge-active="true"]')) return;
      const roots = [...document.querySelectorAll('[data-local-port="vocabulary"]')];
      const activeRoot = document.querySelector('[data-local-port="vocabulary"][data-vocab-keyboard-active="true"]') || roots[0];
      if (activeRoot !== root) return;
      const target = event.target;
      if (target instanceof HTMLElement && target.closest('input,textarea,select,[contenteditable="true"]')) return;
      if (event.key.toLowerCase() === 's') { event.preventDefault(); speak('en-US'); return; }
      if (!state.revealed && (event.code === 'Space' || event.key === 'Enter')) { event.preventDefault(); openCard(); return; }
      if (!state.revealed) return;
      if (event.key === 'ArrowDown') { event.preventDefault(); selectByDelta(1); return; }
      if (event.key === 'ArrowUp') { event.preventDefault(); selectByDelta(-1); return; }
      if (event.key === 'ArrowRight' || event.key === '+') {
        const button = activeRepairButton();
        if (button) { event.preventDefault(); setRepair(button, true); }
        return;
      }
      if (event.key === 'ArrowLeft') {
        const button = activeRepairButton();
        if (button) { event.preventDefault(); setRepair(button, false); }
      }
    };
    document.addEventListener('keydown', onKeydown);

    save();
    render();
  };

  document.querySelectorAll('[data-local-port="vocabulary"]').forEach(initializeVocabularyRoot);
</script>