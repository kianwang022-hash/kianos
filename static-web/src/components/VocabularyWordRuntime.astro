---
const { answer } = Astro.props;
const card = answer.record || {};
const core = card.core_concept || {};
const senses = Array.isArray(card.senses) ? card.senses : [];
const constructions = Array.isArray(card.constructions) ? card.constructions : [];
const relations = Array.isArray(card.semantic_neighbors) ? card.semantic_neighbors : [];

const posCode = (value = '') => {
  const pos = String(value).toLowerCase();
  if (pos.startsWith('verb') || pos === 'v') return 'V';
  if (pos.startsWith('adj') || pos === 'a') return 'A';
  if (pos.startsWith('noun') || pos === 'n') return 'N';
  if (pos.startsWith('adv')) return 'ADV';
  if (pos.startsWith('prep')) return 'PREP';
  return String(value || 'S').toUpperCase();
};

const posOrder = ['V', 'A', 'N', 'ADV', 'PREP'];
const posCounts = senses.reduce((acc, sense) => {
  const code = posCode(sense.pos);
  acc[code] = (acc[code] || 0) + 1;
  return acc;
}, {});
const recallParts = Object.entries(posCounts)
  .sort(([a], [b]) => {
    const ai = posOrder.indexOf(a);
    const bi = posOrder.indexOf(b);
    return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi) || a.localeCompare(b);
  })
  .map(([code, count]) => `${count}${code}`);

const escapeRegExp = (value = '') => String(value).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const skeletonize = (value = '') => {
  const text = String(value || '').trim();
  if (!text) return '';
  const word = String(card.word || '').trim();
  if (!word) return text;
  return text.replace(new RegExp(`\\b${escapeRegExp(word)}\\b`, 'gi'), '~');
};

const patternPrompts = [];
for (const construction of constructions) {
  const pattern = skeletonize(construction.pattern || construction.label_en || '');
  if (pattern) patternPrompts.push(pattern);
}
for (const sense of senses) {
  for (const collocation of (sense.collocations || [])) {
    if (collocation.exam_value !== 'fixed_pattern') continue;
    const pattern = skeletonize(collocation.phrase || '');
    if (pattern) patternPrompts.push(pattern);
  }
}
const recallPatterns = [...new Set(patternPrompts)].slice(0, 4);
---
<section class="portedVocabRuntime portedVocabRuntimeV2" data-local-port="vocabulary" data-vocab-word={card.word} data-vocab-object={answer.objectId} data-vocab-ordinal={answer.ordinal} data-vocab-source-hash={answer.sourceHash}>
  <header class="portedVocabPreviewBar">
    <a href="/">‹ Vocabulary</a>
    <div><span>Study · Depth</span><b>{card.word}</b><small data-vocab-state-label>Ready · 1 / 1</small></div>
    <div class="portedVocabPreviewActions">
      <button type="button" data-vocab-speak="en-US" aria-label="美式发音">US</button>
      <button type="button" data-vocab-speak="en-GB" aria-label="英式发音">UK</button>
    </div>
  </header>

  <section class="portedVocabStudySheet">
    <section class="portedVocabWordFront" data-vocab-front>
      <span>Recall Map</span>
      <h2>{card.word}</h2>
      <div class="portedVocabRecallMap">
        <strong>{recallParts.length ? recallParts.join(' · ') : 'Core'}</strong>
        {recallPatterns.map((pattern) => <code>{pattern}</code>)}
      </div>
      <p>先把你能想到的高价值含义和结构在脑中搜一遍，再翻开核对。</p>
      <button type="button" class="portedPrimaryAction" data-vocab-reveal>Reveal</button>
    </section>

    <div data-vocab-details hidden>
      <header class="portedVocabWordHeader">
        <div>
          <span>Depth Reveal</span>
          <h2>{card.word}</h2>
          <p>{core.core_meaning_en || '—'}</p>
        </div>
        <aside>
          <b>{recallParts.length ? recallParts.join(' · ') : 'Core'}</b>
          <small>会的直接扫过；慢 / 模糊 / 漏掉的分支按 +</small>
        </aside>
      </header>

      <div class="portedVocabBody" data-vocab-body>
        <main class="portedVocabMeaningColumn">
          <section class="portedVocabCoreSense">
            <header><span>CORE / WORD FEEL</span><small>mental compression</small></header>
            <div>
              <p>{core.core_meaning_cn || '—'}</p>
              <strong>{core.mental_model_cn || core.core_meaning_en || '—'}</strong>
            </div>
          </section>

          <div class="portedVocabSenseList" data-vocab-repair-list>
            {senses.map((sense, index) => (
              <section data-vocab-target-row>
                <header>
                  <span>{posCode(sense.pos)}</span>
                  <button
                    type="button"
                    data-vocab-repair
                    data-target-kind="sense"
                    data-target-id={sense.sense_id || ''}
                    data-target-locator={`record.senses[${index}]`}
                    data-target-label={`${sense.definition_cn || sense.definition_en || card.word}`}
                    aria-pressed="false"
                  >+</button>
                </header>
                <div>
                  <p>{sense.definition_cn || '—'}</p>
                  <strong>{sense.definition_en || '—'}</strong>
                  {(sense.collocations || []).length > 0 && (
                    <ul>
                      {sense.collocations.map((item, collocationIndex) => (
                        <li data-vocab-target-row>
                          <b>{item.phrase}</b><span>{item.meaning_cn}</span>
                          <button
                            type="button"
                            data-vocab-repair
                            data-target-kind="collocation"
                            data-target-id={item.collocation_id || ''}
                            data-target-locator={`record.senses[${index}].collocations[${collocationIndex}]`}
                            data-target-label={`${item.phrase || card.word}`}
                            aria-pressed="false"
                          >+</button>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </section>
            ))}
          </div>
        </main>

        <aside class="portedVocabEvidenceColumn">
          {constructions.length > 0 && <section>
            <header><span>Constructions</span><small>only when Current owns them</small></header>
            <div class="portedVocabEvidenceList">
              {constructions.map((item, index) => (
                <article data-vocab-target-row>
                  <b>{item.pattern || item.label_en}</b>
                  <p>{item.meaning_cn || item.definition_cn || '—'}</p>
                  <button
                    type="button"
                    data-vocab-repair
                    data-target-kind="construction"
                    data-target-id={item.fact_id || item.construction_id || ''}
                    data-target-locator={`record.constructions[${index}]`}
                    data-target-label={`${item.pattern || item.label_en || card.word}`}
                    aria-pressed="false"
                  >+</button>
                </article>
              ))}
            </div>
          </section>}

          {relations.length > 0 && <section>
            <header><span>Contrast / Confusable</span><small>Relation owner</small></header>
            <div class="portedVocabEvidenceList">
              {relations.map((relation, index) => (
                <article data-vocab-target-row>
                  <b>{relation.target_expression || relation.target_word || relation.relation_type}</b>
                  {relation.shared_core && <p>{relation.shared_core}</p>}
                  {Object.values(relation.difference_axes || {}).map((value) => <p>{String(value)}</p>)}
                  {(relation.boundaries || []).map((boundary) => <p>{boundary}</p>)}
                  {relation.learning_note && <p>{relation.learning_note}</p>}
                  <button
                    type="button"
                    data-vocab-repair
                    data-target-kind="relation"
                    data-target-id={relation.relation_id || ''}
                    data-target-locator={`record.semantic_neighbors[${index}]`}
                    data-target-label={`${relation.target_expression || relation.target_word || relation.relation_type || card.word}`}
                    aria-pressed="false"
                  >+</button>
                </article>
              ))}
            </div>
          </section>}

          <section class="portedVocabLocalNote">
            <header><span>Repair</span><small>local-only until exported</small></header>
            <p data-vocab-repair-summary>当前没有加入 Repair 的分支。</p>
            <button type="button" data-vocab-copy-packet>Copy Return Packet</button>
          </section>
        </aside>
      </div>
    </div>

    <footer class="portedVocabFoot">
      <span>Space Reveal · ↑↓ 选择拓展 · → / + 加入 Repair · ← 撤销 · S 发音</span>
      <details><summary>Source</summary><code>{answer.sourcePath}</code><code>sha256:{String(answer.sourceHash).slice(0, 16)}</code></details>
    </footer>
  </section>
</section>

<script>
  const root = document.querySelector('[data-local-port="vocabulary"]');
  if (root) {
    const word = root.getAttribute('data-vocab-word') || '';
    const objectId = root.getAttribute('data-vocab-object') || word;
    const ordinal = Number(root.getAttribute('data-vocab-ordinal') || 0);
    const sourceHash = root.getAttribute('data-vocab-source-hash') || '';
    const storageKey = `kianos-vocabulary-astro-v2:${objectId}`;
    const front = root.querySelector('[data-vocab-front]');
    const details = root.querySelector('[data-vocab-details]');
    const reveal = root.querySelector('[data-vocab-reveal]');
    const stateLabel = root.querySelector('[data-vocab-state-label]');
    const repairSummary = root.querySelector('[data-vocab-repair-summary]');
    const repairButtons = [...root.querySelectorAll('[data-vocab-repair]')];
    let selectedIndex = -1;
    let state = { revealed: false, repairTargets: {}, lastSeenAt: '' };

    try { state = { ...state, ...(JSON.parse(localStorage.getItem(storageKey) || 'null') || {}) }; } catch {}
    if (!state.repairTargets || typeof state.repairTargets !== 'object') state.repairTargets = {};

    const targetFromButton = (button) => {
      const kind = button.getAttribute('data-target-kind') || 'lexical';
      const id = button.getAttribute('data-target-id') || '';
      const locator = button.getAttribute('data-target-locator') || '';
      const label = button.getAttribute('data-target-label') || '';
      const key = id || `${kind}:${locator}`;
      return { key, kind, id, locator, label };
    };

    const save = () => {
      state.lastSeenAt = new Date().toISOString();
      try { localStorage.setItem(storageKey, JSON.stringify(state)); } catch {}
    };

    const render = () => {
      if (front) front.hidden = Boolean(state.revealed);
      if (details) details.hidden = !state.revealed;
      repairButtons.forEach((button, index) => {
        const target = targetFromButton(button);
        const active = Boolean(state.repairTargets[target.key]);
        button.classList.toggle('selected', active);
        button.setAttribute('aria-pressed', String(active));
        button.textContent = active ? '✓' : '+';
        const row = button.closest('[data-vocab-target-row]');
        row?.classList.toggle('keyboard-target', index === selectedIndex);
        row?.classList.toggle('repair-selected', active);
      });
      const count = Object.keys(state.repairTargets).length;
      if (stateLabel) stateLabel.textContent = state.revealed ? `${count ? `${count} Repair` : 'Scanned'} · 1 / 1` : 'Ready · 1 / 1';
      if (repairSummary) repairSummary.textContent = count ? `${count} 个具体分支已加入 Repair；将进入 Return Packet。` : '当前没有加入 Repair 的分支。';
    };

    const openCard = () => {
      state.revealed = true;
      save();
      render();
    };
    reveal?.addEventListener('click', openCard);

    const speak = (lang = 'en-US') => {
      if (!('speechSynthesis' in window) || !word) return;
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(word);
      utterance.lang = lang;
      utterance.rate = 0.86;
      window.speechSynthesis.speak(utterance);
      root.querySelectorAll('[data-vocab-speak]').forEach((button) => {
        const active = button.getAttribute('data-vocab-speak') === lang;
        button.classList.toggle('speaking', active);
        window.setTimeout(() => button.classList.remove('speaking'), 700);
      });
    };
    root.querySelectorAll('[data-vocab-speak]').forEach((button) => button.addEventListener('click', () => speak(button.getAttribute('data-vocab-speak') || 'en-US')));

    const setRepair = (button, active) => {
      const target = targetFromButton(button);
      if (active) {
        state.repairTargets[target.key] = {
          target_kind: target.kind,
          target_id: target.id || null,
          target_locator: target.locator || null,
          label: target.label,
          source: 'depth_plus',
          outcome: 'ADDED',
          observed_at: new Date().toISOString()
        };
      } else {
        delete state.repairTargets[target.key];
      }
      save();
      render();
    };

    repairButtons.forEach((button, index) => button.addEventListener('click', () => {
      selectedIndex = index;
      const target = targetFromButton(button);
      setRepair(button, !state.repairTargets[target.key]);
    }));

    const selectByDelta = (delta) => {
      if (!repairButtons.length) return;
      selectedIndex = selectedIndex < 0 ? (delta > 0 ? 0 : repairButtons.length - 1) : (selectedIndex + delta + repairButtons.length) % repairButtons.length;
      repairButtons[selectedIndex]?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      render();
    };

    const activeRepairButton = () => selectedIndex >= 0 ? repairButtons[selectedIndex] : null;

    const buildReturnPacket = () => ({
      schema: 'kianos.lexical.return_packet.v1',
      study_day: new Date().toLocaleDateString('en-CA'),
      exported_at: new Date().toISOString(),
      word_id: objectId,
      ordinal,
      word,
      source_hash: sourceHash,
      events: Object.values(state.repairTargets)
    });

    root.querySelector('[data-vocab-copy-packet]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget;
      const packet = JSON.stringify(buildReturnPacket(), null, 2);
      try {
        await navigator.clipboard.writeText(packet);
        button.textContent = 'Copied';
      } catch {
        window.prompt('Copy Return Packet', packet);
      }
      window.setTimeout(() => { button.textContent = 'Copy Return Packet'; }, 1200);
    });

    document.addEventListener('keydown', (event) => {
      const target = event.target;
      if (target instanceof HTMLElement && target.closest('input,textarea,select,[contenteditable="true"]')) return;
      if (event.key.toLowerCase() === 's') { event.preventDefault(); speak('en-US'); return; }
      if (!state.revealed && (event.code === 'Space' || event.key === 'Enter')) { event.preventDefault(); openCard(); return; }
      if (!state.revealed) return;
      if (event.key === 'ArrowDown') { event.preventDefault(); selectByDelta(1); return; }
      if (event.key === 'ArrowUp') { event.preventDefault(); selectByDelta(-1); return; }
      if (event.key === 'ArrowRight' || event.key === '+') {
        const button = activeRepairButton();
        if (button) { event.preventDefault(); setRepair(button, true); }
        return;
      }
      if (event.key === 'ArrowLeft') {
        const button = activeRepairButton();
        if (button) { event.preventDefault(); setRepair(button, false); }
      }
    });

    render();
  }
</script>
