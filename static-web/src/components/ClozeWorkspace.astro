---
const { item } = Astro.props;
const storageKey = `kianos-cloze-attempt-v1:${item.objectId}`;
const sourceLabel = [item.year, item.code, item.section].filter(Boolean).join(' · ');

function optionEntries(options) {
  if (Array.isArray(options)) return options.map((value, index) => ({ label: String.fromCharCode(65 + index), text: typeof value === 'string' ? value : String(value?.text || value?.content || value?.value || '') }));
  if (!options || typeof options !== 'object') return [];
  return Object.entries(options).map(([label, value]) => ({ label, text: typeof value === 'string' ? value : String(value?.text || value?.content || value?.value || '') }));
}
---
<section class="clozeRuntime" data-objective-root data-objective-task="cloze" data-objective-object={item.objectId} data-objective-storage-key={storageKey} data-objective-answers-ready="false">
  <header class="clozeRuntimeHeader">
    <div>
      <span>Cloze · Slot Constraint → Best Fit</span>
      <h2 data-objective-title>{item.title}</h2>
      <small data-objective-source-label>{sourceLabel || item.objectId}</small>
    </div>
    <div class="clozeProgress"><strong data-cloze-progress>1 / {item.questions.length}</strong><span>整篇完成后统一提交</span></div>
  </header>

  <section class="clozeLayout">
    <article class="clozePassage" data-objective-material>
      <header><span>PASSAGE</span><strong>上下文始终保持可见</strong></header>
      {item.material.length ? item.material.map((block) => <p data-objective-material-block>{block.text}</p>) : <p data-objective-material-block class="clozeMaterialFallback">Current set 没有可投影的整篇正文；请不要把这组退化成孤立词汇题。</p>}
    </article>

    <aside class="clozeDecision">
      <div class="clozeDecisionTop">
        <div><span>ACTIVE SLOT</span><strong data-cloze-active-label>Blank 1</strong></div>
        <button type="button" data-cloze-uncertain>Uncertain</button>
      </div>

      <div class="clozeQuestions">
        {item.questions.map((question, index) => {
          const id = String(question.id || question.question_id || `q${index + 1}`);
          const options = optionEntries(question.options);
          return (
            <section class="clozeQuestion" data-objective-question={id} data-objective-index={index}>
              <p data-objective-prompt>{question.prompt || `Blank ${index + 1}`}</p>
              <div class="clozeOptions">
                {options.map((option) => (
                  <button type="button" data-cloze-option data-objective-option data-value={option.label}>
                    <b>{option.label}</b><span>{option.text}</span>
                  </button>
                ))}
              </div>
              <p class="clozeFormal" data-objective-formal hidden>Formal answer: <strong></strong></p>
            </section>
          );
        })}
      </div>

      <div class="clozeNav">
        <button type="button" data-cloze-prev>← 上一空</button>
        <div class="clozeDots" data-cloze-dots>
          {item.questions.map((_, index) => <button type="button" data-cloze-jump={index} aria-label={`Blank ${index + 1}`}>{index + 1}</button>)}
        </div>
        <button type="button" data-cloze-next>下一空 →</button>
      </div>

      <div class="clozeSubmitRow">
        <span data-cloze-answer-count>0 / {item.questions.length} answered</span>
        <button type="button" class="clozeSubmit" data-objective-submit>提交整篇</button>
      </div>

      <div class="clozeResult" data-objective-result-summary hidden>
        <strong data-objective-score></strong>
        <span data-objective-result-note></span>
      </div>
    </aside>
  </section>
</section>

<script>
  document.querySelectorAll('[data-objective-root][data-objective-task="cloze"]').forEach((root) => {
    if (!(root instanceof HTMLElement)) return;
    const storageKey = root.getAttribute('data-objective-storage-key') || '';
    const rows = [...root.querySelectorAll('[data-objective-question]')];
    const jumps = [...root.querySelectorAll('[data-cloze-jump]')];
    const uncertainButton = root.querySelector('[data-cloze-uncertain]');
    const submit = root.querySelector('[data-objective-submit]');
    let active = 0;

    const normalizeAnswer = (value) => Array.isArray(value)
      ? value.map(String)
      : value === null || value === undefined || value === '' ? [] : [String(value)];
    const idOf = (row) => row.getAttribute('data-objective-question') || '';
    const now = () => new Date().toISOString();
    const blankState = () => ({
      schema: 'kianos.english.cloze_attempt.v1',
      objectId: root.getAttribute('data-objective-object') || '',
      startedAt: now(),
      submittedAt: null,
      submitted: false,
      answers: {},
      uncertain: [],
      trajectory: {},
      results: {}
    });
    const read = () => {
      try {
        const saved = JSON.parse(localStorage.getItem(storageKey) || 'null');
        return saved?.objectId === root.getAttribute('data-objective-object') ? { ...blankState(), ...saved } : blankState();
      } catch { return blankState(); }
    };
    let state = read();
    const save = () => localStorage.setItem(storageKey, JSON.stringify(state));

    const formalOf = (row) => {
      try { return normalizeAnswer(JSON.parse(row.getAttribute('data-answer') || '""')); }
      catch { return []; }
    };

    const render = () => {
      rows.forEach((row, index) => {
        // Every blank stays visible; active only determines navigation / Uncertain focus.
        row.hidden = false;
        row.classList.toggle('is-current', index === active);
        const id = idOf(row);
        row.querySelectorAll('[data-cloze-option]').forEach((button) => {
          const value = button.getAttribute('data-value') || '';
          button.classList.toggle('selected', state.answers?.[id] === value);
          button.toggleAttribute('disabled', Boolean(state.submitted));
          button.classList.remove('result-correct', 'result-wrong');
          if (state.submitted) {
            const formal = formalOf(row);
            button.classList.toggle('result-correct', formal.includes(value));
            button.classList.toggle('result-wrong', state.answers?.[id] === value && !formal.includes(value));
          }
        });
        const formalLine = row.querySelector('[data-objective-formal]');
        if (formalLine instanceof HTMLElement) {
          formalLine.hidden = !state.submitted;
          const strong = formalLine.querySelector('strong');
          if (strong) strong.textContent = formalOf(row).join(', ') || '—';
        }
      });
      jumps.forEach((jump, index) => {
        const id = idOf(rows[index]);
        jump.classList.toggle('active', index === active);
        jump.classList.toggle('answered', Boolean(state.answers?.[id]));
        jump.classList.toggle('uncertain', (state.uncertain || []).includes(id));
        jump.classList.toggle('wrong', state.submitted && ['wrong', 'unanswered'].includes(state.results?.[id]));
      });
      const id = idOf(rows[active]);
      if (uncertainButton instanceof HTMLButtonElement) {
        uncertainButton.classList.toggle('active', (state.uncertain || []).includes(id));
        uncertainButton.disabled = Boolean(state.submitted);
      }
      const label = root.querySelector('[data-cloze-active-label]');
      const progress = root.querySelector('[data-cloze-progress]');
      if (label) label.textContent = `Blank ${active + 1}`;
      if (progress) progress.textContent = `${active + 1} / ${rows.length}`;
      const count = Object.values(state.answers || {}).filter(Boolean).length;
      const countNode = root.querySelector('[data-cloze-answer-count]');
      if (countNode) countNode.textContent = `${count} / ${rows.length} answered`;
      root.querySelector('[data-cloze-prev]')?.toggleAttribute('disabled', active <= 0);
      root.querySelector('[data-cloze-next]')?.toggleAttribute('disabled', active >= rows.length - 1);
      if (submit instanceof HTMLButtonElement) {
        submit.hidden = Boolean(state.submitted);
      }
      const result = root.querySelector('[data-objective-result-summary]');
      if (result instanceof HTMLElement) {
        result.hidden = !state.submitted;
        if (state.submitted) {
          const score = Object.values(state.results || {}).filter((value) => value === 'correct').length;
          const scoreNode = result.querySelector('[data-objective-score]');
          const note = result.querySelector('[data-objective-result-note]');
          if (scoreNode) scoreNode.textContent = `${score} / ${rows.length}`;
          if (note) note.textContent = score === rows.length && !(state.uncertain || []).length
            ? 'Clean pass · 不强制复盘。'
            : '整篇进入 review；先看共同根因，再决定局部 repair。';
        }
      }
    };

    rows.forEach((row, index) => {
      const focusRow = () => { if (active !== index) { active = index; render(); } };
      row.addEventListener('pointerdown', focusRow);
      row.addEventListener('focusin', focusRow);
      row.querySelectorAll('[data-cloze-option]').forEach((button) => {
        button.addEventListener('click', () => {
          if (state.submitted) return;
          active = rows.indexOf(row);
          const id = idOf(row);
          const answer = button.getAttribute('data-value') || '';
          state.answers[id] = answer;
          state.trajectory[id] ||= [];
          const last = state.trajectory[id][state.trajectory[id].length - 1]?.answer;
          if (last !== answer) state.trajectory[id].push({ answer, at: now() });
          save();
          render();
        });
      });
    });

    uncertainButton?.addEventListener('click', () => {
      if (state.submitted) return;
      const id = idOf(rows[active]);
      const uncertain = new Set(state.uncertain || []);
      uncertain.has(id) ? uncertain.delete(id) : uncertain.add(id);
      state.uncertain = [...uncertain];
      save();
      render();
    });
    root.querySelector('[data-cloze-prev]')?.addEventListener('click', () => { active = Math.max(0, active - 1); render(); rows[active]?.scrollIntoView({ block: 'nearest' }); });
    root.querySelector('[data-cloze-next]')?.addEventListener('click', () => { active = Math.min(rows.length - 1, active + 1); render(); rows[active]?.scrollIntoView({ block: 'nearest' }); });
    jumps.forEach((jump, index) => jump.addEventListener('click', () => { active = index; render(); rows[active]?.scrollIntoView({ block: 'nearest' }); }));

    submit?.addEventListener('click', () => {
      if (state.submitted || root.getAttribute('data-objective-answers-ready') !== 'true') return;
      const results = {};
      rows.forEach((row) => {
        const id = idOf(row);
        const selected = String(state.answers?.[id] || '');
        const formal = formalOf(row);
        results[id] = !selected ? 'unanswered' : formal.includes(selected) ? 'correct' : 'wrong';
      });
      state.results = results;
      state.submitted = true;
      state.submittedAt = now();
      save();
      render();
      root.dispatchEvent(new CustomEvent('kianos:objective-submitted', { bubbles: true }));
    });

    render();
    if (state.submitted) root.dispatchEvent(new CustomEvent('kianos:objective-submitted', { bubbles: true }));
  });
</script>

<style>
  .clozeRuntime{max-width:76rem;margin:0 auto;display:grid;gap:12px}.clozeRuntimeHeader{display:flex;justify-content:space-between;gap:20px;align-items:end;padding:18px 20px;border:1px solid var(--study-line);border-radius:14px;background:#fff}.clozeRuntimeHeader>div:first-child{display:grid;gap:4px}.clozeRuntimeHeader span,.clozePassage header span,.clozeDecisionTop span{font-size:9px;font-weight:850;letter-spacing:.08em;color:var(--study-green)}.clozeRuntimeHeader h2{margin:0;font-size:22px}.clozeRuntimeHeader small{color:var(--study-faint)}.clozeProgress{display:grid;text-align:right}.clozeProgress strong{font-size:16px}.clozeProgress span{color:var(--study-muted);font-size:10px}.clozeLayout{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(320px,.65fr);gap:12px;align-items:start}.clozePassage,.clozeDecision{border:1px solid var(--study-line);border-radius:14px;background:#fff;box-shadow:var(--study-shadow)}.clozePassage{padding:24px 26px;position:sticky;top:76px}.clozePassage header{display:flex;justify-content:space-between;gap:12px;margin-bottom:18px}.clozePassage header strong{font-size:11px;color:var(--study-muted)}.clozePassage p{margin:0 0 1em;font-size:15px;line-height:1.9}.clozeMaterialFallback{color:var(--study-muted)}.clozeDecision{padding:18px;display:grid;gap:14px}.clozeDecisionTop{display:flex;align-items:center;justify-content:space-between;gap:12px}.clozeDecisionTop>div{display:grid;gap:3px}.clozeDecisionTop button{padding:6px 9px;border:1px solid var(--study-line);border-radius:8px;background:#fff;color:var(--study-muted);font:inherit;font-size:10px}.clozeDecisionTop button.active{border-color:var(--study-green);background:var(--study-green-soft);color:var(--study-green)}.clozeQuestion>p:first-child{margin:0 0 12px;font-size:13px;line-height:1.65}.clozeOptions{display:grid;gap:7px}.clozeOptions button{display:grid;grid-template-columns:24px 1fr;gap:8px;text-align:left;align-items:start;padding:10px;border:1px solid var(--study-line);border-radius:9px;background:#fff;color:inherit;font:inherit;cursor:pointer}.clozeOptions button b{color:var(--study-green)}.clozeOptions button span{font-size:12px;line-height:1.55}.clozeOptions button.selected{border-color:var(--study-green);background:var(--study-green-soft)}.clozeOptions button.result-correct{outline:2px solid var(--study-green)}.clozeOptions button.result-wrong{border-style:dashed}.clozeFormal{margin:10px 0 0;color:var(--study-muted);font-size:10px}.clozeNav{display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:center}.clozeNav>button,.clozeDots button{border:1px solid var(--study-line);border-radius:8px;background:#fff;color:inherit;font:inherit;font-size:10px;padding:7px 9px}.clozeDots{display:flex;gap:4px;overflow:auto;padding:2px}.clozeDots button{min-width:28px;padding:6px}.clozeDots button.active{border-color:var(--study-green)}.clozeDots button.answered{background:var(--study-green-soft)}.clozeDots button.uncertain{font-weight:900}.clozeDots button.wrong{border-style:dashed}.clozeSubmitRow{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:12px;border-top:1px solid var(--study-line)}.clozeSubmitRow span{color:var(--study-muted);font-size:10px}.clozeSubmit{padding:9px 14px;border:1px solid var(--study-green);border-radius:9px;background:var(--study-green);color:#fff;font:inherit;font-weight:850}.clozeResult{padding:12px;border-radius:10px;background:var(--study-green-soft);display:grid;gap:3px}.clozeResult strong{font-size:18px}.clozeResult span{font-size:10px;color:var(--study-muted)}@media(max-width:900px){.clozeLayout{grid-template-columns:1fr}.clozePassage{position:static}.clozeRuntimeHeader{align-items:start}.clozeProgress{display:none}}@media(max-width:560px){.clozeRuntimeHeader{display:grid}.clozeNav{grid-template-columns:1fr 1fr}.clozeDots{grid-column:1/-1;grid-row:1}.clozePassage{padding:18px}.clozeDecision{padding:14px}}
</style>
