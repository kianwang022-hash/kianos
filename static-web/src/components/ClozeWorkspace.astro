---
const { item } = Astro.props;
const storageKey = `kianos-cloze-attempt-v1:${item.objectId}`;
const sourceLabel = [item.year, item.code, item.section].filter(Boolean).join(' · ');

function optionEntries(options) {
  if (Array.isArray(options)) return options.map((value, index) => ({ label: String.fromCharCode(65 + index), text: typeof value === 'string' ? value : String(value?.text || value?.content || value?.value || '') }));
  if (!options || typeof options !== 'object') return [];
  return Object.entries(options).map(([label, value]) => ({ label, text: typeof value === 'string' ? value : String(value?.text || value?.content || value?.value || '') }));
}
---
<section class="clozeRuntime" data-objective-root data-english-source-hash={item.sourceHashes?.renderedObject} data-objective-task="cloze" data-objective-object={item.objectId} data-objective-storage-key={storageKey} data-objective-answers-ready="false">
  <script type="application/json" data-english-task-snapshot set:html={JSON.stringify({evidence:{source_kind:item.sourceKind||'official',evidence_role:item.context?.evidence_role||null,semantic_source_hash:item.sourceHashes?.semanticSource||item.sourceHashes?.renderedObject||null},material:item.material,context:item.context,questions:item.questions.map(({id,ordinal,prompt,options})=>({id,ordinal,prompt,options}))}).replace(/</g, "\\u003c")}></script>
  <header class="clozeRuntimeHeader">
    <div>
      <span>Cloze · Slot Constraint → Best Fit</span>
      <h2 data-objective-title>{item.title}</h2>
      <small data-objective-source-label>{sourceLabel || item.objectId}</small>
    </div>
    <div class="clozeProgress"><strong data-cloze-progress>1 / {item.questions.length}</strong><span>整篇完成后统一提交</span></div>
  </header>

  <section class="clozeLayout">
    <article class="clozePassage" data-objective-material>
      <header><span>PASSAGE</span><strong>完整语境 · 独立滚动</strong></header>
      {item.material.length ? item.material.map((block) => <p data-objective-material-block>{block.text}</p>) : <p data-objective-material-block class="clozeMaterialFallback">Current set 没有可投影的整篇正文；请不要把这组退化成孤立词汇题。</p>}
    </article>

    <aside class="clozeDecision">
      <div class="clozeDecisionTop">
        <div><span>QUESTION SHEET</span><strong data-cloze-active-label>Blank 1</strong></div>
        <button type="button" data-cloze-uncertain>Uncertain</button>
      </div>

      <div class="clozeQuestions">
        {item.questions.map((question, index) => {
          const id = String(question.id || question.question_id || `q${index + 1}`);
          const options = optionEntries(question.options);
          return (
            <section class="clozeQuestion" data-objective-question={id} data-objective-index={index}>
              <p data-objective-prompt>{question.prompt || `Blank ${index + 1}`}</p>
              <div class="clozeOptions">
                {options.map((option) => (
                  <button type="button" data-cloze-option data-objective-option data-value={option.label}>
                    <b>{option.label}</b><span>{option.text}</span>
                  </button>
                ))}
              </div>
              <p class="clozeFormal" data-objective-formal hidden>Formal answer: <strong></strong></p>
            </section>
          );
        })}
      </div>

      <div class="clozeNav" aria-hidden="true">
        <button type="button" data-cloze-prev>← 上一空</button>
        <div class="clozeDots" data-cloze-dots>
          {item.questions.map((_, index) => <button type="button" data-cloze-jump={index} aria-label={`Blank ${index + 1}`}>{index + 1}</button>)}
        </div>
        <button type="button" data-cloze-next>下一空 →</button>
      </div>

      <div class="clozeSubmitRow">
        <span data-cloze-answer-count>0 / {item.questions.length} answered</span>
        <button type="button" class="clozeSubmit" data-objective-submit>提交整篇</button>
      </div>

      <div class="clozeResult" data-objective-result-summary hidden>
        <strong data-objective-score></strong>
        <span data-objective-result-note></span>
      </div>
    </aside>
  </section>
</section>

<script>
  import { initClozeRuntime } from '../lib/clozeRuntime.mjs';
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(() => {
    document.querySelectorAll('[data-objective-root][data-objective-task="cloze"]').forEach((root) => {
      if (root instanceof HTMLElement && !root.hasAttribute('data-generated-cloze')) initClozeRuntime(root);
    });
  });
</script>
