---
const { sets = [], learningHref = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const payload = JSON.stringify(sets).replace(/</g, '\\u003c');
const first = sets[0];
---
<section class="readingHome" data-reading-home data-base={base}>
  <section class="readingHomeHero">
    <div>
      <span>Reading A · Current</span>
      <h2>完整做一篇，按需复盘</h2>
      <p>选择阅读材料，完整作答后再核对；已经理解的题不必反复复盘。</p>
    </div>
    <aside><strong>{sets.length} passages</strong><span>Current source only</span><span>held-out evidence stays clean</span></aside>
  </section>

  {learningHref && (
    <a class="readingLearnEntry" href={learningHref}>
      <div><span>First Learning</span><strong>先建立 Reading A 的做题框架</strong></div>
      <p>需要时查阅题意、证据与选项如何核对；会的部分直接跳过。</p>
      <b>学习框架 →</b>
    </a>
  )}

  <section class="readingHomeGrid">
    <a class="readingContinue" data-reading-continue href={first ? `${base}reading/${encodeURIComponent(first.id)}/` : `${base}reading/`}>
      <span data-catalog-entry-label>打开一篇</span>
      <strong data-reading-continue-title>{first?.title || '开始 Reading A'}</strong>
      <p data-reading-continue-meta>{first ? `第 1 / ${sets.length} 篇` : 'Current Reading 暂不可用'}</p>
    </a>

    <section class="readingBrowse">
      <header><div><span>Navigate</span><strong>Current passages</strong></div><input type="search" data-reading-search placeholder="搜索年份 / passage id / 标题" /></header>
      <div data-reading-results></div>
    </section>
  </section>

  <script type="application/json" data-reading-catalog set:html={payload}></script>
</section>

<script>
  const root = document.querySelector('[data-reading-home]');
  if (root instanceof HTMLElement) {
    const base = root.getAttribute('data-base') || '/';
    let sets = [];
    try { sets = JSON.parse(root.querySelector('[data-reading-catalog]')?.textContent || '[]'); } catch {}
    const hrefFor = (id) => `${base}reading/${encodeURIComponent(id)}/`;

    let last = null;
    try { last = JSON.parse(localStorage.getItem('kianos-reading-last-location-v1') || 'null'); } catch {}
    const continueLink = root.querySelector('[data-reading-continue]');
    if (last?.id && continueLink instanceof HTMLAnchorElement && sets.some((item) => item.id === last.id)) {
      const fallback = hrefFor(last.id);
      try {
        const target = new URL(last.href || fallback, location.origin);
        continueLink.href = target.origin === location.origin && !target.username && !target.password
          && [fallback, fallback.slice(0,-1)].includes(target.pathname)
          ? target.pathname + target.search + target.hash : fallback;
      } catch { continueLink.href = fallback; }
      root.querySelector('[data-catalog-entry-label]').textContent = '最近查看';
      const title = root.querySelector('[data-reading-continue-title]');
      const meta = root.querySelector('[data-reading-continue-meta]');
      if (title) title.textContent = last.title || last.id;
      if (meta) meta.textContent = `${last.paperId || 'Reading A'} · 第 ${last.position || '?'} / ${last.total || sets.length} 篇 · 最近打开`;
    }

    const results = root.querySelector('[data-reading-results]');
    const render = (query = '') => {
      if (!results) return;
      const q = String(query || '').trim().toLowerCase();
      const visible = sets.filter((item) => {
        if (!q) return true;
        return [item.id, item.title, item.paperId].some((value) => String(value || '').toLowerCase().includes(q));
      }).slice(0, q ? 40 : 16);
      results.replaceChildren();
      visible.forEach((item) => {
        const link = document.createElement('a');
        link.href = hrefFor(item.id);
        const copy = document.createElement('div');
        const title = document.createElement('strong'); title.textContent = item.title || item.id;
        const meta = document.createElement('span'); meta.textContent = `${item.paperId || 'English I'} · ${item.id}`;
        copy.append(title, meta);
        const pos = document.createElement('small'); pos.textContent = `${item.position} / ${item.total}`;
        link.append(copy, pos);
        results.appendChild(link);
      });
      if (!visible.length) {
        const empty = document.createElement('p');
        empty.textContent = '没有匹配的 Current passage。';
        results.appendChild(empty);
      }
    };
    root.querySelector('[data-reading-search]')?.addEventListener('input', (event) => render(event.currentTarget.value || ''));
    render();
  }
</script>

<style>
  .readingHome{max-width:72rem;margin:0 auto;display:grid;gap:12px}.readingHomeHero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px;align-items:end;padding:24px 26px;border:1px solid var(--study-line);border-radius:16px;background:#fff;box-shadow:var(--study-shadow)}.readingHomeHero>div>span,.readingBrowse header span,.readingContinue>span,.readingLearnEntry span{color:var(--study-green);font-size:9px;font-weight:850;letter-spacing:.08em;text-transform:uppercase}.readingHomeHero h2{margin:5px 0 8px;font-size:27px}.readingHomeHero p{max-width:74ch;margin:0;color:var(--study-muted);font-size:13px;line-height:1.7}.readingHomeHero aside{display:grid;gap:3px;padding-left:20px;border-left:1px solid var(--study-line)}.readingHomeHero aside strong{color:var(--study-green)}.readingHomeHero aside span{color:var(--study-faint);font-size:10px}
  .readingLearnEntry{display:grid;grid-template-columns:minmax(220px,.8fr) minmax(0,1.3fr) auto;gap:18px;align-items:center;padding:14px 18px;border:1px solid #cfe2d8;border-radius:13px;background:var(--study-green-soft);color:inherit;text-decoration:none}.readingLearnEntry>div{display:grid;gap:3px}.readingLearnEntry strong{font-size:14px}.readingLearnEntry p{margin:0;color:var(--study-muted);font-size:11px;line-height:1.55}.readingLearnEntry b{color:var(--study-green);font-size:11px;white-space:nowrap}
  .readingHomeGrid{display:grid;grid-template-columns:minmax(260px,.72fr) minmax(0,1.28fr);gap:12px}.readingContinue,.readingBrowse{padding:20px;border:1px solid var(--study-line);border-radius:14px;background:#fff;color:inherit}.readingContinue{display:grid;align-content:start;gap:6px;text-decoration:none}.readingContinue strong{font-size:22px;line-height:1.35}.readingContinue p{margin:0;color:var(--study-muted);font-size:12px;line-height:1.6}.readingBrowse header{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-bottom:12px}.readingBrowse header>div{display:grid;gap:3px}.readingBrowse header input{width:min(280px,48%);padding:8px 10px;border:1px solid var(--study-line);border-radius:9px;font:inherit}.readingBrowse [data-reading-results]{display:grid;gap:5px}.readingBrowse [data-reading-results]>a{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:9px 10px;border-radius:9px;color:inherit;text-decoration:none}.readingBrowse [data-reading-results]>a:hover{background:var(--study-green-soft)}.readingBrowse [data-reading-results] div{display:grid;gap:2px;min-width:0}.readingBrowse [data-reading-results] strong{font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.readingBrowse [data-reading-results] span,.readingBrowse [data-reading-results] small{color:var(--study-faint);font-size:9px}.readingBrowse [data-reading-results]>p{color:var(--study-muted);font-size:12px}
  @media(max-width:820px){.readingHomeHero,.readingHomeGrid,.readingLearnEntry{grid-template-columns:1fr}.readingHomeHero aside{padding:12px 0 0;border-left:0;border-top:1px solid var(--study-line)}.readingBrowse header{align-items:stretch;flex-direction:column}.readingBrowse header input{width:100%;box-sizing:border-box}}
</style>