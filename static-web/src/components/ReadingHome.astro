---
const { sets = [], learningHref = '' } = Astro.props;
const base = import.meta.env.BASE_URL;
const payload = JSON.stringify(sets).replace(/</g, '\\u003c');
const first = sets[0];
const readingTitle = (item) => item?.year
  ? `${item.year} · 阅读理解 · 第 ${item.paperPosition || '?'} 篇`
  : '阅读理解';
---
<section class="readingHome" data-reading-home data-base={base}>
  <section class="readingHomeHero">
    <div>
      <span>READING A · 阅读理解</span>
      <h2>按篇做真题</h2>
      <p>继续上次做到的位置，或按年份选择一篇。提交后再进入答案与复盘。</p>
    </div>
    <aside><strong>{sets.length} 篇真题</strong><span>按年份选择 · 每次一篇</span></aside>
  </section>

  {learningHref && (
    <a class="readingLearnEntry" href={learningHref}>
      <div><span>方法框架</span><strong>第一次系统学 Reading A</strong></div>
      <p>先把题目需求、决定性证据、选项判断和最终裁决的做题链学清楚；平时做题直接进入真题。</p>
      <b>进入方法框架 →</b>
    </a>
  )}

  <section class="readingHomeGrid">
    <a class="readingContinue" data-reading-continue href={first ? `${base}reading/${encodeURIComponent(first.id)}/` : `${base}reading/`}>
      <span>继续做题</span>
      <strong data-reading-continue-title>{first ? readingTitle(first) : '开始一篇阅读'}</strong>
      <p data-reading-continue-meta>{first ? '从真题列表开始' : '当前没有可用真题'}</p>
    </a>

    <section class="readingBrowse">
      <header>
        <div><span>选择真题</span><strong>按年份浏览</strong></div>
        <input type="search" data-reading-search placeholder="搜索年份" />
      </header>
      <div data-reading-results></div>
    </section>
  </section>

  <script type="application/json" data-reading-catalog set:html={payload}></script>
</section>

<script>
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(() => {

  const root = document.querySelector('[data-reading-home]');
  if (root instanceof HTMLElement) {
    const base = root.getAttribute('data-base') || '/';
    let sets = [];
    try { sets = JSON.parse(root.querySelector('[data-reading-catalog]')?.textContent || '[]'); } catch {}
    const hrefFor = (id) => `${base}reading/${encodeURIComponent(id)}/`;
    const learnerTitle = (item) => item?.year
      ? `${item.year} · 阅读理解 · 第 ${item.paperPosition || '?'} 篇`
      : '阅读理解';

    let last = null;
    try { last = JSON.parse(localStorage.getItem('kianos-reading-last-location-v1') || 'null'); } catch {}
    const continueLink = root.querySelector('[data-reading-continue]');
    const matched = last?.id ? sets.find((item) => item.id === last.id) : null;
    if (matched && continueLink instanceof HTMLAnchorElement) {
      continueLink.href = last.href || hrefFor(last.id);
      const title = root.querySelector('[data-reading-continue-title]');
      const meta = root.querySelector('[data-reading-continue-meta]');
      if (title) title.textContent = learnerTitle(matched);
      if (meta) meta.textContent = '最近打开 · 从这里继续';
    }

    const results = root.querySelector('[data-reading-results]');
    const render = (query = '') => {
      if (!results) return;
      const q = String(query || '').trim().toLowerCase();
      const visible = sets.filter((item) => {
        if (!q) return true;
        return [item.year, item.paperId, item.title].some((value) => String(value || '').toLowerCase().includes(q));
      }).slice(0, q ? 40 : 20);
      results.replaceChildren();
      visible.forEach((item) => {
        const link = document.createElement('a');
        link.href = hrefFor(item.id);
        const copy = document.createElement('div');
        const title = document.createElement('strong');
        title.textContent = item.year ? String(item.year) : '英语一';
        const meta = document.createElement('span');
        meta.textContent = `第 ${item.paperPosition || '?'} 篇`;
        copy.append(title, meta);
        const pos = document.createElement('small');
        pos.textContent = '进入 →';
        link.append(copy, pos);
        results.appendChild(link);
      });
      if (!visible.length) {
        const empty = document.createElement('p');
        empty.textContent = '没有匹配的年份。';
        results.appendChild(empty);
      }
    };
    root.querySelector('[data-reading-search]')?.addEventListener('input', (event) => render(event.currentTarget.value || ''));
    render();
  }

  });
</script>

<style>
  .readingHome{max-width:72rem;margin:0 auto;display:grid;gap:14px}
  .readingHomeHero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:28px;align-items:end;padding:20px 22px;border:1px solid var(--study-line);border-radius:14px;background:#fff}
  .readingHomeHero>div>span,.readingBrowse header span,.readingContinue>span,.readingLearnEntry span{color:var(--study-green);font-size:14px;font-weight:800;letter-spacing:.04em}
  .readingHomeHero h2{margin:6px 0 8px;font-size:28px}
  .readingHomeHero p{max-width:70ch;margin:0;color:var(--study-muted);font-size:16px;line-height:1.65}
  .readingHomeHero aside{display:grid;gap:5px;padding-left:22px;border-left:1px solid var(--study-line)}
  .readingHomeHero aside strong{font-size:18px;color:var(--study-green)}
  .readingHomeHero aside span{color:var(--study-muted);font-size:14px}
  .readingLearnEntry{display:grid;grid-template-columns:minmax(220px,.8fr) minmax(0,1.3fr) auto;gap:18px;align-items:center;padding:14px 18px;border:1px solid #cfe2d8;border-radius:12px;background:var(--study-green-soft);color:inherit;text-decoration:none}
  .readingLearnEntry>div{display:grid;gap:4px}.readingLearnEntry strong{font-size:17px}.readingLearnEntry p{margin:0;color:var(--study-muted);font-size:15px;line-height:1.55}.readingLearnEntry b{color:var(--study-green);font-size:15px;white-space:nowrap}
  .readingHomeGrid{display:grid;grid-template-columns:minmax(300px,.72fr) minmax(0,1.28fr);gap:14px}
  .readingContinue,.readingBrowse{padding:20px;border:1px solid var(--study-line);border-radius:14px;background:#fff;color:inherit}
  .readingContinue{display:grid;align-content:start;gap:8px;text-decoration:none}.readingContinue strong{font-size:22px;line-height:1.35}.readingContinue p{margin:0;color:var(--study-muted);font-size:15px;line-height:1.6}
  .readingBrowse header{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-bottom:12px}.readingBrowse header>div{display:grid;gap:4px}.readingBrowse header strong{font-size:17px}
  .readingBrowse header input{width:min(250px,44%);padding:9px 11px;border:1px solid var(--study-line);border-radius:9px;font:inherit;font-size:15px}
  .readingBrowse [data-reading-results]{display:grid}.readingBrowse [data-reading-results]>a{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:52px;padding:8px 10px;border-bottom:1px solid var(--study-line);color:inherit;text-decoration:none}
  .readingBrowse [data-reading-results]>a:last-child{border-bottom:0}.readingBrowse [data-reading-results]>a:hover{background:var(--study-green-soft)}
  .readingBrowse [data-reading-results] div{display:grid;gap:3px;min-width:0}.readingBrowse [data-reading-results] strong{font-size:16px}.readingBrowse [data-reading-results] span{color:var(--study-muted);font-size:14px}.readingBrowse [data-reading-results] small{color:var(--study-green);font-size:14px;font-weight:700}.readingBrowse [data-reading-results]>p{color:var(--study-muted);font-size:15px}

  :global(.readingBrowse [data-reading-results]>a){display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:52px;padding:8px 10px;border-bottom:1px solid var(--study-line);color:inherit;text-decoration:none}
  :global(.readingBrowse [data-reading-results]>a:last-child){border-bottom:0}
  :global(.readingBrowse [data-reading-results]>a:hover){background:var(--study-green-soft)}
  :global(.readingBrowse [data-reading-results]>a>div){display:grid;gap:2px;min-width:0}
  :global(.readingBrowse [data-reading-results]>a strong){font-size:17px;line-height:1.2}
  :global(.readingBrowse [data-reading-results]>a span){color:var(--study-muted);font-size:14px}
  :global(.readingBrowse [data-reading-results]>a small){color:var(--study-green);font-size:14px;font-weight:700}
  :global(.readingBrowse [data-reading-results]>p){color:var(--study-muted);font-size:15px}
  @media(max-width:820px){.readingHomeHero,.readingHomeGrid,.readingLearnEntry{grid-template-columns:1fr}.readingHomeHero aside{padding:12px 0 0;border-left:0;border-top:1px solid var(--study-line)}.readingBrowse header{align-items:stretch;flex-direction:column}.readingBrowse header input{width:100%;box-sizing:border-box}}
</style>
