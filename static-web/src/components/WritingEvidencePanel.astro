---
const { task } = Astro.props;
const payload = JSON.stringify(task).replace(/</g, '\\u003c');
---
<section class="writingEvidencePanel" data-writing-evidence-panel data-task-id={task.id} hidden>
  <header>
    <div>
      <span>可选 · 后续验证</span>
      <h2>这篇刚好测试了一个既有可复用问题</h2>
      <p>只有当前这篇刚好碰到以前反复出现的问题时，这里才会出现。它不是新的学习任务，也不会阻塞下一篇。</p>
    </div>
    <aside data-evidence-summary></aside>
  </header>

  <section class="writingEvidenceStatus" data-evidence-status></section>

  <section class="writingEvidenceTarget" data-evidence-target hidden>
    <div class="writingEvidenceTargetHead">
      <span data-target-state>待验证</span>
      <strong data-target-label></strong>
     </div>
    <p data-target-demand></p>
 
    <div class="writingEvidenceActions">
      <button type="button" class="primary" data-copy-transfer>可选：让 Chat 判断这次表现</button>
      <small data-copy-transfer-status>只判断这个问题，不重做整篇复盘。</small>
    </div>

    <label class="writingEvidenceField">
      <span>Chat 返回</span>
      <textarea rows="10" data-transfer-return placeholder="把 Chat 返回的判断粘贴到这里…"></textarea>
    </label>
    <div class="writingEvidenceActions">
      <button type="button" class="primary" data-import-transfer>应用 Chat 判断 →</button>
      <small data-import-transfer-status>这次判断只保存在本机。</small>
    </div>
  </section>

  <details class="writingEvidenceLedger">
    <summary>本机验证记录</summary>
    <div data-ledger-list></div>
  </details>

  <script type="application/json" data-writing-evidence-task set:html={payload}></script>
</section>

<script>
  import {
    createWritingEvidenceLedger,
    summarizeWritingEvidenceLedger,
    admitWritingTransferCandidate,
    listEligibleWritingTransferTargets,
    buildWritingTransferCheckPacket,
    validateWritingTransferReturn,
    applyWritingTransferReturn
  } from '../lib/writingEvidenceModel.mjs';

  const evidenceRoot = document.querySelector('[data-writing-evidence-panel]');
  if (evidenceRoot instanceof HTMLElement) {
    let task = null;
    try { task = JSON.parse(evidenceRoot.querySelector('[data-writing-evidence-task]')?.textContent || 'null'); } catch {}
    if (!task?.id) throw new Error('WRITING_EVIDENCE_TASK_PAYLOAD_MISSING');

    const ledgerKey = 'kianos-writing-evidence-v1';
    const runtimeKey = `kianos-writing-runtime-v1:${task.id}`;
    let ledger = loadLedger();
    let activeTarget = null;

    function loadLedger() {
      let saved = null;
      try { saved = JSON.parse(localStorage.getItem(ledgerKey) || 'null'); } catch {}
      return createWritingEvidenceLedger(saved);
    }

    function loadRuntimeRecord() {
      try { return JSON.parse(localStorage.getItem(runtimeKey) || 'null'); }
      catch { return null; }
    }

    function persistLedger() {
      try { localStorage.setItem(ledgerKey, JSON.stringify(ledger)); } catch {}
    }

    function setText(selector, text) {
      const node = evidenceRoot.querySelector(selector);
      if (node) node.textContent = text;
    }

    function setStatus(selector, text, bad = false) {
      const node = evidenceRoot.querySelector(selector);
      if (!node) return;
      node.textContent = text;
      node.classList.toggle('isBad', bad);
    }

    function syncCurrentAdmission(record) {
      if (!record || record.state !== 'TRANSFER_PENDING' || !record.transferCandidate) return;
      const before = JSON.stringify(ledger);
      ledger = admitWritingTransferCandidate(ledger, task, record);
      if (JSON.stringify(ledger) !== before) persistLedger();
    }

    function renderLedger() {
      const summary = summarizeWritingEvidenceLedger(ledger);
      setText('[data-evidence-summary]', `${summary.pending} 待验证 · ${summary.closed} 已完成`);
      const list = evidenceRoot.querySelector('[data-ledger-list]');
      if (!(list instanceof HTMLElement)) return;
      list.replaceChildren();
      ledger.targets.forEach((target) => {
        const row = document.createElement('div');
        row.className = 'writingEvidenceLedgerRow';
        const state = document.createElement('span'); state.textContent = String(target.status || '').toLowerCase() === 'closed' ? '已完成' : '待验证';
        const label = document.createElement('strong'); label.textContent = target.label;
        const meta = document.createElement('small'); meta.textContent = `${target.events.length} 次后续记录`;
        row.append(state, label, meta);
        list.append(row);
      });
    }

    function render() {
      evidenceRoot.hidden = true;
      ledger = loadLedger();
      const record = loadRuntimeRecord();
      syncCurrentAdmission(record);
      renderLedger();
      activeTarget = null;

      const targetPanel = evidenceRoot.querySelector('[data-evidence-target]');
      if (!(targetPanel instanceof HTMLElement)) return;
      targetPanel.hidden = true;

      if (!record?.firstDraft) return;
      if (!['PASS_ACCEPTABLE', 'REPAIR_COMPLETE', 'TRANSFER_PENDING'].includes(record.state)) return;

      const eligible = listEligibleWritingTransferTargets(ledger, task, record);
      if (!eligible.length) return;

      activeTarget = eligible[0];
      evidenceRoot.hidden = false;
      targetPanel.hidden = false;
      setStatus('[data-evidence-status]', `这篇刚好可以顺手检查 ${eligible.length} 个以前的问题；现在不判断也不会阻塞下一篇。`);
      setText('[data-target-state]', String(activeTarget.status || '').toLowerCase() === 'closed' ? '已完成' : '待验证');
      setText('[data-target-label]', activeTarget.label);
            setText('[data-target-demand]', activeTarget.underlyingDemand);
          }

    async function copyActivePacket() {
      try {
        const record = loadRuntimeRecord();
        if (!activeTarget || !record) throw new Error('WRITING_TRANSFER_NO_ACTIVE_TARGET');
        const packet = buildWritingTransferCheckPacket(task, record, activeTarget);
        const text = `KIANOS_WRITING_TRANSFER_CHECK_PACKET\nJudge only the named reusable Writing target under the embedded contract. Return only one JSON object matching the requested schema. Do not rewrite the essay.\n\n${JSON.stringify(packet, null, 2)}`;
        try {
          await navigator.clipboard.writeText(text);
          setStatus('[data-copy-transfer-status]', '已复制。把整包发给 Chat。');
        } catch {
          setStatus('[data-copy-transfer-status]', '浏览器未允许自动复制；请从弹窗手动复制。', true);
          window.prompt('Copy this packet', text);
        }
      } catch (error) {
        setStatus('[data-copy-transfer-status]', error instanceof Error ? error.message : String(error), true);
      }
    }

    function importActiveReturn() {
      try {
        const record = loadRuntimeRecord();
        if (!activeTarget || !record) throw new Error('WRITING_TRANSFER_NO_ACTIVE_TARGET');
        const box = evidenceRoot.querySelector('[data-transfer-return]');
        const raw = box instanceof HTMLTextAreaElement ? box.value : '';
        const packet = buildWritingTransferCheckPacket(task, record, activeTarget);
        const parsed = validateWritingTransferReturn(raw, packet);
        ledger = applyWritingTransferReturn(ledger, activeTarget.targetId, parsed);
        persistLedger();
        if (box instanceof HTMLTextAreaElement) box.value = '';
        const message = parsed.verdict === 'CLOSE'
          ? '这次表现已经足够确认这个问题稳定。'
          : parsed.verdict === 'REOPEN'
            ? '这次表现说明这个问题仍不稳定，保留到以后继续观察。'
            : parsed.verdict === 'IRRELEVANT'
              ? '这篇与这个问题无关，不做结论。'
              : '这次表现已记录，后续再根据新作文判断。';
        setStatus('[data-import-transfer-status]', message);
        render();
      } catch (error) {
        setStatus('[data-import-transfer-status]', error instanceof Error ? error.message : String(error), true);
      }
    }

    evidenceRoot.querySelector('[data-copy-transfer]')?.addEventListener('click', copyActivePacket);
    evidenceRoot.querySelector('[data-import-transfer]')?.addEventListener('click', importActiveReturn);

    const stageLabel = document.querySelector('[data-writing-runtime] [data-stage-label]');
    if (stageLabel) new MutationObserver(() => render()).observe(stageLabel, { childList: true, subtree: true, characterData: true });
    window.addEventListener('focus', render);
    render();
  }
</script>

<style>
  .writingEvidencePanel{max-width:84rem;margin:12px auto 0;padding:18px 20px;border:1px solid var(--study-line);border-radius:14px;background:#fff;box-shadow:var(--study-shadow);display:grid;gap:12px}.writingEvidencePanel[hidden]{display:none}.writingEvidencePanel>header{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:20px;align-items:start}.writingEvidencePanel>header>div{display:grid;gap:4px}.writingEvidencePanel>header span{font-size:9px;font-weight:850;letter-spacing:.08em;text-transform:uppercase;color:var(--study-green)}.writingEvidencePanel h2{margin:0;font-size:17px}.writingEvidencePanel header p{margin:0;max-width:82ch;color:var(--study-muted);font-size:10px;line-height:1.6}.writingEvidencePanel header aside{font-size:9px;color:var(--study-faint);white-space:nowrap}.writingEvidenceStatus{padding:10px 12px;border-radius:10px;background:#fbfdfc;color:var(--study-muted);font-size:10px;line-height:1.55}.writingEvidenceTarget{padding:13px;border:1px solid #cfe2d8;border-radius:11px;background:var(--study-green-soft)}.writingEvidenceTargetHead{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.writingEvidenceTargetHead>span{font-size:8px;font-weight:850;color:var(--study-green)}.writingEvidenceTargetHead>strong{font-size:12px}.writingEvidenceTargetHead code{font-size:8px;color:var(--study-faint)}.writingEvidenceTarget>p{margin:7px 0 3px;font-size:11px;line-height:1.55}.writingEvidenceTarget>small{font-size:8px;color:var(--study-faint)}.writingEvidenceActions{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin-top:11px}.writingEvidenceActions button{padding:8px 11px;border:1px solid var(--study-green);border-radius:9px;background:var(--study-green);color:#fff;font:inherit;font-size:9px;font-weight:800;cursor:pointer}.writingEvidenceActions small{font-size:8px;color:var(--study-faint)}.writingEvidenceActions small.isBad{color:#a24832}.writingEvidenceField{display:grid;gap:5px;margin-top:11px}.writingEvidenceField>span{font-size:9px;font-weight:850}.writingEvidenceField textarea{width:100%;box-sizing:border-box;padding:10px 11px;border:1px solid var(--study-line);border-radius:9px;background:#fff;font:inherit;font-size:10px;line-height:1.55}.writingEvidenceLedger summary{cursor:pointer;font-size:9px;font-weight:800}.writingEvidenceLedger [data-ledger-list]{display:grid;gap:6px;margin-top:8px}.writingEvidenceLedgerRow{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:8px;align-items:center;padding:8px 10px;border:1px solid var(--study-line);border-radius:9px}.writingEvidenceLedgerRow span{font-size:8px;color:var(--study-green);font-weight:850}.writingEvidenceLedgerRow strong{font-size:9px}.writingEvidenceLedgerRow small{font-size:8px;color:var(--study-faint)}@media(max-width:820px){.writingEvidencePanel>header{grid-template-columns:1fr}.writingEvidencePanel header aside{white-space:normal}.writingEvidenceLedgerRow{grid-template-columns:1fr}}
</style>
