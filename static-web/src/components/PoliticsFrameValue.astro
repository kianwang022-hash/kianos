---
import PoliticsFrameMap from './PoliticsFrameMap.astro';
const { value, role = '' } = Astro.props;
const omitted = new Set(['id','natural_unit_id','source_refs','source_evidence','learning_priority']);
const labels = {role:'身份',not_role:'不是',upstream:'上承',downstream:'下接',learning_rule:'把握方式',parallel_boundary:'并列边界',meaning:'',detail:'',text:'',fact:'',relation:'',problem:'',items:'',groups:'',name:'',title:'',label:'',left:'',right:'',distinction:''};
const heading = value && !Array.isArray(value) && typeof value === 'object' ? value.title || value.name || value.label : '';
const maps = Array.isArray(value?.nodes) && Array.isArray(value?.edges);
---
{value == null ? null : typeof value === 'string' || typeof value === 'number' ? <p>{value}</p> : Array.isArray(value) ? (
  <div class:list={['frameValues', {parallel: ['mechanism','parallel_theory_responses','teaching_relations','framework_maps'].includes(role)}]}>
    {value.map(item=><div class="frameValue"><Astro.self value={item} role={role} /></div>)}
  </div>
) : maps ? (
  <PoliticsFrameMap value={value} />
) : value?.steps ? (
  <section><h3>{heading}</h3><ol class="frameSteps">{value.steps.map(s=><li><Astro.self value={s.text ?? s} /></li>)}</ol></section>
) : (
  <section class:list={['frameObject', {boundary: value.left && value.right}]}>
    {heading && <h3>{heading}</h3>}
    {Object.entries(value).filter(([key])=>!omitted.has(key)&&!['title','name','label'].includes(key)).map(([key,v])=><div class={`frameField field-${key}`}>
      {(labels[key] ?? key) && <strong class="frameFieldLabel">{labels[key] ?? key}</strong>}
      <Astro.self value={v} role={key} />
    </div>)}
  </section>
)}
