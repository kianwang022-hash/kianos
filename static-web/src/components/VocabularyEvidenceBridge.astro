---
const { nextHref = '/vocabulary/' } = Astro.props;
---
<div data-vocab-evidence-bridge data-next-href={nextHref} hidden></div>
<style is:global>
  .lexicalRoutingControls{display:flex;flex-wrap:wrap;gap:.55rem;justify-content:center;margin-top:.9rem}.lexicalRoutingControls button{border:1px solid currentColor;background:transparent;color:inherit;border-radius:.75rem;padding:.62rem .82rem;font:inherit;cursor:pointer}.lexicalRoutingControls button[data-route="known"],.lexicalRoutingControls button[data-route="mastered"]{font-weight:700}.lexicalRoutingHint{display:block;margin-top:.45rem;text-align:center;font-size:.8rem;opacity:.62}
</style>
<script>
  import { LEXICAL_LEDGER_STORAGE_KEY, appendEvidenceEvent, compileRepairTargets, emptyLexicalLedger, legacyEventId, normalizeLexicalLedger } from '../lib/lexicalEvidence.mjs';
  import {
    DEFAULT_DAILY_NEW_LIMIT,
    LEXICAL_INTAKE_STORAGE_KEY,
    LEXICAL_ROUTING_STORAGE_KEY,
    LEXICAL_SETTINGS_STORAGE_KEY,
    introducedCountForDay,
    introductionDayFor,
    localLexicalDay,
    normalizeLexicalIntake,
    normalizeLexicalSettings,
    registerLexicalIntroduction
  } from '../lib/lexicalSettings.mjs';
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(() => {

  const bridge=document.querySelector('[data-vocab-evidence-bridge]');
  const root=document.querySelector('[data-local-port="vocabulary"]');
  if(bridge instanceof HTMLElement&&root instanceof HTMLElement){
    const nextHref=bridge.getAttribute('data-next-href')||'/vocabulary/';
    const word=root.getAttribute('data-vocab-word')||'';
    const objectId=root.getAttribute('data-vocab-object')||word;
    const ordinal=Number(root.getAttribute('data-vocab-ordinal')||0);
    const sourceHash=root.getAttribute('data-vocab-source-hash')||'';
    const requestedMode=new URLSearchParams(location.search).get('mode');
    const mode=['lookup','repair'].includes(String(requestedMode||''))?String(requestedMode):'study';
    root.dataset.vocabMode=mode;
    const readOnlyLookup=mode==='lookup';
    const storageKey=`kianos-vocabulary-astro-v2:${objectId}`;
    const readJson=(key,fallback)=>{try{return JSON.parse(localStorage.getItem(key)||'null')||fallback}catch{return fallback}};
    const saveJson=(key,value)=>{try{localStorage.setItem(key,JSON.stringify(value))}catch{}};
    const readLedger=()=>normalizeLexicalLedger(readJson(LEXICAL_LEDGER_STORAGE_KEY,emptyLexicalLedger()));
    const saveLedger=(ledger)=>saveJson(LEXICAL_LEDGER_STORAGE_KEY,ledger);
    const browserEventId=(prefix='browser')=>`${prefix}:${globalThis.crypto?.randomUUID?.()||`${Date.now()}-${Math.random().toString(36).slice(2)}`}`;
    const syncProjection=(ledger)=>{const existing=readJson(storageKey,{revealed:false,repairTargets:{},lastSeenAt:'',meta:{word_id:objectId,ordinal,word,source_hash:sourceHash}});const previous=existing?.repairTargets&&typeof existing.repairTargets==='object'?existing.repairTargets:{};const active=compileRepairTargets(ledger).filter((target)=>target.word_id===objectId);existing.repairTargets=Object.fromEntries(active.map((target)=>{const key=target.target_id||`${target.target_kind}:${target.target_locator||''}`;const prior=previous[key]||{};return [key,{target_kind:target.target_kind,target_id:target.target_id||null,target_locator:target.target_locator||null,target_revision:target.target_revision||null,label:prior.label||target.word||word,source:'evidence_reducer',outcome:'ADDED',observed_at:target.last_evidence_at||target.activated_at||new Date().toISOString()}]}));existing.meta={...(existing.meta||{}),word_id:objectId,ordinal,word,source_hash:sourceHash};existing.lastSeenAt=new Date().toISOString();saveJson(storageKey,existing)};
    const append=(event)=>{const result=appendEvidenceEvent(readLedger(),event);saveLedger(result.ledger);syncProjection(result.ledger);window.dispatchEvent(new CustomEvent('kianos:lexical-evidence-changed'));return result};
    const targetEventFromButton=(button,overrides={})=>{const targetKind=button.getAttribute('data-target-kind')||'lexical';const targetId=button.getAttribute('data-target-id')||null;const targetLocator=button.getAttribute('data-target-locator')||null;return {event_id:browserEventId('depth'),word_id:objectId,ordinal,word,target_kind:targetKind,target_id:targetId,target_locator:targetLocator,target_revision:targetId?null:(sourceHash||null),source:'depth_plus',outcome:'ADDED',observed_at:new Date().toISOString(),...overrides}};
    const existingState=readJson(storageKey,null);
    if(!readOnlyLookup&&existingState?.repairTargets&&typeof existingState.repairTargets==='object'){
      let ledger=readLedger();
      for(const target of Object.values(existingState.repairTargets)){
        if(!target||typeof target!=='object'||target.source==='evidence_reducer')continue;
        const migration={word_id:objectId,ordinal,word,target_kind:target.target_kind||'lexical',target_id:target.target_id||null,target_locator:target.target_locator||null,target_revision:target.target_id?null:(target.target_revision||sourceHash||null),source:'depth_plus',outcome:'ADDED',observed_at:target.observed_at||existingState.lastSeenAt||new Date().toISOString()};
        migration.event_id=`migration:${legacyEventId(migration)}`;ledger=appendEvidenceEvent(ledger,migration).ledger;
      }
      saveLedger(ledger);syncProjection(ledger);
    }
    const front=root.querySelector('[data-vocab-front]');
    const reveal=root.querySelector('[data-vocab-reveal]');
    const routeButtons=[...root.querySelectorAll('[data-vocab-route]')];
    const undoButton=root.querySelector('[data-vocab-undo]');
    const emptyRouting=()=>({schema:'kianos.lexical.card_routing.v1',history:[],latest_by_word:{}});
    const readRouting=()=>{const value=readJson(LEXICAL_ROUTING_STORAGE_KEY,emptyRouting());return value?.schema==='kianos.lexical.card_routing.v1'?value:emptyRouting()};
    const saveRouting=(value)=>saveJson(LEXICAL_ROUTING_STORAGE_KEY,value);
    const readSettings=()=>normalizeLexicalSettings(readJson(LEXICAL_SETTINGS_STORAGE_KEY,{daily_new_limit:DEFAULT_DAILY_NEW_LIMIT}));
    const readIntake=()=>normalizeLexicalIntake(readJson(LEXICAL_INTAKE_STORAGE_KEY,null));
    const saveIntake=(value)=>saveJson(LEXICAL_INTAKE_STORAGE_KEY,value);
    const homeHref=()=>{const url=new URL('../',location.href);url.searchParams.set('limit','reached');return url.href};
    const newWordBlocked=()=>{
      if(mode!=='study'||introductionDayFor(readIntake(),objectId))return false;
      return introducedCountForDay(readIntake(),localLexicalDay())>=readSettings().daily_new_limit;
    };
    if(newWordBlocked())location.replace(homeHref());
    const updateUndoState=()=>{if(undoButton instanceof HTMLButtonElement)undoButton.disabled=readRouting().history.length===0};

    const recordRouting=(route)=>{
      const now=new Date().toISOString();
      const routing=readRouting();
      const event={
        event_id:browserEventId('route'),
        word_id:objectId,
        ordinal,
        word,
        route:String(route||'').toUpperCase(),
        observed_at:now,
        return_href:location.pathname
      };
      routing.history=[...routing.history,event].slice(-300);
      routing.latest_by_word={...(routing.latest_by_word||{}),[objectId]:event};
      saveRouting(routing);
      updateUndoState();
      return event;
    };

    const undoRouting=()=>{
      const routing=readRouting();
      const last=routing.history.at(-1);
      if(!last)return;
      routing.history=routing.history.slice(0,-1);
      const previous=[...routing.history].reverse().find((item)=>item.word_id===last.word_id)||null;
      routing.latest_by_word={...(routing.latest_by_word||{})};
      if(previous)routing.latest_by_word[last.word_id]=previous;
      else delete routing.latest_by_word[last.word_id];
      saveRouting(routing);
      if(!previous){
        const intake=readIntake();
        if(intake.introduced?.[last.word_id]){
          delete intake.introduced[last.word_id];
          saveIntake(intake);
        }
      }
      updateUndoState();
      if(last.return_href)location.href=last.return_href;
    };

    const submitRoute=(route)=>{
      if(mode!=='study')return;
      const routingBefore=readRouting();
      const prior=routingBefore.latest_by_word?.[objectId]||null;
      let intake=readIntake();
      let introducedNow=false;
      if(!introductionDayFor(intake,objectId)){
        const registered=registerLexicalIntroduction(intake,objectId,prior?.observed_at||new Date());
        intake=registered.intake;
        introducedNow=registered.added&&!prior&&registered.studyDay===localLexicalDay();
        if(registered.added)saveIntake(intake);
      }
      recordRouting(route);
      const reached=introducedNow&&introducedCountForDay(intake,localLexicalDay())>=readSettings().daily_new_limit;
      if(reached){
        const nextOrdinal=String(nextHref||'').match(/\/vocabulary\/(\d+)\/?/i)?.[1]||'';
        if(nextOrdinal)try{localStorage.setItem('kianos-vocabulary-last-ordinal',nextOrdinal)}catch{}
        location.href=homeHref();
        return;
      }
      location.href=nextHref;
    };

    routeButtons.forEach((button)=>button.addEventListener('click',()=>{
      submitRoute(button.getAttribute('data-vocab-route')||'');
    }));
    undoButton?.addEventListener('click',undoRouting);
    updateUndoState();

    // The legacy WordRuntime listener was registered first on the same bubbling path.
    // Read aria-pressed after it finishes instead of queueing from capture phase; otherwise
    // the evidence bridge can observe the pre-toggle state and silently miss the admission.
    const recordToggle=(button)=>{const active=button.getAttribute('aria-pressed')==='true';append(targetEventFromButton(button,active?{}:{event_id:browserEventId('clear'),source:'manual_clear',outcome:'CLEAR'}))};
    root.addEventListener('click',(event)=>{const button=event.target instanceof HTMLElement?event.target.closest('[data-vocab-repair]'):null;if(button instanceof HTMLButtonElement)recordToggle(button)});
    document.addEventListener('keydown',(event)=>{
      if(event.defaultPrevented||mode!=='study'||document.querySelector('[data-vocab-challenge-runtime][data-challenge-active="true"]'))return;
      const activeRoot=document.querySelector('[data-local-port="vocabulary"][data-vocab-keyboard-active="true"]')||document.querySelector('[data-local-port="vocabulary"]');
      if(activeRoot!==root)return;
      const target=event.target;
      if(target instanceof HTMLElement&&target.closest('input,textarea,select,button,a,[contenteditable="true"]'))return;
      if(event.key==='Backspace'){
        if(readRouting().history.length){event.preventDefault();undoRouting();}
        return;
      }
      const revealed=root.dataset.vocabRevealed==='true';
      if(!revealed)return;
      const routeByKey={ArrowLeft:'unknown',ArrowUp:'fuzzy',ArrowRight:'known',ArrowDown:'mastered'};
      const route=routeByKey[event.key];
      if(route){event.preventDefault();submitRoute(route);}
    });
  }

  });
</script>
