---
import Value from './PoliticsProjectionValue.astro';
import PoliticsPurposeFirstGeometry from './PoliticsPurposeFirstGeometry.astro';
import PoliticsExplicitSurfacePlan from './PoliticsExplicitSurfacePlan.astro';
const { projection } = Astro.props;
const labels = {cause:'起因',cause_layers:'原因层次',process:'发展过程',turning_point:'转折',evaluation:'评价',historical_gain:'历史成果',failure_causes:'失败原因',failure_lesson:'教训',program:'主张与方案',mechanism:'作用机制',before:'前提',historical_meaning:'历史意义',core_contradiction:'核心矛盾',from_previous:'承上',historical_position:'历史位置',conditions:'形成条件',teaching_relations:'关键关系',identity_hierarchy:'体系身份',role_summary:'这一层回答什么',concept_identity:'概念与性质',application_rule:'情境判断',current_relation:'主关系',theory_response:'理论回应',parallel_theory_responses:'不同问题的回应'};
const explicitOrient = projection?.surfacePlan?.states?.ORIENT || null;
const usePurposeFirst = projection?.purposeFirst === true || projection?.purposeFirstPilot === true;
const hierarchy = projection?.hierarchy?.tiers || null;
const h1Primary = hierarchy
  ? hierarchy.H1_ORIENTATION_CORE.filter((item) => item.kind === 'primary').map((item) => ({ role: item.role, value: item.value }))
  : projection?.primary || [];
const h3 = hierarchy?.H3_SUPPORTING_UNDERSTANDING || [];
const h1Projection = hierarchy ? { ...projection, primary: h1Primary, secondary: [] } : projection;
---
{projection && <section class={`politicsCompiledGeometry ${explicitOrient ? 'explicitMapped' : ''} ${usePurposeFirst ? 'purposeFirst' : ''} ${hierarchy ? 'hierarchyAware' : ''}`} data-compiled-shape={projection.shape} data-compiled-unit={projection.unitId} data-representation={projection?.representation?.kind || undefined} data-content-hierarchy={hierarchy ? 'v1' : undefined} data-explicit-surface-mapping={explicitOrient ? 'v1' : undefined}>
  {explicitOrient ? (
    <PoliticsExplicitSurfacePlan groups={explicitOrient} />
  ) : usePurposeFirst ? (
    <PoliticsPurposeFirstGeometry projection={h1Projection} />
  ) : (
    <div class="compiledPrimary">
      {h1Primary.map(item => <article class={`compiledObject role-${item.role}`}>
        {labels[item.role] && <h3>{labels[item.role]}</h3>}
        <Value value={item.value} emphasizeLabels={['current_structure', 'current_owned_structure', 'identity_hierarchy'].includes(item.role)} />
      </article>)}
    </div>
  )}

  {!explicitOrient && (hierarchy ? (
    h3.length > 0 && <details class="politicsHierarchySupport" data-hierarchy-tier="H3_SUPPORTING_UNDERSTANDING">
      <summary>理解补充 · 需要时展开</summary>
      <div class="politicsHierarchySupportBody">
        {h3.map((item) => <section class="politicsHierarchySupportItem" data-hierarchy-kind={item.kind}>
          {item.role && <strong>{labels[item.role] || '进一步理解'}</strong>}
          <Value value={item.value} emphasizeLabels={['current_structure', 'current_owned_structure', 'identity_hierarchy'].includes(item.role)} />
        </section>)}
      </div>
    </details>
  ) : (
    <>
      {projection.secondary.length > 0 && <div class="compiledSecondary">{projection.secondary.map(item => <article class={`compiledObject role-${item.role}`}><h3>{labels[item.role] || '进一步判断'}</h3><Value value={item.value} emphasizeLabels={['current_structure', 'current_owned_structure', 'identity_hierarchy'].includes(item.role)} /></article>)}</div>}
      {projection.boundaries.length > 0 && <aside class="compiledBoundaries"><h3>分清边界</h3>{projection.boundaries.map(value => <Value value={value} />)}</aside>}
      {projection.takeaway.length > 0 && <section class="compiledTakeaway"><h3>这一段带走</h3>{projection.takeaway.map(value => <Value value={value} />)}</section>}
      {projection.exact.length > 0 && <section class="compiledExact"><h3>精确表述</h3>{projection.exact.map(value => <Value value={value} />)}</section>}
    </>
  ))}
</section>}

<style>
  .politicsCompiledGeometry.hierarchyAware{display:grid;gap:18px}
  .politicsHierarchySupport{border-top:1px solid var(--study-line);padding-top:12px}
  .politicsHierarchySupport>summary{cursor:pointer;list-style:none;width:max-content;max-width:100%;font-size:16px;line-height:1.5;font-weight:720;color:#557067}
  .politicsHierarchySupport>summary::-webkit-details-marker{display:none}
  .politicsHierarchySupport>summary::after{content:'  +';color:var(--study-green)}
  .politicsHierarchySupport[open]>summary::after{content:'  −'}
  .politicsHierarchySupportBody{display:grid;gap:12px;margin-top:14px}
  .politicsHierarchySupportItem{display:grid;grid-template-columns:minmax(145px,.3fr) minmax(0,1fr);gap:16px;padding:10px 0;border-bottom:1px solid #e8eeeb}
  .politicsHierarchySupportItem>strong{font-size:17px;line-height:1.55;color:#38584d}
  .politicsHierarchySupportItem :global(.projectionText),
  .politicsHierarchySupportItem :global(p),
  .politicsHierarchySupportItem :global(li),
  .politicsHierarchySupportItem :global(span),
  .politicsHierarchySupportItem :global(strong){font-size:17px;line-height:1.62}
  @media(max-width:1050px){.politicsHierarchySupportItem{grid-template-columns:1fr}}
</style>
