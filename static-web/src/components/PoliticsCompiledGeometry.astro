---
import Value from './PoliticsProjectionValue.astro';
import PoliticsPurposeFirstGeometry from './PoliticsPurposeFirstGeometry.astro';
const { projection } = Astro.props;
const labels = {cause:'起因',cause_layers:'原因层次',process:'发展过程',turning_point:'转折',evaluation:'评价',historical_gain:'历史成果',failure_causes:'失败原因',failure_lesson:'教训',program:'主张与方案',mechanism:'作用机制',before:'前提',historical_meaning:'历史意义',core_contradiction:'核心矛盾',from_previous:'承上',historical_position:'历史位置',conditions:'形成条件',teaching_relations:'关键关系',identity_hierarchy:'体系身份',role_summary:'这一层回答什么',concept_identity:'概念与性质',application_rule:'情境判断',current_relation:'主关系',theory_response:'理论回应',parallel_theory_responses:'不同问题的回应'};
const usePurposeFirst = projection?.purposeFirstPilot === true;
---
{projection && <section class={`politicsCompiledGeometry ${usePurposeFirst ? 'purposeFirstPilot' : ''}`} data-compiled-shape={projection.shape} data-compiled-unit={projection.unitId} data-representation={projection?.representation?.kind || undefined}>
  {usePurposeFirst ? (
    <PoliticsPurposeFirstGeometry projection={projection} />
  ) : (
    <>
      <div class="compiledPrimary">
        {projection.primary.map(item => <article class={`compiledObject role-${item.role}`}>
          {labels[item.role] && <h3>{labels[item.role]}</h3>}
          <Value value={item.value} emphasizeLabels={['current_structure', 'current_owned_structure', 'identity_hierarchy'].includes(item.role)} />
        </article>)}
      </div>
      {projection.secondary.length > 0 && <div class="compiledSecondary">{projection.secondary.map(item => <article class={`compiledObject role-${item.role}`}><h3>{labels[item.role] || '进一步判断'}</h3><Value value={item.value} emphasizeLabels={['current_structure', 'current_owned_structure', 'identity_hierarchy'].includes(item.role)} /></article>)}</div>}
    </>
  )}
  {projection.boundaries.length > 0 && <aside class="compiledBoundaries"><h3>分清边界</h3>{projection.boundaries.map(value => <Value value={value} />)}</aside>}
  {projection.takeaway.length > 0 && <section class="compiledTakeaway"><h3>这一段带走</h3>{projection.takeaway.map(value => <Value value={value} />)}</section>}
  {projection.exact.length > 0 && <section class="compiledExact"><h3>精确表述</h3>{projection.exact.map(value => <Value value={value} />)}</section>}
</section>}
