---
const { block } = Astro.props;
const allowedKpIds = (block?.kpRecords || []).map((kp) => kp.kpId).filter(Boolean);
---
<span data-xizong-repair-inbox-bridge data-object-id={block.objectId} hidden></span>
<script type="application/json" data-repair-inbox-kp-ids set:html={JSON.stringify(allowedKpIds)}></script>

<script>
  const marker = document.querySelector('[data-xizong-repair-inbox-bridge]');
  if (marker instanceof HTMLElement) {
    const objectId = marker.getAttribute('data-object-id') || 'xizong:unknown';
    const extensionKey = `kianos-xizong-memory-review-v2:${objectId}`;
    const inboxKey = `kianos-xizong-repair-inbox-v1:${objectId}`;
    let allowedKpIds = [];
    try { allowedKpIds = JSON.parse(document.querySelector('[data-repair-inbox-kp-ids]')?.textContent || '[]'); } catch {}
    const allowed = new Set(allowedKpIds);

    const readJson = (key, fallback = null) => {
      try { return JSON.parse(localStorage.getItem(key) || '') || fallback; } catch { return fallback; }
    };
    const writeJson = (key, value) => {
      try { localStorage.setItem(key, JSON.stringify(value)); return true; } catch { return false; }
    };

    const consumeInbox = () => {
      const inbox = readJson(inboxKey, null);
      if (!inbox) return false;
      const seen = new Set();
      const incoming = (Array.isArray(inbox?.plans) ? inbox.plans : [])
        .map((row) => ({
          kpId: String(row?.kpId || row?.kp_id || ''),
          reason: String(row?.reason || ''),
          action: String(row?.action || ''),
          priority: String(row?.priority || ''),
          sourceQuestionIds: Array.isArray(row?.sourceQuestionIds) ? [...new Set(row.sourceQuestionIds.map(String).filter(Boolean))] : []
        }))
        .filter((row) => row.kpId && allowed.has(row.kpId) && !seen.has(row.kpId) && seen.add(row.kpId));

      try { localStorage.removeItem(inboxKey); } catch {}
      if (!incoming.length) return false;

      const ext = readJson(extensionKey, {
        memory: {}, memoryIndex: 0, reviewPlan: [], reviewIndex: 0,
        reviewRatings: {}, evidenceHistory: [], lastRecallRatings: {}
      });
      const incomingIds = new Set(incoming.map((row) => row.kpId));
      const existing = (Array.isArray(ext.reviewPlan) ? ext.reviewPlan : [])
        .filter((row) => !incomingIds.has(String(row?.kpId || row?.kp_id || row || '')));
      ext.reviewPlan = [...existing, ...incoming];
      ext.reviewIndex = 0;
      ext.evidenceHistory = [...(Array.isArray(ext.evidenceHistory) ? ext.evidenceHistory : []), {
        at: new Date().toISOString(),
        type: 'SYSTEM_WU_PLAN_IMPORTED',
        evidence_role: 'REPAIR_ONLY',
        kp_ids: incoming.map((row) => row.kpId),
        source_question_ids: [...new Set(incoming.flatMap((row) => row.sourceQuestionIds || []))]
      }].slice(-400);
      if (!writeJson(extensionKey, ext)) return false;
      try { sessionStorage.setItem(`kianos-xizong-repair-inbox-consumed:${objectId}`, '1'); } catch {}
      return true;
    };

    const consumeAndReload = () => {
      if (!consumeInbox()) return;
      window.location.reload();
    };

    window.setTimeout(() => {
      if (readJson(inboxKey, null)) {
        consumeAndReload();
        return;
      }
      window.addEventListener('storage', (event) => {
        if (event.key !== inboxKey || !event.newValue) return;
        consumeAndReload();
      });
    }, 0);
  }
</script>