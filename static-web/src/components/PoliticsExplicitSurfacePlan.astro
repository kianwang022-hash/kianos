---
const { groups = [] } = Astro.props;

function textList(value) {
  if (value == null || value === '') return [];
  if (Array.isArray(value)) return value.flatMap(textList);
  return [String(value)];
}

function itemLabel(item) {
  return item?.label || item?.role || item?.name || item?.left || item?.from_label || '';
}

function learnerLines(item, extraReserved = []) {
  const reserved = new Set([
    'id',
    'label',
    'role',
    'name',
    'left',
    'right',
    'from_label',
    'to_label',
    'locator',
    'look_for',
    'items',
    ...extraReserved
  ]);
  return Object.entries(item || {}).flatMap(([field, value]) => {
    if (reserved.has(field) || value == null || value === '' || typeof value === 'object') return [];
    return [{ field, text: String(value) }];
  });
}

function itemChildren(item) {
  return textList(item?.items);
}
---

<div class="politicsExplicitSurfacePlan" data-politics-explicit-surface-plan>
  {groups.map((group) => (
    <section
      class={`explicitGroup primitive-${String(group.primitive || '').toLowerCase()} zone-${String(group.zone || '').toLowerCase()}`}
      data-surface-group={group.id}
      data-surface-zone={group.zone}
      data-surface-primitive={group.primitive}
    >
      {group.title && <header><strong>{group.title}</strong></header>}

      {group.primitive === 'DIRECTED_SEQUENCE' ? (
        <div class="explicitSequence">
          {group.items.map((item, index) => {
            const next = group.items[index + 1];
            const transition = next ? group.transitions.find((row) => row.from === item.id && row.to === next.id) : null;
            return (
              <>
                <article class="sequenceItem">
                  {itemLabel(item) && <b>{itemLabel(item)}</b>}
                  {learnerLines(item).map((line) => <p data-surface-field={line.field}>{line.text}</p>)}
                  {itemChildren(item).length > 0 && <ul>{itemChildren(item).map((line) => <li>{line}</li>)}</ul>}
                </article>
                {next && transition && (
                  <div class="sequenceTransition" data-transition-mode={transition.relation_mode}>
                    {transition.relation_mode === 'LABELED_RELATION' && transition.relation && (
                      <span data-surface-field="relation">{transition.relation}</span>
                    )}
                    <i aria-hidden="true">→</i>
                  </div>
                )}
              </>
            );
          })}
        </div>
      ) : group.primitive === 'PARALLEL_SET' ? (
        <div class="explicitParallel">
          {group.items.map((item) => (
            <article>
              {itemLabel(item) && <b>{itemLabel(item)}</b>}
              {item.from_label && item.to_label ? (
                <p><strong>{item.from_label}</strong><span data-surface-field="relation">{item.relation || ''}</span><strong>{item.to_label}</strong></p>
              ) : learnerLines(item).map((line) => <p data-surface-field={line.field}>{line.text}</p>)}
              {itemChildren(item).length > 0 && <ul>{itemChildren(item).map((line) => <li>{line}</li>)}</ul>}
            </article>
          ))}
        </div>
      ) : group.primitive === 'COMPARE' ? (
        <div class="explicitCompare">
          {group.items.map((item) => (
            <article>
              <div class="compareSides">
                {item.left && <b>{item.left}</b>}
                {item.right && <b>{item.right}</b>}
              </div>
              {learnerLines(item).map((line) => <p data-surface-field={line.field}>{line.text}</p>)}
            </article>
          ))}
        </div>
      ) : group.primitive === 'HIERARCHY' ? (
        <div class="explicitHierarchy">
          {group.items.map((item, index) => (
            <article style={`--level:${index}`}>
              {itemLabel(item) && <span>{itemLabel(item)}</span>}
              <div>{learnerLines(item).map((line) => <p data-surface-field={line.field}>{line.text}</p>)}</div>
            </article>
          ))}
        </div>
      ) : group.primitive === 'TIMELINE' ? (
        <ol class="explicitTimeline">
          {group.items.map((item) => (
            <li>
              {itemLabel(item) && <b>{itemLabel(item)}</b>}
              <div>{learnerLines(item).map((line) => <span data-surface-field={line.field}>{line.text}</span>)}</div>
            </li>
          ))}
        </ol>
      ) : (
        <div class="explicitStatements">
          {group.items.map((item) => (
            <article>
              {item.from_label && item.to_label ? (
                <p class="edgeStatement"><strong>{item.from_label}</strong><span data-surface-field="relation">{item.relation || ''}</span><strong>{item.to_label}</strong></p>
              ) : (
                <>
                  {itemLabel(item) && <b>{itemLabel(item)}</b>}
                  {learnerLines(item).map((line) => <p data-surface-field={line.field}>{line.text}</p>)}
                  {itemChildren(item).length > 0 && <ul>{itemChildren(item).map((line) => <li>{line}</li>)}</ul>}
                  {item.locator && <p class="surfaceLocator" data-surface-field="locator">{item.locator}</p>}
                  {textList(item.look_for).length > 0 && <ul>{textList(item.look_for).map((line) => <li data-surface-field="look_for">{line}</li>)}</ul>}
                </>
              )}
            </article>
          ))}
        </div>
      )}
    </section>
  ))}
</div>

<style>
  .politicsExplicitSurfacePlan {
    display: grid;
    gap: 24px;
    min-width: 0;
  }

  .explicitGroup {
    display: grid;
    gap: 14px;
    min-width: 0;
  }

  .explicitGroup > header {
    padding-bottom: 9px;
    border-bottom: 1px solid var(--study-line);
  }

  .explicitGroup > header strong {
    color: #294b40;
    font-size: 19px;
    font-weight: 650;
    line-height: 1.5;
  }

  .zone-support {
    padding-top: 2px;
  }

  .zone-support > header strong {
    color: #587067;
    font-size: 17px;
    font-weight: 600;
  }

  .explicitParallel {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 18px 26px;
  }

  .explicitParallel article,
  .explicitStatements article {
    display: grid;
    gap: 7px;
    min-width: 0;
    padding: 10px 0 11px 15px;
    border-left: 3px solid #b7cec4;
  }

  .explicitParallel b,
  .explicitStatements b,
  .sequenceItem b {
    color: #173f32;
    font-size: 18px;
    font-weight: 650;
    line-height: 1.5;
  }

  .explicitParallel p,
  .explicitStatements p,
  .sequenceItem p {
    margin: 0;
    color: #4b645a;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.75;
  }

  .explicitParallel ul,
  .explicitStatements ul,
  .sequenceItem ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin: 3px 0 0;
    padding: 0;
    list-style: none;
  }

  .explicitParallel li,
  .explicitStatements li,
  .sequenceItem li {
    color: #405f54;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.65;
  }

  .explicitSequence {
    display: flex;
    align-items: stretch;
    gap: 14px;
    min-width: 0;
  }

  .sequenceItem {
    display: grid;
    flex: 1 1 0;
    align-content: start;
    gap: 7px;
    min-width: 0;
    padding: 11px 0 12px 15px;
    border-left: 3px solid #78a590;
  }

  .sequenceTransition {
    display: grid;
    flex: 0 0 104px;
    align-content: center;
    justify-items: center;
    gap: 7px;
    color: #547d6e;
  }

  .sequenceTransition span {
    font-size: 16px;
    font-weight: 550;
    line-height: 1.55;
    text-align: center;
  }

  .sequenceTransition i {
    font-size: 22px;
    font-style: normal;
    font-weight: 700;
  }

  .explicitCompare {
    display: grid;
    gap: 0;
  }

  .explicitCompare article {
    padding: 14px 0 15px;
    border-bottom: 1px solid #e2ebe6;
  }

  .compareSides {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .compareSides b {
    color: #24483c;
    font-size: 18px;
    font-weight: 650;
    line-height: 1.55;
  }

  .explicitCompare p {
    margin: 8px 0 0;
    color: #536a61;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.7;
  }

  .explicitHierarchy {
    display: grid;
    gap: 0;
  }

  .explicitHierarchy article {
    display: grid;
    grid-template-columns: minmax(120px, .38fr) minmax(0, 1.62fr);
    gap: 20px;
    margin-left: calc(var(--level) * 14px);
    padding: 13px 0;
    border-bottom: 1px solid #e2ebe6;
  }

  .explicitHierarchy article > span {
    color: #527166;
    font-size: 16px;
    font-weight: 650;
    line-height: 1.55;
  }

  .explicitHierarchy article > div {
    display: grid;
    gap: 6px;
  }

  .explicitHierarchy p {
    margin: 0;
    color: #29483d;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.7;
  }

  .explicitTimeline {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .explicitTimeline li {
    display: grid;
    grid-template-columns: minmax(150px, .45fr) minmax(0, 1.55fr);
    gap: 22px;
    padding: 13px 0;
    border-bottom: 1px solid #e2ebe6;
  }

  .explicitTimeline b {
    color: #24483c;
    font-size: 17px;
    font-weight: 650;
    line-height: 1.55;
  }

  .explicitTimeline li > div {
    display: grid;
    gap: 5px;
  }

  .explicitTimeline span {
    color: #536a61;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.7;
  }

  .edgeStatement {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 9px;
  }

  .edgeStatement strong {
    font-size: 18px;
    font-weight: 650;
  }

  .edgeStatement span {
    color: #587067;
    font-size: 17px;
    font-weight: 550;
  }

  .surfaceLocator {
    color: #2d5b49 !important;
    font-weight: 650 !important;
  }

  @media (max-width: 980px) {
    .explicitSequence {
      display: grid;
    }

    .sequenceTransition {
      grid-template-columns: auto auto;
      min-height: 36px;
      justify-content: start;
    }

    .sequenceTransition i {
      transform: rotate(90deg);
    }

    .compareSides,
    .explicitHierarchy article,
    .explicitTimeline li {
      grid-template-columns: 1fr;
    }

    .explicitHierarchy article {
      margin-left: 0;
    }
  }
</style>
