---
const { groups = [] } = Astro.props;

function textList(value) {
  if (value == null || value === '') return [];
  if (Array.isArray(value)) return value.flatMap(textList);
  return [String(value)];
}

function primaryText(item) {
  return item?.text || item?.fact || item?.meaning || item?.distinction || '';
}

function itemLabel(item) {
  return item?.label || item?.role || item?.name || item?.left || item?.from_label || '';
}

function itemChildren(item) {
  return textList(item?.items);
}
---

<div class="politicsExplicitSurfacePlan" data-politics-explicit-surface-plan>
  {groups.map((group) => (
    <section
      class={`explicitGroup primitive-${String(group.primitive || '').toLowerCase()} zone-${String(group.zone || '').toLowerCase()}`}
      data-surface-group={group.id}
      data-surface-zone={group.zone}
      data-surface-primitive={group.primitive}
    >
      {group.title && <header><strong>{group.title}</strong></header>}

      {group.primitive === 'DIRECTED_SEQUENCE' ? (
        <div class="explicitSequence">
          {group.items.map((item, index) => {
            const next = group.items[index + 1];
            const transition = next ? group.transitions.find((row) => row.from === item.id && row.to === next.id) : null;
            return (
              <>
                <article class="sequenceItem">
                  {itemLabel(item) && <b>{itemLabel(item)}</b>}
                  {primaryText(item) && <p>{primaryText(item)}</p>}
                  {itemChildren(item).length > 0 && <ul>{itemChildren(item).map((line) => <li>{line}</li>)}</ul>}
                </article>
                {next && transition && (
                  <div class="sequenceTransition" aria-label={transition.relation || '下一步'}>
                    {transition.relation && <span>{transition.relation}</span>}
                    <i aria-hidden="true">→</i>
                  </div>
                )}
              </>
            );
          })}
        </div>
      ) : group.primitive === 'PARALLEL_SET' ? (
        <div class="explicitParallel">
          {group.items.map((item) => (
            <article>
              {itemLabel(item) && <b>{itemLabel(item)}</b>}
              {item.from_label && item.to_label ? (
                <p><strong>{item.from_label}</strong><span>{item.relation || ''}</span><strong>{item.to_label}</strong></p>
              ) : primaryText(item) ? <p>{primaryText(item)}</p> : null}
              {itemChildren(item).length > 0 && <ul>{itemChildren(item).map((line) => <li>{line}</li>)}</ul>}
            </article>
          ))}
        </div>
      ) : group.primitive === 'COMPARE' ? (
        <div class="explicitCompare">
          {group.items.map((item) => (
            <article>
              <div class="compareSides">
                {item.left && <b>{item.left}</b>}
                {item.right && <b>{item.right}</b>}
              </div>
              {item.distinction && <p>{item.distinction}</p>}
              {!item.left && !item.right && primaryText(item) && <p>{primaryText(item)}</p>}
            </article>
          ))}
        </div>
      ) : group.primitive === 'HIERARCHY' ? (
        <div class="explicitHierarchy">
          {group.items.map((item, index) => (
            <article style={`--level:${index}`}>
              {itemLabel(item) && <span>{itemLabel(item)}</span>}
              <p>{item.text || primaryText(item)}</p>
            </article>
          ))}
        </div>
      ) : group.primitive === 'TIMELINE' ? (
        <ol class="explicitTimeline">
          {group.items.map((item) => <li>{itemLabel(item) && <b>{itemLabel(item)}</b>}<span>{primaryText(item)}</span></li>)}
        </ol>
      ) : (
        <div class="explicitStatements">
          {group.items.map((item) => (
            <article>
              {item.from_label && item.to_label ? (
                <p class="edgeStatement"><strong>{item.from_label}</strong><span>{item.relation || ''}</span><strong>{item.to_label}</strong></p>
              ) : (
                <>
                  {itemLabel(item) && <b>{itemLabel(item)}</b>}
                  {primaryText(item) && <p>{primaryText(item)}</p>}
                  {itemChildren(item).length > 0 && <ul>{itemChildren(item).map((line) => <li>{line}</li>)}</ul>}
                  {item.locator && <p class="surfaceLocator">{item.locator}</p>}
                  {textList(item.look_for).length > 0 && <ul>{textList(item.look_for).map((line) => <li>{line}</li>)}</ul>}
                </>
              )}
            </article>
          ))}
        </div>
      )}
    </section>
  ))}
</div>

<style>
  .politicsExplicitSurfacePlan{display:grid;gap:18px;min-width:0}.explicitGroup{display:grid;gap:10px;min-width:0}.explicitGroup>header{padding-bottom:7px;border-bottom:1px solid var(--study-line)}.explicitGroup>header strong{font-size:18px;line-height:1.45;color:#294b40}.zone-support{padding-top:4px}.zone-support>header strong{color:#587067;font-size:16px}.explicitParallel{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px}.explicitParallel article,.explicitStatements article{display:grid;gap:5px;padding:9px 0 9px 12px;border-left:3px solid #bfd3cb}.explicitParallel b,.explicitStatements b,.sequenceItem b{font-size:18px;line-height:1.4;color:#173f32}.explicitParallel p,.explicitStatements p,.sequenceItem p{margin:0;font-size:16px;line-height:1.62;color:#4f675e}.explicitParallel ul,.explicitStatements ul,.sequenceItem ul{display:flex;flex-wrap:wrap;gap:7px 12px;margin:2px 0 0;padding:0;list-style:none}.explicitParallel li,.explicitStatements li,.sequenceItem li{font-size:16px;line-height:1.55;color:#405f54}.explicitSequence{display:flex;align-items:stretch;gap:12px;min-width:0}.sequenceItem{flex:1 1 0;display:grid;align-content:start;gap:5px;padding:10px 0 10px 12px;border-left:3px solid #7aa995}.sequenceTransition{flex:0 0 80px;display:grid;align-content:center;justify-items:center;gap:3px;color:#658d7f}.sequenceTransition span{font-size:12px;line-height:1.35;text-align:center}.sequenceTransition i{font-style:normal;font-size:20px;font-weight:760}.explicitCompare{display:grid;gap:10px}.explicitCompare article{padding:10px 0;border-bottom:1px solid #e7eeea}.compareSides{display:grid;grid-template-columns:1fr 1fr;gap:12px}.compareSides b{font-size:17px;color:#24483c}.explicitCompare p{margin:7px 0 0;font-size:16px;line-height:1.62;color:#536a61}.explicitHierarchy{display:grid;gap:8px}.explicitHierarchy article{display:grid;grid-template-columns:100px minmax(0,1fr);gap:14px;margin-left:calc(var(--level) * 12px);padding:9px 0;border-bottom:1px solid #e7eeea}.explicitHierarchy span{font-size:15px;font-weight:760;color:#527166}.explicitHierarchy p{margin:0;font-size:17px;line-height:1.6;color:#29483d}.explicitTimeline{display:grid;gap:8px;margin:0;padding:0;list-style:none}.explicitTimeline li{display:grid;grid-template-columns:130px minmax(0,1fr);gap:14px;padding:8px 0;border-bottom:1px solid #e7eeea}.explicitTimeline b{font-size:16px;color:#24483c}.explicitTimeline span{font-size:16px;line-height:1.6;color:#536a61}.edgeStatement{display:flex;flex-wrap:wrap;align-items:baseline;gap:7px}.edgeStatement strong{font-size:17px}.edgeStatement span{font-size:16px;color:#587067}.surfaceLocator{font-weight:700;color:#2d5b49!important}@media(max-width:980px){.explicitSequence{display:grid}.sequenceTransition{min-height:30px;grid-template-columns:auto auto;justify-content:start}.sequenceTransition i{transform:rotate(90deg)}.compareSides{grid-template-columns:1fr}.explicitHierarchy article,.explicitTimeline li{grid-template-columns:1fr}.explicitHierarchy article{margin-left:0}}
</style>
