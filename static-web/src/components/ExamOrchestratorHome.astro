---
import { examProductCatalog, politicsProductCatalog } from '../lib/productCatalog.mjs';
import { buildPoliticsMemoryCandidateCatalogCurrent } from '../lib/politicsMemoryCandidates.mjs';
const { xizongPacketIndex = [], xizongForecastQuestionScope = null, xizongForecastCanonicalScope = null } = Astro.props;
const base = import.meta.env.BASE_URL;
const catalog = examProductCatalog(base);
const politicsCatalog = politicsProductCatalog(base);
const politicsMemoryCatalog = buildPoliticsMemoryCandidateCatalogCurrent();
---
<section class="examToday" data-exam-home>
  <script type="application/json" data-exam-catalog set:html={JSON.stringify(catalog).replace(/</g, '\\u003c')} />
  <script type="application/json" data-exam-daily-politics-catalog set:html={JSON.stringify(politicsCatalog).replace(/</g, '\\u003c')} />
  <script type="application/json" data-exam-politics-memory-catalog set:html={JSON.stringify(politicsMemoryCatalog).replace(/</g, '\\u003c')} />
  <script type="application/json" data-exam-daily-xizong-index set:html={JSON.stringify(xizongPacketIndex).replace(/</g, '\\u003c')} />
  <script type="application/json" data-exam-xizong-forecast-question-scope set:html={JSON.stringify(xizongForecastQuestionScope).replace(/</g, '\\u003c')} />
  <script type="application/json" data-exam-xizong-forecast-canonical-scope set:html={JSON.stringify(xizongForecastCanonicalScope).replace(/</g, '\\u003c')} />
  <header class="examTodayHead"><div><h2>今天</h2></div><button class="examQuiet" data-exam-settings>调整时间</button></header>
  <p class="examCapacity" data-exam-capacity>今天的时间与学习记录会汇总在这里。</p>
  <div class="examAllocation" data-exam-allocations aria-live="polite"></div>
  <div class="examNext"><span data-exam-next-label>下一步</span><a data-exam-next href={`${base}xizong/`}>进入学习 →</a></div>
  <section class="examAttention" data-exam-attention hidden><p data-exam-attention-text></p><button data-exam-attention-action class="examQuiet"></button></section>
  <p class="examError" data-exam-error role="alert" hidden></p>
  <footer class="examTodayFoot">
    <button class="examQuiet" data-exam-why>安排说明</button>
    <button class="examQuiet" data-exam-record>补录时间</button>
    <button class="examQuiet examDailyPacketButton" data-exam-copy-daily>复制今日学习包</button>
  </footer>
  <p class="examDailyPacketStatus" data-exam-daily-status aria-live="polite"></p>
  <section class="examMaterial" data-exam-reminder hidden><p></p><button class="examQuiet" data-exam-reminder-dismiss>记住了</button></section>

  <dialog class="examDialog" data-exam-settings-dialog aria-labelledby="exam-settings-title">
    <form data-exam-settings-form>
      <header><h2 id="exam-settings-title">可用时间</h2><button type="button" data-close aria-label="关闭">×</button></header>
      <p>这里只记录真实可用时间，供 Chat 调度使用；网页不会因为你改了时间就自行重排三科。</p>
      <label>今天总共可学（含已学）<div class="examTimeInput"><input data-capacity-hours type="number" min="0" max="24" step="0.25" required /><span>小时</span></div></label>
      <label class="examCheck"><input type="checkbox" data-capacity-default />也作为以后通常一天的可用时间</label>
      <label>今天的模式（作为 Chat 上下文）<select data-maintenance><option value="">正常安排三科</option><option value="xizong">维护西综，其余暂歇</option><option value="english">维护英语，其余暂歇</option><option value="politics">维护政治，其余暂歇</option></select></label>
      <p class="examSmall">0 小时就是休息；模式变化只记录为上下文，不由网页自动产生新的学习策略。</p>
      <p data-form-error role="alert" hidden></p><button class="examPrimary" type="submit">保存可用时间</button>
    </form>
  </dialog>
  <dialog class="examDialog" data-exam-record-dialog aria-labelledby="exam-record-title">
    <form data-exam-record-form><header><h2 id="exam-record-title">今天已学多久</h2><button type="button" data-close aria-label="关闭">×</button></header>
      <p>可选校准。按今天累计有效分钟填写，只更新事实证据；不会把时间当成掌握，也不会由网页自动重排学习。</p>
      <div class="examRecordedFields">{[['xizong','西综'],['english','英语'],['politics','政治']].map(([id,label]) => <label>{label}<input type="number" min="0" max="1440" step="1" data-studied={id} required />分钟</label>)}</div>
      <p data-form-error role="alert" hidden></p><button class="examPrimary" type="submit">确认今天累计时间</button>
    </form>
  </dialog>
  <dialog class="examDialog examWhyDialog" data-exam-why-dialog aria-labelledby="exam-why-title">
    <header><h2 id="exam-why-title">Chat 安排与本机上下文</h2><button type="button" data-close aria-label="关闭">×</button></header>
    <div data-exam-reasons></div>
    <details class="examAdvanced"><summary>Chat Plan / 阶段证据 / 本机备份</summary>
      <p>阶段证据只作为 Chat 的决策输入；网页不根据工作量、估分、阶段标签或资料完成度自动生成学习计划。</p>
      <button class="examQuiet" data-exam-export>导出本机学习上下文</button>
      <label>载入 Chat Plan / 本机学习上下文<input data-exam-import type="file" accept="application/json,.json" /></label>
      <pre data-exam-import-preview hidden></pre><button class="examPrimary" data-exam-import-confirm hidden>确认替换本机调度记录</button>
      <p data-import-error role="alert" hidden></p>
    </details>
  </dialog>
</section>
<script>
  import { initExamHome } from '../lib/examOrchestratorClient.mjs';
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(() => {

  initExamHome(document.querySelector('[data-exam-home]'));

  });
</script>
