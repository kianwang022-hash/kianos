---
const { objectId = '', sourceHash = '' } = Astro.props;
const memoryHref = `${import.meta.env.BASE_URL}xizong/memory/?view=precision`;
---
<span hidden data-xizong-memory-release-bridge data-object-id={objectId} data-source-hash={sourceHash}></span>
<div hidden data-prepared-memory-action data-memory-href={memoryHref}>
  <button type="button" data-open-prepared-memory title="只把已有精确答案加入可浏览的 Memory，不代表学完或接触过原讲义。">打开已准备的 Memory</button>
  <span role="status" data-prepared-memory-status></span>
</div>

<script>
  import { XIZONG_MEMORY_STORAGE_KEY, readXizongMemoryStorage, readXizongPersonalStorage, makePreparedMemoryAvailable } from '../lib/xizongMemoryModel.mjs';
  import { buildXizongPreparedMemoryAvailability, supportsXizongPreparedMemoryBlock } from '../lib/xizongMemoryRelease.mjs';
  import {
    releaseCompletedBlockToMemory,
    syncXizongPersonalMarks,
    xizongStudyStorageKey
  } from '../lib/xizongMemoryAutoRelease.mjs';
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(() => {


  const root = document.querySelector('[data-xizong-v6-block]');
  const payloadNode = document.querySelector('[data-xizong-learner-object-payload]');
  const bridgeNode = document.querySelector('[data-xizong-memory-release-bridge]');

  const parseJson = (value, fallback = null) => {
    try { return JSON.parse(value || 'null') ?? fallback; } catch { return fallback; }
  };

  const learnerObject = parseJson(payloadNode?.textContent, null);
  const objectId = bridgeNode?.getAttribute('data-object-id') || root?.getAttribute('data-study-object') || '';
  const sourceHash = bridgeNode?.getAttribute('data-source-hash') || '';
  let studyKey = '';
  try { studyKey = xizongStudyStorageKey(objectId); } catch {}

  // Explicit Browse availability is independent of Source / KP / Block
  // completion. Use the resolved payload, never learner ratings or URL claims.
  if (supportsXizongPreparedMemoryBlock(learnerObject?.identity?.blockId)) {
  const preparedAction = document.querySelector('[data-prepared-memory-action]');
  const preparedButton = preparedAction?.querySelector('[data-open-prepared-memory]');
  const preparedStatus = preparedAction?.querySelector('[data-prepared-memory-status]');
  const preparedHost = root?.querySelector('.portedStudyShellActions');
  if (preparedAction && preparedButton && preparedHost) {
    try {
      const descriptor = buildXizongPreparedMemoryAvailability(learnerObject, { sourceHash });
      preparedButton.textContent = `打开已准备的 Memory（${descriptor.precisionCards.length} 项）`;
      preparedAction.setAttribute('data-memory-href', `${preparedAction.getAttribute('data-memory-href')}&block=${encodeURIComponent(descriptor.blockId)}`);
      preparedHost.append(preparedAction);
      preparedAction.hidden = false;
      preparedButton.addEventListener('click', () => {
        try {
          const current = readXizongMemoryStorage(localStorage);
          const next = makePreparedMemoryAvailable(current,
            buildXizongPreparedMemoryAvailability(learnerObject, { sourceHash }));
          const serialized = JSON.stringify(next);
          if (serialized !== JSON.stringify(current)) localStorage.setItem(XIZONG_MEMORY_STORAGE_KEY, serialized);
          // Never navigate on failed persistence. This action creates no study
          // evidence, completion flags, attention or first-release receipt.
          window.location.assign(preparedAction.getAttribute('data-memory-href'));
        } catch (error) {
          if (preparedStatus) preparedStatus.textContent = 'Memory 暂时无法安全打开，原记录保留。请先备份后恢复。';
          console.error(error);
        }
      });
    } catch (error) { console.error(error); }
  }
  }

  const attemptRelease = () => {
    if (!root || !learnerObject || !studyKey) return;
    let result;
    let memoryState;
    try {
      const studyState = parseJson(localStorage.getItem(studyKey), {});
      memoryState = readXizongMemoryStorage(localStorage);
      const personal = readXizongPersonalStorage(localStorage, objectId);
      result = releaseCompletedBlockToMemory(memoryState, learnerObject, studyState, { sourceHash });
      result.state = syncXizongPersonalMarks(result.state, learnerObject, personal, objectId);
    } catch (error) {
      console.error(error);
      return;
    }
    if (!result?.released && !result?.refreshed && JSON.stringify(result?.state) === JSON.stringify(memoryState)) return;
    try {
      localStorage.setItem(XIZONG_MEMORY_STORAGE_KEY, JSON.stringify(result.state));
      window.dispatchEvent(new CustomEvent('kianos:xizong-memory-release', {
        detail: {
          schema: result.schema,
          blockId: result.blockId,
          action: result.refreshed ? 'CONTENT_REVISION_REFRESHED' : result.released ? 'BLOCK_COMPLETE_RELEASED' : 'PERSONAL_MARKS_SYNCED',
          coreCount: result.coreCardIds?.length || 0,
          precisionCount: result.precisionCardIds?.length || 0,
          attentionCount: result.attentionCardIds?.length || 0
        }
      }));
    } catch (error) {
      console.error(error);
    }
  };

  // Handles a Block that was completed before this bridge existed or before a reload.
  attemptRelease();

  // BlockV6 owns the completion write and emits this event only after the Current
  // Block state is persisted. Memory consumes that explicit semantic event instead
  // of inferring completion from a DOM click.
  window.addEventListener('kianos:xizong-block-complete', (event) => {
    const detail = event instanceof CustomEvent ? event.detail : null;
    if (detail?.object_id && detail.object_id !== objectId) return;
    attemptRelease();
  });
  window.addEventListener('kianos:xizong-personal-marks', (event) => {
    if (event instanceof CustomEvent && event.detail?.object_id === objectId) attemptRelease();
  });

  });
</script>
