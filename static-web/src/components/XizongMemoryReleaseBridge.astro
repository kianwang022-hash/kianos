---
const { objectId = '', sourceHash = '' } = Astro.props;
---
<span hidden data-xizong-memory-release-bridge data-object-id={objectId} data-source-hash={sourceHash}></span>

<script>
  import { XIZONG_MEMORY_STORAGE_KEY } from '../lib/xizongMemoryModel.mjs';
  import {
    releaseCompletedBlockToMemory,
    xizongStudyStorageKey
  } from '../lib/xizongMemoryAutoRelease.mjs';
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(() => {


  const root = document.querySelector('[data-xizong-v6-block]');
  const payloadNode = document.querySelector('[data-xizong-learner-object-payload]');
  const bridgeNode = document.querySelector('[data-xizong-memory-release-bridge]');

  const parseJson = (value, fallback = null) => {
    try { return JSON.parse(value || 'null') ?? fallback; } catch { return fallback; }
  };

  const learnerObject = parseJson(payloadNode?.textContent, null);
  const objectId = bridgeNode?.getAttribute('data-object-id') || root?.getAttribute('data-study-object') || '';
  const sourceHash = bridgeNode?.getAttribute('data-source-hash') || '';
  let studyKey = '';
  try { studyKey = xizongStudyStorageKey(objectId); } catch {}

  const attemptRelease = () => {
    if (!root || !learnerObject || !studyKey) return;
    const studyState = parseJson(localStorage.getItem(studyKey), {});
    const memoryState = parseJson(localStorage.getItem(XIZONG_MEMORY_STORAGE_KEY), null);
    let result;
    try {
      result = releaseCompletedBlockToMemory(memoryState, learnerObject, studyState, { sourceHash });
    } catch (error) {
      console.error(error);
      return;
    }
    if (!result?.released) return;
    try {
      localStorage.setItem(XIZONG_MEMORY_STORAGE_KEY, JSON.stringify(result.state));
      window.dispatchEvent(new CustomEvent('kianos:xizong-memory-release', {
        detail: {
          schema: result.schema,
          blockId: result.blockId,
          coreCount: result.coreCardIds?.length || 0,
          precisionCount: result.precisionCardIds?.length || 0,
          attentionCount: result.attentionCardIds?.length || 0
        }
      }));
    } catch (error) {
      console.error(error);
    }
  };

  // Handles a Block that was completed before this bridge existed or before a reload.
  attemptRelease();

  // BlockV6 owns the completion write. This bridge listens after that interaction and
  // consumes the persisted result; it does not redefine canComplete or mutate Block state.
  root?.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    if (!target?.closest('[data-block-complete]')) return;
    queueMicrotask(attemptRelease);
  });

  });
</script>
