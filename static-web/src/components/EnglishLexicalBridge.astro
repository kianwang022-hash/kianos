---
const base = import.meta.env.BASE_URL;
---
<aside data-english-lexical-bridge data-base={base} hidden><a data-lexical-lookup-link></a><span data-lexical-lookup-status role="status"></span></aside>
<script>
const lookup=document.querySelector('[data-english-lexical-bridge]');
if(lookup){
 let rows=null;
 document.addEventListener('mouseup',async()=>{
  const selection=getSelection();const text=selection?.toString().trim();
  if(!text || text.length>80 || !/^[A-Za-z][A-Za-z '-]*$/.test(text) || !selection?.anchorNode?.parentElement?.closest('.portedReadingPassage,.clozePassage,.readingBPassage,.readingBCandidates,.translationSource,.writingPrompt'))return;
  const base=lookup.getAttribute('data-base')||'/';
  const matches=()=>rows.filter(row=>row.word.toLowerCase()===text.toLowerCase());
  try{
    rows ||= await fetch(`${base}lexical-index.json`).then(response=>{if(!response.ok)throw new Error();return response.json()});
    const found=matches();lookup.hidden=false;
    const link=lookup.querySelector('a');const status=lookup.querySelector('span');
    if(found.length!==1){link.hidden=true;status.textContent=`${text}：没有唯一的 Current 精确词条。`;return;}
    const url=new URL(`${base}lexical-reference/`,location.origin);url.searchParams.set('ordinal',String(found[0].ordinal));url.searchParams.set('object',found[0].objectId);url.searchParams.set('return',location.pathname+location.search+location.hash);
    link.href=url.href;link.hidden=false;link.textContent=`${text} · 查阅 Lexical →`;status.textContent='只读参考';
    link.onclick=()=>{try{sessionStorage.setItem('kianos:guide-return:v1',JSON.stringify({href:location.pathname+location.search+location.hash,y:scrollY,panes:['.portedReadingPassage','.portedReadingQuestions','.clozePassage','.clozeDecision','.translationSource','.translationWork','.writingPrompt','.writingWork'].map(selector=>({selector,y:document.querySelector(selector)?.scrollTop||0}))}));}catch{}};
  }catch{lookup.hidden=false;lookup.querySelector('span').textContent='Lexical 暂时无法读取；当前任务保留。';}
 });
}
</script>
<style>[data-english-lexical-bridge]{position:fixed;bottom:24px;right:28px;z-index:20;display:flex;gap:18px;padding:14px 20px;background:#fff;border:1px solid var(--study-line);border-radius:6px;box-shadow:0 4px 24px #172d2214;font-size:16px;max-width:85vw;box-sizing:border-box}[data-english-lexical-bridge] a{color:var(--study-green)}[data-english-lexical-bridge] span{font-size:14px;color:var(--study-muted)}</style>
