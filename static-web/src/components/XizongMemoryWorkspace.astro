---
import {
  XIZONG_MEMORY_STORAGE_KEY,
  normalizeXizongMemoryState,
  memorySummary,
  selectMemoryView,
  weakWeightForCard,
  resolvedCorePrompt,
  setPersonalPrompt,
  addMarkedFragment,
  removeMarkedFragment,
  requestMemoryReview,
  appendMemoryEvidence
} from '../lib/xizongMemoryModel.mjs';
---
<section class="xzMemory" data-xizong-memory-workspace data-memory-storage-key={XIZONG_MEMORY_STORAGE_KEY}>
  <header class="xzMemoryHeader">
    <div class="xzMemoryIdentity">
      <a href={`${import.meta.env.BASE_URL}xizong/`}>← 西综</a>
      <div>
        <span>Standalone Memory</span>
        <h1>滚动复习工作区</h1>
        <p>不是一次性 Block 页的尾巴；这里承接已完成 Block 的长期复习。</p>
      </div>
    </div>
    <div class="xzMemorySummary" aria-label="Memory summary">
      <span><b data-memory-summary="today">0</b>Today</span>
      <span><b data-memory-summary="core">0</b>Core</span>
      <span><b data-memory-summary="precision">0</b>Precision</span>
      <span><b data-memory-summary="marked">0</b>Marked</span>
      <span><b data-memory-summary="repair">0</b>Repair</span>
    </div>
  </header>

  <nav class="xzMemoryTabs" aria-label="Memory views">
    <button type="button" data-memory-view="TODAY" class="active">Today</button>
    <button type="button" data-memory-view="CORE">Core</button>
    <button type="button" data-memory-view="PRECISION">Precision</button>
    <button type="button" data-memory-view="MARKED">Marked</button>
    <button type="button" data-memory-view="REPAIR">Repair</button>
  </nav>

  <div class="xzMemoryToolbar">
    <div>
      <strong data-memory-view-title>Today</strong>
      <span data-memory-view-note>由真实不稳证据、内容变更或主动请求进入；没有 due wall。</span>
    </div>
    <label class="xzMemoryWeakFilter"><input type="checkbox" data-memory-weak-only /> 只看弱项</label>
    <div class="xzMemoryPrecisionMode" data-memory-precision-mode hidden>
      <button type="button" class="active" data-precision-mode="BROWSE">Browse</button>
      <button type="button" data-precision-mode="TEST">Test</button>
    </div>
  </div>

  <div class="xzMemoryLayout">
    <aside class="xzMemoryQueue">
      <header><span data-memory-queue-kicker>Rolling queue</span><b data-memory-queue-count>0</b></header>
      <div data-memory-queue></div>
    </aside>

    <main class="xzMemoryStage">
      <section class="xzMemoryEmpty" data-memory-empty>
        <span>Memory is evidence-triggered</span>
        <h2>现在没有需要滚动复习的内容。</h2>
        <p>完成 Block 只会把 Core / 当前 Precision 释放进 Memory library；只有真实不稳、内容变更、主动请求或明确 Repair 才进入 Today。</p>
      </section>

      <article class="xzMemoryCard" data-memory-card hidden>
        <header class="xzMemoryCardHeader">
          <div>
            <span data-memory-card-family>Core</span>
            <h2 data-memory-card-title></h2>
            <p data-memory-card-context></p>
          </div>
          <div class="xzMemoryCardMeta">
            <span data-memory-card-weight></span>
            <b data-memory-card-resolution></b>
          </div>
        </header>

        <section class="xzMemoryPrompt" data-mark-surface="PROMPT">
          <header><span>Prompt</span><button type="button" data-memory-prompt-edit>改主动提示</button></header>
          <p data-memory-prompt></p>
          <div class="xzMemoryPromptEditor" data-memory-prompt-editor hidden>
            <textarea rows="3" data-memory-prompt-input></textarea>
            <div><button type="button" data-memory-prompt-reset>恢复 canonical</button><button type="button" data-memory-prompt-cancel>取消</button><button type="button" class="primary" data-memory-prompt-save>保存</button></div>
          </div>
        </section>

        <section class="xzMemoryPrecisionCue" data-memory-precision-cue hidden>
          <span>Precision cue</span>
          <p data-memory-precision-cue-text></p>
          <small data-memory-source-locator></small>
        </section>

        <div class="xzMemoryRevealGate" data-memory-reveal-gate>
          <strong>先主动恢复</strong>
          <button type="button" class="primary" data-memory-reveal>Reveal <span>Space</span></button>
        </div>
        <div class="xzMemoryAnswer" data-memory-answer data-mark-surface="CORE" hidden></div>

        <div class="xzMemoryRatings" data-memory-ratings hidden>
          <div><span>这次真实回忆</span><small>只写 evidence，不伪造 mastery。</small></div>
          <div>
            <button type="button" data-memory-rating="unknown">Unknown</button>
            <button type="button" data-memory-rating="fuzzy">Fuzzy</button>
            <button type="button" data-memory-rating="known">Known</button>
            <button type="button" data-memory-rating="mastered">Mastered</button>
          </div>
        </div>
        <footer class="xzMemoryCardActions">
          <button type="button" data-memory-review-request>加入 Today</button>
          <button type="button" data-memory-mark-selection>标记所选片段</button>
        </footer>
      </article>

      <article class="xzMemoryMarkedCard" data-memory-marked-card hidden>
        <header>
          <div><span>Marked fragment</span><h2 data-marked-title></h2><p data-marked-context></p></div>
        </header>
        <blockquote data-marked-text></blockquote>
        <footer><span data-marked-surface></span><button type="button" data-marked-remove>移除</button></footer>
      </article>

      <article class="xzMemoryRepairCard" data-memory-repair-card hidden>
        <header><div><span>Targeted Repair</span><h2 data-repair-title></h2><p data-repair-context></p></div></header>
        <dl>
          <div><dt>为什么回来</dt><dd data-repair-reason></dd></div>
          <div><dt>最小修补动作</dt><dd data-repair-action></dd></div>
        </dl>
        <small>Repair 由当前 evidence / Chat / 题目回链进入；不是固定周期墙。</small>
      </article>
    </main>

    <aside class="xzMemoryContext">
      <section><span>Current item</span><strong data-memory-context-title>—</strong><p data-memory-context-meta>—</p></section>
      <section><span>Evidence</span><dl><div><dt>Weak weight</dt><dd data-memory-context-weight>—</dd></div><div><dt>Last rating</dt><dd data-memory-context-rating>—</dd></div></dl></section>
      <section><span>Rule</span><p>Release ≠ Today。Memory 只在真实不稳、主动请求、内容变更或 Repair 证据出现时打断主线。</p></section>
      <section><span>Keys</span><p>Space Reveal · ←/→ 切换当前队列。</p></section>
    </aside>
  </div>
</section>

<script>
  import {
    XIZONG_MEMORY_STORAGE_KEY,
    normalizeXizongMemoryState,
    memorySummary,
    selectMemoryView,
    weakWeightForCard,
    resolvedCorePrompt,
    setPersonalPrompt,
    addMarkedFragment,
    removeMarkedFragment,
    requestMemoryReview,
    appendMemoryEvidence
  } from '../lib/xizongMemoryModel.mjs';

  const root = document.querySelector('[data-xizong-memory-workspace]');
  if (root instanceof HTMLElement) {
    const q = (selector) => root.querySelector(selector);
    const qa = (selector) => [...root.querySelectorAll(selector)];
    const read = () => {
      try { return normalizeXizongMemoryState(JSON.parse(localStorage.getItem(XIZONG_MEMORY_STORAGE_KEY) || 'null')); }
      catch { return normalizeXizongMemoryState(null); }
    };
    let state = read();
    let view = 'TODAY';
    let precisionMode = 'BROWSE';
    let weakOnly = false;
    let currentItems = [];
    let index = 0;
    let revealed = false;

    const viewNotes = {
      TODAY: ['Today', '由真实不稳证据、内容变更或主动请求进入；没有 due wall。'],
      CORE: ['Core library', '已完成 Block 的正式 Core 记忆对象。'],
      PRECISION: ['Precision library', '独立浏览或 Test；不偷塞进 Recall front。'],
      MARKED: ['Marked fragments', '只保留你显式标出的 Prompt / Core 片段。'],
      REPAIR: ['Repair queue', '由 Chat / Question / 当前 evidence 指定的最小修补任务。']
    };

    const save = () => localStorage.setItem(XIZONG_MEMORY_STORAGE_KEY, JSON.stringify(state));
    const setText = (selector, value) => { const node = q(selector); if (node) node.textContent = String(value ?? ''); };
    const lastEvidence = (cardId) => [...state.evidence].reverse().find((row) => row?.cardId === cardId) || null;
    const cardLabel = (item) => [item.displayId, item.title || item.cue || item.kpId].filter(Boolean).join(' · ');
    const cardContext = (item) => [item.canonicalId, item.blockLabel, item.blockTitle, item.groupLabel].filter(Boolean).join(' · ');

    const syncSummary = () => {
      const summary = memorySummary(state);
      Object.entries(summary).forEach(([key, value]) => setText(`[data-memory-summary="${key}"]`, value));
    };

    const tabs = qa('[data-memory-view]');
    const precisionButtons = qa('[data-precision-mode]');
    const queue = q('[data-memory-queue]');
    const empty = q('[data-memory-empty]');
    const card = q('[data-memory-card]');
    const markedCard = q('[data-memory-marked-card]');
    const repairCard = q('[data-memory-repair-card]');
    const answer = q('[data-memory-answer]');
    const revealGate = q('[data-memory-reveal-gate]');
    const ratings = q('[data-memory-ratings]');

    const selectedItem = () => currentItems[index] || null;
    const contextFor = (item) => {
      if (!item) {
        setText('[data-memory-context-title]', '—');
        setText('[data-memory-context-meta]', '—');
        setText('[data-memory-context-weight]', '—');
        setText('[data-memory-context-rating]', '—');
        return;
      }
      const owner = item.cardId ? state.cards[item.cardId] : item;
      const weightId = item.cardId || item.id;
      setText('[data-memory-context-title]', item.text || item.title || cardLabel(owner || item));
      setText('[data-memory-context-meta]', cardContext(owner || item) || item.origin || item.surface || '—');
      setText('[data-memory-context-weight]', weightId && state.cards[weightId] ? weakWeightForCard(state, weightId) : '—');
      setText('[data-memory-context-rating]', weightId ? (lastEvidence(weightId)?.rating || '—') : '—');
    };

    const renderHtml = (target, html) => {
      if (!target) return;
      target.replaceChildren();
      if (!html) return;
      const template = document.createElement('template');
      template.innerHTML = html;
      target.append(template.content.cloneNode(true));
    };

    const showCard = (item) => {
      if (!item) return;
      if (markedCard) markedCard.hidden = true;
      if (repairCard) repairCard.hidden = true;
      if (card) card.hidden = false;
      if (empty) empty.hidden = true;
      setText('[data-memory-card-family]', item.family === 'PRECISION' ? 'Precision' : 'Core');
      setText('[data-memory-card-title]', cardLabel(item));
      setText('[data-memory-card-context]', cardContext(item));
      setText('[data-memory-card-weight]', `Weak ${weakWeightForCard(state, item.id)}`);
      setText('[data-memory-card-resolution]', item.answerResolution || '');
      const prompt = q('[data-memory-prompt]');
      const promptSection = q('.xzMemoryPrompt');
      const precisionCue = q('[data-memory-precision-cue]');
      const editor = q('[data-memory-prompt-editor]');
      if (editor) editor.hidden = true;
      if (item.family === 'PRECISION') {
        if (promptSection) promptSection.hidden = true;
        if (precisionCue) precisionCue.hidden = false;
        setText('[data-memory-precision-cue-text]', item.cue);
        setText('[data-memory-source-locator]', item.sourceLocator || '');
        renderHtml(answer, item.answerHtml || item.ownerContextHtml || '');
      } else {
        if (promptSection) promptSection.hidden = false;
        if (precisionCue) precisionCue.hidden = true;
        if (prompt) prompt.textContent = resolvedCorePrompt(state, item);
        renderHtml(answer, item.coreHtml || '');
      }
      contextFor(item);
      const browse = item.family === 'PRECISION' && view === 'PRECISION' && precisionMode === 'BROWSE';
      revealed = browse;
      if (answer) answer.hidden = !revealed;
      if (revealGate) revealGate.hidden = browse;
      if (ratings) ratings.hidden = !revealed || browse;
      const requestButton = q('[data-memory-review-request]');
      if (requestButton) requestButton.textContent = state.attention?.[item.id]?.reviewRequested ? '移出 Today' : '加入 Today';
    };

    const showMarked = (item) => {
      if (!item) return;
      if (card) card.hidden = true;
      if (repairCard) repairCard.hidden = true;
      if (markedCard) markedCard.hidden = false;
      if (empty) empty.hidden = true;
      const owner = state.cards[item.cardId] || {};
      setText('[data-marked-title]', cardLabel(owner) || item.kpId);
      setText('[data-marked-context]', cardContext(owner));
      setText('[data-marked-text]', item.text);
      setText('[data-marked-surface]', `${item.surface} · ${new Date(item.createdAt).toLocaleString()}`);
    };

    const showRepair = (item) => {
      if (!item) return;
      if (card) card.hidden = true;
      if (markedCard) markedCard.hidden = true;
      if (repairCard) repairCard.hidden = false;
      if (empty) empty.hidden = true;
      const owner = state.cards[item.cardId] || {};
      setText('[data-repair-title]', item.title || cardLabel(owner) || item.kpId || '专项修补');
      setText('[data-repair-context]', [item.priority, item.origin, cardContext(owner)].filter(Boolean).join(' · '));
      setText('[data-repair-reason]', item.reason || '已由上游 evidence / Chat 指定为专项修补。');
      setText('[data-repair-action]', item.action || '按最小充分范围完成修补后返回主线。');
    };

    const makeQueueButton = (item, itemIndex, kind) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = itemIndex === index ? 'active' : '';
      const top = document.createElement('b');
      const body = document.createElement('span');
      const meta = document.createElement('small');
      if (kind === 'MARKS') {
        const owner = state.cards[item.cardId] || {};
        top.textContent = owner.displayId || item.kpId || 'Marked';
        body.textContent = item.text;
        meta.textContent = item.surface || 'fragment';
      } else if (kind === 'REPAIR') {
        top.textContent = item.priority || 'Repair';
        body.textContent = item.title || item.action || item.kpId || '专项修补';
        meta.textContent = item.origin || '';
      } else {
        top.textContent = item.family === 'PRECISION' ? 'P' : (item.displayId || 'Core');
        body.textContent = cardLabel(item);
        const weight = weakWeightForCard(state, item.id);
        meta.textContent = weight >= 1 ? `Weak ${weight}` : item.family === 'PRECISION' ? 'Precision' : cardContext(item);
      }
      button.append(top, body, meta);
      button.addEventListener('click', () => { index = itemIndex; renderCurrent(); });
      return button;
    };

    const renderCurrent = () => {
      if (!currentItems.length) {
        if (card) card.hidden = true;
        if (markedCard) markedCard.hidden = true;
        if (repairCard) repairCard.hidden = true;
        if (empty) empty.hidden = false;
        contextFor(null);
        return;
      }
      const result = selectMemoryView(state, view);
      const item = selectedItem();
      if (result.kind === 'MARKS') showMarked(item);
      else if (result.kind === 'REPAIR') showRepair(item);
      else showCard(item);
      qa('[data-memory-queue] > button').forEach((button, i) => button.classList.toggle('active', i === index));
    };

    const rebuild = () => {
      const note = viewNotes[view] || viewNotes.TODAY;
      setText('[data-memory-view-title]', note[0]);
      setText('[data-memory-view-note]', note[1]);
      tabs.forEach((button) => button.classList.toggle('active', button.getAttribute('data-memory-view') === view));
      const precisionModeRoot = q('[data-memory-precision-mode]');
      if (precisionModeRoot) precisionModeRoot.hidden = view !== 'PRECISION';
      const weakFilter = q('[data-memory-weak-only]');
      const weakLabel = q('.xzMemoryWeakFilter');
      if (weakLabel) weakLabel.hidden = !['TODAY', 'CORE', 'PRECISION'].includes(view);
      if (weakFilter instanceof HTMLInputElement) weakFilter.checked = weakOnly;

      const result = selectMemoryView(state, view);
      currentItems = result.items || [];
      if (weakOnly && result.kind === 'CARDS') currentItems = currentItems.filter((item) => weakWeightForCard(state, item.id) >= 1);
      index = Math.max(0, Math.min(currentItems.length - 1, index));
      setText('[data-memory-queue-count]', currentItems.length);
      setText('[data-memory-queue-kicker]', view === 'TODAY' ? 'Rolling queue' : view === 'REPAIR' ? 'Active repair' : `${view.toLowerCase()} library`);
      queue?.replaceChildren();
      currentItems.forEach((item, itemIndex) => queue?.append(makeQueueButton(item, itemIndex, result.kind)));
      syncSummary();
      renderCurrent();
    };

    tabs.forEach((button) => button.addEventListener('click', () => {
      view = button.getAttribute('data-memory-view') || 'TODAY';
      index = 0;
      revealed = false;
      rebuild();
    }));
    precisionButtons.forEach((button) => button.addEventListener('click', () => {
      precisionMode = button.getAttribute('data-precision-mode') || 'BROWSE';
      precisionButtons.forEach((candidate) => candidate.classList.toggle('active', candidate === button));
      revealed = false;
      renderCurrent();
    }));
    q('[data-memory-weak-only]')?.addEventListener('change', (event) => {
      weakOnly = event.target instanceof HTMLInputElement ? event.target.checked : false;
      index = 0;
      rebuild();
    });

    const reveal = () => {
      const item = selectedItem();
      if (!item || view === 'MARKED' || view === 'REPAIR') return;
      if (item.family === 'PRECISION' && view === 'PRECISION' && precisionMode === 'BROWSE') return;
      revealed = true;
      if (answer) answer.hidden = false;
      if (revealGate) revealGate.hidden = true;
      if (ratings) ratings.hidden = false;
    };
    q('[data-memory-reveal]')?.addEventListener('click', reveal);
    qa('[data-memory-rating]').forEach((button) => button.addEventListener('click', () => {
      const item = selectedItem();
      const rating = button.getAttribute('data-memory-rating') || '';
      if (!item?.id || !rating) return;
      state = appendMemoryEvidence(state, { cardId: item.id, rating, origin: item.family === 'PRECISION' ? 'PRECISION_MEMORY_RECALL' : 'CORE_MEMORY_RECALL' });
      save();
      revealed = false;
      if (view === 'TODAY') {
        const previousId = item.id;
        rebuild();
        const still = currentItems.findIndex((row) => row.id === previousId);
        if (still >= 0) index = still;
        else index = Math.min(index, Math.max(0, currentItems.length - 1));
      } else rebuild();
    }));

    q('[data-memory-review-request]')?.addEventListener('click', () => {
      const item = selectedItem();
      if (!item?.id) return;
      const requested = state.attention?.[item.id]?.reviewRequested !== true;
      state = requestMemoryReview(state, item.id, requested, requested ? 'LEARNER_REQUESTED' : '');
      save(); rebuild();
    });

    const promptEditor = q('[data-memory-prompt-editor]');
    const promptInput = q('[data-memory-prompt-input]');
    q('[data-memory-prompt-edit]')?.addEventListener('click', () => {
      const item = selectedItem();
      if (!item || item.family !== 'CORE') return;
      if (promptInput instanceof HTMLTextAreaElement) promptInput.value = resolvedCorePrompt(state, item);
      if (promptEditor) promptEditor.hidden = false;
    });
    q('[data-memory-prompt-cancel]')?.addEventListener('click', () => { if (promptEditor) promptEditor.hidden = true; });
    q('[data-memory-prompt-save]')?.addEventListener('click', () => {
      const item = selectedItem();
      if (!item?.kpId || !(promptInput instanceof HTMLTextAreaElement)) return;
      state = setPersonalPrompt(state, item.kpId, promptInput.value);
      save();
      if (promptEditor) promptEditor.hidden = true;
      renderCurrent();
    });
    q('[data-memory-prompt-reset]')?.addEventListener('click', () => {
      const item = selectedItem();
      if (!item?.kpId) return;
      state = setPersonalPrompt(state, item.kpId, '');
      save(); renderCurrent();
    });

    q('[data-memory-mark-selection]')?.addEventListener('click', () => {
      const item = selectedItem();
      if (!item || item.family !== 'CORE') return;
      const selection = window.getSelection();
      const fragment = selection?.toString().trim() || '';
      if (!fragment) return;
      const anchorElement = selection?.anchorNode instanceof Element ? selection.anchorNode : selection?.anchorNode?.parentElement;
      const surfaceNode = anchorElement?.closest?.('[data-mark-surface]');
      const surface = surfaceNode?.getAttribute('data-mark-surface') || '';
      if (!['PROMPT', 'CORE'].includes(surface)) return;
      state = addMarkedFragment(state, { cardId: item.id, kpId: item.kpId, surface, text: fragment });
      save(); syncSummary();
      selection?.removeAllRanges();
    });

    q('[data-marked-remove]')?.addEventListener('click', () => {
      const item = selectedItem();
      if (!item?.id) return;
      state = removeMarkedFragment(state, item.id);
      save();
      index = Math.min(index, Math.max(0, currentItems.length - 2));
      rebuild();
    });

    window.addEventListener('keydown', (event) => {
      const target = event.target;
      if (target instanceof HTMLTextAreaElement || target instanceof HTMLInputElement) return;
      if (event.code === 'Space') { event.preventDefault(); reveal(); }
      if (event.key === 'ArrowLeft' && currentItems.length) { event.preventDefault(); index = Math.max(0, index - 1); renderCurrent(); }
      if (event.key === 'ArrowRight' && currentItems.length) { event.preventDefault(); index = Math.min(currentItems.length - 1, index + 1); renderCurrent(); }
    });

    window.addEventListener('storage', (event) => {
      if (event.key !== XIZONG_MEMORY_STORAGE_KEY) return;
      state = read(); rebuild();
    });

    rebuild();
  }
</script>
