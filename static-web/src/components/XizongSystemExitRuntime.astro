<script>
const recallDialog=document.querySelector('[data-recall-dialog]');
if(recallDialog){
 const hide=()=>{recallDialog.querySelector('[data-recall-front]').hidden=false;recallDialog.querySelector('[data-recall-reveal]').hidden=true;};
 recallDialog.querySelector('[data-hide-recall]')?.addEventListener('click',hide);
 recallDialog.addEventListener('keydown',event=>{
  if(event.isComposing || event.keyCode===229 || event.target instanceof HTMLTextAreaElement || event.target instanceof HTMLInputElement)return;
  if(event.target instanceof HTMLButtonElement && (event.code==='Space'||event.key==='Enter'))return;
  if(event.code==='Space'){event.preventDefault();if(recallDialog.querySelector('[data-recall-reveal]').hidden)recallDialog.querySelector('[data-reveal-recall]').click();else hide();}
  if(event.key.toLowerCase()==='c'){event.preventDefault();recallDialog.querySelector('[data-recall-scratch]').focus();}
  if(event.key==='Enter'&&!recallDialog.querySelector('[data-recall-reveal]').hidden){event.preventDefault();recallDialog.querySelector('[data-complete-recall]').click();}
 });
}
</script>
