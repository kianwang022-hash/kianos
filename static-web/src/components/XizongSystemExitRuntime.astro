---
const { system, practiceHref } = Astro.props;

const recall = system?.systemRecall || {};
const recallPrompt = typeof recall === 'string'
  ? recall
  : String(recall?.neutral_front || recall?.prompt || recall?.question || '先闭卷恢复整个系统，再核对模型。');
const recallSteps = Array.isArray(recall?.reverse_case_algorithm)
  ? recall.reverse_case_algorithm
  : Array.isArray(recall?.algorithm) ? recall.algorithm : [];
const freeReconstruction = Array.isArray(recall?.free_reconstruction) ? recall.free_reconstruction : [];
const spine = Array.isArray(system?.mentalModel?.spine) ? system.mentalModel.spine : [];
const parallelControls = Array.isArray(system?.mentalModel?.parallelControls) ? system.mentalModel.parallelControls : [];
const failureModes = Array.isArray(system?.failureModes) ? system.failureModes : [];
const failureLabel = (mode) => Array.isArray(mode)
  ? [mode[1], mode[2]].filter(Boolean).join('：')
  : [mode?.label, mode?.chain].filter(Boolean).join('：');
---
<section class="xse xseRecallOnly" id="system-exit" data-xizong-system-exit={system.systemId}>
  <section class="xseCompletionWorkbench">
    <section class="xseRecallWorkspace" data-recall-workspace>
      <div class="xseRecallStage">
        <header class="xseRecallStageHead">
          <div>
            <span class="xseEyebrow">{system.canonicalId} · System Recall</span>
            <h3>闭卷恢复 {system.title}</h3>
          </div>
          <strong data-recall-status>还没完成本次 System Recall</strong>
        </header>

        <div class="xseRecallAxes" aria-label="Reconstruction dimensions">
          <span>重建维度</span>
          <strong>系统主链</strong>
          <strong>并行控制</strong>
          <strong>Failure 定位</strong>
          <strong>病例判断顺序</strong>
          <small>只给维度，不提前给答案。</small>
        </div>

        <section class="xseRecallFront" data-recall-front>
          <p class="xseRecallPrompt">{recallPrompt}</p>
          <div class="xseRecallInstruction">
            <b>先闭卷恢复，不回看 Framework。</b>
            <span>脑内、口述或纸写都可以。网页不要求额外输入，也不把“写了草稿”当成学习证据。</span>
          </div>
          <div class="xseRecallActions">
            <button type="button" data-reveal-recall>Space · 核对模型</button>
          </div>
        </section>

        <section class="xseRecallReveal" data-recall-reveal hidden>
          <div class="xseRecallPaper">
            {spine.length > 0 && (
              <section>
                <span>系统主链</span>
                <ol>{spine.map((item) => <li>{item}</li>)}</ol>
              </section>
            )}

            {parallelControls.length > 0 && (
              <section>
                <span>并行控制</span>
                <ul>{parallelControls.map((item) => <li>{item}</li>)}</ul>
              </section>
            )}

            {freeReconstruction.length > 0 && (
              <section>
                <span>自由重建核对</span>
                <ol>{freeReconstruction.map((item) => <li>{item}</li>)}</ol>
              </section>
            )}

            {failureModes.length > 0 && (
              <section>
                <span>Failure Modes</span>
                <ul>{failureModes.map((mode) => <li>{failureLabel(mode)}</li>)}</ul>
              </section>
            )}

            {recallSteps.length > 0 && (
              <section>
                <span>陌生病例顺序</span>
                <ol>{recallSteps.map((item) => <li>{typeof item === 'string' ? item : JSON.stringify(item)}</li>)}</ol>
              </section>
            )}
          </div>

          <div class="xseRecallActions">
            <button type="button" class="secondary" data-reveal-recall-back>Space · 再闭卷一次</button>
            <button type="button" data-complete-recall>Enter · 完成本次 Recall</button>
          </div>
        </section>
      </div>
    </section>

    <section class="xsePracticeHandoff" data-practice-handoff hidden>
      <div>
        <span>System Recall 已完成</span>
        <strong>{practiceHref ? '现在进入训练，用题目验证模型。' : '本次系统重建已经闭合。'}</strong>
        <p>{practiceHref ? '训练区会直接使用当前 System 的正式题目；后续二轮、整卷和后期仍在同一个训练工作区完成。' : '训练范围和 System Recall 分开管理；这里不会因为当前训练题还没准备好而阻塞系统重建。'}</p>
      </div>
      <div>
        <button type="button" class="secondary" data-start-recall>再 Recall 一次</button>
        {practiceHref && <a href={practiceHref}>进入训练 · {system.canonicalId} →</a>}
      </div>
    </section>
  </section>
</section>

<script>
  document.querySelectorAll('[data-xizong-system-exit]').forEach((root) => {
    const systemId = root.getAttribute('data-xizong-system-exit') || '';
    const recallKey = `kianos:xizong:system-recall:${systemId}:v1`;
    const readJson = (key, fallback) => {
      try { return JSON.parse(localStorage.getItem(key) || '') || fallback; } catch { return fallback; }
    };
    const writeJson = (key, value) => {
      try { localStorage.setItem(key, JSON.stringify(value)); return true; } catch { return false; }
    };

    let recallState = readJson(recallKey, { completedAt: null });
    const workspace = root.querySelector('[data-recall-workspace]');
    const front = root.querySelector('[data-recall-front]');
    const reveal = root.querySelector('[data-recall-reveal]');
    const status = root.querySelector('[data-recall-status]');
    const handoff = root.querySelector('[data-practice-handoff]');
    const startRecall = root.querySelector('[data-start-recall]');
    const revealButton = root.querySelector('[data-reveal-recall]');
    const revealBack = root.querySelector('[data-reveal-recall-back]');
    const complete = root.querySelector('[data-complete-recall]');

    const render = () => {
      const completed = Boolean(recallState.completedAt);
      if (workspace instanceof HTMLElement) workspace.hidden = completed;
      if (handoff instanceof HTMLElement) handoff.hidden = !completed;
      if (status) status.textContent = completed ? '本次 System Recall 已完成' : '还没完成本次 System Recall';
    };

    const openRecall = () => {
      if (handoff instanceof HTMLElement) handoff.hidden = true;
      if (workspace instanceof HTMLElement) workspace.hidden = false;
      front.hidden = false;
      reveal.hidden = true;
      workspace?.scrollIntoView({ behavior:'smooth', block:'start' });
    };

    startRecall?.addEventListener('click', openRecall);
    revealButton?.addEventListener('click', () => {
      front.hidden = true;
      reveal.hidden = false;
    });
    revealBack?.addEventListener('click', () => {
      reveal.hidden = true;
      front.hidden = false;
    });
    complete?.addEventListener('click', () => {
      recallState = { completedAt:new Date().toISOString() };
      if (!writeJson(recallKey, recallState)) {
        window.alert('本机保存失败：System Recall 没有记录完成。');
        return;
      }
      render();
      handoff?.scrollIntoView({ behavior:'smooth', block:'nearest' });
    });

    document.addEventListener('keydown', (event) => {
      if (root.inert || event.repeat) return;
      const target = event.target;
      if (target instanceof HTMLElement && target.closest('input,textarea,select,[contenteditable="true"]')) return;
      if (!(workspace instanceof HTMLElement) || workspace.hidden) return;
      if (event.code === 'Space') {
        event.preventDefault();
        if (!reveal.hidden) revealBack?.click();
        else revealButton?.click();
      } else if (event.key === 'Enter' && !reveal.hidden) {
        event.preventDefault();
        complete?.click();
      }
    });

    render();
  });
</script>
