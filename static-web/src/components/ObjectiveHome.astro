---
const {
  sets = [],
  route = '',
  label = 'Objective',
  headline = '完整做一组，按需复盘',
  description = '',
  unitLabel = 'sets',
  lastLocationKey = '',
  learningHref = '',
  learningSummary = '第一次系统学习时先建立题型认知模型；平时训练可直接 Continue。'
} = Astro.props;
const base = import.meta.env.BASE_URL;
const payload = JSON.stringify(sets).replace(/</g, '\\u003c');
const first = sets[0];
---
<section class="objectiveHome" data-objective-home data-base={base} data-route={route} data-last-key={lastLocationKey}>
  <section class="objectiveHomeHero">
    <div>
      <span>{label} · Current</span>
      <h2>{headline}</h2>
      <p>{description}</p>
    </div>
    <aside>
      <strong>{sets.length} {unitLabel}</strong>
      <span>Current source only</span>
      <span>passage / set-level review</span>
    </aside>
  </section>

  {learningHref && (
    <a class="objectiveLearnEntry" href={learningHref}>
      <div><span>First Learning</span><strong>先建立 {label} 的做题框架</strong></div>
      <p>{learningSummary}</p>
      <b>学习框架 →</b>
    </a>
  )}

  <section class="objectiveHomeGrid">
    <a class="objectiveContinue" data-objective-continue href={first ? `${base}${route}/${encodeURIComponent(first.id)}/` : `${base}${route}/`}>
      <span data-catalog-entry-label>打开一组</span>
      <strong data-objective-continue-title>{first?.title || `开始 ${label}`}</strong>
      <p data-objective-continue-meta>{first ? `第 1 / ${sets.length} 组` : 'Current task 暂不可用'}</p>
    </a>

    <section class="objectiveBrowse">
      <header>
        <div><span>Navigate</span><strong>Current {unitLabel}</strong></div>
        <input type="search" data-objective-search placeholder="搜索年份 / set id / 标题" />
      </header>
      <div data-objective-results></div>
    </section>
  </section>

  <script type="application/json" data-objective-catalog set:html={payload}></script>
</section>

<script>
  document.querySelectorAll('[data-objective-home]').forEach((node) => {
    if (!(node instanceof HTMLElement)) return;
    const base = node.getAttribute('data-base') || '/';
    const route = node.getAttribute('data-route') || '';
    const lastKey = node.getAttribute('data-last-key') || '';
    let sets = [];
    try { sets = JSON.parse(node.querySelector('[data-objective-catalog]')?.textContent || '[]'); } catch {}
    const hrefFor = (id) => `${base}${route}/${encodeURIComponent(id)}/`;

    let last = null;
    try { last = lastKey ? JSON.parse(localStorage.getItem(lastKey) || 'null') : null; } catch {}
    const continueLink = node.querySelector('[data-objective-continue]');
    if (last?.id && continueLink instanceof HTMLAnchorElement && sets.some((item) => item.id === last.id)) {
      const fallback = hrefFor(last.id);
      try {
        const target = new URL(last.href || fallback, location.origin);
        continueLink.href = target.origin === location.origin && !target.username && !target.password
          && [fallback, fallback.slice(0,-1)].includes(target.pathname)
          ? target.pathname + target.search + target.hash : fallback;
      } catch { continueLink.href = fallback; }
      node.querySelector('[data-catalog-entry-label]').textContent = '最近查看';
      const title = node.querySelector('[data-objective-continue-title]');
      const meta = node.querySelector('[data-objective-continue-meta]');
      if (title) title.textContent = last.title || last.id;
      if (meta) meta.textContent = `${last.year || last.paperId || 'English I'} · 第 ${last.position || '?'} / ${last.total || sets.length} 组 · 最近打开`;
    }

    const results = node.querySelector('[data-objective-results]');
    const render = (query = '') => {
      if (!results) return;
      const q = String(query || '').trim().toLowerCase();
      const visible = sets.filter((item) => {
        if (!q) return true;
        return [item.id, item.title, item.paperId, item.year, item.section].some((value) => String(value || '').toLowerCase().includes(q));
      }).slice(0, q ? 50 : 20);
      results.replaceChildren();
      visible.forEach((item) => {
        const link = document.createElement('a');
        link.href = hrefFor(item.id);
        const copy = document.createElement('div');
        const title = document.createElement('strong');
        title.textContent = item.title || item.id;
        const meta = document.createElement('span');
        meta.textContent = `${item.year || item.paperId || 'English I'} · ${item.id}`;
        copy.append(title, meta);
        const pos = document.createElement('small');
        pos.textContent = `${item.position} / ${item.total}`;
        link.append(copy, pos);
        results.appendChild(link);
      });
      if (!visible.length) {
        const empty = document.createElement('p');
        empty.textContent = '没有匹配的 Current set。';
        results.appendChild(empty);
      }
    };
    node.querySelector('[data-objective-search]')?.addEventListener('input', (event) => render(event.currentTarget.value || ''));
    render();
  });
</script>

<style>
  .objectiveHome{max-width:72rem;margin:0 auto;display:grid;gap:12px}.objectiveHomeHero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px;align-items:end;padding:24px 26px;border:1px solid var(--study-line);border-radius:16px;background:#fff;box-shadow:var(--study-shadow)}.objectiveHomeHero>div>span,.objectiveBrowse header span,.objectiveContinue>span,.objectiveLearnEntry span{color:var(--study-green);font-size:9px;font-weight:850;letter-spacing:.08em;text-transform:uppercase}.objectiveHomeHero h2{margin:5px 0 8px;font-size:27px}.objectiveHomeHero p{max-width:74ch;margin:0;color:var(--study-muted);font-size:13px;line-height:1.7}.objectiveHomeHero aside{display:grid;gap:3px;padding-left:20px;border-left:1px solid var(--study-line)}.objectiveHomeHero aside strong{color:var(--study-green)}.objectiveHomeHero aside span{color:var(--study-faint);font-size:10px}
  .objectiveLearnEntry{display:grid;grid-template-columns:minmax(220px,.8fr) minmax(0,1.3fr) auto;gap:18px;align-items:center;padding:14px 18px;border:1px solid #cfe2d8;border-radius:13px;background:var(--study-green-soft);color:inherit;text-decoration:none}.objectiveLearnEntry>div{display:grid;gap:3px}.objectiveLearnEntry strong{font-size:14px}.objectiveLearnEntry p{margin:0;color:var(--study-muted);font-size:11px;line-height:1.55}.objectiveLearnEntry b{color:var(--study-green);font-size:11px;white-space:nowrap}
  .objectiveHomeGrid{display:grid;grid-template-columns:minmax(260px,.72fr) minmax(0,1.28fr);gap:12px}.objectiveContinue,.objectiveBrowse{padding:20px;border:1px solid var(--study-line);border-radius:14px;background:#fff;color:inherit}.objectiveContinue{display:grid;align-content:start;gap:6px;text-decoration:none}.objectiveContinue strong{font-size:22px;line-height:1.35}.objectiveContinue p{margin:0;color:var(--study-muted);font-size:12px;line-height:1.6}.objectiveBrowse header{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-bottom:12px}.objectiveBrowse header>div{display:grid;gap:3px}.objectiveBrowse header input{width:min(280px,48%);padding:8px 10px;border:1px solid var(--study-line);border-radius:9px;font:inherit}.objectiveBrowse [data-objective-results]{display:grid;gap:5px}.objectiveBrowse [data-objective-results]>a{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:9px 10px;border-radius:9px;color:inherit;text-decoration:none}.objectiveBrowse [data-objective-results]>a:hover{background:var(--study-green-soft)}.objectiveBrowse [data-objective-results] div{display:grid;gap:2px;min-width:0}.objectiveBrowse [data-objective-results] strong{font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.objectiveBrowse [data-objective-results] span,.objectiveBrowse [data-objective-results] small{color:var(--study-faint);font-size:9px}.objectiveBrowse [data-objective-results]>p{color:var(--study-muted);font-size:12px}@media(max-width:820px){.objectiveHomeHero,.objectiveHomeGrid,.objectiveLearnEntry{grid-template-columns:1fr}.objectiveHomeHero aside{padding:12px 0 0;border-left:0;border-top:1px solid var(--study-line)}.objectiveBrowse header{align-items:stretch;flex-direction:column}.objectiveBrowse header input{width:100%;box-sizing:border-box}}
</style>