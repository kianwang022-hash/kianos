---
const { block } = Astro.props;
const kps = block?.kpRecords || [];
const reserveItems = (block?.pathways?.outgoing || [])
  .filter((row) => row?.reserveLearning === true)
  .map((row) => ({
    id: row.id,
    cue: row?.source?.cue || '',
    sourceGroupId: row?.source?.logic_group_id || '',
    targetBlockId: row?.target?.block_id || '',
    targetGroupId: row?.target?.logic_group_id || '',
    returnCue: row?.target?.cue || ''
  }));
---
<section class="portedStudyExtension xv6MemoryReview" data-study-extension data-study-object={block.objectId} data-study-source-hash={block.sourceHash}>
  <header class="portedExtensionHeader">
    <div>
      <span>After Learn</span>
      <h3>{block.label} · Memory / 储备 / Review</h3>
      <p>正式学过但不稳的东西进 Memory；未来重要但现在不展开的放在储备；两者不混。</p>
    </div>
    <nav>
      <button type="button" class="active" data-extension-tab="memory">Memory</button>
      <button type="button" data-extension-tab="reserve">储备</button>
      <button type="button" data-extension-tab="review">Review</button>
    </nav>
  </header>

  <section data-extension-panel="memory">
    <div class="portedMemorySummary">
      <strong data-memory-summary>等待 Recall 状态</strong>
      <span>只收正式学过的薄弱 KP；4 · 稳定后退出当前薄弱队列。</span>
    </div>
    <div class="portedPrecisionShell">
      <aside data-memory-queue></aside>
      <main><article class="portedPrecisionCard">
        <span data-memory-meta>薄弱 Memory</span>
        <h4 data-memory-title>暂无待练项</h4>
        <p data-memory-prompt>完成 KP Recall 后，不稳项才进入这里。</p>
        <button type="button" class="portedPrimaryAction" data-memory-reveal disabled>Reveal</button>
        <div class="portedPrecisionAnswer markdown" data-memory-answer hidden></div>
        <footer data-memory-actions hidden>
          <button type="button" data-memory-response="HOT">不稳</button>
          <button type="button" data-memory-response="WARM">勉强</button>
          <button type="button" data-memory-response="STABLE">稳定</button>
        </footer>
      </article></main>
    </div>
    <small class="xv6RoleNote">Precision 是“最终要记多精确”的属性，不是这条 Memory 队列。全量内容审计完成前，网页不会从正文自动抓数字冒充 Precision。</small>
  </section>

  <section data-extension-panel="reserve" hidden>
    <div class="xv6ReserveIntro">
      <span>储备学习</span>
      <strong>现在先混个脸熟，不要求完整 Recall。</strong>
      <p>这些关系后面会反复用到，所以现在值得提前看一眼；到正式 Block 时系统会主动把它们重新叫回来。</p>
    </div>
    {reserveItems.length > 0 ? (
      <div class="xv6ReserveList">
        {reserveItems.map((item) => <article>
          <span>先留个印象</span>
          <p>{item.cue}</p>
          <small>正式展开：{item.targetBlockId.replace('respiratory-', '').toUpperCase()} · 到时自动回收</small>
        </article>)}
      </div>
    ) : (
      <p class="xv6ReserveEmpty">这个 Block 没有需要提前占用注意力的储备项。</p>
    )}
    <small class="xv6RoleNote">储备不会进入普通 Memory，也不要求现在评分。普通“后面会接”的串联路牌甚至不会进这里，只在正式 owner 到来时重新提示。</small>
  </section>

  <section data-extension-panel="review" hidden>
    <div class="portedReviewToolbar">
      <div><span>Review · Chat loop</span><strong data-review-summary>等待本机薄弱项</strong></div>
      <div><button type="button" data-review-export>复制今日学习包</button><button type="button" data-review-import-toggle>导入 Chat 计划</button></div>
    </div>
    <div class="portedReviewImport" data-review-import hidden>
      <textarea rows="5" data-review-import-text placeholder='粘贴 JSON，例如 {"kp_ids":["circulation-b01-kp02"]}'></textarea>
      <button type="button" data-review-apply>应用计划</button>
      <small>只接受当前 Block 存在的 KP ID。</small>
    </div>
    <div class="portedReviewWorkspace">
      <aside data-review-queue></aside>
      <article class="portedReviewCard">
        <span>Active Review</span>
        <h4 data-review-title>暂无待复习项</h4>
        <p data-review-prompt>先完成 Recall，或导入 Chat 返回的 KP 列表。</p>
        <button type="button" data-review-reveal disabled>Reveal</button>
        <div class="portedReviewAnswer markdown" data-review-answer hidden></div>
        <footer data-review-ratings hidden>
          <button type="button" data-review-rating="unknown">1 · 没记住</button>
          <button type="button" data-review-rating="fuzzy">2 · 模糊</button>
          <button type="button" data-review-rating="known">3 · 会了</button>
          <button type="button" data-review-rating="mastered">4 · 稳定</button>
        </footer>
      </article>
    </div>
  </section>

  <script type="application/json" data-study-kp-payload set:html={JSON.stringify(kps.map((kp) => ({
    kpId: kp.kpId,
    displayId: kp.displayId,
    title: kp.title,
    prompt: kp.prompt,
    detailHtml: kp.detailHtml
  })))}></script>
</section>

<script>
  const extension = document.querySelector('.xv6MemoryReview[data-study-extension]');
  if (extension) {
    const objectId = extension.getAttribute('data-study-object') || 'xizong:unknown';
    const sourceHash = extension.getAttribute('data-study-source-hash') || '';
    const stateKey = `kianos-xizong-astro-v2:${objectId}`;
    const extensionKey = `kianos-xizong-memory-review-v2:${objectId}`;
    let kps = [];
    try { kps = JSON.parse(extension.querySelector('[data-study-kp-payload]')?.textContent || '[]'); } catch {}
    let ext = { memory: {}, memoryIndex: 0, reviewPlan: [], reviewIndex: 0, reviewRatings: {} };
    try { ext = { ...ext, ...(JSON.parse(localStorage.getItem(extensionKey) || 'null') || {}) }; } catch {}
    const readStudy = () => { try { return JSON.parse(localStorage.getItem(stateKey) || 'null') || {}; } catch { return {}; } };
    const writeStudy = (study) => { try { localStorage.setItem(stateKey, JSON.stringify(study)); } catch {} };
    const saveExt = () => { try { localStorage.setItem(extensionKey, JSON.stringify(ext)); } catch {} };
    const byId = new Map(kps.map((kp) => [kp.kpId, kp]));
    const ratingState = (value) => value === 'unknown' || value === 'fuzzy' ? 'HOT' : value === 'known' ? 'WARM' : value === 'mastered' ? 'STABLE' : '';
    const memoryItems = () => {
      const study = readStudy();
      const rows = kps.map((kp) => ({ ...kp, sourceRating: study.ratings?.[kp.kpId] || '', memoryState: ext.memory?.[kp.kpId] || ratingState(study.ratings?.[kp.kpId]) || '' }));
      const weak = rows.filter((row) => ['HOT', 'WARM'].includes(row.memoryState));
      return weak.length ? weak : rows.filter((row) => row.sourceRating && row.memoryState !== 'STABLE');
    };

    const tabs = [...extension.querySelectorAll('[data-extension-tab]')];
    const panels = [...extension.querySelectorAll('[data-extension-panel]')];
    const switchTab = (name) => {
      tabs.forEach((button) => button.classList.toggle('active', button.getAttribute('data-extension-tab') === name));
      panels.forEach((panel) => { panel.hidden = panel.getAttribute('data-extension-panel') !== name; });
      if (name === 'memory') renderMemory();
      if (name === 'review') renderReview();
    };
    tabs.forEach((button) => button.addEventListener('click', () => switchTab(button.getAttribute('data-extension-tab') || 'memory')));

    const memoryQueue = extension.querySelector('[data-memory-queue]');
    const memoryTitle = extension.querySelector('[data-memory-title]');
    const memoryPrompt = extension.querySelector('[data-memory-prompt]');
    const memoryMeta = extension.querySelector('[data-memory-meta]');
    const memoryAnswer = extension.querySelector('[data-memory-answer]');
    const memoryReveal = extension.querySelector('[data-memory-reveal]');
    const memoryActions = extension.querySelector('[data-memory-actions]');
    const memorySummary = extension.querySelector('[data-memory-summary]');
    function renderMemory() {
      const items = memoryItems();
      ext.memoryIndex = Math.max(0, Math.min(items.length - 1, Number(ext.memoryIndex || 0)));
      if (memorySummary) {
        const hot = items.filter((item) => item.memoryState === 'HOT').length;
        const warm = items.filter((item) => item.memoryState === 'WARM').length;
        memorySummary.textContent = items.length ? `${items.length} 项 · 不稳 ${hot} · 勉强 ${warm}` : '当前没有薄弱 Memory 项';
      }
      memoryQueue?.replaceChildren();
      items.forEach((item, index) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = index === ext.memoryIndex ? 'active' : '';
        button.innerHTML = `<b>${item.displayId || item.kpId}</b><span>${item.title}</span><small>${item.memoryState === 'HOT' ? '不稳' : item.memoryState === 'WARM' ? '勉强' : '—'}</small>`;
        button.addEventListener('click', () => { ext.memoryIndex = index; saveExt(); renderMemory(); });
        memoryQueue?.appendChild(button);
      });
      const current = items[ext.memoryIndex];
      if (memoryTitle) memoryTitle.textContent = current ? `${current.displayId || current.kpId}｜${current.title}` : '暂无待练项';
      if (memoryPrompt) memoryPrompt.textContent = current?.prompt || (current ? '先回忆，再翻面。' : '完成 KP Recall 后，不稳项才进入这里。');
      if (memoryMeta) memoryMeta.textContent = current ? `${current.memoryState === 'HOT' ? '不稳' : '勉强'} · ${ext.memoryIndex + 1}/${items.length}` : '薄弱 Memory';
      if (memoryReveal) { memoryReveal.disabled = !current; memoryReveal.hidden = false; }
      if (memoryAnswer) { memoryAnswer.hidden = true; memoryAnswer.innerHTML = current?.detailHtml || ''; }
      if (memoryActions) memoryActions.hidden = true;
      saveExt();
    }
    memoryReveal?.addEventListener('click', () => {
      if (memoryAnswer) memoryAnswer.hidden = false;
      if (memoryActions) memoryActions.hidden = false;
      memoryReveal.hidden = true;
    });
    extension.querySelectorAll('[data-memory-response]').forEach((button) => button.addEventListener('click', () => {
      const items = memoryItems();
      const current = items[ext.memoryIndex];
      if (!current) return;
      ext.memory = { ...(ext.memory || {}), [current.kpId]: button.getAttribute('data-memory-response') || 'WARM' };
      ext.memoryIndex = Math.min(ext.memoryIndex, Math.max(0, memoryItems().length - 1));
      saveExt();
      renderMemory();
    }));

    const reviewQueue = extension.querySelector('[data-review-queue]');
    const reviewTitle = extension.querySelector('[data-review-title]');
    const reviewPrompt = extension.querySelector('[data-review-prompt]');
    const reviewAnswer = extension.querySelector('[data-review-answer]');
    const reviewReveal = extension.querySelector('[data-review-reveal]');
    const reviewRatings = extension.querySelector('[data-review-ratings]');
    const reviewSummary = extension.querySelector('[data-review-summary]');
    const defaultReviewIds = () => memoryItems().map((item) => item.kpId);
    const activeReview = () => (ext.reviewPlan?.length ? ext.reviewPlan : defaultReviewIds()).map((id) => byId.get(id)).filter(Boolean);
    function renderReview() {
      const items = activeReview();
      ext.reviewIndex = Math.max(0, Math.min(items.length - 1, Number(ext.reviewIndex || 0)));
      if (reviewSummary) reviewSummary.textContent = items.length ? `${items.length} 个 KP 待复习` : '当前没有待复习项';
      reviewQueue?.replaceChildren();
      items.forEach((item, index) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = index === ext.reviewIndex ? 'active' : '';
        const rating = ext.reviewRatings?.[item.kpId] || readStudy().ratings?.[item.kpId] || '';
        button.innerHTML = `<b>${item.displayId || item.kpId}</b><span>${item.title}</span><small>${rating || '待复习'}</small>`;
        button.addEventListener('click', () => { ext.reviewIndex = index; saveExt(); renderReview(); });
        reviewQueue?.appendChild(button);
      });
      const current = items[ext.reviewIndex];
      if (reviewTitle) reviewTitle.textContent = current ? `${current.displayId || current.kpId}｜${current.title}` : '暂无待复习项';
      if (reviewPrompt) reviewPrompt.textContent = current?.prompt || (current ? '先主动恢复，再 Reveal。' : '可导入 Chat 返回的 KP 列表。');
      if (reviewAnswer) { reviewAnswer.hidden = true; reviewAnswer.innerHTML = current?.detailHtml || ''; }
      if (reviewReveal) { reviewReveal.disabled = !current; reviewReveal.hidden = false; }
      if (reviewRatings) reviewRatings.hidden = true;
      saveExt();
    }
    reviewReveal?.addEventListener('click', () => {
      if (reviewAnswer) reviewAnswer.hidden = false;
      if (reviewRatings) reviewRatings.hidden = false;
      reviewReveal.hidden = true;
    });
    extension.querySelectorAll('[data-review-rating]').forEach((button) => button.addEventListener('click', () => {
      const items = activeReview();
      const current = items[ext.reviewIndex];
      if (!current) return;
      const value = button.getAttribute('data-review-rating') || '';
      ext.reviewRatings = { ...(ext.reviewRatings || {}), [current.kpId]: value };
      const study = readStudy();
      study.ratings = { ...(study.ratings || {}), [current.kpId]: value };
      writeStudy(study);
      ext.reviewIndex = Math.min(ext.reviewIndex + 1, Math.max(0, items.length - 1));
      saveExt();
      renderReview();
    }));

    const importBox = extension.querySelector('[data-review-import]');
    extension.querySelector('[data-review-import-toggle]')?.addEventListener('click', () => { if (importBox) importBox.hidden = !importBox.hidden; });
    extension.querySelector('[data-review-apply]')?.addEventListener('click', () => {
      const text = extension.querySelector('[data-review-import-text]')?.value || '';
      try {
        const parsed = JSON.parse(text);
        const ids = (parsed.kp_ids || parsed.items || []).map((item) => typeof item === 'string' ? item : item?.kp_id).filter((id) => byId.has(id));
        ext.reviewPlan = [...new Set(ids)];
        ext.reviewIndex = 0;
        saveExt();
        renderReview();
        if (importBox) importBox.hidden = true;
      } catch { window.alert('Review plan JSON 无法解析。'); }
    });
    extension.querySelector('[data-review-export]')?.addEventListener('click', async () => {
      const study = readStudy();
      const packet = {
        schema: 'kianos.xizong.review_packet.v1',
        object_id: objectId,
        source_hash: sourceHash,
        kp_ids: defaultReviewIds(),
        ratings: study.ratings || {},
        memory: ext.memory || {},
        instruction: '请基于这些 Current KP 生成简洁复习顺序，只返回 kp_ids，不改写知识内容。'
      };
      const text = JSON.stringify(packet, null, 2);
      try { await navigator.clipboard.writeText(text); } catch { window.prompt('复制 Review Packet', text); }
    });
    renderMemory();
    renderReview();
  }
</script>

<style>
  .xv6ReserveIntro{display:grid;gap:5px;padding:12px 14px;border-bottom:1px solid var(--study-line,#d9dde5)}.xv6ReserveIntro>span{color:var(--study-green,#286c57);font-size:9px;font-weight:850;letter-spacing:.06em}.xv6ReserveIntro strong{font-size:14px}.xv6ReserveIntro p,.xv6RoleNote,.xv6ReserveEmpty{margin:0;color:var(--study-muted,#6d7873);font-size:10px;line-height:1.55}.xv6ReserveList{display:grid;gap:7px;padding:12px 14px}.xv6ReserveList article{padding:9px 10px;border:1px solid var(--study-line,#d9dde5);border-radius:9px;background:var(--study-surface-muted,#f5f6f8)}.xv6ReserveList article>span{color:var(--study-green,#286c57);font-size:8px;font-weight:850}.xv6ReserveList p{margin:4px 0;font-size:11px;line-height:1.55}.xv6ReserveList small{color:var(--study-muted,#6d7873);font-size:8px}.xv6ReserveEmpty{padding:14px}.xv6RoleNote{display:block;padding:9px 14px;border-top:1px solid var(--study-line,#d9dde5)}
</style>
