---
const { translation, reference } = Astro.props;
const base = import.meta.env.BASE_URL;
const prompts = translation.prompts || [];
const material = translation.material || [];
const materialTexts = new Set(material.map((item) => String(item.text || '').trim()).filter(Boolean));
const promptSegments = prompts.filter((item) => {
  const text = String(item.sourceText || '').trim();
  return text && !materialTexts.has(text);
});
const referencePayload = JSON.stringify(reference || {}).replace(/</g, '\\u003c');
const promptPayload = JSON.stringify(prompts).replace(/</g, '\\u003c');
const previousHref = translation.navigation?.previousId
  ? `${base}translation/${encodeURIComponent(translation.navigation.previousId)}/`
  : '';
const nextHref = translation.navigation?.nextId
  ? `${base}translation/${encodeURIComponent(translation.navigation.nextId)}/`
  : '';
---
<section
  class="translationRuntime"
  data-translation-runtime
  data-object-id={translation.objectId}
  data-title={translation.title}
  data-paper-id={translation.paperId || ''}
  data-position={translation.navigation?.position || 1}
  data-total={translation.navigation?.total || 1}
  data-base={base}
>
  <header class="translationHeader">
    <a class="translationBack" href={`${base}translation/`}>‹ Translation</a>
    <div>
      <span>Productive lane · whole task/set</span>
      <h1>{translation.title}</h1>
      <small>{translation.paperId || 'English I'} · {translation.navigation?.position || 1} / {translation.navigation?.total || 1} · <b data-translation-stage-label>Clean Attempt</b></small>
    </div>
    <nav aria-label="Translation set navigation">
      {previousHref ? <a href={previousHref}>‹ 上一套</a> : <span>‹ 上一套</span>}
      {nextHref ? <a href={nextHref}>下一套 ›</a> : <span>下一套 ›</span>}
    </nav>
  </header>

  <div class="translationColumns">
    <article class="translationSource">
      <header>
        <span>Source stays visible</span>
        <h2>原文 / Task</h2>
      </header>
      {translation.context?.instruction && <p class="translationInstruction">{translation.context.instruction}</p>}
      {translation.context?.subtitle && <p class="translationSubtitle">{translation.context.subtitle}</p>}

      <div class="translationSourceBody" data-translation-source-text>
        {material.map((item) => <p>{item.text}</p>)}
        {promptSegments.map((item) => (
          <section class="translationSegment">
            {prompts.length > 1 && <small>Segment {item.ordinal}</small>}
            {item.instruction && <em>{item.instruction}</em>}
            <p>{item.sourceText}</p>
          </section>
        ))}
        {!material.length && !promptSegments.length && (
          <p class="translationMissing">Current source projection is empty. Runtime validation should block this build.</p>
        )}
      </div>

      <section class="translationPending" data-pending-panel hidden>
        <header><span>Transfer Pending</span><strong data-pending-count>0</strong></header>
        <div data-pending-list></div>
        <small>这些是过去 repair 后仍等待新材料验证的可复用能力点；当前题不相关时不会自动算证据。</small>
      </section>

      <details class="translationProvenance">
        <summary>Current provenance</summary>
        <code>{translation.sourcePaths?.questions}</code>
        <code>{translation.sourcePaths?.contract}</code>
        <code>question-bank:{translation.sourceHashes?.questionOwner?.slice(0, 12)}</code>
        <code>task:{translation.sourceHashes?.renderedObject?.slice(0, 12)}</code>
        <code>reference:{translation.referenceCoverage?.available || 0}/{translation.referenceCoverage?.total || prompts.length}</code>
      </details>
    </article>

    <section class="translationWork">
      <section class="translationStage" data-stage="attempt">
        <header>
          <span>01 · Clean Attempt</span>
          <h2>完整做完这一套</h2>
          <p>Review unit 仍是一整套；但每个 Segment 的第一版分别保存，避免证据被一个大文本框压扁。参考译文现在不可见。</p>
        </header>
        <div class="translationAttemptGrid">
          {prompts.map((item) => (
            <label class="translationAnswerCard" data-attempt-card={item.id}>
              <span>Segment {item.ordinal}</span>
              {item.sourceText && <p>{item.sourceText}</p>}
              <textarea data-attempt-id={item.id} rows="5" placeholder={`Segment ${item.ordinal} 的第一版译文…`}></textarea>
            </label>
          ))}
        </div>
        <div class="translationActions">
          <button type="button" class="primary" data-freeze-first>锁定整套第一版</button>
          <small data-first-status>必须完成全部 Segment 才能锁定；锁定后第一版不再被 revision 覆盖。</small>
        </div>
      </section>

      <section class="translationFrozen" data-frozen-first hidden>
        <header><span>First Translation · immutable evidence</span><small data-first-time></small></header>
        <div data-first-list></div>
      </section>

      <section class="translationStage" data-stage="decision" hidden>
        <header>
          <span>02 · PASS or Review</span>
          <h2>稳定就走，有真实问题才修</h2>
          <p>如果意义、关系、信息和中文表达都足够稳定，直接 PASS；不要为了“系统有复盘功能”制造修复债务。</p>
        </header>
        <div class="translationDecisionGrid">
          <button type="button" class="decisionPass" data-pass-clean>
            <strong>PASS · 这套稳定</strong>
            <span>没有足以影响得分可靠性的 meaningful failure，直接离开。</span>
          </button>
          <button type="button" class="decisionReview" data-route-review>
            <strong>Need Review / Verify</strong>
            <span>有错误、不确定，或这套可能验证了一个旧的 Transfer Pending。</span>
          </button>
        </div>
      </section>

      <section class="translationStage" data-stage="diagnosis" hidden>
        <header>
          <span>03 · Whole-set Review</span>
          <h2>把整套交给 Chat，只修 first meaningful failure</h2>
          <p>Chat 可以在内部定位到句子 / clause / scope，但 learner-facing 仍保持整套复盘。默认不先看 Reference。</p>
        </header>
        <div class="translationActions">
          <button type="button" class="primary" data-copy-chat>复制 Handoff 给 Chat</button>
          <button type="button" data-reveal-reference>确实需要时看 Reference</button>
          <small data-copy-status>Handoff 会自动带上第一版和现有 Transfer Pending；不会提前附参考译文。</small>
        </div>
        <label class="translationReturnBox">
          <span>Chat Return</span>
          <textarea data-chat-return rows="12" placeholder="把 Chat 返回的 KIANOS_TRANSLATION_RETURN_V1 粘贴到这里…"></textarea>
        </label>
        <div class="translationActions">
          <button type="button" class="primary" data-import-return>导入 Chat 判断 →</button>
          <small data-return-status>PASS 会直接结束；REPAIR_NEEDED 会带着 primary failure / minimal repair 进入 Reconstruction。</small>
        </div>
        <section class="translationReference" data-reference-panel hidden>
          <div class="translationReferenceHead">
            <strong>Reference · explicit reveal</strong>
            <small>{reference?.availableCount || 0}/{reference?.totalCount || prompts.length} available · 参考表达不是唯一正确表达</small>
          </div>
          <div data-reference-list></div>
        </section>
      </section>

      <section class="translationStage" data-stage="reconstruct" hidden>
        <header>
          <span>04 · Reconstruction</span>
          <h2>只重做真正受影响的部分</h2>
          <p>先用 minimal repair 自己重新执行；Reference 自动收起。同一句重译成功只说明 repair 生效，不等于 mastery。</p>
        </header>
        <section class="translationRepairCard" data-repair-card></section>
        <div class="translationReconstructGrid" data-reconstruct-list></div>
        <div class="translationActions">
          <button type="button" class="primary" data-save-reconstruction>保存 Reconstruction</button>
          <button type="button" data-back-diagnosis>返回 Review</button>
          <small data-reconstruct-status></small>
        </div>
      </section>

      <section class="translationStage" data-stage="passed" hidden>
        <header>
          <span>PASS · no manufactured debt</span>
          <h2>这套可以离开</h2>
          <p>当前任务没有需要建立 repair debt 的 meaningful failure。若它同时提供了某个旧 Pending target 的新证据，需要 Chat 明确判定后才更新那个 target。</p>
        </header>
        <div class="translationActions">
          <button type="button" data-toggle-complete-reference>可选：看 Reference</button>
          {nextHref && <a class="buttonLink primaryLink" href={nextHref}>下一套 →</a>}
        </div>
        <section class="translationReference" data-complete-reference hidden>
          <div class="translationReferenceHead">
            <strong>Reference · optional post-attempt comparison</strong>
            <small>{reference?.availableCount || 0}/{reference?.totalCount || prompts.length} available</small>
          </div>
          <div data-complete-reference-list></div>
        </section>
      </section>

      <section class="translationStage" data-stage="repaired" hidden>
        <header>
          <span>Repair Complete</span>
          <h2>当前失败已修复，不自动制造长期债务</h2>
          <p>Chat 判断这个问题不值得进入 durable transfer ledger。可以看 Reference，也可以直接进入下一套。</p>
        </header>
        <div class="translationLatest" data-latest-reconstruction></div>
        <div class="translationActions">
          <button type="button" data-toggle-complete-reference>打开 Reference</button>
          {nextHref && <a class="buttonLink primaryLink" href={nextHref}>下一套 →</a>}
        </div>
        <section class="translationReference" data-complete-reference hidden>
          <div class="translationReferenceHead"><strong>Reference · post-reconstruction</strong><small>{reference?.availableCount || 0}/{reference?.totalCount || prompts.length} available</small></div>
          <div data-complete-reference-list></div>
        </section>
      </section>

      <section class="translationStage" data-stage="transfer_pending" hidden>
        <header>
          <span>TRANSFER_PENDING</span>
          <h2>这次 repair 生效；以后新题再验证</h2>
          <p>当前题的 reconstruction 不能关闭能力问题。这个可复用 target 已进入本机 Pending；只有后续真正相关的 fresh evidence 才能支持或反驳它。</p>
        </header>
        <section class="translationTransferCard" data-current-transfer></section>
        <div class="translationLatest" data-latest-reconstruction></div>
        <div class="translationActions">
          <button type="button" data-toggle-complete-reference>打开 Reference</button>
          {nextHref && <a class="buttonLink primaryLink" href={nextHref}>下一套 →</a>}
        </div>
        <section class="translationReference" data-complete-reference hidden>
          <div class="translationReferenceHead"><strong>Reference · post-reconstruction</strong><small>{reference?.availableCount || 0}/{reference?.totalCount || prompts.length} available</small></div>
          <div data-complete-reference-list></div>
        </section>
      </section>

      <details class="translationHistory">
        <summary>Local attempt history <span data-history-count>0</span></summary>
        <div data-history-list><p>还没有历史记录。</p></div>
        <div class="translationHistoryActions">
          <button type="button" data-reset-task>归档本轮并重新开始</button>
          <button type="button" data-clear-history>清空已归档 History</button>
        </div>
        <small>Attempt / repair / transfer 都只存在本机浏览器；不会写回 GitHub shared Current。</small>
      </details>
    </section>
  </div>

  <script type="application/json" data-translation-reference set:html={referencePayload}></script>
  <script type="application/json" data-translation-prompts set:html={promptPayload}></script>
</section>

<script>
  import {
    TRANSLATION_RETURN_SCHEMA,
    TRANSLATION_TRANSFER_STORAGE_KEY,
    blankTranslationState,
    normalizeTranslationState,
    normalizeTransferLedger,
    pendingTransferTargets,
    freezeWholeAttempt,
    passCleanAttempt,
    routeAttemptToReview,
    parseTranslationReturn,
    applyTranslationReturn,
    saveReconstruction,
    archiveTranslationAttempt
  } from '../lib/translationRuntimeModel.mjs';

  const root = document.querySelector('[data-translation-runtime]');
  if (root instanceof HTMLElement) {
    const objectId = root.getAttribute('data-object-id') || 'translation';
    const title = root.getAttribute('data-title') || objectId;
    const paperId = root.getAttribute('data-paper-id') || 'English I';
    const position = Number(root.getAttribute('data-position') || 1);
    const total = Number(root.getAttribute('data-total') || 1);
    const base = root.getAttribute('data-base') || '/';
    const examSessionId = new URLSearchParams(location.search).get('exam_session') || '';
    const storageKey = examSessionId
      ? `kianos-english-exam-task-v1:${examSessionId}:translation:${objectId}`
      : `kianos-translation-attempt-v2:${objectId}`;
    const legacyStorageKey = `kianos-translation-attempt-v1:${objectId}`;
    const lastLocationKey = 'kianos-translation-last-location-v1';

    const readJson = (key, fallback = null) => {
      try { return JSON.parse(localStorage.getItem(key) || 'null') || fallback; }
      catch { return fallback; }
    };
    const writeJson = (key, value) => {
      try { localStorage.setItem(key, JSON.stringify(value)); } catch {}
    };

    let prompts = [];
    let reference = { references: [], availableCount: 0, totalCount: 0, missingCount: 0 };
    try { prompts = JSON.parse(root.querySelector('[data-translation-prompts]')?.textContent || '[]'); } catch {}
    try { reference = JSON.parse(root.querySelector('[data-translation-reference]')?.textContent || '{}'); } catch {}
    const references = Array.isArray(reference?.references) ? reference.references : [];
    const promptById = new Map(prompts.map((prompt) => [String(prompt.id), prompt]));

    const saved = readJson(storageKey, null) || (!examSessionId ? readJson(legacyStorageKey, null) : null);
    let state = normalizeTranslationState(prompts, saved);
    let transferLedger = normalizeTransferLedger(examSessionId ? null : readJson(TRANSLATION_TRANSFER_STORAGE_KEY, null));

    const save = () => {
      writeJson(storageKey, state);
      if (!examSessionId) writeJson(TRANSLATION_TRANSFER_STORAGE_KEY, transferLedger);
    };
    const stampLastLocation = () => writeJson(lastLocationKey, {
      id: objectId,
      title,
      paperId,
      position,
      total,
      href: `${base}translation/${encodeURIComponent(objectId)}/`,
      updatedAt: new Date().toISOString()
    });
    if (!examSessionId) stampLastLocation();

    const escapeLine = (value) => String(value || '').replace(/\s+/g, ' ').trim();
    const formatTime = (value) => {
      if (!value) return '';
      try { return new Date(value).toLocaleString(); } catch { return String(value); }
    };

    const fillReference = (container) => {
      if (!container) return;
      container.replaceChildren();
      references.forEach((item) => {
        const block = document.createElement('section');
        const label = document.createElement('small');
        label.textContent = `Segment ${item.ordinal || ''}`;
        const text = document.createElement('p');
        if (item?.available && String(item?.text || '').trim()) text.textContent = String(item.text);
        else {
          block.classList.add('referenceGap');
          text.textContent = `Current source 暂无已核验参考译文（${item?.status || 'missing_reference'}）；runtime 不会自行补造。`;
        }
        block.append(label, text);
        container.appendChild(block);
      });
    };
    fillReference(root.querySelector('[data-reference-list]'));
    root.querySelectorAll('[data-complete-reference-list]').forEach(fillReference);

    const renderFirst = () => {
      const box = root.querySelector('[data-first-list]');
      const frozen = root.querySelector('[data-frozen-first]');
      if (!(box instanceof HTMLElement) || !(frozen instanceof HTMLElement)) return;
      const rows = Object.entries(state.firstAttempts || {});
      frozen.hidden = !rows.length;
      box.replaceChildren();
      rows.forEach(([id, answer]) => {
        const item = document.createElement('section');
        const label = document.createElement('small');
        label.textContent = `Segment ${promptById.get(id)?.ordinal || id}`;
        const pre = document.createElement('pre');
        pre.textContent = String(answer || '');
        item.append(label, pre);
        box.appendChild(item);
      });
      const time = root.querySelector('[data-first-time]');
      if (time) time.textContent = state.firstSubmittedAt ? `locked ${formatTime(state.firstSubmittedAt)}` : '';
    };

    const renderPending = () => {
      const pending = pendingTransferTargets(transferLedger);
      const panel = root.querySelector('[data-pending-panel]');
      const count = root.querySelector('[data-pending-count]');
      const list = root.querySelector('[data-pending-list]');
      if (panel instanceof HTMLElement) panel.hidden = pending.length === 0;
      if (count) count.textContent = String(pending.length);
      if (!list) return;
      list.replaceChildren();
      pending.forEach((target) => {
        const p = document.createElement('p');
        const b = document.createElement('b'); b.textContent = target.label || target.id;
        p.append(b, document.createTextNode(` · ${target.underlyingDemand || ''}`));
        list.appendChild(p);
      });
    };

    const renderRepair = () => {
      const card = root.querySelector('[data-repair-card]');
      const failure = state.chatReturn?.primary_failure;
      if (card) {
        card.replaceChildren();
        if (failure) {
          const titleEl = document.createElement('strong');
          titleEl.textContent = [failure.layer, failure.skill].filter(Boolean).join(' · ');
          const repair = document.createElement('p');
          repair.textContent = `Minimal repair：${failure.minimal_repair || ''}`;
          const action = document.createElement('p');
          action.textContent = `重新执行：${failure.reconstruction_prompt || '按刚才修复重新翻译受影响部分。'}`;
          card.append(titleEl, repair, action);
        }
      }

      const list = root.querySelector('[data-reconstruct-list]');
      if (!list) return;
      list.replaceChildren();
      for (const id of state.affectedSegments || []) {
        const prompt = promptById.get(id);
        const label = document.createElement('label');
        label.className = 'translationAnswerCard';
        const tag = document.createElement('span'); tag.textContent = `Segment ${prompt?.ordinal || id}`;
        const source = document.createElement('p'); source.textContent = prompt?.sourceText || '';
        const first = document.createElement('blockquote'); first.textContent = state.firstAttempts?.[id] || '';
        const area = document.createElement('textarea');
        area.rows = 5;
        area.placeholder = '用 repair 后的能力自己重新翻译…';
        area.dataset.reconstructId = id;
        area.value = state.reconstructDrafts?.[id] || '';
        area.addEventListener('input', () => { state.reconstructDrafts[id] = area.value; save(); });
        label.append(tag, source, first, area);
        list.appendChild(label);
      }
    };

    const renderLatest = () => {
      root.querySelectorAll('[data-latest-reconstruction]').forEach((box) => {
        box.replaceChildren();
        const latest = state.reconstructions?.[state.reconstructions.length - 1];
        if (!latest?.answers) return;
        const strong = document.createElement('strong'); strong.textContent = 'Latest reconstruction';
        box.appendChild(strong);
        Object.entries(latest.answers).forEach(([id, answer]) => {
          const p = document.createElement('p');
          p.textContent = `Segment ${promptById.get(id)?.ordinal || id}：${answer}`;
          box.appendChild(p);
        });
      });
      const transferCard = root.querySelector('[data-current-transfer]');
      if (transferCard) {
        transferCard.replaceChildren();
        const candidate = state.pendingTransferCandidate;
        if (candidate?.admit === true) {
          const strong = document.createElement('strong'); strong.textContent = candidate.label || candidate.target_id;
          const p = document.createElement('p'); p.textContent = candidate.underlying_demand || '';
          transferCard.append(strong, p);
        }
      }
    };

    const renderHistory = () => {
      const list = root.querySelector('[data-history-list]');
      const count = root.querySelector('[data-history-count]');
      if (count) count.textContent = String(state.history?.length || 0);
      if (!list) return;
      list.replaceChildren();
      if (!state.history?.length) {
        const p = document.createElement('p'); p.textContent = '还没有已归档记录。'; list.appendChild(p); return;
      }
      [...state.history].reverse().forEach((item, index) => {
        const details = document.createElement('details');
        const summary = document.createElement('summary');
        summary.textContent = `Attempt ${state.history.length - index} · ${item.decision || 'legacy'} · ${formatTime(item.archivedAt || item.firstSubmittedAt)}`;
        details.appendChild(summary);
        const firstRows = item.firstAttempts || {};
        Object.entries(firstRows).forEach(([id, answer]) => {
          const p = document.createElement('p'); p.textContent = `S${promptById.get(id)?.ordinal || id}：${answer}`; details.appendChild(p);
        });
        if (item.legacy && item.firstAttempt) {
          const p = document.createElement('p'); p.textContent = `Legacy first attempt：${item.firstAttempt}`; details.appendChild(p);
        }
        list.appendChild(details);
      });
    };

    const render = () => {
      root.querySelectorAll('[data-stage]').forEach((section) => {
        section.hidden = section.getAttribute('data-stage') !== state.stage;
      });
      const stageLabel = root.querySelector('[data-translation-stage-label]');
      if (stageLabel) stageLabel.textContent = ({
        attempt: 'Clean Attempt',
        decision: 'PASS / Review',
        diagnosis: 'Whole-set Review',
        reconstruct: 'Reconstruction',
        passed: 'PASS',
        repaired: 'Repair Complete',
        transfer_pending: 'TRANSFER_PENDING'
      })[state.stage] || 'Translation';

      root.querySelectorAll('[data-attempt-id]').forEach((node) => {
        if (node instanceof HTMLTextAreaElement) node.value = state.drafts?.[node.dataset.attemptId || ''] || '';
      });
      renderFirst();
      renderPending();
      renderRepair();
      renderLatest();
      renderHistory();

      const referencePanel = root.querySelector('[data-reference-panel]');
      if (referencePanel instanceof HTMLElement) referencePanel.hidden = !state.referenceRevealed;
      const revealButton = root.querySelector('[data-reveal-reference]');
      if (revealButton) revealButton.textContent = state.referenceRevealed ? '收起 Reference' : '确实需要时看 Reference';
      root.querySelectorAll('[data-complete-reference]').forEach((panel) => {
        if (panel instanceof HTMLElement) panel.hidden = !state.completeReferenceOpen;
      });
      root.querySelectorAll('[data-toggle-complete-reference]').forEach((button) => {
        button.textContent = state.completeReferenceOpen ? '收起 Reference' : '打开 Reference';
      });
      save();
    };

    const sourceSegmentsText = () => prompts.map((prompt) =>
      `[${prompt.id} | Segment ${prompt.ordinal}]\n${prompt.sourceText || ''}`
    ).join('\n\n');
    const firstAttemptsText = () => prompts.map((prompt) =>
      `[${prompt.id} | Segment ${prompt.ordinal}]\n${state.firstAttempts?.[prompt.id] || '—'}`
    ).join('\n\n');
    const referenceText = () => references.map((item) =>
      item?.available && String(item?.text || '').trim()
        ? `[${item.id} | Segment ${item.ordinal}] ${item.text}`
        : `[${item.id} | Segment ${item.ordinal}] [reference unavailable: ${item?.status || 'missing_reference'}]`
    ).join('\n\n');
    const pendingText = () => {
      const pending = pendingTransferTargets(transferLedger);
      if (!pending.length) return 'none';
      return pending.map((target) =>
        `- ${target.id} | ${target.label}\n  demand: ${target.underlyingDemand}\n  prior evidence: ${(target.evidence || []).filter((e) => e.relation !== 'irrelevant').length}`
      ).join('\n');
    };

    const buildHandoff = () => [
      'KIANOS_TRANSLATION_HANDOFF_V2',
      `task: ${objectId}`,
      `paper: ${paperId}`,
      `title: ${title}`,
      '',
      'SOURCE SEGMENTS',
      sourceSegmentsText(),
      '',
      'FIRST TRANSLATION · IMMUTABLE',
      firstAttemptsText(),
      '',
      'PENDING TRANSFER TARGETS',
      pendingText(),
      '',
      'REFERENCE STATE',
      state.referenceRevealed ? referenceText() : 'intentionally not revealed',
      '',
      'REVIEW CONTRACT',
      '先看完整 task/set，再定位最早一个足以解释结果的 first meaningful failure；可由它解释的 cascade 不另建债务。稳定且可信则 PASS。若需修复，只给 smallest sufficient repair，并让我自己 reconstruct。',
      '若这套对已有 Pending target 提供了真正相关的新证据，才给 transfer_updates；irrelevant 不得算支持或反驳；close=true 只能来自语义上足够的 fresh independent evidence，不能因为同题改对或凑次数。',
      '',
      'RETURN EXACTLY WITH THIS MARKER + JSON',
      TRANSLATION_RETURN_SCHEMA,
      JSON.stringify({
        schema: TRANSLATION_RETURN_SCHEMA,
        task: objectId,
        decision: 'PASS | REPAIR_NEEDED',
        primary_failure: {
          layer: 'Lexical | English Representation | Relation / Information Preservation | Chinese Reconstruction | Execution / Self-check',
          skill: 'optional stable skill address',
          affected_segments: ['exact segment id'],
          minimal_repair: 'smallest cue / explanation needed to re-execute',
          reconstruction_prompt: 'what I should now do myself'
        },
        transfer_target: {
          admit: false,
          target_id: 'stable reusable target id if admitted',
          label: 'short learner-facing label',
          layer: 'failure layer',
          skill: 'optional skill address',
          underlying_demand: 'what later fresh material must actually test'
        },
        transfer_updates: [
          { target_id: 'existing pending target id', relation: 'support | contradict | irrelevant', note: 'why', close: false }
        ]
      }, null, 2)
    ].join('\n');

    const copyText = async (text) => {
      try { await navigator.clipboard.writeText(text); return true; }
      catch {
        try {
          const area = document.createElement('textarea');
          area.value = text; area.style.position = 'fixed'; area.style.opacity = '0';
          document.body.appendChild(area); area.select();
          const ok = document.execCommand('copy'); area.remove(); return ok;
        } catch { return false; }
      }
    };

    root.querySelectorAll('[data-attempt-id]').forEach((node) => {
      if (!(node instanceof HTMLTextAreaElement)) return;
      node.addEventListener('input', () => {
        const id = node.dataset.attemptId || '';
        state.drafts[id] = node.value;
        node.closest('[data-attempt-card]')?.classList.remove('incomplete');
        save();
      });
    });

    root.querySelector('[data-freeze-first]')?.addEventListener('click', () => {
      const result = freezeWholeAttempt(state, prompts);
      const status = root.querySelector('[data-first-status]');
      root.querySelectorAll('[data-attempt-card]').forEach((card) => card.classList.remove('incomplete'));
      if (!result.ok) {
        result.missing.forEach((id) => root.querySelector(`[data-attempt-card="${CSS.escape(id)}"]`)?.classList.add('incomplete'));
        if (status) status.textContent = `还缺 ${result.missing.length} 个 Segment；整套没有完成，不能锁定。`;
        return;
      }
      state = result.state;
      render();
    });

    root.querySelector('[data-pass-clean]')?.addEventListener('click', () => {
      state = passCleanAttempt(state);
      render();
    });
    root.querySelector('[data-route-review]')?.addEventListener('click', () => {
      state = routeAttemptToReview(state);
      render();
    });
    root.querySelector('[data-reveal-reference]')?.addEventListener('click', () => {
      state.referenceRevealed = !state.referenceRevealed;
      render();
    });
    root.querySelector('[data-copy-chat]')?.addEventListener('click', async () => {
      const status = root.querySelector('[data-copy-status]');
      const ok = await copyText(buildHandoff());
      if (status) status.textContent = ok ? '已复制整套 Handoff；回到 Chat 直接粘贴即可。' : '复制失败，请手动复制。';
    });

    root.querySelector('[data-import-return]')?.addEventListener('click', () => {
      const area = root.querySelector('[data-chat-return]');
      const status = root.querySelector('[data-return-status]');
      if (!(area instanceof HTMLTextAreaElement)) return;
      try {
        const payload = parseTranslationReturn(area.value, objectId);
        const applied = applyTranslationReturn(state, payload, prompts, transferLedger, { task: objectId });
        state = applied.state;
        transferLedger = applied.ledger;
        if (status) status.textContent = payload.decision === 'PASS' ? 'Chat 判定 PASS。' : '已导入 primary failure，进入 Reconstruction。';
        render();
      } catch (error) {
        if (status) status.textContent = `Return 无法导入：${error instanceof Error ? error.message : String(error)}`;
      }
    });

    root.querySelector('[data-back-diagnosis]')?.addEventListener('click', () => {
      state.stage = 'diagnosis';
      state.referenceRevealed = false;
      render();
    });
    root.querySelector('[data-save-reconstruction]')?.addEventListener('click', () => {
      const status = root.querySelector('[data-reconstruct-status]');
      const result = saveReconstruction(state, transferLedger, { task: objectId });
      if (!result.ok) {
        if (status) status.textContent = `还缺 ${result.missing.length} 个受影响 Segment 的 Reconstruction。`;
        return;
      }
      state = result.state;
      transferLedger = result.ledger;
      render();
    });

    root.querySelectorAll('[data-toggle-complete-reference]').forEach((button) => {
      button.addEventListener('click', () => {
        state.completeReferenceOpen = !state.completeReferenceOpen;
        render();
      });
    });

    root.querySelector('[data-reset-task]')?.addEventListener('click', () => {
      if (!confirm('归档当前 Translation attempt，并重新开始这一套？')) return;
      const history = [...(state.history || [])];
      const snapshot = archiveTranslationAttempt(state);
      if (snapshot) history.push(snapshot);
      state = blankTranslationState(prompts, history);
      render();
      root.querySelector('[data-attempt-id]')?.focus();
    });
    root.querySelector('[data-clear-history]')?.addEventListener('click', () => {
      if (!state.history?.length) return;
      if (!confirm('清空这一套已归档的本机 Translation History？')) return;
      state.history = [];
      render();
    });

    render();
  }
</script>

