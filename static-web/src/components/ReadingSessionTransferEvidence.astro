---
const base = import.meta.env.BASE_URL;
---
<span data-reading-session-transfer-root data-reading-base={base} hidden></span>

<script>
  const host = document.querySelector('[data-reading-session-transfer-root]');

  if (host) {
    const basePath = host.getAttribute('data-reading-base') || '/';
    const continuousKey = 'kianos-reading-continuous-session-v1';
    const watchKey = 'kianos-reading-watch-signals-v1';
    const scanKey = 'kianos-reading-session-transfer-scans-v1';

    const readJson = (key, fallback) => {
      try { return JSON.parse(localStorage.getItem(key) || 'null') || fallback; }
      catch { return fallback; }
    };
    const writeJson = (key, value) => {
      try { localStorage.setItem(key, JSON.stringify(value)); } catch {}
    };
    const readSession = () => {
      const value = readJson(continuousKey, {});
      return {
        active: Boolean(value.active),
        reviewing: Boolean(value.reviewing),
        startedAt: value.startedAt || '',
        items: Array.isArray(value.items) ? value.items : [],
        reviewIds: Array.isArray(value.reviewIds) ? value.reviewIds : [],
        lastSummary: value.lastSummary || null
      };
    };
    const sameAnswer = (actual, correct) => {
      const left = (Array.isArray(actual) ? actual : actual ? [actual] : []).map(String).sort();
      const right = (Array.isArray(correct) ? correct : correct ? [correct] : []).map(String).sort();
      return left.length === right.length && left.every((value, index) => value === right[index]);
    };
    const expectedFromAttempt = (attempt, id) => {
      const correctAnswer = attempt.correctAnswers?.[id];
      if (correctAnswer !== undefined) {
        return Array.isArray(correctAnswer) ? correctAnswer.map(String) : [String(correctAnswer)];
      }
      return [];
    };
    const stableCorrect = (attempt, id) => {
      if (attempt.results?.[id] !== 'correct') return false;
      if ((attempt.uncertain || []).includes(id)) return false;
      const path = (attempt.trajectory?.[id] || []).map((step) => String(step?.answer || '')).filter(Boolean);
      if (path.length !== 1) return false;
      const correct = expectedFromAttempt(attempt, id);
      return correct.length ? sameAnswer(attempt.answers?.[id], correct) : true;
    };
    const reviewUrl = (id) => `${basePath}reading-review/${encodeURIComponent(id)}.json`;

    const run = async () => {
      const session = readSession();
      if (!session.startedAt || !session.items.length || session.active) return;
      if (!session.reviewing && !session.lastSummary) return;

      const scans = readJson(scanKey, { version: 1, sessions: {} });
      if (scans.sessions?.[session.startedAt]) return;

      const watchStore = readJson(watchKey, { version: 1, signals: [] });
      const signals = Array.isArray(watchStore.signals) ? watchStore.signals : [];
      if (!signals.some((signal) => signal?.status === 'WATCH' && signal?.family === 'JUDGE' && (signal.subtypeCodes || []).length)) {
        writeJson(scanKey, {
          version: 1,
          sessions: { ...(scans.sessions || {}), [session.startedAt]: { scannedAt: new Date().toISOString(), matched: 0 } }
        });
        return;
      }

      const passageData = [];
      for (const item of session.items) {
        const passageId = item?.id || '';
        if (!passageId) continue;
        const attempt = readJson(`kianos-reading-attempt-v1:${passageId}`, {});
        if (!attempt.submitted || !attempt.submittedAt) continue;
        try {
          const response = await fetch(reviewUrl(passageId), { headers: { Accept: 'application/json' } });
          if (!response.ok) return;
          const review = await response.json();
          if (!review || review.objectId !== passageId || typeof review.questions !== 'object') return;
          passageData.push({ passageId, attempt, review });
        } catch {
          return;
        }
      }

      let matchedCount = 0;
      const nextSignals = signals.map((signal) => {
        if (signal?.status !== 'WATCH' || signal?.family !== 'JUDGE' || !(signal.subtypeCodes || []).length || !signal.reviewedAt) return signal;
        const priorCodes = new Set((signal.subtypeCodes || []).map(String));
        const priorTask = String(signal.questionTask || '');
        const evidence = Array.isArray(signal.transferEvidence) ? [...signal.transferEvidence] : [];
        const seen = new Set(evidence.map((item) => `${item?.passageId}:${item?.questionId}`));
        let changed = false;

        passageData.forEach(({ passageId, attempt, review }) => {
          if (passageId === signal.passageId) return;
          if (new Date(attempt.submittedAt).getTime() <= new Date(signal.reviewedAt).getTime()) return;

          Object.entries(attempt.results || {}).forEach(([questionId, result]) => {
            if (result !== 'correct' || !stableCorrect(attempt, questionId)) return;
            const reviewItem = review.questions?.[questionId];
            if (!reviewItem) return;
            if (priorTask && String(reviewItem.questionTask || '') !== priorTask) return;

            const correctAnswer = attempt.correctAnswers?.[questionId];
            const correct = new Set(Array.isArray(correctAnswer) ? correctAnswer.map(String) : correctAnswer ? [String(correctAnswer)] : []);
            const candidateCodes = new Set();
            Object.entries(reviewItem.optionDiagnosis || {}).forEach(([label, diagnoses]) => {
              if (correct.size && correct.has(String(label))) return;
              (Array.isArray(diagnoses) ? diagnoses : []).forEach((code) => {
                if (code && code !== 'SUPPORTED') candidateCodes.add(String(code));
              });
            });
            const matched = [...priorCodes].filter((code) => candidateCodes.has(code));
            if (!matched.length) return;

            const evidenceKey = `${passageId}:${questionId}`;
            if (seen.has(evidenceKey)) return;
            evidence.push({
              passageId,
              questionId,
              matchedSubtypeCodes: matched,
              attemptSubmittedAt: attempt.submittedAt,
              evidenceKind: 'DISTINCT_PASSAGE_STABLE_CORRECT',
              unseenStatus: 'UNKNOWN',
              recordedAt: new Date().toISOString()
            });
            seen.add(evidenceKey);
            changed = true;
            matchedCount += 1;
          });
        });

        if (!changed) return signal;
        return {
          ...signal,
          transferEvidence: evidence.slice(-8),
          transferSuccessCount: evidence.length,
          updatedAt: new Date().toISOString()
        };
      });

      if (matchedCount) writeJson(watchKey, { version: 1, signals: nextSignals.slice(-200) });
      writeJson(scanKey, {
        version: 1,
        sessions: {
          ...(scans.sessions || {}),
          [session.startedAt]: { scannedAt: new Date().toISOString(), matched: matchedCount }
        }
      });
    };

    void run();
  }
</script>
