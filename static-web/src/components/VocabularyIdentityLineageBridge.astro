<div data-vocab-identity-lineage-bridge hidden></div>
<script>
  import { reconcileEvidenceIdentity } from '../lib/lexicalEvidence.mjs';
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  import { readBrowserLexicalLedger, writeBrowserLexicalLedger, lexicalBrowserStateReadable } from '../lib/lexicalBrowserState.mjs';

  void learnerWriterReady.then(() => {
    if (!lexicalBrowserStateReadable()) return;

    const initialize = (root) => {
      if (!(root instanceof HTMLElement)) return;
      root.dataset.vocabIdentityInitialized = 'true';
      const params = new URLSearchParams(location.search);
      if (params.get('mode') === 'lookup' || params.has('lookup') || params.get('from') === 'english') return;
      let lineage = [];
      let form = null;
      try {
        lineage = JSON.parse(root.querySelector('[data-vocab-identity-lineage]')?.textContent || '[]');
        form = JSON.parse(root.querySelector('[data-vocab-current-form]')?.textContent || 'null');
      } catch {}
      if (!Array.isArray(lineage)) return;
      if (!lineage.length && form?.disposition !== 'EXPLORE_ONLY') return;
      const result = reconcileEvidenceIdentity(readBrowserLexicalLedger(), lineage, [{
        word_id: root.getAttribute('data-vocab-object'), form
      }]);
      if (result.statuses.length) writeBrowserLexicalLedger(result.ledger);
    };

    const initializeCurrent = () => {
      document.querySelectorAll('[data-local-port="vocabulary"]').forEach(initialize);
    };

    initializeCurrent();
    window.addEventListener('kianos:vocabulary-root-ready', initializeCurrent);
    window.addEventListener('kianos:lexical-evidence-changed', initializeCurrent);
  });
</script>
