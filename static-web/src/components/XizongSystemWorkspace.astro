---
import { composeXizongSystemFrameworkRepresentation } from '../lib/xizongRepresentationGate.mjs';

const { system, pathways } = Astro.props;
const base = import.meta.env.BASE_URL;
const framework = composeXizongSystemFrameworkRepresentation(system);
const totalKp = system.blocks.reduce((sum, block) => sum + block.kpCount, 0);
const firstBlock = system.blocks[0];
const failureViews = pathways?.systemFailureViews || {};
const variableRows = framework.variables.rows;
const relationRows = framework.formulas;
---
<section
  class="xzSystemWorkspace"
  data-xizong-system={system.systemId}
  data-representation-gate={framework.schema}
  data-system-framework-plan="purpose-first"
>
  <aside class="xzSystemRouteRail" aria-label="System Block route">
    <header>
      <span>System Route</span>
      <strong>{system.canonicalId} · {system.title}</strong>
      <small>{system.blocks.length} Blocks · {totalKp} KP</small>
    </header>
    <nav aria-label="Block route">
      {system.blocks.map((block, index) => <a
        href={`${base}xizong/${system.systemId}/${block.slug}/`}
        data-system-block={index}
        class={index === 0 ? 'selected' : ''}
      >
        <b>{block.label}</b>
        <span>{block.title}</span>
        <small>{block.kpCount} KP</small>
      </a>)}
    </nav>
    <footer>↑ ↓ 选择 · Enter 进入</footer>
  </aside>

  <main class="xzSystemMain">
    <header class="xzSystemHero">
      <div>
        <span>{system.canonicalId} · System Framework</span>
        <h1>{system.title}</h1>
      </div>
      <p data-representation-kind={framework.mission.representation.kind}>{framework.mission.text}</p>
    </header>

    <section class="xzSystemFramework" data-system-section="mother">
      <header class="xzSystemSectionHeading">
        <span>先抓主模型</span>
        <h2>这个系统在维持什么？</h2>
      </header>

      {framework.motherModel.text && (
        <p class="xzSystemMother" data-representation-kind={framework.motherModel.representation.kind}>
          {framework.motherModel.text}
        </p>
      )}

      {framework.spine.items.length > 0 && (
        <div class="xzSystemFrameworkBlock" data-representation-kind={framework.spine.representation.kind}>
          <span class="xzSystemSectionLabel">主骨架</span>
          <ol class="xzSystemSpine" data-system-spine>
            {framework.spine.items.map((item, index) => <li data-spine-node={index + 1}>
              <b>{String(index + 1).padStart(2, '0')}</b>
              <span>{item}</span>
            </li>)}
          </ol>
        </div>
      )}

      {framework.parallelControls.items.length > 0 && (
        <div class="xzSystemParallelBlock" data-representation-kind={framework.parallelControls.representation.kind}>
          <span class="xzSystemSectionLabel">并行调节</span>
          <div class="xzSystemParallel">{framework.parallelControls.items.map((item) => <span>{item}</span>)}</div>
        </div>
      )}
    </section>

    <section class="xzSystemCoordinates">
      <article class="xzSystemLanguage">
        <header>
          <span>最小变量语言</span>
          <h2>先用这些量描述系统</h2>
        </header>
        {variableRows.length > 0 && (
          <div class="xzSystemVariableTable" data-representation-kind={framework.variables.representation.kind}>
            {variableRows.map((item) => <div class="xzSystemVariableRow">
              <strong>{item.label}</strong>
              {item.role && <span>{item.role}</span>}
            </div>)}
          </div>
        )}
        {relationRows.length > 0 && (
          <div class="xzSystemFormulaList">
            {relationRows.map((item) => <code data-representation-kind={item.representation.kind}>{item.formula}</code>)}
          </div>
        )}
      </article>

      <article class="xzSystemAxes" data-representation-kind={framework.judgmentAxes.representation.kind}>
        <header>
          <span>病例判断坐标</span>
          <h2>遇到病例先沿这些轴定位</h2>
        </header>
        <ul>{framework.judgmentAxes.items.map((item) => <li>{item}</li>)}</ul>
      </article>
    </section>

    {framework.failures.length > 0 && (
      <section class="xzSystemFailureWorkspace" data-system-section="failure">
        <header class="xzSystemSectionHeading">
          <span>Failure Explorer</span>
          <h2>一次只看一种失败怎样破坏主链</h2>
        </header>
        <div class="xzSystemFailureLayout">
          <div class="xzSystemFailureGrid">
            {framework.failures.map((mode, index) => <button type="button" data-failure-id={mode.id}>
              <b>F{index + 1}</b>
              <span>{mode.label}</span>
            </button>)}
          </div>
          <div class="xzSystemFailureRun" data-failure-run data-representation-kind="STRUCTURED_TEXT">
            <span>当前机制</span>
            <strong data-failure-run-title>选择一个 Failure</strong>
            <p data-failure-run-chain>只看它首先影响哪一段，以及随后怎样传下去。</p>
            <div data-failure-run-vars></div>
          </div>
        </div>
      </section>
    )}

    {framework.dependencies.items.length > 0 && (
      <details class="xzSystemDependency" data-representation-kind={framework.dependencies.representation.kind}>
        <summary>按需看学习依赖</summary>
        <p>这里只保留 Current 明确写出的依赖关系；不自动画层级图，也不据此制造新的强制顺序。</p>
        <ul>{framework.dependencies.items.map((item) => <li>{item}</li>)}</ul>
      </details>
    )}

    <details class="portedSourceFoot">
      <summary>Source</summary>
      <code>{system.sourcePath}</code>
      <code>sha256:{String(system.sourceHash).slice(0, 16)}</code>
      {pathways?.sourcePath && <code>{pathways.sourcePath}</code>}
    </details>
  </main>

  <aside class="xzSystemContext">
    <section class="xzSystemSelectedBlock">
      <span>当前 Block</span>
      <b data-selected-label>{firstBlock?.label}</b>
      <h2 data-selected-title>{firstBlock?.title}</h2>
      <p data-selected-meta>{firstBlock ? `${firstBlock.kpCount} KP${firstBlock.outlineCount > 0 ? ` · Outline ${firstBlock.outlineCount}` : ''}` : ''}</p>
      <button type="button" data-open-selected>进入这个 Block</button>
    </section>

    <section class="xzSystemGuide">
      <span>怎么用这一页</span>
      <p>先恢复主骨架与判断坐标，再从左侧进入当前 Block。Failure 只用来定位“哪里先坏”，不需要一次展开全部。</p>
    </section>

    <section class="xzSystemKeys">
      <span>快捷键</span>
      <p>↑ ↓ 选择 Block</p>
      <p>Enter 进入</p>
      <p>M 主模型 · F Failure</p>
    </section>
  </aside>

  <script type="application/json" data-system-block-payload set:html={JSON.stringify(system.blocks.map((block) => ({
    label: block.label,
    title: block.title,
    kpCount: block.kpCount,
    outlineCount: block.outlineCount
  })))}></script>
  <script type="application/json" data-failure-payload set:html={JSON.stringify(Object.fromEntries(system.failureModes.map((mode) => [mode.id, {
    ...(failureViews[mode.id] || {}),
    label: mode.label,
    chain: mode.chain || failureViews[mode.id]?.chain || ''
  }])))}></script>
</section>

<script>
  const root = document.querySelector('[data-xizong-system]');
  if (root) {
    const systemId = root.getAttribute('data-xizong-system') || 'system';
    const links = [...root.querySelectorAll('[data-system-block]')];
    let blocks = [];
    let failures = {};
    try { blocks = JSON.parse(root.querySelector('[data-system-block-payload]')?.textContent || '[]'); } catch {}
    try { failures = JSON.parse(root.querySelector('[data-failure-payload]')?.textContent || '{}'); } catch {}
    let selected = 0;
    try { selected = Number(sessionStorage.getItem(`kianos-xizong-system-selection:${systemId}`) || 0); } catch {}
    selected = Math.max(0, Math.min(links.length - 1, selected));

    const label = root.querySelector('[data-selected-label]');
    const title = root.querySelector('[data-selected-title]');
    const meta = root.querySelector('[data-selected-meta]');
    const open = root.querySelector('[data-open-selected]');
    const spineNodes = [...root.querySelectorAll('[data-spine-node]')];
    const failureButtons = [...root.querySelectorAll('[data-failure-id]')];
    const failureTitle = root.querySelector('[data-failure-run-title]');
    const failureChain = root.querySelector('[data-failure-run-chain]');
    const failureVars = root.querySelector('[data-failure-run-vars]');

    const renderSelection = (scroll = true) => {
      links.forEach((link, index) => link.classList.toggle('selected', index === selected));
      const block = blocks[selected];
      if (block) {
        if (label) label.textContent = block.label || '';
        if (title) title.textContent = block.title || '';
        if (meta) meta.textContent = `${block.kpCount || 0} KP${Number(block.outlineCount) > 0 ? ` · Outline ${block.outlineCount}` : ''}`;
      }
      if (scroll) links[selected]?.scrollIntoView({ block: 'nearest' });
      try { sessionStorage.setItem(`kianos-xizong-system-selection:${systemId}`, String(selected)); } catch {}
    };

    const runFailure = (id) => {
      const view = failures[id];
      if (!view) return;
      const focus = new Set((view.focus_nodes || []).map(Number));
      spineNodes.forEach((node) => {
        const active = focus.has(Number(node.getAttribute('data-spine-node') || 0));
        node.classList.toggle('mechanism-active', active);
        node.classList.toggle('mechanism-dim', focus.size > 0 && !active);
      });
      failureButtons.forEach((button) => button.classList.toggle('active', button.getAttribute('data-failure-id') === id));
      if (failureTitle) failureTitle.textContent = view.label || id;
      if (failureChain) failureChain.textContent = view.chain || 'Current 只定义了 Failure 身份；这里不补猜额外链条。';
      if (failureVars) {
        failureVars.replaceChildren();
        (view.variables || []).forEach((value) => {
          const span = document.createElement('span');
          span.textContent = value;
          failureVars.appendChild(span);
        });
        if (view.parallel_focus) {
          const span = document.createElement('span');
          span.textContent = `并行：${view.parallel_focus}`;
          failureVars.appendChild(span);
        }
      }
    };

    links.forEach((link, index) => {
      link.addEventListener('focus', () => { selected = index; renderSelection(false); });
      link.addEventListener('mouseenter', () => { selected = index; renderSelection(false); });
    });
    failureButtons.forEach((button) => button.addEventListener('click', () => runFailure(button.getAttribute('data-failure-id') || '')));
    open?.addEventListener('click', () => links[selected]?.click());

    document.addEventListener('keydown', (event) => {
      const target = event.target;
      if (target instanceof HTMLElement && target.closest('input,textarea,select,button,[contenteditable="true"]')) return;
      if (event.key === 'ArrowUp') { event.preventDefault(); selected = Math.max(0, selected - 1); renderSelection(); return; }
      if (event.key === 'ArrowDown') { event.preventDefault(); selected = Math.min(links.length - 1, selected + 1); renderSelection(); return; }
      if (event.key === 'Enter') { event.preventDefault(); links[selected]?.click(); return; }
      const key = event.key.toLowerCase();
      if (key === 'm') root.querySelector('[data-system-section="mother"]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      if (key === 'f') root.querySelector('[data-system-section="failure"]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    renderSelection(false);
  }
</script>
