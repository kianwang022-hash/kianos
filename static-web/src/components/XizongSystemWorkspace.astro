---
import { composeXizongSystemFrameworkRepresentation } from '../lib/xizongRepresentationGate.mjs';

const { system, pathways, guide = null } = Astro.props;
const base = import.meta.env.BASE_URL;
const framework = composeXizongSystemFrameworkRepresentation(system);
const failureViews = pathways?.systemFailureViews || {};
const variableRows = framework.variables.rows;
const relationRows = framework.formulas;
const guideSections = guide?.sections || [];
const hasGuide = guideSections.length > 0;
const hasVariableRoles = variableRows.some((row) => row.role);
const spineLabels = framework.spine.items.map((item) => String(item || '').trim());
const spineTotalChars = spineLabels.reduce((sum, item) => sum + [...item].length, 0);
const spineMaxChars = spineLabels.reduce((max, item) => Math.max(max, [...item].length), 0);
const spineAverageChars = spineLabels.length ? spineTotalChars / spineLabels.length : 0;
const spineLayout = spineLabels.length >= 6 && (spineAverageChars >= 10 || spineMaxChars >= 15)
  ? 'vertical'
  : 'horizontal';
const axisRows = framework.judgmentAxes.items.map((item, index) => {
  const raw = String(item || '').trim();
  const pair = raw.includes('↔')
    ? raw.split('↔').map((value) => value.trim()).filter(Boolean)
    : /\s+vs\s+/i.test(raw)
      ? raw.split(/\s+vs\s+/i).map((value) => value.trim()).filter(Boolean)
      : [];
  return {
    id: `axis-${index + 1}`,
    raw,
    left: pair.length === 2 ? pair[0] : '',
    right: pair.length === 2 ? pair[1] : '',
    paired: pair.length === 2
  };
});
---

<section
  class="xzSystemWorkspace"
  data-xizong-system={system.systemId}
  data-representation-gate={framework.schema}
  data-system-framework-plan="purpose-first"
  data-system-default-view={hasGuide ? 'guide' : 'framework'}
>
  <header class="xzSystemTopbar">
    <div class="xzSystemIdentity">
      <span>{system.canonicalId} · SYSTEM</span>
      <h1>{system.title}</h1>
      <p data-representation-kind={framework.mission.representation.kind}>{framework.mission.text}</p>
    </div>
    <nav class="xzSystemViewTabs" aria-label="System view">
      {hasGuide && <button type="button" data-system-view-button="guide" aria-pressed="true">GUIDE</button>}
      <button type="button" data-system-view-button="framework" aria-pressed={hasGuide ? 'false' : 'true'}>FRAMEWORK</button>
    </nav>
  </header>

  <div class="xzSystemBody" data-system-body>
    <aside class="xzSystemRouteRail" aria-label="System Block route">
      <header>
        <span>BLOCK ROUTE</span>
        <strong>{system.canonicalId} · {system.title}</strong>
      </header>
      <nav aria-label="Block route">
        {system.blocks.map((block, index) => (
          <a
            href={`${base}xizong/${system.systemId}/${block.slug}/`}
            data-system-block={index}
            class={index === 0 ? 'selected' : ''}
          >
            <b>{block.label}</b>
            <span>{block.title}</span>
          </a>
        ))}
      </nav>
    </aside>

    <main class="xzSystemStage">
      {hasGuide && (
        <section class="xzSystemGuideView" data-system-view="guide">
          <div class="xzSystemGuideLead">
            <span>BEGINNER GUIDE</span>
            <strong>第一次进入这个 System 时，用它把整张地图真正看懂。</strong>
            <p>看懂整体以后可随时切回 Framework；进入 Block 后继续沿原讲义 + KP Learn 主线学习。</p>
          </div>
          <div class="xzSystemGuideFlow">
            {guideSections.map((section) => (
              <article
                class:list={[
                  'xzSystemGuideSection',
                  `role-${String(section.role || 'EXPLANATION').toLowerCase()}`
                ]}
                data-guide-role={section.role}
              >
                <header>
                  <h2>{section.title}</h2>
                </header>
                <div class="xzSystemGuideMarkdown markdown" set:html={section.html}></div>
              </article>
            ))}
          </div>
        </section>
      )}

      <section class="xzSystemFrameworkView" data-system-view="framework" hidden={hasGuide}>
        <section class="xzSystemCanvas" data-system-section="mother">
          <header class="xzSystemSectionHeading">
            <span>SYSTEM MODEL</span>
            <h2>这个系统怎样运行？</h2>
          </header>

          {framework.motherModel.text && (
            <p class="xzSystemMother" data-representation-kind={framework.motherModel.representation.kind}>
              {framework.motherModel.text}
            </p>
          )}

          {framework.spine.items.length > 0 && (
            <div class="xzSystemSpineBlock" data-representation-kind={framework.spine.representation.kind}>
              <ol
                class="xzSystemSpine"
                data-system-spine
                data-spine-layout={spineLayout}
                data-spine-average-chars={spineAverageChars.toFixed(1)}
                data-spine-max-chars={spineMaxChars}
              >
                {framework.spine.items.map((item, index) => (
                  <li data-spine-node={index + 1}>
                    <b>{String(index + 1).padStart(2, '0')}</b>
                    <span>{item}</span>
                  </li>
                ))}
              </ol>
            </div>
          )}

          {framework.parallelControls.items.length > 0 && (
            <div class="xzSystemParallelBlock" data-representation-kind={framework.parallelControls.representation.kind}>
              <span>并行控制</span>
              <div class="xzSystemParallel">
                {framework.parallelControls.items.map((item) => <p>{item}</p>)}
              </div>
            </div>
          )}
        </section>

        {(variableRows.length > 0 || relationRows.length > 0 || axisRows.length > 0) && (
          <section class="xzSystemLanguageAxes">
            <article class="xzSystemLanguage">
              <header class="xzSystemSectionHeading">
                <span>SYSTEM LANGUAGE</span>
                <h2>描述这个系统时，用哪些变量和关系？</h2>
              </header>

              {variableRows.length > 0 && hasVariableRoles && (
                <div class="xzSystemVariableTable" data-representation-kind={framework.variables.representation.kind}>
                  {variableRows.map((item) => (
                    <div class="xzSystemVariableRow">
                      <strong>{[item.id, item.label].filter(Boolean).join(' · ')}</strong>
                      <span>{item.role}</span>
                    </div>
                  ))}
                </div>
              )}

              {variableRows.length > 0 && !hasVariableRoles && (
                <div class="xzSystemVariableFlow" data-representation-kind={framework.variables.representation.kind}>
                  {variableRows.map((item) => <span>{item.label}</span>)}
                </div>
              )}

              {relationRows.length > 0 && (
                <div class="xzSystemFormulaStrip">
                  {relationRows.map((item) => (
                    <span data-representation-kind={item.representation.kind}>{item.formula}</span>
                  ))}
                </div>
              )}
            </article>

            {axisRows.length > 0 && (
              <article class="xzSystemAxes" data-representation-kind={framework.judgmentAxes.representation.kind}>
                <header class="xzSystemSectionHeading">
                  <span>JUDGMENT AXES</span>
                  <h2>遇到病例，先沿哪些轴定位？</h2>
                </header>
                <div class="xzSystemAxisList">
                  {axisRows.map((axis) => axis.paired ? (
                    <div class="xzSystemAxis paired">
                      <span>{axis.left}</span>
                      <i aria-hidden="true"></i>
                      <span>{axis.right}</span>
                    </div>
                  ) : (
                    <div class="xzSystemAxis single"><span>{axis.raw}</span></div>
                  ))}
                </div>
              </article>
            )}
          </section>
        )}

        {framework.failures.length > 0 && (
          <section class="xzSystemFailureMap" data-system-section="failure">
            <header class="xzSystemSectionHeading">
              <span>FAILURE MAP</span>
              <h2>第一故障可能从哪里开始？</h2>
            </header>
            <div class="xzSystemFailureStrip">
              {framework.failures.map((mode, index) => (
                <button type="button" data-failure-id={mode.id}>
                  <b>F{index + 1}</b>
                  <span>{mode.label}</span>
                </button>
              ))}
            </div>
          </section>
        )}

        {framework.dependencies.items.length > 0 && (
          <details class="xzSystemDependency" data-representation-kind={framework.dependencies.representation.kind}>
            <summary>按需看当前明确的依赖关系</summary>
            <ul>{framework.dependencies.items.map((item) => <li>{item}</li>)}</ul>
          </details>
        )}
      </section>
    </main>

    <aside class="xzSystemContext" data-system-context hidden>
      <header>
        <div>
          <span>FAILURE CONTEXT</span>
          <strong data-failure-run-title>—</strong>
        </div>
        <button type="button" data-close-system-context aria-label="关闭 Failure Context">×</button>
      </header>
      <p data-failure-run-chain></p>
      <div data-failure-run-vars></div>
    </aside>
  </div>

  <script type="application/json" data-failure-payload set:html={JSON.stringify(Object.fromEntries(system.failureModes.map((mode) => [mode.id, {
    ...(failureViews[mode.id] || {}),
    label: mode.label,
    chain: mode.chain || failureViews[mode.id]?.chain || ''
  }])))}></script>
</section>

<script>
  const root = document.querySelector('[data-xizong-system]');
  if (root instanceof HTMLElement) {
    const systemId = root.getAttribute('data-xizong-system') || 'system';
    const defaultView = root.getAttribute('data-system-default-view') || 'framework';
    const body = root.querySelector('[data-system-body]');
    const viewButtons = [...root.querySelectorAll('[data-system-view-button]')];
    const views = [...root.querySelectorAll('[data-system-view]')];
    const links = [...root.querySelectorAll('[data-system-block]')];
    const context = root.querySelector('[data-system-context]');
    const contextClose = root.querySelector('[data-close-system-context]');
    const spineNodes = [...root.querySelectorAll('[data-spine-node]')];
    const failureButtons = [...root.querySelectorAll('[data-failure-id]')];
    const failureTitle = root.querySelector('[data-failure-run-title]');
    const failureChain = root.querySelector('[data-failure-run-chain]');
    const failureVars = root.querySelector('[data-failure-run-vars]');
    let failures = {};
    try { failures = JSON.parse(root.querySelector('[data-failure-payload]')?.textContent || '{}'); } catch {}

    let selected = 0;
    try { selected = Number(sessionStorage.getItem(`kianos-xizong-system-selection:${systemId}`) || 0); } catch {}
    selected = Math.max(0, Math.min(links.length - 1, selected));

    const renderSelection = (scroll = true) => {
      links.forEach((link, index) => link.classList.toggle('selected', index === selected));
      if (scroll) links[selected]?.scrollIntoView({ block: 'nearest' });
      try { sessionStorage.setItem(`kianos-xizong-system-selection:${systemId}`, String(selected)); } catch {}
    };

    const closeContext = () => {
      if (context instanceof HTMLElement) context.hidden = true;
      if (body instanceof HTMLElement) body.classList.remove('context-open');
      failureButtons.forEach((button) => button.classList.remove('active'));
      spineNodes.forEach((node) => {
        node.classList.remove('mechanism-active');
        node.classList.remove('mechanism-dim');
      });
    };

    const setView = (name) => {
      const target = views.some((view) => view.getAttribute('data-system-view') === name) ? name : defaultView;
      views.forEach((view) => { view.hidden = view.getAttribute('data-system-view') !== target; });
      viewButtons.forEach((button) => {
        const active = button.getAttribute('data-system-view-button') === target;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      if (target !== 'framework') closeContext();
      try { localStorage.setItem(`kianos:xizong:system-view:${systemId}`, target); } catch {}
    };

    let initialView = defaultView;
    try {
      const saved = localStorage.getItem(`kianos:xizong:system-view:${systemId}`);
      if (saved) initialView = saved;
    } catch {}
    setView(initialView);

    viewButtons.forEach((button) => button.addEventListener('click', () => {
      setView(button.getAttribute('data-system-view-button') || defaultView);
    }));

    links.forEach((link, index) => {
      link.addEventListener('focus', () => { selected = index; renderSelection(false); });
      link.addEventListener('mouseenter', () => { selected = index; renderSelection(false); });
    });

    const runFailure = (id) => {
      const view = failures[id];
      if (!view) return;

      const focus = new Set((view.focus_nodes || []).map(Number));
      spineNodes.forEach((node) => {
        const active = focus.has(Number(node.getAttribute('data-spine-node') || 0));
        node.classList.toggle('mechanism-active', active);
        node.classList.toggle('mechanism-dim', focus.size > 0 && !active);
      });
      failureButtons.forEach((button) => button.classList.toggle('active', button.getAttribute('data-failure-id') === id));

      if (failureTitle) failureTitle.textContent = view.label || id;
      if (failureChain) failureChain.textContent = view.chain || '这里只保留已经明确的故障定位；没有证据的链条不补猜。';
      if (failureVars) {
        failureVars.replaceChildren();
        (view.variables || []).forEach((value) => {
          const span = document.createElement('span');
          span.textContent = value;
          failureVars.appendChild(span);
        });
        if (view.parallel_focus) {
          const span = document.createElement('span');
          span.textContent = `并行：${view.parallel_focus}`;
          failureVars.appendChild(span);
        }
      }

      if (context instanceof HTMLElement) context.hidden = false;
      if (body instanceof HTMLElement) body.classList.add('context-open');
    };

    failureButtons.forEach((button) => button.addEventListener('click', () => runFailure(button.getAttribute('data-failure-id') || '')));
    contextClose?.addEventListener('click', closeContext);

    document.addEventListener('keydown', (event) => {
      const target = event.target;
      if (target instanceof HTMLElement && target.closest('input,textarea,select,button,[contenteditable="true"]')) return;
      if (event.key === 'ArrowUp') {
        event.preventDefault();
        selected = Math.max(0, selected - 1);
        renderSelection();
        return;
      }
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        selected = Math.min(links.length - 1, selected + 1);
        renderSelection();
        return;
      }
      if (event.key === 'Enter') {
        event.preventDefault();
        links[selected]?.click();
      }
    });

    renderSelection(false);
  }
</script>
