---
import { composeXizongSystemFrameworkRepresentation } from '../lib/xizongRepresentationGate.mjs';

const { system, pathways, guide = null } = Astro.props;
const base = import.meta.env.BASE_URL;
const framework = composeXizongSystemFrameworkRepresentation(system);
const failureViews = pathways?.systemFailureViews || {};
const variableRows = framework.variables.rows;
const relationRows = framework.formulas;
const guideSections = guide?.sections || [];
const hasGuide = guideSections.length > 0;
const biochemistryLane = system?.biochemistryLane || null;
const biochemistryUnits = Array.isArray(biochemistryLane?.units) ? biochemistryLane.units : [];
const hasBiochemistryLane = biochemistryUnits.length > 0;
const biochemistryReconstructions = Array.isArray(biochemistryLane?.reconstructions) ? biochemistryLane.reconstructions : [];
const hasVariableRoles = variableRows.some((row) => row.role);
const spineLabels = framework.spine.items.map((item) => String(item || '').trim());
const spineTotalChars = spineLabels.reduce((sum, item) => sum + [...item].length, 0);
const spineMaxChars = spineLabels.reduce((max, item) => Math.max(max, [...item].length), 0);
const spineAverageChars = spineLabels.length ? spineTotalChars / spineLabels.length : 0;
const spineLayout = spineLabels.length >= 6 && (spineAverageChars >= 10 || spineMaxChars >= 15)
  ? 'vertical'
  : 'horizontal';
const axisRows = framework.judgmentAxes.items.map((item, index) => {
  const raw = String(item || '').trim();
  const pair = raw.includes('↔')
    ? raw.split('↔').map((value) => value.trim()).filter(Boolean)
    : /\s+vs\s+/i.test(raw)
      ? raw.split(/\s+vs\s+/i).map((value) => value.trim()).filter(Boolean)
      : [];
  return {
    id: `axis-${index + 1}`,
    raw,
    left: pair.length === 2 ? pair[0] : '',
    right: pair.length === 2 ? pair[1] : '',
    paired: pair.length === 2
  };
});
---

<section
  class="xzSystemWorkspace"
  data-xizong-system={system.systemId}
  data-representation-gate={framework.schema}
  data-system-framework-plan="purpose-first"
  data-system-default-view={hasGuide ? 'guide' : 'framework'}
>
  <header class="xzSystemTopbar">
    <div class="xzSystemIdentity">
      <span>{system.canonicalId} · SYSTEM</span>
      <h1>{system.title}</h1>
      <p data-representation-kind={framework.mission.representation.kind}>{framework.mission.text}</p>
    </div>
    <nav class="xzSystemViewTabs" aria-label="System view">
      {hasGuide && <button type="button" data-system-view-button="guide" aria-pressed="true">GUIDE</button>}
      <button type="button" data-system-view-button="framework" aria-pressed={hasGuide ? 'false' : 'true'}>FRAMEWORK</button>
      {hasBiochemistryLane && <button type="button" data-system-view-button="biochemistry" aria-pressed="false">27 生化</button>}
    </nav>
  </header>

  <div class="xzSystemBody" data-system-body>
    <aside class="xzSystemRouteRail" aria-label="System Block route">
      <header>
        <span>BLOCK ROUTE</span>
        <strong>{system.canonicalId} · {system.title}</strong>
      </header>
      <nav aria-label="Block route">
        {system.blocks.map((block, index) => (
          <a
            href={`${base}xizong/${system.systemId}/${block.slug}/`}
            data-system-block={index}
            class={index === 0 ? 'selected' : ''}
          >
            <b>{block.label}</b>
            <span>{block.title}</span>
          </a>
        ))}
      </nav>
    </aside>

    <main class="xzSystemStage">
      {hasGuide && (
        <section class="xzSystemGuideView" data-system-view="guide">
          <div class="xzSystemGuideLead">
            <span>BEGINNER GUIDE</span>
            <strong>第一次进入这个 System 时，用它把整张地图真正看懂。</strong>
            <p>看懂整体以后可随时切回 Framework；进入 Block 后继续沿原讲义 + KP Learn 主线学习。</p>
          </div>
          <div class="xzSystemGuideFlow">
            {guideSections.map((section) => (
              <article
                class:list={[
                  'xzSystemGuideSection',
                  `role-${String(section.role || 'EXPLANATION').toLowerCase()}`
                ]}
                data-guide-role={section.role}
              >
                <header>
                  <h2>{section.title}</h2>
                </header>
                <div class="xzSystemGuideMarkdown markdown" set:html={section.html}></div>
              </article>
            ))}
          </div>
        </section>
      )}

      {hasBiochemistryLane && (
        <section class="xzSystemBiochemistryView" data-system-view="biochemistry" hidden>
          <header class="xzBiochemistryLaneLead">
            <div>
              <span>27 BIOCHEMISTRY · SOURCE LANE</span>
              <h2>沿老师顺序连续学一次，知识回到整个 B 系统。</h2>
              <p>{biochemistryLane.sourceName} · Source 只读一条；26 精编的有效解释已经吸收到 Framework / KP，不再要求第二遍课程。</p>
            </div>
            <div class="xzBiochemistryMotherMaps">
              <span>{biochemistryLane?.mentalModels?.metabolism?.label || '物质—能量网络'}</span>
              <span>{biochemistryLane?.mentalModels?.information?.label || '信息生命周期'}</span>
            </div>
          </header>

          <div class="xzBiochemistryLane">
            <aside class="xzBiochemistryUnitRail" aria-label="27 生化 Source units">
              <header>
                <span>老师顺序</span>
                <strong data-biochemistry-progress>0 / {biochemistryUnits.length}</strong>
              </header>
              <nav>
                {biochemistryUnits.map((unit, index) => (
                  <button type="button" data-biochemistry-unit-target={unit.id} data-unit-index={index}>
                    <b>{String(index + 1).padStart(2, '0')}</b>
                    <span>{unit.label}</span>
                  </button>
                ))}
              </nav>
            </aside>

            <main class="xzBiochemistryUnitStage">
              {biochemistryUnits.map((unit, index) => (
                <article data-biochemistry-unit-panel={unit.id} hidden={index !== 0}>
                  <header>
                    <span>{unit.id} · PDF P{String(unit.pdf?.[0] || '').padStart(3, '0')}–P{String(unit.pdf?.[1] || '').padStart(3, '0')}</span>
                    <h2>{unit.label}</h2>
                  </header>

                  {unit.primaryTargets?.length > 0 && (
                    <section class="xzBioTargetSection primary">
                      <span>这段真正形成</span>
                      <div>
                        {unit.primaryTargets.map((target) => (
                          <a href={system.blocks.find((block) => block.blockId === target.blockId)?.slug
                            ? `${base}xizong/${system.systemId}/${system.blocks.find((block) => block.blockId === target.blockId)?.slug}/`
                            : undefined}>
                            <b>{target.blockId}</b>
                            <span>{target.blockTitle}</span>
                          </a>
                        ))}
                      </div>
                    </section>
                  )}

                  {unit.supportTargets?.length > 0 && (
                    <section class="xzBioTargetSection support">
                      <span>只借用 / 预热</span>
                      <p>{[...new Set(unit.supportTargets.map((target) => `${target.blockId} ${target.blockTitle}`))].join(' · ')}</p>
                    </section>
                  )}

                  {unit.connections?.length > 0 && (
                    <section class="xzBioTargetSection connection">
                      <span>Source 提示</span>
                      <p>{unit.connections.join(' · ')}</p>
                    </section>
                  )}

                  {unit.connectionRoutes?.length > 0 && (
                    <section class="xzBioTargetSection connection" data-biochemistry-reviewed-connections>
                      <span>JIT / Connection</span>
                      <div>
                        {unit.connectionRoutes.map((route) => (
                          <article
                            data-biochemistry-connection-route={route.id}
                            data-source-blocks={JSON.stringify(route.sourceBlocks)}
                            data-local-targets={JSON.stringify(route.localTargetBlockIds)}
                            data-external-targets={JSON.stringify(route.externalTargetRefs)}
                            data-post-formation={route.postFormation}
                          >
                            <strong>{route.sourceBlocks.join(' + ')} ↔ {route.targets.join(' + ')}</strong>
                            <p>{route.sharedModel}</p>
                            <small data-biochemistry-connection-status>JIT Connection · 当前只建立接口，不切换课程。</small>
                          </article>
                        ))}
                      </div>
                    </section>
                  )}

                  {unit.notes && (
                    <section class="xzBioTargetSection note">
                      <span>这一段怎么理解</span>
                      <p>{unit.notes}</p>
                    </section>
                  )}

                  {unit.closesBlocks?.length > 0 && (
                    <p class="xzBioClosure">学完这一段后，{unit.closesBlocks.join(' / ')} 的 Current Source 接触闭合，可回 KianOS 做对应 Recall。</p>
                  )}
                </article>
              ))}

              <footer class="xzBiochemistryLaneAction">
                <div>
                  <span data-biochemistry-current-status>准备从当前未完成 Source unit 继续。</span>
                  <small>这里只记录真实原讲义接触；不会把 Source unit 变成新的 Knowledge 层级。</small>
                </div>
                <button type="button" data-biochemistry-unit-complete>本段原讲义已完成</button>
              </footer>

              {biochemistryReconstructions.map((reconstruction) => (
                <section
                  class="xzBiochemistryReconstruction"
                  data-biochemistry-reconstruction={reconstruction.id}
                  hidden
                >
                  <span>阶段重构 · 非门槛</span>
                  <h3>把刚学过的机制重新拼回系统，而不是按 Block 名背一遍。</h3>
                  <p data-biochemistry-reconstruction-prompt>{reconstruction.prompt}</p>
                  <small data-biochemistry-reconstruction-boundary></small>
                  <button type="button" data-biochemistry-reconstruction-reveal>核对这阶段应该连起来什么</button>
                  <div data-biochemistry-reconstruction-answer hidden>
                    <strong data-biochemistry-reconstruction-target></strong>
                    <p data-biochemistry-reconstruction-closure></p>
                  </div>
                </section>
              ))}
            </main>
          </div>
        </section>
      )}

      <section class="xzSystemFrameworkView" data-system-view="framework" hidden={hasGuide}>
        <section class="xzSystemCanvas" data-system-section="mother">
          <header class="xzSystemSectionHeading">
            <span>SYSTEM MODEL</span>
            <h2>这个系统怎样运行？</h2>
          </header>

          {framework.motherModel.text && (
            <p class="xzSystemMother" data-representation-kind={framework.motherModel.representation.kind}>
              {framework.motherModel.text}
            </p>
          )}

          {framework.spine.items.length > 0 && (
            <div class="xzSystemSpineBlock" data-representation-kind={framework.spine.representation.kind}>
              <ol
                class="xzSystemSpine"
                data-system-spine
                data-spine-layout={spineLayout}
                data-spine-average-chars={spineAverageChars.toFixed(1)}
                data-spine-max-chars={spineMaxChars}
              >
                {framework.spine.items.map((item, index) => (
                  <li data-spine-node={index + 1}>
                    <b>{String(index + 1).padStart(2, '0')}</b>
                    <span>{item}</span>
                  </li>
                ))}
              </ol>
            </div>
          )}

          {framework.parallelControls.items.length > 0 && (
            <div class="xzSystemParallelBlock" data-representation-kind={framework.parallelControls.representation.kind}>
              <span>并行控制</span>
              <div class="xzSystemParallel">
                {framework.parallelControls.items.map((item) => <p>{item}</p>)}
              </div>
            </div>
          )}
        </section>

        {(variableRows.length > 0 || relationRows.length > 0 || axisRows.length > 0) && (
          <section class="xzSystemLanguageAxes">
            <article class="xzSystemLanguage">
              <header class="xzSystemSectionHeading">
                <span>SYSTEM LANGUAGE</span>
                <h2>描述这个系统时，用哪些变量和关系？</h2>
              </header>

              {variableRows.length > 0 && hasVariableRoles && (
                <div class="xzSystemVariableTable" data-representation-kind={framework.variables.representation.kind}>
                  {variableRows.map((item) => (
                    <div class="xzSystemVariableRow">
                      <strong>{[item.id, item.label].filter(Boolean).join(' · ')}</strong>
                      <span>{item.role}</span>
                    </div>
                  ))}
                </div>
              )}

              {variableRows.length > 0 && !hasVariableRoles && (
                <div class="xzSystemVariableFlow" data-representation-kind={framework.variables.representation.kind}>
                  {variableRows.map((item) => <span>{item.label}</span>)}
                </div>
              )}

              {relationRows.length > 0 && (
                <div class="xzSystemFormulaStrip">
                  {relationRows.map((item) => (
                    <span data-representation-kind={item.representation.kind}>{item.formula}</span>
                  ))}
                </div>
              )}
            </article>

            {axisRows.length > 0 && (
              <article class="xzSystemAxes" data-representation-kind={framework.judgmentAxes.representation.kind}>
                <header class="xzSystemSectionHeading">
                  <span>JUDGMENT AXES</span>
                  <h2>遇到病例，先沿哪些轴定位？</h2>
                </header>
                <div class="xzSystemAxisList">
                  {axisRows.map((axis) => axis.paired ? (
                    <div class="xzSystemAxis paired">
                      <span>{axis.left}</span>
                      <i aria-hidden="true"></i>
                      <span>{axis.right}</span>
                    </div>
                  ) : (
                    <div class="xzSystemAxis single"><span>{axis.raw}</span></div>
                  ))}
                </div>
              </article>
            )}
          </section>
        )}

        {framework.failures.length > 0 && (
          <section class="xzSystemFailureMap" data-system-section="failure">
            <header class="xzSystemSectionHeading">
              <span>FAILURE MAP</span>
              <h2>第一故障可能从哪里开始？</h2>
            </header>
            <div class="xzSystemFailureStrip">
              {framework.failures.map((mode, index) => (
                <button type="button" data-failure-id={mode.id}>
                  <b>F{index + 1}</b>
                  <span>{mode.label}</span>
                </button>
              ))}
            </div>
          </section>
        )}

        {framework.dependencies.items.length > 0 && (
          <details class="xzSystemDependency" data-representation-kind={framework.dependencies.representation.kind}>
            <summary>按需看当前明确的依赖关系</summary>
            <ul>{framework.dependencies.items.map((item) => <li>{item}</li>)}</ul>
          </details>
        )}
      </section>
    </main>

    <aside class="xzSystemContext" data-system-context hidden>
      <header>
        <div>
          <span>FAILURE CONTEXT</span>
          <strong data-failure-run-title>—</strong>
        </div>
        <button type="button" data-close-system-context aria-label="关闭 Failure Context">×</button>
      </header>
      <p data-failure-run-chain></p>
      <div data-failure-run-vars></div>
    </aside>
  </div>

  <script type="application/json" data-failure-payload set:html={JSON.stringify(Object.fromEntries(system.failureModes.map((mode) => [mode.id, {
    ...(failureViews[mode.id] || {}),
    label: mode.label,
    chain: mode.chain || failureViews[mode.id]?.chain || ''
  }])))}></script>
  {hasBiochemistryLane && (
    <script
      type="application/json"
      data-biochemistry-lane-payload
      set:html={JSON.stringify(biochemistryLane).replace(/</g, String.fromCharCode(92) + 'u003c')}
    ></script>
  )}
</section>

<script>
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  import { inspectXizongBlockCompletion } from '../lib/xizongMemoryAutoRelease.mjs';
  void learnerWriterReady.then(() => {

  const root = document.querySelector('[data-xizong-system]');
  if (root instanceof HTMLElement) {
    const systemId = root.getAttribute('data-xizong-system') || 'system';
    const defaultView = root.getAttribute('data-system-default-view') || 'framework';
    const body = root.querySelector('[data-system-body]');
    const viewButtons = [...root.querySelectorAll('[data-system-view-button]')];
    const views = [...root.querySelectorAll('[data-system-view]')];
    const links = [...root.querySelectorAll('[data-system-block]')];
    const context = root.querySelector('[data-system-context]');
    const contextClose = root.querySelector('[data-close-system-context]');
    const spineNodes = [...root.querySelectorAll('[data-spine-node]')];
    const failureButtons = [...root.querySelectorAll('[data-failure-id]')];
    const failureTitle = root.querySelector('[data-failure-run-title]');
    const failureChain = root.querySelector('[data-failure-run-chain]');
    const failureVars = root.querySelector('[data-failure-run-vars]');
    let failures = {};
    try { failures = JSON.parse(root.querySelector('[data-failure-payload]')?.textContent || '{}'); } catch {}
    let biochemistryLane = null;
    try { biochemistryLane = JSON.parse(root.querySelector('[data-biochemistry-lane-payload]')?.textContent || 'null'); } catch {}

    let selected = 0;
    try { selected = Number(sessionStorage.getItem(`kianos-xizong-system-selection:${systemId}`) || 0); } catch {}
    selected = Math.max(0, Math.min(links.length - 1, selected));

    const renderSelection = (scroll = true) => {
      links.forEach((link, index) => link.classList.toggle('selected', index === selected));
      if (scroll) links[selected]?.scrollIntoView({ block: 'nearest' });
      try { sessionStorage.setItem(`kianos-xizong-system-selection:${systemId}`, String(selected)); } catch {}
    };

    const closeContext = () => {
      if (context instanceof HTMLElement) context.hidden = true;
      if (body instanceof HTMLElement) body.classList.remove('context-open');
      failureButtons.forEach((button) => button.classList.remove('active'));
      spineNodes.forEach((node) => {
        node.classList.remove('mechanism-active');
        node.classList.remove('mechanism-dim');
      });
    };

    const setView = (name) => {
      const target = views.some((view) => view.getAttribute('data-system-view') === name) ? name : defaultView;
      views.forEach((view) => { view.hidden = view.getAttribute('data-system-view') !== target; });
      viewButtons.forEach((button) => {
        const active = button.getAttribute('data-system-view-button') === target;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      if (target !== 'framework') closeContext();
      try { localStorage.setItem(`kianos:xizong:system-view:${systemId}`, target); } catch {}
    };

    let initialView = defaultView;
    try {
      const saved = localStorage.getItem(`kianos:xizong:system-view:${systemId}`);
      if (saved) initialView = saved;
      const requested = new URLSearchParams(window.location.search).get('view');
      if (requested && views.some((view) => view.getAttribute('data-system-view') === requested)) initialView = requested;
    } catch {}
    setView(initialView);

    viewButtons.forEach((button) => button.addEventListener('click', () => {
      setView(button.getAttribute('data-system-view-button') || defaultView);
    }));

    if (biochemistryLane?.sourceHash && Array.isArray(biochemistryLane?.units)) {
      const ledgerKey = `kianos:xizong:biochemistry-source-lane:${systemId}:v1`;
      const unitButtons = [...root.querySelectorAll('[data-biochemistry-unit-target]')];
      const unitPanels = [...root.querySelectorAll('[data-biochemistry-unit-panel]')];
      const completeButton = root.querySelector('[data-biochemistry-unit-complete]');
      const progress = root.querySelector('[data-biochemistry-progress]');
      const currentStatus = root.querySelector('[data-biochemistry-current-status]');
      const connectionCards = [...root.querySelectorAll('[data-biochemistry-connection-route]')];
      const reconstructionCards = [...root.querySelectorAll('[data-biochemistry-reconstruction]')];
      const sourceHash = String(biochemistryLane.sourceHash);
      const units = biochemistryLane.units;
      let selectedUnit = -1;

      const readLedger = () => {
        try {
          const row = JSON.parse(localStorage.getItem(ledgerKey) || 'null');
          if (row?.schema === 'kianos.xizong.biochemistry-source-lane-state.v1' && Array.isArray(row.history)) return row;
        } catch {}
        return { schema: 'kianos.xizong.biochemistry-source-lane-state.v1', history: [] };
      };
      const writeLedger = (row) => {
        try { localStorage.setItem(ledgerKey, JSON.stringify(row)); return true; } catch { return false; }
      };
      const currentCompleted = (row) => new Set((row?.history || [])
        .filter((entry) => String(entry?.source_hash || '') === sourceHash)
        .map((entry) => String(entry?.source_unit_id || ''))
        .filter(Boolean));

      const completionRequirements = (() => {
        try {
          const raw = JSON.parse(document.querySelector('[data-xizong-completion-input]')?.textContent || '{}');
          return new Map((raw?.requirements || []).map((req) => [String(req?.identity?.blockId || ''), req]));
        } catch { return new Map(); }
      })();
      const blockIsCurrentComplete = (blockId) => {
        const requirement = completionRequirements.get(String(blockId || ''));
        if (!requirement) return false;
        try {
          const state = JSON.parse(localStorage.getItem(`kianos-xizong-astro-v2:xizong:${blockId}`) || 'null');
          return inspectXizongBlockCompletion(requirement, state || {}).complete === true;
        } catch { return false; }
      };

      const parseJsonAttr = (node, name) => {
        try { return JSON.parse(node.getAttribute(name) || '[]'); } catch { return []; }
      };
      const syncConnectionRoutes = () => {
        connectionCards.forEach((card) => {
          if (!(card instanceof HTMLElement)) return;
          const sourceBlocks = parseJsonAttr(card, 'data-source-blocks').map(String);
          const localTargets = parseJsonAttr(card, 'data-local-targets').map(String);
          const externalTargets = parseJsonAttr(card, 'data-external-targets').map(String);
          const sourceReady = sourceBlocks.length > 0 && sourceBlocks.every(blockIsCurrentComplete);
          const completedTargets = localTargets.filter(blockIsCurrentComplete);
          const pendingTargets = localTargets.filter((blockId) => !blockIsCurrentComplete(blockId));
          const localReady = localTargets.length > 0 && pendingTargets.length === 0;
          const reconstructionReady = sourceReady && localReady && externalTargets.length === 0
            && String(card.getAttribute('data-post-formation') || '').startsWith('RECONSTRUCT');
          const status = card.querySelector('[data-biochemistry-connection-status]');
          card.classList.toggle('reconstruction-ready', reconstructionReady);
          if (!status) return;
          if (reconstructionReady) {
            status.textContent = `跨系统重构已解锁 · ${sourceBlocks.join(' + ')} 与 ${localTargets.join(' + ')} 都已形成。`;
          } else if (completedTargets.length > 0) {
            const tail = [...pendingTargets, ...externalTargets];
            status.textContent = `Recall ${completedTargets.join(' + ')}；${tail.length ? `Future Connection ${tail.join(' + ')} 尚未形成/未在本页证明` : '继续当前生化 Source'}。`;
          } else if (sourceReady && (pendingTargets.length > 0 || externalTargets.length > 0)) {
            const futureTargets = [...pendingTargets, ...externalTargets];
            status.textContent = `Future Connection · ${futureTargets.join(' + ')} 尚未形成/未在本页证明；保留正式 owner 接口，不切换课程。`;
          } else if (externalTargets.length > 0 && localTargets.length === 0) {
            status.textContent = `Future Connection · ${externalTargets.join(' + ')} 的学习状态未在本页证明；只保留接口，不制造已学证据。`;
          } else {
            status.textContent = `JIT Connection · ${[...localTargets, ...externalTargets].join(' + ')} 先记住接口，不切换课程。`;
          }
        });
      };

      const syncReconstructions = () => {
        const rows = Array.isArray(biochemistryLane?.reconstructions) ? biochemistryLane.reconstructions : [];
        reconstructionCards.forEach((card) => {
          if (!(card instanceof HTMLElement)) return;
          const psrId = card.getAttribute('data-biochemistry-reconstruction') || '';
          const psr = rows.find((row) => String(row?.id || '') === psrId);
          if (!psr) { card.hidden = true; return; }
          const refreshes = Array.isArray(psr.incremental_refreshes) ? psr.incremental_refreshes : [];
          const externalRequired = Array.isArray(psr.external_required) ? psr.external_required.filter(Boolean) : [];
          const fullReady = externalRequired.length === 0
            && Array.isArray(psr.after_when_ready) && psr.after_when_ready.length
            && psr.after_when_ready.every(blockIsCurrentComplete);
          const eligible = refreshes.filter((row) =>
            Array.isArray(row?.after_when_ready) && row.after_when_ready.length
            && row.after_when_ready.every(blockIsCurrentComplete)
          );
          const active = fullReady
            ? { target: psr.target || '', closure: psr.closure || '', full: true }
            : eligible.at(-1);
          card.hidden = !active;
          if (!active) return;
          const target = card.querySelector('[data-biochemistry-reconstruction-target]');
          const closure = card.querySelector('[data-biochemistry-reconstruction-closure]');
          const answer = card.querySelector('[data-biochemistry-reconstruction-answer]');
          const boundary = card.querySelector('[data-biochemistry-reconstruction-boundary]');
          if (target) target.textContent = active.target || '';
          if (closure) closure.textContent = active.closure || '';
          if (boundary) boundary.textContent = externalRequired.length
            ? `当前只释放可证明的生化半层；完整重构还需要 ${externalRequired.join(' + ')}。`
            : active.full ? '当前 Source / Block 条件已满足，可做完整阶段重构。' : '当前只释放已经形成的增量阶段。';
          if (answer instanceof HTMLElement) answer.hidden = true;
        });
      };

      const syncIntegration = () => {
        syncConnectionRoutes();
        syncReconstructions();
      };

      const renderBiochemistryLane = () => {
        const ledger = readLedger();
        const completed = currentCompleted(ledger);
        const firstIncomplete = units.findIndex((unit) => !completed.has(String(unit.id || '')));
        const nextIndex = firstIncomplete < 0 ? Math.max(0, units.length - 1) : firstIncomplete;
        if (selectedUnit > nextIndex || selectedUnit < 0) selectedUnit = nextIndex;

        unitButtons.forEach((button, index) => {
          const unitId = button.getAttribute('data-biochemistry-unit-target') || '';
          const done = completed.has(unitId);
          button.classList.toggle('completed', done);
          button.classList.toggle('selected', index === selectedUnit);
          button.disabled = index > nextIndex;
        });
        unitPanels.forEach((panel, index) => { panel.hidden = index !== selectedUnit; });

        if (progress) progress.textContent = `${completed.size} / ${units.length}`;
        const selected = units[selectedUnit];
        const selectedDone = selected ? completed.has(String(selected.id || '')) : false;
        const allDone = completed.size >= units.length;
        if (completeButton instanceof HTMLButtonElement) {
          completeButton.disabled = allDone || selectedDone || selectedUnit !== nextIndex;
          completeButton.textContent = allDone ? '27 生化 Source 已完整接触' : selectedDone ? '本段已完成' : '本段原讲义已完成';
        }
        if (currentStatus) {
          currentStatus.textContent = allDone
            ? '27 生化连续 Source 已完整接触；后续进入对应 Block Recall / 系统重构。'
            : `当前 ${selected?.id || ''} · PDF P${String(selected?.pdf?.[0] || '').padStart(3, '0')}–P${String(selected?.pdf?.[1] || '').padStart(3, '0')}`;
        }
        syncIntegration();
      };

      unitButtons.forEach((button, index) => button.addEventListener('click', () => {
        if (button.disabled) return;
        selectedUnit = index;
        renderBiochemistryLane();
      }));
      completeButton?.addEventListener('click', () => {
        const unit = units[selectedUnit];
        if (!unit) return;
        const ledger = readLedger();
        const completed = currentCompleted(ledger);
        if (completed.has(String(unit.id || ''))) return;
        ledger.history = [...(ledger.history || []), {
          source_unit_id: String(unit.id || ''),
          source_hash: sourceHash,
          completed_at: new Date().toISOString()
        }];
        ledger.updated_at = new Date().toISOString();
        if (!writeLedger(ledger)) return;
        window.dispatchEvent(new CustomEvent('kianos:xizong-biochemistry-source-updated', {
          detail: { source_unit_id: unit.id, source_hash: sourceHash }
        }));
        selectedUnit = Math.min(units.length - 1, selectedUnit + 1);
        renderBiochemistryLane();
      });
      root.querySelectorAll('[data-biochemistry-reconstruction-reveal]').forEach((button) => {
        button.addEventListener('click', () => {
          const card = button.closest('[data-biochemistry-reconstruction]');
          const answer = card?.querySelector('[data-biochemistry-reconstruction-answer]');
          if (answer instanceof HTMLElement) answer.hidden = false;
        });
      });
      window.addEventListener('storage', (event) => {
        if (event.key === ledgerKey) renderBiochemistryLane();
      });
      window.addEventListener('kianos:xizong-block-complete', syncIntegration);
      renderBiochemistryLane();
    }

    links.forEach((link, index) => {
      link.addEventListener('focus', () => { selected = index; renderSelection(false); });
      link.addEventListener('mouseenter', () => { selected = index; renderSelection(false); });
    });

    const runFailure = (id) => {
      const view = failures[id];
      if (!view) return;

      const focus = new Set((view.focus_nodes || []).map(Number));
      spineNodes.forEach((node) => {
        const active = focus.has(Number(node.getAttribute('data-spine-node') || 0));
        node.classList.toggle('mechanism-active', active);
        node.classList.toggle('mechanism-dim', focus.size > 0 && !active);
      });
      failureButtons.forEach((button) => button.classList.toggle('active', button.getAttribute('data-failure-id') === id));

      if (failureTitle) failureTitle.textContent = view.label || id;
      if (failureChain) failureChain.textContent = view.chain || '这里只保留已经明确的故障定位；没有证据的链条不补猜。';
      if (failureVars) {
        failureVars.replaceChildren();
        (view.variables || []).forEach((value) => {
          const span = document.createElement('span');
          span.textContent = value;
          failureVars.appendChild(span);
        });
        if (view.parallel_focus) {
          const span = document.createElement('span');
          span.textContent = `并行：${view.parallel_focus}`;
          failureVars.appendChild(span);
        }
      }

      if (context instanceof HTMLElement) context.hidden = false;
      if (body instanceof HTMLElement) body.classList.add('context-open');
    };

    failureButtons.forEach((button) => button.addEventListener('click', () => runFailure(button.getAttribute('data-failure-id') || '')));
    contextClose?.addEventListener('click', closeContext);

    document.addEventListener('keydown', (event) => {
      const target = event.target;
      if (target instanceof HTMLElement && target.closest('input,textarea,select,button,[contenteditable="true"]')) return;
      if (event.key === 'ArrowUp') {
        event.preventDefault();
        selected = Math.max(0, selected - 1);
        renderSelection();
        return;
      }
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        selected = Math.min(links.length - 1, selected + 1);
        renderSelection();
        return;
      }
      if (event.key === 'Enter') {
        event.preventDefault();
        links[selected]?.click();
      }
    });

    renderSelection(false);
  }

  });
</script>
