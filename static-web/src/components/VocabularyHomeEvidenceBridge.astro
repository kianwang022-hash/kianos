---
const { rows = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const payload = JSON.stringify(rows).replace(/</g, '\\u003c');
---
<div data-lexical-home-evidence-bridge data-base={base} hidden>
  <script type="application/json" data-lexical-evidence-catalog set:html={payload}></script>
</div>
<script>
  import {
    LEXICAL_LEDGER_STORAGE_KEY,
    compileRepairTargets,
    emptyLexicalLedger,
    exportReturnEvents,
    normalizeLexicalLedger,
    reconcileEvidenceIdentity
  } from '../lib/lexicalEvidence.mjs';

  const bridge = document.querySelector('[data-lexical-home-evidence-bridge]');
  const home = document.querySelector('[data-lexical-home]');
  if (bridge instanceof HTMLElement && home instanceof HTMLElement) {
    const base = bridge.getAttribute('data-base') || '/';
    let rows = [];
    try { rows = JSON.parse(bridge.querySelector('[data-lexical-evidence-catalog]')?.textContent || '[]'); } catch {}

    const byObjectId = new Map(rows.map((row) => [row.objectId, row]));
    const lineage = rows.flatMap((row) => Array.isArray(row?.senseLineage) ? row.senseLineage : []);
    const readJson = (key, fallback) => {
      try { return JSON.parse(localStorage.getItem(key) || 'null') || fallback; } catch { return fallback; }
    };
    const saveJson = (key, value) => { try { localStorage.setItem(key, JSON.stringify(value)); } catch {} };
    const rawLedger = normalizeLexicalLedger(readJson(LEXICAL_LEDGER_STORAGE_KEY, emptyLexicalLedger()));
    const reconciled = reconcileEvidenceIdentity(rawLedger, lineage).ledger;
    saveJson(LEXICAL_LEDGER_STORAGE_KEY, reconciled);
    const readLedger = () => normalizeLexicalLedger(readJson(LEXICAL_LEDGER_STORAGE_KEY, reconciled));
    const localStudyDay = () => new Date().toLocaleDateString('en-CA');
    const eventLocalDay = (iso) => {
      const date = new Date(iso);
      return Number.isNaN(date.getTime()) ? '' : date.toLocaleDateString('en-CA');
    };
    const hrefFor = (ordinal) => `${base}vocabulary/${ordinal}/`;

    const renderReview = () => {
      const host = home.querySelector('[data-lexical-review-list]');
      if (!host) return;
      host.replaceChildren();
      const grouped = new Map();
      for (const target of compileRepairTargets(readLedger())) {
        if (!grouped.has(target.word_id)) grouped.set(target.word_id, []);
        grouped.get(target.word_id).push(target);
      }
      const groups = [...grouped]
        .map(([wordId, targets]) => ({ row: byObjectId.get(wordId), targets }))
        .filter(({ row }) => Boolean(row))
        .sort((a, b) => Number(a.row.ordinal) - Number(b.row.ordinal));
      if (!groups.length) {
        const empty = document.createElement('p');
        empty.className = 'lexicalEmpty';
        empty.textContent = '当前没有 evidence-backed Repair 对象。';
        host.appendChild(empty);
        return;
      }
      for (const { row, targets } of groups) {
        const link = document.createElement('a');
        link.className = 'lexicalWordRow';
        link.href = hrefFor(row.ordinal);
        const copy = document.createElement('div');
        const word = document.createElement('strong');
        word.textContent = row.word;
        const detail = document.createElement('span');
        detail.textContent = targets.some((target) => target.diagnosis_required)
          ? `${targets.length} Repair · 需要换诊断方式`
          : `${targets.length} exact Repair target${targets.length === 1 ? '' : 's'}`;
        copy.append(word, detail);
        const meta = document.createElement('small');
        meta.textContent = `#${row.ordinal} · ACTIVE from current evidence`;
        link.append(copy, meta);
        host.appendChild(link);
      }
    };

    const currentPacket = () => {
      const studyDay = localStudyDay();
      return {
        schema: 'kianos.lexical.return_packet.v1',
        study_day: studyDay,
        exported_at: new Date().toISOString(),
        events: exportReturnEvents(readLedger(), studyDay, eventLocalDay)
      };
    };

    let copyButton = home.querySelector('[data-lexical-copy-return]');
    if (copyButton instanceof HTMLButtonElement) {
      const clean = copyButton.cloneNode(true);
      copyButton.replaceWith(clean);
      copyButton = clean;
      copyButton.addEventListener('click', async () => {
        const packet = currentPacket();
        if (!packet.events.length) return;
        const text = JSON.stringify(packet, null, 2);
        try { await navigator.clipboard.writeText(text); copyButton.textContent = 'Copied'; }
        catch { window.prompt('Copy Return Packet', text); }
        window.setTimeout(() => { copyButton.textContent = 'Copy Return Packet'; }, 1200);
      });
    }

    const renderHandoff = () => {
      const packet = currentPacket();
      const handoff = home.querySelector('[data-lexical-handoff]');
      const summary = home.querySelector('[data-lexical-return-summary]');
      if (handoff instanceof HTMLElement) handoff.hidden = packet.events.length === 0;
      if (copyButton instanceof HTMLButtonElement) copyButton.disabled = packet.events.length === 0;
      if (summary) summary.textContent = packet.events.length
        ? `当前学习日有 ${packet.events.length} 条可追溯 lexical evidence；重复导入会按 event identity 去重。`
        : '';
    };

    const render = () => { renderReview(); renderHandoff(); };
    home.querySelectorAll('[data-lexical-tab]').forEach((button) => button.addEventListener('click', () => queueMicrotask(render)));
    window.addEventListener('kianos:lexical-evidence-changed', render);
    window.addEventListener('storage', (event) => { if (event.key === LEXICAL_LEDGER_STORAGE_KEY) render(); });
    render();
  }
</script>
