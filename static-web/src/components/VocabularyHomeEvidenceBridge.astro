---
const { rows = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const payload = JSON.stringify(rows).replace(/</g, '\\u003c');
---
<div data-lexical-home-evidence-bridge data-base={base} hidden>
  <script type="application/json" data-lexical-evidence-catalog set:html={payload}></script>
</div>
<script>
  import {
    LEXICAL_LEDGER_STORAGE_KEY,
    compileRepairTargets,
    reconcileEvidenceIdentity
  } from '../lib/lexicalEvidence.mjs';
  import {
    LEXICAL_INTAKE_STORAGE_KEY,
    LEXICAL_ROUTING_STORAGE_KEY,
    LEXICAL_SETTINGS_STORAGE_KEY
  } from '../lib/lexicalSettings.mjs';
  import { buildLexicalChatStatePacket, serializeLexicalChatStateForChat } from '../lib/lexicalChatState.mjs';
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  import { readBrowserLexicalLedger, writeBrowserLexicalLedger, lexicalBrowserStateReadable } from '../lib/lexicalBrowserState.mjs';
  const copyTextRobust = async (text) => {
    if (navigator.clipboard?.writeText && window.isSecureContext) {
      try { await navigator.clipboard.writeText(text); return true; } catch {}
    }
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.left = '-9999px';
    textarea.style.top = '0';
    document.body.appendChild(textarea);
    textarea.focus();
    textarea.select();
    let copied = false;
    try { copied = Boolean(document.execCommand?.('copy')); } catch {}
    textarea.remove();
    if (copied) return true;
    window.prompt('复制学习状态给 Chat', text);
    return false;
  };

  // Read-only handoff must not depend on learner-writer ownership.
  // Copying/exporting state is safe even when another KianOS tab owns the write lock
  // or the browser cannot provide Web Locks/BroadcastChannel.
  const bindReadOnlyHandoff = () => {
    if (!lexicalBrowserStateReadable()) return;
    const bridge = document.querySelector('[data-lexical-home-evidence-bridge]');
    const home = document.querySelector('[data-lexical-home]');
    if (!(bridge instanceof HTMLElement) || !(home instanceof HTMLElement)) return;

    let rows = [];
    try { rows = JSON.parse(bridge.querySelector('[data-lexical-evidence-catalog]')?.textContent || '[]'); } catch {}
    const lineage = rows.flatMap((row) => Array.isArray(row?.senseLineage) ? row.senseLineage : []);
    const readJson = (key, fallback) => {
      try { return JSON.parse(localStorage.getItem(key) || 'null') || fallback; } catch { return fallback; }
    };
    const readLedger = () => reconcileEvidenceIdentity(
      readBrowserLexicalLedger(),
      lineage
    ).ledger;

    const currentPacket = () => {
      const lastOrdinalRaw = Number(localStorage.getItem('kianos-vocabulary-last-ordinal') || 1);
      const lastOrdinal = Number.isInteger(lastOrdinalRaw) && lastOrdinalRaw >= 1 ? lastOrdinalRaw : 1;
      const cursorRow = rows.find((row) => Number(row.ordinal) === lastOrdinal) || rows[0] || null;
      return buildLexicalChatStatePacket({
        ledger: readLedger(),
        routing: readJson(LEXICAL_ROUTING_STORAGE_KEY, null),
        intake: readJson(LEXICAL_INTAKE_STORAGE_KEY, null),
        settings: readJson(LEXICAL_SETTINGS_STORAGE_KEY, null),
        cursor: cursorRow ? { word_id: cursorRow.objectId, ordinal: Number(cursorRow.ordinal), word: cursorRow.word } : null,
        challengePacket: readJson('kianos-lexical-challenge-packet-v1', null),
        challengeProgress: readJson('kianos-lexical-challenge-progress-v1', null),
        challengeEvents: readJson('kianos-lexical-challenge-events-v1', []),
        now: new Date()
      });
    };

    const renderReadOnlyHandoff = () => {
      const packet = currentPacket();
      const handoff = home.querySelector('[data-lexical-handoff]');
      const summary = home.querySelector('[data-lexical-return-summary]');
      const hasState = packet.coverage.introduced_total > 0
        || packet.routing.latest_total > 0
        || packet.repair.active_target_count > 0
        || packet.today_evidence.length > 0
        || Boolean(packet.challenge_session);
      if (handoff instanceof HTMLElement) handoff.hidden = !hasState;
      if (summary) summary.textContent = hasState
        ? `已进入 ${packet.coverage.introduced_total} 词 · 今日 ${packet.coverage.today_new} 新词 · ${packet.routing.same_day_revisit.length} 个同日待重学 · ${packet.repair.active_target_count} 个 Repair`
        : '';

      const copyButton = home.querySelector('[data-lexical-copy-return]');
      if (copyButton instanceof HTMLButtonElement) {
        copyButton.disabled = !hasState;
        if (!copyButton.dataset.readOnlyCopyBound) {
          copyButton.dataset.readOnlyCopyBound = 'true';
          copyButton.addEventListener('click', async () => {
            const text = serializeLexicalChatStateForChat(currentPacket());
            const copied = await copyTextRobust(text);
            copyButton.textContent = copied ? '已复制' : '请手动复制';
            window.setTimeout(() => { copyButton.textContent = '复制学习状态给 Chat'; }, 1400);
          });
        }
      }
    };

    renderReadOnlyHandoff();
    window.addEventListener('kianos:lexical-evidence-changed', renderReadOnlyHandoff);
    window.addEventListener('storage', renderReadOnlyHandoff);
  };

  bindReadOnlyHandoff();

  void learnerWriterReady.then(() => {
  if (!lexicalBrowserStateReadable()) return;


  const bridge = document.querySelector('[data-lexical-home-evidence-bridge]');
  const home = document.querySelector('[data-lexical-home]');
  if (bridge instanceof HTMLElement && home instanceof HTMLElement) {
    const base = bridge.getAttribute('data-base') || '/';
    let rows = [];
    try { rows = JSON.parse(bridge.querySelector('[data-lexical-evidence-catalog]')?.textContent || '[]'); } catch {}

    const byObjectId = new Map(rows.map((row) => [row.objectId, row]));
    const lineage = rows.flatMap((row) => Array.isArray(row?.senseLineage) ? row.senseLineage : []);
    const readJson = (key, fallback) => {
      try { return JSON.parse(localStorage.getItem(key) || 'null') || fallback; } catch { return fallback; }
    };
    const rawLedger = readBrowserLexicalLedger();
    const reconciled = reconcileEvidenceIdentity(rawLedger, lineage).ledger;
    if(!(new URLSearchParams(location.search).has('lookup')||new URLSearchParams(location.search).get('from')==='english'))writeBrowserLexicalLedger(reconciled);
    const readLedger = () => readBrowserLexicalLedger();
    const localStudyDay = () => new Date().toLocaleDateString('en-CA');
    const eventLocalDay = (iso) => {
      const date = new Date(iso);
      return Number.isNaN(date.getTime()) ? '' : date.toLocaleDateString('en-CA');
    };
    const hrefFor = (ordinal, mode = 'study') => {
      const href = `${base}vocabulary/${ordinal}/`;
      return mode === 'study' ? href : `${href}?mode=${encodeURIComponent(mode)}`;
    };

    const currentRepairTargets = () => compileRepairTargets(readLedger());

    const renderRepairSummary = () => {
      const targets = currentRepairTargets();
      const wordCount = new Set(targets.map((target) => target.word_id).filter(Boolean)).size;
      home.querySelectorAll('[data-lexical-repair-count]').forEach((node) => { node.textContent = String(targets.length); });
      home.querySelectorAll('[data-lexical-repair-word-count]').forEach((node) => { node.textContent = String(wordCount); });
    };

    const renderReview = () => {
      const host = home.querySelector('[data-lexical-review-list]');
      if (!host) return;
      host.replaceChildren();
      const grouped = new Map();
      for (const target of currentRepairTargets()) {
        if (!grouped.has(target.word_id)) grouped.set(target.word_id, []);
        grouped.get(target.word_id).push(target);
      }
      const groups = [...grouped]
        .map(([wordId, targets]) => ({ row: byObjectId.get(wordId), targets }))
        .filter(({ row }) => Boolean(row))
        .sort((a, b) => Number(a.row.ordinal) - Number(b.row.ordinal));
      if (!groups.length) {
        const empty = document.createElement('p');
        empty.className = 'lexicalEmpty';
        empty.textContent = '当前没有需要处理的 Repair 对象。';
        host.appendChild(empty);
        return;
      }
      for (const { row, targets } of groups) {
        const link = document.createElement('a');
        link.className = 'lexicalWordRow';
        link.href = hrefFor(row.ordinal, 'repair');
        const copy = document.createElement('div');
        const word = document.createElement('strong');
        word.textContent = row.word;
        const detail = document.createElement('span');
        detail.textContent = targets.some((target) => target.diagnosis_required)
          ? `${targets.length} 个 Repair 对象 · 需要换一种测试方式`
          : `${targets.length} 个 Repair 对象`;
        copy.append(word, detail);
        const meta = document.createElement('small');
        meta.textContent = `#${row.ordinal} · 当前 Repair`;
        link.append(copy, meta);
        host.appendChild(link);
      }
    };

    const currentPacket = () => {
      const lastOrdinalRaw = Number(localStorage.getItem('kianos-vocabulary-last-ordinal') || 1);
      const lastOrdinal = Number.isInteger(lastOrdinalRaw) && lastOrdinalRaw >= 1 ? lastOrdinalRaw : 1;
      const cursorRow = rows.find((row) => Number(row.ordinal) === lastOrdinal) || rows[0] || null;
      return buildLexicalChatStatePacket({
        ledger: readLedger(),
        routing: readJson(LEXICAL_ROUTING_STORAGE_KEY, null),
        intake: readJson(LEXICAL_INTAKE_STORAGE_KEY, null),
        settings: readJson(LEXICAL_SETTINGS_STORAGE_KEY, null),
        cursor: cursorRow ? { word_id: cursorRow.objectId, ordinal: Number(cursorRow.ordinal), word: cursorRow.word } : null,
        challengePacket: readJson('kianos-lexical-challenge-packet-v1', null),
        challengeProgress: readJson('kianos-lexical-challenge-progress-v1', null),
        challengeEvents: readJson('kianos-lexical-challenge-events-v1', []),
        now: new Date()
      });
    };

    let copyButton = home.querySelector('[data-lexical-copy-return]');
    if (copyButton instanceof HTMLButtonElement) {
      const clean = copyButton.cloneNode(true);
      copyButton.replaceWith(clean);
      copyButton = clean;
      copyButton.addEventListener('click', async () => {
        const packet = currentPacket();
        const text = serializeLexicalChatStateForChat(packet);
        const copied = await copyTextRobust(text);
        copyButton.textContent = copied ? '已复制' : '请手动复制';
        window.setTimeout(() => { copyButton.textContent = '复制学习状态给 Chat'; }, 1400);
      });
    }

    const renderHandoff = () => {
      const packet = currentPacket();
      const handoff = home.querySelector('[data-lexical-handoff]');
      const summary = home.querySelector('[data-lexical-return-summary]');
      const hasState = packet.coverage.introduced_total > 0
        || packet.routing.latest_total > 0
        || packet.repair.active_target_count > 0
        || packet.today_evidence.length > 0
        || Boolean(packet.challenge_session);
      if (handoff instanceof HTMLElement) handoff.hidden = !hasState;
      if (copyButton instanceof HTMLButtonElement) copyButton.disabled = !hasState;
      if (summary) summary.textContent = hasState
        ? `已进入 ${packet.coverage.introduced_total} 词 · 今日 ${packet.coverage.today_new} 新词 · ${packet.routing.same_day_revisit.length} 个同日待重学 · ${packet.repair.active_target_count} 个 Repair`
        : '';
    };

    const render = () => { renderRepairSummary(); renderReview(); renderHandoff(); };
    home.querySelectorAll('[data-lexical-tab]').forEach((button) => button.addEventListener('click', () => queueMicrotask(render)));
    window.addEventListener('kianos:lexical-evidence-changed', render);
    window.addEventListener('storage', (event) => { if (event.key === LEXICAL_LEDGER_STORAGE_KEY) render(); });
    render();
  }

  });
</script>
