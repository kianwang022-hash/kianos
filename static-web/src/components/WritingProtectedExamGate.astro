---
const { task } = Astro.props;
const base = import.meta.env.BASE_URL;
const payload = JSON.stringify({ taskId: task.id, taskKind: task.kind }).replace(/</g, '\\u003c');
---
<section class="writingExamGate" data-writing-exam-gate>
  <section class="writingExamLocked" data-exam-locked>
    <span>真题 · 题面尚未展开</span>
    <h2>准备独立完成这篇作文</h2>
    <p>打开后，这道题就不再是未见材料。若还不能独立从题目写到成文，先用起步练习找到缺口；已有这项能力可以直接进入，不必补做课程。</p>
    <a href={`${base}writing/`}>← 返回 Writing / 起步练习</a>
    <button type="button" data-writing-open-task>我已准备好，打开这篇</button>
  </section>
  <div data-exam-runtime hidden><slot /></div>
  <script type="application/json" data-exam-gate-payload set:html={payload}></script>
</section>
<script>
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(() => {

  const gate = document.querySelector('[data-writing-exam-gate]');
  if (gate instanceof HTMLElement) {
    const payload = JSON.parse(gate.querySelector('[data-exam-gate-payload]')?.textContent || '{}');
    const locked = gate.querySelector('[data-exam-locked]');
    const shell = gate.querySelector('[data-exam-runtime]');
    const open = () => {
      if (!(shell instanceof HTMLElement)) return;
      shell.hidden = false;
      if (locked instanceof HTMLElement) locked.hidden = true;
      window.dispatchEvent(new CustomEvent('kianos:writing-task-opened'));
    };
    gate.querySelector('[data-writing-open-task]')?.addEventListener('click', open);
    // A real saved attempt is a resume, not new exposure or proof of competence.
    // No bootstrap writes occur inside the unopened gate.
    if (localStorage.getItem(`kianos-writing-runtime-v1:${payload.taskId}`) !== null) open();
  }

  });
</script>
<style>
  .writingExamGate{display:grid;gap:12px}.writingExamLocked{max-width:54rem;margin:28px auto;padding:28px;border:1px solid var(--study-line);border-radius:16px;background:#fffdf8;box-shadow:var(--study-shadow)}.writingExamLocked span{font-size:9px;font-weight:850;letter-spacing:.08em;text-transform:uppercase;color:var(--study-green)}.writingExamLocked h2{margin:6px 0 8px}.writingExamLocked p{margin:0 0 14px;color:var(--study-muted);font-size:12px;line-height:1.7}.writingExamLocked a{font-size:11px;font-weight:800;color:var(--study-green);text-decoration:none}
</style>
