---
const { block } = Astro.props;
const base = import.meta.env.BASE_URL;
const kps = block?.kpRecords || [];
const groups = block?.logicGroups || [];
const firstKp = kps[0];
---
<section class="portedStudyRuntime portedStudyRuntimeV2 xv6Block" data-xizong-v6-block data-study-object={block.objectId} data-block-label={block.label}>
  <header class="portedStudyHeader">
    <div class="portedStudyContextRow">
      <a href={`${base}xizong/${block.systemId}/`}>‹ {block.systemTitle}</a>
      <span>{block.systemTitle} › {block.label}</span>
      <div class="portedStudyShellActions">
        <button type="button" data-toggle-outline aria-pressed="false">目录</button>
        <button type="button" data-toggle-chain aria-pressed="false">学习链</button>
      </div>
    </div>
    <div class="portedStudyIdentity">
      <div>
        <span data-study-context-label>西医综合 · {block.label} · Learn · Block Learn</span>
        <h2>{block.title}</h2>
      </div>
      <div class="portedStudyIdentityMeta">
        <strong data-study-local-status>本机进度 · 0/{kps.length}</strong>
        <small>Canonical read-only · learner state local-only</small>
      </div>
    </div>
    <nav class="portedStudyTabs" aria-label="Block workspace">
      <button type="button" class="active" data-study-tab="learn">Learn</button>
      <button type="button" data-study-tab="outline">Outline</button>
    </nav>
  </header>

  <div class="portedStudyLayout" data-study-layout>
    <aside class="portedStudyOutline" id="content-map">
      <header><span data-study-rail-kicker>Logic Map</span><strong data-study-rail-title>连续学习</strong></header>
      <nav data-study-group-rail aria-label="Logic Group navigation">
        {groups.map((group, index) => <button type="button" data-group-target={index}>
          <b>LG{String(index + 1).padStart(2, '0')}</b>
          <span>{group.label}</span>
          <small>{group.kpCount} KP</small>
        </button>)}
      </nav>
      <nav class="portedStudyKpRail" data-study-kp-rail aria-label="KP navigation" hidden>
        {kps.map((kp, index) => <button type="button" data-kp-target={index}>
          <b>{kp.displayId}</b><span>{kp.groupLabel}</span><small data-kp-state={kp.kpId}>未记录</small>
        </button>)}
      </nav>
      <footer>Logic Group 来自 Current system owner；医学 Core 仍只来自当前 Block Markdown。</footer>
    </aside>

    <main class="portedStudyMain" id="canonical-content">
      <section data-study-panel="learn">
        <section data-study-stage="block_learn">
          <div class="portedStudyLead"><span>Learn · Block Learn</span><strong>先建立这一块的局部机制电影，再进入 Logic Group。</strong></div>
          <article class="portedStudyArticle markdown" set:html={block.blockLearnHtml}></article>
          {block.visualGateHtml && <details class="xv6VisualGate"><summary>Visual Gate · 必看原图</summary><div class="markdown" set:html={block.visualGateHtml}></div></details>}
          <footer class="portedStudyStageAction"><span>这里只完成局部模型定位，不代表掌握。</span><button type="button" class="portedPrimaryAction" data-stage-next="logic_group">进入 Logic Group</button></footer>
        </section>

        <section class="xv6LogicStage" data-study-stage="logic_group" hidden>
          <span>Learn · Logic Group</span>
          <b data-logic-counter>LG01 / {groups.length}</b>
          <h3 data-logic-title>{groups[0]?.label}</h3>
          <p>先回答“接下来这组 KP 在共同解决什么问题”，再进入本组连续精学。</p>
          <div class="xv6LogicKps" data-logic-kps>
            {groups[0]?.kpIds.map((id) => <code>{id.split('-').at(-1)?.toUpperCase()}</code>)}
          </div>
          <button type="button" class="portedPrimaryAction" data-enter-group>进入本组 KP</button>
        </section>

        <section class="portedKpWorkspace" data-study-stage="kp_learn" hidden>
          <header class="portedKpWorkspaceHeader">
            <div><span>Learn · KP</span><strong data-kp-learn-title>{firstKp?.displayId} · {firstKp?.title}</strong></div>
            <div><button type="button" data-kp-prev>‹</button><em data-kp-counter>1 / {kps.length}</em><button type="button" data-kp-next>›</button></div>
          </header>
          <div class="portedKpCards">
            {kps.map((kp, index) => <article class="portedKpCard" data-kp-learn-card={index} hidden={index !== 0}>
              <header><span>{kp.groupLabel}</span><h3>{kp.displayId}｜{kp.title}</h3>{kp.prompt && <p>{kp.prompt}</p>}</header>
              <div class="portedKpCanonical markdown" set:html={kp.detailHtml}></div>
              <footer><span>Current canonical · {kp.kpId}</span><button type="button" data-kp-learned={kp.kpId}>本 KP 已精学</button></footer>
            </article>)}
          </div>
        </section>

        <section class="xv6LogicStage close" data-study-stage="group_close" hidden>
          <span>Natural subsection closure</span>
          <h3 data-group-close-title>本 Logic Group 已闭合</h3>
          <p>此时才释放该自然小节的 Lecture-attached Questions。当前 Current 没有暴露可验证的题组 Binding，因此 Astro 不补造题目，也不伪造完成状态。</p>
          <button type="button" class="portedPrimaryAction" data-group-close-next>完成讲义配套题后继续</button>
        </section>

        <section class="portedKpWorkspace recall" data-study-stage="kp_recall" hidden>
          <header class="portedKpWorkspaceHeader">
            <div><span>Recall · KP</span><strong data-kp-recall-title>{firstKp?.displayId}</strong></div>
            <div><button type="button" data-recall-prev>‹</button><em data-recall-counter>1 / {kps.length}</em><button type="button" data-recall-next>›</button></div>
          </header>
          <div class="portedKpCards">
            {kps.map((kp, index) => <article class="portedKpRecallCard" data-kp-recall-card={index} data-kp-id={kp.kpId} hidden={index !== 0}>
              <header><span>{kp.groupLabel}</span><h3>{kp.displayId}</h3>{kp.prompt && <p>{kp.prompt}</p>}</header>
              <div class="portedRecallPrompt"><strong>先主动恢复，不看答案型标题。</strong><button type="button" data-kp-reveal>Reveal Core</button></div>
              <div class="portedRecallAnswer" data-kp-answer hidden>
                <h4>{kp.title}</h4>
                <div class="markdown" set:html={kp.detailHtml}></div>
              </div>
              <footer class="portedRecallRating" data-kp-rating hidden>
                <span>这次回忆质量</span>
                <div><button type="button" data-rating="unknown">1 · 没记住</button><button type="button" data-rating="fuzzy">2 · 模糊</button><button type="button" data-rating="known">3 · 会了</button><button type="button" data-rating="mastered">4 · 稳定</button></div>
              </footer>
            </article>)}
          </div>
        </section>

        <section class="portedBlockRecall" data-study-stage="block_recall" hidden>
          <header><span>Recall · Block</span><h3>先恢复整块，再按 Logic Group 核对</h3><p>{block.centerQuestion}</p></header>
          <div>{groups.map((group) => <details>
            <summary><strong>{group.label}</strong><small>KP{String(group.start).padStart(2, '0')}–KP{String(group.end).padStart(2, '0')}</small></summary>
            <div class="xv6RecallList">{kps.filter((kp) => kp.groupId === group.groupId).map((kp) => <details>
              <summary><b>{kp.displayId}</b><span>{kp.title}</span></summary>
              {kp.prompt && <p>{kp.prompt}</p>}
              <div class="markdown" set:html={kp.detailHtml}></div>
            </details>)}</div>
          </details>)}</div>
          <footer><span>展开核对不会自动算完成。</span><button type="button" data-block-recall-complete>确认本轮 Block Recall 已完成</button></footer>
        </section>

        <section class="portedBlockComplete" data-study-stage="block_complete" hidden>
          <span>Learn · Block 完成</span><h3 data-block-complete-title>还没有满足本机 First-Pass 检查点</h3>
          <p data-block-complete-detail>需要完成全部 KP 精学、全部 KP Recall 评分，并明确完成一次 Block Recall。</p>
          <button type="button" class="portedPrimaryAction" data-block-complete disabled>确认 Block 第一轮完成</button>
          <small>这里只写浏览器本地 learner state；不会修改 Current content。</small>
        </section>
      </section>

      <section class="portedStudyOutlinePanel" data-study-panel="outline" hidden>
        <header><span>Outline · Logic index</span><h3>Block 学习地图</h3><p>这里只投影 Current system.json 的 Logic Group → stable KP 关系；不是第二份知识内容。</p></header>
        <div class="portedOutlineSectionList">
          {groups.map((group, index) => <section><b>{String(index + 1).padStart(2, '0')}</b><div><strong>{group.label}</strong><p>KP{String(group.start).padStart(2, '0')}–KP{String(group.end).padStart(2, '0')}</p></div><button type="button" data-outline-open={index}>进入</button></section>)}
        </div>
      </section>
    </main>

    <aside class="portedStudyChain" aria-label="Learning Chain">
      <header><span>Learning Chain</span><strong>v6 · First-Pass</strong></header>
      <ol>
        <li data-chain-step="block_learn"><button type="button" data-stage-target="block_learn"><i></i><span><b>Block Learn</b><small>局部模型</small></span></button></li>
        <li data-chain-step="logic_group"><button type="button" data-stage-target="logic_group"><i></i><span><b>Logic Group</b><small data-chain-group>1/{groups.length}</small></span></button></li>
        <li data-chain-step="kp_learn"><button type="button" data-stage-target="kp_learn"><i></i><span><b>KP Learn</b><small data-chain-kp-learn>0/{kps.length}</small></span></button></li>
        <li data-chain-step="kp_recall"><button type="button" data-stage-target="kp_recall"><i></i><span><b>KP Recall</b><small data-chain-kp-recall>0/{kps.length}</small></span></button></li>
        <li data-chain-step="block_recall"><button type="button" data-stage-target="block_recall"><i></i><span><b>Block Recall</b><small data-chain-block-recall>未完成</small></span></button></li>
        <li data-chain-step="block_complete"><button type="button" data-stage-target="block_complete"><i></i><span><b>Block Complete</b><small data-chain-complete>未完成</small></span></button></li>
      </ol>
      <footer>配套题按自然小节闭合释放；无 verified Binding 时 fail closed。</footer>
    </aside>
  </div>

  <details class="portedSourceFoot"><summary>Current Block owner</summary><code>{block.sourcePath}</code><code>sha256:{String(block.sourceHash).slice(0, 16)}</code></details>
</section>

<script define:vars={{ groupPayload: groups.map((group) => ({ groupId: group.groupId, label: group.label, start: group.start, end: group.end, kpIds: group.kpIds })), kpPayload: kps.map((kp) => ({ kpId: kp.kpId, displayId: kp.displayId, title: kp.title, groupId: kp.groupId })) }}>
  const root = document.querySelector('[data-xizong-v6-block]');
  if (root) {
    const objectId = root.getAttribute('data-study-object') || 'xizong:unknown';
    const blockLabel = root.getAttribute('data-block-label') || 'Block';
    const storageKey = `kianos-xizong-astro-v2:${objectId}`;
    const groups = groupPayload || [];
    const kpData = kpPayload || [];
    const kpLearnCards = [...root.querySelectorAll('[data-kp-learn-card]')];
    const kpRecallCards = [...root.querySelectorAll('[data-kp-recall-card]')];
    const kpRailButtons = [...root.querySelectorAll('[data-kp-target]')];
    const groupRailButtons = [...root.querySelectorAll('[data-group-target]')];
    const stages = [...root.querySelectorAll('[data-study-stage]')];
    const tabButtons = [...root.querySelectorAll('[data-study-tab]')];
    const tabPanels = [...root.querySelectorAll('[data-study-panel]')];
    const layout = root.querySelector('[data-study-layout]');
    const kpRail = root.querySelector('[data-study-kp-rail]');
    const groupRail = root.querySelector('[data-study-group-rail]');
    const contextLabel = root.querySelector('[data-study-context-label]');
    const statusLabel = root.querySelector('[data-study-local-status]');
    const totalKp = kpLearnCards.length;
    let state = { stage: 'block_learn', groupIndex: 0, kpIndex: 0, learned: {}, ratings: {}, blockRecallDone: false, completed: false };
    try { state = { ...state, ...(JSON.parse(localStorage.getItem(storageKey) || 'null') || {}) }; } catch {}

    const save = () => { try { localStorage.setItem(storageKey, JSON.stringify(state)); } catch {} };
    const learnedCount = () => Object.values(state.learned || {}).filter(Boolean).length;
    const recallCount = () => Object.keys(state.ratings || {}).length;
    const canComplete = () => totalKp > 0 && learnedCount() >= totalKp && recallCount() >= totalKp && Boolean(state.blockRecallDone);
    const currentGroup = () => groups[Math.max(0, Math.min(groups.length - 1, Number(state.groupIndex || 0)))] || groups[0];
    const groupIndexForKp = (index) => {
      const ordinal = index + 1;
      return Math.max(0, groups.findIndex((group) => ordinal >= group.start && ordinal <= group.end));
    };
    const stageLabel = { block_learn: 'Block Learn', logic_group: 'Logic Group', kp_learn: 'KP Learn', group_close: '自然小节闭合', kp_recall: 'KP Recall', block_recall: 'Block Recall', block_complete: 'Block Complete' };

    const syncGroupStage = () => {
      const group = currentGroup();
      root.querySelector('[data-logic-counter]')?.replaceChildren(document.createTextNode(`LG${String(state.groupIndex + 1).padStart(2, '0')} / ${groups.length}`));
      root.querySelector('[data-logic-title]')?.replaceChildren(document.createTextNode(group?.label || 'Logic Group'));
      const box = root.querySelector('[data-logic-kps]');
      if (box) {
        box.replaceChildren();
        (group?.kpIds || []).forEach((id) => { const code = document.createElement('code'); code.textContent = id.split('-').at(-1)?.toUpperCase() || id; box.appendChild(code); });
      }
      root.querySelector('[data-chain-group]')?.replaceChildren(document.createTextNode(`${state.groupIndex + 1}/${groups.length}`));
      groupRailButtons.forEach((button, index) => { button.classList.toggle('active', index === state.groupIndex); button.classList.toggle('done', (groups[index]?.end || 0) <= learnedCount()); });
    };

    const syncState = () => {
      kpRailButtons.forEach((button, index) => {
        const kpId = kpData[index]?.kpId || '';
        const small = button.querySelector('[data-kp-state]');
        const rating = state.ratings?.[kpId];
        const learned = Boolean(state.learned?.[kpId]);
        if (small) small.textContent = rating || (learned ? '已精学' : '未记录');
        button.classList.toggle('active', index === state.kpIndex);
        button.classList.toggle('done', learned || Boolean(rating));
      });
      root.querySelector('[data-chain-kp-learn]')?.replaceChildren(document.createTextNode(`${learnedCount()}/${totalKp}`));
      root.querySelector('[data-chain-kp-recall]')?.replaceChildren(document.createTextNode(`${recallCount()}/${totalKp}`));
      root.querySelector('[data-chain-block-recall]')?.replaceChildren(document.createTextNode(state.blockRecallDone ? '已完成' : '未完成'));
      root.querySelector('[data-chain-complete]')?.replaceChildren(document.createTextNode(state.completed ? '已完成' : '未完成'));
      if (statusLabel) statusLabel.textContent = `本机进度 · 精学 ${learnedCount()}/${totalKp} · Recall ${recallCount()}/${totalKp}`;
      const completeButton = root.querySelector('[data-block-complete]');
      if (completeButton) completeButton.disabled = !canComplete() || state.completed;
      root.querySelector('[data-block-complete-title]')?.replaceChildren(document.createTextNode(state.completed ? '本 Block 第一轮已在本机记录完成' : canComplete() ? '本机 First-Pass 检查点已满足' : '还没有满足本机 First-Pass 检查点'));
      root.querySelector('[data-block-complete-detail]')?.replaceChildren(document.createTextNode(`KP 精学 ${learnedCount()}/${totalKp} · KP Recall ${recallCount()}/${totalKp} · Block Recall ${state.blockRecallDone ? '完成' : '未完成'}`));
      syncGroupStage();
    };

    const setKpIndex = (index) => {
      state.kpIndex = Math.max(0, Math.min(totalKp - 1, Number(index) || 0));
      state.groupIndex = groupIndexForKp(state.kpIndex);
      kpLearnCards.forEach((card, itemIndex) => { card.hidden = itemIndex !== state.kpIndex; });
      kpRecallCards.forEach((card, itemIndex) => { card.hidden = itemIndex !== state.kpIndex; });
      const learnLabel = kpLearnCards[state.kpIndex]?.querySelector('h3')?.textContent || '';
      const recallLabel = kpRecallCards[state.kpIndex]?.querySelector('h3')?.textContent || '';
      root.querySelector('[data-kp-learn-title]')?.replaceChildren(document.createTextNode(learnLabel));
      root.querySelector('[data-kp-recall-title]')?.replaceChildren(document.createTextNode(recallLabel));
      root.querySelector('[data-kp-counter]')?.replaceChildren(document.createTextNode(`${state.kpIndex + 1} / ${totalKp}`));
      root.querySelector('[data-recall-counter]')?.replaceChildren(document.createTextNode(`${state.kpIndex + 1} / ${totalKp}`));
      save(); syncState();
    };

    const setStage = (stage) => {
      state.stage = stage || 'block_learn';
      stages.forEach((panel) => { panel.hidden = panel.getAttribute('data-study-stage') !== state.stage; });
      const kpMode = ['kp_learn', 'kp_recall'].includes(state.stage);
      if (kpRail) kpRail.hidden = !kpMode;
      if (groupRail) groupRail.hidden = kpMode;
      root.querySelectorAll('[data-chain-step]').forEach((item) => item.classList.toggle('viewing', item.getAttribute('data-chain-step') === state.stage));
      if (contextLabel) contextLabel.textContent = `西医综合 · ${blockLabel} · Learn · ${stageLabel[state.stage] || 'Learn'}`;
      save(); syncState();
    };

    const switchTab = (name) => {
      tabButtons.forEach((button) => button.classList.toggle('active', button.dataset.studyTab === name));
      tabPanels.forEach((panel) => { panel.hidden = panel.dataset.studyPanel !== name; });
      if (name === 'learn') setStage(state.stage || 'block_learn');
    };
    tabButtons.forEach((button) => button.addEventListener('click', () => switchTab(button.dataset.studyTab || 'learn')));
    root.querySelectorAll('[data-stage-target],[data-stage-next]').forEach((button) => button.addEventListener('click', () => { switchTab('learn'); setStage(button.getAttribute('data-stage-target') || button.getAttribute('data-stage-next') || 'block_learn'); }));

    root.querySelector('[data-enter-group]')?.addEventListener('click', () => {
      const group = currentGroup();
      if (group) setKpIndex(group.start - 1);
      setStage('kp_learn');
    });
    groupRailButtons.forEach((button, index) => button.addEventListener('click', () => { state.groupIndex = index; save(); switchTab('learn'); setStage('logic_group'); }));
    root.querySelectorAll('[data-outline-open]').forEach((button) => button.addEventListener('click', () => { state.groupIndex = Number(button.getAttribute('data-outline-open') || 0); save(); switchTab('learn'); setStage('logic_group'); }));

    const stepKp = (delta) => setKpIndex(state.kpIndex + delta);
    root.querySelector('[data-kp-prev]')?.addEventListener('click', () => stepKp(-1));
    root.querySelector('[data-kp-next]')?.addEventListener('click', () => stepKp(1));
    root.querySelector('[data-recall-prev]')?.addEventListener('click', () => stepKp(-1));
    root.querySelector('[data-recall-next]')?.addEventListener('click', () => stepKp(1));
    kpRailButtons.forEach((button, index) => button.addEventListener('click', () => setKpIndex(index)));

    root.querySelectorAll('[data-kp-learned]').forEach((button) => button.addEventListener('click', () => {
      const kpId = button.getAttribute('data-kp-learned') || '';
      state.learned = { ...(state.learned || {}), [kpId]: true };
      button.classList.add('completed'); button.textContent = '已精学'; save(); syncState();
      const group = currentGroup();
      if ((state.kpIndex + 1) >= Number(group?.end || totalKp)) {
        root.querySelector('[data-group-close-title]')?.replaceChildren(document.createTextNode(`${group?.label || 'Logic Group'} 已闭合`));
        window.setTimeout(() => setStage('group_close'), 120);
      } else {
        window.setTimeout(() => setKpIndex(state.kpIndex + 1), 120);
      }
    }));

    root.querySelector('[data-group-close-next]')?.addEventListener('click', () => {
      if (state.groupIndex < groups.length - 1) {
        state.groupIndex += 1;
        const group = currentGroup();
        if (group) state.kpIndex = group.start - 1;
        save(); setStage('logic_group');
      } else {
        state.kpIndex = 0; save(); setStage('kp_recall');
      }
    });

    kpRecallCards.forEach((card) => {
      const reveal = card.querySelector('[data-kp-reveal]');
      const answer = card.querySelector('[data-kp-answer]');
      const rating = card.querySelector('[data-kp-rating]');
      reveal?.addEventListener('click', () => { if (answer) answer.hidden = false; if (rating) rating.hidden = false; reveal.hidden = true; });
      card.querySelectorAll('[data-rating]').forEach((button) => button.addEventListener('click', () => {
        const kpId = card.getAttribute('data-kp-id') || '';
        const value = button.getAttribute('data-rating') || '';
        state.ratings = { ...(state.ratings || {}), [kpId]: value };
        card.querySelectorAll('[data-rating]').forEach((candidate) => candidate.classList.toggle('selected', candidate === button));
        save(); syncState();
        if (state.kpIndex < totalKp - 1) window.setTimeout(() => setKpIndex(state.kpIndex + 1), 120);
        else window.setTimeout(() => setStage('block_recall'), 120);
      }));
    });

    root.querySelector('[data-block-recall-complete]')?.addEventListener('click', (event) => { state.blockRecallDone = true; event.currentTarget.textContent = 'Block Recall 已完成'; event.currentTarget.classList.add('completed'); save(); syncState(); setStage('block_complete'); });
    root.querySelector('[data-block-complete]')?.addEventListener('click', (event) => { if (!canComplete()) return; state.completed = true; event.currentTarget.textContent = 'Block 第一轮已完成'; save(); syncState(); });

    const setCollapsed = (kind, collapsed) => {
      layout?.classList.toggle(`${kind}-collapsed`, collapsed);
      root.querySelector(kind === 'outline' ? '[data-toggle-outline]' : '[data-toggle-chain]')?.setAttribute('aria-pressed', String(collapsed));
      try { sessionStorage.setItem(`kianos-xizong-layout:${objectId}:${kind}`, String(collapsed)); } catch {}
    };
    ['outline', 'chain'].forEach((kind) => {
      let collapsed = false; try { collapsed = sessionStorage.getItem(`kianos-xizong-layout:${objectId}:${kind}`) === 'true'; } catch {}
      setCollapsed(kind, collapsed);
      root.querySelector(kind === 'outline' ? '[data-toggle-outline]' : '[data-toggle-chain]')?.addEventListener('click', () => setCollapsed(kind, !layout?.classList.contains(`${kind}-collapsed`)));
    });

    document.addEventListener('keydown', (event) => {
      const target = event.target;
      if (target instanceof HTMLElement && target.closest('input,textarea,select,button,a,[contenteditable="true"]')) return;
      if (!['kp_learn', 'kp_recall'].includes(state.stage)) return;
      if (event.key === 'ArrowLeft') { event.preventDefault(); stepKp(-1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); stepKp(1); }
      if (state.stage === 'kp_recall' && event.code === 'Space') { event.preventDefault(); kpRecallCards[state.kpIndex]?.querySelector('[data-kp-reveal]')?.click(); }
      if (state.stage === 'kp_recall' && /^[1-4]$/.test(event.key)) {
        const values = ['unknown', 'fuzzy', 'known', 'mastered'];
        kpRecallCards[state.kpIndex]?.querySelector(`[data-rating="${values[Number(event.key) - 1]}"]`)?.click();
      }
    });

    Object.entries(state.learned || {}).forEach(([kpId, done]) => { if (done) { const button = root.querySelector(`[data-kp-learned="${kpId}"]`); if (button) { button.classList.add('completed'); button.textContent = '已精学'; } } });
    kpRecallCards.forEach((card) => { const value = state.ratings?.[card.getAttribute('data-kp-id') || '']; if (value) card.querySelector(`[data-rating="${value}"]`)?.classList.add('selected'); });
    if (state.blockRecallDone) { const button = root.querySelector('[data-block-recall-complete]'); if (button) { button.textContent = 'Block Recall 已完成'; button.classList.add('completed'); } }
    setKpIndex(state.kpIndex || 0); setStage(state.stage || 'block_learn'); syncState();
  }
</script>

