<script>
  import {
    XIZONG_SESSION_KEY,
    acknowledgeXizongBlockReturn,
    validateXizongSessionInstruction
  } from '../lib/xizongSessionInstruction.mjs';
  import { studyDayAt } from '../lib/studyTimer.mjs';

  (() => {
    const root = document.querySelector('[data-xizong-v6-block]');
    if (!(root instanceof HTMLElement)) return;
    const params = new URLSearchParams(window.location.search);
    const sessionId = params.get('session') || '';
    const stepId = params.get('step') || '';
    if (!sessionId || !stepId) return;

    try {
      const instruction = validateXizongSessionInstruction(
        JSON.parse(localStorage.getItem(XIZONG_SESSION_KEY) || 'null'),
        studyDayAt(Date.now())
      );
      const step = instruction.session_id === sessionId
        ? instruction.steps.find((row) => row?.step_id === stepId && row?.kind === 'BLOCK_RETURN')
        : null;
      if (!step) return;

      const systemId = root.dataset.studySystemId || '';
      const blockId = root.dataset.studyBlockId || '';
      const blockSlug = root.dataset.studyBlockSlug || '';
      const sourceHash = root.dataset.studySourceHash || '';
      acknowledgeXizongBlockReturn(localStorage, {
        sessionId,
        stepId,
        systemId,
        blockId,
        blockSlug,
        sourceHash,
        now: Date.now()
      });
      window.dispatchEvent(new CustomEvent('kianos:xizong-session-step-progress', {
        detail: {
          session_id: sessionId,
          step_id: stepId,
          kind: 'BLOCK_RETURN',
          transport_only: true
        }
      }));
    } catch {}
  })();
</script>
