gap:.25rem}.xv6LectureHandoff p{margin:0;max-width:48rem;font-size:.9rem;line-height:1.65;opacity:.76}.xv6SourceRules{display:grid;gap:.45rem;margin:.75rem 0 1rem}.xv6SourceRules p{margin:0;font-size:.9rem;line-height:1.65;opacity:.76}.xv6GroupKpMap{margin:.7rem 0 1rem;padding:.65rem .8rem;border:1px solid var(--line,#d9dde5);border-radius:10px}.xv6GroupKpMap p{margin:.6rem 0 .1rem;line-height:1.6;opacity:.72}.portedRecallAnswer>h4{font-size:1.15rem;margin:.25rem 0 1rem}.xv6BlockRecallCore{display:grid;gap:.8rem;margin:1rem 0}.xv6RecallPromptBox{padding:.8rem 0;border-bottom:1px solid var(--line,#d9dde5)}.xv6RecallPromptBox p{margin:.3rem 0 0;line-height:1.65;opacity:.75}.xv6RecallSpine,.xv6GroupReview{padding:.7rem .8rem;border:1px solid var(--line,#d9dde5);border-radius:12px}.xv6RecallSpine p{font-size:1.02rem;line-height:1.75;margin:.8rem 0 .15rem;font-weight:650}.xv6GroupReview>div{display:grid;gap:.65rem;margin-top:.75rem}.xv6GroupReview section{padding:.55rem 0;border-top:1px solid var(--line,#d9dde5)}.xv6GroupReview section:first-child{border-top:0}.xv6GroupReview p{margin:.2rem 0 0;line-height:1.6;opacity:.78}.xv6AttentionRail{gap:0!important}.xv6AttentionGroup{padding:10px 11px;border-bottom:1px solid var(--study-line,var(--line,#d9dde5))}.xv6AttentionGroup>span{display:block;margin-bottom:4px;font-size:9px;font-weight:850;letter-spacing:.06em;opacity:.62}.xv6AttentionGroup p{margin:0;font-size:10px;line-height:1.55}.xv6AttentionGroup.primary p{font-weight:650}.xv6AttentionGroup.support p,.xv6AttentionGroup.later p{opacity:.72}.xv6ProgressMini{opacity:.78}.xv6ProgressMini b{font-size:9px!important}.xv6ProgressMini small{font-size:8px!important}@media(max-width:720px){.xv6LectureFirst{align-items:flex-start;flex-direction:column}.xv6LectureFirst span{text-align:left}}
</style>

<script>
  import {
    XIZONG_SESSION_KEY,
    acknowledgeXizongBlockReturn,
    validateXizongSessionInstruction
  } from '../lib/xizongSessionInstruction.mjs';
  import { studyDayAt } from '../lib/studyTimer.mjs';
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(() => {


  (() => {
    const root = document.querySelector('[data-xizong-v6-block]');
    if (!(root instanceof HTMLElement)) return;
    const params = new URLSearchParams(window.location.search);
    const sessionId = params.get('session') || '';
    const stepId = params.get('step') || '';
    if (!sessionId || !stepId) return;

    try {
      const instruction = validateXizongSessionInstruction(
        JSON.parse(localStorage.getItem(XIZONG_SESSION_KEY) || 'null'),
        studyDayAt(Date.now())
      );
      const step = instruction.session_id === sessionId
        ? instruction.steps.find((row) => row?.step_id === stepId && row?.kind === 'BLOCK_RETURN')
        : null;
      if (!step) return;

      const systemId = root.dataset.studySystemId || '';
      const blockId = root.dataset.studyBlockId || '';
      const blockSlug = root.dataset.studyBlockSlug || '';
      const sourceHash = root.dataset.studySourceHash || '';
      acknowledgeXizongBlockReturn(localStorage, {
        sessionId,
        stepId,
        systemId,
        blockId,
        blockSlug,
        sourceHash,
        now: Date.now()
      });
      window.dispatchEvent(new CustomEvent('kianos:xizong-session-step-progress', {
        detail: {
          session_id: sessionId,
          step_id: stepId,
          kind: 'BLOCK_RETURN',
          transport_only: true
        }
      }));
    } catch {}
  })();

  });
</script>

