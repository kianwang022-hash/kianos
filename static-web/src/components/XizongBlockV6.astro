---
import revisionRuntimeUrl from '../lib/xizongContentRevision.mjs?url';
import XizongCognitiveProjectionStage from './XizongCognitiveProjectionStage.astro';

const { block } = Astro.props;
const base = import.meta.env.BASE_URL;
const kps = block?.kpRecords || [];
const groups = block?.logicGroups || [];
const firstKp = kps[0];
const firstGroup = groups[0];
const firstGroupKps = firstGroup ? kps.filter((kp) => (firstGroup.kpIds || []).includes(kp.kpId)) : [];
const firstGroupLocators = [...new Set(firstGroupKps.map((kp) => kp.sourceLocator).filter(Boolean))];
const firstGroupSource = firstGroupLocators.length === 0
  ? 'MarginNote · 原讲义对应连续小节'
  : firstGroupLocators.length === 1
    ? `MarginNote · ${firstGroupLocators[0]}`
    : `MarginNote · 相关定位：${firstGroupLocators.join('；')}`;
const allSourceLocators = [...new Set(kps.map((kp) => kp.sourceLocator).filter(Boolean))];
const continuousSource = allSourceLocators.length === 0
  ? 'MarginNote · 按原讲义自然边界连续学习'
  : allSourceLocators.length === 1
    ? `MarginNote · ${allSourceLocators[0]}`
    : `MarginNote · 相关定位：${allSourceLocators.join('；')}`;
const sourceContact = block?.sourceContact || {};
const blockSourceDebt = Array.isArray(sourceContact.blockSourceDebt) ? sourceContact.blockSourceDebt : [];
const blockSourceConflict = Array.isArray(sourceContact.blockSourceConflict) ? sourceContact.blockSourceConflict : [];
const blockVisualDebt = Array.isArray(sourceContact.blockVisualDebt) ? sourceContact.blockVisualDebt : [];
const sourceContactMode = String(sourceContact.mode || 'NATURAL_SOURCE_UNIT');
const sourcePerGroup = sourceContact.logicGroupIsAutomaticSourceChunk === true;
const postChatReferenceBlock = block?.systemId === 'circulation' && ['b01', 'b02'].includes(block?.slug);
const titleOnlyKps = postChatReferenceBlock;
// B1/B2 reference slices only. This opens retrieval; it never certifies Chat or Source study.
const postChatRecallAvailable = postChatReferenceBlock
  && sourceContactMode === 'NATURAL_SOURCE_UNIT' && !sourcePerGroup;
const globalBiochemistrySource = sourceContactMode === 'CONSUME_GLOBAL_BIOCHEMISTRY_SOURCE_MAP_CURRENT';
const naturalSourceUnits = sourceContactMode === 'NATURAL_SOURCE_UNITS';
const integrationPrimary = sourceContactMode === 'INTEGRATION_PRIMARY';
const integrationTargetedSourceReturns = integrationPrimary && sourceContact.integrationTargetedSourceReturns === true;
const integrationReleaseLogicGroupIds = Array.isArray(sourceContact.integrationReleaseLogicGroupIds)
  ? sourceContact.integrationReleaseLogicGroupIds.map(String)
  : [];
const segmentedSourceUnits = naturalSourceUnits || integrationTargetedSourceReturns;
const kpIdByOrdinal = new Map(kps.map((kp) => [Number(kp.ordinal), kp.kpId]));
const sourceSegmentsForRuntime = segmentedSourceUnits
  ? (sourceContact.segments || []).map((segment) => ({
      ...segment,
      kpIds: (segment.kpOrdinals || []).map((ordinal) => kpIdByOrdinal.get(Number(ordinal))).filter(Boolean)
    }))
  : [];
const firstSourceSegment = sourceSegmentsForRuntime[0] || null;
const biochemistrySegments = globalBiochemistrySource
  ? (sourceContact.segments || []).map((segment) => ({
      ...segment,
      kpIds: (segment.kpOrdinals || []).map((ordinal) => kpIdByOrdinal.get(Number(ordinal))).filter(Boolean)
    }))
  : [];
const biochemistryBlockSource = globalBiochemistrySource ? {
  schema: 'kianos.xizong.biochemistry_block_source_binding.v1',
  sourceMapOwner: sourceContact.sourceMapOwner || '',
  laneSourceHash: sourceContact.sourceLaneHash || '',
  sourceName: sourceContact.sourceName || '',
  closureUnit: sourceContact.closureUnit || '',
  segments: biochemistrySegments
} : null;
const attention = block?.attention || {};
const carryNow = attention.carryNow || [];
const supportOnDemand = attention.supportOnDemand || [];
const supportCount = {
  visual: supportOnDemand.filter((row) => row.kind === 'VISUAL_GATE').length,
  precision: supportOnDemand.filter((row) => row.kind === 'PRECISION').length,
  extension: supportOnDemand.filter((row) => row.kind === 'EXTENSION').length
};
const hasTimedVisuals = (block?.learningCues?.visuals || []).length > 0;
const ttsx = block?.ttsx || { checkpoints: [] };
const normalizeTtsxQuestionRow = (item, index) => ({
  questionId: String(item?.questionId || item?.question_id || item?.id || `question-${index + 1}`),
  displayLabel: String(item?.displayLabel || item?.question_display_label || item?.label || item?.questionId || item?.question_id || `题 ${index + 1}`),
  title: String(item?.title || item?.question_display_title || item?.stem || '题干请回 MarginNote 查看'),
  sourcePageLabel: String(item?.sourcePageLabel || item?.source_page_label || item?.pageLabel || item?.page_label || '')
});
const ttsxCheckpoints = (Array.isArray(ttsx.checkpoints) ? ttsx.checkpoints : []).map((row, index) => {
  const rawRows = Array.isArray(row?.questionRows)
    ? row.questionRows
    : Array.isArray(row?.question_rows)
      ? row.question_rows
      : Array.isArray(row?.questions) ? row.questions : [];
  const rawIds = Array.isArray(row?.questionIds)
    ? row.questionIds
    : Array.isArray(row?.question_ids) ? row.question_ids : [];
  const questionRows = rawRows.length
    ? rawRows.map(normalizeTtsxQuestionRow)
    : rawIds.map((questionId, questionIndex) => normalizeTtsxQuestionRow({ questionId }, questionIndex));
  return {
    checkpointId: String(row?.checkpointId || row?.checkpoint_id || `ttsx-${index + 1}`),
    logicGroupId: String(row?.logicGroupId || row?.logic_group_id || ''),
    sourceSegmentId: String(row?.sourceSegmentId || row?.source_segment_id || ''),
    label: String(row?.label || row?.group_title || '当前原讲义边界'),
    lecturePageLabel: String(row?.lecturePageLabel || row?.lecture_page_label || ''),
    questionPageLabel: String(row?.questionPageLabel || row?.question_page_label || ''),
    questionRows
  };
});
---
<section
  class="portedStudyRuntime portedStudyRuntimeV2 xv6Block"
  data-xizong-v6-block
  data-study-object={block.objectId}
  data-study-system-id={block.systemId || ''}
  data-study-block-id={block.blockId || ''}
  data-study-block-slug={block.slug || ''}
  data-study-source-hash={block.sourceHash || ''}
  data-block-label={block.label}
  data-source-contact-mode={sourceContactMode}
  data-post-chat-recall-available={postChatRecallAvailable ? 'true' : 'false'}
  data-kp-title-only={titleOnlyKps ? 'true' : 'false'}
  data-semantic-adapter={block.semanticAdapterSchema || ''}
>
  <header class="portedStudyHeader">
    <div class="portedStudyContextRow">
      <a href={`${base}xizong/${block.systemId}/`}>‹ {block.systemTitle}</a>
      <span>{block.label}</span>
      <div class="portedStudyShellActions" aria-label="Block controls">
        <button type="button" class="xzBlockFrameworkPreviewButton" data-block-framework-preview-open>回看本块框架</button>
        <span data-block-keyboard-hint>← → 切换 · Space 显示 / 隐藏内容</span>
      </div>
    </div>
    <div class="portedStudyIdentity">
      <div class="portedStudyBlockIdentity">
        <span data-study-context-label>西医综合 · {block.label} · 建立框架</span>
        <h2>{block.title}</h2>
      </div>
      <div class="portedStudyActiveKp" data-study-active-kp aria-live="polite"></div>
      <div class="portedStudyIdentityMeta">
        <strong data-study-local-status>{sourcePerGroup ? `学习节 1/${groups.length}` : '准备进入原讲义'}</strong>
        <small>← / → 推进 · 状态只留在本机</small>
      </div>
    </div>
    <nav class="portedStudyTabs" aria-label="Block workspace" hidden>
      <button type="button" class="active" data-study-tab="learn">Learn</button>
    </nav>
  </header>

  <dialog class="xzBlockFrameworkDialog" data-block-framework-dialog>
    <header>
      <div>
        <span>只读回看</span>
        <strong>{block.label} · {block.title}</strong>
      </div>
      <button type="button" data-block-framework-preview-close>返回当前学习</button>
    </header>
    <div class="xzBlockFrameworkDialogBody" data-block-framework-dialog-body></div>
    <footer>只读回看 · 不改变当前 stage、Resume 或学习证据。</footer>
  </dialog>

  <div class="portedStudyLayout" data-study-layout>
    <aside class="portedStudyOutline" id="content-map">
      <header><span data-study-rail-kicker>学习地图</span><strong data-study-rail-title>学习节</strong></header>
      <nav data-study-group-rail aria-label="Logic Group navigation">
        {groups.map((group, index) => <button type="button" data-group-target={index}>
          <b>{String(index + 1).padStart(2, '0')}</b>
          <span>{group.label}</span>
        </button>)}
      </nav>
      <nav class="portedStudyKpRail" data-study-kp-rail aria-label="KP navigation" hidden>
        {kps.map((kp, index) => <button type="button" data-kp-target={index}>
          <b aria-hidden={titleOnlyKps ? 'true' : undefined}>{titleOnlyKps ? '' : kp.displayId}</b><span>{kp.title}</span><small data-kp-state={kp.kpId}>—</small>
        </button>)}
      </nav>
      <footer>位置图只负责导航；学习顺序由当前学习路径决定。</footer>
    </aside>

    <main class="portedStudyMain" id="canonical-content">
      <section data-study-panel="learn">
        <section data-study-stage="block_learn">
          <div class="portedStudyLead xv6BlockFocus">
            <span>这块现在抓什么</span>
            <strong>{attention.currentProblem || block.firstPassFocus || '先建立这一块的局部模型，再进入正式学习。'}</strong>
          </div>
          {attention.minimalModel && <div class="xv6MinimalModel"><span>先带着这个最小模型</span><p>{attention.minimalModel}</p></div>}
          <XizongCognitiveProjectionStage projection={block.cognitiveProjection} />
          {!block?.cognitiveProjection?.compiled && block.blockLearnHtml && (
            <article class="portedStudyArticle markdown xv6BlockOrientation" set:html={block.blockLearnHtml}></article>
          )}
          {!hasTimedVisuals && block.visualGateHtml && <details class="xv6VisualGate"><summary>需要时看原图</summary><div class="markdown" set:html={block.visualGateHtml}></div></details>}
          <footer class="portedStudyStageAction">
            <span>{globalBiochemistrySource
              ? '这个 Block 不单独重读讲义；正式 Source 接触来自 B 系统里的 27 生化连续跟课主线。'
              : sourcePerGroup
                ? '先知道这块为什么存在，再按学习节进入原讲义。'
                : naturalSourceUnits
                  ? '按真实 Source unit 学习；一个 Source unit 可以连续覆盖多个学习节。'
                  : integrationPrimary
                    ? '这块以 KianOS 整合回忆为主；不制造一轮新的连续 Lecture。'
                    : '先定位这块，再去原讲义保持连续学习；不要按学习节反复切 App。'}</span>
            <button type="button" class="portedPrimaryAction" data-stage-next="logic_group">{globalBiochemistrySource
              ? '检查当前 Source 形成状态'
              : sourcePerGroup
                ? '进入第一个学习节'
                : naturalSourceUnits
                  ? '进入第一个 Source unit'
                  : integrationPrimary
                    ? '开始整合回忆'
                    : '去原讲义连续学习'}</button>
            {postChatRecallAvailable && <button type="button" data-post-chat-recall>Chat 后开始 KP 回忆</button>}
          </footer>
        </section>

        {!sourcePerGroup && (!integrationPrimary || integrationTargetedSourceReturns) && (
          <section class="portedKpWorkspace xv6BlockSourceContact" data-study-stage="source_contact" hidden>
            <header class="portedKpWorkspaceHeader">
              <div>
                <span>Lecture · MarginNote</span>
                <strong data-source-unit-title>{globalBiochemistrySource
                  ? '27 生化连续跟课主线'
                  : naturalSourceUnits
                    ? '按自然 Source unit 连续学习'
                    : integrationTargetedSourceReturns
                      ? '按需要定点回原讲义'
                      : '保持原讲义连续学习'}</strong>
              </div>
              <em data-source-unit-counter>{segmentedSourceUnits
                ? `${integrationTargetedSourceReturns ? '回原讲义' : 'Source Unit'} 1/${sourceSegmentsForRuntime.length}`
                : 'Source Contact'}</em>
            </header>
            <div class="xv6LectureFirst xv6LectureHandoff">
              <div>
                <strong data-source-unit-label>{globalBiochemistrySource
                  ? 'Source 只学一次；这个 Block 只消费已经形成的内容'
                  : naturalSourceUnits
                    ? (firstSourceSegment?.label || '当前自然 Source unit')
                    : integrationTargetedSourceReturns
                      ? (firstSourceSegment?.label || '当前需回看的原讲义')
                      : 'MarginNote 连续学习 + Mac KP Learn 同时进行'}</strong>
                <p>{globalBiochemistrySource
                  ? '老师顺序可能同时形成多个 M/G Block。这里不会要求你为了当前 Block 重读讲义；完成到对应 27 Source unit 后，正式接触证据会自动同步回来。'
                  : naturalSourceUnits
                    ? '保持这个 Source unit 连续完成；回来后只释放它真实支持的 Logic Group Recall，不按 LG 反复切 App。'
                    : integrationTargetedSourceReturns
                      ? '只在当前明确需要核对的位置回原讲义；完成后只释放对应学习节，不额外制造整块重学。'
                      : '原讲义保持连续推进；Mac 只切换当前 KP 的 Prompt / Core / 支持，不把 KP 变成新的 Source 边界。'}</p>
              </div>
              <span data-block-source-contact>{globalBiochemistrySource
                ? sourceContact.sourceName
                : segmentedSourceUnits
                  ? `MarginNote · ${firstSourceSegment?.label || (integrationTargetedSourceReturns ? '当前需回看的原讲义' : '当前 Source unit')}`
                  : continuousSource}</span>
            </div>
            <div class="xv6SourceRules">
              <p>{globalBiochemistrySource
                ? '先回 B 系统的「27 生化」按老师顺序推进；只有真实完成的 Source unit 才会释放这里对应的 KP / Logic Group Recall。'
                : naturalSourceUnits
                  ? 'Source unit 按本块真实讲义边界划分；原图、表格、例子与讲义配套题继续留在 MarginNote 原位置。'
                  : integrationTargetedSourceReturns
                    ? '只回到当前明确需要核对的原讲义位置；完整清单、原图和其他章节内容没有依据时不在当前页面补齐。'
                    : '原图、表格、例子与讲义配套题都留在 MarginNote 原位置；题目在讲义里完成并看全部选项 / 题旁拓展。'}</p>
              {globalBiochemistrySource && (
                <p data-biochemistry-block-source-status>
                  当前 Block 所需 Source：{biochemistrySegments.map((segment) => segment.sourceUnitId).join(' → ')}
                </p>
              )}
              {segmentedSourceUnits && <p data-natural-source-status>{integrationTargetedSourceReturns ? '当前需回看的原讲义' : '当前 Source unit'}：{firstSourceSegment?.sourceUnitId || '—'}</p>}
              {blockSourceConflict.length > 0 && <p data-block-source-conflict>Source 口径仍有冲突，先不强行定论：{blockSourceConflict.join('；')}</p>}
              {blockSourceDebt.length > 0 && <p data-block-source-debt>精确细节仍需回原 Source：{blockSourceDebt.join('；')}</p>}
              {blockVisualDebt.length > 0 && <p data-block-visual-debt>原图关系仍需回原 Source：{blockVisualDebt.join('；')}</p>}
            </div>
            <footer>
              <span>{globalBiochemistrySource
                ? 'Source contact 由共享 27 生化主线记录；本页只负责 Recall / Reconstruction。'
                : naturalSourceUnits
                  ? '到这个真实 Source-unit 边界再确认；相关学习节会在同一个学习界面里释放。'
                  : integrationTargetedSourceReturns
                    ? '只确认这次定点回原讲义；完成后仅释放它真实支持的学习节。'
                    : '到真实 Source boundary 再确认本段接触完成；KP Learn 本身持续伴读。'}</span>
              {globalBiochemistrySource
                ? <a class="portedPrimaryAction" href={`${base}xizong/${block.systemId}/?view=biochemistry`}>回到 27 生化跟课</a>
                : <button type="button" class="portedPrimaryAction" data-source-contact-done>{naturalSourceUnits ? '这个 Source unit 已完成' : integrationTargetedSourceReturns ? '这次定点回原讲义已完成' : '本段原讲义已完成'}</button>}
              {postChatRecallAvailable && <button type="button" data-post-chat-recall>Chat 后开始 KP 回忆</button>}
            </footer>
          </section>
        )}

        <section class="xv6LogicStage" data-study-stage="logic_group" hidden>
          <span>当前学习节</span>
          <b data-logic-counter>01 / {groups.length}</b>
          <h3 data-logic-title>{firstGroup?.label}</h3>
          <p class="xv6LogicGoal" data-logic-goal>{firstGroup?.goal || '先回答这一节共同在解决什么问题。'}</p>
          {firstGroup?.closure && <div class="xv6LogicTarget"><span>这一节闭合时，你应该能</span><p data-logic-closure>{firstGroup.closure}</p></div>}
          <button type="button" class="portedPrimaryAction" data-enter-group>{sourcePerGroup ? '去讲义连续学习这一节' : '开始这一节回忆'}</button>
        </section>

        {sourcePerGroup && (
          <section class="portedKpWorkspace xv6GroupLecture" data-study-stage="kp_learn" hidden>
            <header class="portedKpWorkspaceHeader">
              <div><span>Lecture · MarginNote</span><strong data-group-lecture-title>{firstGroup?.label}</strong></div>
              <em data-group-lecture-counter>学习节 1/{groups.length}</em>
            </header>
            <div class="xv6LectureFirst xv6LectureHandoff">
              <div><strong>MarginNote 连续学习 + Mac KP Learn 同时进行</strong><p>原讲义不停；左右键只切 Mac 当前 KP 伴读对象，Enter 记录这个 KP 已学好。</p></div>
              <span data-group-lecture-source>{firstGroupSource}</span>
            </div>
            <details class="xv6GroupKpMap">
              <summary>回来后要回忆的 KP 路标</summary>
              <p data-group-lecture-kps>{firstGroupKps.map((kp) => kp.displayId).join(' · ') || '本学习节对应 KP'}</p>
            </details>
            <footer><span>原图、表格、例子和讲义配套题仍留在 MarginNote；KP Learn 同步提供 Prompt、Core 和当前支持。</span><button type="button" class="portedPrimaryAction" data-group-lecture-done>这一节已完成</button></footer>
          </section>
        )}

        <section class="xv6TtsxCheckpoint" data-study-stage="ttsx_checkpoint" hidden>
          <header class="xv6TtsxHeader">
            <div>
              <span>MarginNote-first</span>
              <strong>配套题 <b data-ttsx-progress>0 道</b></strong>
              <small data-ttsx-meta>按原讲义页码逐组核对；这里不判分、不分类、不生成 Question Attempt。</small>
            </div>
            <em>Checkpoint</em>
          </header>
          <div class="xv6TtsxBody">
            <div class="xv6TtsxBoundary">
              <strong data-ttsx-boundary-label>当前原讲义边界</strong>
              <span data-ttsx-page-label>回 MarginNote 原位置完成题目、答案、全部选项和题旁拓展。</span>
            </div>
            <div class="xv6TtsxQuestionList" data-ttsx-question-list></div>
            <p class="xv6TtsxEmpty" data-ttsx-empty hidden>当前 reviewed Binding 没有可展示的题目明细；不会从系统真题库猜题。</p>
          </div>
          <footer class="portedStudyStageAction">
            <span>完成后直接进入当前学习节的 KP 回忆。</span>
            <button type="button" class="portedPrimaryAction" data-ttsx-done>已完成 → 进入 KP 回忆</button>
          </footer>
        </section>

        <section class="portedKpWorkspace recall" data-study-stage="kp_recall" hidden>
          <header class="portedKpWorkspaceHeader">
            <div><span>主动回忆 · 当前学习节</span><strong data-kp-recall-title>{titleOnlyKps ? firstKp?.title : firstKp?.displayId}</strong></div>
            {postChatRecallAvailable && <button type="button" data-stage-target="source_contact">回原讲义</button>}
            <div><button type="button" data-recall-prev>‹</button><em data-recall-counter>本节 1/{firstGroup?.kpCount || 1}</em><button type="button" data-recall-next>›</button></div>
          </header>
          <div class="portedKpCards">
            {kps.map((kp, index) => <article class="portedKpRecallCard" data-kp-recall-card={index} data-kp-id={kp.kpId} hidden={index !== 0}>
              <header><span>{kp.groupLabel}</span><h3>{titleOnlyKps ? kp.title : kp.displayId}</h3>{kp.prompt && <p>{kp.prompt}</p>}</header>
              <div class="portedRecallPrompt"><strong>先自己回忆；答案暂时隐藏。</strong><button type="button" data-kp-reveal>核对答案</button></div>
              <div class="portedRecallAnswer" data-kp-answer hidden>
                <h4>{kp.title}</h4>
                <div class="markdown" set:html={kp.detailHtml}></div>
              </div>
              <footer class="portedRecallRating" data-kp-rating hidden>
                <span>这次回忆质量</span>
                <div><button type="button" data-rating="unknown">1 · 没记住</button><button type="button" data-rating="fuzzy">2 · 模糊</button><button type="button" data-rating="known">3 · 会了</button><button type="button" data-rating="mastered">4 · 稳定</button></div>
              </footer>
            </article>)}
          </div>
        </section>

        <section class="portedBlockRecall" data-study-stage="block_recall" hidden>
          <header><span>整块回忆</span><h3>把这一块重新压回一条主链</h3><p>{block.centerQuestion}</p></header>
          <div class="xv6BlockRecallCore">
            <div class="xv6RecallPromptBox">
              <strong>先从中心问题把整个 Block 自己跑一遍。</strong>
              <p>左侧学习节名称可以作为骨架，但整块主链和闭合答案在核对前保持隐藏。</p>
              <button type="button" class="portedPrimaryAction" data-block-recall-reveal>核对整块模型</button>
            </div>
            <div data-block-recall-answer hidden>
              {block.recallSpine && <section class="xv6RecallSpine"><strong>整块主链</strong><p>{block.recallSpine}</p></section>}
              <section class="xv6GroupReview">
                <strong>学习节闭合目标</strong>
                <div>{groups.map((group) => <section data-revision-group={group.groupId}><strong>{group.label}</strong><p>{group.closure || group.goal || ''}</p></section>)}</div>
              </section>
            </div>
          </div>
          <footer class="xzBlockRecallActions">
            <div>
              <span>整块回忆测的是能不能重新运行模型，不是再读一遍全部 KP。</span>
              <strong data-block-complete-title>完成整块回忆后即可确认本 Block 第一轮完成。</strong>
              <small data-block-complete-detail>状态只记录真实学习证据，不会把模糊项自动升级成掌握。</small>
            </div>
            <div>
              <button type="button" data-block-recall-complete disabled>完成整块回忆</button>
              <button type="button" class="portedPrimaryAction" data-block-complete disabled>确认 Block 第一轮完成</button>
              <a href={`${base}xizong/${block.systemId}/`} data-block-return-system hidden>返回系统</a>
            </div>
          </footer>
        </section>
      </section>

      <section class="portedStudyOutlinePanel" data-study-panel="outline" hidden>
        <header><span>学习地图</span><h3>Block 学习地图</h3><p>需要跳转或检查覆盖时再看；正常学习不靠这里推进。</p></header>
        <div class="portedOutlineSectionList">
          {groups.map((group, index) => <section><b>{String(index + 1).padStart(2, '0')}</b><div><strong>{group.label}</strong><p>{group.goal || ''}</p></div><button type="button" data-outline-open={index}>进入</button></section>)}
        </div>
      </section>
    </main>

    <aside class="portedStudyChain xv6AttentionRail" aria-label="当前学习辅助" data-xizong-attention></aside>
  </div>

</section>

<script define:vars={{
  revisionRuntimeUrl,
  revisionWitness: block.learnerObject?.revisionWitness,
  sourcePerGroup,
  postChatRecallAvailable,
  sourceContactPayload: sourceContact,
  sourceContactMode,
  naturalSourceUnits,
  integrationPrimary,
  integrationTargetedSourceReturns,
  integrationReleaseLogicGroupIds,
  segmentedSourceUnits,
  blockSourceDebtPayload: blockSourceDebt,
  blockSourceConflictPayload: blockSourceConflict,
  blockVisualDebtPayload: blockVisualDebt,
  sourceSegmentPayload: sourceSegmentsForRuntime,
  biochemistrySourcePayload: biochemistryBlockSource,
  ttsxPayload: ttsxCheckpoints,
  groupPayload: groups.map((group) => ({ groupId: group.groupId, label: group.label, start: group.start, end: group.end, kpIds: group.kpIds, goal: group.goal || '', closure: group.closure || '', membershipMode: group.membershipMode || '', visualRequired: group.visualRequired === true, visualSourceState: group.visualSourceState || '' })),
  kpPayload: kps.map((kp) => ({ kpId: kp.kpId, ordinal: kp.ordinal, displayId: kp.displayId, title: kp.title, groupId: kp.groupId, sourceLocator: kp.sourceLocator || '' }))
}}>
window.__kianosLearnerWriterReady.then(async () => {
  const { reconcileXizongRevision, revisionRequiresAction, revisionStatus, needsFreshKpRecall, currentGroupClaim, sourceContactCompatible, revalidateXizongUnit, xizongSourceContactCovered, historicalXizongSourceContinuation } = await import(revisionRuntimeUrl);

  const root = document.querySelector('[data-xizong-v6-block]');
  if (root) {
   (() => {
    const objectId = root.getAttribute('data-study-object') || 'xizong:unknown';
    const blockLabel = root.getAttribute('data-block-label') || 'Block';
    const storageKey = `kianos-xizong-astro-v2:${objectId}`;
    const groups = groupPayload || [];
    const kpData = kpPayload || [];
    const ttsxData = Array.isArray(ttsxPayload) ? ttsxPayload : [];
    const kpRecallCards = [...root.querySelectorAll('[data-kp-recall-card]')];
    const kpRailButtons = [...root.querySelectorAll('[data-kp-target]')];
    const groupRailButtons = [...root.querySelectorAll('[data-group-target]')];
    const stages = [...root.querySelectorAll('[data-study-stage]')];
    const tabButtons = [...root.querySelectorAll('[data-study-tab]')];
    const tabPanels = [...root.querySelectorAll('[data-study-panel]')];
    const layout = root.querySelector('[data-study-layout]');
    const kpRail = root.querySelector('[data-study-kp-rail]');
    const groupRail = root.querySelector('[data-study-group-rail]');
    const contextLabel = root.querySelector('[data-study-context-label]');
    const statusLabel = root.querySelector('[data-study-local-status]');
    const totalKp = kpData.length;
    const currentSourceHash = root.getAttribute('data-study-source-hash') || '';
    const sourceSegments = Array.isArray(sourceSegmentPayload) ? sourceSegmentPayload : [];
    const biochemistrySource = biochemistrySourcePayload || null;
    const biochemistryLedgerKey = biochemistrySource?.laneSourceHash
      ? `kianos:xizong:biochemistry-source-lane:${root.dataset.studySystemId || ''}:v1`
      : '';
    let sourceRevisionMigrated = false;
    let state = { stage: 'block_learn', groupIndex: 0, kpIndex: 0, sourceSegmentIndex: 0, learned: {}, ratings: {}, ttsxEvidence: {}, ttsxAnnotations: {}, pendingTtsx: null, blockRecallDone: false, blockRecallCompletedAt: null, completed: false, completedAt: null, sourceHash: currentSourceHash, sourceRevisionPending: false, sourceRevisionFromHash: null };
    const suspend = (message) => {
      root.dataset.xizongStateBlocked = 'true';
      root.inert = true;
      if (!document.querySelector('[data-xizong-state-recovery]')) {
        const notice = document.createElement('p');
        notice.dataset.xizongStateRecovery = '';
        notice.setAttribute('role', 'alert');
        notice.textContent = message;
        root.before(notice);
      }
    };
    try {
      const raw = localStorage.getItem(storageKey);
      if (raw !== null) {
        const saved = JSON.parse(raw);
        const object = (v) => v && typeof v === 'object' && !Array.isArray(v);
        if (!object(saved) || (saved.schema && saved.schema !== 'kianos.xizong.block-state.v2')) throw new Error('Unsupported state');
        if (saved.learned != null && (!object(saved.learned) || Object.values(saved.learned).some((v) => typeof v !== 'boolean'))) throw new Error('Invalid contact evidence');
        if (saved.ratings != null && (!object(saved.ratings) || Object.values(saved.ratings).some((v) => !['unknown','fuzzy','known','mastered'].includes(v)))) throw new Error('Invalid Recall evidence');
        if (['completed', 'blockRecallDone', 'sourceContactDone'].some((key) => saved[key] != null && typeof saved[key] !== 'boolean')) throw new Error('Invalid completion evidence');
        if (saved.sourceSegmentIndex != null && (!Number.isInteger(saved.sourceSegmentIndex) || saved.sourceSegmentIndex < 0)) throw new Error('Invalid Source segment index');
        state = { ...state, ...reconcileXizongRevision(saved, revisionWitness) };
        sourceRevisionMigrated = true;
      }
    } catch {
      suspend('本机学习记录无法安全读取，原数据已保留，本页暂停写入。请先备份记录再恢复；不要直接清除浏览器数据。');
      return;
    }
    // Missing legacy Source flags remain missing: learned counts cannot invent
    // a contact confirmation or turn UNKNOWN history into a Current claim.
    // This optional field is navigation intent, scoped to the reference Block.
    // Foreign/unknown values cannot release Recall or manufacture contact.
    if (!postChatRecallAvailable || state.recallEntryMode !== 'POST_CHAT_RECALL') delete state.recallEntryMode;
    const isPostChatRecall = () => postChatRecallAvailable && state.recallEntryMode === 'POST_CHAT_RECALL';

    // Bind a fresh empty state before Source adapters form their first evidence.
    if (!state.contentRevision) state = reconcileXizongRevision(state, revisionWitness);
    let lastPersistedState = JSON.stringify(state);
    const save = () => {
      if (root.dataset.xizongStateBlocked === 'true') return false;
      try {
        if (!state.contentRevision) state = reconcileXizongRevision(state, revisionWitness);
        state.resumeKpId = kpData[state.kpIndex || 0]?.kpId || null;
        state.resumeGroupId = groups[state.groupIndex || 0]?.groupId || null;
        state.resumeSourceSegmentId = revisionWitness?.segmentOrder?.[state.sourceSegmentIndex || 0] || null;
        const serialized = JSON.stringify(state);
        localStorage.setItem(storageKey, serialized);
        lastPersistedState = serialized; return true;
      }
      catch { state = JSON.parse(lastPersistedState); suspend('本次学习状态未能保存，本页已暂停。之前记录仍保留，请先备份或释放本机空间后重新打开。'); return false; }
    };
    if (sourceRevisionMigrated && !save()) return;
    const recordSourceContact = (segmentId, ids, cumulative = false, extra = {}) => {
      const history = Array.isArray(state.sourceContactEvidence) ? state.sourceContactEvidence : [];
      const existingIndex = history.findLastIndex((entry) => entry.segment_id === segmentId && sourceContactCompatible(state, entry, currentSourceHash));
      const existing = existingIndex >= 0 ? history[existingIndex] : null;
      const visualReviewed = [...new Set([
        ...(Array.isArray(existing?.visual_reviewed_lg_ids) ? existing.visual_reviewed_lg_ids : []),
        ...(Array.isArray(extra?.visual_reviewed_lg_ids) ? extra.visual_reviewed_lg_ids : [])
      ].map(String).filter(Boolean))];
      const next = {
        ...(existing || {}),
        segment_id: segmentId,
        source_contact_mode: sourceContactMode,
        coverage_kind: extra?.coverage_kind || existing?.coverage_kind || (cumulative ? 'EXPLICIT_BLOCK_CUMULATIVE_CONFIRMATION' : 'ACCEPTED_SOURCE_SEGMENT'),
        kp_ids: [...new Set([...(Array.isArray(existing?.kp_ids) ? existing.kp_ids : []), ...ids].map(String).filter(Boolean))],
        completed_at: new Date().toISOString(),
        source_hash: currentSourceHash,
        contact_witness: revisionWitness.contact,
        ...extra,
        visual_reviewed_lg_ids: visualReviewed
      };
      state.sourceContactEvidence = [...history, next];
      if (!state.sourceHash) state.sourceHash = currentSourceHash;
    };
    const groupIndexById = (groupId) => groups.findIndex((group) => group.groupId === groupId);
    const naturalSegmentDone = (segment) => {
      if (!segment?.segmentId || !currentSourceHash) return false;
      const entry = (state.sourceContactEvidence || []).find((row) =>
        row.segment_id === segment.segmentId && sourceContactCompatible(state, row, currentSourceHash)
      );
      if (!entry) return false;
      const reviewed = new Set((Array.isArray(entry?.visual_reviewed_lg_ids) ? entry.visual_reviewed_lg_ids : []).map(String));
      const requiredVisualReviews = (Array.isArray(segment?.visualDebt) ? segment.visualDebt : [])
        .map(String)
        .filter((groupId) => {
          const index = groupIndexById(groupId);
          const group = index >= 0 ? groups[index] : null;
          return group?.visualRequired === true && /GAP.*NOT_MOUNTED/i.test(String(group?.visualSourceState || ''));
        });
      return requiredVisualReviews.every((groupId) => reviewed.has(groupId));
    };
    const naturalReleaseGroupIds = (segment) => [...new Set([
      ...(Array.isArray(segment?.logicGroupIds) ? segment.logicGroupIds : []),
      ...(Array.isArray(segment?.postUnitClosureLogicGroupIds) ? segment.postUnitClosureLogicGroupIds : [])
    ])];
    const naturalSegmentForGroup = (groupId) => sourceSegments.find((segment) => naturalReleaseGroupIds(segment).includes(groupId)) || null;
    const segmentGroupSourceCovered = (group) => {
      const groupId = String(group?.groupId || '');
      const segment = naturalSegmentForGroup(groupId);
      if (segment) return naturalSegmentDone(segment);
      if (integrationPrimary && integrationReleaseLogicGroupIds.includes(groupId)) {
        const ids = Array.isArray(group?.kpIds) ? group.kpIds : [];
        return ids.length > 0 && ids.every((id) => state.learned?.[id] === true);
      }
      return false;
    };
    const firstPendingNaturalSegmentIndex = () => {
      const index = sourceSegments.findIndex((segment) => !naturalSegmentDone(segment));
      return index >= 0 ? index : sourceSegments.length;
    };
    const syncNaturalSourceStage = () => {
      if (!segmentedSourceUnits || !sourceSegments.length) return;
      const index = Math.max(0, Math.min(sourceSegments.length - 1, Number(state.sourceSegmentIndex || 0)));
      const segment = sourceSegments[index];
      const unitLabel = integrationTargetedSourceReturns ? '回原讲义' : 'Source Unit';
      const fallbackLabel = integrationTargetedSourceReturns ? '当前需回看的原讲义' : '当前自然 Source unit';
      root.dataset.sourceSegmentId = String(segment?.sourceUnitId || segment?.segmentId || '');
      root.querySelector('[data-source-unit-counter]')?.replaceChildren(document.createTextNode(`${unitLabel} ${index + 1}/${sourceSegments.length}`));
      root.querySelector('[data-source-unit-label]')?.replaceChildren(document.createTextNode(segment?.label || segment?.sourceUnitId || fallbackLabel));
      root.querySelector('[data-block-source-contact]')?.replaceChildren(document.createTextNode(`MarginNote · ${segment?.label || segment?.sourceUnitId || fallbackLabel}`));
      const contribution = (segment?.contributesToLogicGroupIds || []).length ? ` · 预热 ${(segment.contributesToLogicGroupIds || []).join(' / ')}` : '';
      const reactivation = (segment?.reactivateLogicGroupIds || []).length
        ? ` · 重激活 ${(segment.reactivateLogicGroupIds || []).join(' / ')}`
        : (segment?.reactivationNote ? ` · 局部重激活：${segment.reactivationNote}` : '');
      const sourceDebt = (segment?.sourceDebt || []).length ? ` · 精确 Source 待回看：${(segment.sourceDebt || []).join(' / ')}` : '';
      const visualDebt = (segment?.visualDebt || []).length ? ` · 原图待回看：${(segment.visualDebt || []).join(' / ')}` : '';
      root.querySelector('[data-natural-source-status]')?.replaceChildren(document.createTextNode(`${integrationTargetedSourceReturns ? '当前需回看的原讲义' : '当前 Source unit'}：${segment?.sourceUnitId || '—'}${contribution}${reactivation}${sourceDebt}${visualDebt}`));
    };
    const ensureIntegrationPrimaryReady = () => {
      if (!integrationPrimary) return;
      const directGroupIds = integrationTargetedSourceReturns
        ? integrationReleaseLogicGroupIds
        : groups.map((group) => String(group?.groupId || '')).filter(Boolean);
      const directIds = groups
        .filter((group) => directGroupIds.includes(String(group?.groupId || '')))
        .flatMap((group) => Array.isArray(group?.kpIds) ? group.kpIds : [])
        .map(String)
        .filter(Boolean);
      const segmentId = `integration-primary:${objectId}`;
      const changedDirectContract = state.contentRevision?.contactPending
        && state.contentRevision.contactReason !== 'UNCLASSIFIED_REVISION'
        && !(state.sourceContactEvidence || []).some(entry => entry.segment_id === segmentId && sourceContactCompatible(state, entry, currentSourceHash));
      if (directIds.length && (!directIds.every(id => state.learned?.[id] === true) || changedDirectContract)) {
        recordSourceContact(segmentId, directIds, true, {
          coverage_kind: integrationTargetedSourceReturns
            ? 'INTEGRATION_PRIMARY_DIRECT_RELEASE'
            : 'INTEGRATION_PRIMARY_NO_NEW_CONTINUOUS_SOURCE'
        });
        const learned = { ...(state.learned || {}) };
        directIds.forEach((id) => { learned[id] = true; });
        state.learned = learned;
      }
      const allSegmentsDone = !integrationTargetedSourceReturns
        || (sourceSegments.length > 0 && sourceSegments.every((segment) => naturalSegmentDone(segment)));
      const allFormed = totalKp > 0 && kpData.every((kp) => state.learned?.[kp.kpId] === true);
      state.sourceContactDone = state.sourceContactDone === true || (allSegmentsDone && allFormed);
      if (state.sourceContactDone) {
        state.sourceRevisionPending = false;
        state.sourceRevisionReason = '';
      }
    };
    const reconcileIntegrationTargetedState = () => {
      if (!integrationTargetedSourceReturns) return;
      const validSegmentIds = new Set(sourceSegments.map((segment) => String(segment?.segmentId || '')).filter(Boolean));
      const evidence = Array.isArray(state.sourceContactEvidence) ? state.sourceContactEvidence : [];
      const covered = new Set();
      for (const entry of evidence) {
        if (!sourceContactCompatible(state, entry, currentSourceHash)) continue;
        if (!validSegmentIds.has(String(entry?.segment_id || ''))) continue;
        for (const kpId of Array.isArray(entry?.kp_ids) ? entry.kp_ids : []) covered.add(String(kpId));
      }
      state.learned = { ...state.learned, ...Object.fromEntries([...covered].map(id => [id, true])) };
      ensureIntegrationPrimaryReady();
    };
    const readBiochemistryLane = () => {
      if (!biochemistryLedgerKey || !biochemistrySource?.laneSourceHash) return null;
      try {
        const row = JSON.parse(localStorage.getItem(biochemistryLedgerKey) || 'null');
        return row?.schema === 'kianos.xizong.biochemistry-source-lane-state.v1' ? row : null;
      } catch { return null; }
    };
    const syncBiochemistrySource = () => {
      if (!biochemistrySource?.laneSourceHash || !Array.isArray(biochemistrySource?.segments)) return false;
      const lane = readBiochemistryLane();
      const completed = new Set((lane?.history || [])
        .filter((entry) => String(entry?.source_hash || '') === String(biochemistrySource.laneSourceHash))
        .map((entry) => String(entry?.source_unit_id || ''))
        .filter(Boolean));
      let changed = false;
      const learned = { ...(state.learned || {}) };
      for (const segment of biochemistrySource.segments) {
        if (!completed.has(String(segment?.sourceUnitId || ''))) continue;
        const ids = Array.isArray(segment?.kpIds) ? segment.kpIds.map(String).filter(Boolean) : [];
        ids.forEach((id) => {
          if (learned[id] !== true) { learned[id] = true; changed = true; }
        });
        if ((state.sourceContactEvidence || []).some(entry => entry.segment_id === String(segment?.segmentId || '') && entry.lane_source_hash === String(biochemistrySource.laneSourceHash) && sourceContactCompatible(state, entry, currentSourceHash))) continue;
        const before = (state.sourceContactEvidence || []).length;
        recordSourceContact(String(segment?.segmentId || ''), ids, false, {
          coverage_kind: 'GLOBAL_BIOCHEMISTRY_SOURCE_UNIT',
          source_unit_id: String(segment?.sourceUnitId || ''),
          lane_source_hash: String(biochemistrySource.laneSourceHash)
        });
        if ((state.sourceContactEvidence || []).length !== before) changed = true;
      }
      state.learned = learned;
      const closureReached = completed.has(String(biochemistrySource.closureUnit || ''));
      const allFormed = kpData.length > 0 && kpData.every((kp) => learned[kp.kpId] === true);
      const currentLaneCovered = closureReached && allFormed && biochemistrySource.segments.every(segment => completed.has(String(segment.sourceUnitId || '')));
      if (currentLaneCovered && state.contentRevision?.contactPending) {
        revalidateXizongUnit(state, 'CONTACT', objectId);
        changed = true;
      }
      const nextDone = state.sourceContactDone === true || (closureReached && allFormed);
      if (state.sourceContactDone !== nextDone) { state.sourceContactDone = nextDone; changed = true; }
      if (nextDone && state.sourceRevisionPending === true) {
        state.sourceRevisionPending = false;
        state.sourceRevisionReason = '';
        changed = true;
      }
      const status = root.querySelector('[data-biochemistry-block-source-status]');
      if (status) {
        const doneUnits = biochemistrySource.segments
          .filter((segment) => completed.has(String(segment?.sourceUnitId || '')))
          .map((segment) => segment.sourceUnitId);
        status.textContent = `当前 Block Source 已形成 ${doneUnits.length}/${biochemistrySource.segments.length} 段 · ${nextDone ? '可进入 Recall' : '继续 27 生化主线'}`;
      }
      return changed;
    };
    const learnedCount = () => kpData.filter((kp) => state.learned?.[kp.kpId] === true).length;
    const recallCount = () => kpData.filter((kp) => ['unknown', 'fuzzy', 'known', 'mastered'].includes(state.ratings?.[kp.kpId])).length;
    const currentSourceContactCovered = () => xizongSourceContactCovered(state, {
      sourceHash: currentSourceHash, sourceContact: sourceContactPayload, kps: kpData, logicGroups: groups
    });
    const groupVisualGapReviewableFromOriginalSource = (group) => group?.visualRequired === true
      && /GAP.*NOT_MOUNTED/i.test(String(group?.visualSourceState || ''));
    const groupVisualReviewEvidenceSatisfied = (group) => {
      const groupId = String(group?.groupId || '');
      if (!groupId || !currentSourceHash) return false;
      return (state.sourceContactEvidence || []).some((entry) =>
        sourceContactCompatible(state, entry, currentSourceHash)
        && (Array.isArray(entry?.visual_reviewed_lg_ids) ? entry.visual_reviewed_lg_ids : []).map(String).includes(groupId)
      );
    };
    const reviewableVisualGroupIds = (candidateIds = []) => [...new Set((Array.isArray(candidateIds) ? candidateIds : [])
      .map(String)
      .filter((groupId) => {
        const index = groupIndexById(groupId);
        return index >= 0 && groupVisualGapReviewableFromOriginalSource(groups[index]);
      }))];
    const groupHasBlockingVisualGap = (group) => group?.visualRequired === true
      && /GAP/i.test(String(group?.visualSourceState || ''))
      && !groupVisualReviewEvidenceSatisfied(group);
    const groupClosureSatisfied = (group) => {
      const ids = Array.isArray(group?.kpIds) ? group.kpIds : [];
      return ids.length > 0
        && ids.every((id) => state.learned?.[id] === true && Boolean(state.ratings?.[id]) && !needsFreshKpRecall(state, id))
        && (currentGroupClaim(state, group.groupId) || state.contentRevision?.pendingGroup?.[group.groupId] === 'UNCLASSIFIED_REVISION')
        && !groupHasBlockingVisualGap(group);
    };
    const unresolvedVisualGroups = () => groups.filter((group) => groupHasBlockingVisualGap(group));
    const firstBlockingVisualGroupIndex = () => groups.findIndex((group) => groupHasBlockingVisualGap(group));
    // Existing Recall surface also verifies changed LG closure tasks. Pending
    // group claims must not deadlock the action that can verify those claims.
    const blockRecallReady = () => groups.length > 0 && groups.every((group) =>
      (group.kpIds || []).every(id => state.learned?.[id] === true && Boolean(state.ratings?.[id]) && !needsFreshKpRecall(state, id))
      && !groupHasBlockingVisualGap(group));
    const canComplete = () => totalKp > 0
      && !revisionRequiresAction(state)
      && (currentSourceContactCovered() || historicalXizongSourceContinuation(state))
      && learnedCount() >= totalKp
      && recallCount() >= totalKp
      && groups.every((group) => groupClosureSatisfied(group))
      && Boolean(state.blockRecallDone);
    const currentGroup = () => groups[Math.max(0, Math.min(groups.length - 1, Number(state.groupIndex || 0)))] || groups[0];
    const currentGroupSourceCovered = (group = currentGroup()) => {
      const ids = Array.isArray(group?.kpIds) ? group.kpIds : [];
      return ids.length > 0 && ids.every((id) => state.learned?.[id] === true);
    };
    const ttsxRowsForGroup = (group = currentGroup()) => {
      if (!group) return [];
      const segmentId = `source:${group.groupId}`;
      return ttsxData.filter((row) => row?.logicGroupId === group.groupId || row?.sourceSegmentId === segmentId);
    };
    const ttsxKeyFor = (rows, fallback) => {
      const ids = rows.map((row) => String(row?.checkpointId || '')).filter(Boolean);
      return ids.length ? ids.join('|') : fallback;
    };
    const reviewedTtsxIds = new Set(ttsxData.map((row) => String(row?.checkpointId || '')).filter(Boolean));
    const pendingTtsxIsReviewed = (pending) => {
      const ids = Array.isArray(pending?.checkpointIds) ? pending.checkpointIds.map(String).filter(Boolean) : [];
      return ids.length > 0 && ids.every((id) => reviewedTtsxIds.has(id));
    };
    const ttsxDone = (key) => Boolean(key && state.ttsxEvidence?.[key]?.completedAt);
    const queueTtsx = (rows, fallbackKey, label) => {
      if (!Array.isArray(rows) || rows.length === 0) return false;
      const key = ttsxKeyFor(rows, fallbackKey);
      if (ttsxDone(key)) return false;
      state.pendingTtsx = {
        key,
        label: String(rows[0]?.label || label || '当前原讲义边界'),
        lecturePageLabel: String(rows[0]?.lecturePageLabel || ''),
        questionPageLabel: String(rows[0]?.questionPageLabel || ''),
        checkpointIds: rows.map((row) => String(row?.checkpointId || '')).filter(Boolean),
        questionRows: rows.flatMap((row) => Array.isArray(row?.questionRows) ? row.questionRows : [])
      };
      return true;
    };
    const groupIndexForKp = (index) => {
      const groupId = kpData[index]?.groupId || '';
      const found = groups.findIndex((group) => group.groupId === groupId);
      return found >= 0 ? found : 0;
    };
    const firstIndexForGroup = (group) => {
      const firstKpId = Array.isArray(group?.kpIds) ? group.kpIds[0] : '';
      const found = kpData.findIndex((kp) => kp.kpId === firstKpId);
      return found >= 0 ? found : 0;
    };
    const indexForKpId = (kpId) => kpData.findIndex((kp) => kp.kpId === kpId);
    const groupKps = (group = currentGroup()) => {
      const ids = Array.isArray(group?.kpIds) ? group.kpIds : [];
      return ids.map((id) => kpData.find((kp) => kp.kpId === id)).filter(Boolean);
    };
    const sourceSummaryForGroup = (group = currentGroup()) => {
      const locators = [...new Set(groupKps(group).map((kp) => kp.sourceLocator).filter(Boolean))];
      if (!locators.length) return 'MarginNote · 原讲义对应连续小节';
      if (locators.length === 1) return `MarginNote · ${locators[0]}`;
      return `MarginNote · 相关定位：${locators.join('；')}`;
    };
    const firstUnrecalledIndexForGroup = (group = currentGroup()) => {
      const item = groupKps(group).find((kp) => (!state.ratings?.[kp.kpId] || needsFreshKpRecall(state, kp.kpId)));
      const index = item ? indexForKpId(item.kpId) : firstIndexForGroup(group);
      return index >= 0 ? index : 0;
    };
    const groupHasUnrecalled = (group) => (group?.kpIds || []).some((id) => (!state.ratings?.[id] || needsFreshKpRecall(state, id)));
    const naturalSegmentIndexForGroup = (group = currentGroup()) => {
      if (!segmentedSourceUnits || !group) return -1;
      const candidates = sourceSegments
        .map((segment, index) => ({ segment, index }))
        .filter(({ segment }) => [
          ...(segment.logicGroupIds || []),
          ...(segment.postUnitClosureLogicGroupIds || []),
          ...(segment.contributesToLogicGroupIds || []),
          ...(segment.reactivateLogicGroupIds || [])
        ].includes(group.groupId));
      const pending = candidates.find(({ segment }) => !naturalSegmentDone(segment));
      if (pending) return pending.index;
      const release = candidates.find(({ segment }) => naturalReleaseGroupIds(segment).includes(group.groupId));
      return release?.index ?? -1;
    };
    const firstUnrecalledNaturalGroupIndex = (segment = null) => {
      const segments = segment ? [segment] : sourceSegments;
      for (const row of segments) {
        for (const groupId of naturalReleaseGroupIds(row)) {
          const index = groupIndexById(groupId);
          if (index >= 0 && groupHasUnrecalled(groups[index])) return index;
        }
      }
      return -1;
    };
    const nextNaturalStepAfterGroup = (group = currentGroup()) => {
      const segmentIndex = sourceSegments.findIndex((segment) => naturalReleaseGroupIds(segment).includes(group?.groupId));
      const segment = segmentIndex >= 0 ? sourceSegments[segmentIndex] : null;
      if (segment) {
        const releaseIds = naturalReleaseGroupIds(segment);
        const position = releaseIds.indexOf(group.groupId);
        for (const groupId of releaseIds.slice(Math.max(0, position + 1))) {
          const index = groupIndexById(groupId);
          if (index >= 0 && groupHasUnrecalled(groups[index])) return { stage: 'kp_recall', groupIndex: index, sourceSegmentIndex: segmentIndex };
        }
      }
      const nextSegmentIndex = firstPendingNaturalSegmentIndex();
      if (nextSegmentIndex < sourceSegments.length) return { stage: 'source_contact', sourceSegmentIndex: nextSegmentIndex };
      const remainingGroupIndex = firstUnrecalledNaturalGroupIndex();
      if (remainingGroupIndex >= 0) return { stage: 'kp_recall', groupIndex: remainingGroupIndex, sourceSegmentIndex: naturalSegmentIndexForGroup(groups[remainingGroupIndex]) };
      const visualBlockedIndex = firstBlockingVisualGroupIndex();
      if (visualBlockedIndex >= 0) {
        const blockedGroup = groups[visualBlockedIndex];
        return {
          stage: groupVisualGapReviewableFromOriginalSource(blockedGroup) ? 'source_contact' : 'kp_recall',
          groupIndex: visualBlockedIndex,
          sourceSegmentIndex: naturalSegmentIndexForGroup(blockedGroup)
        };
      }
      return { stage: 'block_recall' };
    };
    const applyNaturalStep = (step) => {
      if (!step) return 'block_recall';
      if (Number.isInteger(step.sourceSegmentIndex) && step.sourceSegmentIndex >= 0) state.sourceSegmentIndex = step.sourceSegmentIndex;
      if (Number.isInteger(step.groupIndex) && step.groupIndex >= 0) {
        state.groupIndex = step.groupIndex;
        state.kpIndex = firstUnrecalledIndexForGroup(groups[step.groupIndex]);
      }
      return step.stage || 'block_recall';
    };
    const stageLabel = { block_learn: '建立框架', source_contact: '原讲义连续学习', logic_group: '学习节', kp_learn: '原讲义连续学习', ttsx_checkpoint: '讲义配套题', kp_recall: '本节 KP 回忆', block_recall: '整块回忆' };

    const syncTtsxStage = () => {
      const pending = state.pendingTtsx;
      const label = root.querySelector('[data-ttsx-boundary-label]');
      const pageLabel = root.querySelector('[data-ttsx-page-label]');
      const progress = root.querySelector('[data-ttsx-progress]');
      const meta = root.querySelector('[data-ttsx-meta]');
      const list = root.querySelector('[data-ttsx-question-list]');
      const empty = root.querySelector('[data-ttsx-empty]');
      const rows = Array.isArray(pending?.questionRows) ? pending.questionRows : [];
      if (label) label.textContent = pending?.label || '当前原讲义边界';
      if (pageLabel) {
        const parts = [pending?.lecturePageLabel, pending?.questionPageLabel ? `题目 ${pending.questionPageLabel}` : ''].filter(Boolean);
        pageLabel.textContent = parts.length
          ? `${parts.join(' · ')} · 回 MarginNote 原位置完成题目、答案、全部选项和题旁拓展。`
          : '回 MarginNote 原位置完成题目、答案、全部选项和题旁拓展。';
      }
      if (progress) progress.textContent = `${rows.length} 道`;
      if (meta) meta.textContent = rows.length
        ? `${rows.length} 道 · 每题都可以单独「+写一句」，也可以一题都不记。`
        : '按原讲义页码逐组核对；这里不判分、不分类、不生成 Question Attempt。';
      if (empty instanceof HTMLElement) empty.hidden = rows.length > 0;
      if (!(list instanceof HTMLElement)) return;
      list.replaceChildren();

      const annotations = pending?.key ? (state.ttsxAnnotations?.[pending.key] || {}) : {};
      rows.forEach((question) => {
        const row = document.createElement('section');
        row.className = 'xv6TtsxQuestionRow';
        row.dataset.ttsxQuestionRow = String(question?.questionId || '');

        const id = document.createElement('strong');
        id.className = 'xv6TtsxQuestionId';
        id.textContent = String(question?.displayLabel || question?.questionId || '题目');
        row.append(id);

        const title = document.createElement('p');
        title.textContent = String(question?.title || '题干请回 MarginNote 查看');
        row.append(title);

        const page = document.createElement('span');
        page.className = 'xv6TtsxQuestionPage';
        page.textContent = String(question?.sourcePageLabel || '');
        row.append(page);

        const write = document.createElement('button');
        write.type = 'button';
        write.className = 'xv6TtsxWrite';
        write.dataset.ttsxWrite = String(question?.questionId || '');
        const savedText = String(annotations?.[question?.questionId]?.text || '');
        write.textContent = savedText || '+写一句';
        row.append(write);

        const editor = document.createElement('div');
        editor.className = 'xv6TtsxAnnotationEditor';
        editor.hidden = true;
        const textarea = document.createElement('textarea');
        textarea.rows = 2;
        textarea.placeholder = '写一句你想以后回看的东西';
        textarea.value = savedText;
        const actions = document.createElement('div');
        const saveButton = document.createElement('button');
        saveButton.type = 'button';
        saveButton.textContent = '保存';
        const cancelButton = document.createElement('button');
        cancelButton.type = 'button';
        cancelButton.textContent = '取消';
        actions.append(saveButton, cancelButton);
        editor.append(textarea, actions);
        row.append(editor);

        write.addEventListener('click', () => {
          editor.hidden = false;
          write.hidden = true;
          textarea.focus();
        });
        cancelButton.addEventListener('click', () => {
          editor.hidden = true;
          write.hidden = false;
          textarea.value = String(state.ttsxAnnotations?.[pending?.key]?.[question?.questionId]?.text || '');
        });
        saveButton.addEventListener('click', () => {
          const value = textarea.value.trim();
          const key = pending?.key || '';
          const qid = String(question?.questionId || '');
          if (!key || !qid) return;
          const group = { ...(state.ttsxAnnotations?.[key] || {}) };
          if (value) group[qid] = { text: value, updatedAt: new Date().toISOString() };
          else delete group[qid];
          state.ttsxAnnotations = { ...(state.ttsxAnnotations || {}), [key]: group };
          save();
          write.textContent = value || '+写一句';
          editor.hidden = true;
          write.hidden = false;
        });
        textarea.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            event.preventDefault();
            cancelButton.click();
          }
          if ((event.metaKey || event.ctrlKey) && event.key === 'Enter') {
            event.preventDefault();
            saveButton.click();
          }
        });

        list.append(row);
      });
    };

    // Read-only projection of the existing native state; no second cursor/store.
    const readStudyPosition = () => Object.freeze({
      objectId,
      stage: state.stage,
      kpId: kpData[state.kpIndex]?.kpId || '',
      logicGroupId: groups[state.groupIndex]?.groupId || '',
      kpIndex: state.kpIndex,
      groupIndex: state.groupIndex,
      sourceSegmentIndex: state.sourceSegmentIndex
    });
    Object.defineProperty(root, 'getXizongStudyPosition', {
      value: readStudyPosition, configurable: true
    });
    let lastPublishedPosition = '';
    const publishStudyPosition = () => {
      const position = readStudyPosition();
      const key = JSON.stringify(position);
      if (key === lastPublishedPosition) return;
      lastPublishedPosition = key;
      root.dispatchEvent(new CustomEvent('kianos:xizong-position-change', { detail: position }));
    };

    const syncGroupStage = () => {
      const group = currentGroup();
      const groupItems = groupKps(group);
      root.querySelector('[data-logic-counter]')?.replaceChildren(document.createTextNode(`${String(state.groupIndex + 1).padStart(2, '0')} / ${groups.length}`));
      root.querySelector('[data-logic-title]')?.replaceChildren(document.createTextNode(group?.label || '学习节'));
      root.querySelector('[data-logic-goal]')?.replaceChildren(document.createTextNode(group?.goal || '先回答这一节共同在解决什么问题。'));
      root.querySelector('[data-logic-closure]')?.replaceChildren(document.createTextNode(group?.closure || '学完后能自己恢复这一节的核心关系。'));
      root.querySelector('[data-group-lecture-title]')?.replaceChildren(document.createTextNode(group?.label || '当前学习节'));
      root.querySelector('[data-group-lecture-counter]')?.replaceChildren(document.createTextNode(`学习节 ${state.groupIndex + 1}/${groups.length}`));
      root.querySelector('[data-group-lecture-source]')?.replaceChildren(document.createTextNode(sourceSummaryForGroup(group)));
      root.querySelector('[data-group-lecture-kps]')?.replaceChildren(document.createTextNode(groupItems.map((kp) => kp.displayId).join(' · ') || '本学习节对应 KP'));
      root.querySelector('[data-chain-group]')?.replaceChildren(document.createTextNode(`${state.groupIndex + 1}/${groups.length}`));
      groupRailButtons.forEach((button, index) => {
        const ids = groups[index]?.kpIds || [];
        const active = index === state.groupIndex;
        const done = groupClosureSatisfied(groups[index]);
        button.classList.toggle('active', active);
        button.classList.toggle('done', done);
      });
    };

    const syncState = () => {
      if (root.dataset.xizongStateBlocked === 'true') return;
      const shortcutHint = root.querySelector('[data-block-keyboard-hint]');
      if (shortcutHint) shortcutHint.textContent = state.stage === 'kp_recall' ? 'Space 核对答案 · 1–4 记录回忆并继续 · ← → 切换' : '← → 切换伴读 · 原讲义段学完后一次确认';
      kpRailButtons.forEach((button, index) => {
        const kpId = kpData[index]?.kpId || '';
        const small = button.querySelector('[data-kp-state]');
        const rating = state.ratings?.[kpId];
        const learned = Boolean(state.learned?.[kpId]);
        if (small) small.textContent = rating || (learned ? '已接触' : '—');
        button.classList.toggle('active', index === state.kpIndex);
        button.classList.toggle('done', learned && Boolean(rating));
      });
      const revision = revisionStatus(state, currentSourceHash);
      root.dataset.xizongSourceRevision = revision.status;
      const closureOnly = state.blockRecallDone && revision.impacted_group_ids.length > 0 && !revision.block_review_required;
      root.querySelectorAll('[data-revision-group]').forEach(node => { node.hidden = closureOnly && !revision.impacted_group_ids.includes(node.getAttribute('data-revision-group')); });
      const spine = root.querySelector('.xv6RecallSpine');
      if (spine) spine.hidden = closureOnly;
      const recallPrompt = root.querySelector('.xv6RecallPromptBox > strong');
      if (recallPrompt) recallPrompt.textContent = closureOnly ? '只恢复有变化的学习节闭合目标，再核对。' : '先从中心问题把整个 Block 自己跑一遍。';
      const detail = root.querySelector('[data-block-complete-detail]');
      if (detail && !revision.blocked) detail.textContent = '状态只记录真实学习证据，不会把模糊项自动升级成掌握。';
      if (detail && revision.blocked) detail.textContent = revision.status === 'UNCLASSIFIED_REVISION' ? '原位置和历史记录保留；旧记录缺少语义基线，当前结论待核对。' : `原记录保留；${revision.impacted_kp_ids.length} 个知识点、${revision.impacted_group_ids.length} 个学习节需局部核对。`;
      const completedGroups = groups.filter((group) => groupClosureSatisfied(group)).length;
      const visualGaps = unresolvedVisualGroups();
      root.querySelector('[data-chain-source]')?.replaceChildren(document.createTextNode(
        state.sourceRevisionPending
          ? '原记录保留 · 内容变化待核对'
          : (currentSourceContactCovered() ? '已确认' : '未确认')
      ));
      root.querySelector('[data-chain-kp-learn]')?.replaceChildren(document.createTextNode(
        visualGaps.length
          ? `${completedGroups}/${groups.length} 节闭合 · ${visualGaps.length} 个原图门禁未闭合`
          : (learnedCount() >= totalKp ? '全部已接触' : `${completedGroups}/${groups.length} 节闭合`)
      ));
      root.querySelector('[data-chain-kp-recall]')?.replaceChildren(document.createTextNode(`${recallCount()}/${totalKp}`));
      root.querySelector('[data-chain-block-recall]')?.replaceChildren(document.createTextNode(state.blockRecallDone ? '已完成' : '未完成'));
      root.querySelector('[data-chain-complete]')?.replaceChildren(document.createTextNode(state.completed ? (revisionStatus(state, currentSourceHash).blocked ? '已完成 · 局部待核对' : '已完成') : '未完成'));
      const group = currentGroup();
      if (statusLabel) {
        if (state.stage === 'source_contact') statusLabel.textContent = '原讲义连续学习 · 等待回来确认';
        else if (state.stage === 'kp_recall') statusLabel.textContent = groupHasBlockingVisualGap(group) && !groupHasUnrecalled(group)
          ? `原图门禁未闭合 · ${group?.label || '当前学习节'}`
          : `本节回忆 · ${groupKps(group).filter((kp) => Boolean(state.ratings?.[kp.kpId])).length}/${groupKps(group).length}`;
        else if (state.stage === 'block_recall') statusLabel.textContent = state.completed
          ? '本块第一轮已完成'
          : (visualGaps.length ? `整块回忆 · 原图门禁未闭合 ${visualGaps.map((row) => row.label || '当前学习节').join(' / ')}` : '整块回忆');
        else statusLabel.textContent = `学习节 ${state.groupIndex + 1}/${groups.length} · ${group?.label || ''}`;
      }
      const completeButton = root.querySelector('[data-block-complete]');
      if (completeButton) completeButton.disabled = !canComplete() || state.completed;
      const returnSystem = root.querySelector('[data-block-return-system]');
      if (returnSystem instanceof HTMLElement) returnSystem.hidden = !state.completed;
      root.querySelector('[data-block-complete-title]')?.replaceChildren(document.createTextNode(state.completed ? '本 Block 第一轮已在本机记录完成' : canComplete() ? '本轮检查点已满足' : '还没有满足本轮检查点'));
      const contactText = sourcePerGroup ? `学习接触 ${learnedCount()}/${totalKp}` : `连续 Source ${state.sourceContactDone ? '已确认' : '未确认'}`;
      root.querySelector('[data-block-complete-detail]')?.replaceChildren(document.createTextNode(
        `${contactText} · Recall ${recallCount()}/${totalKp} · 整块回忆 ${state.blockRecallDone ? '完成' : '未完成'}`
        + (visualGaps.length ? ` · 原图门禁未闭合 ${visualGaps.map((row) => row.label || '当前学习节').join(' / ')}` : '')
      ));
      syncGroupStage();
      publishStudyPosition();
    };

    const resetRecallCard = (card) => {
      if (!(card instanceof HTMLElement)) return;
      card.dataset.ratingCommitted = 'false';
      const answer = card.querySelector('[data-kp-answer]');
      const rating = card.querySelector('[data-kp-rating]');
      const reveal = card.querySelector('[data-kp-reveal]');
      if (answer instanceof HTMLElement) answer.hidden = true;
      if (rating instanceof HTMLElement) rating.hidden = true;
      if (reveal instanceof HTMLElement) reveal.hidden = false;
    };

    const setKpIndex = (index) => {
      if (root.dataset.xizongStateBlocked === 'true') return;
      state.kpIndex = Math.max(0, Math.min(totalKp - 1, Number(index) || 0));
      state.groupIndex = groupIndexForKp(state.kpIndex);
      if (!save()) return;
      kpRecallCards.forEach((card, itemIndex) => {
        card.hidden = itemIndex !== state.kpIndex;
        if (itemIndex === state.kpIndex && state.stage === 'kp_recall') resetRecallCard(card);
      });
      const recallLabel = kpRecallCards[state.kpIndex]?.querySelector('h3')?.textContent || '';
      root.querySelector('[data-kp-recall-title]')?.replaceChildren(document.createTextNode(recallLabel));
      const group = currentGroup();
      const currentKpId = kpData[state.kpIndex]?.kpId || '';
      const groupKpIds = Array.isArray(group?.kpIds) ? group.kpIds : [];
      const groupPosition = groupKpIds.indexOf(currentKpId);
      const localPosition = groupPosition >= 0 ? groupPosition + 1 : 1;
      const groupTotal = Math.max(1, groupKpIds.length);
      root.querySelector('[data-recall-counter]')?.replaceChildren(document.createTextNode(`本节 ${localPosition}/${groupTotal}`));
      save(); syncState();
    };

    const normalizeLegacyStage = () => {
      const validStages = ['block_learn', 'source_contact', 'logic_group', 'kp_learn', 'ttsx_checkpoint', 'kp_recall', 'group_close', 'block_recall', 'block_complete'];
      if (sourceRevisionMigrated && validStages.includes(state.stage) && state.stage !== 'block_complete') return;
      if (!validStages.includes(state.stage)) state.stage = 'block_learn';
      if (state.stage === 'block_complete') state.stage = 'block_recall';
      if (isPostChatRecall() && ['logic_group', 'kp_learn'].includes(state.stage)) state.stage = 'kp_recall';
      const visualBlockedIndex = firstBlockingVisualGroupIndex();
      if (visualBlockedIndex >= 0) {
        // Keep historical completion; visual readiness gates current actions.
        if (state.stage === 'block_recall') {
          const blockedGroup = groups[visualBlockedIndex];
          state.groupIndex = visualBlockedIndex;
          state.kpIndex = firstIndexForGroup(blockedGroup);
          const segmentIndex = naturalSegmentIndexForGroup(blockedGroup);
          if (segmentIndex >= 0) state.sourceSegmentIndex = segmentIndex;
          state.stage = groupVisualGapReviewableFromOriginalSource(blockedGroup) ? 'source_contact' : 'kp_recall';
        }
      }
      if (biochemistrySource?.laneSourceHash && state.stage === 'kp_learn') state.stage = currentGroupSourceCovered() ? 'kp_recall' : 'source_contact';
      else if (segmentedSourceUnits && state.stage === 'kp_learn') {
        if (integrationPrimary) ensureIntegrationPrimaryReady();
        const segmentIndex = naturalSegmentIndexForGroup(currentGroup());
        if (segmentIndex >= 0) state.sourceSegmentIndex = segmentIndex;
        state.stage = segmentGroupSourceCovered(currentGroup()) ? 'kp_recall' : 'source_contact';
      } else if (integrationPrimary && state.stage === 'kp_learn') {
        ensureIntegrationPrimaryReady();
        state.stage = 'kp_recall';
      } else if (!sourcePerGroup && state.stage === 'kp_learn') state.stage = state.sourceContactDone ? 'kp_recall' : 'source_contact';
      if (sourcePerGroup && state.stage === 'source_contact') state.stage = 'kp_learn';
      if (integrationPrimary && !integrationTargetedSourceReturns && state.stage === 'source_contact') {
        ensureIntegrationPrimaryReady();
        state.stage = 'kp_recall';
      }
      if (segmentedSourceUnits && state.stage === 'source_contact') {
        if (integrationTargetedSourceReturns && integrationReleaseLogicGroupIds.includes(String(currentGroup()?.groupId || '')) && groupHasUnrecalled(currentGroup())) {
          ensureIntegrationPrimaryReady();
          state.stage = 'kp_recall';
        } else {
          const pendingIndex = firstPendingNaturalSegmentIndex();
          if (pendingIndex < sourceSegments.length) state.sourceSegmentIndex = pendingIndex;
          else {
            const remaining = firstUnrecalledNaturalGroupIndex();
            if (remaining >= 0) {
              state.groupIndex = remaining;
              state.kpIndex = firstUnrecalledIndexForGroup(groups[remaining]);
              state.stage = 'kp_recall';
            } else state.stage = 'block_recall';
          }
        }
      }
      if (biochemistrySource?.laneSourceHash && state.stage === 'source_contact' && currentGroupSourceCovered()) state.stage = 'kp_recall';
      if (state.stage === 'logic_group') {
        if (biochemistrySource?.laneSourceHash) state.stage = currentGroupSourceCovered() ? 'kp_recall' : 'source_contact';
        else if (sourcePerGroup) state.stage = 'kp_learn';
        else if (segmentedSourceUnits) {
          if (integrationPrimary) ensureIntegrationPrimaryReady();
          const segmentIndex = naturalSegmentIndexForGroup(currentGroup());
          if (segmentIndex >= 0) state.sourceSegmentIndex = segmentIndex;
          state.stage = segmentGroupSourceCovered(currentGroup()) ? 'kp_recall' : 'source_contact';
        } else if (integrationPrimary) {
          ensureIntegrationPrimaryReady();
          state.stage = 'kp_recall';
        } else state.stage = state.sourceContactDone ? 'kp_recall' : 'source_contact';
      }
      const group = currentGroup();
      if (state.stage === 'group_close') {
        const missing = (group?.kpIds || []).some((id) => (!state.ratings?.[id] || needsFreshKpRecall(state, id)));
        if (missing) {
          state.kpIndex = firstUnrecalledIndexForGroup(group);
          state.stage = 'kp_recall';
        } else if (segmentedSourceUnits) {
          state.stage = applyNaturalStep(nextNaturalStepAfterGroup(group));
        } else if (state.groupIndex < groups.length - 1) {
          state.groupIndex += 1;
          state.kpIndex = firstIndexForGroup(currentGroup());
          state.stage = stageForSelectedGroup();
        } else {
          state.stage = 'block_recall';
        }
      }
      if (state.pendingTtsx && !pendingTtsxIsReviewed(state.pendingTtsx)) state.pendingTtsx = null;
      if (state.stage === 'ttsx_checkpoint' && (!state.pendingTtsx?.key || ttsxDone(state.pendingTtsx.key))) {
        state.pendingTtsx = null;
        state.stage = 'kp_recall';
      }
      if (state.stage === 'kp_recall' && state.pendingTtsx?.key && pendingTtsxIsReviewed(state.pendingTtsx) && !ttsxDone(state.pendingTtsx.key)) state.stage = 'ttsx_checkpoint';
      if (state.stage === 'kp_recall') state.kpIndex = firstUnrecalledIndexForGroup(currentGroup());
      // Completion is historical evidence; canComplete gates a new current claim.
    };

    const setStage = (requested) => {
      if (root.dataset.xizongStateBlocked === 'true') return;
      let stage = requested || 'block_learn';
      // Historical UNKNOWN completion permits continuation without inventing
      // Source evidence or rewriting the learner's saved Recall position.
      if (historicalXizongSourceContinuation(state) || isPostChatRecall()) {
        // Whole-LG kp_learn is an actual explicit Source-view panel. Keep
        // that saved intention; only adapt legacy routes without that panel.
        if (stage === 'logic_group' || (stage === 'kp_learn' && !sourcePerGroup)) stage = 'kp_recall';
      } else {
        if (biochemistrySource?.laneSourceHash && stage === 'kp_learn') stage = currentGroupSourceCovered() ? 'kp_recall' : 'source_contact';
        else if (segmentedSourceUnits && stage === 'kp_learn') {
          if (integrationPrimary) ensureIntegrationPrimaryReady();
          const segmentIndex = naturalSegmentIndexForGroup(currentGroup());
          if (segmentIndex >= 0) state.sourceSegmentIndex = segmentIndex;
          stage = segmentGroupSourceCovered(currentGroup()) ? 'kp_recall' : 'source_contact';
        } else if (integrationPrimary && stage === 'kp_learn') {
          ensureIntegrationPrimaryReady();
          stage = 'kp_recall';
        } else if (!sourcePerGroup && stage === 'kp_learn') stage = state.sourceContactDone ? 'kp_recall' : 'source_contact';

        if (biochemistrySource?.laneSourceHash && stage === 'kp_recall' && !currentGroupSourceCovered()) stage = 'source_contact';
        else if (segmentedSourceUnits && stage === 'kp_recall') {
          if (integrationPrimary) ensureIntegrationPrimaryReady();
          if (!segmentGroupSourceCovered(currentGroup())) {
            const segmentIndex = naturalSegmentIndexForGroup(currentGroup());
            if (segmentIndex >= 0) state.sourceSegmentIndex = segmentIndex;
            stage = 'source_contact';
          }
        } else if (integrationPrimary && stage === 'kp_recall') {
          ensureIntegrationPrimaryReady();
        } else if (!biochemistrySource?.laneSourceHash && !naturalSourceUnits && !integrationPrimary && !sourcePerGroup && stage === 'kp_recall' && !state.sourceContactDone) stage = 'source_contact';

        if (stage === 'logic_group') {
          if (biochemistrySource?.laneSourceHash) stage = currentGroupSourceCovered() ? 'kp_recall' : 'source_contact';
          else if (sourcePerGroup) stage = 'kp_learn';
          else if (segmentedSourceUnits) {
            if (integrationPrimary) ensureIntegrationPrimaryReady();
            const segmentIndex = naturalSegmentIndexForGroup(currentGroup());
            if (segmentIndex >= 0) state.sourceSegmentIndex = segmentIndex;
            stage = segmentGroupSourceCovered(currentGroup()) ? 'kp_recall' : 'source_contact';
          } else if (integrationPrimary) {
            ensureIntegrationPrimaryReady();
            stage = 'kp_recall';
          } else stage = state.sourceContactDone ? 'kp_recall' : 'source_contact';
        }
      }
      // Mode normalization is independent of historical/current eligibility:
      // source_contact has no rendered panel in whole-LG/direct integration.
      if (sourcePerGroup && stage === 'source_contact') stage = 'kp_learn';
      if (integrationPrimary && !integrationTargetedSourceReturns && stage === 'source_contact') {
        if (!historicalXizongSourceContinuation(state)) ensureIntegrationPrimaryReady();
        stage = 'kp_recall';
      }
      if (stage === 'kp_recall' && state.pendingTtsx?.key && pendingTtsxIsReviewed(state.pendingTtsx) && !ttsxDone(state.pendingTtsx.key)) stage = 'ttsx_checkpoint';
      if (stage === 'ttsx_checkpoint' && (!state.pendingTtsx?.key || !pendingTtsxIsReviewed(state.pendingTtsx) || ttsxDone(state.pendingTtsx.key))) {
        state.pendingTtsx = null;
        stage = 'kp_recall';
      }
      state.stage = stage;
      if (!save()) return;
      stages.forEach((panel) => { panel.hidden = panel.getAttribute('data-study-stage') !== state.stage; });
      if (state.stage === 'kp_recall') setKpIndex(state.kpIndex);
      if (state.stage === 'source_contact') syncNaturalSourceStage();
      if (state.stage === 'ttsx_checkpoint') syncTtsxStage();
      if (kpRail) kpRail.hidden = true;
      if (groupRail) groupRail.hidden = false;
      root.querySelectorAll('[data-chain-step]').forEach((item) => item.classList.toggle('viewing', item.getAttribute('data-chain-step') === state.stage));
      if (contextLabel) contextLabel.textContent = `西医综合 · ${blockLabel} · ${stageLabel[state.stage] || 'Learn'}`;
      save(); syncState();
    };

    const switchTab = (name) => {
      tabButtons.forEach((button) => button.classList.toggle('active', button.dataset.studyTab === name));
      tabPanels.forEach((panel) => { panel.hidden = panel.dataset.studyPanel !== name; });
      if (name === 'learn') setStage(state.stage || 'block_learn');
    };
    tabButtons.forEach((button) => button.addEventListener('click', () => switchTab(button.dataset.studyTab || 'learn')));
    root.querySelectorAll('[data-post-chat-recall]').forEach((button) => button.addEventListener('click', () => {
      if (!postChatRecallAvailable || root.dataset.xizongStateBlocked === 'true' || root.inert) return;
      state.recallEntryMode = 'POST_CHAT_RECALL';
      // Keep the current KP/LG/Resume. Only an actual revealed rating writes evidence.
      setStage('kp_recall');
    }));
    root.querySelectorAll('[data-stage-target],[data-stage-next]').forEach((button) => button.addEventListener('click', () => {
      switchTab('learn');
      const requested = button.getAttribute('data-stage-target') || button.getAttribute('data-stage-next') || 'block_learn';
      if (requested === 'logic_group' && button.hasAttribute('data-stage-next')) {
        if (historicalXizongSourceContinuation(state)) setStage('kp_recall');
        else if (integrationPrimary) {
          ensureIntegrationPrimaryReady();
          state.groupIndex = 0;
          state.kpIndex = firstUnrecalledIndexForGroup(groups[0]);
          setStage('kp_recall');
        } else if (naturalSourceUnits) {
          state.sourceSegmentIndex = Math.min(firstPendingNaturalSegmentIndex(), Math.max(0, sourceSegments.length - 1));
          setStage('source_contact');
        } else if (!biochemistrySource?.laneSourceHash && !sourcePerGroup && !state.sourceContactDone) setStage('source_contact');
        else setStage(requested);
      } else setStage(requested);
    }));

    root.querySelector('[data-source-contact-done]')?.addEventListener('click', () => {
      if (segmentedSourceUnits) {
        const index = Math.max(0, Math.min(sourceSegments.length - 1, Number(state.sourceSegmentIndex || 0)));
        const segment = sourceSegments[index];
        if (!segment) return;
        const ids = Array.isArray(segment.kpIds) ? segment.kpIds : [];
        recordSourceContact(String(segment.segmentId || `source-unit:${index + 1}`), ids, false, {
          coverage_kind: integrationTargetedSourceReturns ? 'INTEGRATION_TARGETED_SOURCE_RETURN' : 'NATURAL_SOURCE_UNIT',
          source_unit_id: String(segment.sourceUnitId || ''),
          source_debt: Array.isArray(segment.sourceDebt) ? [...segment.sourceDebt] : [],
          visual_debt: Array.isArray(segment.visualDebt) ? [...segment.visualDebt] : [],
          visual_reviewed_lg_ids: reviewableVisualGroupIds(segment.visualDebt)
        });
        const learned = { ...(state.learned || {}) };
        ids.forEach((id) => { learned[id] = true; });
        state.learned = learned;
        const allSegmentsDone = sourceSegments.length > 0 && sourceSegments.every((row) => naturalSegmentDone(row));
        const allKpFormed = totalKp > 0 && kpData.every((kp) => learned[kp.kpId] === true);
        state.sourceContactDone = allSegmentsDone && allKpFormed;
        if (state.sourceContactDone && currentSourceContactCovered()) revalidateXizongUnit(state, 'CONTACT', objectId);
        if (state.sourceContactDone) {
          state.sourceRevisionPending = false;
          state.sourceRevisionReason = '';
        }

        const nextGroupIndex = firstUnrecalledNaturalGroupIndex(segment);
        if (nextGroupIndex >= 0) {
          state.groupIndex = nextGroupIndex;
          state.kpIndex = firstUnrecalledIndexForGroup(groups[nextGroupIndex]);
          save();
          setStage('kp_recall');
          return;
        }
        const nextSegmentIndex = firstPendingNaturalSegmentIndex();
        if (nextSegmentIndex < sourceSegments.length) {
          state.sourceSegmentIndex = nextSegmentIndex;
          save();
          setStage('source_contact');
          return;
        }
        const remainingGroupIndex = firstUnrecalledNaturalGroupIndex();
        if (remainingGroupIndex >= 0) {
          state.groupIndex = remainingGroupIndex;
          state.kpIndex = firstUnrecalledIndexForGroup(groups[remainingGroupIndex]);
          save();
          setStage('kp_recall');
          return;
        }
        save();
        setStage('block_recall');
        return;
      }

      recordSourceContact(`block-cumulative:${objectId}`, kpData.map((kp) => kp.kpId), true, {
        source_debt: Array.isArray(blockSourceDebtPayload) ? [...blockSourceDebtPayload] : [],
        source_conflict: Array.isArray(blockSourceConflictPayload) ? [...blockSourceConflictPayload] : [],
        visual_debt: Array.isArray(blockVisualDebtPayload) ? [...blockVisualDebtPayload] : [],
        visual_reviewed_lg_ids: reviewableVisualGroupIds(blockVisualDebtPayload)
      });
      state.sourceContactDone = true;
      revalidateXizongUnit(state, 'CONTACT', objectId);
      state.sourceRevisionPending = false;
      state.sourceRevisionReason = '';
      state.learned = { ...state.learned, ...Object.fromEntries(kpData.map((kp) => [kp.kpId, true])) };
      state.groupIndex = 0;
      state.kpIndex = firstIndexForGroup(groups[0]);
      const queued = queueTtsx(ttsxData, 'block-source-boundary', '本段原讲义 Source boundary');
      save();
      setStage(queued ? 'ttsx_checkpoint' : 'kp_recall');
    });

    root.querySelector('[data-enter-group]')?.addEventListener('click', () => {
      const group = currentGroup();
      if (group) state.kpIndex = firstIndexForGroup(group);
      save();
      if (isPostChatRecall()) setStage('kp_recall');
      else if (biochemistrySource?.laneSourceHash) setStage(currentGroupSourceCovered() ? 'kp_recall' : 'source_contact');
      else if (sourcePerGroup) setStage('kp_learn');
      else if (segmentedSourceUnits) {
        if (integrationPrimary) ensureIntegrationPrimaryReady();
        const segmentIndex = naturalSegmentIndexForGroup(group);
        if (segmentIndex >= 0) state.sourceSegmentIndex = segmentIndex;
        setStage(segmentGroupSourceCovered(group) ? 'kp_recall' : 'source_contact');
      } else if (integrationPrimary) {
        ensureIntegrationPrimaryReady();
        setStage('kp_recall');
      } else if (state.sourceContactDone) setStage('kp_recall');
      else setStage('source_contact');
    });
    root.querySelector('[data-group-lecture-done]')?.addEventListener('click', () => {
      const group = currentGroup();
      const ids = Array.isArray(group?.kpIds) ? group.kpIds : [];
      const learned = { ...(state.learned || {}) };
      recordSourceContact(`source:${group.groupId}`, ids, false, {
        visual_reviewed_lg_ids: groupVisualGapReviewableFromOriginalSource(group) ? [String(group.groupId || '')] : []
      });
      ids.forEach((id) => { learned[id] = true; });
      state.learned = learned;
      if (sourcePerGroup && xizongSourceContactCovered({ ...state, sourceContactDone: true }, {
        sourceHash: currentSourceHash, sourceContact: sourceContactPayload, kps: kpData, logicGroups: groups
      })) state.sourceContactDone = true;
      if (currentSourceContactCovered()) {
        revalidateXizongUnit(state, 'CONTACT', objectId);
        state.sourceRevisionPending = false;
        state.sourceRevisionReason = '';
      }
      state.kpIndex = firstUnrecalledIndexForGroup(group);
      const rows = ttsxRowsForGroup(group);
      const queued = queueTtsx(rows, `logic-group:${group?.groupId || state.groupIndex}`, `${group?.label || '当前学习节'} · 配套题`);
      save();
      setStage(queued ? 'ttsx_checkpoint' : 'kp_recall');
    });
    root.querySelector('[data-ttsx-done]')?.addEventListener('click', () => {
      const pending = state.pendingTtsx;
      if (!pending?.key) {
        setStage('kp_recall');
        return;
      }
      state.ttsxEvidence = {
        ...(state.ttsxEvidence || {}),
        [pending.key]: {
          completedAt: new Date().toISOString(),
          annotations: { ...(state.ttsxAnnotations?.[pending.key] || {}) },
          checkpointIds: Array.isArray(pending.checkpointIds) ? [...pending.checkpointIds] : []
        }
      };
      state.pendingTtsx = null;
      save();
      setStage('kp_recall');
    });
    const stageForSelectedGroup = () => {
      if (isPostChatRecall()) return 'kp_recall';
      if (historicalXizongSourceContinuation(state)) return 'kp_recall';
      if (biochemistrySource?.laneSourceHash) return currentGroupSourceCovered() ? 'kp_recall' : 'source_contact';
      if (sourcePerGroup) return 'kp_learn';
      if (segmentedSourceUnits) {
        if (integrationPrimary) ensureIntegrationPrimaryReady();
        const segmentIndex = naturalSegmentIndexForGroup(currentGroup());
        if (segmentIndex >= 0) state.sourceSegmentIndex = segmentIndex;
        return segmentGroupSourceCovered(currentGroup()) ? 'kp_recall' : 'source_contact';
      }
      if (integrationPrimary) {
        ensureIntegrationPrimaryReady();
        return 'kp_recall';
      }
      return state.sourceContactDone ? 'kp_recall' : 'source_contact';
    };
    groupRailButtons.forEach((button, index) => button.addEventListener('click', () => {
      state.groupIndex = index;
      const group = currentGroup();
      if (group) state.kpIndex = firstIndexForGroup(group);
      save();
      switchTab('learn');
      setStage(stageForSelectedGroup());
    }));
    root.querySelectorAll('[data-outline-open]').forEach((button) => button.addEventListener('click', () => {
      state.groupIndex = Number(button.getAttribute('data-outline-open') || 0);
      const group = currentGroup();
      if (group) state.kpIndex = firstIndexForGroup(group);
      save();
      switchTab('learn');
      setStage(stageForSelectedGroup());
    }));

    const stepRecall = (delta) => {
      const ids = currentGroup()?.kpIds || [];
      const currentId = kpData[state.kpIndex]?.kpId || '';
      const position = Math.max(0, ids.indexOf(currentId));
      const nextPosition = Math.max(0, Math.min(ids.length - 1, position + delta));
      const nextIndex = indexForKpId(ids[nextPosition]);
      if (nextIndex >= 0) setKpIndex(nextIndex);
    };
    root.querySelector('[data-recall-prev]')?.addEventListener('click', () => stepRecall(-1));
    root.querySelector('[data-recall-next]')?.addEventListener('click', () => stepRecall(1));
    kpRailButtons.forEach((button, index) => button.addEventListener('click', () => {
      if (groupIndexForKp(index) !== state.groupIndex) return;
      setKpIndex(index);
    }));

    kpRecallCards.forEach((card) => {
      const reveal = card.querySelector('[data-kp-reveal]');
      const answer = card.querySelector('[data-kp-answer]');
      const rating = card.querySelector('[data-kp-rating]');
      reveal?.addEventListener('click', () => { if (answer) answer.hidden = false; if (rating) rating.hidden = false; reveal.hidden = true; });
      card.querySelectorAll('[data-rating]').forEach((button) => button.addEventListener('click', () => {
        const kpId = card.getAttribute('data-kp-id') || '';
        const value = button.getAttribute('data-rating') || '';
        if (root.dataset.xizongStateBlocked === 'true' || root.inert || state.stage !== 'kp_recall' || card.hidden || answer?.hidden !== false || (state.learned?.[kpId] !== true && !isPostChatRecall()) || card.dataset.ratingCommitted === 'true') return;
        if (!['unknown', 'fuzzy', 'known', 'mastered'].includes(value)) return;
        card.dataset.ratingCommitted = 'true';
        revalidateXizongUnit(state, 'KP', kpId);
        state.ratings = { ...(state.ratings || {}), [kpId]: value };
        if (!save()) return;
        card.querySelectorAll('[data-rating]').forEach((candidate) => candidate.classList.toggle('selected', candidate === button));
        syncState();
        const group = currentGroup();
        const ids = Array.isArray(group?.kpIds) ? group.kpIds : [];
        const firstMissingId = ids.find((id) => (!state.ratings?.[id] || needsFreshKpRecall(state, id)));
        if (firstMissingId) {
          const nextIndex = indexForKpId(firstMissingId);
          if (nextIndex >= 0) window.setTimeout(() => setKpIndex(nextIndex), 120);
        } else if (segmentedSourceUnits) {
          window.setTimeout(() => {
            const nextStage = applyNaturalStep(nextNaturalStepAfterGroup(group));
            save();
            setStage(nextStage);
          }, 120);
        } else if (state.groupIndex < groups.length - 1) {
          window.setTimeout(() => {
            state.groupIndex += 1;
            const nextGroup = currentGroup();
            state.kpIndex = firstIndexForGroup(nextGroup);
            save();
            setStage(stageForSelectedGroup());
          }, 120);
        } else {
          window.setTimeout(() => {
            const visualBlockedIndex = firstBlockingVisualGroupIndex();
            if (visualBlockedIndex >= 0) {
              const blockedGroup = groups[visualBlockedIndex];
              state.groupIndex = visualBlockedIndex;
              state.kpIndex = firstIndexForGroup(blockedGroup);
              const segmentIndex = naturalSegmentIndexForGroup(blockedGroup);
              if (segmentIndex >= 0) state.sourceSegmentIndex = segmentIndex;
              save();
              setStage(groupVisualGapReviewableFromOriginalSource(blockedGroup) ? 'source_contact' : 'kp_recall');
              if (statusLabel) statusLabel.textContent = groupVisualGapReviewableFromOriginalSource(blockedGroup)
                ? `回原讲义核对原图 · ${blockedGroup?.label || '当前学习节'}`
                : `原图门禁未闭合 · ${blockedGroup?.label || '当前学习节'}`;
            } else setStage('block_recall');
          }, 120);
        }
      }));
    });

    root.querySelector('[data-block-recall-complete]')?.addEventListener('click', (event) => {
      if (!blockRecallReady() || root.querySelector('[data-block-recall-answer]')?.hidden !== false) return;
      for (const group of groups) { if (!currentGroupClaim(state, group.groupId)) revalidateXizongUnit(state, 'GROUP', group.groupId); }
      revalidateXizongUnit(state, 'BLOCK', objectId);
      if (!state.blockRecallDone) {
        state.blockRecallDone = true;
        state.blockRecallCompletedAt = new Date().toISOString();
      }
      event.currentTarget.textContent = '整块回忆已完成';
      event.currentTarget.classList.add('completed');
      save();
      syncState();
    });
    root.querySelector('[data-block-complete]')?.addEventListener('click', (event) => {
      if (!canComplete()) return;
      if (!state.completed) {
        state.completed = true;
        state.completedAt = new Date().toISOString();
      }
      event.currentTarget.textContent = '本块第一轮已完成';
      const persisted = save();
      syncState();
      if (persisted) {
        window.dispatchEvent(new CustomEvent('kianos:xizong-block-complete', {
          detail: {
            object_id: objectId,
            block_id: root.dataset.studyBlockId || '',
            source_hash: currentSourceHash
          }
        }));
      }
    });

    const setCollapsed = (kind, collapsed) => {
      layout?.classList.toggle(`${kind}-collapsed`, collapsed);
      root.querySelector(kind === 'outline' ? '[data-toggle-outline]' : '[data-toggle-chain]')?.setAttribute('aria-pressed', String(collapsed));
      try { sessionStorage.setItem(`kianos-xizong-layout:${objectId}:${kind}`, String(collapsed)); } catch {}
    };
    ['outline', 'chain'].forEach((kind) => {
      let collapsed = false; try { collapsed = sessionStorage.getItem(`kianos-xizong-layout:${objectId}:${kind}`) === 'true'; } catch {}
      setCollapsed(kind, collapsed);
      root.querySelector(kind === 'outline' ? '[data-toggle-outline]' : '[data-toggle-chain]')?.addEventListener('click', () => setCollapsed(kind, !layout?.classList.contains(`${kind}-collapsed`)));
    });

    root.addEventListener('kianos:xizong-kp-focused', (event) => {
      const kpId = event instanceof CustomEvent ? String(event.detail?.kpId || '') : '';
      if (!kpId || root.dataset.xizongStateBlocked === 'true' || root.inert) return;
      const index = indexForKpId(kpId);
      if (index < 0) return;
      state.kpIndex = index;
      state.groupIndex = groupIndexForKp(index);
      save();
      syncState();
    });

    root.addEventListener('kianos:xizong-kp-learned', (event) => {
      const kpId = event instanceof CustomEvent ? String(event.detail?.kpId || '') : '';
      if (!kpId) return;
      const index = indexForKpId(kpId);
      if (index < 0) return;
      state.learned = { ...(state.learned || {}), [kpId]: true };
      state.kpIndex = index;
      state.groupIndex = groupIndexForKp(index);
      save();
      syncState();
    });

    const blockRecallReveal = root.querySelector('[data-block-recall-reveal]');
    const blockRecallAnswer = root.querySelector('[data-block-recall-answer]');
    const blockRecallComplete = root.querySelector('[data-block-recall-complete]');
    blockRecallReveal?.addEventListener('click', () => {
      if (!blockRecallReady()) return;
      if (blockRecallAnswer) blockRecallAnswer.hidden = false;
      blockRecallReveal.hidden = true;
      if (blockRecallComplete) blockRecallComplete.disabled = false;
    });

    document.addEventListener('keydown', (event) => {
      const target = event.target;
      if (target instanceof HTMLElement && target.closest('input,textarea,select,button,a,[contenteditable="true"]')) return;
      if (root.dataset.xizongStateBlocked === 'true' || root.inert || state.stage !== 'kp_recall' || event.repeat) return;
      if (event.key === 'ArrowLeft') { event.preventDefault(); stepRecall(-1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); stepRecall(1); }
      if (event.code === 'Space') {
        event.preventDefault();
        const card = kpRecallCards[state.kpIndex];
        if (card?.querySelector('[data-kp-answer]')?.hidden === false) resetRecallCard(card);
        else card?.querySelector('[data-kp-reveal]')?.click();
      }
      if (/^[1-4]$/.test(event.key)) {
        const values = ['unknown', 'fuzzy', 'known', 'mastered'];
        kpRecallCards[state.kpIndex]?.querySelector(`[data-rating="${values[Number(event.key) - 1]}"]`)?.click();
      }
    });

    reconcileIntegrationTargetedState();
    if (syncBiochemistrySource()) save();
    if (biochemistryLedgerKey) {
      window.addEventListener('storage', (event) => {
        if (event.key !== biochemistryLedgerKey) return;
        if (syncBiochemistrySource()) save();
        normalizeLegacyStage();
        setStage(state.stage || 'block_learn');
        syncState();
      });
    }
    normalizeLegacyStage();
    kpRecallCards.forEach((card) => { const value = state.ratings?.[card.getAttribute('data-kp-id') || '']; if (value) card.querySelector(`[data-rating="${value}"]`)?.classList.add('selected'); });
    {
      const button = root.querySelector('[data-block-recall-complete]');
      if (button) {
        button.textContent = state.blockRecallDone ? '整块回忆已完成' : '完成整块回忆';
        button.classList.toggle('completed', state.blockRecallDone === true);
        if (!state.blockRecallDone) button.disabled = true;
      }
    }
    setKpIndex(state.kpIndex || 0); setStage(state.stage || 'block_learn'); syncState();
   })();
  }

});
</script>

<script>
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(() => {

  (() => {
    const root = document.querySelector('[data-xizong-v6-block]');
    if (!(root instanceof HTMLElement)) return;
    const openButton = root.querySelector('[data-block-framework-preview-open]');
    const dialog = root.querySelector('[data-block-framework-dialog]');
    const dialogBody = root.querySelector('[data-block-framework-dialog-body]');
    const closeButton = root.querySelector('[data-block-framework-preview-close]');
    if (!(dialog instanceof HTMLDialogElement) || !(dialogBody instanceof HTMLElement)) return;

    const renderPreview = () => {
      if (dialogBody.childElementCount) return;
      const source = root.querySelector('[data-study-stage="block_learn"]');
      if (!(source instanceof HTMLElement)) return;
      const clone = source.cloneNode(true);
      if (!(clone instanceof HTMLElement)) return;
      clone.removeAttribute('data-study-stage');
      clone.removeAttribute('hidden');
      clone.classList.add('xzBlockFrameworkPreviewContent');
      clone.querySelector('.portedStudyStageAction')?.remove();
      clone.querySelectorAll('[id]').forEach((node) => node.removeAttribute('id'));
      clone.querySelectorAll('button,input,textarea,select').forEach((node) => node.remove());
      dialogBody.append(clone);
    };

    openButton?.addEventListener('click', () => {
      renderPreview();
      if (!dialog.open) dialog.showModal();
    });
    closeButton?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  })();

  });
</script>

