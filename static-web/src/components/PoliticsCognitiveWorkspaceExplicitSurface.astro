---
import PoliticsExplicitSurfacePlan from './PoliticsExplicitSurfacePlan.astro';
const { compiled = null } = Astro.props;
const rows = compiled instanceof Map
  ? [...compiled.values()]
      .filter((row) => row?.surfacePlan?.states?.ORIENT?.length)
      .map((row) => ({
        unitId: row.unitId,
        orientMain: row.surfacePlan.states.ORIENT.filter((group) => ['PRIMARY', 'SUPPORT'].includes(group.zone)),
        orientCompanion: row.surfacePlan.states.ORIENT.filter((group) => group.zone === 'COMPANION'),
        external: row.surfacePlan.states.EXTERNAL_LEARN || [],
        close: row.surfacePlan.states.CLOSE || [],
        repair: row.surfacePlan.states.REPAIR || [],
        continueGroups: row.surfacePlan.states.CONTINUE || []
      }))
  : [];
---

{rows.map((row) => (
  <>
    <template data-explicit-workspace-unit={row.unitId} data-explicit-workspace-slot="ORIENT_MAIN">
      <PoliticsExplicitSurfacePlan groups={row.orientMain} />
    </template>
    <template data-explicit-workspace-unit={row.unitId} data-explicit-workspace-slot="ORIENT_COMPANION">
      <PoliticsExplicitSurfacePlan groups={row.orientCompanion} />
    </template>
    {row.external.length > 0 && (
      <template data-explicit-workspace-unit={row.unitId} data-explicit-workspace-slot="EXTERNAL_LEARN">
        <PoliticsExplicitSurfacePlan groups={row.external} />
      </template>
    )}
    {row.close.length > 0 && (
      <template data-explicit-workspace-unit={row.unitId} data-explicit-workspace-slot="CLOSE">
        <PoliticsExplicitSurfacePlan groups={row.close} />
      </template>
    )}
    {row.repair.length > 0 && (
      <template data-explicit-workspace-unit={row.unitId} data-explicit-workspace-slot="REPAIR">
        <PoliticsExplicitSurfacePlan groups={row.repair} />
      </template>
    )}
    {row.continueGroups.length > 0 && (
      <template data-explicit-workspace-unit={row.unitId} data-explicit-workspace-slot="CONTINUE">
        <PoliticsExplicitSurfacePlan groups={row.continueGroups} />
      </template>
    )}
  </>
))}

<script is:inline>
  (() => {
    const workspace = document.querySelector('[data-politics-cognitive-workspace]');
    if (!workspace) return;

    const clonePlan = (unitId, slot) => {
      const template = document.querySelector(`template[data-explicit-workspace-unit="${CSS.escape(unitId)}"][data-explicit-workspace-slot="${slot}"]`);
      return template instanceof HTMLTemplateElement ? template.content.cloneNode(true) : null;
    };

    workspace.querySelectorAll('[data-workspace-unit][data-unit-id]').forEach((unit) => {
      const unitId = unit.getAttribute('data-unit-id');
      if (!unitId) return;

      const orient = unit.querySelector('[data-stage="ORIENT"]');
      const orientMain = clonePlan(unitId, 'ORIENT_MAIN');
      if (orient && orientMain) {
        orient.querySelectorAll('.mapDeck,.relationStrip,.stageAnchor,.fallbackOrientation,.purposeChain,.purposeTextMap').forEach((node) => node.remove());
        orient.querySelectorAll('[data-politics-explicit-surface-plan]').forEach((node) => node.remove());
        const actions = orient.querySelector('.stageActions');
        actions?.before(orientMain);
        unit.setAttribute('data-politics-representation', 'EXPLICIT_SURFACE_MAPPING');
        unit.setAttribute('data-explicit-surface-mapping', 'v1');
      }

      const orientInspector = unit.querySelector('[data-inspector-state="ORIENT"]');
      const companion = clonePlan(unitId, 'ORIENT_COMPANION');
      if (orientInspector) {
        orientInspector.replaceChildren();
        if (companion) orientInspector.appendChild(companion);
        else {
          const quiet = document.createElement('p');
          quiet.className = 'explicitQuietCompanion';
          quiet.textContent = '当前没有需要同时占用注意力的补充。';
          orientInspector.appendChild(quiet);
        }
      }

      const external = unit.querySelector('[data-stage="EXTERNAL_LEARN"]');
      const externalPlan = clonePlan(unitId, 'EXTERNAL_LEARN');
      if (external && externalPlan) {
        external.querySelectorAll('.externalFocus,.compactMap,[data-politics-explicit-surface-plan]').forEach((node) => node.remove());
        const actions = external.querySelector('.stageActions');
        actions?.before(externalPlan);
      }
      const externalInspector = unit.querySelector('[data-inspector-state="EXTERNAL_LEARN"]');
      if (externalInspector) {
        externalInspector.replaceChildren();
        const p = document.createElement('p');
        p.className = 'explicitQuietCompanion';
        p.textContent = '连续学习在 iPad / MarginNote；这里不复制第二份讲义。';
        externalInspector.appendChild(p);
      }

      const repairPanel = unit.querySelector('[data-inspector-state="REPAIR"]');
      const repairPlan = clonePlan(unitId, 'REPAIR');
      if (repairPanel && repairPlan) {
        const slot = repairPanel.querySelector('[data-workspace-repair-slot]');
        slot?.before(repairPlan);
      }

      const close = unit.querySelector('[data-stage="CLOSE"]');
      const closePlan = clonePlan(unitId, 'CLOSE');
      const continuePlan = clonePlan(unitId, 'CONTINUE');
      if (close && (closePlan || continuePlan)) {
        close.querySelectorAll('.closeAnchors,.nextBridge,[data-politics-explicit-surface-plan]').forEach((node) => node.remove());
        const actions = close.querySelector('.stageActions');
        if (closePlan) actions?.before(closePlan);
        if (continuePlan) actions?.before(continuePlan);
      }
      const closeInspector = unit.querySelector('[data-inspector-state="CLOSE"]');
      if (closeInspector) {
        closeInspector.replaceChildren();
        const p = document.createElement('p');
        p.className = 'explicitQuietCompanion';
        p.textContent = '收口内容已由当前 Surface Mapping 放回主舞台。';
        closeInspector.appendChild(p);
      }
    });
  })();
</script>

<style is:global>
  .politicsCognitiveWorkspace [data-explicit-surface-mapping="v1"] .explicitQuietCompanion{
    margin:0;
    color:#667870;
    font-size:15px;
    line-height:1.65;
  }
</style>
