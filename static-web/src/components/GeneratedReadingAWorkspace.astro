---
const base=import.meta.env.BASE_URL;
---
<section class="portedReadingSession portedReadingSessionV3" data-local-port="reading" data-generated-reading-a data-reading-base={base} data-reading-answers-ready="false" hidden>
  <script type="application/json" data-english-task-snapshot set:html={JSON.stringify({})}></script>
  <header class="portedReadingSessionHeader">
    <a href={`${base}english/`}>‹ English</a>
    <div class="portedReadingHeaderCenter">
      <span>Reading A · Targeted</span>
      <b data-generated-reading-title>Chat-generated Reading A</b>
      <small data-reading-progress>Loading…</small>
      <small data-reading-timer>00:00</small>
    </div>
    <div class="portedReadingHeaderActions">
      <button type="button" data-reading-prev aria-label="上一题">‹</button>
      <button type="button" data-reading-next aria-label="下一题">›</button>
      <button type="button" class="submit" data-reading-submit>Submit</button>
      <button type="button" data-reading-retry hidden>再做一轮</button>
      <button type="button" data-reading-reset>重置</button>
    </div>
  </header>
  <nav class="portedReadingQuestionNav" aria-label="Question navigation" data-generated-reading-nav></nav>
  <section class="portedReadingResultBar" data-reading-result hidden>
    <div class="portedReadingResultMain"><span>Result</span><strong data-reading-score></strong><small data-reading-result-meta>Chat-generated · not true-paper calibration</small></div>
    <div class="portedReadingResultSummary"><b data-reading-summary></b><div data-reading-review-nav></div><small>本次只形成对应 Reading-A 训练证据；不自动生成复习债或稳定性结论。</small></div>
  </section>
  <div class="portedReadingColumns">
    <article class="portedReadingPassage" data-reading-passage>
      <div class="portedReadingAnnotate" role="toolbar" aria-label="Reading annotation"><span>标记 · 可选</span><button type="button" data-reading-highlight disabled>高亮选区</button><button type="button" data-reading-clear-highlight disabled>清除</button><small data-reading-selection>选中文字后可高亮</small></div>
      <header><span>CHAT-GENERATED · READING A</span><h2 data-generated-reading-passage-title></h2></header>
      <div data-generated-reading-paragraphs></div>
    </article>
    <aside class="portedReadingQuestions" aria-live="polite"><div data-generated-reading-questions></div><footer class="portedReadingQuestionFooter"><span>← / → 切题 · A–D 选择 · U uncertain</span><strong data-reading-session-count>0 / 0 answered</strong></footer></aside>
  </div>
  <details class="portedReadingHistory" data-reading-history><summary>本机记录 <span data-reading-history-count>0</span></summary><ol data-reading-history-list><li>还没有提交记录。</li></ol><button type="button" data-reading-clear-history>清空本机记录</button></details>
</section>
<p data-generated-reading-error hidden></p>

<script>
  import {preserveEnglishFailure} from '../lib/englishLearnerEvidence.mjs';
  import {initReadingRuntime} from '../lib/readingRuntime.mjs';
  import {learnerWriterReady} from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(async()=>{
    const root=document.querySelector('[data-generated-reading-a]');
    const errorNode=document.querySelector('[data-generated-reading-error]');
    if(!(root instanceof HTMLElement))return;
    const base=root.getAttribute('data-reading-base')||'/';
    const id=new URLSearchParams(location.search).get('id')||'';
    const endpoint=path=>`${base}__kianos-private/english-generated/${path}`;
    const fetchJson=async url=>{
      const response=await fetch(url,{cache:'no-store'});
      const data=await response.json().catch(()=>({status:'error',error:'Generated material response is not JSON.'}));
      if(!response.ok||data.status==='error')throw new Error(data.error||data.status||`HTTP ${response.status}`);
      return data;
    };
    const showError=error=>{
      if(errorNode instanceof HTMLElement){errorNode.hidden=false;errorNode.textContent=String(error?.message||error);}
      preserveEnglishFailure(root,error);
    };
    if(!id){showError(new Error('ENGLISH_GENERATED_READING_ID_REQUIRED'));return;}
    root.dataset.readingObject=id;
    try{
      const payload=await fetchJson(endpoint('material?id='+encodeURIComponent(id)));
      const material=payload.material;
      if(material?.generated_task!=='reading_a'||material?.question_origin!=='CHAT_GENERATED')throw new Error('ENGLISH_GENERATED_READING_TASK_MISMATCH');
      const questions=Array.isArray(material.questions)?material.questions:[];
      if(questions.length<1||questions.some(q=>q.response_kind!=='single_choice'||!q.question_id))throw new Error('ENGLISH_GENERATED_READING_QUESTIONS_INVALID');
      root.dataset.englishSourceHash=material.content_hash||'';
      const snapshot={
        evidence:{source_kind:'generated',evidence_role:material.evidence_role||null,semantic_source_hash:material.content_hash||null,
          transfer_independence:material.transfer_independence||null,calibration_status:material.calibration_status||'NOT_SCORE_EQUIVALENT'},
        question_origin:'CHAT_GENERATED',completion_requirement:material.completion_requirement||'QUESTIONS_SUBMITTED',training_target:material.training_target||null,
        paragraphs:(material.passage_paragraphs||[]).map((text,index)=>({id:`${id}-p${index+1}`,text:String(text||'')})),
        questions:questions.map(q=>({id:q.question_id,ordinal:q.ordinal,prompt:q.prompt,options:q.options}))
      };
      const snapshotNode=root.querySelector('[data-english-task-snapshot]');if(snapshotNode)snapshotNode.textContent=JSON.stringify(snapshot);
      const title=material.title||id;
      root.querySelector('[data-generated-reading-title]').textContent=title;
      root.querySelector('[data-generated-reading-passage-title]').textContent=title;
      const paragraphHost=root.querySelector('[data-generated-reading-paragraphs]');paragraphHost.innerHTML='';
      snapshot.paragraphs.forEach(row=>{const p=document.createElement('p');p.id=row.id;p.textContent=row.text;paragraphHost.appendChild(p);});
      const nav=root.querySelector('[data-generated-reading-nav]');const host=root.querySelector('[data-generated-reading-questions]');nav.innerHTML='';host.innerHTML='';
      questions.forEach((q,index)=>{
        const navButton=document.createElement('button');navButton.type='button';navButton.dataset.target=q.question_id;navButton.textContent=`Q${q.ordinal||index+1}`;if(index===0)navButton.classList.add('active');nav.appendChild(navButton);
        const section=document.createElement('section');section.className=`portedReadingQuestion ${index===0?'is-current':''}`;section.dataset.question=q.question_id;section.dataset.index=String(index);
        section.innerHTML='<header><span></span><button type="button" class="portedUncertain" aria-pressed="false">Uncertain</button></header><p></p><div class="portedReadingOptions"></div><div class="portedReadingAnswerStrip" data-reading-answer-strip hidden><span>你的答案 <b data-reading-your-answer>—</b></span><span>正式答案 <b data-reading-formal-answer>—</b></span></div><section class="portedReadingRepair" data-reading-repair hidden><header><div><span>只处理这道</span><strong data-reading-repair-title></strong></div><small>错因可选，一点即可</small></header><div class="portedReadingCauseRow" aria-label="Quick cause"><button type="button" data-cause="没读懂">没读懂</button><button type="button" data-cause="没定位准">没定位准</button><button type="button" data-cause="选项没辨清">选项没辨清</button><button type="button" data-cause="看错/改错">看错 / 改错</button></div><div class="portedReadingRepairActions"><button type="button" data-reading-copy-chat>复制给 Chat</button><small data-reading-copy-status>需要深挖时再用，不必每题都分析。</small></div></section>';
        section.querySelector('header span').textContent=`Question ${q.ordinal||index+1}`;section.querySelector(':scope > p').textContent=q.prompt;
        const options=section.querySelector('.portedReadingOptions');
        for(const [label,text] of Object.entries(q.options||{})){const option=document.createElement('button');option.type='button';option.dataset.option=label;option.innerHTML='<b></b><span></span>';option.querySelector('b').textContent=label;option.querySelector('span').textContent=text;options.appendChild(option);}
        host.appendChild(section);
      });
      const count=root.querySelector('[data-reading-session-count]');if(count)count.textContent=`0 / ${questions.length} answered`;
      localStorage.setItem('kianos-reading-last-location-v1',JSON.stringify({id,title,href:`${base}reading-generated/?id=${encodeURIComponent(id)}`,updatedAt:new Date().toISOString()}));
      root.dataset.readingMaterialReady='true';
      initReadingRuntime(root);
      root.hidden=false;
      root.dispatchEvent(new CustomEvent('kianos:reading-material-ready',{bubbles:true}));
    }catch(error){showError(error);}
  });
</script>
