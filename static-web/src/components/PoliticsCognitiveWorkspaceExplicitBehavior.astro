<script is:inline>
window.__kianosLearnerWriterReady.then(() => {

  (() => {
    const workspace = document.querySelector('[data-politics-cognitive-workspace]');
    if (!workspace) return;
    workspace.classList.add('directReasoningWorkspace', 'explicitSurfaceWorkspace');

    const setWorkspaceState = (unit, state) => {
      if (!unit) return;
      const visibleStage = state === 'REPAIR' ? 'VERIFY' : state;
      unit.dataset.state = state;
      unit.querySelectorAll('[data-stage]').forEach((scene) => {
        scene.hidden = scene.getAttribute('data-stage') !== visibleStage;
      });
      unit.querySelectorAll('[data-inspector-state]').forEach((panel) => {
        panel.hidden = panel.getAttribute('data-inspector-state') !== state;
      });
      try {
        const key = `kianos-politics-workspace-v1:${workspace.dataset.subject || ''}:${workspace.dataset.chapter || ''}`;
        const saved = JSON.parse(localStorage.getItem(key) || '{}');
        const states = { ...(saved.states || {}), [unit.dataset.unitId || '']: state };
        localStorage.setItem(key, JSON.stringify({ ...saved, states, observed_at: new Date().toISOString() }));
      } catch {}
    };

    const chapterContext = workspace.querySelector('.chapterContext');
    if (chapterContext) {
      const firstRow = chapterContext.querySelector(':scope > div:first-child');
      const chain = chapterContext.querySelector('.chapterContextChain');
      if (firstRow && chain && !firstRow.querySelector('.chapterContextToggle')) {
        const toggle = document.createElement('button');
        toggle.type = 'button';
        toggle.className = 'chapterContextToggle';
        toggle.textContent = '章地图 +';
        firstRow.appendChild(toggle);
        toggle.addEventListener('click', () => {
          const expanded = chapterContext.classList.toggle('expanded');
          toggle.textContent = expanded ? '章地图 −' : '章地图 +';
        });
      }
    }

    // Optional close remains optional. The base workspace owns the state machine;
    // this enhancer only changes the learner choice, never content composition.
    workspace.querySelectorAll('[data-workspace-action="learn-done"]').forEach((button) => {
      const unit = button.closest('[data-workspace-unit]');
      if (!unit) return;
      button.setAttribute('data-workspace-action', 'learn-fastpath');
      button.textContent = '直接进入肖1000 →';

      const recallButton = document.createElement('button');
      recallButton.type = 'button';
      recallButton.className = 'secondaryAction';
      recallButton.setAttribute('data-workspace-score-recall', 'optional');
      recallButton.textContent = '20 秒闭卷收口（可选）';
      button.before(recallButton);

      recallButton.addEventListener('click', () => setWorkspaceState(unit, 'RECALL'));
      button.addEventListener('click', () => {
        const href = unit.dataset.practiceHref || unit.querySelector('[data-workspace-practice-link]')?.getAttribute('href');
        if (href) window.location.assign(href);
        else setWorkspaceState(unit, 'VERIFY');
      });
    });

    workspace.addEventListener('politics:resume-state', (event) => {
      const unit = event.target?.closest?.('[data-workspace-unit]');
      const state = event.detail?.state;
      if (unit && state) setWorkspaceState(unit, state);
    });

    workspace.addEventListener('click', (event) => {
      const link = event.target?.closest?.('a[href^="#source-"]');
      if (!link || !workspace.contains(link)) return;
      const unit = link.closest('[data-workspace-unit]');
      if (!unit) return;
      event.preventDefault();
      setWorkspaceState(unit, 'EXTERNAL_LEARN');
      requestAnimationFrame(() => unit.querySelector('[data-stage="EXTERNAL_LEARN"]')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' }));
    });
  })();

});
</script>

<style is:global>
