  .politicsCognitiveWorkspace.explicitSurfaceWorkspace .workspaceBar{grid-template-columns:minmax(260px,.9fr) minmax(520px,1.8fr);min-height:54px;padding:7px 14px;box-shadow:0 5px 18px rgba(22,31,27,.035)}
  .politicsCognitiveWorkspace.explicitSurfaceWorkspace .workspaceState{display:none}
  .politicsCognitiveWorkspace.explicitSurfaceWorkspace .workspaceLocation>a,
  .politicsCognitiveWorkspace.explicitSurfaceWorkspace .workspaceLocation>span,
  .politicsCognitiveWorkspace.explicitSurfaceWorkspace .workspaceLocation>strong{flex:0 0 auto;white-space:nowrap}
  .politicsCognitiveWorkspace.explicitSurfaceWorkspace .workspaceLocation>b{flex:1 1 auto;min-width:0}
  .politicsCognitiveWorkspace.explicitSurfaceWorkspace .chapterContext{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:14px;min-height:44px;padding:8px 16px;border:1px solid var(--study-line);border-radius:10px;background:#fbfcfb}
  .politicsCognitiveWorkspace.explicitSurfaceWorkspace .chapterContext>div:first-child{display:flex;align-items:center;gap:10px;min-width:0}
  .politicsCognitiveWorkspace.explicitSurfaceWorkspace .chapterContextChain{display:none;grid-column:1/-1;gap:6px;padding:3px 0 7px 72px}
  .politicsCognitiveWorkspace.explicitSurfaceWorkspace .chapterContext.expanded .chapterContextChain{display:grid}
  .politicsCognitiveWorkspace.explicitSurfaceWorkspace .chapterContextToggle{border:0;background:transparent;color:#54756a;cursor:pointer;font:inherit;font-size:14px;font-weight:760}
  .politicsCognitiveWorkspace.explicitSurfaceWorkspace .workspaceUnit{grid-template-columns:minmax(0,1fr) minmax(270px,22%);min-height:calc(100vh - 205px)}
  .politicsCognitiveWorkspace.explicitSurfaceWorkspace .cognitiveStage{padding:24px 30px 30px}
  .politicsCognitiveWorkspace.explicitSurfaceWorkspace .contextualInspector{padding:22px 18px}
  .politicsCognitiveWorkspace.explicitSurfaceWorkspace .stageScene{min-height:calc(100vh - 292px)}
  .politicsCognitiveWorkspace.explicitSurfaceWorkspace .stageScene>h2{max-width:44ch;margin:4px 0 16px;font-size:clamp(31px,2.45vw,39px);line-height:1.22;letter-spacing:-.015em}
  .politicsCognitiveWorkspace.explicitSurfaceWorkspace .stageBridge{max-width:74ch;margin:0 0 8px;color:#65756f;font-size:16px;line-height:1.62}
