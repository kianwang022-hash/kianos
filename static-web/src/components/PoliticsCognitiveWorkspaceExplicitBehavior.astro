  .politicsCognitiveWorkspace.explicitSurfaceWorkspace .stageActions{padding-top:16px}
  @media(max-width:980px){
    .politicsCognitiveWorkspace.explicitSurfaceWorkspace .workspaceBar{grid-template-columns:1fr}
    .politicsCognitiveWorkspace.explicitSurfaceWorkspace .workspaceUnit{grid-template-columns:1fr;min-height:auto}
    .politicsCognitiveWorkspace.explicitSurfaceWorkspace .stageScene{min-height:auto}
    .politicsCognitiveWorkspace.explicitSurfaceWorkspace .chapterContext{grid-template-columns:1fr}
    .politicsCognitiveWorkspace.explicitSurfaceWorkspace .chapterContextChain{padding-left:0}
  }
</style>
