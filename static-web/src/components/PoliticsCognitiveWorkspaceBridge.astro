<style is:global>
  .politicsCognitiveWorkspace.directReasoningWorkspace{gap:8px}
  .politicsCognitiveWorkspace.directReasoningWorkspace .chapterContext{display:none}
  .politicsCognitiveWorkspace.directReasoningWorkspace .workspaceBar{grid-template-columns:minmax(220px,1fr) minmax(440px,1.55fr);min-height:56px;padding:8px 14px;box-shadow:0 5px 18px rgba(22,31,27,.035)}
  .politicsCognitiveWorkspace.directReasoningWorkspace .workspaceState{display:none}
  .politicsCognitiveWorkspace.directReasoningWorkspace .workspaceUnit{grid-template-columns:minmax(0,1fr) minmax(290px,23%);min-height:calc(100vh - 190px)}
  .politicsCognitiveWorkspace.directReasoningWorkspace .cognitiveStage{padding:28px 34px 34px}
  .politicsCognitiveWorkspace.directReasoningWorkspace .contextualInspector{padding:24px 20px}
  .politicsCognitiveWorkspace.directReasoningWorkspace .contextualInspector [data-inspector-state]>header>span{display:none}
  .politicsCognitiveWorkspace.directReasoningWorkspace .contextualInspector [data-inspector-state]>header>strong{font-size:15px;line-height:1.4}
  .politicsCognitiveWorkspace.directReasoningWorkspace .stageScene{min-height:calc(100vh - 275px)}
  .politicsCognitiveWorkspace.directReasoningWorkspace .stageScene>h2{max-width:38ch;margin-bottom:18px;font-size:clamp(28px,2.25vw,35px);line-height:1.22}
  .politicsCognitiveWorkspace.directReasoningWorkspace .mapDeck{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(430px,100%),1fr));gap:22px;align-items:start}
  .politicsCognitiveWorkspace.directReasoningWorkspace .mapTabs{display:none!important}
  .politicsCognitiveWorkspace.directReasoningWorkspace .semanticMap{display:grid!important;gap:12px;padding-top:14px;border-top:1px solid var(--study-line)}
  .politicsCognitiveWorkspace.directReasoningWorkspace .semanticMap[hidden]{display:grid!important}
  .politicsCognitiveWorkspace.directReasoningWorkspace .semanticMap>header{display:grid;gap:3px}
  .politicsCognitiveWorkspace.directReasoningWorkspace .semanticMap>header>span{display:none}
  .politicsCognitiveWorkspace.directReasoningWorkspace .semanticMap>header strong{font-size:16px;line-height:1.45}

  .politicsCognitiveWorkspace.directReasoningWorkspace .directRelationField{display:grid;grid-template-columns:1fr;gap:0;margin-top:2px;border-top:1px solid #edf0ee;border-bottom:1px solid #edf0ee}
  .politicsCognitiveWorkspace.directReasoningWorkspace .directRelationField>div{display:grid;grid-template-columns:minmax(92px,.85fr) 18px minmax(150px,1.35fr) 18px minmax(92px,.85fr);align-items:center;gap:7px;padding:10px 2px;border-radius:0;background:transparent}
  .politicsCognitiveWorkspace.directReasoningWorkspace .directRelationField>div+div{border-top:1px solid #f0f2f1}
  .politicsCognitiveWorkspace.directReasoningWorkspace .directRelationField span{font-size:13.5px;line-height:1.45;font-weight:760}
  .politicsCognitiveWorkspace.directReasoningWorkspace .directRelationField i{color:var(--study-green);font-size:14px}
  .politicsCognitiveWorkspace.directReasoningWorkspace .directRelationField small{color:#436b5d;font-size:12.5px;line-height:1.45;font-weight:650}

  .politicsCognitiveWorkspace.directReasoningWorkspace .mapNodeGlossary{margin-top:2px;border:0}
  .politicsCognitiveWorkspace.directReasoningWorkspace .mapNodeGlossary>summary{width:max-content;cursor:pointer;color:var(--study-muted);font-size:13px;font-weight:720;list-style:none}
  .politicsCognitiveWorkspace.directReasoningWorkspace .mapNodeGlossary>summary::-webkit-details-marker{display:none}
  .politicsCognitiveWorkspace.directReasoningWorkspace .mapNodeGlossary>summary::after{content:'  +';color:var(--study-green)}
  .politicsCognitiveWorkspace.directReasoningWorkspace .mapNodeGlossary[open]>summary::after{content:'  −'}
  .politicsCognitiveWorkspace.directReasoningWorkspace .mapNodeGlossary .semanticMapNodes{grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px;margin-top:10px}
  .politicsCognitiveWorkspace.directReasoningWorkspace .mapNodeGlossary .semanticMapNodes article{min-height:auto;padding:9px 4px 9px 12px;border:0;border-left:3px solid #c5d8d1;background:transparent}
  .politicsCognitiveWorkspace.directReasoningWorkspace .mapNodeGlossary .semanticMapNodes b{font-size:14.5px;line-height:1.4}
  .politicsCognitiveWorkspace.directReasoningWorkspace .mapNodeGlossary .semanticMapNodes p{margin:5px 0 0;color:var(--study-muted);font-size:13px;line-height:1.58}

  .politicsCognitiveWorkspace.directReasoningWorkspace .nodeDeepening{margin-top:14px;padding-top:11px;border:0;border-top:1px solid var(--study-line)}
  .politicsCognitiveWorkspace.directReasoningWorkspace .nodeDeepening>summary{cursor:pointer;color:#45695d;font-size:13px;font-weight:760;list-style:none}
  .politicsCognitiveWorkspace.directReasoningWorkspace .nodeDeepening>summary::-webkit-details-marker{display:none}
  .politicsCognitiveWorkspace.directReasoningWorkspace .nodeDeepening>summary::after{content:'  +';color:var(--study-green)}
  .politicsCognitiveWorkspace.directReasoningWorkspace .nodeDeepening[open]>summary::after{content:'  −'}
  .politicsCognitiveWorkspace.directReasoningWorkspace .nodeDeepening>div{display:flex;align-items:center;gap:8px;overflow:auto;margin-top:10px;padding-bottom:2px}
  .politicsCognitiveWorkspace.directReasoningWorkspace .nodeDeepening b{min-width:max-content;font-size:13px;line-height:1.45;font-weight:720}
  .politicsCognitiveWorkspace.directReasoningWorkspace .nodeDeepening i{color:var(--study-green);font-style:normal}

  .politicsCognitiveWorkspace.directReasoningWorkspace .stageActions{padding-top:20px}
  .politicsCognitiveWorkspace.directReasoningWorkspace .inspectorPrimaryAnchor{margin:18px 0 0!important;padding:10px 0 10px 12px!important;border-left:3px solid var(--study-green)!important;border-radius:0!important;background:transparent!important;color:#315247!important;font-size:14px!important;line-height:1.58!important}
  .politicsCognitiveWorkspace.directReasoningWorkspace .inspectorBlock p strong{font-size:13.5px;line-height:1.45}
  .politicsCognitiveWorkspace.directReasoningWorkspace .inspectorBlock p span{font-size:12.5px;line-height:1.55}
  .politicsCognitiveWorkspace.directReasoningWorkspace .inspectorDetails{font-size:13px;line-height:1.55}
  .politicsCognitiveWorkspace.directReasoningWorkspace .suyiNote{display:none!important}

  @media(max-width:1050px){
    .politicsCognitiveWorkspace.directReasoningWorkspace .workspaceBar{grid-template-columns:1fr}
    .politicsCognitiveWorkspace.directReasoningWorkspace .workspaceUnit{grid-template-columns:1fr;min-height:auto}
    .politicsCognitiveWorkspace.directReasoningWorkspace .stageScene{min-height:auto}
    .politicsCognitiveWorkspace.directReasoningWorkspace .mapDeck{grid-template-columns:1fr}
  }
  @media(max-width:720px){
    .politicsCognitiveWorkspace.directReasoningWorkspace .directRelationField>div{grid-template-columns:1fr;gap:3px;padding:10px 0}
    .politicsCognitiveWorkspace.directReasoningWorkspace .directRelationField i{display:none}
    .politicsCognitiveWorkspace.directReasoningWorkspace .directRelationField small::before{content:'→ ';color:var(--study-green)}
  }
</style>

<script is:inline>
  const workspace = document.querySelector('[data-politics-cognitive-workspace]');

  const setWorkspaceState = (unit, state) => {
    if (!workspace || !unit) return;
    const visibleStage = state === 'REPAIR' ? 'VERIFY' : state;
    unit.dataset.state = state;
    unit.querySelectorAll('[data-stage]').forEach((scene) => {
      scene.hidden = scene.getAttribute('data-stage') !== visibleStage;
    });
    unit.querySelectorAll('[data-inspector-state]').forEach((panel) => {
      panel.hidden = panel.getAttribute('data-inspector-state') !== state;
    });

    const stateLabel = workspace.querySelector('[data-workspace-state-label]');
    if (stateLabel && !unit.hidden) stateLabel.textContent = state;

    try {
      const key = `kianos-politics-workspace-v1:${workspace.dataset.subject || ''}:${workspace.dataset.chapter || ''}`;
      const saved = JSON.parse(localStorage.getItem(key) || '{}');
      const states = { ...(saved.states || {}), [unit.dataset.unitId || '']: state };
      localStorage.setItem(key, JSON.stringify({ ...saved, states, observed_at: new Date().toISOString() }));
    } catch {}
  };

  const promoteDirectRelations = (panel) => {
    const nodeWrap = panel.querySelector('.semanticMapNodes');
    const edgeWrap = panel.querySelector('.semanticEdges');
    const header = panel.querySelector('header');

    if (edgeWrap && header) {
      edgeWrap.classList.add('directRelationField');
      edgeWrap.setAttribute('data-direct-relation-field', '');
      header.after(edgeWrap);
    }

    // The semantic edges are the primary reasoning. Node prose remains available,
    // but it must not compete with the relation that orients the Unit.
    if (nodeWrap && edgeWrap && !nodeWrap.closest('.mapNodeGlossary')) {
      const glossary = document.createElement('details');
      glossary.className = 'mapNodeGlossary';
      const summary = document.createElement('summary');
      summary.textContent = '节点含义';
      glossary.append(summary, nodeWrap);
      edgeWrap.after(glossary);
    }

    panel.classList.add('directReasoningMap');
  };

  const demoteRelationChain = (strip) => {
    const section = strip.querySelector(':scope > section');
    if (!section) return;
    const title = section.querySelector(':scope > span')?.textContent?.trim() || '关系深化';
    const body = section.querySelector(':scope > div');
    if (!body) return;

    const details = document.createElement('details');
    details.className = 'nodeDeepening';
    details.setAttribute('data-node-deepening', '');
    const summary = document.createElement('summary');
    summary.textContent = `再深入 · ${title}`;
    details.append(summary, body);
    strip.replaceWith(details);
  };

  if (workspace) {
    workspace.classList.add('directReasoningWorkspace');

    // Real-use visual rule: core reasoning is primary content, so it is visible by default.
    // Preserve the Map's own topology instead of coercing every Map into one generic Chain.
    workspace.querySelectorAll('[data-map-deck]').forEach((deck) => {
      deck.querySelector('.mapTabs')?.remove();
      deck.querySelectorAll('[data-map-panel]').forEach((panel) => {
        panel.hidden = false;
        panel.classList.add('active');
        promoteDirectRelations(panel);
      });
    });

    // A relation_chain may deepen one node without becoming a third equal-weight mainline.
    workspace.querySelectorAll('[data-stage="ORIENT"] .relationStrip').forEach(demoteRelationChain);

    // Keep the Cognitive Stage lean: durable Anchor stays visible, but in the Inspector.
    workspace.querySelectorAll('[data-workspace-unit]').forEach((unit) => {
      const anchor = unit.querySelector('[data-stage="ORIENT"] .stageAnchor');
      const inspector = unit.querySelector('[data-inspector-state="ORIENT"]');
      if (anchor && inspector) {
        anchor.classList.add('inspectorPrimaryAnchor');
        inspector.appendChild(anchor);
      }

      const verifyTitle = unit.querySelector('[data-inspector-state="VERIFY"] header strong');
      if (verifyTitle) verifyTitle.textContent = '安静作答';
      const closeEyebrow = unit.querySelector('[data-stage="CLOSE"] .stageEyebrow');
      if (closeEyebrow) closeEyebrow.textContent = '本段收口';
    });

    // Shared Functional First resume/repair enhancer can request a canonical workspace state
    // without owning or redefining the C00 state machine.
    workspace.addEventListener('politics:resume-state', (event) => {
      const unit = event.target?.closest?.('[data-workspace-unit]');
      const state = event.detail?.state;
      if (unit && state) setWorkspaceState(unit, state);
    });

    // Score-first fast path: Recall is useful, but it is not a compulsory ritual.
    workspace.querySelectorAll('[data-workspace-action="learn-done"]').forEach((button) => {
      const unit = button.closest('[data-workspace-unit]');
      if (!unit) return;

      button.setAttribute('data-workspace-action', 'learn-fastpath');
      button.textContent = '直接进入肖1000 →';

      const recallButton = document.createElement('button');
      recallButton.type = 'button';
      recallButton.className = 'secondaryAction';
      recallButton.setAttribute('data-workspace-score-recall', 'optional');
      recallButton.textContent = '20 秒闭卷收口（可选）';
      button.before(recallButton);

      recallButton.addEventListener('click', () => setWorkspaceState(unit, 'RECALL'));
      button.addEventListener('click', () => setWorkspaceState(unit, 'VERIFY'));
    });

    workspace.addEventListener('click', (event) => {
      const link = event.target?.closest?.('a[href^="#source-"]');
      if (!link || !workspace.contains(link)) return;
      const unit = link.closest('[data-workspace-unit]');
      if (!unit) return;

      event.preventDefault();
      setWorkspaceState(unit, 'EXTERNAL_LEARN');

      const target = document.querySelector(link.getAttribute('href'));
      requestAnimationFrame(() => target?.scrollIntoView({ behavior: 'smooth', block: 'nearest' }));
    });
  }
</script>