<style is:global>
  .politicsCognitiveWorkspace.directReasoningWorkspace{gap:8px}
  .politicsCognitiveWorkspace.directReasoningWorkspace .workspaceBar{grid-template-columns:minmax(260px,.9fr) minmax(520px,1.8fr);min-height:54px;padding:7px 14px;box-shadow:0 5px 18px rgba(22,31,27,.035)}
  .politicsCognitiveWorkspace.directReasoningWorkspace .workspaceState{display:none}
  .politicsCognitiveWorkspace.directReasoningWorkspace .workspaceLocation>a,
  .politicsCognitiveWorkspace.directReasoningWorkspace .workspaceLocation>span,
  .politicsCognitiveWorkspace.directReasoningWorkspace .workspaceLocation>strong{flex:0 0 auto;white-space:nowrap}
  .politicsCognitiveWorkspace.directReasoningWorkspace .workspaceLocation>b{flex:1 1 auto;min-width:0}

  /* Chapter context stays reachable, but it must not become a second page. */
  .politicsCognitiveWorkspace.directReasoningWorkspace .chapterContext{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:14px;min-height:44px;padding:8px 16px;border:1px solid var(--study-line);border-radius:10px;background:#fbfcfb}
  .politicsCognitiveWorkspace.directReasoningWorkspace .chapterContext>div:first-child{display:flex;align-items:center;gap:10px;min-width:0}
  .politicsCognitiveWorkspace.directReasoningWorkspace .chapterContext>div:first-child>span{flex:0 0 auto;color:var(--study-green);font-size:11px;font-weight:820;letter-spacing:.08em}
  .politicsCognitiveWorkspace.directReasoningWorkspace .chapterContext>div:first-child>strong{overflow:hidden;color:#28483d;font-size:13px;line-height:1.4;text-overflow:ellipsis;white-space:nowrap}
  .politicsCognitiveWorkspace.directReasoningWorkspace .chapterContextToggle{border:0;background:transparent;color:#54756a;cursor:pointer;font:inherit;font-size:12px;font-weight:760}
  .politicsCognitiveWorkspace.directReasoningWorkspace .chapterContextChain{display:none;grid-column:1/-1;gap:6px;padding:3px 0 7px 72px}
  .politicsCognitiveWorkspace.directReasoningWorkspace .chapterContext.expanded .chapterContextChain{display:grid}
  .politicsCognitiveWorkspace.directReasoningWorkspace .chapterContextChain span{position:relative;padding-left:16px;color:#52665f;font-size:12.5px;line-height:1.5}
  .politicsCognitiveWorkspace.directReasoningWorkspace .chapterContextChain span::before{content:'→';position:absolute;left:0;color:var(--study-green);font-weight:800}

  .politicsCognitiveWorkspace.directReasoningWorkspace .workspaceUnit{grid-template-columns:minmax(0,1fr) minmax(270px,22%);min-height:calc(100vh - 205px)}
  .politicsCognitiveWorkspace.directReasoningWorkspace .cognitiveStage{padding:24px 30px 30px}
  .politicsCognitiveWorkspace.directReasoningWorkspace .contextualInspector{padding:22px 18px}
  .politicsCognitiveWorkspace.directReasoningWorkspace .contextualInspector [data-inspector-state]>header>span{display:none}
  .politicsCognitiveWorkspace.directReasoningWorkspace .contextualInspector [data-inspector-state]>header>strong{font-size:14px;line-height:1.4}
  .politicsCognitiveWorkspace.directReasoningWorkspace .stageScene{min-height:calc(100vh - 292px)}
  .politicsCognitiveWorkspace.directReasoningWorkspace .stageScene>h2{max-width:44ch;margin:4px 0 16px;font-size:clamp(25px,2vw,31px);line-height:1.24;letter-spacing:-.015em}
  .politicsCognitiveWorkspace.directReasoningWorkspace .stageBridge{max-width:74ch;margin:0 0 8px;color:#65756f;font-size:13px;line-height:1.55}

  /* The main map is a spatial model, not a list of edge sentences. */
  .politicsCognitiveWorkspace.directReasoningWorkspace .mapDeck{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(390px,100%),1fr));gap:16px;align-items:start}
  .politicsCognitiveWorkspace.directReasoningWorkspace .mapTabs{display:none!important}
  .politicsCognitiveWorkspace.directReasoningWorkspace .semanticMap{display:grid!important;gap:10px;padding:12px 14px 13px;border:1px solid #e5ebe8;border-radius:12px;background:#fff}
  .politicsCognitiveWorkspace.directReasoningWorkspace .semanticMap[hidden]{display:grid!important}
  .politicsCognitiveWorkspace.directReasoningWorkspace .semanticMap>header{display:grid;gap:2px;padding-bottom:8px;border-bottom:1px solid #edf1ef}
  .politicsCognitiveWorkspace.directReasoningWorkspace .semanticMap>header>span{display:none}
  .politicsCognitiveWorkspace.directReasoningWorkspace .semanticMap>header strong{font-size:14px;line-height:1.4;color:#304a41}
  .politicsCognitiveWorkspace.directReasoningWorkspace .semanticMap.goldenized>.semanticEdges{display:none!important}

  .politicsCognitiveWorkspace.directReasoningWorkspace .goldenGraph{--graph-levels:2;display:grid;grid-template-columns:repeat(var(--graph-levels),minmax(0,1fr));gap:28px;align-items:center;min-height:118px;padding:4px 2px 1px}
  .politicsCognitiveWorkspace.directReasoningWorkspace .goldenGraphColumn{position:relative;display:grid;gap:6px;align-content:center;min-width:0}
  .politicsCognitiveWorkspace.directReasoningWorkspace .goldenGraphColumn:not(:last-child)::after{content:'→';position:absolute;right:-22px;top:50%;transform:translateY(-50%);color:#6c9a8a;font-size:18px;font-weight:800}
  .politicsCognitiveWorkspace.directReasoningWorkspace .goldenNode{display:grid;gap:2px;min-width:0;padding:7px 8px 7px 10px;border-left:3px solid #b8d2c8;background:#f9fbfa}
  .politicsCognitiveWorkspace.directReasoningWorkspace .goldenNode b{color:#173f32;font-size:13px;line-height:1.32}
  .politicsCognitiveWorkspace.directReasoningWorkspace .goldenNode p{display:none}
  .politicsCognitiveWorkspace.directReasoningWorkspace .goldenNode small{display:block;margin-top:1px;color:#3f6d5e;font-size:10.5px;line-height:1.35;font-weight:700}
  .politicsCognitiveWorkspace.directReasoningWorkspace .goldenGraphColumn:last-child .goldenNode{border-left-color:var(--study-green);background:#f4f8f6}
  .politicsCognitiveWorkspace.directReasoningWorkspace .goldenCrossEdges{display:grid;gap:4px;margin-top:3px;padding-top:7px;border-top:1px dashed #dfe8e4}
  .politicsCognitiveWorkspace.directReasoningWorkspace .goldenCrossEdges span{color:#4e685f;font-size:10.5px;line-height:1.4}
  .politicsCognitiveWorkspace.directReasoningWorkspace .goldenCrossEdges b{color:#24483c}

  /* Full node explanations remain available, but they do not compete with the map at first glance. */
  .politicsCognitiveWorkspace.directReasoningWorkspace .goldenNodeNotes{margin-top:2px;border:0;border-top:1px solid #edf1ef;padding-top:7px}
  .politicsCognitiveWorkspace.directReasoningWorkspace .goldenNodeNotes>summary{width:max-content;cursor:pointer;color:#63756e;font-size:11.5px;font-weight:720;list-style:none}
  .politicsCognitiveWorkspace.directReasoningWorkspace .goldenNodeNotes>summary::-webkit-details-marker{display:none}
  .politicsCognitiveWorkspace.directReasoningWorkspace .goldenNodeNotes>summary::after{content:'  +';color:var(--study-green)}
  .politicsCognitiveWorkspace.directReasoningWorkspace .goldenNodeNotes[open]>summary::after{content:'  −'}
  .politicsCognitiveWorkspace.directReasoningWorkspace .goldenNodeNotes .semanticMapNodes{grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;margin-top:7px}
  .politicsCognitiveWorkspace.directReasoningWorkspace .goldenNodeNotes .semanticMapNodes article{min-height:auto;padding:7px 4px 7px 9px;border:0;border-left:2px solid #c8d9d2;background:transparent}
  .politicsCognitiveWorkspace.directReasoningWorkspace .goldenNodeNotes .semanticMapNodes b{font-size:11.5px;line-height:1.35}
  .politicsCognitiveWorkspace.directReasoningWorkspace .goldenNodeNotes .semanticMapNodes p{margin:3px 0 0;color:#66756f;font-size:10.5px;line-height:1.45}

  /* Required reasoning stays visible, but below the main map. */
  .politicsCognitiveWorkspace.directReasoningWorkspace .relationStrip{margin-top:12px;padding-top:10px;border-top:1px solid var(--study-line)}
  .politicsCognitiveWorkspace.directReasoningWorkspace .relationStrip>section{display:grid;grid-template-columns:minmax(150px,190px) minmax(0,1fr);gap:12px;align-items:center}
  .politicsCognitiveWorkspace.directReasoningWorkspace .relationStrip>section>span{color:#48675c;font-size:12px;font-weight:780;line-height:1.4}
  .politicsCognitiveWorkspace.directReasoningWorkspace .relationStrip>section>div{display:flex;align-items:center;gap:7px;overflow-x:auto;padding:2px 0}
  .politicsCognitiveWorkspace.directReasoningWorkspace .relationStrip b{min-width:max-content;color:#263f37;font-size:11.5px;line-height:1.4;font-weight:680}
  .politicsCognitiveWorkspace.directReasoningWorkspace .relationStrip i{color:#6c9a8a;font-style:normal;font-size:12px}

  .politicsCognitiveWorkspace.directReasoningWorkspace .stageAnchor{margin:12px 0 0;padding:8px 0 8px 11px;border-left:3px solid var(--study-green);background:transparent;color:#315247;font-size:12.5px;line-height:1.5}
  .politicsCognitiveWorkspace.directReasoningWorkspace .stageActions{padding-top:16px}

  /* Inspector is for discrimination, not a duplicate summary of the stage. */
  .politicsCognitiveWorkspace.directReasoningWorkspace [data-inspector-state="ORIENT"] .inspectorBlock>b{display:none}
  .politicsCognitiveWorkspace.directReasoningWorkspace .inspectorBlock p{margin:0;padding:10px 0;border-bottom:1px solid #edf1ef}
  .politicsCognitiveWorkspace.directReasoningWorkspace .inspectorBlock p strong{display:block;color:#294b40;font-size:12.5px;line-height:1.4}
  .politicsCognitiveWorkspace.directReasoningWorkspace .inspectorBlock p span{display:block;margin-top:4px;color:#667771;font-size:11.5px;line-height:1.5}
  .politicsCognitiveWorkspace.directReasoningWorkspace [data-inspector-state="ORIENT"]>.inspectorDetails{display:none!important}
  .politicsCognitiveWorkspace.directReasoningWorkspace .suyiNote{display:none!important}

  @media(max-width:1180px){
    .politicsCognitiveWorkspace.directReasoningWorkspace .workspaceUnit{grid-template-columns:minmax(0,1fr) 250px}
    .politicsCognitiveWorkspace.directReasoningWorkspace .mapDeck{grid-template-columns:1fr}
  }
  @media(max-width:980px){
    .politicsCognitiveWorkspace.directReasoningWorkspace .workspaceBar{grid-template-columns:1fr}
    .politicsCognitiveWorkspace.directReasoningWorkspace .workspaceUnit{grid-template-columns:1fr;min-height:auto}
    .politicsCognitiveWorkspace.directReasoningWorkspace .stageScene{min-height:auto}
    .politicsCognitiveWorkspace.directReasoningWorkspace .chapterContext{grid-template-columns:1fr}
    .politicsCognitiveWorkspace.directReasoningWorkspace .chapterContextChain{padding-left:0}
  }
  @media(max-width:720px){
    .politicsCognitiveWorkspace.directReasoningWorkspace .goldenGraph{grid-template-columns:1fr;gap:14px}
    .politicsCognitiveWorkspace.directReasoningWorkspace .goldenGraphColumn:not(:last-child)::after{content:'↓';right:auto;left:50%;top:auto;bottom:-16px;transform:translateX(-50%)}
    .politicsCognitiveWorkspace.directReasoningWorkspace .relationStrip>section{grid-template-columns:1fr}
    .politicsCognitiveWorkspace.directReasoningWorkspace .goldenNodeNotes .semanticMapNodes{grid-template-columns:1fr}
  }
</style>

<script is:inline>
  const workspace = document.querySelector('[data-politics-cognitive-workspace]');

  const setWorkspaceState = (unit, state) => {
    if (!workspace || !unit) return;
    const visibleStage = state === 'REPAIR' ? 'VERIFY' : state;
    unit.dataset.state = state;
    unit.querySelectorAll('[data-stage]').forEach((scene) => {
      scene.hidden = scene.getAttribute('data-stage') !== visibleStage;
    });
    unit.querySelectorAll('[data-inspector-state]').forEach((panel) => {
      panel.hidden = panel.getAttribute('data-inspector-state') !== state;
    });

    const stateLabel = workspace.querySelector('[data-workspace-state-label]');
    if (stateLabel && !unit.hidden) stateLabel.textContent = state;

    try {
      const key = `kianos-politics-workspace-v1:${workspace.dataset.subject || ''}:${workspace.dataset.chapter || ''}`;
      const saved = JSON.parse(localStorage.getItem(key) || '{}');
      const states = { ...(saved.states || {}), [unit.dataset.unitId || '']: state };
      localStorage.setItem(key, JSON.stringify({ ...saved, states, observed_at: new Date().toISOString() }));
    } catch {}
  };

  const goldenizeMap = (panel) => {
    const nodeWrap = panel.querySelector('.semanticMapNodes');
    const edgeWrap = panel.querySelector('.semanticEdges');
    const header = panel.querySelector('header');
    if (!nodeWrap || !edgeWrap || !header || panel.classList.contains('goldenized')) return;

    const nodeRows = [...nodeWrap.querySelectorAll(':scope > article')].map((article) => ({
      label: article.querySelector('b')?.textContent?.trim() || '',
      meaning: article.querySelector('p')?.textContent?.trim() || ''
    })).filter((row) => row.label);
    const meanings = new Map(nodeRows.map((row) => [row.label, row.meaning]));
    const edgeRows = [...edgeWrap.querySelectorAll(':scope > div')].map((row) => {
      const labels = row.querySelectorAll('span');
      return {
        from: labels[0]?.textContent?.trim() || '',
        relation: row.querySelector('small')?.textContent?.trim() || '',
        to: labels[1]?.textContent?.trim() || ''
      };
    }).filter((edge) => edge.from && edge.to);

    const labels = [...new Set([...nodeRows.map((row) => row.label), ...edgeRows.flatMap((edge) => [edge.from, edge.to])])];
    const indegree = new Map(labels.map((label) => [label, 0]));
    const outgoing = new Map(labels.map((label) => [label, []]));
    edgeRows.forEach((edge) => {
      indegree.set(edge.to, (indegree.get(edge.to) || 0) + 1);
      outgoing.get(edge.from)?.push(edge);
    });

    const queue = labels.filter((label) => (indegree.get(label) || 0) === 0);
    const level = new Map(queue.map((label) => [label, 0]));
    const remaining = new Map(indegree);
    while (queue.length) {
      const current = queue.shift();
      const currentLevel = level.get(current) || 0;
      for (const edge of outgoing.get(current) || []) {
        level.set(edge.to, Math.max(level.get(edge.to) || 0, currentLevel + 1));
        remaining.set(edge.to, (remaining.get(edge.to) || 0) - 1);
        if ((remaining.get(edge.to) || 0) === 0) queue.push(edge.to);
      }
    }
    labels.forEach((label) => { if (!level.has(label)) level.set(label, 0); });
    const maxLevel = Math.max(0, ...level.values());

    const graph = document.createElement('div');
    graph.className = 'goldenGraph';
    graph.style.setProperty('--graph-levels', String(maxLevel + 1));

    for (let columnIndex = 0; columnIndex <= maxLevel; columnIndex += 1) {
      const column = document.createElement('div');
      column.className = 'goldenGraphColumn';
      labels.filter((label) => level.get(label) === columnIndex).forEach((label) => {
        const card = document.createElement('article');
        card.className = 'goldenNode';
        const title = document.createElement('b');
        title.textContent = label;
        card.appendChild(title);
        const meaning = meanings.get(label);
        if (meaning) {
          const copy = document.createElement('p');
          copy.textContent = meaning;
          card.appendChild(copy);
        }
        const edges = outgoing.get(label) || [];
        if (edges.length === 1) {
          const edge = edges[0];
          const relation = document.createElement('small');
          const skipsLevel = (level.get(edge.to) || 0) > columnIndex + 1;
          relation.textContent = skipsLevel ? `↗ ${edge.relation} → ${edge.to}` : `→ ${edge.relation}`;
          card.appendChild(relation);
        }
        column.appendChild(card);
      });
      graph.appendChild(column);
    }

    const crossEdges = edgeRows.filter((edge) => (level.get(edge.to) || 0) > (level.get(edge.from) || 0) + 1);
    panel.insertBefore(graph, edgeWrap);

    const notes = document.createElement('details');
    notes.className = 'goldenNodeNotes';
    const notesSummary = document.createElement('summary');
    notesSummary.textContent = '节点解释';
    notes.append(notesSummary, nodeWrap);
    graph.after(notes);

    if (crossEdges.length) {
      const cross = document.createElement('div');
      cross.className = 'goldenCrossEdges';
      crossEdges.forEach((edge) => {
        const row = document.createElement('span');
        const from = document.createElement('b');
        from.textContent = edge.from;
        const to = document.createElement('b');
        to.textContent = edge.to;
        row.append(from, document.createTextNode(` → ${edge.relation} → `), to);
        cross.appendChild(row);
      });
      graph.after(cross);
    }
    panel.classList.add('goldenized');
  };

  if (workspace) {
    workspace.classList.add('directReasoningWorkspace');

    const chapterContext = workspace.querySelector('.chapterContext');
    if (chapterContext) {
      const firstRow = chapterContext.querySelector(':scope > div:first-child');
      if (firstRow && chapterContext.querySelector('.chapterContextChain')) {
        const toggle = document.createElement('button');
        toggle.type = 'button';
        toggle.className = 'chapterContextToggle';
        toggle.textContent = '章地图 +';
        firstRow.appendChild(toggle);
        toggle.addEventListener('click', () => {
          const expanded = chapterContext.classList.toggle('expanded');
          toggle.textContent = expanded ? '章地图 −' : '章地图 +';
        });
      }
    }

    // All Current maps stay simultaneously visible on the golden page. Their topology,
    // not a repeated edge list, owns first glance.
    workspace.querySelectorAll('[data-map-deck]').forEach((deck) => {
      deck.querySelector('.mapTabs')?.remove();
      deck.querySelectorAll('[data-map-panel]').forEach((panel) => {
        panel.hidden = false;
        panel.classList.add('active');
        goldenizeMap(panel);
      });
    });

    workspace.querySelectorAll('[data-workspace-unit]').forEach((unit) => {
      const inspectorTitle = unit.querySelector('[data-inspector-state="ORIENT"] header strong');
      if (inspectorTitle) inspectorTitle.textContent = '容易混';
      const verifyTitle = unit.querySelector('[data-inspector-state="VERIFY"] header strong');
      if (verifyTitle) verifyTitle.textContent = '安静作答';
      const closeEyebrow = unit.querySelector('[data-stage="CLOSE"] .stageEyebrow');
      if (closeEyebrow) closeEyebrow.textContent = '本段收口';
    });

    workspace.addEventListener('politics:resume-state', (event) => {
      const unit = event.target?.closest?.('[data-workspace-unit]');
      const state = event.detail?.state;
      if (unit && state) setWorkspaceState(unit, state);
    });

    // Score-first fast path: optional close stays available without becoming a ritual.
    workspace.querySelectorAll('[data-workspace-action="learn-done"]').forEach((button) => {
      const unit = button.closest('[data-workspace-unit]');
      if (!unit) return;

      button.setAttribute('data-workspace-action', 'learn-fastpath');
      button.textContent = '直接进入肖1000 →';

      const recallButton = document.createElement('button');
      recallButton.type = 'button';
      recallButton.className = 'secondaryAction';
      recallButton.setAttribute('data-workspace-score-recall', 'optional');
      recallButton.textContent = '20 秒闭卷收口（可选）';
      button.before(recallButton);

      recallButton.addEventListener('click', () => setWorkspaceState(unit, 'RECALL'));
      button.addEventListener('click', () => setWorkspaceState(unit, 'VERIFY'));
    });

    workspace.addEventListener('click', (event) => {
      const link = event.target?.closest?.('a[href^="#source-"]');
      if (!link || !workspace.contains(link)) return;
      const unit = link.closest('[data-workspace-unit]');
      if (!unit) return;

      event.preventDefault();
      setWorkspaceState(unit, 'EXTERNAL_LEARN');
      const target = document.querySelector(link.getAttribute('href'));
      requestAnimationFrame(() => target?.scrollIntoView({ behavior: 'smooth', block: 'nearest' }));
    });
  }
</script>