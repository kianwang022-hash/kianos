---
import {englishSessionCatalog} from "../lib/englishSessionCatalog.mjs";
const catalogPayload=JSON.stringify(englishSessionCatalog()).replace(/</g,"\\u003c");
const base = import.meta.env.BASE_URL;
---
<div data-english-resume-surface data-base={base}>
  <section class="englishResume" data-english-resume hidden>
    <div>
      <span>Chat-selected next action</span>
      <strong data-english-resume-title></strong>
      <small data-english-resume-meta></small>
    </div>
    <a class="primaryLink" data-english-resume-link href={`${base}english/`}>进入 →</a>
  </section>
</div>

<script type="application/json" data-english-resume-catalog set:html={catalogPayload}></script>
<script>
  import {
    ENGLISH_SESSION_KEY,
    readEnglishSessionInstruction,
    resolveEnglishSessionStep,
    englishSessionStepHref,
    inspectEnglishSessionSourceContinuation,
    advanceEnglishSessionSourceRevision
  } from '../lib/englishSessionControl.mjs';

  const root = document.querySelector('[data-english-resume-surface]');
  if (root instanceof HTMLElement) {
    let catalog = JSON.parse(document.querySelector('[data-english-resume-catalog]')?.textContent || '[]');
    let catalogPromise = null;
    const loadExternalCatalog = () => {
      if (catalogPromise) return catalogPromise;
      catalogPromise = (async () => {
        const [native, external] = await Promise.allSettled([
          fetch('/__kianos-private/control/english-session-catalog', {cache:'no-store'}).then(async response => response.ok ? (await response.json()).rows : null),
          fetch('/__kianos-private/external-reading/catalog', {cache:'no-store'}).then(async response => response.ok ? (await response.json()).collections : null)
        ]);
        const nativeRows = native.status === 'fulfilled' && Array.isArray(native.value) ? native.value : null;
        const externalRows = external.status === 'fulfilled' && Array.isArray(external.value)
          ? external.value.flatMap(group => group.passages || []).map(row => ({task:'external_reading',object_id:row.object_id,source_hash:row.content_hash,label:row.title||row.object_id,study_day:row.study_day||null,origin:row.origin||null})) : [];
        if (nativeRows) catalog = [...nativeRows, ...externalRows];
        else if (externalRows.length) catalog = [...catalog.filter(row => row.task !== 'external_reading'), ...externalRows];
        const node=document.querySelector('[data-english-resume-catalog]');
        if(node)node.textContent=JSON.stringify(catalog);
        return catalog;
      })().finally(() => {catalogPromise = null;});
      return catalogPromise;
    };
    const base = root.getAttribute('data-base') || '/';
    const resume = root.querySelector('[data-english-resume]');
    const title = root.querySelector('[data-english-resume-title]');
    const meta = root.querySelector('[data-english-resume-meta]');
    const link = root.querySelector('[data-english-resume-link]');
    const taskLabels = {
      reading_a: 'Reading A',
      cloze: 'Cloze',
      reading_b: 'Part B',
      external_reading: 'External Reading',
      translation: 'Translation',
      writing: 'Writing'
    };
    const localDay = () => new Date().toLocaleDateString('en-CA');
    let continuation = null;
    let advancing = false;
    const publishContinue = (detail) => {
      window.dispatchEvent(new CustomEvent('kianos:subject-continue-updated', {
        detail: { subject: 'english', ...detail }
      }));
    };

    const render = async () => {
      if (!(resume instanceof HTMLElement)
        || !(title instanceof HTMLElement)
        || !(meta instanceof HTMLElement)
        || !(link instanceof HTMLAnchorElement)) return;

      await loadExternalCatalog();
      const state = readEnglishSessionInstruction(localStorage, localDay(), {catalog});
      continuation = null;
      link.hidden = false;
      link.textContent = '进入 →';
      link.removeAttribute('data-source-continuation');
      if (['stale_source','source_unverified'].includes(state.status)) {
        const candidate = inspectEnglishSessionSourceContinuation(localStorage, localDay(), {catalog});
        resume.hidden = false;
        title.textContent = '学习材料已有变化';
        link.removeAttribute('data-session-ref');
        link.removeAttribute('href');
        link.hidden = candidate.status !== 'available';
        if (candidate.status === 'available') {
          continuation = candidate;
          title.textContent = candidate.step.label || `${taskLabels[candidate.step.task] || candidate.step.task} · ${candidate.step.object_id}`;
          meta.textContent = '来源已更新。开始新版会保留旧作答与记录，继续同一对象。';
          link.href = '#';
          link.textContent = '开始新版 →';
          link.setAttribute('data-source-continuation','available');
        } else {
          meta.textContent = candidate.error === 'ENGLISH_SOURCE_CONTINUATION_CHAT_REQUIRED'
            ? '旧记录已保留；当前任务需要调整或改换对象，请让 Chat 更新安排。'
            : '当前来源或记录尚未确认，旧记录已保留，确认后再继续。';
        }
        publishContinue({href:null,title:null,session_ref:state.instruction?.session_id || null});
        return;
      }
      if (state.status !== 'ready' || !state.instruction) {
        resume.hidden = true;
        link.removeAttribute('data-session-ref');
        publishContinue({ href: null, title: null, session_ref: null });
        return;
      }

      const instruction = state.instruction;
      const selected = resolveEnglishSessionStep(localStorage, instruction, catalog);
      const step = selected?.step;
      const href = englishSessionStepHref(step, base);
      if (!step || !href) {
        resume.hidden = true;
        link.removeAttribute('data-session-ref');
        publishContinue({ href: null, title: null, session_ref: instruction.session_id });
        return;
      }

      resume.hidden = false;
      title.textContent = step.label || `${taskLabels[step.task] || step.task} · ${step.object_id}`;
      meta.textContent = step.note
        || `Session ${selected.index + 1} / ${instruction.steps.length} · Chat 已选择，本页不重新排序`;
      if(state.pending_source_changes)meta.textContent += ' · 后续来源变化会在到达时提示确认';
      link.href = href;
      link.setAttribute('data-session-ref', instruction.session_id);
      publishContinue({
        href,
        title: step.label || taskLabels[step.task] || step.object_id,
        session_ref: instruction.session_id
      });
    };

    link?.addEventListener('click', async (event) => {
      if (!continuation) return;
      event.preventDefault();
      if (advancing) return;
      advancing = true;
      const accepted = continuation;
      try {
        await loadExternalCatalog();
        const result = advanceEnglishSessionSourceRevision(localStorage, localDay(), {
          catalog, expectedInstructionRaw:accepted.expectedInstructionRaw,
          expectedRaw:accepted.expectedRaw, expectedSourceHash:accepted.step.source_hash
        });
        window.dispatchEvent(new Event('kianos:english-session-updated'));
        window.location.assign(englishSessionStepHref(result.step, base));
      } catch {
        await render();
        if (meta instanceof HTMLElement) meta.textContent = '状态已变化，未覆盖旧记录。请检查当前来源后重试。';
      } finally { advancing = false; }
    });

    window.addEventListener('kianos:english-session-updated', () => void render());
    window.addEventListener('kianos:subject-continue-requested', (event) => {
      const subject = event?.detail?.subject || null;
      if (!subject || subject === 'english') void render();
    });
    window.addEventListener('storage', (event) => {
      if (event.key === ENGLISH_SESSION_KEY || event.key === null) void render();
    });
    window.addEventListener('focus', () => void render());
    void render();
  }
</script>
