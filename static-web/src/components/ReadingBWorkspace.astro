---
const { item } = Astro.props;
const storageKey = `kianos-reading-b-attempt-v1:${item.objectId}`;
const sourceLabel = [item.year, item.code, item.section].filter(Boolean).join(' · ');

function optionEntries(options) {
  if (Array.isArray(options)) return options.map((value, index) => ({ label: String.fromCharCode(65 + index), text: typeof value === 'string' ? value : String(value?.text || value?.content || value?.value || '') }));
  if (!options || typeof options !== 'object') return [];
  return Object.entries(options).map(([label, value]) => ({ label, text: typeof value === 'string' ? value : String(value?.text || value?.content || value?.value || '') }));
}
---
<section class="readingBRuntime" data-objective-root data-objective-task="reading_b" data-objective-object={item.objectId} data-objective-storage-key={storageKey} data-objective-answers-ready="false">
  <header class="readingBHeader">
    <div>
      <span>Reading B · Discourse Reconstruction</span>
      <h2 data-objective-title>{item.title}</h2>
      <small data-objective-source-label>{sourceLabel || item.objectId}</small>
    </div>
    <aside><strong>{item.questions.length} positions</strong><span>先恢复结构，再做全局裁决</span></aside>
  </header>

  <section class="readingBLayout">
    <article class="readingBMaterial" data-objective-material>
      <header><span>MATERIAL</span><strong>Whole structure stays visible</strong></header>
      {item.material.length ? item.material.map((block) => <p data-objective-material-block>{block.text}</p>) : <p data-objective-material-block class="readingBFallback">Current set 没有可投影的完整材料；本任务不能退化成孤立关键词匹配。</p>}
    </article>

    <aside class="readingBMap">
      {item.candidates.length > 0 && (
        <section class="readingBCandidates">
          <header><span>CANDIDATES</span><strong>候选池</strong></header>
          <div>
            {item.candidates.map((candidate) => <p data-objective-candidate><b>{candidate.label}</b><span>{candidate.text}</span></p>)}
          </div>
        </section>
      )}

      <section class="readingBPositions">
        <header><span>PLACEMENT MAP</span><strong>所有位置同时可见</strong></header>
        <div class="readingBPositionList">
          {item.questions.map((question, index) => {
            const id = String(question.id || question.question_id || `q${index + 1}`);
            const local = optionEntries(question.options);
            const options = local.length ? local : item.candidates;
            return (
              <section class="readingBPosition" data-objective-question={id} data-objective-index={index}>
                <div class="readingBPositionHead">
                  <strong>Position {index + 1}</strong>
                  <button type="button" data-reading-b-uncertain>Uncertain</button>
                </div>
                <p data-objective-prompt>{question.prompt || `Position ${index + 1}`}</p>
                <select data-reading-b-select aria-label={`Position ${index + 1}`}>
                  <option value="">— choose —</option>
                  {options.map((option) => <option data-objective-option value={option.label}>{option.label}. {option.text}</option>)}
                </select>
                <p class="readingBFormal" data-objective-formal hidden>Formal answer: <strong></strong></p>
              </section>
            );
          })}
        </div>
      </section>

      <div class="readingBSubmitRow">
        <span data-reading-b-answer-count>0 / {item.questions.length} placed</span>
        <button type="button" data-objective-submit>提交整组</button>
      </div>
      <div class="readingBResult" data-objective-result-summary hidden>
        <strong data-objective-score></strong>
        <span data-objective-result-note></span>
      </div>
    </aside>
  </section>
</section>

<script>
  document.querySelectorAll('[data-objective-root][data-objective-task="reading_b"]').forEach((root) => {
    if (!(root instanceof HTMLElement)) return;
    const storageKey = root.getAttribute('data-objective-storage-key') || '';
    const rows = [...root.querySelectorAll('[data-objective-question]')];
    const submit = root.querySelector('[data-objective-submit]');
    const normalizeAnswer = (value) => Array.isArray(value)
      ? value.map(String)
      : value === null || value === undefined || value === '' ? [] : [String(value)];
    const idOf = (row) => row.getAttribute('data-objective-question') || '';
    const now = () => new Date().toISOString();
    const blankState = () => ({
      schema: 'kianos.english.reading_b_attempt.v1',
      objectId: root.getAttribute('data-objective-object') || '',
      startedAt: now(),
      submittedAt: null,
      submitted: false,
      answers: {},
      uncertain: [],
      trajectory: {},
      results: {}
    });
    const read = () => {
      try {
        const saved = JSON.parse(localStorage.getItem(storageKey) || 'null');
        return saved?.objectId === root.getAttribute('data-objective-object') ? { ...blankState(), ...saved } : blankState();
      } catch { return blankState(); }
    };
    let state = read();
    const save = () => localStorage.setItem(storageKey, JSON.stringify(state));
    const formalOf = (row) => {
      try { return normalizeAnswer(JSON.parse(row.getAttribute('data-answer') || '""')); }
      catch { return []; }
    };

    const render = () => {
      rows.forEach((row) => {
        const id = idOf(row);
        const select = row.querySelector('[data-reading-b-select]');
        if (select instanceof HTMLSelectElement) {
          select.value = state.answers?.[id] || '';
          select.disabled = Boolean(state.submitted);
        }
        const uncertain = row.querySelector('[data-reading-b-uncertain]');
        if (uncertain instanceof HTMLButtonElement) {
          uncertain.classList.toggle('active', (state.uncertain || []).includes(id));
          uncertain.disabled = Boolean(state.submitted);
        }
        row.classList.remove('result-correct', 'result-wrong');
        if (state.submitted) row.classList.add(state.results?.[id] === 'correct' ? 'result-correct' : 'result-wrong');
        const formalLine = row.querySelector('[data-objective-formal]');
        if (formalLine instanceof HTMLElement) {
          formalLine.hidden = !state.submitted;
          const strong = formalLine.querySelector('strong');
          if (strong) strong.textContent = formalOf(row).join(', ') || '—';
        }
      });
      const count = Object.values(state.answers || {}).filter(Boolean).length;
      const countNode = root.querySelector('[data-reading-b-answer-count]');
      if (countNode) countNode.textContent = `${count} / ${rows.length} placed`;
      if (submit instanceof HTMLButtonElement) submit.hidden = Boolean(state.submitted);
      const result = root.querySelector('[data-objective-result-summary]');
      if (result instanceof HTMLElement) {
        result.hidden = !state.submitted;
        if (state.submitted) {
          const score = Object.values(state.results || {}).filter((value) => value === 'correct').length;
          const scoreNode = result.querySelector('[data-objective-score]');
          const note = result.querySelector('[data-objective-result-note]');
          if (scoreNode) scoreNode.textContent = `${score} / ${rows.length}`;
          if (note) note.textContent = score === rows.length && !(state.uncertain || []).length
            ? 'Clean pass · 不强制复盘。'
            : '整组进入 review；先看 discourse skeleton 和完整 placement map。';
        }
      }
    };

    rows.forEach((row) => {
      const id = idOf(row);
      const select = row.querySelector('[data-reading-b-select]');
      select?.addEventListener('change', (event) => {
        if (state.submitted) return;
        const answer = String(event.currentTarget.value || '');
        answer ? state.answers[id] = answer : delete state.answers[id];
        state.trajectory[id] ||= [];
        const last = state.trajectory[id][state.trajectory[id].length - 1]?.answer;
        if (last !== answer) state.trajectory[id].push({ answer, at: now() });
        save();
        render();
      });
      row.querySelector('[data-reading-b-uncertain]')?.addEventListener('click', () => {
        if (state.submitted) return;
        const uncertain = new Set(state.uncertain || []);
        uncertain.has(id) ? uncertain.delete(id) : uncertain.add(id);
        state.uncertain = [...uncertain];
        save();
        render();
      });
    });

    submit?.addEventListener('click', () => {
      if (state.submitted || root.getAttribute('data-objective-answers-ready') !== 'true') return;
      const results = {};
      rows.forEach((row) => {
        const id = idOf(row);
        const selected = String(state.answers?.[id] || '');
        const formal = formalOf(row);
        results[id] = !selected ? 'unanswered' : formal.includes(selected) ? 'correct' : 'wrong';
      });
      state.results = results;
      state.submitted = true;
      state.submittedAt = now();
      save();
      render();
      root.dispatchEvent(new CustomEvent('kianos:objective-submitted', { bubbles: true }));
    });

    render();
    if (state.submitted) root.dispatchEvent(new CustomEvent('kianos:objective-submitted', { bubbles: true }));
  });
</script>

<style>
  .readingBRuntime{max-width:78rem;margin:0 auto;display:grid;gap:12px}.readingBHeader{display:flex;justify-content:space-between;gap:20px;align-items:end;padding:18px 20px;border:1px solid var(--study-line);border-radius:14px;background:#fff}.readingBHeader>div{display:grid;gap:4px}.readingBHeader>div>span,.readingBMaterial header span,.readingBCandidates header span,.readingBPositions>header span{font-size:9px;font-weight:850;letter-spacing:.08em;color:var(--study-green)}.readingBHeader h2{margin:0;font-size:22px}.readingBHeader small{color:var(--study-faint)}.readingBHeader aside{display:grid;text-align:right}.readingBHeader aside span{font-size:10px;color:var(--study-muted)}.readingBLayout{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(380px,.85fr);gap:12px;align-items:start}.readingBMaterial,.readingBMap{border:1px solid var(--study-line);border-radius:14px;background:#fff;box-shadow:var(--study-shadow)}.readingBMaterial{padding:24px 26px;position:sticky;top:76px}.readingBMaterial header,.readingBCandidates header,.readingBPositions>header{display:flex;justify-content:space-between;gap:12px;margin-bottom:14px}.readingBMaterial header strong,.readingBCandidates header strong,.readingBPositions>header strong{font-size:11px;color:var(--study-muted)}.readingBMaterial p{margin:0 0 1em;font-size:14px;line-height:1.85}.readingBFallback{color:var(--study-muted)}.readingBMap{padding:18px;display:grid;gap:16px}.readingBCandidates{padding-bottom:14px;border-bottom:1px solid var(--study-line)}.readingBCandidates>div{display:grid;gap:5px;max-height:250px;overflow:auto}.readingBCandidates p{display:grid;grid-template-columns:28px 1fr;gap:8px;margin:0;padding:7px 8px;border-radius:8px;background:var(--study-green-soft);font-size:11px;line-height:1.5}.readingBCandidates b{color:var(--study-green)}.readingBPositionList{display:grid;gap:8px}.readingBPosition{padding:10px;border:1px solid var(--study-line);border-radius:10px;display:grid;gap:7px}.readingBPosition.result-correct{border-color:var(--study-green)}.readingBPosition.result-wrong{border-style:dashed}.readingBPositionHead{display:flex;justify-content:space-between;gap:8px;align-items:center}.readingBPositionHead strong{font-size:11px}.readingBPositionHead button{padding:5px 7px;border:1px solid var(--study-line);border-radius:7px;background:#fff;color:var(--study-muted);font:inherit;font-size:9px}.readingBPositionHead button.active{border-color:var(--study-green);background:var(--study-green-soft);color:var(--study-green)}.readingBPosition>p[data-objective-prompt]{margin:0;color:var(--study-muted);font-size:11px;line-height:1.55}.readingBPosition select{width:100%;padding:8px 9px;border:1px solid var(--study-line);border-radius:8px;background:#fff;font:inherit;font-size:11px}.readingBFormal{margin:0;color:var(--study-muted);font-size:9px}.readingBSubmitRow{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:12px;border-top:1px solid var(--study-line)}.readingBSubmitRow span{color:var(--study-muted);font-size:10px}.readingBSubmitRow button{padding:9px 14px;border:1px solid var(--study-green);border-radius:9px;background:var(--study-green);color:#fff;font:inherit;font-weight:850}.readingBResult{padding:12px;border-radius:10px;background:var(--study-green-soft);display:grid;gap:3px}.readingBResult strong{font-size:18px}.readingBResult span{font-size:10px;color:var(--study-muted)}@media(max-width:960px){.readingBLayout{grid-template-columns:1fr}.readingBMaterial{position:static}}@media(max-width:560px){.readingBHeader{display:grid}.readingBHeader aside{text-align:left}.readingBMaterial{padding:18px}.readingBMap{padding:14px}}
</style>
