:sticky;top:76px;max-height:calc(100vh - 96px);overflow:auto}.readingBCandidates>div{display:grid;gap:7px;max-height:310px;overflow:auto}.readingBOrderingCandidates>div{max-height:none;overflow:visible}.readingBCandidates p{display:grid;grid-template-columns:30px 1fr auto;gap:9px;margin:0;padding:9px 10px;border:1px solid transparent;border-radius:9px;background:var(--study-green-soft);font-size:12.5px;line-height:1.55}.readingBCandidates p.used{border-color:var(--study-green)}.readingBCandidates p.fixed{background:#f2f3ef}.readingBCandidates p.duplicate{border-color:#a85d42}.readingBCandidates b{color:var(--study-green);font-size:13px}.readingBCandidates small{align-self:start;color:var(--study-muted);font-size:9px;white-space:nowrap}.readingBPositionList{display:grid;gap:9px}.readingBPosition{padding:11px;border:1px solid var(--study-line);border-radius:10px;display:grid;gap:8px;background:#fff}.readingBPosition.result-correct{border-color:var(--study-green)}.readingBPosition.result-wrong,.readingBPosition.constraint-wrong{border-color:#9f684d;border-style:dashed}.readingBPositionHead{display:flex;justify-content:space-between;gap:8px;align-items:center}.readingBPositionHead strong{font-size:13px}.readingBPositionHead button{padding:5px 8px;border:1px solid var(--study-line);border-radius:7px;background:#fff;color:var(--study-muted);font:inherit;font-size:10px}.readingBPositionHead button.active{border-color:var(--study-green);background:var(--study-green-soft);color:var(--study-green)}.readingBPosition select{width:100%;padding:9px 10px;border:1px solid var(--study-line);border-radius:8px;background:#fff;font:inherit;font-size:12px}.readingBFormal{margin:0;color:var(--study-muted);font-size:10px}.readingBOrderSkeleton{display:grid;gap:9px}.readingBFixedSlot{display:flex;align-items:center;gap:10px;padding:13px 14px;border:1px solid var(--study-line);border-radius:10px;background:#f2f3ef}.readingBFixedSlot small{text-transform:uppercase;letter-spacing:.08em;color:var(--study-muted);font-size:9px}.readingBFixedSlot strong{font-size:18px;color:var(--study-green)}.readingBOrderSlot{border-left:3px solid var(--study-green)}.readingBConstraint{padding:9px 10px;border-radius:8px;background:#f7f8f5;color:var(--study-muted);font-size:10.5px;line-height:1.55}.readingBConstraint.warning{background:#fff3ee;color:#824e38}.readingBSubmitRow{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:12px;border-top:1px solid var(--study-line)}.readingBSubmitRow span{color:var(--study-muted);font-size:11px}.readingBSubmitRow button{padding:10px 15px;border:1px solid var(--study-green);border-radius:9px;background:var(--study-green);color:#fff;font:inherit;font-weight:850}.readingBSubmitRow button:disabled{opacity:.45;cursor:not-allowed}.readingBResult{padding:13px;border-radius:10px;background:var(--study-green-soft);display:grid;gap:3px}.readingBResult strong{font-size:19px}.readingBResult span{font-size:11px;color:var(--study-muted)}@media(max-width:960px){.readingBLayout,.readingBOrderingLayout{grid-template-columns:1fr}.readingBMaterial,.readingBOrderingCandidates{position:static;max-height:none}.readingBCandidates>div{max-height:none}}@media(max-width:560px){.readingBHeader{display:grid}.readingBHeader aside{text-align:left}.readingBMaterial{padding:18px}.readingBMap,.readingBOrderingCandidates{padding:14px}.readingBCandidates p{grid-template-columns:28px 1fr}.readingBCandidates small{grid-column:2}}
</style>