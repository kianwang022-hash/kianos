---
const { task, answerRoute } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<span data-objective-answer-gate data-task={task} data-answer-route={answerRoute} data-base={base} hidden></span>

<script>
  import {readEnglishExamSession} from '../lib/englishExamSession.mjs';
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(() => {

  document.querySelectorAll('[data-objective-answer-gate]').forEach((gate) => {
    if (!(gate instanceof HTMLElement)) return;
    const task = gate.getAttribute('data-task') || '';
    const route = gate.getAttribute('data-answer-route') || '';
    const basePath = gate.getAttribute('data-base') || '/';
    const root = document.querySelector(`[data-objective-root][data-objective-task="${task}"]`);
    if (!(root instanceof HTMLElement)) return;

    const objectId = root.getAttribute('data-objective-object') || '';
    const baseStorageKey = root.getAttribute('data-objective-storage-key') || '';
    const examSessionId = new URLSearchParams(location.search).get('exam_session') || '';
    const storageKey = examSessionId
      ? `kianos-english-exam-task-v1:${examSessionId}:${task}:${objectId}`
      : baseStorageKey;
    const examMode = Boolean(examSessionId);
    const answerUrl = `${basePath}${route}/${encodeURIComponent(objectId)}.json`;
    const submit = root.querySelector('[data-objective-submit]');
    const questions = [...root.querySelectorAll('[data-objective-question]')];
    let ready = root.getAttribute('data-objective-answers-ready') === 'true';
    let loading = null;

    const normalizeAnswer = (value) => Array.isArray(value)
      ? value.map(String)
      : value === null || value === undefined || value === '' ? [] : [String(value)];
    const readAttempt = () => {
      try { return storageKey ? JSON.parse(localStorage.getItem(storageKey) || 'null') || {} : {}; }
      catch { return {}; }
    };
    const formalOf = (question) => {
      try { return normalizeAnswer(JSON.parse(question.getAttribute('data-answer') || '""')); }
      catch { return []; }
    };

    const decorateSubmittedReview = () => {
      const attempt = readAttempt();
      if (!attempt.submitted) return;
      questions.forEach((question) => {
        const id = question.getAttribute('data-objective-question') || '';
        const formal = formalOf(question);
        const selected = String(attempt.answers?.[id] || '');
        const formalLine = question.querySelector('[data-objective-formal]');
        if (formalLine instanceof HTMLElement) {
          formalLine.hidden = false;
          const strong = formalLine.querySelector('strong');
          if (strong) strong.textContent = formal.join(', ') || '—';
        }

        if (task === 'cloze') {
          question.querySelectorAll('[data-cloze-option]').forEach((option) => {
            const value = option.getAttribute('data-value') || '';
            option.classList.toggle('result-correct', formal.includes(value));
            option.classList.toggle('result-wrong', Boolean(selected && value === selected && !formal.includes(value)));
          });
        }

        if (task === 'reading_b') {
          question.classList.remove('result-correct', 'result-wrong');
          question.classList.add(attempt.results?.[id] === 'correct' ? 'result-correct' : 'result-wrong');
        }
      });
      root.dispatchEvent(new CustomEvent('kianos:objective-submitted', { bubbles: true }));
    };

    const applyAnswers = (payload) => {
      if (!payload || payload.objectId !== objectId || payload.task !== task || typeof payload.answers !== 'object') return false;
      questions.forEach((question) => {
        const id = question.getAttribute('data-objective-question') || '';
        if (!id || !Object.prototype.hasOwnProperty.call(payload.answers, id)) return;
        question.setAttribute('data-answer', JSON.stringify(payload.answers[id] ?? ''));
      });
      ready = questions.every((question) => {
        try { return normalizeAnswer(JSON.parse(question.getAttribute('data-answer') || '""')).length > 0; }
        catch { return false; }
      });
      if (!ready) return false;
      root.setAttribute('data-objective-answers-ready', 'true');
      root.dispatchEvent(new CustomEvent('kianos:objective-answers-ready', { bubbles: true }));
      decorateSubmittedReview();
      return true;
    };

    const loadAnswers = async () => {
      const activeExam=readEnglishExamSession(localStorage);
      if(root.dataset.englishReadonly==='true' || (activeExam&&activeExam.status!=='RELEASED'&&activeExam.steps.some(s=>s.object_id===objectId)))return false;
      if (ready) {
        decorateSubmittedReview();
        return true;
      }
      if (loading) return loading;
      const originalText = submit?.textContent || 'Submit';
      if (submit instanceof HTMLButtonElement) {
        submit.disabled = true;
        submit.textContent = 'Submitting…';
      }
      loading = fetch(answerUrl, { headers: { Accept: 'application/json' } })
        .then((response) => {
          if (!response.ok) throw new Error(`answer ${response.status}`);
          return response.json();
        })
        .then(applyAnswers)
        .catch(() => false)
        .finally(() => {
          loading = null;
          if (submit instanceof HTMLButtonElement) {
            submit.disabled = false;
            submit.textContent = originalText;
          }
        });
      return loading;
    };

    document.addEventListener('click', async (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const button = target?.closest('[data-objective-submit]');
      if (!button || !root.contains(button) || ready || examMode) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      const ok = await loadAnswers();
      if (ok) button.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
      else if (submit instanceof HTMLButtonElement) {
        submit.disabled = false;
        submit.textContent = '重试提交';
        submit.title = '答案加载失败，本次作答尚未提交。';
      }
    }, true);

    const saved = readAttempt();
    if (!examMode && saved.submitted) void loadAnswers();
  });

  });
</script>
