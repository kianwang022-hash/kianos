---
const { base='/' }=Astro.props;
---
<nav class="taskGuideBridge" data-task-guide-bridge data-base={base} hidden aria-label="学习参考与返回"><a data-task-guide-link></a><span data-guide-feedback role="status"></span></nav>
<script>
const bar=document.querySelector('[data-task-guide-bridge]');
if(bar){
 const path=location.pathname;const base=bar.getAttribute('data-base')||'/';
 const guides=[['reading','objective-learn','reading-a'],['cloze','objective-learn','cloze'],['reading-b','objective-learn','reading-b'],['translation','translation-learn','translation-a'],['writing','writing-learn','global-map']];
 const guide=guides.find(([,route])=>path===`${base}${route}/`);
 const task=guides.find(([route])=>path.startsWith(`${base}${route}/`));
 const link=bar.querySelector('a');
 const isTask=url=>url.origin===location.origin && guides.some(([route])=>url.pathname.startsWith(`${base}${route}/`));
 const scrollSelectors=['.portedReadingPassage','.portedReadingQuestions','.clozePassage','.clozeDecision','.translationSource','.translationWork','.writingPrompt','.writingWork'];
 const storageKey='kianos:guide-return:v1';
 if(guide){
  const raw=new URLSearchParams(location.search).get('return');
  if(raw){try{const url=new URL(raw,location.origin);if(isTask(url)){link.href=url.href;link.textContent='← 已经够用，返回原任务';bar.hidden=false;}}catch{}}
  const posKey=`kianos:guide-position:${path}`;
  if(!location.hash){try{const y=Number(sessionStorage.getItem(posKey));if(y>0)requestAnimationFrame(()=>scrollTo(0,y));}catch{}}
  addEventListener('pagehide',()=>{try{sessionStorage.setItem(posKey,String(scrollY));}catch{}});
 }else if(task){
  const [,route,anchor]=task;
  const url=new URL(`${base}${route}/`,location.origin);url.searchParams.set('return',location.pathname+location.search+location.hash);url.hash=anchor;
  link.href=url.href;link.textContent='Guide · 随时查阅';bar.hidden=false;
  link.addEventListener('click',()=>{
   try{sessionStorage.setItem(storageKey,JSON.stringify({href:location.pathname+location.search+location.hash,y:scrollY,panes:scrollSelectors.map(selector=>({selector,y:document.querySelector(selector)?.scrollTop||0}))}));}
   catch{bar.querySelector('[data-guide-feedback]').textContent='位置暂未保存，可用浏览器返回。';}
  });
  try{const saved=JSON.parse(sessionStorage.getItem(storageKey)||'null');if(saved?.href===location.pathname+location.search+location.hash){requestAnimationFrame(()=>{scrollTo(0,saved.y);saved.panes.forEach(({selector,y})=>{const pane=document.querySelector(selector);if(pane)pane.scrollTop=y;});});sessionStorage.removeItem(storageKey);}}catch{}
 }
}
</script>
<style>.taskGuideBridge{display:flex;gap:16px;align-items:center;margin:0 0 12px;font-size:15px}.taskGuideBridge a{color:var(--study-green);text-decoration:none}.taskGuideBridge a:focus-visible{outline:3px solid #759b89;outline-offset:4px}.taskGuideBridge span{color:#935521}</style>
