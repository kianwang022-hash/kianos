<span data-vocab-english-evidence-bridge hidden></span>

<script>
  import {
    LEXICAL_LEDGER_STORAGE_KEY,
    appendEvidenceEvent,
    emptyLexicalLedger,
    normalizeLexicalLedger,
    repairStateForEvent
  } from '../lib/lexicalEvidence.mjs';
  import { lexicalEventFromObjectiveThread } from '../lib/lexicalEnglishEvidence.mjs';

  const RETURN_SCHEMA = 'kianos.english.objective_review_return.v1';
  const WORD_PREFIX = 'kianos-vocabulary-astro-v2:';
  let captured = null;

  const readJson = (key, fallback) => {
    try { return JSON.parse(localStorage.getItem(key) || 'null') || fallback; }
    catch { return fallback; }
  };
  const saveJson = (key, value) => {
    try { localStorage.setItem(key, JSON.stringify(value)); return true; }
    catch { return false; }
  };
  const readLedger = () => normalizeLexicalLedger(readJson(LEXICAL_LEDGER_STORAGE_KEY, emptyLexicalLedger()));
  const extractReturn = (text) => {
    const raw = String(text || '').trim();
    if (!raw) return null;
    try {
      const direct = JSON.parse(raw);
      if (direct?.schema === RETURN_SCHEMA) return direct;
    } catch {}
    const marked = raw.match(/KIANOS_OBJECTIVE_RETURN_V1[\s\S]*?```(?:json)?\s*([\s\S]*?)```/i);
    if (marked?.[1]) {
      try {
        const parsed = JSON.parse(marked[1].trim());
        if (parsed?.schema === RETURN_SCHEMA) return parsed;
      } catch {}
    }
    const fenced = [...raw.matchAll(/```(?:json)?\s*([\s\S]*?)```/gi)];
    for (const match of fenced) {
      try {
        const parsed = JSON.parse(String(match?.[1] || '').trim());
        if (parsed?.schema === RETURN_SCHEMA) return parsed;
      } catch {}
    }
    return null;
  };

  const contextFor = (button) => {
    const readingRoot = button.closest('[data-local-port="reading"]');
    if (readingRoot instanceof HTMLElement) {
      const objectId = String(readingRoot.getAttribute('data-reading-object') || '');
      return objectId ? {
        task: 'reading_a', objectId,
        attemptKey: `kianos-reading-attempt-v1:${objectId}`
      } : null;
    }
    const objectiveRoot = button.closest('[data-objective-root]');
    if (!(objectiveRoot instanceof HTMLElement)) return null;
    const task = String(objectiveRoot.getAttribute('data-objective-task') || '');
    const objectId = String(objectiveRoot.getAttribute('data-objective-object') || '');
    const attemptKey = String(objectiveRoot.getAttribute('data-objective-storage-key') || '');
    return task && objectId && attemptKey ? { task, objectId, attemptKey } : null;
  };

  const cacheKeyFor = (event) => event.target_id || `${event.target_kind}:${event.target_locator || ''}`;
  const syncLegacyProjection = (event, derived) => {
    if (!derived || !['ACTIVE', 'DORMANT'].includes(derived.state)) return;
    const key = `${WORD_PREFIX}${event.word_id}`;
    const state = readJson(key, {
      revealed: false,
      repairTargets: {},
      lastSeenAt: '',
      meta: { word_id: event.word_id, ordinal: Number(event.ordinal), word: event.word || null, source_hash: event.target_revision || null }
    });
    if (!state.repairTargets || typeof state.repairTargets !== 'object') state.repairTargets = {};
    const cacheKey = cacheKeyFor(event);
    if (derived.state === 'ACTIVE') {
      state.repairTargets[cacheKey] = {
        target_kind: event.target_kind,
        target_id: event.target_id || null,
        target_locator: event.target_locator || null,
        target_revision: event.target_revision || null,
        label: event.target_label || event.word || event.target_id || event.target_locator || event.target_kind,
        source: 'evidence_reducer',
        outcome: 'ADDED',
        observed_at: event.observed_at
      };
    } else {
      delete state.repairTargets[cacheKey];
    }
    state.lastSeenAt = event.observed_at;
    state.meta = {
      ...state.meta,
      word_id: event.word_id,
      ordinal: Number(event.ordinal),
      word: event.word || state.meta?.word || null
    };
    saveJson(key, state);
  };

  document.addEventListener('click', (event) => {
    const button = event.target instanceof HTMLElement ? event.target.closest('[data-transfer-apply]') : null;
    if (!(button instanceof HTMLButtonElement)) return;
    const context = contextFor(button);
    const panel = button.closest('.objectiveTransferPanel');
    const input = panel?.querySelector('[data-transfer-input]');
    if (!context || !(input instanceof HTMLTextAreaElement)) { captured = null; return; }
    const reviewKey = `kianos-english-objective-review-return-v1:${context.task}:${context.objectId}`;
    const priorReview = readJson(reviewKey, null);
    captured = {
      button,
      context,
      reviewKey,
      raw: input.value,
      priorImportedAt: priorReview?.importedAt || null,
      capturedAt: Date.now()
    };
  }, true);

  document.addEventListener('click', (event) => {
    const button = event.target instanceof HTMLElement ? event.target.closest('[data-transfer-apply]') : null;
    if (!(button instanceof HTMLButtonElement) || !captured || captured.button !== button) return;
    const snapshot = captured;
    captured = null;

    const nextReview = readJson(snapshot.reviewKey, null);
    if (!nextReview || nextReview.schema !== RETURN_SCHEMA || nextReview.task !== snapshot.context.task || nextReview.objectId !== snapshot.context.objectId) return;
    if (!nextReview.importedAt || nextReview.importedAt === snapshot.priorImportedAt) return;

    const payload = extractReturn(snapshot.raw);
    if (!payload || payload.task !== snapshot.context.task || payload.objectId !== snapshot.context.objectId) return;
    const attempt = readJson(snapshot.context.attemptKey, null);
    if (!attempt?.submitted || !attempt?.submittedAt) return;

    const acceptedIds = new Set((Array.isArray(nextReview.threads) ? nextReview.threads : []).map((thread) => String(thread?.threadId || '')).filter(Boolean));
    let ledger = readLedger();
    let appended = 0;
    let duplicates = 0;
    let rejected = 0;
    let conflicts = 0;

    (Array.isArray(payload.threads) ? payload.threads : []).forEach((thread, index) => {
      if (String(thread?.route || '') !== 'lexical') return;
      const threadId = String(thread?.threadId || `t${index + 1}`);
      if (!acceptedIds.has(threadId)) { rejected += 1; return; }
      const prepared = lexicalEventFromObjectiveThread({
        task: snapshot.context.task,
        objectId: snapshot.context.objectId,
        attemptSubmittedAt: attempt.submittedAt,
        thread: { ...thread, threadId },
        threadIndex: index
      });
      if (prepared.status !== 'READY' || !prepared.event) { rejected += 1; return; }
      const result = appendEvidenceEvent(ledger, prepared.event);
      ledger = result.ledger;
      if (result.status === 'APPENDED') appended += 1;
      else if (result.status === 'DUPLICATE_IGNORED') duplicates += 1;
      else if (result.status === 'CONFLICT_QUARANTINED') conflicts += 1;
      else rejected += 1;
      if (['APPENDED', 'DUPLICATE_IGNORED'].includes(result.status)) {
        syncLegacyProjection(prepared.event, repairStateForEvent(ledger, prepared.event));
      }
    });

    saveJson(LEXICAL_LEDGER_STORAGE_KEY, ledger);
    if (appended || duplicates || conflicts) {
      window.dispatchEvent(new CustomEvent('kianos:lexical-evidence-changed'));
      window.dispatchEvent(new CustomEvent('kianos:lexical-cross-module-evidence', {
        detail: { task: snapshot.context.task, objectId: snapshot.context.objectId, appended, duplicates, rejected, conflicts }
      }));
    }
    const status = button.closest('.objectiveTransferPanel')?.querySelector('[data-transfer-status]');
    if (status && (appended || duplicates || rejected || conflicts)) {
      status.textContent += ` · Lexical ${appended} new / ${duplicates} duplicate / ${rejected} rejected / ${conflicts} conflict`;
    }
  });
</script>
