---
import { buildMissionControlSnapshot } from '../lib/missionControl.mjs';

const base = import.meta.env.BASE_URL;
const snapshot = buildMissionControlSnapshot();

function laneState(lane) {
  const blocker = String(lane.blocker || '').trim().toLowerCase();
  if (blocker && blocker !== 'none') return { label: '有阻塞', tone: 'blocked' };
  const active = String(lane.active || '').trim().toLowerCase();
  if (!active || active === 'none' || active.includes('router-only')) return { label: '工程已收口', tone: 'quiet' };
  return { label: '建设中', tone: 'active' };
}

const lanes = snapshot.lanes.map((lane) => ({ ...lane, state: laneState(lane) }));
const activeCount = lanes.filter((lane) => lane.state.tone === 'active').length;
const blockedCount = lanes.filter((lane) => lane.state.tone === 'blocked').length;
---
<section class="homeMission" aria-label="KianOS 系统进度">
  <header class="homeMissionHead">
    <div>
      <span class="pageKicker">SYSTEM</span>
      <h2>系统进度</h2>
    </div>
    <a href={`${base}current/`}>完整进度 →</a>
  </header>

  <p class="homeMissionSummary">
    {blockedCount ? `${blockedCount} 个范围有阻塞` : '当前无系统级阻塞'}
    <span aria-hidden="true">·</span>
    {activeCount ? `${activeCount} 个范围仍在建设` : '工程已收口'}
  </p>

  <div class="homeMissionLanes">
    {lanes.map((lane) => (
      <div class={`homeMissionLane is-${lane.state.tone}`}>
        <strong>{lane.label}</strong>
        <span>{lane.state.label}</span>
      </div>
    ))}
  </div>

  <div class="homeMissionNext">
    <span>后台下一步</span>
    <p>{snapshot.project.next || '没有新的系统建设任务。'}</p>
  </div>
</section>
