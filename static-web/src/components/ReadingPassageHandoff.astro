<span data-reading-passage-handoff-root hidden></span>

<script>
  const TRANSFER_STORE_KEY = 'kianos-english-objective-transfer-claims-v1';
  const TASK = 'reading_a';
  const readingRoot = document.querySelector('[data-local-port="reading"]');

  if (readingRoot) {
    const readingKey = readingRoot.getAttribute('data-reading-object') || 'reading';
    const storageKey = `kianos-reading-attempt-v1:${readingKey}`;
    const handoffKey = `kianos-english-objective-handoff-v1:${TASK}:${readingKey}`;
    const resultSummary = readingRoot.querySelector('.portedReadingResultSummary');
    let handoff = null;

    const readJson = (key, fallback) => {
      try { return JSON.parse(localStorage.getItem(key) || 'null') || fallback; }
      catch { return fallback; }
    };
    const taskClaims = () => {
      const store = readJson(TRANSFER_STORE_KEY, { claims: [] });
      return (Array.isArray(store.claims) ? store.claims : []).filter((claim) => claim?.task === TASK);
    };
    const activeClaims = () => taskClaims().filter((claim) => claim?.status === 'TRANSFER_PENDING');
    const recentClosedClaims = () => taskClaims()
      .filter((claim) => claim?.status === 'CLOSED' && claim?.sourceObjectId !== readingKey)
      .sort((a, b) => String(b?.updatedAt || '').localeCompare(String(a?.updatedAt || '')))
      .slice(0, 5);
    const readAttempt = () => readJson(storageKey, {});

    const expected = (question) => {
      try {
        const value = JSON.parse(question.getAttribute('data-answer') || '""');
        return Array.isArray(value) ? value.map(String) : value === null || value === undefined ? [] : [String(value)];
      } catch { return []; }
    };
    const qid = (question) => question.getAttribute('data-question') || '';
    const ordinal = (question) => Number(question.getAttribute('data-index') || 0) + 1;

    const durationSeconds = (attempt) => {
      if (!attempt?.startedAt || !attempt?.submittedAt) return null;
      const start = new Date(attempt.startedAt).getTime();
      const end = new Date(attempt.submittedAt).getTime();
      if (!Number.isFinite(start) || !Number.isFinite(end)) return null;
      return Math.max(0, Math.round((end - start) / 1000));
    };
    const formatDuration = (seconds) => {
      if (!Number.isFinite(seconds)) return '—';
      const minutes = Math.floor(seconds / 60);
      const rest = seconds % 60;
      return `${String(minutes).padStart(2, '0')}:${String(rest).padStart(2, '0')}`;
    };
    const problemIds = (attempt) => {
      const uncertain = new Set(attempt.uncertain || []);
      return Object.keys(attempt.results || {}).filter((id) =>
        ['wrong', 'unanswered'].includes(attempt.results?.[id]) || uncertain.has(id)
      );
    };

    const ensureHandoff = () => {
      if (handoff || !resultSummary) return handoff;
      handoff = document.createElement('div');
      handoff.className = 'portedReadingSessionHandoff';
      handoff.hidden = true;

      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = '深复盘 · 整篇给 Chat';
      button.setAttribute('data-reading-passage-copy-chat', '');

      const status = document.createElement('small');
      status.setAttribute('data-reading-passage-copy-status', '');
      status.textContent = '可选：快速看懂错误就继续；解释不清、反复错或需要归因时再用。';

      handoff.append(button, status);
      resultSummary.appendChild(handoff);
      return handoff;
    };

    const demoteLegacyQuestionBridge = () => {
      readingRoot.querySelectorAll('[data-reading-copy-chat]').forEach((button) => {
        const actions = button.closest('.portedReadingRepairActions');
        if (actions instanceof HTMLElement) actions.hidden = true;
      });
      readingRoot.querySelectorAll('.portedReadingRepair header span').forEach((label) => {
        if (label.textContent?.trim() === '只处理这道') label.textContent = '局部线索 · 深挖时可选';
      });
      readingRoot.querySelectorAll('.portedReadingRepair header small').forEach((label) => {
        if (label.textContent?.includes('错因')) label.textContent = '能直接说清就不用选错因';
      });
    };

    const questionBlock = (question) => {
      const id = qid(question);
      const prompt = question.querySelector(':scope > p')?.textContent?.trim() || '';
      const options = [...question.querySelectorAll('[data-option]')]
        .map((option) => `${option.getAttribute('data-option')}. ${option.querySelector('span')?.textContent?.trim() || ''}`);
      return ['', `Q${ordinal(question)} (${id})`, `Prompt: ${prompt || '—'}`, ...options];
    };

    const buildPacket = (attempt) => {
      const questions = [...readingRoot.querySelectorAll('[data-question]')];
      const passage = readingRoot.querySelector('[data-reading-passage]');
      const passageTitle = passage?.querySelector('h2')?.textContent?.trim() || readingKey;
      const passageMeta = passage?.querySelector('header span')?.textContent?.trim() || '';
      const passageText = [...(passage?.querySelectorAll('p') || [])]
        .map((paragraph) => paragraph.textContent?.trim() || '')
        .filter(Boolean)
        .join('\n\n');
      const uncertain = new Set(attempt.uncertain || []);
      const problems = new Set(problemIds(attempt));
      const pendingClaims = activeClaims();
      const reopenCandidates = recentClosedClaims();
      const score = Object.values(attempt.results || {}).filter((value) => value === 'correct').length;
      const wrongOrdinals = questions.filter((question) => ['wrong', 'unanswered'].includes(attempt.results?.[qid(question)])).map((question) => `Q${ordinal(question)}`);
      const uncertainOrdinals = questions.filter((question) => uncertain.has(qid(question))).map((question) => `Q${ordinal(question)}`);

      const lines = [
        'Reading A deep review packet v2',
        'Mode: OPTIONAL_ESCALATION',
        `Object: ${readingKey}`,
        `Source: ${passageMeta || '—'}`,
        `Title: ${passageTitle}`,
        `Score: ${score}/${questions.length}`,
        `Time: ${formatDuration(durationSeconds(attempt))}`,
        `Wrong/unanswered: ${wrongOrdinals.join(', ') || 'none'}`,
        `Uncertain: ${uncertainOrdinals.join(', ') || 'none'}`,
        '',
        'PASSAGE',
        passageText || '—',
        '',
        'ALL-QUESTION OUTCOME MAP'
      ];

      questions.forEach((question) => {
        const id = qid(question);
        const path = (attempt.trajectory?.[id] || []).map((step) => step?.answer).filter(Boolean).join(' → ') || '—';
        const note = attempt.causes?.[id] || '—';
        lines.push(`Q${ordinal(question)} (${id}) · ${attempt.results?.[id] || '—'} · my ${attempt.answers?.[id] || '未答'} · formal ${expected(question).join(', ') || '—'} · uncertain ${uncertain.has(id) ? 'yes' : 'no'} · path ${path} · optional local note ${note}`);
      });

      const expanded = questions.filter((question) => problems.has(qid(question)));
      if (expanded.length) {
        lines.push('', 'PROBLEM QUESTION CONTEXT');
        expanded.forEach((question) => lines.push(...questionBlock(question)));
      }

      lines.push('', 'ACTIVE TRANSFER CLAIMS · opportunistic only');
      if (!pendingClaims.length) lines.push('none');
      else pendingClaims.forEach((claim) => lines.push(`${claim.claimId} · ${claim.statement}`));

      lines.push('', 'RECENT CLOSED CLAIMS · reopen only with direct contradiction');
      if (!reopenCandidates.length) lines.push('none');
      else reopenCandidates.forEach((claim) => lines.push(`${claim.claimId} · ${claim.statement}`));

      lines.push(
        '',
        'REVIEW INSTRUCTION',
        'This escalation was requested because the local result was not cheap to resolve. Diagnose the whole passage first, but stop as soon as the smallest failure sufficient to explain the score-relevant miss is clear. Do not create one review object per wrong question.',
        'Route true lexical failures to LexicalOS; keep Reading representation failures with Reading; keep task-specific option adjudication failures with Reading A. If the learner can already explain a one-off miss after seeing the decisive evidence / contrast, do not manufacture a durable claim.',
        'ACTIVE TRANSFER CLAIMS are opportunistic only: update one only if this passage genuinely tested the same procedure. Their existence is not a reason to lengthen the review.',
        '',
        'REPAIR / RETURN PROTOCOL',
        'Use the smallest useful repair and re-execution only when it changes future behavior or resolves genuine uncertainty. newClaims require a reusable, high-value repaired thread with real repairEvidence. Leave unrelated claims untouched.',
        'KIANOS_OBJECTIVE_RETURN_V1',
        '```json',
        JSON.stringify({ schema: 'kianos.english.objective_review_return.v1', task: TASK, objectId: readingKey, threads: [], newClaims: [], claimUpdates: [] }, null, 2),
        '```'
      );

      return {
        text: lines.join('\n'),
        activeClaimIds: pendingClaims.map((claim) => String(claim.claimId || '')).filter(Boolean),
        reopenCandidateIds: reopenCandidates.map((claim) => String(claim.claimId || '')).filter(Boolean)
      };
    };

    const sync = () => {
      demoteLegacyQuestionBridge();
      const node = ensureHandoff();
      if (!node) return;
      const attempt = readAttempt();
      const problems = problemIds(attempt).length;
      node.hidden = !attempt?.submitted || attempt?.reviewUnlocked === false || problems === 0;
      const status = node.querySelector('[data-reading-passage-copy-status]');
      if (status && problems > 0) status.textContent = `${problems} 个 problem。先快速理解；只有解释不清 / 反复出现时才值得整篇深复盘。`;
    };

    ensureHandoff()?.querySelector('[data-reading-passage-copy-chat]')?.addEventListener('click', async () => {
      const attempt = readAttempt();
      if (!attempt?.submitted || attempt?.reviewUnlocked === false || problemIds(attempt).length === 0) return;
      const status = handoff?.querySelector('[data-reading-passage-copy-status]');
      const packet = buildPacket(attempt);
      try {
        await navigator.clipboard.writeText(packet.text);
        try {
          localStorage.setItem(handoffKey, JSON.stringify({
            schema: 'kianos.english.objective_handoff.v1',
            task: TASK,
            objectId: readingKey,
            mode: 'OPTIONAL_ESCALATION',
            activeClaimIds: packet.activeClaimIds,
            reopenCandidateIds: packet.reopenCandidateIds,
            createdAt: new Date().toISOString()
          }));
          if (status) status.textContent = '已复制给 Chat；能解释得分问题时立即停，不追求流程完整。';
        } catch {
          if (status) status.textContent = '已复制给 Chat，但本机未能保存这次回访信息；这次只做复盘，不更新长期记录。';
        }
      } catch {
        if (status) status.textContent = '复制失败，请稍后再试。';
      }
    });

    readingRoot.addEventListener('kianos:objective-transfer-updated', sync);
    readingRoot.addEventListener('click', () => window.setTimeout(sync, 0));
    window.addEventListener('storage', (event) => {
      if (event.key === TRANSFER_STORE_KEY) sync();
    });
    sync();
  }
</script>