---
const {
  firstHref,
  firstLabel = '开始西综学习',
  resumeIndex = []
} = Astro.props;
---

<section class="xzHomeSection xzHomeContinueBand" data-xizong-home-tools>
  <header class="xzHomeSectionHead">
    <span>继续学习</span>
  </header>

  <a class="xzHomeContinue" data-xizong-continue href={firstHref}>
    <div class="xzHomeContinueCopy">
      <span data-xizong-continue-location>{firstLabel}</span>
      <strong data-xizong-continue-title>从系统导学开始</strong>
      <p data-xizong-continue-detail>第一次进入西综</p>
    </div>
    <div class="xzHomeContinueState">
      <span data-xizong-continue-stage>系统导学</span>
      <strong data-xizong-continue-position>{firstLabel}</strong>
      <b data-xizong-continue-action>开始 →</b>
    </div>
  </a>

  <script type="application/json" data-xizong-home-resume-index set:html={JSON.stringify(resumeIndex)}></script>
</section>

<script>
  import {
    normalizeXizongMemoryState,
    todayMemoryQueue,
    markedFragments,
    activeRepairTasks
  } from '../lib/xizongMemoryModel.mjs';
  import {
    XIZONG_SESSION_KEY,
    activateXizongSessionNext,
    validateXizongSessionInstruction
  } from '../lib/xizongSessionInstruction.mjs';
  import { studyDayAt } from '../lib/studyTimer.mjs';
  import { readXizongPendingChatReturnState } from '../lib/xizongPendingChatReturn.mjs';

  const root = document.querySelector('[data-xizong-home-tools]');
  if (root instanceof HTMLElement) {
    const parse = (value, fallback = null) => {
      try { return JSON.parse(value || '') ?? fallback; } catch { return fallback; }
    };

    const resumeIndex = parse(root.querySelector('[data-xizong-home-resume-index]')?.textContent, []);
    const systems = Array.isArray(resumeIndex) ? resumeIndex : [];
    const last = parse(localStorage.getItem('kianos-xizong-last-location-v1'), null);
    const link = root.querySelector('[data-xizong-continue]');
    const location = root.querySelector('[data-xizong-continue-location]');
    const title = root.querySelector('[data-xizong-continue-title]');
    const detail = root.querySelector('[data-xizong-continue-detail]');
    const stage = root.querySelector('[data-xizong-continue-stage]');
    const position = root.querySelector('[data-xizong-continue-position]');
    const action = root.querySelector('[data-xizong-continue-action]');

    let pendingReturnNext = null;
    try {
      const pendingState = readXizongPendingChatReturnState(localStorage);
      const pendingRows = Object.values(pendingState.pending_by_object || {})
        .filter((row) => typeof row?.return_href === 'string' && row.return_href.startsWith('/xizong/'))
        .sort((a, b) => String(b.received_at || '').localeCompare(String(a.received_at || '')));
      const row = pendingRows[0] || null;
      if (row) pendingReturnNext = {
        href: row.return_href,
        object_id: row.object_id,
        block_id: row.block_id,
        received_at: row.received_at
      };
    } catch {}

    let chatSessionNext = null;
    try {
      const raw = JSON.parse(localStorage.getItem(XIZONG_SESSION_KEY) || 'null');
      const instruction = validateXizongSessionInstruction(raw, studyDayAt(Date.now()));
      const holdoutYears = parse(localStorage.getItem('kianos:xizong:full-paper-holdout-years:v1'), []);
      const result = activateXizongSessionNext(localStorage, instruction, {
        holdoutYears: Array.isArray(holdoutYears) ? holdoutYears : [],
        now: Date.now()
      });
      chatSessionNext = result?.next || null;
    } catch {}

    const setText = (node, value) => {
      if (node) node.textContent = String(value || '');
    };

    const learnerFacingResumeCopy = (value) => String(value || '')
      .replace(/System Recall/gi, '系统回忆')
      .replace(/System Guide/gi, '系统导学')
      .replace(/Block Recall/gi, '模块回忆')
      .replace(/Block Complete/gi, '模块完成')
      .replace(/Block Framework/gi, '模块框架')
      .replace(/KP Recall/gi, '主动回忆')
      .replace(/KP Learn/gi, '知识点学习')
      .replace(/Logic Group/gi, '学习节')
      .replace(/Recall/gi, '回忆')
      .replace(/\bBlock\b/gi, '模块');

    const stageView = (state, block) => {
      const current = String(state?.stage || 'block_learn');
      const groupNo = Math.max(1, Number(state?.groupIndex || 0) + 1);
      const kpNo = Math.max(1, Number(state?.kpIndex || 0) + 1);
      const kpTotal = Math.max(0, Number(block?.kpCount || 0));
      const views = {
        block_learn: ['模块框架', block?.label || '当前模块', '继续 →'],
        source_contact: ['原讲义学习', '原讲义 + 知识点', '继续 →'],
        logic_group: ['学习节', `第 ${groupNo} 节`, '继续 →'],
        kp_learn: ['知识点学习', `第 ${groupNo} 节`, '继续 →'],
        kp_recall: ['主动回忆', kpTotal ? `第 ${Math.min(kpNo, kpTotal)} / ${kpTotal} 个知识点` : `第 ${kpNo} 个知识点`, '继续回忆 →'],
        group_close: ['学习节收口', `第 ${groupNo} 节`, '继续 →'],
        block_recall: ['模块回忆', state?.blockRecallDone ? '本轮已完成' : '等待重建', '继续回忆 →'],
        block_complete: ['模块完成', state?.completed ? '第一轮已完成' : '等待确认', state?.completed ? '查看模块 →' : '完成本轮 →']
      };
      return views[current] || ['继续学习', block?.label || '当前模块', '继续 →'];
    };

    if (pendingReturnNext && link instanceof HTMLAnchorElement) {
      link.href = pendingReturnNext.href;
      setText(location, '西综 · Chat 更新');
      setText(title, '核对当前 Block');
      setText(detail, 'Chat Return 已到达；进入当前 Block 后会用最新学习证据重新校验。');
      setText(stage, '待安全应用');
      setText(position, pendingReturnNext.block_id || '当前 Block');
      setText(action, '继续 →');
    } else if (chatSessionNext && link instanceof HTMLAnchorElement) {
      link.href = chatSessionNext.href;
      setText(location, '西综 · Chat 安排');
      setText(title, chatSessionNext.step?.label || (
        chatSessionNext.step?.kind === 'MEMORY_REVIEW' ? 'Memory 回收'
          : chatSessionNext.step?.kind === 'PRACTICE_SET' ? 'Chat 自选题'
            : '继续当前复习'
      ));
      setText(detail, chatSessionNext.step?.reason || '按当前 Chat 安排继续');
      setText(stage, '当前复习');
      setText(position, `第 ${chatSessionNext.index + 1} 步`);
      setText(action, '继续 →');
    } else if (last?.href && link instanceof HTMLAnchorElement) {
      const system = systems.find((row) => row?.systemId === last.systemId);
      const block = system?.blocks?.find((row) => row?.slug === last.blockSlug || row?.label === last.blockLabel);

      link.href = last.href;
      setText(location, [system?.canonicalId || last.systemCanonical, system?.title || last.systemTitle].filter(Boolean).join(' · ') || '西医综合');

      if (last.resumeKind) {
        setText(title, learnerFacingResumeCopy(last.resumeTitle || '继续上次学习'));
        setText(detail, learnerFacingResumeCopy(last.resumeDetail || '回到上次中断的位置'));
        setText(stage, learnerFacingResumeCopy(last.resumeStage || '继续学习'));
        setText(position, learnerFacingResumeCopy(last.resumePosition || last.resumeTitle || '上次学习位置'));
        setText(action, learnerFacingResumeCopy(last.resumeAction || '继续 →'));
      } else if (block) {
        const stateKey = `kianos-xizong-astro-v2:xizong:${block.blockId}`;
        const blockState = parse(localStorage.getItem(stateKey), {});
        const [stageLabel, stagePosition, actionLabel] = stageView(blockState, block);
        setText(title, `${block.label} · ${block.title}`);
        setText(detail, '回到最近学习位置');
        setText(stage, stageLabel);
        setText(position, stagePosition);
        setText(action, actionLabel);
      } else {
        setText(title, '继续系统导学');
        setText(detail, '回到最近学习位置');
        setText(stage, '系统导学');
        setText(position, `${system?.canonicalId || last.systemCanonical || ''} · ${system?.title || last.systemTitle || last.systemId}`);
        setText(action, '继续 →');
      }

      document.querySelectorAll('[data-xizong-system-entry]').forEach((entry) => {
        const active = Boolean(system) && entry.getAttribute('data-xizong-system-entry') === last.systemId;
        entry.classList.toggle('is-current', active);
        const actionNode = entry.querySelector('[data-xizong-system-action]');
        if (active && actionNode) actionNode.textContent = '当前正在学习';
      });
    }

    const attentionRoot = document.querySelector('[data-xizong-home-attention]');
    if (attentionRoot instanceof HTMLElement) {
      const rawMemory = parse(localStorage.getItem('kianos-xizong-memory-v1'), null);
      if (rawMemory) {
        const memory = normalizeXizongMemoryState(rawMemory);
        const todayCount = todayMemoryQueue(memory).length;
        const markedCount = markedFragments(memory, { reviewRequestedOnly: true }).length;
        const repairCount = activeRepairTasks(memory).length;
        const rows = [
          ['[data-xizong-attention-memory]', '[data-xizong-attention-memory-count]', todayCount],
          ['[data-xizong-attention-marked]', '[data-xizong-attention-marked-count]', markedCount],
          ['[data-xizong-attention-repair]', '[data-xizong-attention-repair-count]', repairCount]
        ];

        let visible = false;
        rows.forEach(([rowSelector, countSelector, count]) => {
          const row = attentionRoot.querySelector(rowSelector);
          const countNode = attentionRoot.querySelector(countSelector);
          if (countNode) countNode.textContent = String(count);
          if (row instanceof HTMLElement) row.hidden = count <= 0;
          if (count > 0) visible = true;
        });
        attentionRoot.hidden = !visible;
      }
    }

    window.addEventListener('kianos:xizong-pending-chat-return', () => {
      window.location.reload();
    });

    window.addEventListener('kianos:private-control-consumed', (event) => {
      const detail = event instanceof CustomEvent ? event.detail : null;
      if (detail?.fresh !== true || detail?.target !== 'xizong.session') return;
      if (!['APPLIED','IDEMPOTENT'].includes(String(detail?.status || ''))) return;
      window.location.reload();
    });
  }
</script>
