---
const base = import.meta.env.BASE_URL;
const { firstHref, firstLabel = '开始西综学习', memoryHref = `${base}xizong/memory/` } = Astro.props;
---
<section class="xzHomeActionBar" data-xizong-home-tools>
  <a class="xzHomeContinue" data-xizong-continue href={firstHref}>
    <span>Continue</span>
    <strong data-xizong-continue-title>{firstLabel}</strong>
    <small data-xizong-continue-meta>第一次从 System 开始；之后自动回到最近打开的位置。</small>
  </a>
  <a class="xzHomeMemory" data-xizong-memory-entry href={memoryHref}>
    <span>Memory</span>
    <strong>滚动复习工作区</strong>
    <small>Today · Core · Precision · Marked · Repair</small>
    <b>进入 Memory →</b>
  </a>
  <aside class="xzHomeMethod">
    <span>How it works</span>
    <strong>讲义连续学习，KianOS 负责框架、Recall 与修补</strong>
    <p>平时沿学习主线走；只有不稳、Wrong / Uncertain 或需要回 Chat 深挖时，复习与修补入口才出现。</p>
  </aside>
</section>

<script>
  const root = document.querySelector('[data-xizong-home-tools]');
  if (root instanceof HTMLElement) {
    let last = null;
    try { last = JSON.parse(localStorage.getItem('kianos-xizong-last-location-v1') || 'null'); } catch {}
    const link = root.querySelector('[data-xizong-continue]');
    if (last?.href && link instanceof HTMLAnchorElement) {
      link.href = last.href;
      const title = root.querySelector('[data-xizong-continue-title]');
      const meta = root.querySelector('[data-xizong-continue-meta]');
      if (title) title.textContent = last.blockTitle
        ? `${last.blockLabel || ''} · ${last.blockTitle}`
        : `${last.systemCanonical || ''} · ${last.systemTitle || last.systemId}`;
      if (meta) meta.textContent = last.blockTitle
        ? `${last.systemCanonical || last.systemId} · 最近 Block`
        : `${last.systemCanonical || last.systemId} · 最近 System`;
    }
  }
</script>
