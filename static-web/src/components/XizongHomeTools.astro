---
const { firstHref, firstLabel = '开始西综学习' } = Astro.props;
---
<section class="xizongHomeTools" data-xizong-home-tools>
  <a class="xizongContinue" data-xizong-continue href={firstHref}>
    <span>Continue</span>
    <strong data-xizong-continue-title>{firstLabel}</strong>
    <small data-xizong-continue-meta>第一次从 System 开始；之后自动回到最近打开的位置。</small>
  </a>
  <aside>
    <span>How it works</span>
    <strong>讲义连续学习，KianOS 负责框架、Recall 与修补</strong>
    <p>平时沿学习主线走；只有不稳、Wrong / Uncertain 或需要回 Chat 深挖时，复习与修补入口才出现。</p>
  </aside>
</section>

<script>
  const root = document.querySelector('[data-xizong-home-tools]');
  if (root instanceof HTMLElement) {
    let last = null;
    try { last = JSON.parse(localStorage.getItem('kianos-xizong-last-location-v1') || 'null'); } catch {}
    const link = root.querySelector('[data-xizong-continue]');
    if (last?.href && link instanceof HTMLAnchorElement) {
      link.href = last.href;
      const title = root.querySelector('[data-xizong-continue-title]');
      const meta = root.querySelector('[data-xizong-continue-meta]');
      if (title) title.textContent = last.blockTitle
        ? `${last.blockLabel || ''} · ${last.blockTitle}`
        : `${last.systemCanonical || ''} · ${last.systemTitle || last.systemId}`;
      if (meta) meta.textContent = last.blockTitle
        ? `${last.systemCanonical || last.systemId} · 最近 Block`
        : `${last.systemCanonical || last.systemId} · 最近 System`;
    }
  }
</script>

<style>
  .xizongHomeTools{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:9px;margin-top:9px}.xizongContinue,.xizongHomeTools aside{padding:17px 19px;border:1px solid var(--study-line);border-radius:11px;background:#fff;color:inherit}.xizongContinue{display:grid;gap:5px;text-decoration:none}.xizongContinue>span,.xizongHomeTools aside>span{color:var(--study-green);font-size:10.5px;font-weight:850;letter-spacing:.07em;text-transform:uppercase}.xizongContinue strong,.xizongHomeTools aside strong{font-size:18px;line-height:1.4}.xizongContinue small,.xizongHomeTools aside p{color:var(--study-muted);font-size:13px;line-height:1.58}.xizongHomeTools aside{display:grid;gap:5px}.xizongHomeTools aside p{margin:0}@media(max-width:760px){.xizongHomeTools{grid-template-columns:1fr}}
</style>