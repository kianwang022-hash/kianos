  .politicsKnowledgeReview{padding-left:26px;border-left:1px solid var(--politics-line)}.politicsKnowledgeReview>header{display:flex;align-items:center;justify-content:space-between;gap:12px}.politicsKnowledgeReview>header>span{color:#75877f;font-size:12px}.politicsChatExplanation{padding-bottom:14px;border-bottom:1px solid var(--politics-line)}.politicsReviewSources{display:grid;gap:10px}.politicsReviewSources>div{display:grid;gap:8px}.politicsReviewSources article{display:grid;gap:5px;padding:10px 0;border-top:1px solid #edf1ef}.politicsReviewSources article:first-child{border-top:0}.politicsReviewSources strong{font-size:13px}.politicsReviewSources code{color:#82918b;font-size:10px;overflow-wrap:anywhere}.politicsReviewSources p{color:#52675f;font-size:13px}.politicsReturnUnit{display:inline-flex;justify-self:start;color:var(--politics-green);font-size:13px;font-weight:720;text-decoration:none}
