  @media(max-width:760px){.politicsMode{overflow-x:auto;grid-template-columns:repeat(4,minmax(80px,1fr))}.politicsFilters>div{align-items:stretch;flex-direction:column}.politicsFilters label{flex-basis:auto}.politicsFilters>div>button{margin-left:0}.politicsSessionBar{grid-template-columns:1fr}.politicsQuestionMeta{align-items:flex-start}.politicsQuestionMeta .favorite{margin-left:0}.politicsOptions{grid-template-columns:1fr}.politicsSubmitRow{grid-template-columns:1fr}.politicsStem{font-size:16px}.politicsQuestionCard{padding:18px 14px}.politicsReview{padding:16px}}
