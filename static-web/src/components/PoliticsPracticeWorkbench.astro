---
const { catalog, base = '/' } = Astro.props;
import { publicPracticeCatalog } from '../lib/politicsPracticeView.mjs';
const serializedCatalog = JSON.stringify(publicPracticeCatalog(catalog)).replace(/</g, '\\u003c');
---
<section class="politicsWorkbench" data-politics-practice>
  <header class="politicsWorkbenchHeader">
    <div class="politicsHeroCopy">
      <a class="backLink" href={`${base}politics/`}>← Politics</a>
      <h1>肖1000</h1>
      <div class="politicsHeroActions">
        <button type="button" data-resume-session hidden>继续上次题组</button>
        <button type="button" data-finish-paused hidden>结束本组</button>
      </div>
    </div>
    <div class="politicsHeadlineStats" aria-label="当前训练范围">
      <span><small>当前可用</small><strong data-available-count>—</strong></span>
      <span><small>本组题数</small><strong data-target-count>20</strong></span>
    </div>
  </header>

  <nav class="politicsMode" aria-label="刷题模式">
    <button type="button" class="active" data-mode-value="practice"><span>普通练习</span></button>
    <button type="button" data-mode-value="random"><span>随机</span></button>
    <button type="button" data-mode-value="wrong"><span>错题</span></button>
    <button type="button" data-mode-value="favorite"><span>收藏</span></button>
    <button type="button" data-mode-value="review"><span>回访错题与不确定</span></button>
  </nav>
  <select data-filter-mode hidden aria-hidden="true">
    <option value="practice">practice</option>
    <option value="random">random</option>
    <option value="wrong">wrong</option>
    <option value="favorite">favorite</option>
    <option value="review">review</option>
  </select>

  <details class="politicsFilters" open data-practice-setup>
    <summary>学习范围 <span data-scope-summary>选择已经在原讲义学过的范围。</span></summary>
    <div>
      <label><span>科目</span><select data-filter-subject><option value="all">全部</option></select></label>
      <label><span>章节</span><select data-filter-chapter><option value="all">全部章节</option></select></label>
      <label><span>学习单元</span><select data-filter-unit><option value="all">全部学习单元</option></select></label>
      <label><span>题型</span><select data-filter-type><option value="all">全部题型</option><option value="single">单选</option><option value="multiple">多选</option></select></label>
      <label><span>题数</span><select data-filter-count><option>5</option><option>10</option><option selected>20</option><option>40</option></select></label>
    </div>
    <div class="practiceSetupActions">
      <label class="practiceLearned"><input type="checkbox" data-learned-scope /> 所选范围已在原讲义学过，可以开始配套题</label>
      <button type="button" class="primary" data-start-session data-start-session-inline>开始做题 →</button>
    </div>
  </details>

  <p class="practiceAvailability" data-practice-unavailable hidden></p>

  <div class="politicsError" data-practice-error role="alert" hidden></div>
  <button type="button" data-retry-save hidden>重试保存本次作答</button>

  <section class="practiceSession" data-practice-session hidden>
    <div class="politicsSessionBar">
      <span data-session-scope>当前题组</span>
      <div><i data-session-progress></i></div>
      <strong><b data-session-current>0</b> / <b data-session-total>0</b></strong>
      <div class="practiceAttemptTools">
        <div class="politicsPracticeMode" data-interaction-mode role="group" aria-label="答题模式">
          <button type="button" class="active" data-interaction-normal>普通模式</button>
          <button type="button" data-interaction-fast>快刷模式</button>
        </div>
        <div class="politicsOptionalActions" role="group" aria-label="本题标记">
        <button type="button" class="favorite" data-favorite aria-pressed="false">☆ 收藏</button>
          <button type="button" data-uncertain aria-pressed="false">△ 不确定</button>
          <button type="button" data-discussion aria-pressed="false">待讨论</button>
        </div>
      </div>
      <button type="button" data-exit-session>退出题组</button>
    </div>

    <article class="politicsQuestionCard" data-question-card tabindex="-1">
      <header class="politicsQuestionMeta">
        <span data-question-location></span>
        <strong>第 <b data-question-number>—</b> 题 · <i data-question-type></i></strong>
        <small class="politicsQuestionProgress"><b data-question-progress>1</b> / <b data-question-total>0</b></small>
      </header>

      <p class="politicsStem" data-question-stem></p>
      <div class="politicsOptions" data-question-options></div>

      <div class="politicsSubmitRow">
        <span class="politicsTimer" data-question-timer>0:00</span>
        <small class="practiceKeyHint">A–D 选择 · Enter 提交</small>
        <small class="politicsFastHint" data-fast-hint hidden>单选即答；提交后看背面</small>
        <button type="button" class="politicsConfirmAnswer primary" data-submit>确认答案</button>
      </div>
      <div class="politicsFastFeedback" data-fast-feedback role="status" hidden></div>
    </article>

    <section class="politicsReview" data-submitted-result tabindex="-1" hidden>
      <details class="practiceQuestionReference"><summary>回看题面</summary><div data-result-question></div></details>
      <div class="politicsResultLayout">
        <div class="politicsResultSummaryPane">
          <div class="politicsResultHeadline"><span data-result-status></span></div>
          <section class="politicsResultTakeaway">
            <h2>一句话带走</h2>
            <p data-takeaway></p>
          </section>
          <section class="politicsResultAnswers">
            <strong>你的答案：<b data-result-selected></b></strong>
            <strong>正确答案：<b data-result-answer></b></strong>
            <small data-result-delta-row hidden><span data-result-delta></span></small>
            <p data-result-uncertain hidden>△ 本次作答标记为不确定</p>
            <p data-result-discussion hidden>✓ 已标记，留待讨论</p>
          </section>
          <div class="politicsOptionalActions">
            <button type="button" data-result-favorite aria-pressed="false">☆ 收藏</button>
            <button type="button" data-result-discussion-toggle aria-pressed="false">待讨论</button>
          </div>
          <section class="politicsCausePicker" data-cause-picker hidden>
            <span>你觉得主要是哪里出了问题？（可选）</span>
            <div>
              <button type="button" data-cause="memory">没记住</button>
              <button type="button" data-cause="understanding">没想明白</button>
              <button type="button" data-cause="options">选项没辨清</button>
              <button type="button" data-cause="careless">看错 / 粗心</button>
            </div>
          </section>
          <label class="politicsAttemptNote">
            <span>备注</span>
            <textarea rows="3" data-note placeholder="记录你卡住的点（可选）……"></textarea>
            <small data-note-status role="status" aria-live="polite"></small>
          </label>
        </div>

        <section class="politicsKnowledgeReview" aria-label="知识回看">
          <section class="politicsChatExplanation" data-chat-explanation-block>
            <h2>理解这道题</h2>
            <p data-chat-explanation></p>
          </section>
          <section class="politicsReviewSources">
            <h2>对应乘风考点</h2>
            <div class="politicsExactLocator" data-chengfeng-locator hidden></div>
            <div data-review-sources></div>
          </section>
          <div class="politicsReviewActions">
            <a class="politicsReturnUnit" data-return-unit href="#">← 返回当前学习单元</a>
            <button type="button" class="next primary" data-next-question>下一题</button>
          </div>
        </section>
      </div>
    </section>
  </section>

  <section class="politicsSessionComplete" data-session-complete hidden>
    <span data-complete-label>本组完成</span>
    <h2 data-complete-title></h2>
    <div class="completeStats">
      <strong data-complete-score></strong>
      <small data-complete-time></small>
      <small data-complete-wrong></small>
      <small data-complete-causes></small>
    </div>
    <div>
      <button type="button" class="primary" data-start-another>再开一组</button>
      <a data-complete-return href={`${base}politics/`}>返回学习入口</a>
    </div>
  </section>

  <script type="application/json" data-politics-practice-catalog set:html={serializedCatalog}></script>
</section>

<script>
  import { initPoliticsPractice } from '../lib/politicsPracticeClient.mjs';
  initPoliticsPractice(document.querySelector('[data-politics-practice]'));
</script>

<style is:global>
  .politicsWorkbench{--politics-ink:#17342c;--politics-green:#246a55;--politics-soft:#edf6f1;--politics-line:#dce7e1;display:grid;gap:14px;color:var(--politics-ink)}
  .politicsWorkbench button,.politicsWorkbench select,.politicsWorkbench textarea{font:inherit}.politicsWorkbench button{cursor:pointer}.politicsWorkbench button:disabled{opacity:.5;cursor:not-allowed}.politicsWorkbench .backLink{color:#70837b;text-decoration:none;font-size:13px}
  .politicsWorkbenchHeader,.politicsFilters,.politicsQuestionCard,.politicsReview,.politicsSessionComplete{border:1px solid var(--politics-line);border-radius:18px;background:#fff;box-shadow:0 12px 34px rgba(23,52,44,.045)}
  .politicsWorkbenchHeader{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(270px,.65fr);gap:28px;padding:26px;background:linear-gradient(135deg,#fbfdfc 0%,#f1f8f4 100%)}
  .politicsHeroCopy{display:grid;align-content:start;gap:6px}.politicsHeroCopy>span{color:var(--politics-green);font-size:11px;font-weight:850;letter-spacing:.11em}.politicsHeroCopy h1{margin:0;font-family:inherit;font-size:32px;line-height:1.2}.politicsHeroCopy p{max-width:760px;margin:2px 0 0;color:#687c74;font-size:13px;line-height:1.7}
  .politicsHeroActions{display:flex;gap:8px;margin-top:10px}.politicsHeroActions button,.politicsFilters button,.politicsSessionBar button,.politicsPracticeMode button,.politicsOptionalActions button,.politicsConfirmAnswer,.politicsKnowledgeReview button,.politicsSessionComplete button{min-height:38px;padding:8px 12px;border:1px solid #cbd9d2;border-radius:9px;background:#fff;color:#35584d;font-weight:720}.politicsWorkbench .primary{border-color:var(--politics-green)!important;background:var(--politics-green)!important;color:#fff!important}
  .politicsHeadlineStats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;align-self:center}.politicsHeadlineStats span{padding:14px;border:1px solid rgba(36,106,85,.11);border-radius:13px;background:rgba(255,255,255,.82)}.politicsHeadlineStats small,.politicsHeadlineStats strong{display:block}.politicsHeadlineStats small{color:#7e8f88;font-size:10px}.politicsHeadlineStats strong{margin-top:4px;font-family:inherit;font-size:25px}
  .politicsMode{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;padding:5px;border-radius:13px;background:#eef3f0}.politicsMode button{min-height:38px;border:0;border-radius:9px;background:transparent;color:#697a74}.politicsMode button.active{background:#fff;color:var(--politics-green);box-shadow:0 2px 10px rgba(23,52,44,.08);font-weight:800}
  .politicsFilters{padding:0 18px}.politicsFilters summary{display:flex;justify-content:space-between;gap:18px;padding:14px 0;color:#546b63;font-size:12px;font-weight:760;cursor:pointer}.politicsFilters summary span{overflow:hidden;color:#87958f;font-weight:500;text-overflow:ellipsis;white-space:nowrap}.politicsFilters>div{display:flex;flex-wrap:wrap;align-items:end;gap:12px;padding:0 0 16px}.politicsFilters label{display:grid;flex:1 1 150px;gap:5px}.politicsFilters label span{color:#7c8d86;font-size:10px;font-weight:720}.politicsFilters select{min-height:40px;padding:8px 28px 8px 10px;border:1px solid #ccd9d3;border-radius:9px;background:#fff;color:#29463d}.politicsFilters>div>button{margin-left:auto}
  .politicsError{padding:12px 15px;border:1px solid #efc6bd;border-radius:11px;background:#fff5f2;color:#a24739;font-size:12px}
  .practiceSession{display:grid;gap:12px}.politicsSessionBar{display:grid;grid-template-columns:auto minmax(160px,1fr) auto auto;align-items:center;gap:12px;padding:9px 12px;border-radius:12px;background:#f1f6f3;color:#547067;font-size:11px}.politicsSessionBar>div{height:6px;overflow:hidden;border-radius:999px;background:#dce7e1}.politicsSessionBar i{display:block;height:100%;border-radius:inherit;background:var(--politics-green);transition:width .2s ease}.politicsSessionBar strong{white-space:nowrap}.politicsSessionBar button{min-height:32px;padding:5px 9px;background:transparent}
  .politicsQuestionCard{display:grid;gap:20px;padding:clamp(20px,3vw,30px)}.politicsQuestionMeta{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.politicsQuestionMeta>span{padding:5px 8px;border-radius:999px;background:var(--politics-soft);color:var(--politics-green);font-size:11px;font-weight:820}.politicsQuestionMeta>strong{color:#415d54;font-size:12px}.politicsQuestionMeta>strong i{font-style:normal}.politicsQuestionProgress{color:#7e8f88}.politicsQuestionMeta .favorite{margin-left:auto;padding:7px 9px;border:0;border-radius:8px;background:#f6f8f7;color:#73827d}.politicsQuestionMeta .favorite.active{background:#fff3cf;color:#8a6711}
  .politicsPracticeMode{display:flex;gap:3px;padding:3px;border-radius:10px;background:#eef3f0}.politicsPracticeMode button{min-height:30px;padding:5px 9px;border:0;background:transparent;color:#71827b;font-size:11px}.politicsPracticeMode button.active{background:#fff;color:var(--politics-green);box-shadow:0 1px 6px rgba(23,52,44,.08)}
  .politicsStem{max-width:96ch;margin:2px 0;color:#1c332b;font-size:18px;font-weight:650;line-height:1.72}.politicsOptions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 14px}.politicsOptions button{display:grid;grid-template-columns:32px minmax(0,1fr);gap:10px;align-items:start;min-height:70px;padding:14px 16px;border:1px solid #d9e3de;border-radius:12px;background:#fbfcfb;color:#40534c;text-align:left;font-size:15px;line-height:1.55}.politicsOptions button:hover{border-color:#8fb5a5;background:#f6fbf8}.politicsOptions button b{display:grid;place-items:center;width:28px;height:28px;border-radius:9px;background:#edf2ef;color:#487064}.politicsOptions button.selected{border-color:#4b8975;background:#edf6f2;box-shadow:0 0 0 1px #4b8975 inset}.politicsOptions button.selected b{background:#367862;color:#fff}
  .politicsSubmitRow{display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:12px;padding-top:14px;border-top:1px solid var(--politics-line)}.politicsOptionalActions{display:flex;align-items:center;gap:6px;flex-wrap:wrap}.politicsOptionalActions small{margin-right:3px;color:#84918c}.politicsOptionalActions button{min-height:32px;padding:5px 9px;background:#fff;color:#65776f;font-size:11px}.politicsOptionalActions button.active{border-color:var(--politics-green);background:var(--politics-soft);color:var(--politics-green)}.politicsTimer{font-variant-numeric:tabular-nums;font-weight:760;color:#526a61}.politicsFastHint{color:#71827b}.politicsFastFeedback{padding:10px 12px;border-radius:9px;background:#edf7f2;color:#246a55;font-weight:760}
  .politicsReview{padding:20px}.politicsReview[data-outcome="wrong"]{background:#fff9f7;border-color:#ead7d1}.politicsResultLayout{display:grid;grid-template-columns:minmax(280px,34%) minmax(0,1fr);gap:28px}.politicsResultSummaryPane,.politicsKnowledgeReview{display:grid;align-content:start;gap:16px;min-width:0}.politicsResultHeadline span{font-size:22px;font-weight:850;color:#24714f}.politicsReview[data-outcome="wrong"] .politicsResultHeadline span{color:#a44c3e}.politicsReview[data-outcome="uncertain"] .politicsResultHeadline span{color:#8b6a21}
  .politicsResultTakeaway{padding:14px 0;border-top:1px solid var(--politics-line);border-bottom:1px solid var(--politics-line)}.politicsResultTakeaway h2,.politicsKnowledgeReview h2{margin:0 0 7px;font-size:15px}.politicsResultTakeaway p,.politicsKnowledgeReview p{margin:0;font-size:14px;line-height:1.72}.politicsResultAnswers{display:grid;gap:7px}.politicsResultAnswers strong{font-size:13px}.politicsResultAnswers strong b{color:#2e5c4c}.politicsResultAnswers small{color:#a04c3d}.politicsResultAnswers p{margin:0;color:#6e7f78;font-size:12px}
  .politicsCausePicker{display:grid;gap:8px}.politicsCausePicker>span{color:#7c8b86;font-size:11px}.politicsCausePicker>div{display:flex;gap:6px;flex-wrap:wrap}.politicsCausePicker button{padding:6px 9px;border:1px solid #e0cdc7;border-radius:999px;background:#fff;color:#78645e;font-size:11px}.politicsCausePicker button.active{border-color:#a86152;background:#a86152;color:#fff}.politicsAttemptNote{display:grid;gap:6px}.politicsAttemptNote>span{color:#7c8d86;font-size:11px}.politicsAttemptNote textarea{min-height:86px;padding:10px;border:1px solid #d5e0da;border-radius:9px;background:#fff;color:#314c43;resize:vertical;line-height:1.55}.politicsAttemptNote small{color:#87958f;font-size:10px}
  .politicsKnowledgeReview{padding-left:26px;border-left:1px solid var(--politics-line)}.politicsKnowledgeReview>header{display:flex;align-items:center;justify-content:space-between;gap:12px}.politicsKnowledgeReview>header>span{color:#75877f;font-size:12px}.politicsChatExplanation{padding-bottom:14px;border-bottom:1px solid var(--politics-line)}.politicsReviewSources{display:grid;gap:10px}.politicsReviewSources>div{display:grid;gap:8px}.politicsReviewSources article{display:grid;gap:5px;padding:10px 0;border-top:1px solid #edf1ef}.politicsReviewSources article:first-child{border-top:0}.politicsReviewSources strong{font-size:13px}.politicsReviewSources code{color:#82918b;font-size:10px;overflow-wrap:anywhere}.politicsReviewSources p{color:#52675f;font-size:13px}.politicsReturnUnit{display:inline-flex;justify-self:start;color:var(--politics-green);font-size:13px;font-weight:720;text-decoration:none}
  .politicsSessionComplete{display:grid;gap:14px;padding:28px}.politicsSessionComplete>span{color:var(--politics-green);font-size:12px;font-weight:800}.politicsSessionComplete h2{margin:0;font-size:28px}.completeStats{display:flex;gap:18px;align-items:baseline;flex-wrap:wrap}.completeStats strong{font-size:23px}.completeStats small{color:#73847d}.politicsSessionComplete>div:last-child{display:flex;gap:10px;align-items:center}.politicsSessionComplete a{color:var(--politics-green);font-weight:720;text-decoration:none}
  @media(max-width:980px){.politicsWorkbenchHeader{grid-template-columns:1fr}.politicsResultLayout{grid-template-columns:1fr}.politicsKnowledgeReview{padding-left:0;padding-top:18px;border-left:0;border-top:1px solid var(--politics-line)}}
  @media(max-width:760px){.politicsMode{overflow-x:auto;grid-template-columns:repeat(4,minmax(80px,1fr))}.politicsFilters>div{align-items:stretch;flex-direction:column}.politicsFilters label{flex-basis:auto}.politicsFilters>div>button{margin-left:0}.politicsSessionBar{grid-template-columns:1fr}.politicsQuestionMeta{align-items:flex-start}.politicsQuestionMeta .favorite{margin-left:0}.politicsOptions{grid-template-columns:1fr}.politicsSubmitRow{grid-template-columns:1fr}.politicsStem{font-size:16px}.politicsQuestionCard{padding:18px 14px}.politicsReview{padding:16px}}
  /* Retain the baseline two-area result; let task content lead the Mac canvas. */
  .politicsWorkbenchHeader{grid-template-columns:minmax(0,1fr) auto;padding:16px 20px;background:#fff;box-shadow:none;border-radius:12px;gap:18px}
  .politicsHeroCopy{gap:4px}.politicsHeroCopy h1{font-family:inherit;font-size:24px}.politicsHeroCopy>span{display:none}.politicsHeroCopy p{font-size:14px;color:#52675f}.politicsHeroActions{margin-top:6px}
  .politicsHeadlineStats{display:flex;gap:24px}.politicsHeadlineStats span{border:0;padding:0;background:none}.politicsHeadlineStats small{font-size:12px}.politicsHeadlineStats strong{font:600 22px/1.4 var(--study-font)}
  .politicsWorkbench:is([data-active],[data-completed]) .politicsWorkbenchHeader{padding:0 2px;border:0;background:none}.politicsWorkbench:is([data-active],[data-completed]) .politicsHeroCopy{display:flex;align-items:center;gap:16px}.politicsWorkbench:is([data-active],[data-completed]) .politicsHeroCopy h1{font-size:18px}.politicsWorkbench:is([data-active],[data-completed]) .politicsHeroCopy p,.politicsWorkbench:is([data-active],[data-completed]) .politicsHeroActions,.politicsWorkbench:is([data-active],[data-completed]) .politicsHeadlineStats,.politicsWorkbench:is([data-active],[data-completed]) .politicsMode{display:none}
  .politicsFilters label span,.politicsFilters summary,.politicsSessionBar,.politicsQuestionMeta>strong,.politicsPracticeMode button,.politicsOptionalActions button,.politicsAttemptNote>span,.politicsAttemptNote small,.politicsCausePicker>span,.politicsCausePicker button{font-size:13px}
  .politicsFilters label{min-width:0}.politicsFilters select{width:100%;max-width:100%}.politicsFilters .practiceLearned{display:flex;align-items:center;gap:8px;padding:0 0 16px;font-size:14px;color:#415d54}.practiceLearned input{flex:0 0 auto;width:16px;height:16px;margin:0;accent-color:#246a55}
  .practiceAvailability{margin:0;color:#64746c;font-size:13px}.politicsWorkbench:is([data-active],[data-completed]) .practiceAvailability{display:none}
  .politicsSessionBar{grid-template-columns:minmax(0,1fr) 100px auto auto}.politicsSessionBar>span{overflow-wrap:anywhere}.politicsQuestionCard,.politicsReview{box-shadow:none;border-radius:12px}
  .politicsStem{font-size:20px;line-height:1.8;white-space:pre-wrap}.politicsOptions button{font-size:17px;line-height:1.65;border-radius:8px}
  .politicsResultLayout{grid-template-columns:minmax(270px,32%) minmax(0,1fr);gap:24px}.politicsResultTakeaway p,.politicsKnowledgeReview p{font-size:16px;line-height:1.85;white-space:pre-wrap;overflow-wrap:anywhere}.politicsResultAnswers strong{font-size:15px}.politicsChatExplanation{white-space:normal}
  .practiceQuestionReference{padding:0 0 14px;margin-bottom:16px;border-bottom:1px solid var(--politics-line);font-size:15px;line-height:1.8}.practiceQuestionReference summary{cursor:pointer;color:#52675f}.practiceQuestionReference p{white-space:pre-wrap}
  .politicsReviewSources details{padding:10px 0;border-top:1px solid var(--politics-line)}.politicsReviewSources summary{font-size:14px;cursor:pointer}.politicsReviewSources a{font-size:14px;color:var(--politics-green)}
  .politicsWorkbench :is(button,a,input,select,textarea,summary):focus-visible{outline:3px solid #476b97;outline-offset:3px}.politicsWorkbench :is(button,a){transition:background-color 120ms ease,border-color 120ms ease}.politicsError{font-size:14px}
  .politicsKnowledgeReview>header{position:sticky;top:74px;z-index:1;background:#fff;padding:4px 0}.politicsReview[data-outcome="wrong"] .politicsKnowledgeReview>header{background:#fff9f7}
  @media(max-width:980px){.politicsResultLayout{grid-template-columns:1fr}.politicsWorkbenchHeader{grid-template-columns:1fr}.politicsKnowledgeReview{padding-left:0}}
  @media(max-width:760px){.politicsSessionBar{grid-template-columns:1fr auto}.politicsSessionBar>div{display:none}.politicsStem{font-size:18px}.politicsHeadlineStats{display:none}}
  /* Retained compact setup; P10/P11 below own the active composition. */
  .politicsWorkbench{gap:12px}
