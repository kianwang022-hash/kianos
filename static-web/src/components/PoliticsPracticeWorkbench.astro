---
const { catalog, base = '/' } = Astro.props;
const serializedCatalog = JSON.stringify(catalog).replace(/</g, '\u003c');
---
<section class="politicsWorkbench" data-politics-practice>
  <header class="politicsWorkbenchHeader">
    <div class="politicsHeroCopy">
      <a class="backLink" href={`${base}politics/`}>← Politics</a>
      <span>本单元配套题</span>
      <h1>肖1000训练</h1>
      <p>沿用 Legacy 刷题工作台的交互：选范围 → 连续作答 → 题后复盘。题干、答案与题目归属来自 Current；题后只展示一句话带走、AI 精炼解析与 Current 来源。</p>
      <div class="politicsHeroActions">
        <button type="button" class="primary" data-start-session>按当前范围开始</button>
        <button type="button" data-resume-session hidden>继续上次题组</button>
      </div>
    </div>
    <div class="politicsHeadlineStats" aria-label="当前训练范围">
      <span><small>当前可用</small><strong data-available-count>—</strong></span>
      <span><small>本组题数</small><strong data-target-count>20</strong></span>
    </div>
  </header>

  <nav class="politicsMode" aria-label="刷题模式">
    <button type="button" class="active" data-mode-value="practice"><span>继续</span></button>
    <button type="button" data-mode-value="random"><span>随机</span></button>
    <button type="button" data-mode-value="wrong"><span>错题</span></button>
    <button type="button" data-mode-value="favorite"><span>收藏</span></button>
  </nav>
  <select data-filter-mode hidden aria-hidden="true">
    <option value="practice">practice</option>
    <option value="random">random</option>
    <option value="wrong">wrong</option>
    <option value="favorite">favorite</option>
  </select>

  <details class="politicsFilters" open data-practice-setup>
    <summary>学习范围 <span data-scope-summary>按 Current Question Truth 选择训练范围。</span></summary>
    <div>
      <label><span>科目</span><select data-filter-subject><option value="all">全部</option></select></label>
      <label><span>章节</span><select data-filter-chapter><option value="all">全部章节</option></select></label>
      <label><span>Natural Unit</span><select data-filter-unit><option value="all">当前范围全部 Unit</option></select></label>
      <label><span>题型</span><select data-filter-type><option value="all">全部题型</option><option value="single">单选</option><option value="multiple">多选</option></select></label>
      <label><span>题数</span><select data-filter-count><option>5</option><option>10</option><option selected>20</option><option>40</option></select></label>
      <button type="button" class="primary" data-start-session-inline>按此范围开始训练</button>
    </div>
  </details>

  <div class="politicsError" data-practice-error role="alert" hidden></div>

  <section class="practiceSession" data-practice-session hidden>
    <div class="politicsSessionBar">
      <span data-session-scope>当前题组</span>
      <div><i data-session-progress></i></div>
      <strong><b data-session-current>0</b> / <b data-session-total>0</b></strong>
      <button type="button" data-exit-session>退出题组</button>
    </div>

    <article class="politicsQuestionCard" data-question-card>
      <header class="politicsQuestionMeta">
        <span data-question-location></span>
        <strong>第 <b data-question-number>—</b> 题 · <i data-question-type></i></strong>
        <div class="politicsPracticeMode" data-interaction-mode role="group" aria-label="答题模式">
          <button type="button" class="active" data-interaction-normal>普通模式</button>
          <button type="button" data-interaction-fast>快刷模式</button>
        </div>
        <small class="politicsQuestionProgress"><b data-question-progress>1</b> / <b data-question-total>0</b></small>
        <button type="button" class="favorite" data-favorite aria-pressed="false">☆ 收藏</button>
      </header>

      <p class="politicsStem" data-question-stem></p>
      <div class="politicsOptions" data-question-options></div>

      <div class="politicsSubmitRow">
        <div class="politicsOptionalActions">
          <small>可选</small>
          <button type="button" data-uncertain aria-pressed="false">△ 不确定</button>
          <button type="button" data-discussion aria-pressed="false">标记此题</button>
        </div>
        <span class="politicsTimer" data-question-timer>0:00</span>
        <small class="politicsFastHint" data-fast-hint hidden>单选即答；错题停留复盘</small>
        <button type="button" class="politicsConfirmAnswer primary" data-submit>确认答案</button>
      </div>
      <div class="politicsFastFeedback" data-fast-feedback role="status" hidden></div>
    </article>

    <section class="politicsReview" data-submitted-result hidden>
      <div class="politicsResultLayout">
        <div class="politicsResultSummaryPane">
          <div class="politicsResultHeadline"><span data-result-status></span></div>
          <section class="politicsResultTakeaway">
            <h2>一句话带走</h2>
            <p data-takeaway></p>
          </section>
          <section class="politicsResultAnswers">
            <strong>你的答案：<b data-result-selected></b></strong>
            <strong>正确答案：<b data-result-answer></b></strong>
            <small data-result-delta-row hidden><span data-result-delta></span></small>
            <p data-result-uncertain hidden>△ 本次作答标记为不确定</p>
            <p data-result-discussion hidden>✓ 已标记，留待讨论</p>
          </section>
          <section class="politicsCausePicker" data-cause-picker hidden>
            <span>你觉得主要是哪里出了问题？（可选）</span>
            <div>
              <button type="button" data-cause="memory">没记住</button>
              <button type="button" data-cause="understanding">没想明白</button>
              <button type="button" data-cause="options">选项没辨清</button>
              <button type="button" data-cause="careless">看错 / 粗心</button>
            </div>
          </section>
          <label class="politicsAttemptNote">
            <span>备注</span>
            <textarea rows="3" data-note placeholder="今晚想问 Chat / 自己卡住的点……"></textarea>
            <small data-note-status></small>
          </label>
        </div>

        <section class="politicsKnowledgeReview" aria-label="知识回看">
          <header>
            <span>知识回看</span>
            <button type="button" class="next primary" data-next-question>下一题</button>
          </header>
          <section class="politicsChatExplanation" data-chat-explanation-block>
            <h2>理解这道题</h2>
            <p data-chat-explanation></p>
          </section>
          <section class="politicsReviewSources">
            <h2>对应来源</h2>
            <div data-review-sources></div>
          </section>
          <a class="politicsReturnUnit" data-return-unit href="#">← 返回当前 Natural Unit</a>
        </section>
      </div>
    </section>
  </section>

  <section class="politicsSessionComplete" data-session-complete hidden>
    <span>本组完成</span>
    <h2 data-complete-title></h2>
    <div class="completeStats">
      <strong data-complete-score></strong>
      <small data-complete-time></small>
      <small data-complete-wrong></small>
    </div>
    <div>
      <button type="button" class="primary" data-start-another>再开一组</button>
      <a href={`${base}politics/`}>返回 Politics</a>
    </div>
  </section>

  <script type="application/json" data-politics-practice-catalog set:html={serializedCatalog}></script>
</section>

<script>
  import { recordPoliticsFirstAttempt } from '../lib/politicsUnitReturn.mjs';

  const root = document.querySelector('[data-politics-practice]');
  if (root instanceof HTMLElement) {
    const catalogNode = root.querySelector('[data-politics-practice-catalog]');
    const catalog = JSON.parse(catalogNode?.textContent || '{}');
    const questions = Array.isArray(catalog.questions) ? catalog.questions : [];
    const units = Array.isArray(catalog.units) ? catalog.units : [];
    const chapters = Array.isArray(catalog.chapters) ? catalog.chapters : [];
    const subjects = Array.isArray(catalog.subjects) ? catalog.subjects : [];
    const questionById = new Map(questions.map((question) => [question.id, question]));
    const unitByKey = new Map(units.map((unit) => [unit.key, unit]));

    const ATTEMPT_KEY = 'kianos-politics-attempts-v1';
    const META_KEY = 'kianos-politics-practice-meta-v1';
    const SESSION_KEY = 'kianos-politics-practice-session-v1';
    const LAST_KEY = 'kianos-politics-last-location-v1';
    const EVIDENCE_KEY = 'kianos-politics-evidence-v1';

    const readJson = (key, fallback) => {
      try { return JSON.parse(localStorage.getItem(key) || 'null') || fallback; }
      catch { return fallback; }
    };
    const saveJson = (key, value) => {
      try { localStorage.setItem(key, JSON.stringify(value)); return true; }
      catch { return false; }
    };
    const localStudyDay = () => new Date().toLocaleDateString('en-CA');
    const nowIso = () => new Date().toISOString();
    const formatSeconds = (seconds) => {
      const value = Math.max(0, Math.round(Number(seconds || 0)));
      return `${Math.floor(value / 60)}:${String(value % 60).padStart(2, '0')}`;
    };

    const selectors = {
      subject: root.querySelector('[data-filter-subject]'),
      chapter: root.querySelector('[data-filter-chapter]'),
      unit: root.querySelector('[data-filter-unit]'),
      type: root.querySelector('[data-filter-type]'),
      mode: root.querySelector('[data-filter-mode]'),
      count: root.querySelector('[data-filter-count]')
    };

    let meta = readJson(META_KEY, { schema: 'kianos.politics.practice_meta.v1', favorites: {}, discussion: {}, causes: {}, notes: {}, latestOutcome: {} });
    let attemptSnapshot = readJson(ATTEMPT_KEY, { schema: 'kianos.politics.attempt_snapshot.v1', units: {} });
    let session = readJson(SESSION_KEY, null);
    let selected = new Set();
    let uncertain = false;
    let answerChanges = 0;
    let questionStartedAt = Date.now();
    let timerId = null;
    let noteTimer = null;
    let autoAdvanceTimer = null;
    let autoAdvancing = false;

    const currentQuestion = () => session?.status === 'active' ? questionById.get(session.ids?.[session.index] || '') || null : null;
    const currentUnit = () => unitByKey.get(currentQuestion()?.unitKey || '') || null;
    const submittedVisible = () => !root.querySelector('[data-submitted-result]')?.hasAttribute('hidden');

    const showError = (message) => {
      const node = root.querySelector('[data-practice-error]');
      if (!node) return;
      node.textContent = String(message || '');
      node.removeAttribute('hidden');
    };
    const clearError = () => root.querySelector('[data-practice-error]')?.setAttribute('hidden', '');

    const refreshModeButtons = () => {
      const mode = selectors.mode?.value || 'practice';
      root.querySelectorAll('[data-mode-value]').forEach((button) => {
        button.classList.toggle('active', button.getAttribute('data-mode-value') === mode);
        if (button instanceof HTMLButtonElement) button.disabled = session?.status === 'active';
      });
    };

    const populateSubjects = () => {
      if (!(selectors.subject instanceof HTMLSelectElement)) return;
      for (const row of subjects) {
        const option = document.createElement('option');
        option.value = row.id;
        option.textContent = row.label;
        selectors.subject.append(option);
      }
    };

    const refreshChapterOptions = () => {
      if (!(selectors.chapter instanceof HTMLSelectElement)) return;
      const subject = selectors.subject?.value || 'all';
      selectors.chapter.innerHTML = '<option value="all">全部章节</option>';
      for (const row of chapters.filter((chapter) => subject === 'all' || chapter.subject === subject)) {
        const option = document.createElement('option');
        option.value = row.key;
        option.textContent = `${row.title} · ${row.questionIds.length}题`;
        selectors.chapter.append(option);
      }
      refreshUnitOptions();
    };

    const refreshUnitOptions = () => {
      if (!(selectors.unit instanceof HTMLSelectElement)) return;
      const subject = selectors.subject?.value || 'all';
      const chapter = selectors.chapter?.value || 'all';
      selectors.unit.innerHTML = '<option value="all">当前范围全部 Unit</option>';
      for (const row of units.filter((unit) => (subject === 'all' || unit.subject === subject) && (chapter === 'all' || `${unit.subject}/${unit.chapter}` === chapter))) {
        const option = document.createElement('option');
        option.value = row.key;
        option.textContent = row.title;
        selectors.unit.append(option);
      }
      renderScopeSummary();
    };

    const baseFilteredQuestions = () => {
      const subject = selectors.subject?.value || 'all';
      const chapter = selectors.chapter?.value || 'all';
      const unit = selectors.unit?.value || 'all';
      const type = selectors.type?.value || 'all';
      return questions.filter((question) => {
        if (subject !== 'all' && question.subject !== subject) return false;
        if (chapter !== 'all' && `${question.subject}/${question.chapter}` !== chapter) return false;
        if (unit !== 'all' && question.unitKey !== unit) return false;
        if (type !== 'all' && question.type !== type) return false;
        return true;
      });
    };

    const filteredQuestions = () => {
      const mode = selectors.mode?.value || 'practice';
      const rows = baseFilteredQuestions();
      if (mode === 'wrong') return rows.filter((question) => meta.latestOutcome?.[question.id] === 'WRONG');
      if (mode === 'favorite') return rows.filter((question) => Boolean(meta.favorites?.[question.id]));
      return rows;
    };

    const renderScopeSummary = () => {
      const rows = filteredQuestions();
      const mode = selectors.mode?.value || 'practice';
      const modeLabel = { practice: '继续', random: '随机', wrong: '错题', favorite: '收藏' }[mode] || mode;
      const summary = root.querySelector('[data-scope-summary]');
      if (summary) summary.textContent = `${modeLabel} · 当前可用 ${rows.length} 题`;
      const available = root.querySelector('[data-available-count]');
      if (available) available.textContent = String(rows.length);
      const target = root.querySelector('[data-target-count]');
      if (target) target.textContent = String(selectors.count?.value || 20);
      refreshModeButtons();
    };

    const shuffled = (rows) => {
      const copy = [...rows];
      for (let index = copy.length - 1; index > 0; index -= 1) {
        const target = Math.floor(Math.random() * (index + 1));
        [copy[index], copy[target]] = [copy[target], copy[index]];
      }
      return copy;
    };

    const resetQuestionState = () => {
      selected = new Set();
      uncertain = false;
      answerChanges = 0;
      questionStartedAt = Date.now();
      if (timerId) window.clearInterval(timerId);
      timerId = window.setInterval(renderTimer, 1000);
    };

    const renderTimer = () => {
      const node = root.querySelector('[data-question-timer]');
      if (node) node.textContent = formatSeconds((Date.now() - questionStartedAt) / 1000);
    };

    const renderInteractionMode = () => {
      const mode = session?.scope?.interaction || 'NORMAL';
      root.querySelector('[data-interaction-normal]')?.classList.toggle('active', mode === 'NORMAL');
      root.querySelector('[data-interaction-fast]')?.classList.toggle('active', mode === 'FAST');
      const question = currentQuestion();
      const fastSingle = mode === 'FAST' && question?.type === 'single';
      root.querySelector('[data-submit]')?.toggleAttribute('hidden', Boolean(fastSingle));
      root.querySelector('[data-fast-hint]')?.toggleAttribute('hidden', !fastSingle);
    };

    const setInteractionMode = (mode) => {
      if (!session || session.status !== 'active' || submittedVisible() || autoAdvancing) return;
      const previous = session.scope?.interaction || 'NORMAL';
      session.scope = { ...(session.scope || {}), interaction: mode };
      if (!saveJson(SESSION_KEY, session)) {
        session.scope.interaction = previous;
        showError('答题模式没有保存下来；保持原模式。');
      }
      renderInteractionMode();
    };

    const updateLastLocation = (question) => {
      if (!question) return;
      saveJson(LAST_KEY, {
        subject: question.subject,
        chapter: question.chapter,
        title: `${question.subjectLabel} · ${question.chapterTitle}`,
        unit_id: question.unitId,
        action: 'VERIFY',
        question_id: question.id,
        href: window.location.pathname,
        observed_at: nowIso()
      });
    };

    const renderQuestion = () => {
      const question = currentQuestion();
      if (!question || !session) return;
      clearError();
      updateLastLocation(question);
      root.querySelector('[data-submitted-result]')?.setAttribute('hidden', '');
      root.querySelector('[data-question-card]')?.removeAttribute('hidden');
      root.querySelector('[data-fast-feedback]')?.setAttribute('hidden', '');

      const current = root.querySelector('[data-session-current]');
      const total = root.querySelector('[data-session-total]');
      const progress = root.querySelector('[data-session-progress]');
      const sessionScope = root.querySelector('[data-session-scope]');
      if (current) current.textContent = String(session.index + 1);
      if (total) total.textContent = String(session.ids.length);
      if (progress instanceof HTMLElement) progress.style.width = `${(session.index / session.ids.length) * 100}%`;
      if (sessionScope) sessionScope.textContent = `${question.subjectLabel} · ${question.chapterTitle} · ${question.unitTitle}`;

      const location = root.querySelector('[data-question-location]');
      if (location) location.textContent = `${question.subjectLabel} · ${question.chapterTitle}`;
      const number = root.querySelector('[data-question-number]');
      if (number) number.textContent = question.number ? String(question.number) : String(session.index + 1);
      const type = root.querySelector('[data-question-type]');
      if (type) type.textContent = question.type === 'multiple' ? '多选' : '单选';
      const position = root.querySelector('[data-question-progress]');
      if (position) position.textContent = String(session.index + 1);
      const questionTotal = root.querySelector('[data-question-total]');
      if (questionTotal) questionTotal.textContent = String(session.ids.length);
      const stem = root.querySelector('[data-question-stem]');
      if (stem) stem.textContent = question.stem;

      const options = root.querySelector('[data-question-options]');
      if (options instanceof HTMLElement) {
        options.innerHTML = '';
        for (const option of question.options || []) {
          const button = document.createElement('button');
          button.type = 'button';
          button.dataset.option = option.label;
          button.setAttribute('aria-pressed', 'false');
          const key = document.createElement('b');
          key.textContent = option.label;
          const text = document.createElement('span');
          text.textContent = option.text;
          button.append(key, text);
          button.addEventListener('click', () => chooseOption(option.label));
          options.append(button);
        }
      }

      const favorite = root.querySelector('[data-favorite]');
      if (favorite) {
        const active = Boolean(meta.favorites?.[question.id]);
        favorite.setAttribute('aria-pressed', active ? 'true' : 'false');
        favorite.classList.toggle('active', active);
        favorite.textContent = active ? '★ 已收藏' : '☆ 收藏';
      }
      const discussion = root.querySelector('[data-discussion]');
      if (discussion) {
        const active = Boolean(meta.discussion?.[question.id]);
        discussion.setAttribute('aria-pressed', active ? 'true' : 'false');
        discussion.classList.toggle('active', active);
        discussion.textContent = active ? '✓ 已标记' : '标记此题';
      }
      const uncertainty = root.querySelector('[data-uncertain]');
      if (uncertainty) {
        uncertainty.setAttribute('aria-pressed', 'false');
        uncertainty.classList.remove('active');
        uncertainty.textContent = '△ 不确定';
      }
      renderInteractionMode();
      renderTimer();
    };

    const renderSession = () => {
      const active = session?.status === 'active';
      const complete = session?.status === 'completed';
      root.querySelector('[data-practice-session]')?.toggleAttribute('hidden', !active);
      root.querySelector('[data-session-complete]')?.toggleAttribute('hidden', !complete);
      root.querySelector('[data-resume-session]')?.toggleAttribute('hidden', !['active', 'paused'].includes(session?.status || ''));
      root.querySelector('[data-practice-setup]')?.toggleAttribute('hidden', active || complete);
      root.querySelectorAll('[data-start-session], [data-start-session-inline]').forEach((button) => {
        if (button instanceof HTMLButtonElement) button.disabled = active;
      });
      refreshModeButtons();
      if (active) {
        resetQuestionState();
        renderQuestion();
      } else if (complete) {
        renderComplete();
      } else {
        renderScopeSummary();
      }
    };

    const startSession = () => {
      let pool = filteredQuestions();
      const mode = selectors.mode?.value || 'practice';
      if (mode === 'random') pool = shuffled(pool);
      const target = Math.max(1, Number(selectors.count?.value || 20));
      const ids = pool.slice(0, target).map((question) => question.id);
      if (!ids.length) { showError('当前筛选没有可开始的题目。'); return; }
      session = {
        schema: 'kianos.politics.practice_session.v1',
        id: `politics-${Date.now()}`,
        status: 'active',
        ids,
        index: 0,
        startedAt: nowIso(),
        totalElapsedSeconds: 0,
        correctCount: 0,
        wrongCount: 0,
        uncertainCount: 0,
        scope: {
          subject: selectors.subject?.value || 'all',
          chapter: selectors.chapter?.value || 'all',
          unit: selectors.unit?.value || 'all',
          type: selectors.type?.value || 'all',
          mode,
          interaction: 'NORMAL'
        }
      };
      if (!saveJson(SESSION_KEY, session)) { showError('题组没有保存下来，未开始。请恢复浏览器本地存储后重试。'); return; }
      renderSession();
    };

    const chooseOption = (label) => {
      const question = currentQuestion();
      if (!question || submittedVisible() || autoAdvancing) return;
      const previous = [...selected].sort().join('');
      if (question.type === 'single') selected = new Set([label]);
      else if (selected.has(label)) selected.delete(label); else selected.add(label);
      const next = [...selected].sort().join('');
      if (previous && previous !== next) answerChanges += 1;
      root.querySelectorAll('[data-question-options] [data-option]').forEach((button) => {
        const active = selected.has(button.getAttribute('data-option'));
        button.classList.toggle('selected', active);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      if (question.type === 'single' && session?.scope?.interaction === 'FAST') submitAnswer();
    };

    const answerDelta = (selectedAnswer, formalAnswer) => {
      const selectedSet = new Set(selectedAnswer.split('').filter(Boolean));
      const formalSet = new Set(formalAnswer.split('').filter(Boolean));
      const missing = [...formalSet].filter((letter) => !selectedSet.has(letter));
      const extra = [...selectedSet].filter((letter) => !formalSet.has(letter));
      return [missing.length ? `漏选 ${missing.join('、')}` : '', extra.length ? `多选 ${extra.join('、')}` : ''].filter(Boolean).join('；');
    };

    const appendEvidence = (question, outcome, selectedAnswer) => {
      if (!['WRONG', 'UNCERTAIN'].includes(outcome)) return true;
      const events = readJson(EVIDENCE_KEY, []);
      const next = Array.isArray(events) ? [...events] : [];
      next.push({
        subject: question.subject,
        chapter: question.chapter,
        chapter_title: question.chapterTitle,
        unit_id: question.unitId,
        question_id: question.id,
        source: 'xiao1000',
        outcome,
        selected: selectedAnswer,
        correct_answer: question.answer,
        study_day: localStudyDay(),
        observed_at: nowIso()
      });
      return saveJson(EVIDENCE_KEY, next.slice(-1000));
    };

    const renderResult = ({ question, unit, selectedAnswer, correct, outcome }) => {
      root.querySelector('[data-question-card]')?.setAttribute('hidden', '');
      root.querySelector('[data-submitted-result]')?.removeAttribute('hidden');
      const status = root.querySelector('[data-result-status]');
      if (status) status.textContent = correct ? (outcome === 'UNCERTAIN' ? '△ 答对了，但你标了不确定' : '✓ 本题答对') : '× 本题答错';
      root.querySelector('[data-submitted-result]')?.setAttribute('data-outcome', outcome.toLowerCase());

      const selectedNode = root.querySelector('[data-result-selected]');
      const answerNode = root.querySelector('[data-result-answer]');
      if (selectedNode) selectedNode.textContent = selectedAnswer;
      if (answerNode) answerNode.textContent = question.answer;
      const delta = answerDelta(selectedAnswer, question.answer);
      const deltaRow = root.querySelector('[data-result-delta-row]');
      if (deltaRow) deltaRow.toggleAttribute('hidden', !delta);
      const deltaNode = root.querySelector('[data-result-delta]');
      if (deltaNode) deltaNode.textContent = delta;
      root.querySelector('[data-result-uncertain]')?.toggleAttribute('hidden', outcome !== 'UNCERTAIN');
      root.querySelector('[data-result-discussion]')?.toggleAttribute('hidden', !meta.discussion?.[question.id]);

      const takeaway = root.querySelector('[data-takeaway]');
      if (takeaway) takeaway.textContent = question.refined?.takeaway || '';
      const chat = root.querySelector('[data-chat-explanation]');
      if (chat) chat.textContent = question.refined?.chatExplanation || '';

      const cause = root.querySelector('[data-cause-picker]');
      if (cause) cause.toggleAttribute('hidden', correct);
      root.querySelectorAll('[data-cause]').forEach((button) => button.classList.toggle('active', meta.causes?.[question.id] === button.getAttribute('data-cause')));

      const note = root.querySelector('[data-note]');
      if (note instanceof HTMLTextAreaElement) note.value = meta.notes?.[question.id] || '';
      const noteStatus = root.querySelector('[data-note-status]');
      if (noteStatus) noteStatus.textContent = '';

      const sources = root.querySelector('[data-review-sources]');
      if (sources instanceof HTMLElement) {
        sources.innerHTML = '';
        for (const source of unit.source || []) {
          const article = document.createElement('article');
          const heading = document.createElement('strong');
          heading.textContent = source.title || '乘风对应来源';
          article.append(heading);
          if (source.id) {
            const locator = document.createElement('code');
            locator.textContent = source.id;
            article.append(locator);
          }
          if (source.text) {
            const text = document.createElement('p');
            text.textContent = source.text;
            article.append(text);
          }
          sources.append(article);
        }
        if (!unit.source?.length) {
          const p = document.createElement('p');
          p.textContent = '当前 Unit 没有可直接展示的精确来源文本；不猜来源。';
          sources.append(p);
        }
      }

      const returnUnit = root.querySelector('[data-return-unit]');
      if (returnUnit instanceof HTMLAnchorElement) returnUnit.href = question.unitHref || window.location.pathname;
      const nextButton = root.querySelector('[data-next-question]');
      if (nextButton) nextButton.textContent = session && session.index >= session.ids.length - 1 ? '完成题组' : '下一题';
    };

    const submitAnswer = () => {
      const question = currentQuestion();
      const unit = currentUnit();
      if (!question || !unit || !session || !selected.size || submittedVisible() || autoAdvancing) return;
      const selectedAnswer = [...selected].sort().join('');
      const correct = selectedAnswer === String(question.answer || '').split('').sort().join('');
      const outcome = correct ? (uncertain ? 'UNCERTAIN' : 'STABLE') : 'WRONG';
      const elapsedSeconds = Math.round((Date.now() - questionStartedAt) / 1000);
      const firstAttempt = recordPoliticsFirstAttempt(attemptSnapshot, unit.returnConfig, {
        question_id: question.id,
        outcome,
        selected: selectedAnswer,
        correct_answer: question.answer,
        study_day: localStudyDay(),
        observed_at: nowIso()
      });
      const nextSnapshot = firstAttempt.store;
      if (firstAttempt.recorded && !saveJson(ATTEMPT_KEY, nextSnapshot)) {
        showError('本轮 first attempt 没有保存下来；为保护证据，当前题不推进。');
        return;
      }
      attemptSnapshot = nextSnapshot;
      meta.latestOutcome = { ...(meta.latestOutcome || {}), [question.id]: outcome };
      if (!saveJson(META_KEY, meta) || !appendEvidence(question, outcome, selectedAnswer)) {
        showError('本轮学习标记没有可靠保存；当前题不推进。');
        return;
      }
      session.totalElapsedSeconds = Number(session.totalElapsedSeconds || 0) + elapsedSeconds;
      if (correct) session.correctCount = Number(session.correctCount || 0) + 1;
      else session.wrongCount = Number(session.wrongCount || 0) + 1;
      if (outcome === 'UNCERTAIN') session.uncertainCount = Number(session.uncertainCount || 0) + 1;
      if (!saveJson(SESSION_KEY, session)) {
        showError('题组状态保存失败；当前题不推进。');
        return;
      }
      if (timerId) window.clearInterval(timerId);
      renderResult({ question, unit, selectedAnswer, correct, outcome });

      if (session.scope?.interaction === 'FAST' && question.type === 'single' && outcome === 'STABLE') {
        const feedback = root.querySelector('[data-fast-feedback]');
        if (feedback) {
          feedback.textContent = session.index >= session.ids.length - 1 ? '✓ 正确 · 本组完成' : '✓ 正确 · 下一题';
          feedback.removeAttribute('hidden');
        }
        autoAdvancing = true;
        autoAdvanceTimer = window.setTimeout(() => {
          autoAdvancing = false;
          nextQuestion();
        }, 520);
      }
    };

    const persistNote = () => {
      const question = currentQuestion();
      const note = root.querySelector('[data-note]');
      if (!question || !(note instanceof HTMLTextAreaElement)) return true;
      const value = note.value;
      if (value === (meta.notes?.[question.id] || '')) return true;
      meta.notes = { ...(meta.notes || {}), [question.id]: value };
      const ok = saveJson(META_KEY, meta);
      const status = root.querySelector('[data-note-status]');
      if (status) status.textContent = ok ? '已保存' : '保存失败';
      if (!ok) showError('备注保存失败。');
      return ok;
    };

    const nextQuestion = () => {
      if (!session || session.status !== 'active') return;
      if (!persistNote()) return;
      if (autoAdvanceTimer) {
        window.clearTimeout(autoAdvanceTimer);
        autoAdvanceTimer = null;
      }
      autoAdvancing = false;
      if (session.index >= session.ids.length - 1) {
        session.status = 'completed';
        session.completedAt = nowIso();
        if (!saveJson(SESSION_KEY, session)) {
          showError('题组完成状态保存失败；暂不退出当前题。');
          session.status = 'active';
          return;
        }
        renderSession();
        return;
      }
      session.index += 1;
      if (!saveJson(SESSION_KEY, session)) {
        session.index -= 1;
        showError('下一题位置保存失败；暂不推进。');
        return;
      }
      resetQuestionState();
      renderQuestion();
    };

    const renderComplete = () => {
      if (!session) return;
      const title = root.querySelector('[data-complete-title]');
      const score = root.querySelector('[data-complete-score]');
      const time = root.querySelector('[data-complete-time]');
      const wrong = root.querySelector('[data-complete-wrong]');
      if (title) title.textContent = `${session.ids.length} 题完成`;
      if (score) score.textContent = `${session.correctCount || 0} / ${session.ids.length} 正确`;
      if (time) time.textContent = `总用时 ${formatSeconds(session.totalElapsedSeconds || 0)}`;
      if (wrong) wrong.textContent = `错题 ${session.wrongCount || 0} · 不确定 ${session.uncertainCount || 0}`;
    };

    const toggleFavorite = () => {
      const question = currentQuestion();
      if (!question) return;
      meta.favorites = { ...(meta.favorites || {}), [question.id]: !meta.favorites?.[question.id] };
      if (!saveJson(META_KEY, meta)) { showError('收藏状态保存失败。'); return; }
      const button = root.querySelector('[data-favorite]');
      if (button) {
        const active = Boolean(meta.favorites?.[question.id]);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
        button.classList.toggle('active', active);
        button.textContent = active ? '★ 已收藏' : '☆ 收藏';
      }
      renderScopeSummary();
    };

    const toggleDiscussion = () => {
      const question = currentQuestion();
      if (!question) return;
      meta.discussion = { ...(meta.discussion || {}), [question.id]: !meta.discussion?.[question.id] };
      if (!saveJson(META_KEY, meta)) { showError('标记状态保存失败。'); return; }
      const button = root.querySelector('[data-discussion]');
      if (button) {
        const active = Boolean(meta.discussion?.[question.id]);
        button.setAttribute('aria-pressed', active ? 'true' : 'false');
        button.classList.toggle('active', active);
        button.textContent = active ? '✓ 已标记' : '标记此题';
      }
    };

    root.querySelectorAll('[data-start-session], [data-start-session-inline]').forEach((button) => button.addEventListener('click', startSession));
    root.querySelector('[data-start-another]')?.addEventListener('click', () => {
      session = null;
      localStorage.removeItem(SESSION_KEY);
      renderSession();
    });
    root.querySelector('[data-resume-session]')?.addEventListener('click', () => {
      if (!session) return;
      session.status = 'active';
      if (!saveJson(SESSION_KEY, session)) { showError('题组恢复状态保存失败。'); return; }
      renderSession();
    });
    root.querySelector('[data-exit-session]')?.addEventListener('click', () => {
      if (!session || !persistNote()) return;
      session.status = 'paused';
      if (!saveJson(SESSION_KEY, session)) { showError('题组暂停状态保存失败。'); return; }
      renderSession();
    });
    root.querySelector('[data-submit]')?.addEventListener('click', submitAnswer);
    root.querySelector('[data-next-question]')?.addEventListener('click', nextQuestion);
    root.querySelector('[data-favorite]')?.addEventListener('click', toggleFavorite);
    root.querySelector('[data-discussion]')?.addEventListener('click', toggleDiscussion);
    root.querySelector('[data-uncertain]')?.addEventListener('click', (event) => {
      if (submittedVisible()) return;
      uncertain = !uncertain;
      const button = event.currentTarget;
      if (button instanceof HTMLElement) {
        button.setAttribute('aria-pressed', uncertain ? 'true' : 'false');
        button.classList.toggle('active', uncertain);
        button.textContent = uncertain ? '▲ 已标不确定' : '△ 不确定';
      }
    });
    root.querySelector('[data-interaction-normal]')?.addEventListener('click', () => setInteractionMode('NORMAL'));
    root.querySelector('[data-interaction-fast]')?.addEventListener('click', () => setInteractionMode('FAST'));

    root.querySelectorAll('[data-cause]').forEach((button) => button.addEventListener('click', () => {
      const question = currentQuestion();
      if (!question) return;
      const value = button.getAttribute('data-cause') || '';
      meta.causes = { ...(meta.causes || {}), [question.id]: meta.causes?.[question.id] === value ? '' : value };
      if (!saveJson(META_KEY, meta)) { showError('错误原因保存失败。'); return; }
      root.querySelectorAll('[data-cause]').forEach((candidate) => candidate.classList.toggle('active', meta.causes?.[question.id] === candidate.getAttribute('data-cause')));
    }));

    root.querySelector('[data-note]')?.addEventListener('input', () => {
      const status = root.querySelector('[data-note-status]');
      if (status) status.textContent = '待保存';
      if (noteTimer) window.clearTimeout(noteTimer);
      noteTimer = window.setTimeout(persistNote, 350);
    });
    root.querySelector('[data-note]')?.addEventListener('blur', persistNote);

    root.querySelectorAll('[data-mode-value]').forEach((button) => button.addEventListener('click', () => {
      if (session?.status === 'active' || !(selectors.mode instanceof HTMLSelectElement)) return;
      selectors.mode.value = button.getAttribute('data-mode-value') || 'practice';
      renderScopeSummary();
    }));

    selectors.subject?.addEventListener('change', refreshChapterOptions);
    selectors.chapter?.addEventListener('change', refreshUnitOptions);
    selectors.unit?.addEventListener('change', renderScopeSummary);
    selectors.type?.addEventListener('change', renderScopeSummary);
    selectors.count?.addEventListener('change', renderScopeSummary);

    window.addEventListener('keydown', (event) => {
      if (!session || session.status !== 'active' || event.metaKey || event.ctrlKey || event.altKey || event.isComposing || event.repeat || autoAdvancing) return;
      const target = event.target;
      if (target instanceof HTMLElement && (target.matches('input, textarea, select, button') || target.isContentEditable)) return;
      const question = currentQuestion();
      if (!question) return;
      if (submittedVisible()) {
        if (event.key === 'Enter') { event.preventDefault(); nextQuestion(); }
        return;
      }
      if (event.key === 'Enter') {
        event.preventDefault();
        if (selected.size) submitAnswer();
        return;
      }
      const option = question.options?.[Number(event.key) - 1];
      if (option && ['1', '2', '3', '4'].includes(event.key)) {
        event.preventDefault();
        chooseOption(option.label);
      }
    });

    window.addEventListener('pagehide', () => {
      if (noteTimer) window.clearTimeout(noteTimer);
      persistNote();
    });

    populateSubjects();
    refreshChapterOptions();
    renderSession();
  }
</script>

