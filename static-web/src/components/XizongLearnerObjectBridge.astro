---
const { learnerObject } = Astro.props;
const payload = learnerObject || null;
---
{payload && (
  <script type="application/json" data-xizong-learner-object-payload set:html={JSON.stringify(payload)}></script>
)}

<script>
  import { resolveXizongLearnerAssetRepresentation } from '../lib/xizongRepresentationGate.mjs';
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(() => {


  const root = document.querySelector('[data-xizong-v6-block]');
  const payloadNode = document.querySelector('[data-xizong-learner-object-payload]');
  if (root && !root.hasAttribute('data-xizong-state-blocked') && payloadNode) {
    let learner = null;
    try { learner = JSON.parse(payloadNode.textContent || 'null'); } catch {}
    if (learner?.schema === 'kianos.xizong.learner_object.v1') {
      root.classList.add('xv6LearnerObjectActive');
      root.dataset.representationGate = 'kianos.xizong.representation.v1';
      const text = (value) => String(value || '');
      const array = (value) => Array.isArray(value) ? value : [];
      const el = (tag, className = '', value = '') => {
        const node = document.createElement(tag);
        if (className) node.className = className;
        if (value) node.append(document.createTextNode(text(value)));
        return node;
      };
      const decorateRepresentation = (node, representation) => {
        if (!(node instanceof HTMLElement) || !representation) return node;
        node.dataset.representationKind = text(representation.kind);
        node.dataset.representationReason = text(representation.reason);
        node.classList.add(`representation-${text(representation.kind).toLowerCase()}`);
        return node;
      };

      const renderPrecision = (row) => {
        const card = el('div', 'xv6LearnerAsset precision');
        card.dataset.learnerAsset = 'precision';
        card.dataset.learnerAssetId = text(row?.id);
        const exact = text(row?.answerHtml || row?.answer_html);
        const attentionRole = text(row?.attentionRole).toUpperCase();
        const deferred = attentionRole === 'DEFERRED_MEMORY';
        const takeaway = attentionRole === 'CURRENT_TAKEAWAY';
        card.dataset.precisionResolution = exact ? 'EXACT' : 'CUE_ONLY';
        if (attentionRole) card.dataset.attentionRole = attentionRole;
        if (!deferred && !takeaway) card.append(el('span', 'xv6LearnerAssetLabel', exact ? '精确内容' : '精确记忆提示'));
        if (row?.cue || row?.task) card.append(el('p', '', row?.cue || row?.task));
        if (exact) {
          const answer = el('div', 'markdown xv6LearnerPrecisionExact');
          answer.innerHTML = exact;
          card.append(answer);
        }
        return card;
      };

      const renderConnection = (row) => {
        const card = el('div', `xv6LearnerAsset connection ${row?.reserveLearning ? 'reserve' : row?.direction || ''}`);
        card.dataset.learnerAsset = 'connection';
        card.dataset.learnerAssetId = text(row?.id);
        const label = row?.reserveLearning ? '先留个印象' : row?.direction === 'incoming' ? '你之前见过' : '后面会接';
        card.append(el('span', 'xv6LearnerAssetLabel', label));
        card.append(el('p', '', row?.cue));
        return card;
      };

      const renderTextSupport = (row, family) => {
        const card = el('div', `xv6LearnerAsset support support-${family}`);
        card.dataset.learnerAsset = family;
        card.dataset.learnerAssetId = text(row?.id);
        const label = family === 'visual'
          ? `看原图${row?.sourceLocator ? ` · ${row.sourceLocator}` : ''}`
          : text(row?.title || row?.assetType || '按需辅助').replaceAll('_', ' ');
        card.append(el('span', 'xv6LearnerAssetLabel', label));
        const copy = row?.task || row?.cue || row?.caption;
        if (copy) card.append(el('p', '', copy));
        return card;
      };

      const renderVisual = (row) => {
        const card = el('div', 'xv6LearnerAsset visual');
        card.dataset.learnerAsset = 'visual';
        card.dataset.learnerAssetId = text(row?.id);
        card.append(el('span', 'xv6LearnerAssetLabel', `看原图${row?.sourceLocator ? ` · ${row.sourceLocator}` : ''}`));
        if (row?.task || row?.cue) card.append(el('p', '', row?.task || row?.cue));
        const assets = array(row?.sourceVisualBundle?.assets);
        if (assets.length) {
          const gallery = el('div', 'xv6LearnerVisualGallery');
          assets.forEach((asset, index) => {
            const figure = el('figure', index === 0 && assets.length > 1 ? 'primary' : '');
            if (asset?.sourceObjectId) figure.dataset.sourceObject = text(asset.sourceObjectId);
            if (asset?.sourcePage) figure.dataset.sourcePage = text(asset.sourcePage);
            const link = el('a');
            link.href = asset?.src || '#';
            link.target = '_blank';
            link.rel = 'noreferrer';
            const image = el('img');
            image.src = asset?.src || '';
            image.alt = asset?.alt || asset?.usageLabel || '原讲义裁图';
            image.loading = 'lazy';
            image.decoding = 'async';
            if (asset?.width) image.width = Number(asset.width);
            if (asset?.height) image.height = Number(asset.height);
            link.append(image);
            figure.append(link);
            if (asset?.usageLabel || asset?.sourcePage) figure.append(el('figcaption', '', asset?.usageLabel || `P${asset.sourcePage}`));
            gallery.append(figure);
          });
          card.append(gallery);
        }
        return card;
      };

      const renderTable = (asset) => {
        const wrap = el('div', 'xv6LearnerTableWrap');
        const table = el('table', 'xv6LearnerTable');
        const columns = array(asset?.payload?.columns);
        const rows = array(asset?.payload?.rows);
        const thead = el('thead');
        const tr = el('tr');
        columns.forEach((column) => tr.append(el('th', '', column?.label)));
        thead.append(tr);
        table.append(thead);
        const tbody = el('tbody');
        rows.forEach((row) => {
          const line = el('tr', row?.emphasis ? 'emphasis' : '');
          columns.forEach((column) => line.append(el('td', '', row?.[column?.key])));
          tbody.append(line);
        });
        table.append(tbody);
        wrap.append(table);
        return wrap;
      };

      const renderExtensionCard = (asset) => {
        const card = el('article', 'xv6LearnerAsset extension');
        card.dataset.learnerAsset = 'extension';
        card.dataset.learnerAssetId = text(asset?.id);
        card.dataset.extensionType = text(asset?.assetType);
        card.append(el('span', 'xv6LearnerAssetLabel', text(asset?.assetType).replaceAll('_', ' ')));
        if (asset?.title) card.append(el('h4', '', asset.title));
        if (asset?.task) card.append(el('p', '', asset.task));
        if (asset?.assetType === 'STRUCTURED_TABLE') card.append(renderTable(asset));
        else if (asset?.src) {
          const img = el('img', 'xv6LearnerExtensionImage');
          img.src = asset.src;
          img.alt = asset?.payload?.alt || asset?.title || '学习扩展图';
          img.loading = 'lazy';
          card.append(img);
        }
        if (asset?.caption) card.append(el('small', '', asset.caption));
        return card;
      };

      const renderExtension = (asset) => {
        if (asset?.displayPolicy?.timing !== 'REFERENCE_ONLY') return renderExtensionCard(asset);
        const details = el('details', 'xv6LearnerReference');
        details.append(el('summary', '', asset?.title || '参考'));
        details.append(renderExtensionCard(asset));
        return details;
      };

      const renderAttention = (row, stage) => {
        const timing = text(row?.displayPolicy?.timing).toUpperCase();
        if (timing === 'LEARN_ONLY' && !['KP_LEARN', 'LOGIC_GROUP_ORIENT'].includes(stage)) return null;
        if (timing === 'BLOCK_ORIENT' && stage !== 'BLOCK_ORIENT') return null;
        const card = el('div', 'xv6LearnerAsset attention');
        card.dataset.learnerAsset = 'attention';
        card.dataset.learnerAssetId = text(row?.id);
        if (row?.cue) card.append(el('p', '', row.cue));
        return card;
      };

      const renderResolvedAsset = (row, family, stage) => {
        if (family === 'attention') return renderAttention(row, stage);
        const representation = resolveXizongLearnerAssetRepresentation(row, { stage });
        if (!representation.visible) return null;
        let node = null;
        if (family === 'precision') node = renderPrecision(row);
        else if (family === 'connection') node = renderConnection(row);
        else if (family === 'visual') {
          node = representation.kind === 'SOURCE_VISUAL' ? renderVisual(row) : renderTextSupport(row, family);
        } else if (family === 'extension') {
          if (row?.displayPolicy?.timing === 'REFERENCE_ONLY') node = renderExtension(row);
          else node = ['SOURCE_VISUAL', 'REVIEWED_VISUAL', 'STRUCTURED_TABLE'].includes(representation.kind)
            ? renderExtension(row)
            : renderTextSupport(row, family);
        }
        return node ? decorateRepresentation(node, representation) : null;
      };

      const ATTENTION_ORDER = ['CURRENT_TAKEAWAY', 'ON_DEMAND_SUPPORT', 'DEFERRED_MEMORY', 'FUTURE_CONNECTION'];
      const ATTENTION_LABEL = {
        CURRENT_TAKEAWAY: '本轮带走',
        ON_DEMAND_SUPPORT: '按需辅助',
        DEFERRED_MEMORY: '可以后置',
        FUTURE_CONNECTION: '后面再学 / 串联'
      };
      const attentionRoleForAsset = (row, family) => {
        const explicit = text(row?.attentionRole || row?.attention_role).toUpperCase();
        if (ATTENTION_ORDER.includes(explicit)) return explicit;
        if (family === 'connection') {
          if (row?.direction === 'outgoing' && row?.reserveLearning !== true) return 'FUTURE_CONNECTION';
          return 'ON_DEMAND_SUPPORT';
        }
        return 'ON_DEMAND_SUPPORT';
      };

      const renderSlot = (slot = {}, { stage = 'LEARN' } = {}) => {
        const host = el('div', 'xv6LearnerObjectSurface');
        const grouped = new Map(ATTENTION_ORDER.map((role) => [role, []]));
        for (const [family, rows] of [
          ['attention', array(slot?.attention)],
          ['visual', array(slot?.visual)],
          ['precision', array(slot?.precision)],
          ['extension', array(slot?.extension)],
          ['connection', array(slot?.connection)]
        ]) {
          rows.forEach((row) => {
            const node = renderResolvedAsset(row, family, stage);
            if (!node) return;
            const role = attentionRoleForAsset(row, family);
            if (node instanceof HTMLElement) node.dataset.attentionRole = role;
            grouped.get(role)?.push(node);
          });
        }
        for (const role of ATTENTION_ORDER) {
          const nodes = grouped.get(role) || [];
          if (!nodes.length) continue;
          const section = el('section', 'xv6AttentionSection');
          section.dataset.attentionSection = role;
          section.append(el('span', 'xv6AttentionSectionLabel', ATTENTION_LABEL[role]));
          const body = el('div', 'xv6AttentionSectionBody');
          body.append(...nodes);
          section.append(body);
          host.append(section);
        }
        return host;
      };

      const resolvedSlotWeight = (slot = {}, stage = 'LEARN') => {
        const representations = [];
        for (const rows of [array(slot?.connection), array(slot?.visual), array(slot?.precision), array(slot?.extension)]) {
          rows.forEach((row) => {
            const representation = resolveXizongLearnerAssetRepresentation(row, { stage });
            if (representation.visible) representations.push(representation.kind);
          });
        }
        if (representations.some((kind) => ['SOURCE_VISUAL', 'REVIEWED_VISUAL', 'STRUCTURED_TABLE'].includes(kind))) return 'rich';
        if (representations.length || array(slot?.attention).length) return 'light';
        return 'none';
      };

      const rail = root.querySelector('.portedStudyChain');
      const railHeader = rail?.querySelector(':scope > header');
      let auxSurface = rail?.querySelector('[data-xizong-aux-surface]');
      if (rail && !(auxSurface instanceof HTMLElement)) {
        auxSurface = el('section', 'xv6LearnerAuxSurface');
        auxSurface.dataset.xizongAuxSurface = '';
        const header = el('header');
        header.append(el('span', '', 'Assist'));
        const title = el('strong', '', '当前辅助');
        title.dataset.xizongAuxTitle = '';
        header.append(title);
        const body = el('div', 'xv6LearnerAuxBody');
        const activeHost = el('div', 'xv6LearnerAuxHost');
        activeHost.dataset.learnerObjectSlot = 'none';
        body.append(activeHost);
        auxSurface.append(header, body);
        if (railHeader instanceof HTMLElement) railHeader.insertAdjacentElement('afterend', auxSurface);
        else rail.prepend(auxSurface);
      }
      const auxHost = auxSurface?.querySelector('[data-learner-object-slot]');
      const auxTitle = auxSurface?.querySelector('[data-xizong-aux-title]');

      const allKps = array(learner.kps);
      const kpById = new Map(allKps.map((kp) => [kp?.identity?.kpId, kp]));
      const groups = array(learner.logicGroups);
      const sourceContactMode = text(learner?.sourceContact?.mode || root.dataset.sourceContactMode);
      const sourceContactSegments = ['NATURAL_SOURCE_UNITS', 'INTEGRATION_PRIMARY'].includes(sourceContactMode)
        ? array(learner?.sourceContact?.segments)
        : [];
      const targetedIntegrationSource = sourceContactMode === 'INTEGRATION_PRIMARY' && sourceContactSegments.length > 0;
      const groupIds = groups.map((group) => group?.identity?.logicGroupId);
      let sourceLearnIndex = 0;
      let groupLearnIndex = 0;
      let lastGroupId = '';

      const activeStage = () => {
        const node = [...root.querySelectorAll('[data-study-stage]')].find((stage) => !stage.hasAttribute('hidden'));
        return node?.getAttribute('data-study-stage') || 'block_learn';
      };
      const activeGroupIndex = () => {
        const counter = root.querySelector('[data-logic-counter]')?.textContent || '';
        const match = counter.match(/(\d+)\s*\//);
        return Math.max(0, Number(match?.[1] || 1) - 1);
      };
      const activeGroup = () => groups[activeGroupIndex()] || groups[0] || null;
      const activeRecallCard = () => root.querySelector('[data-kp-recall-card]:not([hidden])');
      const activeRecallKpId = () => activeRecallCard()?.getAttribute('data-kp-id') || '';
      const visibleCompanionKp = (stageName) => {
        const frame = root.querySelector(`[data-study-stage="${stageName}"]:not([hidden]) [data-learner-kp-companion="${stageName}"][data-kp-id]`);
        return kpById.get(frame?.getAttribute('data-kp-id') || '') || null;
      };
      const recallAnswerVisible = () => {
        const answer = activeRecallCard()?.querySelector('[data-kp-answer]');
        return Boolean(answer && !answer.hasAttribute('hidden'));
      };
      const postlearnForGroup = (groupId) => {
        const slot = learner.slots?.logicGroupPostlearn?.[groupId] || {};
        let study = {};
        try { study = JSON.parse(localStorage.getItem(`kianos-xizong-astro-v2:${root.getAttribute('data-study-object')}`) || '{}'); } catch {}
        const group = groups.find((row) => row?.identity?.logicGroupId === groupId) || null;
        const ids = group?.kpIds || [];
        const visualBlocked = group?.visualRequired === true && /GAP/i.test(text(group?.visualSourceState));
        const closed = ids.length > 0 && !visualBlocked && ids.every((id) => study.learned?.[id] === true && study.ratings?.[id]);
        // POST_REVEAL extensions have explicit reveal timing; group precision and
        // outgoing connections are not moved earlier merely because a KP is revealed.
        return { extension: slot.extension || [], precision: closed ? slot.precision || [] : [], connection: closed ? slot.connection || [] : [] };
      };
      const sourceCompanionKps = () => {
        if (!sourceContactSegments.length) return allKps;
        const segmentId = text(root.dataset.sourceSegmentId);
        const segment = sourceContactSegments.find((row) => text(row?.sourceUnitId || row?.segmentId) === segmentId)
          || sourceContactSegments[0];
        const directIds = array(segment?.kpOrdinals)
          .map(Number)
          .filter((value) => Number.isInteger(value) && value >= 1 && value <= allKps.length)
          .map((ordinal) => allKps[ordinal - 1]?.identity?.kpId)
          .filter(Boolean);
        const contributionIds = array(segment?.contributesToLogicGroupIds)
          .flatMap((groupId) => array(groups.find((group) => group?.identity?.logicGroupId === groupId)?.kpIds));
        const allowed = new Set([...directIds, ...contributionIds]);
        return allowed.size ? allKps.filter((kp) => allowed.has(kp?.identity?.kpId)) : [];
      };
      const sourceCompanionKp = () => {
        const rows = sourceCompanionKps();
        return rows[Math.max(0, Math.min(rows.length - 1, sourceLearnIndex))] || rows[0] || null;
      };
      const groupCompanionIds = () => array(activeGroup()?.kpIds);
      const groupCompanionKp = () => {
        const ids = groupCompanionIds();
        const kpId = ids[Math.max(0, Math.min(ids.length - 1, groupLearnIndex))] || ids[0] || '';
        return kpById.get(kpId) || null;
      };

      const activeKpHeader = root.querySelector('[data-study-active-kp]');
      const renderActiveKpHeader = (kp, index, total, stageName) => {
        if (!(activeKpHeader instanceof HTMLElement) || !kp) return;
        const identity = el('strong', 'portedStudyActiveKpTitle', `${kp?.identity?.displayId || ''} · ${kp?.identity?.title || ''}`);
        const meta = el('div', 'portedStudyActiveKpMeta');
        if (kp?.source?.locator) meta.append(el('span', '', `讲义 · ${kp.source.locator}`));
        if (kp?.outline?.locator) meta.append(el('span', '', `考纲 · ${kp.outline.locator}`));
        const nav = el('div', 'xv6KpLearnNav');
        const prev = el('button', '', '‹'); prev.type = 'button'; prev.dataset.companionPrev = stageName; prev.disabled = index <= 0;
        const count = el('em', '', `${index + 1}/${Math.max(1, total)}`);
        const next = el('button', '', '›'); next.type = 'button'; next.dataset.companionNext = stageName; next.disabled = index >= total - 1;
        nav.append(prev, count, next);
        activeKpHeader.replaceChildren(identity, meta, nav);
      };

      const renderCompanionCard = (host, kp, index, total, stageName) => {
        host.replaceChildren();
        if (!kp) return;
        renderActiveKpHeader(kp, index, total, stageName);
        const frame = el('section', 'xv6KpLearnCompanion');
        frame.dataset.learnerKpCompanion = stageName;
        frame.dataset.kpId = text(kp?.identity?.kpId);

        if (kp?.prompt?.canonical) {
          const prompt = el('div', 'xv6KpLearnPrompt');
          prompt.append(el('span', '', '主提示'));
          prompt.append(el('p', '', kp.prompt.canonical));
          frame.append(prompt);
        }
        const core = el('div', 'markdown xv6KpLearnCore');
        core.dataset.learnerKpCore = text(kp?.identity?.kpId);
        core.innerHTML = kp?.core?.html || '';
        frame.append(core);
        const note = el('footer', 'xv6KpLearnCompanionNote', '原讲义继续在 iPad / MarginNote 连续读；这里负责 Prompt、完整 Core 和当前辅助，不把 KP 变成新的 Source 边界。');
        frame.append(note);
        host.append(frame);
      };

      const sourceStage = root.querySelector('[data-study-stage="source_contact"]');
      const groupLearnStage = root.querySelector('[data-study-stage="kp_learn"]');
      let sourceCompanionHost = null;
      let groupCompanionHost = null;
      if (sourceStage) {
        sourceStage.classList.add('xv6LearnerCompanionStage');
        sourceCompanionHost = el('div', 'xv6KpLearnCompanionHost');
        const header = sourceStage.querySelector(':scope > header');
        if (header) header.insertAdjacentElement('afterend', sourceCompanionHost); else sourceStage.prepend(sourceCompanionHost);
        const footerText = sourceStage.querySelector(':scope > footer > span');
        if (footerText) footerText.textContent = sourceContactSegments.length
          ? (targetedIntegrationSource
            ? '只完成当前需要定点核对的原讲义；Mac 伴读只显示这次核对真正释放的 KP 范围。'
            : '保持当前自然 Source unit 连续学习；Mac 伴读只显示这个 Source unit 已形成的 KP 范围。')
          : '保持原讲义连续学习；KP Learn 只是 Mac 侧伴读，不要求逐 KP 完成仪式。';
        const done = sourceStage.querySelector('[data-source-contact-done]');
        if (done) done.textContent = sourceContactSegments.length
          ? (targetedIntegrationSource ? '这次定点回原讲义已完成' : '这个 Source unit 已完成')
          : '本块讲义已学完，开始回忆';
      }
      if (groupLearnStage) {
        groupLearnStage.classList.add('xv6LearnerCompanionStage');
        groupCompanionHost = el('div', 'xv6KpLearnCompanionHost');
        const header = groupLearnStage.querySelector(':scope > header');
        if (header) header.insertAdjacentElement('afterend', groupCompanionHost); else groupLearnStage.prepend(groupCompanionHost);
        const footerText = groupLearnStage.querySelector(':scope > footer > span');
        if (footerText) footerText.textContent = '在原讲义连续完成这一学习节；中间可切 KP Learn 伴读，但不要求来回切 App。';
        const done = groupLearnStage.querySelector('[data-group-lecture-done]');
        if (done) done.textContent = '本节讲义已学完，开始回忆';
      }

      const renderCompanions = () => {
        if (sourceCompanionHost) {
          const rows = sourceCompanionKps();
          sourceLearnIndex = Math.max(0, Math.min(rows.length - 1, sourceLearnIndex));
          renderCompanionCard(sourceCompanionHost, sourceCompanionKp(), sourceLearnIndex, rows.length, 'source_contact');
        }
        const group = activeGroup();
        const groupId = group?.identity?.logicGroupId || '';
        if (groupId !== lastGroupId) {
          lastGroupId = groupId;
          groupLearnIndex = 0;
        }
        const ids = groupCompanionIds();
        groupLearnIndex = Math.max(0, Math.min(ids.length - 1, groupLearnIndex));
        if (groupCompanionHost) renderCompanionCard(groupCompanionHost, groupCompanionKp(), groupLearnIndex, ids.length, 'kp_learn');
      };

      const mergeSlots = (...slots) => {
        const families = ['attention', 'connection', 'visual', 'precision', 'extension'];
        const merged = {};
        for (const family of families) {
          const seen = new Set();
          merged[family] = [];
          for (const slot of slots) {
            for (const row of array(slot?.[family])) {
              const key = text(row?.id) || JSON.stringify(row);
              if (seen.has(key)) continue;
              seen.add(key);
              merged[family].push(row);
            }
          }
        }
        return merged;
      };

      const renderAux = () => {
        if (!(auxSurface instanceof HTMLElement) || !(auxHost instanceof HTMLElement)) return;
        const stage = activeStage();
        let slotName = 'none';
        let representationStage = 'LEARN';
        let title = '当前辅助';
        let slot = {};
        if (stage === 'block_learn') {
          slotName = 'block_orientation';
          representationStage = 'BLOCK_ORIENT';
          title = 'Block 辅助';
          slot = {
            attention: array(learner.slots?.blockAttention),
            extension: array(learner.slots?.blockOrientation)
          };
        } else if (stage === 'source_contact') {
          const kp = visibleCompanionKp('source_contact') || sourceCompanionKp();
          slotName = 'kp_learn_aux';
          representationStage = 'KP_LEARN';
          title = kp ? `${kp.identity.displayId} · 学习辅助` : 'KP Learn 辅助';
          slot = mergeSlots(learner.slots?.logicGroupPrelearn?.[kp?.identity?.logicGroupId] || {}, learner.slots?.kpLearnAux?.[kp?.identity?.kpId] || {});
        } else if (stage === 'kp_learn') {
          const kp = visibleCompanionKp('kp_learn') || groupCompanionKp();
          const groupId = kp?.identity?.logicGroupId || groupIds[activeGroupIndex()] || '';
          slotName = 'kp_learn_aux';
          representationStage = 'KP_LEARN';
          title = kp ? `${kp.identity.displayId} · 学习辅助` : 'KP Learn 辅助';
          slot = mergeSlots(
            learner.slots?.logicGroupPrelearn?.[groupId] || {},
            learner.slots?.kpLearnAux?.[kp?.identity?.kpId] || {}
          );
        } else if (stage === 'logic_group') {
          const groupId = groupIds[activeGroupIndex()] || '';
          slotName = 'logic_group_prelearn';
          representationStage = 'LOGIC_GROUP_ORIENT';
          title = '学习节辅助';
          slot = learner.slots?.logicGroupPrelearn?.[groupId] || {};
        } else if (stage === 'kp_recall') {
          const kpId = activeRecallKpId();
          const kp = kpById.get(kpId);
          const groupId = kp?.identity?.logicGroupId || groupIds[activeGroupIndex()] || '';
          slotName = 'kp_recall_aux';
          representationStage = recallAnswerVisible() ? 'KP_RECALL_REVEAL' : 'KP_RECALL_FRONT';
          title = kp ? `${kp.identity.displayId} · 当前辅助` : '当前辅助';
          slot = mergeSlots(
            learner.slots?.logicGroupPrelearn?.[groupId] || {},
            learner.slots?.kpRecallContext?.[kpId] || learner.slots?.kpLearnAux?.[kpId] || {},
            recallAnswerVisible() ? postlearnForGroup(groupId) : {}
          );
        }
        const rendered = renderSlot(slot, { stage: representationStage });
        auxHost.dataset.learnerObjectSlot = slotName;
        auxHost.dataset.representationStage = representationStage;
        auxHost.replaceChildren(...rendered.childNodes);
        const weight = resolvedSlotWeight(slot, representationStage);
        root.dataset.auxWeight = weight;
        auxSurface.hidden = auxHost.childElementCount === 0;
        if (auxTitle) auxTitle.textContent = title;
        root.dispatchEvent(new CustomEvent('kianos:xizong-aux-change', { detail: { slot: slotName, weight, representationStage } }));
      };

      const rerender = () => { renderCompanions(); renderAux(); };
      renderCompanions();
      renderAux();

      root.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target : null;
        const prev = target?.closest('[data-companion-prev]');
        const next = target?.closest('[data-companion-next]');
        if (!prev && !next) return;
        const stageName = (prev || next)?.getAttribute(prev ? 'data-companion-prev' : 'data-companion-next') || '';
        const delta = next ? 1 : -1;
        if (stageName === 'source_contact') sourceLearnIndex = Math.max(0, Math.min(sourceCompanionKps().length - 1, sourceLearnIndex + delta));
        if (stageName === 'kp_learn') groupLearnIndex = Math.max(0, Math.min(groupCompanionIds().length - 1, groupLearnIndex + delta));
        rerender();
      });

      const stages = [...root.querySelectorAll('[data-study-stage]')];
      if (sourceContactSegments.length) {
        new MutationObserver(() => { sourceLearnIndex = 0; rerender(); })
          .observe(root, { attributes: true, attributeFilter: ['data-source-segment-id'] });
      }
      const stageObserver = new MutationObserver(renderAux);
      stages.forEach((stage) => stageObserver.observe(stage, { attributes: true, attributeFilter: ['hidden'] }));
      const counter = root.querySelector('[data-logic-counter]');
      if (counter) new MutationObserver(rerender).observe(counter, { childList: true, subtree: true, characterData: true });
      const recallObserver = new MutationObserver(renderAux);
      root.querySelectorAll('[data-kp-recall-card],[data-kp-answer]').forEach((node) => recallObserver.observe(node, { attributes: true, attributeFilter: ['hidden'] }));
    }
  }

  });
</script>
