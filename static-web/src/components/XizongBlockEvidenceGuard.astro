---
const { block } = Astro.props;
const evidenceVersion = [block?.sourceHash || '', block?.systemSourceHash || '', block?.learningSupportSourceHash || ''].join(':');
---
<span data-xizong-block-evidence-guard data-object-id={block.objectId} data-evidence-version={evidenceVersion} data-revision-witness={JSON.stringify(block.learnerObject?.revisionWitness || null)} hidden></span>

<script>
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(() => {

  const marker = document.querySelector('[data-xizong-block-evidence-guard]');
  const root = document.querySelector('[data-xizong-v6-block]');
  if (marker instanceof HTMLElement && root instanceof HTMLElement) {
    const objectId = marker.getAttribute('data-object-id') || 'xizong:unknown';
    const version = marker.getAttribute('data-evidence-version') || '';
    const metaKey = `kianos-xizong-evidence-meta-v1:${objectId}`;

    const readJson = (key, fallback = null) => {
      try { return JSON.parse(localStorage.getItem(key) || '') || fallback; } catch { return fallback; }
    };
    const writeJson = (key, value) => {
      try { localStorage.setItem(key, JSON.stringify(value)); return true; } catch { return false; }
    };

    const previousMeta = readJson(metaKey, null);
    const revisionWitness = JSON.parse(marker.getAttribute('data-revision-witness') || 'null');
    // Artifact observation only. BlockV6 owns selective reconciliation in its
    // existing state. A hash transition cannot retire learner evidence.
    if (previousMeta?.version !== version || JSON.stringify(previousMeta?.revisionWitness) !== JSON.stringify(revisionWitness)) {
      const next = { ...(previousMeta || {}), version, revisionWitness, observed_at: new Date().toISOString() };
      if (!writeJson(metaKey, next)) {
        root.inert = true;
        const notice = document.createElement('p');
        notice.setAttribute('role', 'alert');
        notice.textContent = '内容版本标记未能保存，原学习记录保留。请先备份或释放存储再恢复。';
        root.before(notice);
      }
    }
  }
  });
</script>
