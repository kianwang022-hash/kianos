---
import { loadXizongSystemCompletionRequirements } from '../lib/xizong.mjs';
const {
  system = null,
  block = null,
  resumeKind = '',
  resumeTitle = '',
  resumeDetail = '',
  resumeStage = '',
  resumePosition = '',
  resumeAction = '',
  requiredBlockIds = [],
  requiredSystemRecall = ''
} = Astro.props;
const systemId = system?.systemId || '';
const requiredBlocks = (requiredBlockIds?.length || requiredSystemRecall) ? loadXizongSystemCompletionRequirements(system) : [];
---
<span
  data-xizong-last-location
  data-system-id={systemId}
  data-system-title={system?.title || ''}
  data-system-canonical={system?.canonicalId || ''}
  data-block-slug={block?.slug || ''}
  data-block-label={block?.label || ''}
  data-block-title={block?.title || ''}
  data-resume-kind={resumeKind}
  data-resume-title={resumeTitle}
  data-resume-detail={resumeDetail}
  data-resume-stage={resumeStage}
  data-resume-position={resumePosition}
  data-resume-action={resumeAction}
  data-required-system-recall={requiredSystemRecall}
  hidden
></span>
<script type="application/json" data-xizong-last-location-required-blocks set:html={JSON.stringify(requiredBlocks)}></script>

<script>
  import { inspectXizongSystemCompletion, hasXizongSystemRecall } from '../lib/xizongMemoryAutoRelease.mjs';
  const node = document.querySelector('[data-xizong-last-location]');
  if (node instanceof HTMLElement) {
    const readJson = (key, fallback = null) => {
      try { return JSON.parse(localStorage.getItem(key) || '') || fallback; } catch { return fallback; }
    };
    let requiredBlocks = [];
    try { requiredBlocks = JSON.parse(document.querySelector('[data-xizong-last-location-required-blocks]')?.textContent || '[]'); } catch {}

    const requiredSystemRecall = node.getAttribute('data-required-system-recall') || '';
    const blocksReady = !requiredBlocks.length || inspectXizongSystemCompletion(requiredBlocks, localStorage).complete;
    const recallReady = !requiredSystemRecall || hasXizongSystemRecall(localStorage, requiredSystemRecall);

    const value = {
      systemId: node.getAttribute('data-system-id') || '',
      systemTitle: node.getAttribute('data-system-title') || '',
      systemCanonical: node.getAttribute('data-system-canonical') || '',
      blockSlug: node.getAttribute('data-block-slug') || '',
      blockLabel: node.getAttribute('data-block-label') || '',
      blockTitle: node.getAttribute('data-block-title') || '',
      resumeKind: node.getAttribute('data-resume-kind') || '',
      resumeTitle: node.getAttribute('data-resume-title') || '',
      resumeDetail: node.getAttribute('data-resume-detail') || '',
      resumeStage: node.getAttribute('data-resume-stage') || '',
      resumePosition: node.getAttribute('data-resume-position') || '',
      resumeAction: node.getAttribute('data-resume-action') || '',
      href: window.location.pathname,
      observed_at: new Date().toISOString()
    };

    if ((value.systemId || value.resumeKind) && blocksReady && recallReady) {
      try { localStorage.setItem('kianos-xizong-last-location-v1', JSON.stringify(value)); } catch {}
    }
  }
</script>
