<span data-objective-handoff-root hidden></span>

<script>
  const TRANSFER_STORE_KEY = 'kianos-english-objective-transfer-claims-v1';
  const normalizeAnswer = (value) => Array.isArray(value)
    ? value.map(String)
    : value === null || value === undefined || value === '' ? [] : [String(value)];

  const readJson = (key, fallback) => {
    try { return JSON.parse(localStorage.getItem(key) || 'null') || fallback; }
    catch { return fallback; }
  };
  const taskClaimsFor = (task) => {
    const store = readJson(TRANSFER_STORE_KEY, { claims: [] });
    return (Array.isArray(store.claims) ? store.claims : []).filter((claim) => claim?.task === task);
  };
  const activeClaimsFor = (task) => taskClaimsFor(task).filter((claim) => claim?.status === 'TRANSFER_PENDING');
  const recentClosedClaimsFor = (task, objectId) => taskClaimsFor(task)
    .filter((claim) => claim?.status === 'CLOSED' && claim?.sourceObjectId !== objectId)
    .sort((a, b) => String(b?.updatedAt || '').localeCompare(String(a?.updatedAt || '')))
    .slice(0, 5);
  const formatDuration = (seconds) => {
    if (!Number.isFinite(seconds)) return '—';
    const minutes = Math.floor(seconds / 60);
    const rest = seconds % 60;
    return `${String(minutes).padStart(2, '0')}:${String(rest).padStart(2, '0')}`;
  };

  document.querySelectorAll('[data-objective-root]').forEach((root) => {
    if (!(root instanceof HTMLElement)) return;
    const task = root.getAttribute('data-objective-task') || '';
    const objectId = root.getAttribute('data-objective-object') || '';
    const storageKey = root.getAttribute('data-objective-storage-key') || '';
    const resultSummary = root.querySelector('[data-objective-result-summary]');
    if (!task || !objectId || !storageKey || !(resultSummary instanceof HTMLElement)) return;

    const handoffKey = `kianos-english-objective-handoff-v1:${task}:${objectId}`;
    let handoff = null;
    const readAttempt = () => readJson(storageKey, {});
    const questions = () => [...root.querySelectorAll('[data-objective-question]')];
    const idOf = (question) => question.getAttribute('data-objective-question') || '';
    const ordinalOf = (question) => Number(question.getAttribute('data-objective-index') || 0) + 1;
    const itemLabel = task === 'cloze' ? 'Blank' : (root.getAttribute('data-reading-b-item-label') || 'Item');
    const displayLabelOf = (row) => task === 'cloze'
      ? `${itemLabel} ${ordinalOf(row)}`
      : (row.getAttribute('data-reading-b-target-label') || `${itemLabel} ${ordinalOf(row)}`);
    const formalOf = (question) => {
      try { return normalizeAnswer(JSON.parse(question.getAttribute('data-answer') || '""')); }
      catch { return []; }
    };
    const problemIds = (attempt) => {
      const uncertain = new Set(attempt.uncertain || []);
      return Object.keys(attempt.results || {}).filter((id) =>
        ['wrong', 'unanswered'].includes(attempt.results?.[id]) || uncertain.has(id)
      );
    };

    const ensureHandoff = () => {
      if (handoff) return handoff;
      handoff = document.createElement('div');
      handoff.className = 'objectiveHandoff';
      handoff.hidden = true;
      const button = document.createElement('button');
      button.type = 'button';
      button.setAttribute('data-objective-copy-chat', '');
      const status = document.createElement('small');
      status.setAttribute('data-objective-copy-status', '');
      handoff.append(button, status);
      resultSummary.appendChild(handoff);
      return handoff;
    };

    const itemContext = (row) => {
      const id = idOf(row);
      const prompt = row.querySelector('[data-objective-prompt]')?.textContent?.trim() || '';
      const options = [...row.querySelectorAll('[data-objective-option]')]
        .map((node) => node.textContent?.trim() || '')
        .filter(Boolean);
      return ['', `${displayLabelOf(row)} (${id})`, ...(prompt ? [`Prompt: ${prompt}`] : []), ...options];
    };

    const buildPacket = (attempt) => {
      const rows = questions();
      const uncertain = new Set(attempt.uncertain || []);
      const problems = new Set(problemIds(attempt));
      const pendingClaims = activeClaimsFor(task);
      const reopenCandidates = recentClosedClaimsFor(task, objectId);
      const score = Object.values(attempt.results || {}).filter((value) => value === 'correct').length;
      const duration = attempt.startedAt && attempt.submittedAt
        ? Math.max(0, Math.round((new Date(attempt.submittedAt).getTime() - new Date(attempt.startedAt).getTime()) / 1000))
        : null;
      const title = root.querySelector('[data-objective-title]')?.textContent?.trim() || objectId;
      const source = root.querySelector('[data-objective-source-label]')?.textContent?.trim() || '—';
      const material = [...root.querySelectorAll('[data-objective-material-block]')]
        .map((node) => node.textContent?.trim() || '')
        .filter(Boolean)
        .join('\n\n');
      const wrong = rows.filter((row) => ['wrong', 'unanswered'].includes(attempt.results?.[idOf(row)])).map(displayLabelOf);
      const uncertainRows = rows.filter((row) => uncertain.has(idOf(row))).map(displayLabelOf);
      const packetName = task === 'cloze' ? 'Cloze deep review packet v2' : 'Reading B deep review packet v2';

      const lines = [
        packetName,
        'Mode: OPTIONAL_ESCALATION',
        `Object: ${objectId}`,
        `Source: ${source}`,
        `Title: ${title}`,
        `Score: ${score}/${rows.length}`,
        `Time: ${formatDuration(duration)}`,
        `Wrong/unanswered: ${wrong.join(', ') || 'none'}`,
        `Uncertain: ${uncertainRows.join(', ') || 'none'}`
      ];

      if (task === 'reading_b') {
        const directions = root.querySelector('[data-objective-instruction] p')?.textContent?.replace(/\s+/g, ' ')?.trim() || '';
        const form = root.getAttribute('data-reading-b-task-form') || '';
        const policy = root.getAttribute('data-reading-b-candidate-policy') || '';
        lines.push(`Task form: ${form || '—'}`, `Candidate policy: ${policy || '—'}`);
        if (directions) lines.push('', 'DIRECTIONS', directions);
        const skeleton = [...root.querySelector('[data-reading-b-ordering-skeleton]')?.children || []]
          .map((node) => node.getAttribute?.('data-reading-b-fixed') || node.getAttribute?.('data-reading-b-target-label') || '')
          .filter(Boolean);
        if (skeleton.length) lines.push('', 'ORDERING SKELETON', skeleton.join(' → '));
      }

      if (task === 'cloze' || material) lines.push('', task === 'cloze' ? 'PASSAGE' : 'MATERIAL', material || '—');

      if (task === 'reading_b') {
        const candidates = [...root.querySelectorAll('[data-objective-candidate]')]
          .map((node) => {
            const label = node.querySelector('b')?.textContent?.trim() || '';
            const text = node.querySelector('span')?.textContent?.replace(/\s+/g, ' ')?.trim() || '';
            return [label, text].filter(Boolean).join('. ');
          })
          .filter(Boolean);
        if (candidates.length) lines.push('', 'CANDIDATE INVENTORY', ...candidates);
      }

      lines.push('', task === 'cloze' ? 'ALL-BLANK OUTCOME MAP' : 'COMPLETE MATCH / PLACEMENT MAP');
      rows.forEach((row) => {
        const id = idOf(row);
        const path = (attempt.trajectory?.[id] || []).map((step) => step?.answer).filter(Boolean).join(' → ') || '—';
        lines.push(`${displayLabelOf(row)} (${id}) · ${attempt.results?.[id] || '—'} · my ${attempt.answers?.[id] || '未答'} · formal ${formalOf(row).join(', ') || '—'} · uncertain ${uncertain.has(id) ? 'yes' : 'no'} · path ${path}`);
      });

      const expanded = rows.filter((row) => problems.has(idOf(row)));
      if (expanded.length) {
        lines.push('', 'PROBLEM ITEM CONTEXT');
        expanded.forEach((row) => lines.push(...itemContext(row)));
      }

      lines.push('', 'ACTIVE TRANSFER CLAIMS · opportunistic only');
      if (!pendingClaims.length) lines.push('none');
      else pendingClaims.forEach((claim) => lines.push(`${claim.claimId} · ${claim.statement}`));

      lines.push('', 'RECENT CLOSED CLAIMS · reopen only with direct contradiction');
      if (!reopenCandidates.length) lines.push('none');
      else reopenCandidates.forEach((claim) => lines.push(`${claim.claimId} · ${claim.statement}`));

      lines.push('', 'REVIEW INSTRUCTION');
      if (task === 'cloze') {
        lines.push('This is optional escalation because a real problem remained. Diagnose the whole Cloze passage first, but stop when the smallest score-relevant failure is clear. Reconstruct Slot Demand before comparing the genuinely competing candidates. Route lexical objects to LexicalOS, representation failures to Reading, and keep only true best-fit procedure failures in Cloze.');
      } else {
        lines.push('This is optional escalation because a real problem remained. Use the actual DIRECTIONS, task form, candidate inventory and ordering skeleton. Compare the complete learner map with the formal map, detect swaps/coupled errors/cascades, then stop at the smallest repair that can change future performance. Route lexical objects to LexicalOS and representation/discourse failures to Reading.');
      }
      lines.push('ACTIVE TRANSFER CLAIMS are opportunistic only. Their existence is not a learner task. Update one only if this set genuinely tested the same procedure; otherwise leave it untouched.');
      lines.push(
        '',
        'REPAIR / RETURN PROTOCOL',
        'Diagnosis does not equal completed repair. If a reusable task-specific failure is genuinely repaired, set repairCompleted=true and place the learner re-execution evidence in repairEvidence. If quick understanding is sufficient and no durable claim is justified, do not manufacture one.',
        'newClaims may only reference a reusable task-specific thread whose repairCompleted=true and repairEvidence is non-empty. Do not duplicate Lexical or Reading objects. CLOSED and REOPENED require relevant fresh evidence; otherwise leave the claim unchanged.',
        'KIANOS_OBJECTIVE_RETURN_V1',
        '```json',
        JSON.stringify({ schema: 'kianos.english.objective_review_return.v1', task, objectId, threads: [], newClaims: [], claimUpdates: [] }, null, 2),
        '```'
      );

      return {
        text: lines.join('\n'),
        activeClaimIds: pendingClaims.map((claim) => String(claim.claimId || '')).filter(Boolean),
        reopenCandidateIds: reopenCandidates.map((claim) => String(claim.claimId || '')).filter(Boolean)
      };
    };

    const sync = () => {
      const node = ensureHandoff();
      const attempt = readAttempt();
      const problems = problemIds(attempt).length;
      node.hidden = !attempt.submitted || problems === 0;
      const button = node.querySelector('[data-objective-copy-chat]');
      const status = node.querySelector('[data-objective-copy-status]');
      if (button) button.textContent = task === 'cloze' ? '深复盘 · 整篇给 Chat' : '深复盘 · 整组给 Chat';
      if (status && problems > 0) status.textContent = `${problems} 个 problem。先快速理解；解释不清、反复出现或结构耦合时再升级。`;
    };

    ensureHandoff()?.querySelector('[data-objective-copy-chat]')?.addEventListener('click', async () => {
      const attempt = readAttempt();
      if (!attempt.submitted || problemIds(attempt).length === 0) return;
      const status = handoff?.querySelector('[data-objective-copy-status]');
      const packet = buildPacket(attempt);
      try {
        await navigator.clipboard.writeText(packet.text);
        try {
          localStorage.setItem(handoffKey, JSON.stringify({
            schema: 'kianos.english.objective_handoff.v1',
            task,
            objectId,
            mode: 'OPTIONAL_ESCALATION',
            activeClaimIds: packet.activeClaimIds,
            reopenCandidateIds: packet.reopenCandidateIds,
            createdAt: new Date().toISOString()
          }));
          if (status) status.textContent = '已复制给 Chat；能解释得分问题时就停，不追求流程完整。';
        } catch {
          if (status) status.textContent = '已复制给 Chat，但本机未能保存这次回访信息；这次只做复盘，不更新长期记录。';
        }
      } catch {
        if (status) status.textContent = '复制失败，请稍后再试。';
      }
    });

    root.addEventListener('kianos:objective-submitted', sync);
    root.addEventListener('kianos:objective-transfer-updated', sync);
    root.addEventListener('click', () => window.setTimeout(sync, 0));
    window.addEventListener('storage', (event) => {
      if (event.key === TRANSFER_STORE_KEY) sync();
    });
    sync();
  });
</script>

<style>
  .objectiveHandoff{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:10px}.objectiveHandoff button{padding:8px 12px;border:1px solid var(--study-green);border-radius:9px;background:var(--study-green);color:#fff;font:inherit;font-weight:800;cursor:pointer}.objectiveHandoff small{color:var(--study-muted);font-size:10px}
</style>