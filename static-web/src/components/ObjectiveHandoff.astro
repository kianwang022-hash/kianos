<span data-objective-handoff-root hidden></span>

<script>
  const TRANSFER_STORE_KEY = 'kianos-english-objective-transfer-claims-v1';
  const normalizeAnswer = (value) => Array.isArray(value)
    ? value.map(String)
    : value === null || value === undefined || value === '' ? [] : [String(value)];

  const readJson = (key, fallback) => {
    try { return JSON.parse(localStorage.getItem(key) || 'null') || fallback; }
    catch { return fallback; }
  };
  const activeClaimsFor = (task) => {
    const store = readJson(TRANSFER_STORE_KEY, { claims: [] });
    return (Array.isArray(store.claims) ? store.claims : [])
      .filter((claim) => claim?.task === task && claim?.status === 'TRANSFER_PENDING');
  };
  const formatDuration = (seconds) => {
    if (!Number.isFinite(seconds)) return '—';
    const minutes = Math.floor(seconds / 60);
    const rest = seconds % 60;
    return `${String(minutes).padStart(2, '0')}:${String(rest).padStart(2, '0')}`;
  };

  document.querySelectorAll('[data-objective-root]').forEach((root) => {
    if (!(root instanceof HTMLElement)) return;
    const task = root.getAttribute('data-objective-task') || '';
    const objectId = root.getAttribute('data-objective-object') || '';
    const storageKey = root.getAttribute('data-objective-storage-key') || '';
    const resultSummary = root.querySelector('[data-objective-result-summary]');
    if (!task || !objectId || !storageKey || !(resultSummary instanceof HTMLElement)) return;

    let handoff = null;
    const readAttempt = () => readJson(storageKey, {});
    const questions = () => [...root.querySelectorAll('[data-objective-question]')];
    const idOf = (question) => question.getAttribute('data-objective-question') || '';
    const ordinalOf = (question) => Number(question.getAttribute('data-objective-index') || 0) + 1;
    const formalOf = (question) => {
      try { return normalizeAnswer(JSON.parse(question.getAttribute('data-answer') || '""')); }
      catch { return []; }
    };
    const problemIds = (attempt) => {
      const uncertain = new Set(attempt.uncertain || []);
      return Object.keys(attempt.results || {}).filter((id) =>
        ['wrong', 'unanswered'].includes(attempt.results?.[id]) || uncertain.has(id)
      );
    };
    const packetMode = (attempt) => {
      const problems = problemIds(attempt).length > 0;
      const pending = activeClaimsFor(task).length > 0;
      if (problems && pending) return 'REVIEW_AND_TRANSFER_CHECK';
      if (problems) return 'REVIEW';
      if (pending) return 'TRANSFER_CHECK';
      return 'PASS';
    };

    const ensureHandoff = () => {
      if (handoff) return handoff;
      handoff = document.createElement('div');
      handoff.className = 'objectiveHandoff';
      handoff.hidden = true;
      const button = document.createElement('button');
      button.type = 'button';
      button.setAttribute('data-objective-copy-chat', '');
      const status = document.createElement('small');
      status.setAttribute('data-objective-copy-status', '');
      handoff.append(button, status);
      resultSummary.appendChild(handoff);
      return handoff;
    };

    const buildPacket = (attempt) => {
      const rows = questions();
      const uncertain = new Set(attempt.uncertain || []);
      const problems = new Set(problemIds(attempt));
      const pendingClaims = activeClaimsFor(task);
      const mode = packetMode(attempt);
      const score = Object.values(attempt.results || {}).filter((value) => value === 'correct').length;
      const duration = attempt.startedAt && attempt.submittedAt
        ? Math.max(0, Math.round((new Date(attempt.submittedAt).getTime() - new Date(attempt.startedAt).getTime()) / 1000))
        : null;
      const title = root.querySelector('[data-objective-title]')?.textContent?.trim() || objectId;
      const source = root.querySelector('[data-objective-source-label]')?.textContent?.trim() || '—';
      const material = [...root.querySelectorAll('[data-objective-material-block]')]
        .map((node) => node.textContent?.trim() || '')
        .filter(Boolean)
        .join('\n\n');
      const wrong = rows
        .filter((row) => ['wrong', 'unanswered'].includes(attempt.results?.[idOf(row)]))
        .map((row) => task === 'cloze' ? `Blank ${ordinalOf(row)}` : `Position ${ordinalOf(row)}`);
      const uncertainRows = rows
        .filter((row) => uncertain.has(idOf(row)))
        .map((row) => task === 'cloze' ? `Blank ${ordinalOf(row)}` : `Position ${ordinalOf(row)}`);
      const packetName = task === 'cloze' ? 'Cloze passage review packet v1' : 'Reading B set review packet v1';

      const lines = [
        packetName,
        `Mode: ${mode}`,
        `Object: ${objectId}`,
        `Source: ${source}`,
        `Title: ${title}`,
        `Score: ${score}/${rows.length}`,
        `Time: ${formatDuration(duration)}`,
        `Wrong/unanswered: ${wrong.join(', ') || 'none'}`,
        `Uncertain: ${uncertainRows.join(', ') || 'none'}`,
        '',
        task === 'cloze' ? 'PASSAGE' : 'MATERIAL',
        material || '—'
      ];

      if (task === 'reading_b') {
        const candidates = [...root.querySelectorAll('[data-objective-candidate]')]
          .map((node) => node.textContent?.trim() || '')
          .filter(Boolean);
        if (candidates.length) lines.push('', 'CANDIDATE INVENTORY', ...candidates);
      }

      lines.push('', task === 'cloze' ? 'ALL-BLANK OUTCOME MAP' : 'COMPLETE PLACEMENT / MATCHING MAP');
      rows.forEach((row) => {
        const id = idOf(row);
        const label = task === 'cloze' ? `Blank ${ordinalOf(row)}` : `Position ${ordinalOf(row)}`;
        const path = (attempt.trajectory?.[id] || [])
          .map((step) => step?.answer)
          .filter(Boolean)
          .join(' → ') || '—';
        lines.push(`${label} (${id}) · ${attempt.results?.[id] || '—'} · my ${attempt.answers?.[id] || '未答'} · formal ${formalOf(row).join(', ') || '—'} · uncertain ${uncertain.has(id) ? 'yes' : 'no'} · path ${path}`);
      });

      if (problems.size) {
        lines.push('', 'EXPANDED PROBLEM ITEMS');
        rows.filter((row) => problems.has(idOf(row))).forEach((row) => {
          const id = idOf(row);
          const label = task === 'cloze' ? `Blank ${ordinalOf(row)}` : `Position ${ordinalOf(row)}`;
          const prompt = row.querySelector('[data-objective-prompt]')?.textContent?.trim() || '';
          const options = [...row.querySelectorAll('[data-objective-option]')]
            .map((node) => node.textContent?.trim() || '')
            .filter(Boolean);
          lines.push('', `${label} (${id})`, `Prompt: ${prompt || '—'}`, ...options);
        });
      }

      lines.push('', 'ACTIVE TRANSFER CLAIMS');
      if (!pendingClaims.length) {
        lines.push('none');
      } else {
        pendingClaims.forEach((claim) => lines.push(`${claim.claimId} · ${claim.statement}`));
      }

      lines.push('', 'REVIEW INSTRUCTION');
      if (task === 'cloze') {
        lines.push('Treat this as one complete Cloze passage. Diagnose globally first; merge blanks that share one lexical, sentence, discourse, or task-procedure root cause. For a local repair, reconstruct Slot Demand before comparing the genuinely competing candidates, then identify the decisive constraint. Route lexical objects to LexicalOS, representation failures to Reading, and keep only true best-fit procedure failures in Cloze. Do not create one permanent card per wrong blank.');
      } else {
        lines.push('Treat this as one complete Reading B set. Reconstruct the discourse skeleton before splitting positions. Compare the learner map with the formal map, detect swaps/coupled errors/cascades, then choose local, coupled, or structure-level repair. Attach dependent wrong placements to the primary structural error. Route lexical objects to LexicalOS and representation/discourse failures to Reading. Do not create one permanent weakness per wrong position.');
      }
      lines.push('Existing ACTIVE TRANSFER CLAIMS are not automatically relevant. Update one only if this fresh material genuinely tests the same behavior. Known-item correction is repair evidence; later fresh transfer is stronger mastery evidence.');
      lines.push(
        '',
        'RETURN PROTOCOL',
        'After the review, append one machine-readable block so the learner can paste the whole Chat reply back into KianOS. Always keep repair threads at the smallest sufficient shared/local/coupled/structure scope. Create newClaims only for reusable task-specific procedure claims; do not duplicate Lexical or Reading objects. claimUpdates may reference only ACTIVE TRANSFER CLAIMS above. CLOSED requires relevant fresh evidence; if this set did not test a claim, leave it unchanged.',
        'KIANOS_OBJECTIVE_RETURN_V1',
        '```json',
        JSON.stringify({
          schema: 'kianos.english.objective_review_return.v1',
          task,
          objectId,
          threads: [],
          newClaims: [],
          claimUpdates: []
        }, null, 2),
        '```'
      );
      return lines.join('\n');
    };

    const sync = () => {
      const node = ensureHandoff();
      const attempt = readAttempt();
      const mode = packetMode(attempt);
      node.hidden = !attempt.submitted || mode === 'PASS';
      const button = node.querySelector('[data-objective-copy-chat]');
      const status = node.querySelector('[data-objective-copy-status]');
      if (button) {
        button.textContent = mode === 'TRANSFER_CHECK'
          ? (task === 'cloze' ? '用这篇验证迁移' : '用这组验证迁移')
          : (task === 'cloze' ? '复制整篇完形给 Chat' : '复制整组 Part B 给 Chat');
      }
      if (status) {
        status.textContent = mode === 'TRANSFER_CHECK'
          ? `当前有 ${activeClaimsFor(task).length} 个 pending claim；只有相关时才需要验证。`
          : '按整篇 / 整组复盘；局部题位只作为内部证据。';
      }
    };

    ensureHandoff()?.querySelector('[data-objective-copy-chat]')?.addEventListener('click', async () => {
      const attempt = readAttempt();
      if (!attempt.submitted || packetMode(attempt) === 'PASS') return;
      const status = handoff?.querySelector('[data-objective-copy-status]');
      try {
        await navigator.clipboard.writeText(buildPacket(attempt));
        if (status) status.textContent = packetMode(attempt) === 'TRANSFER_CHECK'
          ? '已复制迁移验证包；让 Chat 只判断真正相关的 pending claim。'
          : '已复制整组复盘包，直接贴到 Chat。';
      } catch {
        if (status) status.textContent = '复制失败，请稍后再试。';
      }
    });

    root.addEventListener('kianos:objective-submitted', sync);
    root.addEventListener('kianos:objective-transfer-updated', sync);
    root.addEventListener('click', () => window.setTimeout(sync, 0));
    window.addEventListener('storage', (event) => {
      if (event.key === TRANSFER_STORE_KEY) sync();
    });
    sync();
  });
</script>

<style>
  .objectiveHandoff{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:10px}.objectiveHandoff button{padding:8px 12px;border:1px solid var(--study-green);border-radius:9px;background:var(--study-green);color:#fff;font:inherit;font-weight:800;cursor:pointer}.objectiveHandoff small{color:var(--study-muted);font-size:10px}
</style>