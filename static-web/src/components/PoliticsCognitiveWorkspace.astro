chapterContextChain{display:flex;align-items:center;gap:7px;overflow:auto}.chapterContextChain span{position:relative;min-width:max-content;padding-right:17px;color:var(--study-muted);font-size:11px}.chapterContextChain span:not(:last-child)::after{content:'→';position:absolute;right:1px;color:var(--study-line-strong)}
