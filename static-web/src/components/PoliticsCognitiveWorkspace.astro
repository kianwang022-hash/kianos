---
import PoliticsExplicitSurfacePlan from './PoliticsExplicitSurfacePlan.astro';
import Value from './PoliticsProjectionValue.astro';

const { chapter, base = '/', compiled = null, chapterContext = null } = Astro.props;

const units = (chapter.units || [])
  .map((unit) => {
    const projection = compiled instanceof Map ? compiled.get(unit.unitId) : null;
    if (!projection) return null;
    const states = projection.surfacePlan?.states || {};
    return {
      unit,
      projection,
      orientPrimary: (states.ORIENT || []).filter((group) => group.zone === 'PRIMARY'),
      orientSupport: (states.ORIENT || []).filter((group) => group.zone === 'SUPPORT'),
      orientCompanion: (states.ORIENT || []).filter((group) => group.zone === 'COMPANION'),
      external: states.EXTERNAL_LEARN || [],
      close: states.CLOSE || []
    };
  })
  .filter(Boolean);

if (!units.length) {
  throw new Error(`POLITICS_MAPPED_WORKSPACE_EMPTY:${chapter.subject}:${chapter.chapter || chapter.code || ''}`);
}
---

<section
  class="politicsCognitiveWorkspace directReasoningWorkspace explicitSurfaceWorkspace"
  data-politics-runtime
  data-politics-cognitive-workspace
  data-subject={chapter.subject}
  data-chapter={chapter.chapter || chapter.code || ''}
  data-title={chapter.title}
>
  <header class="workspaceBar">
    <div class="workspaceLocation">
      <a href={`${base}politics/`}>政治</a>
      <span>/</span>
      <strong>{chapter.subjectMeta.label}</strong>
      <span>/</span>
      <b>{chapter.title}</b>
    </div>
    <nav class="workspaceUnitTabs" aria-label="Natural Unit">
      {units.map((row, index) => (
        <button type="button" class={index === 0 ? 'active' : ''} data-workspace-unit-tab={index}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <b>{row.unit.title}</b>
        </button>
      ))}
    </nav>
    <div class="workspaceState">
      <span>STATE</span>
      <strong data-workspace-state-label>ORIENT</strong>
    </div>
  </header>

  {chapterContext && (
    <section class="chapterContext" data-projection-chapter-context>
      <div class="chapterContextSummary">
        <span>章位置</span>
        <strong>{chapterContext.location || chapter.title}</strong>
      </div>
      {(chapterContext.currentProblem || chapterContext.stageContext?.length > 0) && (
        <details class="chapterContextDetails">
          <summary>展开整章位置</summary>
          <div class="chapterContextExpanded">
            {chapterContext.currentProblem && <p class="chapterContextProblem">{chapterContext.currentProblem}</p>}
            {chapterContext.stageContext?.length > 0 && (
              <div class="chapterContextChain">
                {chapterContext.stageContext.map((row) => <Value value={row.value} />)}
              </div>
            )}
          </div>
        </details>
      )}
    </section>
  )}

  {units.map((row, unitIndex) => {
    const { unit, projection } = row;
    return (
      <article
        class={`workspaceUnit ${unitIndex === 0 ? 'active' : ''}`}
        data-politics-unit
        data-workspace-unit
        data-unit-index={unitIndex}
        data-unit-id={unit.unitId}
        data-state="ORIENT"
        data-explicit-surface-mapping="v1"
        hidden={unitIndex !== 0}
      >
        <header class="unitQuestionHeader">
          <p class="stageEyebrow">先定位 · 不背</p>
          {projection.problem && <h2>{projection.problem}</h2>}
        </header>

        <main class="cognitiveStage" data-cognitive-stage>
          <section class="stageScene" data-stage="ORIENT">
            <PoliticsExplicitSurfacePlan groups={row.orientPrimary} />
            {row.orientSupport.length > 0 && (
              <details class="orientSupport">
                <summary>进一步理解</summary>
                <PoliticsExplicitSurfacePlan groups={row.orientSupport} />
              </details>
            )}
            <div class="stageActions">
              <button type="button" class="primaryAction" data-workspace-action="start-learn">去 iPad / MarginNote 学乘风 →</button>
            </div>
          </section>

          <section class="stageScene" data-stage="EXTERNAL_LEARN" id={`source-${unit.unitId}`} hidden>
            <p class="stageEyebrow">乘风 · 主学习面在 iPad</p>
            <h2>{unit.title}</h2>
            <PoliticsExplicitSurfacePlan groups={row.external} />
            <div class="stageActions splitActions">
              <button type="button" class="secondaryAction" data-workspace-action="back-orient">← 回看定位</button>
              <button type="button" class="secondaryAction" data-workspace-action="learn-close">20 秒闭合（可选）</button>
              <button type="button" class="primaryAction" data-workspace-action="learn-fastpath">直接进入肖1000 →</button>
            </div>
          </section>

          <section class="stageScene closeScene" data-stage="CLOSE" hidden>
            <p class="stageEyebrow">Unit Close</p>
            <h2>{unit.title} · 收口</h2>
            <PoliticsExplicitSurfacePlan groups={row.close} />
            <div class="stageActions splitActions">
              <button type="button" class="secondaryAction" data-workspace-action="close-source">← 回乘风</button>
              <button type="button" class="primaryAction" data-workspace-action="close-verify">进入肖1000 →</button>
            </div>
          </section>

          <section class="stageScene verifyScene" data-stage="VERIFY" hidden>
            <header class="verifyHeader">
              <div><p class="stageEyebrow">肖1000 · Clean attempt</p><h2>干净作答，不提前看框架。</h2></div>
              <span>{unit.questions.length ? `${unit.questions.length} 题` : unit.questionRefCount ? '题目待解析' : '本段无题'}</span>
            </header>

            <section class="politicsQuiz workspaceQuiz" data-politics-quiz>
              {unit.questions.length > 0 ? (
                <div class="politicsQuizDeck">
                  {unit.questions.map((q, qIndex) => (
                    <article
                      class={`politicsQ workspaceQuestion ${qIndex === 0 ? 'active' : ''}`}
                      data-politics-question
                      data-question-id={q.id}
                      data-unit-id={unit.unitId}
                      data-answer={q.answer}
                      data-index={qIndex}
                    >
                      <div class="politicsQMeta"><span>{qIndex + 1} / {unit.questions.length}</span><code>{q.id}</code></div>
                      <h4>{q.stem}</h4>
                      <div class="politicsOptions">
                        {q.options.map((opt) => <button type="button" data-politics-option={opt.label}><b>{opt.label}</b><span>{opt.text}</span></button>)}
                      </div>
                      <div class="politicsActions"><button type="button" data-politics-uncertain>△ 不确定</button><button type="button" class="primary" data-politics-submit>提交</button></div>
                      <div class="politicsResult" data-politics-result hidden></div>
                      <div class="politicsRepair" data-politics-repair hidden>
                        <p class="politicsMicro">只修最小缺口</p>
                        <a href={`#source-${unit.unitId}`}>回到乘风原讲义定位 ↑</a>
                      </div>
                      {q.explanation && <details class="politicsExplain"><summary>需要时再看解析</summary><p>{q.explanation}</p></details>}
                      <button type="button" class="politicsNextQ" data-politics-next hidden>下一题 →</button>
                    </article>
                  ))}
                </div>
              ) : unit.questionRefCount > 0 ? (
                <div class="politicsBlocked"><strong>题目源当前没有可靠解析出来。</strong><p>不猜题干和答案；乘风原讲义学习不受影响。</p></div>
              ) : (
                <div class="politicsBlocked"><strong>当前 Unit 没有 first-ready 题。</strong><p>不制造空验证。</p></div>
              )}
            </section>
          </section>
        </main>

        <aside class="contextualInspector" data-contextual-inspector>
          <section data-inspector-state="ORIENT">
            {row.orientCompanion.length > 0
              ? <PoliticsExplicitSurfacePlan groups={row.orientCompanion} />
              : <p class="explicitQuietCompanion">当前没有需要同时占用注意力的补充。</p>}
          </section>

          <section data-inspector-state="EXTERNAL_LEARN" hidden>
            <header><span>乘风</span><strong>原讲义主学习面</strong></header>
            <p>连续学习在 iPad / MarginNote。</p>
          </section>

          <section data-inspector-state="CLOSE" hidden>
            <header><span>短闭合</span><strong>收一下再做题</strong></header>
          </section>

          <section data-inspector-state="VERIFY" hidden>
            <header><span>肖1000</span><strong>干净作答</strong></header>
            <p>答题前不展示框架、边界或答案提示。</p>
          </section>

          <section data-inspector-state="REPAIR" hidden>
            <header><span>REPAIR</span><strong>只修最小缺口</strong></header>
            <div data-workspace-repair-slot></div>
          </section>
        </aside>
      </article>
    );
  })}

  {chapterContext?.chapterGeometries?.length > 0 && (
    <details class="chapterCloseCompact" id="chapter-close">
      <summary>整章收口</summary>
      <div class="chapterCloseBody">
        {chapterContext.chapterGeometries.map((row) => <Value value={row.value} />)}
      </div>
    </details>
  )}
</section>

<script is:inline>
  (() => {
    const runtime = document.querySelector('[data-politics-cognitive-workspace]');
    if (!runtime) return;

    const lastKey = 'kianos-politics-last-location-v1';
    const evidenceKey = 'kianos-politics-evidence-v1';
    const cursorKey = `kianos-politics-workspace-v1:${runtime.dataset.subject || ''}:${runtime.dataset.chapter || ''}`;
    const units = [...runtime.querySelectorAll('[data-workspace-unit]')];
    const tabs = [...runtime.querySelectorAll('[data-workspace-unit-tab]')];
    const stateLabel = runtime.querySelector('[data-workspace-state-label]');
    const localStudyDay = () => new Date().toLocaleDateString('en-CA');

    const readJson = (key, fallback) => {
      try { return JSON.parse(localStorage.getItem(key) || 'null') || fallback; } catch { return fallback; }
    };
    const saveJson = (key, value) => {
      try { localStorage.setItem(key, JSON.stringify(value)); return true; } catch { return false; }
    };

    const stateToStage = (state) => state === 'REPAIR' ? 'VERIFY' : state;
    const persistCursor = () => {
      const activeUnit = Math.max(0, units.findIndex((unit) => !unit.hidden));
      const states = Object.fromEntries(units.map((unit) => [unit.dataset.unitId || '', unit.dataset.state || 'ORIENT']));
      saveJson(cursorKey, { activeUnit, states, observed_at: new Date().toISOString() });
    };

    const saveLocation = (unit, state, questionId = '') => {
      const previous = readJson(lastKey, {});
      saveJson(lastKey, {
        ...previous,
        subject: runtime.dataset.subject || '',
        chapter: runtime.dataset.chapter || '',
        title: runtime.dataset.title || '',
        href: window.location.pathname,
        unit_id: unit?.dataset.unitId || previous.unit_id || '',
        action: state,
        question_id: questionId,
        observed_at: new Date().toISOString()
      });
    };

    const syncUnitState = (unit, nextState, persist = true) => {
      if (!unit) return;
      const state = String(nextState || 'ORIENT');
      const stage = stateToStage(state);
      unit.dataset.state = state;
      unit.querySelectorAll('[data-stage]').forEach((scene) => {
        scene.hidden = scene.getAttribute('data-stage') !== stage;
      });
      unit.querySelectorAll('[data-inspector-state]').forEach((panel) => {
        panel.hidden = panel.getAttribute('data-inspector-state') !== state;
      });
      if (!unit.hidden && stateLabel) stateLabel.textContent = state;
      if (persist) {
        persistCursor();
        saveLocation(unit, state);
      }
    };

    const setActiveUnit = (index, persist = true) => {
      const safe = Math.max(0, Math.min(units.length - 1, Number(index) || 0));
      units.forEach((unit, i) => {
        unit.hidden = i !== safe;
        unit.classList.toggle('active', i === safe);
      });
      tabs.forEach((tab, i) => tab.classList.toggle('active', i === safe));
      const active = units[safe];
      syncUnitState(active, active?.dataset.state || 'ORIENT', false);
      if (persist) {
        persistCursor();
        saveLocation(active, active?.dataset.state || 'ORIENT');
      }
    };

    const saved = readJson(cursorKey, { activeUnit: 0, states: {} });
    units.forEach((unit) => {
      const stored = saved?.states?.[unit.dataset.unitId || ''];
      if (stored) unit.dataset.state = stored;
    });
    setActiveUnit(saved?.activeUnit || 0, false);

    tabs.forEach((tab) => tab.addEventListener('click', () => {
      setActiveUnit(Number(tab.getAttribute('data-workspace-unit-tab') || 0));
    }));

    runtime.querySelectorAll('[data-workspace-action]').forEach((button) => {
      button.addEventListener('click', () => {
        const unit = button.closest('[data-workspace-unit]');
        const action = button.getAttribute('data-workspace-action');
        if (action === 'start-learn') syncUnitState(unit, 'EXTERNAL_LEARN');
        if (action === 'back-orient') syncUnitState(unit, 'ORIENT');
        if (action === 'learn-close') syncUnitState(unit, 'CLOSE');
        if (action === 'learn-fastpath') syncUnitState(unit, 'VERIFY');
        if (action === 'close-source') syncUnitState(unit, 'EXTERNAL_LEARN');
        if (action === 'close-verify') syncUnitState(unit, 'VERIFY');
      });
    });

    runtime.addEventListener('politics:resume-state', (event) => {
      const unit = event.target?.closest?.('[data-workspace-unit]');
      const state = event.detail?.state;
      if (unit && state) syncUnitState(unit, state);
    });

    runtime.addEventListener('click', (event) => {
      const link = event.target?.closest?.('a[href^="#source-"]');
      if (!link || !runtime.contains(link)) return;
      const unit = link.closest('[data-workspace-unit]');
      if (!unit) return;
      event.preventDefault();
      syncUnitState(unit, 'EXTERNAL_LEARN');
    });

    const recordEvidence = (card, outcome, selected, correctAnswer) => {
      const events = readJson(evidenceKey, []);
      const next = Array.isArray(events) ? events : [];
      next.push({
        subject: runtime.dataset.subject || '',
        chapter: runtime.dataset.chapter || '',
        chapter_title: runtime.dataset.title || '',
        unit_id: card.getAttribute('data-unit-id') || '',
        question_id: card.getAttribute('data-question-id') || '',
        source: 'xiao1000',
        outcome,
        selected,
        correct_answer: correctAnswer,
        study_day: localStudyDay(),
        observed_at: new Date().toISOString()
      });
      saveJson(evidenceKey, next.slice(-500));
    };

    runtime.querySelectorAll('[data-politics-quiz]').forEach((quiz) => {
      const cards = [...quiz.querySelectorAll('[data-politics-question]')];
      const show = (index) => cards.forEach((card, i) => card.classList.toggle('active', i === index));

      cards.forEach((card, index) => {
        const selected = new Set();
        const answer = String(card.getAttribute('data-answer') || '').split('').sort().join('');
        const result = card.querySelector('[data-politics-result]');
        const repair = card.querySelector('[data-politics-repair]');
        const submit = card.querySelector('[data-politics-submit]');
        const next = card.querySelector('[data-politics-next]');
        const uncertain = card.querySelector('[data-politics-uncertain]');
        const unit = card.closest('[data-workspace-unit]');

        card.querySelectorAll('[data-politics-option]').forEach((button) => {
          button.addEventListener('click', () => {
            const label = button.getAttribute('data-politics-option') || '';
            if (selected.has(label)) selected.delete(label); else selected.add(label);
            button.classList.toggle('selected', selected.has(label));
          });
        });

        uncertain?.addEventListener('click', () => uncertain.classList.toggle('active'));

        submit?.addEventListener('click', () => {
          const choice = [...selected].sort().join('');
          if (!choice) return;
          const correct = choice === answer;
          const wasUncertain = Boolean(uncertain?.classList.contains('active'));
          const needsRepair = !correct || wasUncertain;

          result.hidden = false;
          result.className = `politicsResult ${correct && !wasUncertain ? 'correct' : wasUncertain && correct ? 'uncertain' : 'wrong'}`;
          result.textContent = correct
            ? wasUncertain ? '△ 答对了，但你不确定。先补最小缺口，再继续。' : '✓ 对，继续。'
            : `你的答案 ${choice} · 正确答案 ${answer}`;

          repair.hidden = !needsRepair;
          next.hidden = false;

          if (needsRepair) {
            recordEvidence(card, correct ? 'UNCERTAIN' : 'WRONG', choice, answer);
            const slot = unit?.querySelector('[data-workspace-repair-slot]');
            if (slot && repair) slot.appendChild(repair);
            syncUnitState(unit, 'REPAIR');
            saveLocation(unit, 'REPAIR', card.getAttribute('data-question-id') || '');
          }

          card.querySelectorAll('[data-politics-option]').forEach((button) => {
            button.disabled = true;
            if (answer.includes(button.getAttribute('data-politics-option') || '')) button.classList.add('answer');
          });
          if (uncertain) uncertain.disabled = true;
          submit.disabled = true;
        });

        next?.addEventListener('click', () => {
          if (index < cards.length - 1) {
            show(index + 1);
            cards[index + 1].scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            next.textContent = '这一组完成 ✓';
            next.disabled = true;
          }
        });
      });
    });
  })();
</script>

