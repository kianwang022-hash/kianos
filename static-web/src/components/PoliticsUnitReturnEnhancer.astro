---
import { buildPoliticsUnitReturnConfigs } from '../lib/politicsUnitReturn.mjs';

const { chapter } = Astro.props;
const configs = buildPoliticsUnitReturnConfigs(chapter);
---
{configs.map((config) => (
  <span
    hidden
    data-politics-unit-return-config
    data-config={JSON.stringify(config)}
  ></span>
))}

<script>
  import { evaluatePoliticsUnitReturn, recordPoliticsFirstAttempt } from '../lib/politicsUnitReturn.mjs';
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(() => {


  const attemptKey = 'kianos-politics-attempts-v1';
  const lastKey = 'kianos-politics-last-location-v1';
  const runtime = document.querySelector('[data-politics-runtime]');
  const localStudyDay = () => new Date().toLocaleDateString('en-CA');
  const readJson = (key, fallback) => {
    try { return JSON.parse(localStorage.getItem(key) || 'null') || fallback; } catch { return fallback; }
  };
  const saveJson = (key, value) => {
    try {
      localStorage.setItem(key, JSON.stringify(value));
      return true;
    } catch {
      return false;
    }
  };

  let attemptSnapshot = readJson(attemptKey, { schema: 'kianos.politics.attempt_snapshot.v1', units: {} });

  const configRows = [...document.querySelectorAll('[data-politics-unit-return-config]')]
    .map((row) => {
      try { return JSON.parse(row.getAttribute('data-config') || 'null'); } catch { return null; }
    })
    .filter(Boolean);

  const questionCard = (config, questionId) => [...document.querySelectorAll('[data-politics-question]')]
    .find((card) => card.getAttribute('data-question-id') === questionId && card.getAttribute('data-unit-id') === config.runtime_unit_id);

  const unitSectionFor = (config) => {
    const first = questionCard(config, config.expected_question_ids?.[0]);
    return first?.closest('[data-politics-unit]') || null;
  };

  const unitIdForSection = (unitSection) => {
    if (!(unitSection instanceof HTMLElement)) return '';
    const explicit = unitSection.getAttribute('data-unit-id');
    if (explicit) return explicit;
    const source = unitSection.querySelector('[id^="source-"]');
    if (source?.id) return source.id.replace(/^source-/, '');
    return unitSection.querySelector('[data-politics-question]')?.getAttribute('data-unit-id') || '';
  };

  const chapterIdentity = () => ({
    subject: runtime?.getAttribute('data-subject') || '',
    chapter: runtime?.getAttribute('data-chapter') || '',
    title: runtime?.getAttribute('data-title') || ''
  });

  const saveLastLocation = ({ unitId = '', action = '', questionId = '', href = '' } = {}) => {
    if (!runtime) return false;
    const previous = readJson(lastKey, {});
    const identity = chapterIdentity();
    return saveJson(lastKey, {
      ...previous,
      ...identity,
      href: href || `${window.location.pathname}${window.location.hash}`,
      unit_id: unitId || previous?.unit_id || '',
      action: action || previous?.action || '',
      question_id: questionId,
      observed_at: new Date().toISOString()
    });
  };

  const sameChapterLast = () => {
    const last = readJson(lastKey, null);
    if (!last || !runtime) return null;
    const identity = chapterIdentity();
    return last.subject === identity.subject && last.chapter === identity.chapter ? last : null;
  };

  const make = (tag, className, text = '') => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text) node.textContent = text;
    return node;
  };

  const returnIdFor = (config) => `politics-unit-return-${String(config.natural_unit_id || '').replace(/[^a-zA-Z0-9_-]/g, '-')}`;
  const questionIdFor = (questionId) => `politics-question-${String(questionId || '').replace(/[^a-zA-Z0-9_-]/g, '-')}`;

  const dispatchWorkspaceState = (unitSection, state) => {
    if (!unitSection || !state) return;
    unitSection.dispatchEvent(new CustomEvent('politics:resume-state', {
      bubbles: true,
      detail: { state }
    }));
  };

  const cardsFor = (config) => (config.expected_question_ids || [])
    .map((questionId) => questionCard(config, questionId))
    .filter(Boolean);

  const activateQuestion = (config, questionId) => {
    const cards = cardsFor(config);
    const target = questionCard(config, questionId);
    if (!target) return null;
    cards.forEach((card) => card.classList.toggle('active', card === target));
    target.id = questionIdFor(questionId);
    return target;
  };

  const attemptFor = (config, questionId) => attemptSnapshot?.units?.[String(config.unit_key || '')]?.attempts?.[questionId] || null;

  const showPersistenceFailure = (config) => {
    const unitSection = unitSectionFor(config);
    const quiz = unitSection?.querySelector('[data-politics-quiz]');
    if (!unitSection || !quiz) return;
    let warning = unitSection.querySelector('[data-politics-attempt-persistence-error]');
    if (!warning) {
      warning = make('div', 'politicsAttemptPersistenceError');
      warning.setAttribute('data-politics-attempt-persistence-error', '');
      const strong = make('strong', '', '本轮证据没有保存下来。');
      const copy = make('p', '', '为保护 first attempt，Unit Return 暂不推进。恢复浏览器本地存储后刷新，再重新作答这一题；系统不会用未持久化的结果假装闭合。');
      warning.append(strong, copy);
      quiz.insertAdjacentElement('afterend', warning);
    }
    warning.hidden = false;
  };

  const clearPersistenceFailure = (config) => {
    const unitSection = unitSectionFor(config);
    unitSection?.querySelector('[data-politics-attempt-persistence-error]')?.remove();
  };

  const ensureReturnUi = (config) => {
    const unitSection = unitSectionFor(config);
    if (!unitSection) return null;
    const id = returnIdFor(config);
    const existing = document.getElementById(id);
    if (existing) return existing;
    const quiz = unitSection.querySelector('[data-politics-quiz]');
    if (!quiz) return null;

    const section = make('section', 'politicsUnitReturn');
    section.id = id;
    section.hidden = true;
    section.setAttribute('data-politics-unit-return', '');

    const micro = make('p', 'politicsMicro', 'Unit Return · 本轮证据');
    const title = make('h3', '', `${config.title} · 本轮收口`);
    const summary = make('p', 'politicsUnitReturnSummary');
    summary.setAttribute('data-unit-return-summary', '');
    const nodeList = make('div', 'politicsUnitReturnNodes');

    for (const nodeConfig of config.nodes || []) {
      const row = make('article', 'politicsUnitReturnNode');
      row.setAttribute('data-unit-return-node', nodeConfig.node_id);
      const copy = make('div', 'politicsUnitReturnNodeCopy');
      copy.append(make('strong', '', nodeConfig.label));
      const meta = nodeConfig.deferred_question_count > 0
        ? `当前 ${nodeConfig.current_question_count} 题 · 后续另有 ${nodeConfig.deferred_question_count} 题延后证据`
        : `当前 ${nodeConfig.current_question_count} 题`;
      copy.append(make('small', '', meta));
      const state = make('span', 'politicsUnitReturnState', '等待');
      state.setAttribute('data-unit-return-state', '');
      const repair = make('a', 'politicsUnitReturnRepair', '回乘风修这一点 ↑');
      repair.setAttribute('data-unit-return-repair', '');
      repair.href = `#${config.source_anchor}`;
      repair.hidden = true;
      row.append(copy, state, repair);
      nodeList.append(row);
    }

    const precisionCopy = config.evidence_precision === 'NATURAL_UNIT_SAFE_FALLBACK'
      ? '当前按 Natural Unit 做安全收口；没有经过 Source 验证的更细节点不会被系统假装出来。'
      : '当前按已验证的 canonical node 做收口。';
    const guard = make('p', 'politicsUnitReturnGuard', `STABLE 只表示这轮首次作答没有暴露缺口，不等于长期掌握。${precisionCopy}`);
    const continueButton = make('button', 'politicsUnitReturnContinue', '继续学习 →');
    continueButton.type = 'button';
    continueButton.setAttribute('data-unit-return-continue', '');
    continueButton.addEventListener('click', () => {
      const allUnits = [...document.querySelectorAll('[data-politics-unit]')];
      const currentIndex = allUnits.indexOf(unitSection);
      const target = currentIndex >= 0 && currentIndex < allUnits.length - 1
        ? allUnits[currentIndex + 1]
        : document.getElementById('chapter-close');
      const nextUnitId = target?.matches?.('[data-politics-unit]') ? unitIdForSection(target) : '';
      saveLastLocation({
        unitId: nextUnitId,
        action: nextUnitId ? 'ORIENT' : 'CHAPTER_CLOSE',
        href: target?.id ? `${window.location.pathname}#${target.id}` : window.location.pathname
      });
      target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    section.append(micro, title, summary, nodeList, guard, continueButton);
    quiz.insertAdjacentElement('afterend', section);
    return section;
  };

  const ensureQuestionRepairReturn = (config, card) => {
    const source = document.getElementById(config.source_anchor);
    const questionId = card?.getAttribute('data-question-id') || '';
    if (!source || !questionId) return null;
    let link = source.querySelector(`[data-politics-return-to-question="${questionId}"]`);
    if (!link) {
      link = make('a', 'politicsReturnToQuestion', '修完回这一题 ↓');
      link.setAttribute('data-politics-return-to-question', questionId);
      source.append(link);
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const target = activateQuestion(config, questionId);
        const unitSection = unitSectionFor(config);
        dispatchWorkspaceState(unitSection, 'REPAIR');
        saveLastLocation({
          unitId: config.runtime_unit_id,
          action: 'REPAIR',
          questionId,
          href: `${window.location.pathname}#${questionIdFor(questionId)}`
        });
        requestAnimationFrame(() => target?.scrollIntoView({ behavior: 'smooth', block: 'center' }));
      });
    }
    link.href = `#${questionIdFor(questionId)}`;
    return link;
  };

  const syncRepairReturnLink = (config, evaluation, section) => {
    const source = document.getElementById(config.source_anchor);
    if (!source) return;
    let link = source.querySelector('[data-politics-return-after-repair]');
    const needsReturn = evaluation.ready && evaluation.unit_state !== 'STABLE';
    if (!needsReturn) {
      link?.remove();
      return;
    }
    if (!link) {
      link = make('a', 'politicsReturnAfterRepair', '修完后回本轮收口 ↓');
      link.setAttribute('data-politics-return-after-repair', '');
      source.append(link);
    }
    link.href = `#${section.id}`;
  };

  const renderUnitReturn = (config) => {
    const section = ensureReturnUi(config);
    if (!section) return null;
    const evaluation = evaluatePoliticsUnitReturn(config, attemptSnapshot);
    section.hidden = !evaluation.ready;
    if (!evaluation.ready) return evaluation;

    const repairCount = evaluation.nodes.filter((node) => node.state === 'REPAIR').length;
    const uncertainCount = evaluation.nodes.filter((node) => node.state === 'UNCERTAIN').length;
    const summary = section.querySelector('[data-unit-return-summary]');
    if (summary) {
      const completed = `${evaluation.completed_question_count} / ${evaluation.expected_question_count}`;
      const nodeCount = evaluation.nodes.length;
      summary.textContent = evaluation.unit_state === 'STABLE'
        ? `${completed} 首次作答证据已齐；${nodeCount} 个证据节点本轮都没有暴露缺口。`
        : `${completed} 首次作答证据已齐；${repairCount} 个节点需要修复，${uncertainCount} 个节点仍不确定。`;
    }

    const stateLabels = { STABLE: '本轮稳定', UNCERTAIN: '不确定', REPAIR: '需要修复' };
    for (const node of evaluation.nodes) {
      const row = [...section.querySelectorAll('[data-unit-return-node]')]
        .find((candidate) => candidate.getAttribute('data-unit-return-node') === node.node_id);
      if (!row) continue;
      row.setAttribute('data-state', node.state);
      const state = row.querySelector('[data-unit-return-state]');
      if (state) state.textContent = stateLabels[node.state] || node.state;
      const repair = row.querySelector('[data-unit-return-repair]');
      if (repair) repair.hidden = node.state === 'STABLE';
    }

    const continueButton = section.querySelector('[data-unit-return-continue]');
    if (continueButton) continueButton.textContent = evaluation.unit_state === 'STABLE' ? '继续学习 →' : '修完后继续 →';
    syncRepairReturnLink(config, evaluation, section);
    return evaluation;
  };

  const restoreAttemptCard = (config, questionId, attempt) => {
    const card = activateQuestion(config, questionId);
    const unitSection = unitSectionFor(config);
    if (!card || !unitSection || !attempt) return false;

    const selected = new Set(String(attempt.selected || '').split('').filter(Boolean));
    const answer = String(attempt.correct_answer || '').split('').sort().join('');
    const outcome = String(attempt.outcome || '').toUpperCase();
    const result = card.querySelector('[data-politics-result]');
    const repair = card.querySelector('[data-politics-repair]');
    const submit = card.querySelector('[data-politics-submit]');
    const uncertain = card.querySelector('[data-politics-uncertain]');
    const next = card.querySelector('[data-politics-next]');

    card.querySelectorAll('[data-politics-option]').forEach((button) => {
      const label = String(button.getAttribute('data-politics-option') || '');
      button.classList.toggle('selected', selected.has(label));
      button.classList.toggle('answer', answer.includes(label));
      button.disabled = true;
    });
    if (uncertain) {
      uncertain.classList.toggle('active', outcome === 'UNCERTAIN');
      uncertain.disabled = true;
    }
    if (submit) submit.disabled = true;

    const needsRepair = outcome === 'WRONG' || outcome === 'UNCERTAIN';
    if (result) {
      result.hidden = false;
      result.className = `politicsResult ${outcome === 'WRONG' ? 'wrong' : outcome === 'UNCERTAIN' ? 'uncertain' : 'correct'}`;
      result.textContent = outcome === 'WRONG'
        ? `你的首次答案 ${attempt.selected || ''} · 正确答案 ${attempt.correct_answer || ''}`
        : outcome === 'UNCERTAIN'
          ? '△ 首次答对，但当时不确定。继续完成最小修复。'
          : '✓ 首次作答稳定。';
    }

    if (repair) {
      repair.hidden = !needsRepair;
      if (needsRepair) {
        const slot = unitSection.querySelector('[data-workspace-repair-slot]');
        if (slot) slot.appendChild(repair);
      }
    }
    if (next) {
      next.hidden = !needsRepair;
      const cards = cardsFor(config);
      const index = cards.indexOf(card);
      next.textContent = index >= 0 && index < cards.length - 1 ? '修完继续下一题 →' : '修完进入 Unit Close →';
    }

    if (needsRepair) {
      ensureQuestionRepairReturn(config, card);
      dispatchWorkspaceState(unitSection, 'REPAIR');
    }
    return needsRepair;
  };

  const resumeConfig = (config) => {
    const section = ensureReturnUi(config);
    const evaluation = renderUnitReturn(config) || evaluatePoliticsUnitReturn(config, attemptSnapshot);
    const unitSection = unitSectionFor(config);
    if (!unitSection) return;
    const last = sameChapterLast();
    const matchesUnit = last && [config.runtime_unit_id, config.natural_unit_id].includes(String(last.unit_id || ''));

    cardsFor(config).forEach((card) => {
      const questionId = card.getAttribute('data-question-id') || '';
      if (questionId) card.id = questionIdFor(questionId);
    });

    if (matchesUnit && ['REPAIR', 'REPAIR_SOURCE'].includes(String(last.action || '')) && last.question_id) {
      const attempt = attemptFor(config, last.question_id);
      if (attempt && ['WRONG', 'UNCERTAIN'].includes(String(attempt.outcome || '').toUpperCase())) {
        const card = questionCard(config, last.question_id);
        restoreAttemptCard(config, last.question_id, attempt);
        if (card) ensureQuestionRepairReturn(config, card);
        if (last.action === 'REPAIR_SOURCE') dispatchWorkspaceState(unitSection, 'EXTERNAL_LEARN');
        return;
      }
    }

    if (!evaluation.ready) {
      const pending = evaluation.pending_question_ids || [];
      if (!pending.length) return;
      const preferred = matchesUnit && pending.includes(String(last?.question_id || ''))
        ? String(last.question_id)
        : pending[0];
      activateQuestion(config, preferred);
      if (matchesUnit) {
        dispatchWorkspaceState(unitSection, 'VERIFY');
        saveLastLocation({
          unitId: config.runtime_unit_id,
          action: 'VERIFY',
          questionId: preferred,
          href: `${window.location.pathname}#${questionIdFor(preferred)}`
        });
      }
      return;
    }

    cardsFor(config).forEach((card) => card.classList.remove('active'));
    if (matchesUnit && section) {
      dispatchWorkspaceState(unitSection, 'VERIFY');
      saveLastLocation({
        unitId: config.runtime_unit_id,
        action: 'UNIT_RETURN',
        href: `${window.location.pathname}#${section.id}`
      });
    }
  };

  const captureFirstAttempt = (config, card, submit) => {
    queueMicrotask(() => {
      if (!submit.disabled) return;
      const selected = [...card.querySelectorAll('[data-politics-option].selected')]
        .map((button) => String(button.getAttribute('data-politics-option') || ''))
        .filter(Boolean)
        .sort()
        .join('');
      if (!selected) return;
      const questionId = card.getAttribute('data-question-id') || '';
      const answer = String(card.getAttribute('data-answer') || '').split('').sort().join('');
      const uncertain = Boolean(card.querySelector('[data-politics-uncertain]')?.classList.contains('active'));
      const correct = selected === answer;
      const outcome = correct ? (uncertain ? 'UNCERTAIN' : 'STABLE') : 'WRONG';
      const recorded = recordPoliticsFirstAttempt(attemptSnapshot, config, {
        question_id: questionId,
        outcome,
        selected,
        correct_answer: answer,
        study_day: localStudyDay(),
        observed_at: new Date().toISOString()
      });

      if (recorded.recorded) {
        if (!saveJson(attemptKey, recorded.store)) {
          showPersistenceFailure(config);
          return;
        }
        attemptSnapshot = recorded.store;
        clearPersistenceFailure(config);
      } else {
        attemptSnapshot = recorded.store;
      }

      const evaluation = renderUnitReturn(config) || evaluatePoliticsUnitReturn(config, attemptSnapshot);
      if (outcome === 'WRONG' || outcome === 'UNCERTAIN') {
        ensureQuestionRepairReturn(config, card);
        saveLastLocation({
          unitId: config.runtime_unit_id,
          action: 'REPAIR',
          questionId,
          href: `${window.location.pathname}#${questionIdFor(questionId)}`
        });
      } else if (evaluation.ready) {
        saveLastLocation({
          unitId: config.runtime_unit_id,
          action: 'UNIT_RETURN',
          href: `${window.location.pathname}#${returnIdFor(config)}`
        });
      } else {
        const nextPending = evaluation.pending_question_ids?.[0] || '';
        saveLastLocation({
          unitId: config.runtime_unit_id,
          action: 'VERIFY',
          questionId: nextPending,
          href: nextPending ? `${window.location.pathname}#${questionIdFor(nextPending)}` : window.location.pathname
        });
      }
    });
  };

  const installRepairSourceReturn = (config, card) => {
    const sourceLink = card.querySelector('[data-politics-repair] a[href^="#source-"]');
    if (!sourceLink) return;
    sourceLink.addEventListener('click', () => {
      const questionId = card.getAttribute('data-question-id') || '';
      ensureQuestionRepairReturn(config, card);
      saveLastLocation({
        unitId: config.runtime_unit_id,
        action: 'REPAIR_SOURCE',
        questionId,
        href: sourceLink.getAttribute('href') ? `${window.location.pathname}${sourceLink.getAttribute('href')}` : window.location.pathname
      });
    });
  };

  const installNextCursor = (config, card) => {
    const next = card.querySelector('[data-politics-next]');
    if (!next) return;
    next.addEventListener('click', () => queueMicrotask(() => {
      const evaluation = evaluatePoliticsUnitReturn(config, attemptSnapshot);
      const nextPending = evaluation.pending_question_ids?.[0] || '';
      if (nextPending) {
        saveLastLocation({
          unitId: config.runtime_unit_id,
          action: 'VERIFY',
          questionId: nextPending,
          href: `${window.location.pathname}#${questionIdFor(nextPending)}`
        });
      } else {
        saveLastLocation({
          unitId: config.runtime_unit_id,
          action: 'UNIT_RETURN',
          href: `${window.location.pathname}#${returnIdFor(config)}`
        });
      }
    }));
  };

  for (const config of configRows) {
    ensureReturnUi(config);
    for (const questionId of config.expected_question_ids || []) {
      const card = questionCard(config, questionId);
      const submit = card?.querySelector('[data-politics-submit]');
      if (!card || !(submit instanceof HTMLButtonElement)) continue;
      card.id = questionIdFor(questionId);
      submit.addEventListener('click', () => captureFirstAttempt(config, card, submit));
      installRepairSourceReturn(config, card);
      installNextCursor(config, card);
    }
    resumeConfig(config);
  }

  if (runtime && !runtime.hasAttribute('data-politics-cognitive-workspace') && 'IntersectionObserver' in window) {
    const cursorObserver = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      const node = visible?.target;
      if (!(node instanceof HTMLElement)) return;
      const unitSection = node.closest('[data-politics-unit]');
      const unitId = unitIdForSection(unitSection);
      const current = sameChapterLast();
      // A Workbench source-return query owns this visit. Passive scrolling must
      // not erase its original question/session even when another Unit is visible.
      const returnParams = new URLSearchParams(window.location.search);
      if (current?.action === 'PRACTICE_REFERENCE'
        && returnParams.get('practiceSession')
        && returnParams.get('practiceQuestion') === current.question_id) return;
      // Passive visibility in this same Unit is not explicit learner navigation.
      if (current && current.unit_id === unitId && (
        String(current.action || '').startsWith('REPAIR')
        || ['VERIFY', 'UNIT_RETURN'].includes(String(current.action || ''))
      )) return;

      if (node.matches('[data-politics-external-source]')) {
        saveLastLocation({ unitId, action: 'EXTERNAL_LEARN', href: `${window.location.pathname}#${node.id}` });
        return;
      }
      if (node.matches('[data-politics-quiz]')) {
        const active = node.querySelector('[data-politics-question].active');
        const questionId = active?.getAttribute('data-question-id') || '';
        saveLastLocation({
          unitId,
          action: 'VERIFY',
          questionId,
          href: questionId ? `${window.location.pathname}#${questionIdFor(questionId)}` : window.location.pathname
        });
        return;
      }
      if (unitSection === node) {
        saveLastLocation({ unitId, action: 'ORIENT', href: node.id ? `${window.location.pathname}#${node.id}` : window.location.pathname });
      }
    }, { threshold: [0.45, 0.65] });

    document.querySelectorAll('[data-politics-unit], [data-politics-external-source], [data-politics-quiz]')
      .forEach((node) => cursorObserver.observe(node));
  }

  });
</script>

<style>
