---
import PoliticsExplicitSurfacePlan from './PoliticsExplicitSurfacePlan.astro';

const { chapter, compiled = null } = Astro.props;

const repairs = (chapter?.units || []).flatMap((unit) =>
  (unit.questions || [])
    .filter((question) => question?.repair)
    .map((question) => ({ questionId: question.id, repair: question.repair }))
);

const explicitRepairRows = compiled instanceof Map
  ? [...compiled.values()].filter((row) => row?.surfacePlan?.states?.REPAIR?.length > 0)
  : [];

function hitLabel(hit) {
  if (!hit) return '';
  if (typeof hit === 'string') return hit;
  return String(hit.note || hit.title || hit.natural_unit_id || hit.region_id || '').trim();
}

const handoffMap = Object.fromEntries(repairs.map(({ questionId, repair }) => [questionId, {
  tested_node: repair.tested_node || '',
  owner_natural_unit_id: repair.owner_natural_unit_id || '',
  current_unit_hits: (repair.current_unit_hits || []).map((hit) => ({
    natural_unit_id: hit.natural_unit_id || '',
    region_id: hit.region_id || '',
    note: hitLabel(hit),
    source_basis: hit.source_basis || ''
  })),
  cross_unit_hits: (repair.cross_unit_hits || []).map((hit) => ({
    natural_unit_id: hit.natural_unit_id || '',
    region_id: hit.region_id || '',
    note: hitLabel(hit),
    source_basis: hit.source_basis || ''
  }))
}]));
const handoffJson = JSON.stringify(handoffMap).replace(/</g, '\\u003c');
---

{explicitRepairRows.length > 0 && (
  <div hidden data-politics-explicit-repair-registry>
    {explicitRepairRows.map((row) => (
      <section data-explicit-repair-unit={row.unitId}>
        <template data-explicit-repair-template>
          <PoliticsExplicitSurfacePlan groups={row.surfacePlan.states.REPAIR} />
        </template>
      </section>
    ))}
  </div>
)}

{repairs.length > 0 && <script type="application/json" id="politics-repair-handoff-map" set:html={handoffJson}></script>}

<script is:inline>
  (() => {
    const registry = document.querySelector('[data-politics-explicit-repair-registry]');

    // REPAIR timing stays question-triggered, but every mapped question drawer
    // consumes one resolved Surface Mapping payload. The legacy question.repair
    // object remains evidence metadata only and cannot become parallel teaching.
    document.querySelectorAll('[data-politics-unit]').forEach((unit) => {
      const unitId = unit.getAttribute('data-unit-id') || '';
      if (!unitId || !registry) return;
      const entry = registry.querySelector(`[data-explicit-repair-unit="${CSS.escape(unitId)}"]`);
      const template = entry?.querySelector('template[data-explicit-repair-template]');
      if (!(template instanceof HTMLTemplateElement)) return;

      unit.querySelectorAll('[data-politics-repair]').forEach((drawer) => {
        drawer.querySelectorAll(
          ':scope > ul,:scope > p:not(.politicsMicro),:scope > [data-politics-explicit-surface-plan]'
        ).forEach((node) => node.remove());
        const plan = template.content.cloneNode(true);
        const sourceLink = drawer.querySelector('a');
        if (sourceLink) sourceLink.before(plan);
        else drawer.append(plan);
        drawer.setAttribute('data-explicit-repair-surface', 'v1');
      });
    });

  })();

  const payloadNode = document.getElementById('politics-repair-handoff-map');
  let repairMap = {};
  try { repairMap = JSON.parse(payloadNode?.textContent || '{}'); } catch {}

  document.querySelectorAll('[data-politics-question]').forEach((card) => {
    const questionId = card.getAttribute('data-question-id') || '';
    const repair = repairMap[questionId];
    const submit = card.querySelector('[data-politics-submit]');
    if (!repair || !submit) return;
    submit.addEventListener('click', () => setTimeout(() => {
      try {
        const key = 'kianos-politics-evidence-v1';
        const events = JSON.parse(localStorage.getItem(key) || '[]');
        if (!Array.isArray(events) || !events.length) return;
        for (let index = events.length - 1; index >= 0; index -= 1) {
          if (events[index]?.question_id !== questionId) continue;
          events[index] = {
            ...events[index],
            tested_node: repair.tested_node || '',
            owner_natural_unit_id: repair.owner_natural_unit_id || '',
            current_unit_hits: repair.current_unit_hits || [],
            cross_unit_hits: repair.cross_unit_hits || []
          };
          localStorage.setItem(key, JSON.stringify(events.slice(-500)));
          break;
        }
      } catch {}
    }, 0));
  });
</script>

