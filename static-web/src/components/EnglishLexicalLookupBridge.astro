---
const base = import.meta.env.BASE_URL;
---
<div class="englishSelectionMenu" data-english-selection-menu data-base={base} hidden>
  <button type="button" data-selection-lexical>Lexical 查词</button>
  <button type="button" data-selection-highlight>高亮</button>
  <button type="button" data-selection-chat>Chat 上下文</button>
  <small data-selection-status></small>
</div>

<div class="englishLexicalReturn" data-english-lexical-return hidden>
  <div>
    <span>ENGLISH → VOCABULARY</span>
    <strong data-english-return-title>返回 English</strong>
    <small data-english-return-meta></small>
  </div>
  <button type="button" data-english-return-action>返回原任务</button>
  <button type="button" class="dismiss" data-english-return-dismiss aria-label="关闭返回提示">×</button>
</div>

<script>
  import {markEnglishAssistance, recordEnglishReadingLookup, taskMetadata, updateEnglishReadingDiscussion, englishReadingDiscussionSpans} from "../lib/englishLearnerEvidence.mjs";
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(() => {

  const menu = document.querySelector('[data-english-selection-menu]');
  const returnBar = document.querySelector('[data-english-lexical-return]');
  if (menu instanceof HTMLElement && returnBar instanceof HTMLElement) {
    const base = menu.getAttribute('data-base') || '/';
    const CONTEXT_KEY = 'kianos-english-lexical-return-v1';
    const HIGHLIGHT_NAME = 'kianos-english-selection';
    const sourceSelectors = [
      '[data-local-port="reading"] [data-reading-passage]',
      '[data-objective-root][data-objective-task="cloze"] [data-objective-material]',
      '[data-translation-runtime] [data-translation-source-text]',
      '[data-external-reading-runtime] [data-external-passage]'
    ];
    let activeSelection = null;

    const readContext = () => {
      try { return JSON.parse(sessionStorage.getItem(CONTEXT_KEY) || 'null'); }
      catch { return null; }
    };
    const writeContext = (value) => {
      try { sessionStorage.setItem(CONTEXT_KEY, JSON.stringify(value)); return true; }
      catch { return false; }
    };
    const clearContext = () => {
      try { sessionStorage.removeItem(CONTEXT_KEY); } catch {}
    };
    const compact = (value, max = 1200) => String(value || '').replace(/\s+/g, ' ').trim().slice(0, max);
    const exactToken = (value) => /^[A-Za-z]+(?:[-'’][A-Za-z]+)*$/.test(String(value || '').trim());
    const currentHref = () => `${location.pathname}${location.search}${location.hash}`;

    const routeContext = (sourceRoot) => {
      const reading = sourceRoot.closest('[data-local-port="reading"]');
      if (reading instanceof HTMLElement) return {
        task: 'Reading A',
        objectId: reading.getAttribute('data-reading-object') || '',
        sourceRoot,
        taskRoot: reading
      };
      const cloze = sourceRoot.closest('[data-objective-root][data-objective-task="cloze"]');
      if (cloze instanceof HTMLElement) return {
        task: 'Cloze',
        objectId: cloze.getAttribute('data-objective-object') || '',
        sourceRoot
      };
      const translation = sourceRoot.closest('[data-translation-runtime]');
      if (translation instanceof HTMLElement) return {
        task: 'Translation',
        objectId: translation.getAttribute('data-object-id') || '',
        sourceRoot
      };
      const external = sourceRoot.closest('[data-external-reading-runtime]');
      if (external instanceof HTMLElement) {
        const id = new URLSearchParams(location.search).get('id') || '';
        return { task: 'External Reading', objectId: id, sourceRoot };
      }
      return null;
    };

    const sourceForRange = (range) => {
      const start = range.startContainer instanceof Element ? range.startContainer : range.startContainer.parentElement;
      if (!(start instanceof Element)) return null;
      const source = start.closest(sourceSelectors.join(','));
      if (!(source instanceof HTMLElement)) return null;
      if (!source.contains(range.endContainer)) return null;
      return source;
    };

    const hideMenu = () => {
      menu.hidden = true;
      activeSelection = null;
    };

    const placeMenu = (rect) => {
      const width = Math.min(390, Math.max(250, menu.offsetWidth || 320));
      const left = Math.min(window.innerWidth - width - 12, Math.max(12, rect.left));
      const top = Math.min(window.innerHeight - 74, Math.max(68, rect.bottom + 10));
      menu.style.left = `${left}px`;
      menu.style.top = `${top}px`;
    };

    // Offsets refer only to passage paragraphs, excluding changing timer/selection chrome.
    const readingModel = (source) => {
      const paragraphs = [...source.querySelectorAll('p')];
      let text = '';
      const segments = paragraphs.map((paragraph,index) => {
        if(index) text += '\n\n';
        const start = text.length;
        text += paragraph.textContent || '';
        return {paragraph,start,end:text.length};
      });
      return {text,segments};
    };
    const discussionSelection = (source,range) => {
      const model = readingModel(source);
      const offset = (node,position) => {
        const segment = model.segments.find(row=>row.paragraph.contains(node));
        if(!segment) return null;
        const prefix = document.createRange();
        prefix.selectNodeContents(segment.paragraph);
        prefix.setEnd(node,position);
        return segment.start + prefix.toString().length;
      };
      const start = offset(range.startContainer,range.startOffset);
      const end = offset(range.endContainer,range.endOffset);
      if(start==null || end==null || end<=start) return null;
      return {start,end,text:model.text.slice(start,end)};
    };
    const discussionRange = (model,span) => {
      if(model.text.slice(span.start,span.end)!==span.text) return null;
      const point = (offset) => {
        const segment = model.segments.find(row=>offset>=row.start && offset<=row.end);
        if(!segment) return null;
        const walker = document.createTreeWalker(segment.paragraph,NodeFilter.SHOW_TEXT);
        let remaining = offset-segment.start, node;
        while((node=walker.nextNode())) {
          if(remaining<=node.textContent.length) return [node,remaining];
          remaining-=node.textContent.length;
        }
        return null;
      };
      const start = point(span.start), end = point(span.end);
      if(!start || !end) return null;
      const range = document.createRange();
      range.setStart(...start);range.setEnd(...end);
      return range;
    };
    let discussionObserver = null;
    const observeDiscussion = () => {
      const root=document.querySelector('[data-local-port="reading"]');
      if(root)discussionObserver?.observe(root,{childList:true,subtree:true,attributes:true,attributeFilter:['data-english-source-hash']});
    };
    const renderDiscussion = () => {
      // Re-anchoring marks/panel must not trigger our own mutation observer.
      discussionObserver?.disconnect();
      try {
      const root = document.querySelector('[data-local-port="reading"]');
      const source = root?.querySelector('[data-reading-passage]');
      if(!(root instanceof HTMLElement) || !(source instanceof HTMLElement)) return;
      // Fallback marks alter nodes only, never passage text or offsets.
      source.querySelectorAll('mark[data-reading-discussion-mark]').forEach(mark=>mark.replaceWith(...mark.childNodes));
      CSS.highlights?.delete('kianos-reading-discussion');
      let panel = root.querySelector('[data-reading-discussion-panel]');
      if(!panel) {
        panel = document.createElement('details');
        panel.setAttribute('data-reading-discussion-panel','');
        panel.className = 'englishReadingDiscussion';
        root.querySelector('.portedReadingQuestionNav')?.after(panel);
      }
      panel.replaceChildren();panel.hidden=true;
      if(new URLSearchParams(location.search).has('exam_session')) return;
      let meta,attempt;
      try {
        meta=taskMetadata(root,'reading_a',root.dataset.readingObject);
        attempt=JSON.parse(localStorage.getItem('kianos-reading-attempt-v1:'+meta.object_id)||'null');
      } catch { return; }
      const spans=englishReadingDiscussionSpans(attempt,meta.source_hash);
      if(!spans.length) return;
      const model=readingModel(source), ranges=[];
      const summary=document.createElement('summary');
      summary.textContent=`Chat 上下文 · ${spans.length} 段`;
      panel.append(summary);panel.hidden=false;
      for(const span of spans) {
        const range=discussionRange(model,span);
        if(range)ranges.push(range);
        const row=document.createElement('div');
        row.setAttribute('data-reading-discussion-span',span.span_id);
        const text=document.createElement('span');text.textContent=span.text+(range?'':'（原文定位已变化，保留记录）');
        const remove=document.createElement('button');remove.type='button';remove.textContent='移除';
        remove.setAttribute('data-reading-discussion-remove',span.span_id);
        remove.addEventListener('click',()=>{
          updateEnglishReadingDiscussion(localStorage,meta,{removeId:span.span_id});renderDiscussion();
        });
        row.append(text,remove);panel.append(row);
      }
      const clear=document.createElement('button');clear.type='button';clear.textContent='清空上下文';
      clear.setAttribute('data-reading-discussion-clear','');
      clear.addEventListener('click',()=>{updateEnglishReadingDiscussion(localStorage,meta,{clear:true});renderDiscussion();});
      panel.append(clear);
      if('highlights' in CSS && typeof Highlight!=='undefined')CSS.highlights.set('kianos-reading-discussion',new Highlight(...ranges));
      else {
        // Apply text-node marks from the end so earlier offsets remain intact.
        for(const range of ranges.reverse()) {
          const walker=document.createTreeWalker(source,NodeFilter.SHOW_TEXT), nodes=[];
          let node;
          while((node=walker.nextNode()))if(range.intersectsNode(node))nodes.push(node);
          for(const node of nodes.reverse()) {
            const start=node===range.startContainer?range.startOffset:0;
            const end=node===range.endContainer?range.endOffset:node.textContent.length;
            if(end<=start)continue;
            const part=document.createRange();part.setStart(node,start);part.setEnd(node,end);
            const mark=document.createElement('mark');mark.setAttribute('data-reading-discussion-mark','');
            part.surroundContents(mark);
          }
        }
      }
      } finally { observeDiscussion(); }
    };

    const captureSelection = () => {
      const selection = window.getSelection();
      if (!selection || selection.rangeCount === 0 || selection.isCollapsed) { hideMenu(); return; }
      const range = selection.getRangeAt(0);
      const sourceRoot = sourceForRange(range);
      if (!sourceRoot) { hideMenu(); return; }
      const text = compact(selection.toString(), 320);
      if (!text) { hideMenu(); return; }
      const route = routeContext(sourceRoot);
      if (!route) { hideMenu(); return; }
      const rect = range.getBoundingClientRect();
      const localContext = range.startContainer.parentElement?.closest('p,blockquote,.translationSegment,[data-objective-material-block]');
      const sourceBlocks = [...sourceRoot.querySelectorAll('p,blockquote,[data-objective-material-block]')];
      const blockIndex = localContext instanceof Element ? sourceBlocks.indexOf(localContext) : -1;
      const focusedQuestionId = route.task === 'Reading A' && route.taskRoot instanceof HTMLElement
        ? route.taskRoot.querySelector('[data-question].is-current')?.getAttribute('data-question') || ''
        : '';
      activeSelection = {
        text,
        word: exactToken(text) ? text : '',
        range: range.cloneRange(),
        sourceRoot,
        task: route.task,
        objectId: route.objectId,
        nearby: compact(localContext?.textContent || sourceRoot.textContent, 1200),
        sourceLocator: localContext instanceof HTMLElement && localContext.id
          ? `#${localContext.id}`
          : blockIndex >= 0 ? `block:${blockIndex + 1}` : '',
        focusedQuestionId,
        discussion: route.task === 'Reading A' ? discussionSelection(sourceRoot,range) : null,
        rect
      };
      const lexical = menu.querySelector('[data-selection-lexical]');
      if (lexical instanceof HTMLButtonElement) lexical.hidden = !activeSelection.word;
      const status = menu.querySelector('[data-selection-status]');
      if (status) status.textContent = activeSelection.word ? activeSelection.word : `${text.length} chars`;
      menu.hidden = new URLSearchParams(location.search).has('exam_session');
      requestAnimationFrame(() => placeMenu(rect));
    };

    document.addEventListener('mouseup', (event) => {
      if (event.target instanceof Element && event.target.closest('[data-english-selection-menu]')) return;
      requestAnimationFrame(captureSelection);
    });
    document.addEventListener('keyup', (event) => {
      if (event.key === 'Shift' || event.key.startsWith('Arrow')) requestAnimationFrame(captureSelection);
    });
    document.addEventListener('mousedown', (event) => {
      if (!(event.target instanceof Element) || event.target.closest('[data-english-selection-menu]')) return;
      if (!event.target.closest(sourceSelectors.join(','))) hideMenu();
    });
    menu.addEventListener('pointerdown', (event) => event.preventDefault());

    const applyHighlight = () => {
      if (!activeSelection?.range) return false;
      const range = activeSelection.range.cloneRange();
      try {
        if ('highlights' in CSS && typeof Highlight !== 'undefined') {
          let highlight = CSS.highlights.get(HIGHLIGHT_NAME);
          if (!highlight) {
            highlight = new Highlight();
            CSS.highlights.set(HIGHLIGHT_NAME, highlight);
          }
          highlight.add(range);
          return true;
        }
      } catch {}
      try {
        const mark = document.createElement('mark');
        mark.className = 'englishUserHighlight';
        range.surroundContents(mark);
        return true;
      } catch { return false; }
    };

    menu.querySelector('[data-selection-highlight]')?.addEventListener('click', () => {
      const status = menu.querySelector('[data-selection-status]');
      if (status) status.textContent = applyHighlight() ? '已高亮' : '这段跨越多个结构，暂不能直接高亮';
    });

    menu.querySelector('[data-selection-chat]')?.addEventListener('click', async () => {
      if (!activeSelection || new URLSearchParams(location.search).has('exam_session')) return;
      if(activeSelection.task === 'Reading A') {
        const status=menu.querySelector('[data-selection-status]');
        try {
          if(!activeSelection.discussion)throw new Error('请选择文章中的文字。');
          const root=activeSelection.sourceRoot.closest('[data-local-port="reading"]');
          const meta=taskMetadata(root,'reading_a',activeSelection.objectId);
          updateEnglishReadingDiscussion(localStorage,meta,{span:{...activeSelection.discussion,
            source_locator:activeSelection.sourceLocator,source_context:activeSelection.nearby,
            focused_question_id:activeSelection.focusedQuestionId}});
          renderDiscussion();
          if(status)status.textContent='已保存 Chat 上下文';
        } catch(error) {
          if(status)status.textContent=String(error.message||'上下文保存失败');
        }
        return;
      }
      markEnglishAssistance(localStorage,activeSelection.task,activeSelection.objectId);
      const packet = [
        '请结合这段英语阅读上下文回答我接下来的问题。',
        `Task: ${activeSelection.task}${activeSelection.objectId ? ` · ${activeSelection.objectId}` : ''}`,
        `Selected: ${activeSelection.text}`,
        `Context: ${activeSelection.nearby}`
      ].join('\n\n');
      let ok = false;
      try { await navigator.clipboard.writeText(packet); ok = true; }
      catch {
        try { window.prompt('Copy context', packet); ok = true; } catch {}
      }
      const status = menu.querySelector('[data-selection-status]');
      if (status) status.textContent = ok ? '已复制 Chat 上下文' : '复制失败';
    });

    menu.querySelector('[data-selection-lexical]')?.addEventListener('click', () => {
      if (!activeSelection?.word || new URLSearchParams(location.search).has('exam_session')) return;
      if (activeSelection.task === 'Reading A') {
        recordEnglishReadingLookup(localStorage,activeSelection.objectId,{
          token: activeSelection.word,
          source_context: activeSelection.nearby,
          source_locator: activeSelection.sourceLocator,
          focused_question_id: activeSelection.focusedQuestionId
        });
      } else {
        markEnglishAssistance(localStorage,activeSelection.task,activeSelection.objectId);
      }
      const context = {
        schema: 'kianos.english.lexical_return.v1',
        returnHref: currentHref(),
        task: activeSelection.task,
        objectId: activeSelection.objectId,
        word: activeSelection.word,
        sourceScrollTop: activeSelection.sourceRoot.scrollTop,
        windowScrollY: window.scrollY,
        createdAt: new Date().toISOString(),
        returning: false
      };
      if (!writeContext(context)) return;
      location.href = `${base}vocabulary/?from=english&lookup=${encodeURIComponent(activeSelection.word)}`;
    });

    const isVocabularyRoute = () => {
      const relative = location.pathname.startsWith(base) ? location.pathname.slice(base.length) : location.pathname.replace(/^\//, '');
      return relative === 'vocabulary' || relative === 'vocabulary/' || relative.startsWith('vocabulary/');
    };

    const renderReturnBar = () => {
      const context = readContext();
      if (!context || context.schema !== 'kianos.english.lexical_return.v1' || !isVocabularyRoute()) {
        returnBar.hidden = true;
        return;
      }
      const created = Date.parse(context.createdAt || '') || 0;
      if (!created || Date.now() - created > 2 * 60 * 60 * 1000) {
        clearContext();
        returnBar.hidden = true;
        return;
      }
      const title = returnBar.querySelector('[data-english-return-title]');
      const meta = returnBar.querySelector('[data-english-return-meta]');
      const action = returnBar.querySelector('[data-english-return-action]');
      if (title) title.textContent = context.word || 'Vocabulary Lookup';
      if (meta) meta.textContent = `来自 ${context.task || 'English'} · 浏览本身不推进 Coverage；返回时恢复原位置`;
      if (action) action.textContent = `← 返回 ${context.task || 'English'}`;
      returnBar.hidden = false;
    };

    const applyIncomingLookup = () => {
      if (!isVocabularyRoute()) return;
      const params = new URLSearchParams(location.search);
      const lookup = compact(params.get('lookup') || '', 80);
      if (!lookup) return;
      const root = document.querySelector('[data-lexical-home]');
      if (!(root instanceof HTMLElement)) return;
      const tab = root.querySelector('[data-lexical-tab="research"]');
      const searchMode = root.querySelector('[data-lexical-research-mode="search"]');
      const input = root.querySelector('[data-lexical-search]');
      if (tab instanceof HTMLButtonElement) tab.click();
      if (searchMode instanceof HTMLButtonElement) searchMode.click();
      if (input instanceof HTMLInputElement) {
        input.value = lookup;
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.focus();
      }

      // English handoff should reach the exact canonical owner without making the
      // learner click through an intermediate result row when identity is exact.
      if (params.get('from') === 'english') {
        const exact = [...root.querySelectorAll('[data-lexical-search-results] .lexicalWordRow')]
          .find((row) => String(row.querySelector('strong')?.textContent || '').trim().toLowerCase() === lookup.toLowerCase());
        if (exact instanceof HTMLAnchorElement) location.href = exact.href;
      }
    };

    returnBar.querySelector('[data-english-return-action]')?.addEventListener('click', () => {
      const context = readContext();
      if (!context?.returnHref) return;
      context.returning = true;
      writeContext(context);
      location.href = context.returnHref;
    });
    returnBar.querySelector('[data-english-return-dismiss]')?.addEventListener('click', () => {
      clearContext();
      returnBar.hidden = true;
    });

    const restoreReturnPosition = () => {
      const context = readContext();
      if (!context?.returning || !context.returnHref) return;
      let target;
      try { target = new URL(context.returnHref, location.origin); }
      catch { return; }
      if (`${target.pathname}${target.search}` !== `${location.pathname}${location.search}`) return;
      const source = document.querySelector(sourceSelectors.join(','));
      requestAnimationFrame(() => requestAnimationFrame(() => {
        if (source instanceof HTMLElement) source.scrollTop = Number(context.sourceScrollTop || 0);
        window.scrollTo({ top: Number(context.windowScrollY || 0), behavior: 'instant' });
        clearContext();
      }));
    };

    renderDiscussion();
    const readingRoot=document.querySelector('[data-local-port="reading"]');
    if(readingRoot) {
      let pending=false;
      discussionObserver=new MutationObserver(records=>{
        const source=readingRoot.querySelector('[data-reading-passage]');
        if(pending || !records.some(record=>record.type==='attributes'||source?.contains(record.target)))return;
        pending=true;
        queueMicrotask(()=>{pending=false;renderDiscussion();});
      });
      observeDiscussion();
      globalThis.addEventListener('kianos:english-reading-evidence',()=>renderDiscussion());
      globalThis.addEventListener('storage',event=>{
        if(event.key==='kianos-reading-attempt-v1:'+readingRoot.getAttribute('data-reading-object'))renderDiscussion();
      });
    }
    renderReturnBar();
    requestAnimationFrame(applyIncomingLookup);
    restoreReturnPosition();
  }

  });
</script>

<style is:global>
  ::highlight(kianos-reading-discussion) { background-color: rgba(218,175,82,.38); text-decoration: underline; }
  mark[data-reading-discussion-mark] { background-color: rgba(218,175,82,.38); color: inherit; }
  .englishReadingDiscussion { padding: .4rem .8rem; font-size: .85rem; }
  .englishReadingDiscussion summary { cursor: pointer; font-weight: 600; }
  .englishReadingDiscussion div { display: flex; gap: .7rem; align-items: baseline; margin: .35rem 0; }
  .englishReadingDiscussion div span { flex: 1; }
</style>
