---
import {englishSessionCatalog} from "../lib/englishSessionCatalog.mjs";
const catalogPayload=JSON.stringify(englishSessionCatalog()).replace(/</g,"\\u003c");
---

<details class="englishSessionControl" data-english-session-control>
  <summary>
    <span>和 Chat 同步</span>
    <strong>今日学习安排</strong>
  </summary>
  <div class="englishSessionControlBody">
    <p>需要 Chat 帮你安排下一步时，先复制当前进度；Chat 给出安排后再导入。平时也可以直接自由进入任何任务。</p>
    <div class="englishSessionActions">
      <button type="button" data-english-copy-evidence>复制当前进度</button>
      <button type="button" data-english-toggle-import>导入学习安排</button>
      <button type="button" data-english-clear-session>清除安排</button>
    </div>
    <div class="englishSessionImport" data-english-session-import hidden>
      <textarea rows="8" data-english-session-input placeholder="粘贴 Chat 给你的学习安排"></textarea>
      <div>
        <button type="button" class="primary" data-english-apply-session>导入</button>
        <button type="button" data-english-cancel-session>取消</button>
      </div>
    </div>
    <small data-english-session-status></small>
  </div>
</details>

<script type="application/json" data-english-session-catalog set:html={catalogPayload}></script>

<script>
  import {
    ENGLISH_SESSION_SCHEMA,
    ENGLISH_SESSION_KEY,
    buildEnglishChatHandoffText,
    clearEnglishSessionInstruction,
    readEnglishSessionInstruction,
    writeEnglishSessionInstruction
  } from '../lib/englishSessionControl.mjs';

  const root = document.querySelector('[data-english-session-control]');
  if (root instanceof HTMLDetailsElement) {
    let catalog = JSON.parse(document.querySelector('[data-english-session-catalog]')?.textContent || '[]');
    let externalCatalogLoaded = false;
    const loadCatalog = async () => {
      if (externalCatalogLoaded) return catalog;
      externalCatalogLoaded = true;
      try {
        const response = await fetch('/__kianos-private/external-reading/catalog', { cache: 'no-store' });
        if (response.ok) {
          const data = await response.json();
          const rows = (data.collections || []).flatMap(group => group.passages || []).map(row => ({
            task: 'external_reading',
            object_id: row.object_id,
            source_hash: row.content_hash,
            label: row.title || row.object_id
          }));
          catalog = [...catalog, ...rows];
        }
      } catch {}
      return catalog;
    };
    const status = root.querySelector('[data-english-session-status]');
    const importBox = root.querySelector('[data-english-session-import]');
    const input = root.querySelector('[data-english-session-input]');
    const localDay = () => new Date().toLocaleDateString('en-CA');
    const taskLabels = { reading_a: 'Reading A', cloze: 'Cloze', reading_b: 'Part B', external_reading: 'External Reading', translation: 'Translation', writing: 'Writing', full_paper: 'Full Paper' };

    const setStatus = (text, bad = false) => {
      if (!(status instanceof HTMLElement)) return;
      status.textContent = text;
      status.classList.toggle('isBad', bad);
    };

    const renderStatus = () => {
      const state = readEnglishSessionInstruction(localStorage, localDay());
      if (state.status === 'ready' && state.instruction) {
        const step = state.instruction.steps[state.instruction.current_step];
        setStatus('已载入 · ' + (step.label || taskLabels[step.task] || '英语任务') + ' · ' + (state.instruction.current_step + 1) + '/' + state.instruction.steps.length);
      } else if (state.status === 'stale') {
        setStatus('昨天的学习安排已过期；今天不会自动沿用。', true);
      } else if (state.status === 'invalid') {
        setStatus('这份学习安排无法读取；网页不会自行猜测下一步。', true);
      } else if (state.status === 'unavailable') {
        setStatus('本机存储不可用。', true);
      } else {
        setStatus('当前没有额外安排；下面的任务都可以直接进入。');
      }
    };

    const copyText = async (value) => {
      try {
        await navigator.clipboard.writeText(value);
        return true;
      } catch {
        try {
          const area = document.createElement('textarea');
          area.value = value;
          area.style.position = 'fixed';
          area.style.opacity = '0';
          document.body.appendChild(area);
          area.select();
          const ok = document.execCommand('copy');
          area.remove();
          return ok;
        } catch {
          return false;
        }
      }
    };

    root.querySelector('[data-english-copy-evidence]')?.addEventListener('click', async () => {
      try {
        const text = buildEnglishChatHandoffText(localStorage, { day: localDay() });
        setStatus(await copyText(text)
          ? '当前英语进度已复制；把它发给 Chat 即可继续安排下一步。'
          : '复制失败，请稍后再试。', false);
      } catch (error) {
        setStatus(error instanceof Error ? error.message : String(error), true);
      }
    });

    root.querySelector('[data-english-toggle-import]')?.addEventListener('click', () => {
      if (importBox instanceof HTMLElement) importBox.hidden = false;
      if (input instanceof HTMLTextAreaElement) input.focus();
    });

    root.querySelector('[data-english-cancel-session]')?.addEventListener('click', () => {
      if (importBox instanceof HTMLElement) importBox.hidden = true;
    });

    root.querySelector('[data-english-apply-session]')?.addEventListener('click', async () => {
      try {
        const raw = input instanceof HTMLTextAreaElement ? input.value : '';
        await loadCatalog();
        const instruction = writeEnglishSessionInstruction(localStorage, raw, localDay(), {catalog});
        if (input instanceof HTMLTextAreaElement) input.value = '';
        if (importBox instanceof HTMLElement) importBox.hidden = true;
        setStatus('学习安排已导入。');
        window.dispatchEvent(new CustomEvent('kianos:english-session-updated', {
          detail: { schema: ENGLISH_SESSION_SCHEMA, session_id: instruction.session_id }
        }));
      } catch (error) {
        setStatus(error instanceof Error ? error.message : String(error), true);
      }
    });

    root.querySelector('[data-english-clear-session]')?.addEventListener('click', () => {
      clearEnglishSessionInstruction(localStorage);
      setStatus('学习安排已清除。');
      window.dispatchEvent(new CustomEvent('kianos:english-session-updated', {
        detail: { schema: ENGLISH_SESSION_SCHEMA, cleared: true }
      }));
    });

    window.addEventListener('storage', (event) => {
      if (event.key === ENGLISH_SESSION_KEY || event.key === null) renderStatus();
    });
    window.addEventListener('focus', renderStatus);
    renderStatus();
  }
</script>

<style>
  .englishSessionControl{padding:14px 16px;border:1px solid var(--study-line);border-radius:12px;background:#fff}
  .englishSessionControl summary{display:flex;align-items:baseline;justify-content:space-between;gap:12px;cursor:pointer;list-style:none}
  .englishSessionControl summary::-webkit-details-marker{display:none}
  .englishSessionControl summary span{font-size:9px;font-weight:850;letter-spacing:.08em;color:var(--study-green)}
  .englishSessionControl summary strong{font-size:12px}
  .englishSessionControlBody{display:grid;gap:10px;padding-top:12px}
  .englishSessionControlBody p{margin:0;color:var(--study-muted);font-size:10px;line-height:1.6}
  .englishSessionActions{display:flex;flex-wrap:wrap;gap:6px}
  .englishSessionActions button,.englishSessionImport button{padding:7px 9px;border:1px solid var(--study-line);border-radius:7px;background:#fff;color:inherit;font:inherit;font-size:10px;font-weight:750;cursor:pointer}
  .englishSessionImport{display:grid;gap:7px}
  .englishSessionImport textarea{width:100%;box-sizing:border-box;padding:9px;border:1px solid var(--study-line);border-radius:8px;background:#fff;font:inherit;font-size:10px;line-height:1.5}
  .englishSessionImport>div{display:flex;gap:6px}
  .englishSessionImport button.primary{border-color:var(--study-green);background:var(--study-green);color:#fff}
  .englishSessionControlBody>small{font-size:9px;line-height:1.5;color:var(--study-faint)}
  .englishSessionControlBody>small.isBad{color:#8a4a42}
</style>
