---
import ReadingWorkspace from './ReadingWorkspace.astro';

const {
  reading,
  mode = 'reading-a',
  backHref = import.meta.env.BASE_URL,
  label = 'Reading A'
} = Astro.props;
const external = mode === 'external';
---
<div
  data-shared-reading-workspace
  data-reading-mode={mode}
>
  <ReadingWorkspace
    reading={reading}
    surfaceLabel={label}
    backHref={backHref}
    backLabel={external ? '‹ External Reading' : '‹ Practice'}
    continuousSession={!external}
    reviewPacketLabel={`${label} review`}
  />
</div>
