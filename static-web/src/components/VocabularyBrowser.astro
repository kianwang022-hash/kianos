---
const { answer } = Astro.props;
const rows = answer.shardEntries || [];
const activeWord = answer.record?.word || 'answer';
const previewRows = rows.map((row) => ({
  objectId: row.objectId,
  ordinal: row.ordinal,
  word: row.record?.word || '',
  coreCn: row.record?.core_concept?.core_meaning_cn || '',
  coreEn: row.record?.core_concept?.core_meaning_en || '',
  senseCount: row.record?.senses?.length || 0
}));
---
<section class="portedVocabBrowser" data-vocab-browser data-active-word={activeWord}>
  <header>
    <div><span>Vocabulary · Current prototype</span><h3>Study / Search / Review</h3><p>Study 做 Depth Scan；Search 看完整 Current 词条；Review 只看真正加入 Repair 的分支。</p></div>
    <nav><button type="button" class="active" data-vocab-browser-tab="study">Study</button><button type="button" data-vocab-browser-tab="search">Search</button><button type="button" data-vocab-browser-tab="review">Review</button></nav>
  </header>

  <section data-vocab-browser-panel="study">
    <div class="portedVocabQueueSummary"><strong>{rows.length} word in current prototype</strong><span>当前仍是单词 prototype；状态读取 browser-local Repair targets</span></div>
    <div class="portedVocabQueueGrid" data-vocab-study></div>
  </section>

  <section data-vocab-browser-panel="search" hidden>
    <label class="portedVocabSearch"><span>Search</span><input type="search" data-vocab-search placeholder="Search current prototype" /></label>
    <div class="portedVocabDictionaryGrid">
      <aside data-vocab-search-list></aside>
      <article data-vocab-dictionary-preview><span>Current preview</span><h4>{activeWord}</h4><p>选择词条查看 Current Core；完整 Explore 后续再扩。</p></article>
    </div>
  </section>

  <section data-vocab-browser-panel="review" hidden>
    <div class="portedVocabLocalHistory"><span>Repair targets · local-only</span><ol data-vocab-review-list><li>还没有加入 Repair 的词汇分支。</li></ol></div>
  </section>

  <script type="application/json" data-vocab-shard-payload set:html={JSON.stringify(previewRows)}></script>
</section>

<script>
  const browser = document.querySelector('[data-vocab-browser]');
  if (browser) {
    let rows = [];
    try { rows = JSON.parse(browser.querySelector('[data-vocab-shard-payload]')?.textContent || '[]'); } catch {}
    const activeWord = browser.getAttribute('data-active-word') || '';
    const tabs = [...browser.querySelectorAll('[data-vocab-browser-tab]')];
    const panels = [...browser.querySelectorAll('[data-vocab-browser-panel]')];
    const stateFor = (row) => {
      try { return JSON.parse(localStorage.getItem(`kianos-vocabulary-astro-v2:${row.objectId}`) || 'null') || {}; } catch { return {}; }
    };
    const switchTab = (name) => {
      tabs.forEach((button) => button.classList.toggle('active', button.getAttribute('data-vocab-browser-tab') === name));
      panels.forEach((panel) => { panel.hidden = panel.getAttribute('data-vocab-browser-panel') !== name; });
      if (name === 'review') renderReview();
    };
    tabs.forEach((button) => button.addEventListener('click', () => switchTab(button.getAttribute('data-vocab-browser-tab') || 'study')));

    const study = browser.querySelector('[data-vocab-study]');
    const searchList = browser.querySelector('[data-vocab-search-list]');
    const preview = browser.querySelector('[data-vocab-dictionary-preview]');
    const showPreview = (row) => {
      if (!preview || !row) return;
      preview.replaceChildren();
      const kicker = document.createElement('span'); kicker.textContent = 'Current Core preview';
      const title = document.createElement('h4'); title.textContent = row.word;
      const cn = document.createElement('strong'); cn.textContent = row.coreCn || '—';
      const en = document.createElement('p'); en.textContent = row.coreEn || '—';
      const meta = document.createElement('small'); meta.textContent = `${row.senseCount} learner senses`;
      preview.append(kicker, title, cn, en, meta);
      if (row.word === activeWord) {
        const link = document.createElement('button'); link.type = 'button'; link.textContent = '打开当前 Depth Card';
        link.addEventListener('click', () => document.querySelector('[data-local-port="vocabulary"]')?.scrollIntoView({ behavior: 'smooth', block: 'start' }));
        preview.appendChild(link);
      }
    };
    const renderRows = (filter = '') => {
      const visible = rows.filter((row) => String(row.word || '').toLowerCase().includes(filter.toLowerCase()));
      [study, searchList].forEach((host) => { if (host) host.replaceChildren(); });
      visible.forEach((row) => {
        const state = stateFor(row);
        const repairCount = Object.keys(state.repairTargets || {}).length;
        const status = repairCount ? `${repairCount} REPAIR` : state.revealed ? 'SCANNED' : 'READY';
        const make = (mode) => {
          const button = document.createElement('button'); button.type = 'button';
          button.className = row.word === activeWord ? 'active' : '';
          button.innerHTML = `<b>${row.word}</b><span>${mode === 'study' ? (row.coreCn || row.coreEn || 'Current word') : (row.coreCn || '—')}</span><small>${status}</small>`;
          button.addEventListener('click', () => showPreview(row)); return button;
        };
        study?.appendChild(make('study'));
        searchList?.appendChild(make('search'));
      });
      if (visible.length) showPreview(visible.find((row) => row.word === activeWord) || visible[0]);
    };
    const renderReview = () => {
      const list = browser.querySelector('[data-vocab-review-list]'); if (!list) return;
      const repairRows = rows.map((row) => ({ row, state: stateFor(row) })).filter(({ state }) => Object.keys(state.repairTargets || {}).length > 0);
      list.replaceChildren();
      if (!repairRows.length) { const item = document.createElement('li'); item.textContent = '还没有加入 Repair 的词汇分支。'; list.appendChild(item); return; }
      repairRows.forEach(({ row, state }) => {
        const targets = Object.values(state.repairTargets || {});
        const item = document.createElement('li');
        item.textContent = `${row.word} · ${targets.length} Repair · ${targets.map((target) => target.label || target.target_id || target.target_locator || target.target_kind).join(' / ')}`;
        list.appendChild(item);
      });
    };
    browser.querySelector('[data-vocab-search]')?.addEventListener('input', (event) => renderRows(event.currentTarget.value || ''));
    renderRows();
    renderReview();
  }
</script>
