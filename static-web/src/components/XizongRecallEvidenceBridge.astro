---
const { block } = Astro.props;
const kps = block?.kpRecords || [];
---
<span
  hidden
  data-xizong-recall-evidence-bridge
  data-study-object={block?.objectId || ''}
  data-study-source-hash={block?.sourceHash || ''}
></span>
<script type="application/json" data-xizong-recall-evidence-kps set:html={JSON.stringify(kps.map((kp) => kp.kpId))}></script>

<script>
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(() => {

  const root = document.querySelector('[data-xizong-v6-block]');
  const bridge = document.querySelector('[data-xizong-recall-evidence-bridge]');
  const kpPayload = document.querySelector('[data-xizong-recall-evidence-kps]');

  if (root && !root.hasAttribute('data-xizong-state-blocked') && bridge && kpPayload) {
   (() => {
    const objectId = bridge.getAttribute('data-study-object') || root.getAttribute('data-study-object') || 'xizong:unknown';
    const stateKey = `kianos-xizong-astro-v2:${objectId}`;
    const evidenceKey = `kianos-xizong-memory-review-v2:${objectId}`;
    try {
      const raw = localStorage.getItem(evidenceKey);
      if (raw !== null) {
        const value = JSON.parse(raw);
        if (!value || typeof value !== 'object' || Array.isArray(value) || (value.evidenceHistory != null && !Array.isArray(value.evidenceHistory))) throw new Error('Invalid evidence');
      }
    } catch {
      root.dataset.xizongStateBlocked = 'true'; root.inert = true;
      const notice = document.createElement('p'); notice.setAttribute('role','alert');
      notice.textContent = 'Recall 历史无法安全读取，已保留原数据并暂停写入；请先备份再恢复。'; root.before(notice);
      return;
    }
    let kpIds = [];
    try { kpIds = JSON.parse(kpPayload.textContent || '[]'); } catch {}
    const kpSet = new Set(Array.isArray(kpIds) ? kpIds : []);

    const readJson = (key, fallback = {}) => {
      try { return JSON.parse(localStorage.getItem(key) || 'null') || fallback; } catch { return fallback; }
    };
    const readEvidence = () => ({
      memory: {}, memoryIndex: 0, reviewPlan: [], reviewIndex: 0, reviewRatings: {},
      evidenceHistory: [], lastRecallRatings: {},
      ...readJson(evidenceKey, {})
    });
    const pauseForEvidence = () => {
      root.dataset.xizongStateBlocked = 'true'; root.inert = true;
      if (!document.querySelector('[data-xizong-evidence-save-error]')) {
        const notice = document.createElement('p'); notice.dataset.xizongEvidenceSaveError = '';
        notice.setAttribute('role', 'alert');
        notice.textContent = '本次 Recall 未能保存，未推进学习状态；之前记录仍保留。请先备份或释放本机空间，再重新打开。';
        root.before(notice);
      }
    };
    const saveEvidence = (value) => {
      try { localStorage.setItem(evidenceKey, JSON.stringify(value)); return true; }
      catch { pauseForEvidence(); return false; }
    };
    const appendRecall = (kpId, rating, evidenceOrigin) => {
      if (!kpSet.has(kpId) || !rating) return false;
      const ext = readEvidence();
      ext.evidenceHistory = [
        ...(Array.isArray(ext.evidenceHistory) ? ext.evidenceHistory : []),
        { at: new Date().toISOString(), type: 'KP_RECALL', kp_id: kpId, rating, evidence_origin: evidenceOrigin, core_revealed: true, source_hash: bridge.getAttribute('data-study-source-hash') || '', context_asset_ids: [...root.querySelectorAll('[data-xizong-aux-surface]:not([hidden]) [data-learner-asset-id]')].map((row) => row.getAttribute('data-learner-asset-id')).filter(Boolean) }
      ];
      ext.lastRecallRatings = { ...(ext.lastRecallRatings || {}), [kpId]: rating };
      return saveEvidence(ext);
    };

    // Preserve accepted evidence when an existing Block state predates this bridge.
    const study = readJson(stateKey, {});
    const existing = readEvidence();
    const bootstrapped = { ...(existing.lastRecallRatings || {}) };
    Object.entries(study.ratings || {}).forEach(([kpId, rating]) => {
      if (!kpSet.has(kpId) || bootstrapped[kpId]) return;
      existing.evidenceHistory = [
        ...(Array.isArray(existing.evidenceHistory) ? existing.evidenceHistory : []),
        { at: new Date().toISOString(), type: 'KP_RECALL', kp_id: kpId, rating, evidence_origin: 'BOOTSTRAP_EXISTING_STATE' }
      ];
      bootstrapped[kpId] = rating;
    });
    existing.lastRecallRatings = bootstrapped;
    if (!saveEvidence(existing)) return;

    // Persist the observation during capture, before BlockV6 can advance. A failed
    // write leaves both the previous evidence and learner position intact.
    root.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const ratingButton = target?.closest('[data-rating]');
      if (!ratingButton) return;
      const card = ratingButton.closest('[data-kp-id]');
      const kpId = card?.getAttribute('data-kp-id') || '';
      const rating = ratingButton.getAttribute('data-rating') || '';
      const currentStudy = readJson(stateKey, {});
      if (root.inert || root.dataset.xizongStateBlocked === 'true' || currentStudy?.stage !== 'kp_recall' || card?.hidden || card?.dataset.ratingCommitted === 'true') return;
      if (!kpId || !['unknown', 'fuzzy', 'known', 'mastered'].includes(rating) || currentStudy?.learned?.[kpId] !== true || card?.querySelector('[data-kp-answer]')?.hidden !== false) return;
      if (!appendRecall(kpId, rating, 'USER_RECALL_ATTEMPT')) {
        event.preventDefault(); event.stopImmediatePropagation();
      }
    }, true);
   })();
  }

  });
</script>
