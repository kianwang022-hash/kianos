---
const { block } = Astro.props;
const kps = block?.kpRecords || [];
---
<details class="xv6PersonalDock" data-xizong-study-dock data-study-object={block.objectId}>
  <summary>随手记与讲义定位 · C</summary>
  <div class="xv6DockBody">
  <header>
    <div><span>当前学习</span><strong data-dock-position>{kps[0]?.displayId || 'KP'}</strong></div>
    <small data-dock-group>{kps[0]?.groupLabel || '学习节'}</small>
  </header>

  <div class="xv6DockLocator">
    <span>iPad / MarginNote · 原讲义定位</span>
    <code data-source-locator>{kps[0]?.sourceLocator || 'Current 暂无精确定位'}</code>
  </div>


  <label class="xv6DockComment">
    <span>随手记 · C</span>
    <textarea rows="2" data-kp-comment placeholder="只有真有东西想留时再写，只存在本浏览器"></textarea>
  </label>

  <script type="application/json" data-dock-payload set:html={JSON.stringify(kps.map((kp) => ({
    kpId: kp.kpId,
    displayId: kp.displayId,
    title: kp.title,
    groupId: kp.groupId,
    groupLabel: kp.groupLabel,
    sourceLocator: kp.sourceLocator || ''
  })))}></script>
  </div>
</details>

<script>
  const dock = document.querySelector('[data-xizong-study-dock]');
  const root = document.querySelector('[data-xizong-v6-block]');
  if (dock && root) {
    const objectId = dock.getAttribute('data-study-object') || root.getAttribute('data-study-object') || 'xizong:unknown';
    const personalKey = `kianos-xizong-personal-v1:${objectId}`;
    const studyKey = `kianos-xizong-astro-v2:${objectId}`;
    let kpRows = [];
    try { kpRows = JSON.parse(dock.querySelector('[data-dock-payload]')?.textContent || '[]'); } catch {}
    let personal = { kp: {} };
    try { personal = { ...personal, ...(JSON.parse(localStorage.getItem(personalKey) || 'null') || {}) }; } catch {}

    const outline = root.querySelector('.portedStudyOutline');
    if (outline && dock.parentElement !== outline) outline.append(dock);

    const recallCards = [...root.querySelectorAll('[data-kp-recall-card]')];
    const locator = dock.querySelector('[data-source-locator]');
    const position = dock.querySelector('[data-dock-position]');
    const group = dock.querySelector('[data-dock-group]');
    const comment = dock.querySelector('[data-kp-comment]');
    let renderedKpId = '';

    const readStudy = () => { try { return JSON.parse(localStorage.getItem(studyKey) || 'null') || {}; } catch { return {}; } };
    const savePersonal = () => { try { localStorage.setItem(personalKey, JSON.stringify(personal)); } catch {} };
    const currentStage = () => [...root.querySelectorAll('[data-study-stage]')].find((node) => !node.hidden)?.getAttribute('data-study-stage') || '';
    const currentIndex = () => {
      const recall = recallCards.findIndex((card) => !card.hidden);
      if (recall >= 0 && currentStage() === 'kp_recall') return recall;
      return Math.max(0, Math.min(kpRows.length - 1, Number(readStudy().kpIndex || 0)));
    };
    const currentRow = () => kpRows[currentIndex()] || kpRows[0] || null;
    const currentLocal = () => {
      const row = currentRow();
      if (!row) return null;
      personal.kp ||= {};
      personal.kp[row.kpId] ||= { questionStatus: '', comment: '' };
      return personal.kp[row.kpId];
    };
    const currentScrollSurface = () => {
      if (currentStage() !== 'kp_recall') return null;
      return recallCards[currentIndex()]?.querySelector('.portedRecallAnswer:not([hidden])') || recallCards[currentIndex()] || null;
    };

    const applyCompletionGate = () => {
      const button = root.querySelector('[data-block-complete]');
      if (!button) return;
      const study = readStudy();
      const learned = Object.values(study.learned || {}).filter(Boolean).length;
      const recalled = Object.keys(study.ratings || {}).length;
      const coreReady = kpRows.length > 0 && learned >= kpRows.length && recalled >= kpRows.length && Boolean(study.blockRecallDone);
      button.disabled = !coreReady || Boolean(study.completed);
      button.title = '';
    };

    const syncReviewVisibility = () => {
      const extension = document.querySelector('[data-study-extension]');
      if (!extension) return;
      extension.hidden = currentStage() !== 'block_complete' && extension.dataset.explicitOpen !== 'true';
    };

    const renderDock = () => {
      const row = currentRow();
      const local = currentLocal();
      if (row) {
        if (position) position.textContent = `${row.displayId} · ${row.title}`;
        if (group) group.textContent = row.groupLabel || '学习节';
        if (locator) locator.textContent = row.sourceLocator || 'Current 暂无精确定位';
        if (comment && document.activeElement !== comment && renderedKpId !== row.kpId) comment.value = local?.comment || '';
        renderedKpId = row.kpId;
      }
      applyCompletionGate();
      syncReviewVisibility();
    };

    comment?.addEventListener('input', () => {
      const local = currentLocal();
      if (!local) return;
      local.comment = String(comment.value || '').slice(0, 1200);
      savePersonal();
    });

    let queued = false;
    new MutationObserver(() => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; renderDock(); });
    }).observe(root, { subtree: true, attributes: true, attributeFilter: ['hidden', 'disabled', 'class'] });

    document.addEventListener('keydown', (event) => {
      if (event.defaultPrevented || event.isComposing || event.keyCode === 229
        || event.ctrlKey || event.metaKey || event.altKey || event.shiftKey) return;
      const target = event.target;
      const editing = target instanceof HTMLElement && target.closest('input,textarea,select,[contenteditable="true"]');
      if (editing) {
        if (event.key === 'Escape') { event.preventDefault(); target.blur(); }
        return;
      }
      if (target instanceof HTMLElement && target.closest('button,a,summary,[role="button"]')) return;
      const stage = currentStage();
      if (['ArrowUp', 'ArrowDown'].includes(event.key) && stage === 'kp_recall') {
        const surface = currentScrollSurface();
        if (surface) {
          event.preventDefault();
          surface.scrollBy({ top: (event.key === 'ArrowDown' ? 1 : -1) * Math.max(220, surface.clientHeight * .72), behavior: 'smooth' });
        }
        return;
      }
      if (event.key === 'Enter') {
        if (stage === 'block_learn') root.querySelector('[data-stage-next="logic_group"]')?.click();
        else if (stage === 'logic_group') root.querySelector('[data-enter-group]')?.click();
        else if (stage === 'kp_learn') root.querySelector('[data-group-lecture-done]')?.click();
        else if (stage === 'group_close') root.querySelector('[data-group-close-next]')?.click();
        else if (stage === 'kp_recall') recallCards[currentIndex()]?.querySelector('[data-kp-reveal]:not([hidden])')?.click();
        return;
      }
      const key = event.key.toLowerCase();
      if (key === 'c' && dock.getClientRects().length) { event.preventDefault(); dock.open = true; comment?.focus(); comment?.select(); return; }
    });

    renderDock();
  }
</script>

<style>
  .xv6PersonalDock{display:grid;gap:8px;padding:10px 11px;border-bottom:1px solid var(--study-line);background:#fff}.xv6PersonalDock>header{display:grid!important;grid-template-columns:minmax(0,1fr) auto;gap:2px 8px;padding:0 0 6px!important;border:0!important}.xv6PersonalDock>header div{min-width:0}.xv6PersonalDock>header span,.xv6DockLocator>span,.xv6DockComment>span{display:block;color:var(--study-green);font-size:8px;font-weight:850;letter-spacing:.06em}.xv6PersonalDock>header strong{display:block;overflow:hidden;margin-top:2px;font-size:10px;text-overflow:ellipsis;white-space:nowrap}.xv6PersonalDock>header small{align-self:end;color:var(--study-muted);font-size:8px}.xv6DockLocator{display:grid;gap:3px;padding:7px;border-radius:8px;background:var(--study-surface-muted)}.xv6DockLocator code{overflow:hidden;color:var(--study-muted);font-size:8px;line-height:1.45;white-space:normal}.xv6DockComment{display:grid;gap:4px}.xv6DockComment textarea{width:100%;resize:vertical;min-height:42px;padding:7px;border:1px solid var(--study-line);border-radius:8px;background:#fff;font:inherit;font-size:9px;line-height:1.45}
  @media(min-width:1100px){.xv6Block .portedStudyLayout{grid-template-columns:220px minmax(0,1fr) 250px}.xv6Block .portedStudyLayout.outline-collapsed{grid-template-columns:0 minmax(0,1fr) 250px}.xv6Block .portedStudyLayout.chain-collapsed{grid-template-columns:220px minmax(0,1fr) 0}.xv6Block .portedKpWorkspace{min-height:0}.xv6Block .portedKpCards{height:calc(100vh - 225px);min-height:520px;max-height:760px;padding:8px 10px}.xv6Block .portedKpRecallCard{display:flex;height:100%;max-width:none;flex-direction:column}.xv6Block .portedKpRecallCard>header{padding:11px 15px 9px}.xv6Block .portedKpRecallCard>footer{margin-top:auto}.xv6Block .portedRecallAnswer{overflow:auto}.xv6Block .portedStudyChain{min-width:0}}
</style>
<style is:global>
/* Optional notes belong to local context, never above the cognitive stage. */
:root body.surfaceBody-xizong #main-content .xv6PersonalDock {display:block;padding:16px 4px;border:0;border-top:1px solid var(--study-line);background:transparent;}
:root body.surfaceBody-xizong #main-content .xv6PersonalDock>summary {font-size:16px;font-weight:700;line-height:1.65;cursor:pointer;}
:root body.surfaceBody-xizong #main-content .xv6DockBody {display:grid;gap:12px;padding-top:14px;}
:root body.surfaceBody-xizong #main-content .xv6PersonalDock header {display:grid;gap:5px;padding:0;border:0;}
:root body.surfaceBody-xizong #main-content .xv6PersonalDock :is(header span,header small,.xv6DockLocator>span,.xv6DockComment>span) {font-size:14px;line-height:1.7;}
:root body.surfaceBody-xizong #main-content .xv6PersonalDock header strong {font-size:17px;line-height:1.65;white-space:normal;}
:root body.surfaceBody-xizong #main-content .xv6DockLocator code {font-size:14px;line-height:1.7;overflow-wrap:anywhere;}
:root body.surfaceBody-xizong #main-content .xv6DockComment textarea {font-size:17px;line-height:1.7;min-height:110px;}

</style>
