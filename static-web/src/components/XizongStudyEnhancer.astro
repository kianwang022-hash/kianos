---
const { block } = Astro.props;
const kps = block?.kpRecords || [];
const reserveItems = (block?.pathways?.outgoing || [])
  .filter((row) => row?.reserveLearning === true)
  .map((row) => ({
    id: row.id,
    cue: row?.source?.cue || '',
    sourceGroupId: row?.source?.logic_group_id || '',
    targetBlockId: row?.target?.block_id || '',
    targetGroupId: row?.target?.logic_group_id || '',
    returnCue: row?.target?.cue || ''
  }));
const packetMeta = {
  systemId: block?.systemId || '',
  canonicalId: block?.systemCanonicalId || '',
  blockId: block?.blockId || '',
  blockLabel: block?.label || '',
  blockTitle: block?.title || '',
  sourcePath: block?.sourcePath || '',
  sourceHash: block?.sourceHash || '',
  sourceContactMode: String(block?.sourceContact?.mode || ''),
  sourcePerGroup: block?.sourceContact?.logicGroupIsAutomaticSourceChunk === true,
  reserveItems
};
---
<section class="xv6PersonalDock" data-xizong-study-dock data-study-object={block.objectId}>
  <header>
    <div><span>当前学习</span><strong data-dock-position>{kps[0]?.displayId || 'KP'}</strong></div>
    <small data-dock-group>{kps[0]?.groupLabel || '学习节'}</small>
  </header>

  <div class="xv6DockLocator">
    <span>iPad / MarginNote · 原讲义定位</span>
    <code data-source-locator>{kps[0]?.sourceLocator || '暂无精确定位'}</code>
  </div>


  <label class="xv6DockComment">
    <span>随手记 · C</span>
    <textarea rows="2" data-kp-comment placeholder="只有真有东西想留时再写，只存在本浏览器"></textarea>
  </label>

  <div class="xv6DockPacket">
    <button type="button" data-copy-study-packet>复制学习包给 Chat</button>
    <button type="button" data-import-chat-return>导入 Chat Return</button>
    <small data-study-packet-status>带当前真实断点与学习证据</small>
  </div>

  <script type="application/json" data-dock-payload set:html={JSON.stringify(kps.map((kp) => ({
    kpId: kp.kpId,
    displayId: kp.displayId,
    title: kp.title,
    groupId: kp.groupId,
    groupLabel: kp.groupLabel,
    sourceLocator: kp.sourceLocator || '',
    prompt: kp.prompt || ''
  })))}></script>
  <script type="application/json" data-study-packet-meta set:html={JSON.stringify(packetMeta)}></script>
</section>

<script>
  import {
    XIZONG_RETAINED_SET_KEY,
    XIZONG_QUESTION_PREFERENCES_KEY,
    collectXizongRetainedEvidence,
    xizongQuestionMarkOverrides
  } from '../lib/xizongRetainedPractice.mjs';
  import {
    XIZONG_MEMORY_STORAGE_KEY,
    normalizeXizongMemoryState,
    memorySummary,
    todayMemoryQueue,
    markedFragments,
    activeRepairTasks
  } from '../lib/xizongMemoryModel.mjs';
  import {
    applyXizongChatReturn,
    buildXizongChatExport,
    buildXizongChatHandoff,
    writeXizongChatHandoff
  } from '../lib/xizongChatReturn.mjs';

  const dock = document.querySelector('[data-xizong-study-dock]');
  const root = document.querySelector('[data-xizong-v6-block]');
  if (dock && root) {
    const objectId = dock.getAttribute('data-study-object') || root.getAttribute('data-study-object') || 'xizong:unknown';
    const personalKey = `kianos-xizong-personal-v1:${objectId}`;
    const studyKey = `kianos-xizong-astro-v2:${objectId}`;
    const extensionKey = `kianos-xizong-memory-review-v2:${objectId}`;
    const repairInboxKey = `kianos-xizong-repair-inbox-v1:${objectId}`;
    const holdoutKey = 'kianos:xizong:full-paper-holdout-years:v1';
    let kpRows = [];
    let packetMeta = {};
    try { kpRows = JSON.parse(dock.querySelector('[data-dock-payload]')?.textContent || '[]'); } catch {}
    try { packetMeta = JSON.parse(dock.querySelector('[data-study-packet-meta]')?.textContent || '{}'); } catch {}
    let personal = { kp: {} };
    try { personal = { ...personal, ...(JSON.parse(localStorage.getItem(personalKey) || 'null') || {}) }; } catch {}
    const readJson = (key, fallback = null) => {
      try { return JSON.parse(localStorage.getItem(key) || 'null') ?? fallback; } catch { return fallback; }
    };

    const chain = root.querySelector('.portedStudyChain');
    const chainList = chain?.querySelector('ol');
    if (chain && dock.parentElement !== chain) chain.insertBefore(dock, chainList || chain.firstChild);

    const recallCards = [...root.querySelectorAll('[data-kp-recall-card]')];
    const locator = dock.querySelector('[data-source-locator]');
    const position = dock.querySelector('[data-dock-position]');
    const group = dock.querySelector('[data-dock-group]');
    const comment = dock.querySelector('[data-kp-comment]');
    let renderedKpId = '';

    const readStudy = () => { try { return JSON.parse(localStorage.getItem(studyKey) || 'null') || {}; } catch { return {}; } };
    const savePersonal = () => { try { localStorage.setItem(personalKey, JSON.stringify(personal)); } catch {} };
    const currentStage = () => [...root.querySelectorAll('[data-study-stage]')].find((node) => !node.hidden)?.getAttribute('data-study-stage') || '';
    const currentIndex = () => {
      const recall = recallCards.findIndex((card) => !card.hidden);
      if (recall >= 0 && currentStage() === 'kp_recall') return recall;
      return Math.max(0, Math.min(kpRows.length - 1, Number(readStudy().kpIndex || 0)));
    };
    const currentRow = () => kpRows[currentIndex()] || kpRows[0] || null;
    const currentLocal = () => {
      const row = currentRow();
      if (!row) return null;
      personal.kp ||= {};
      personal.kp[row.kpId] ||= { questionStatus: '', comment: '' };
      return personal.kp[row.kpId];
    };
    const currentScrollSurface = () => {
      if (currentStage() !== 'kp_recall') return null;
      return recallCards[currentIndex()]?.querySelector('.portedRecallAnswer:not([hidden])') || recallCards[currentIndex()] || null;
    };
    const packetButton = dock.querySelector('[data-copy-study-packet]');
    const returnButton = dock.querySelector('[data-import-chat-return]');
    const packetStatus = dock.querySelector('[data-study-packet-status]');

    const buildStudyPacket = () => {
      const study = readStudy();
      const currentPersonal = readJson(personalKey, {}) || {};
      const memory = normalizeXizongMemoryState(readJson(XIZONG_MEMORY_STORAGE_KEY, null));
      const ext = readJson(extensionKey, {}) || {};
      const history = Array.isArray(ext?.evidenceHistory) ? ext.evidenceHistory : [];
      const activeKp = currentRow();
      const activeGroupId = String(activeKp?.groupId || '');
      const activeGroupKps = activeGroupId ? kpRows.filter((kp) => String(kp.groupId || '') === activeGroupId) : [];
      const unstableCount = (kpId) => history.filter((row) => row?.kp_id === kpId && (
        (row?.type === 'KP_RECALL' && ['unknown','fuzzy'].includes(String(row?.rating || ''))) ||
        (row?.type === 'MEMORY' && ['HOT','WARM'].includes(String(row?.state || '')))
      )).length;
      const kpEvidence = kpRows.map((kp) => ({
        kp_id: kp.kpId,
        display_id: kp.displayId,
        title: kp.title,
        logic_group_id: kp.groupId || '',
        logic_group_label: kp.groupLabel || '',
        source_locator: kp.sourceLocator || '',
        prompt: kp.prompt || '',
        prompt_override: String(memory.promptOverrides?.[kp.kpId] || ''),
        marks: Array.isArray(currentPersonal?.kp?.[kp.kpId]?.marks) ? currentPersonal.kp[kp.kpId].marks : [],
        learned: Boolean(study?.learned?.[kp.kpId]),
        recall_rating: String(study?.ratings?.[kp.kpId] || ''),
        repeated_unstable_count: unstableCount(kp.kpId),
        note: String(currentPersonal?.kp?.[kp.kpId]?.comment || '')
      }));

      const blockCardIds = new Set(Object.values(memory.cards || {})
        .filter((card) => String(card?.blockId || '') === String(packetMeta.blockId || ''))
        .map((card) => String(card.id || '')));
      const belongsToBlock = (task) => String(task?.blockId || '') === String(packetMeta.blockId || '')
        || kpRows.some((kp) => kp.kpId === String(task?.kpId || ''));
      const blockMemoryEvidence = (memory.evidence || []).filter((row) => blockCardIds.has(String(row?.cardId || ''))).slice(-120);
      const blockToday = todayMemoryQueue(memory)
        .filter((card) => String(card?.blockId || '') === String(packetMeta.blockId || ''))
        .map((card) => ({ id: card.id, family: card.family, kp_id: card.kpId, weak_weight: card.weakWeight, review_requested: card.reviewRequested }));
      const blockMarks = markedFragments(memory)
        .filter((mark) => blockCardIds.has(String(mark?.cardId || '')))
        .map((mark) => ({ id: mark.id, kp_id: mark.kpId, surface: mark.surface, text: mark.text, created_at: mark.createdAt }));
      const blockRepairs = activeRepairTasks(memory)
        .filter(belongsToBlock)
        .map((task) => ({
          id: task.id,
          kp_id: task.kpId,
          reason: task.reason,
          action: task.action,
          priority: task.priority,
          origin: task.origin,
          source_question_ids: task.sourceQuestionIds || [],
          block_href: task.blockHref || '',
          return_href: task.returnHref || ''
        }));

      const holdoutYears = readJson(holdoutKey, []) || [];
      const preferences = readJson(XIZONG_QUESTION_PREFERENCES_KEY, {}) || {};
      const storageEntries = Object.keys(localStorage)
        .filter((key) => /^kianos:xizong:(?:system|chat-set|retained|paper)-question-sweep:.*:v1$/.test(key))
        .map((key) => [key, localStorage.getItem(key)]);
      const retained = collectXizongRetainedEvidence(storageEntries, {
        holdoutYears,
        markOverrides: xizongQuestionMarkOverrides(preferences)
      });
      const latestAttempt = retained.latestAttemptByQuestion || {};
      const attemptSummary = (questionId) => {
        const row = latestAttempt[questionId] || {};
        return {
          question_id: questionId,
          status: String(row.status || ''),
          submitted_at: String(row.submitted_at || row.updatedAt || ''),
          study_phase: String(row.study_phase || ''),
          result_visibility: String(row.result_visibility || '')
        };
      };
      const systemRecall = packetMeta.systemId
        ? readJson(`kianos:xizong:system-recall:${packetMeta.systemId}:v1`, null)
        : null;

      return {
        schema: 'kianos.xizong.study_packet.v3',
        exported_at: new Date().toISOString(),
        current: {
          object_id: objectId,
          system_id: packetMeta.systemId || '',
          canonical_id: packetMeta.canonicalId || '',
          block_id: packetMeta.blockId || '',
          block_label: packetMeta.blockLabel || '',
          block_title: packetMeta.blockTitle || '',
          source_path: packetMeta.sourcePath || '',
          source_hash: packetMeta.sourceHash || ''
        },
        learning_state: {
          current_stage: currentStage() || study.stage || '',
          source_contact: {
            confirmed_segments: Array.isArray(study.sourceContactEvidence) ? study.sourceContactEvidence : [],
            mode: packetMeta.sourceContactMode || '',
            per_logic_group: Boolean(packetMeta.sourcePerGroup),
            whole_block_confirmed: Boolean(study.sourceContactDone),
            active_group_contacted: activeGroupKps.length > 0 && activeGroupKps.every((kp) => Boolean(study?.learned?.[kp.kpId]))
          },
          resume: {
            group_index: Math.max(0, Number(study.groupIndex || 0)),
            logic_group_id: activeGroupId,
            logic_group_label: activeKp?.groupLabel || '',
            kp_index: currentIndex(),
            kp_id: activeKp?.kpId || '',
            kp_display_id: activeKp?.displayId || '',
            source_locator: activeKp?.sourceLocator || ''
          },
          ttsx: {
            pending: study.pendingTtsx || null,
            evidence: study.ttsxEvidence || {},
            annotations: study.ttsxAnnotations || {}
          },
          learned_kp_ids: Object.entries(study.learned || {}).filter(([,done]) => Boolean(done)).map(([id]) => id),
          recall_ratings: study.ratings || {},
          block_recall_done: Boolean(study.blockRecallDone),
          block_complete: Boolean(study.completed),
          system_recall: systemRecall
        },
        summary: {
          total_kp: kpRows.length,
          learned_kp: Object.values(study.learned || {}).filter(Boolean).length,
          recalled_kp: Object.keys(study.ratings || {}).length,
          active_logic_group_id: activeGroupId,
          active_kp_id: activeKp?.kpId || '',
          repeated_unstable_kp_ids: kpEvidence.filter((row) => row.repeated_unstable_count > 1).map((row) => row.kp_id),
          notes_count: kpEvidence.filter((row) => Boolean(row.note)).length,
          xizong_memory: memorySummary(memory),
          unresolved_wu_questions: retained.wrongUncertainIds.length,
          marked_questions: retained.markedIds.length
        },
        kp_evidence: kpEvidence,
        block_evidence_history: history,
        memory: {
          today: blockToday,
          marked_fragments: blockMarks,
          active_repairs: blockRepairs,
          evidence: blockMemoryEvidence
        },
        practice: {
          holdout_years: holdoutYears,
          wrong_uncertain: retained.wrongUncertainIds.map(attemptSummary),
          marked_question_ids: retained.markedIds
        },
        pending_repair_inbox: readJson(repairInboxKey, null),
        reserve_learning: packetMeta.reserveItems || [],
        evidence_semantics: {
          source_contact: 'original Lecture / MarginNote contact evidence; repository readiness never counts as learner contact',
          ttsx: 'reviewed Lecture-attached checkpoint evidence; absence does not create a checkpoint',
          kp_recall: 'primary active-recall evidence; repeated real attempts remain append-preserved',
          memory: 'later recovery evidence; repair may clear a local weak queue but does not rewrite original Recall',
          repair: 'bounded repair task; completion does not automatically mean mastery',
          question_attempt: 'formal question evidence; latest unresolved Wrong/Uncertain drives the default retained queue'
        },
        request_to_chat: [
          '请先按 current + learning_state.resume 说明我现在学到哪里，再看 evidence；不要把仓库完成度当成我的学习进度。',
          '区分原讲义接触、KP Recall、TTSX、Memory、Repair、Question Attempt，它们不是同一种掌握证据。',
          '只指出最有价值的少数断点；稳定内容不要制造额外复习债务。',
          '如果问题属于 canonical Content / Prompt / 页面时机，请明确指出这是产品或内容问题，不要伪装成 learner weakness。',
          '需要看具体题或 KP 时，用 packet 中的稳定 ID 回 main@HEAD 读取当前 owner；不要凭 packet 文本补猜。'
        ]
      };
    };

    // One subject-owned packet builder serves both copy and the visible download control.
    root.addEventListener('kianos:xizong-request-study-packet', (event) => {
      if (root.inert || root.dataset.xizongStateBlocked === 'true') return;
      if (typeof event.detail?.accept === 'function') event.detail.accept(buildStudyPacket());
    });

    packetButton?.addEventListener('click', async () => {
      try {
        const packet = buildStudyPacket();
        const handoff = writeXizongChatHandoff(localStorage, buildXizongChatHandoff(packet, {
          returnHref: window.location.pathname + window.location.search + window.location.hash
        }));
        const exportPacket = buildXizongChatExport(packet, handoff);
        const text = JSON.stringify(exportPacket, null, 2);
        try {
          await navigator.clipboard.writeText(text);
          if (packetStatus) packetStatus.textContent = '已复制；Chat Return 会绑定这次学习现场';
        } catch {
          window.prompt('复制西综学习包给 Chat', text);
        }
      } catch (error) {
        if (packetStatus) packetStatus.textContent = '学习包身份未能安全绑定，未导出 Return 合同。';
      }
    });

    returnButton?.addEventListener('click', () => {
      const text = window.prompt('粘贴 Chat 返回的 kianos.xizong.chat_return.v1 JSON');
      if (!text) return;
      try {
        const result = applyXizongChatReturn(localStorage, text, { currentPacket: buildStudyPacket() });
        if (result.status === 'already_applied') {
          if (packetStatus) packetStatus.textContent = '这份 Return 已经导入过；没有重复创建 Repair。';
          return;
        }
        const repairCount = result.return_packet?.repairs?.length || 0;
        if (packetStatus) packetStatus.textContent = repairCount
          ? `已安全导入 ${repairCount} 个最小 Repair；回到原中断位置。`
          : 'Chat 判定无需 Repair；保持原中断位置继续。';
        if (repairCount && result.return_href) window.location.assign(result.return_href);
      } catch (error) {
        const message = String(error?.message || error);
        if (packetStatus) packetStatus.textContent = message.includes('STALE_EVIDENCE')
          ? '导出后学习证据已经变化；未写入，请重新复制当前学习包。'
          : 'Chat Return 未通过对象/版本校验；没有改动学习状态。';
      }
    });

    const applyCompletionGate = () => {
      const button = root.querySelector('[data-block-complete]');
      if (!button) return;
      const study = readStudy();
      const learned = Object.values(study.learned || {}).filter(Boolean).length;
      const recalled = Object.keys(study.ratings || {}).length;
      const coreReady = kpRows.length > 0 && learned >= kpRows.length && recalled >= kpRows.length && Boolean(study.blockRecallDone);
      button.disabled = !coreReady || Boolean(study.completed);
      button.title = '';
    };

    const syncReviewVisibility = () => {
      const extension = document.querySelector('[data-study-extension]');
      if (!extension) return;
      extension.hidden = !['kp_recall', 'block_recall'].includes(currentStage());
    };

    const renderDock = () => {
      const row = currentRow();
      const local = currentLocal();
      if (row) {
        if (position) position.textContent = `${row.displayId} · ${row.title}`;
        if (group) group.textContent = row.groupLabel || '学习节';
        if (locator) locator.textContent = row.sourceLocator || '暂无精确定位';
        if (comment && document.activeElement !== comment && renderedKpId !== row.kpId) comment.value = local?.comment || '';
        renderedKpId = row.kpId;
      }
      applyCompletionGate();
      syncReviewVisibility();
    };

    comment?.addEventListener('input', () => {
      const local = currentLocal();
      if (!local) return;
      local.comment = String(comment.value || '').slice(0, 1200);
      savePersonal();
    });

    let queued = false;
    new MutationObserver(() => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; renderDock(); });
    }).observe(root, { subtree: true, attributes: true, attributeFilter: ['hidden', 'disabled', 'class'] });

    document.addEventListener('keydown', (event) => {
      const target = event.target;
      const editing = target instanceof HTMLElement && target.closest('input,textarea,select,[contenteditable="true"]');
      if (editing) {
        if (event.key === 'Escape') { event.preventDefault(); target.blur(); }
        return;
      }
      const stage = currentStage();
      if (['ArrowUp', 'ArrowDown'].includes(event.key) && stage === 'kp_recall') {
        const surface = currentScrollSurface();
        if (surface) {
          event.preventDefault();
          surface.scrollBy({ top: (event.key === 'ArrowDown' ? 1 : -1) * Math.max(220, surface.clientHeight * .72), behavior: 'smooth' });
        }
        return;
      }
      if (event.key === 'Enter') {
        if (stage === 'block_learn') root.querySelector('[data-stage-next="logic_group"]')?.click();
        else if (stage === 'logic_group') root.querySelector('[data-enter-group]')?.click();
        return;
      }
      const key = event.key.toLowerCase();
      if (key === 'c') { event.preventDefault(); comment?.focus(); comment?.select(); return; }
    });

    renderDock();
  }
</script>

<style>
  .xv6PersonalDock{display:grid;gap:8px;padding:10px 11px;border-bottom:1px solid var(--study-line);background:#fff}.xv6PersonalDock>header{display:grid!important;grid-template-columns:minmax(0,1fr) auto;gap:2px 8px;padding:0 0 6px!important;border:0!important}.xv6PersonalDock>header div{min-width:0}.xv6PersonalDock>header span,.xv6DockLocator>span,.xv6DockComment>span{display:block;color:var(--study-green);font-size:8px;font-weight:850;letter-spacing:.06em}.xv6PersonalDock>header strong{display:block;overflow:hidden;margin-top:2px;font-size:10px;text-overflow:ellipsis;white-space:nowrap}.xv6PersonalDock>header small{align-self:end;color:var(--study-muted);font-size:8px}.xv6DockLocator{display:grid;gap:3px;padding:7px;border-radius:8px;background:var(--study-surface-muted)}.xv6DockLocator code{overflow:hidden;color:var(--study-muted);font-size:8px;line-height:1.45;white-space:normal}.xv6DockComment{display:grid;gap:4px}.xv6DockComment textarea{width:100%;resize:vertical;min-height:42px;padding:7px;border:1px solid var(--study-line);border-radius:8px;background:#fff;font:inherit;font-size:9px;line-height:1.45}.xv6DockPacket{display:grid;gap:4px}.xv6DockPacket button{min-height:32px;border:1px solid var(--study-line);border-radius:7px;background:#fff;color:var(--study-ink);font:inherit;font-size:11px;font-weight:700;cursor:pointer}.xv6DockPacket button:hover{background:var(--study-surface-muted)}.xv6DockPacket small{color:var(--study-muted);font-size:9px;line-height:1.4}
  @media(min-width:1100px){.xv6Block .portedStudyLayout{grid-template-columns:220px minmax(0,1fr) 250px}.xv6Block .portedStudyLayout.outline-collapsed{grid-template-columns:0 minmax(0,1fr) 250px}.xv6Block .portedStudyLayout.chain-collapsed{grid-template-columns:220px minmax(0,1fr) 0}.xv6Block .portedKpWorkspace{min-height:0}.xv6Block .portedKpCards{height:calc(100vh - 225px);min-height:520px;max-height:760px;padding:8px 10px}.xv6Block .portedKpRecallCard{display:flex;height:100%;max-width:none;flex-direction:column}.xv6Block .portedKpRecallCard>header{padding:11px 15px 9px}.xv6Block .portedKpRecallCard>footer{margin-top:auto}.xv6Block .portedRecallAnswer{overflow:auto}.xv6Block .portedStudyChain{min-width:0}}
</style>