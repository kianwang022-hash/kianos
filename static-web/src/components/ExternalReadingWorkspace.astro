---
const base=import.meta.env.BASE_URL;
---
<section class="externalReadingHub" data-external-reading-runtime data-base={base}>
  <header class="externalReadingTop">
    <div>
      <a href={`${base}english/`}>‹ English</a>
      <span>EXTERNAL READING · GROWTH</span>
      <h1>额外阅读</h1>
      <p>历史 TPO / IELTS、新增官方来源与高质量长文共用同一 Reading Growth 工作区；保留各自 Source 身份，不把任何题型方法改写成考研 Reading A。</p>
    </div>
    <small data-external-status>读取私有 External Content…</small>
  </header>

  <section class="externalReadingLibrary" data-external-library>
    <div class="externalReadingCounts" data-external-counts></div>
    <div class="externalReadingSourceTabs" role="tablist" data-external-tabs></div>
    <div class="externalReadingCollections" data-external-collections></div>
  </section>

  <section class="externalReadingWorkspace" data-external-workspace hidden>
    <header class="portedReadingSessionHeader">
      <a href={`${base}external-reading/`} data-external-back>‹ 材料库</a>
      <div class="portedReadingHeaderCenter">
        <span data-external-kind>External</span>
        <b data-external-title></b>
        <small data-external-progress>Reading</small>
        <small data-external-timer>00:00</small>
      </div>
      <div class="portedReadingHeaderActions">
        <button type="button" data-external-mode aria-pressed="false">只读文章</button>
        <button type="button" class="submit" data-external-submit>Submit</button>
        <button type="button" data-external-finish>完成阅读</button>
      </div>
    </header>

    <details class="externalReadingSourceNote" data-external-source-note hidden>
      <summary>Source note</summary>
      <p data-external-source-note-text></p>
    </details>

    <div class="portedReadingColumns">
      <article class="portedReadingPassage" data-external-passage>
        <header>
          <span data-external-source></span>
          <h2 data-external-passage-title></h2>
        </header>
        <div data-external-paragraphs></div>
      </article>

      <aside class="portedReadingQuestions externalReadingQuestions">
        <section data-external-question-mode>
          <header class="externalReadingQuestionHeader">
            <div>
              <span>SOURCE-NATIVE QUESTIONS</span>
              <strong>原题身份保留 · 不套考研题型法</strong>
            </div>
            <small data-external-question-count></small>
          </header>
          <div data-external-questions></div>
        </section>

        <section class="externalReadingOnly" data-external-reading-only hidden>
          <span>READING ONLY</span>
          <h2>只读文章也成立。</h2>
          <p>理解、篇章、速度、词汇和复杂句就是本次训练；不会为了流程完整强造题目。</p>
        </section>
      </aside>
    </div>

    <section class="portedReadingResultBar" data-external-result hidden>
      <div class="portedReadingResultMain">
        <span>Result</span>
        <strong data-external-score></strong>
        <small data-external-result-meta></small>
      </div>
      <div class="portedReadingResultSummary">
        <b data-external-summary></b>
        <small>Wrong / Uncertain 是证据，不自动生成复习债；需要深挖时再交给 Chat。</small>
      </div>
    </section>
  </section>
</section>

<script>
  import {inspectEnglishAttempt,saveEnglishAttempt,preserveEnglishFailure} from '../lib/englishLearnerEvidence.mjs';

  const root=document.querySelector('[data-external-reading-runtime]');
  if(root instanceof HTMLElement){
    const base=root.getAttribute('data-base')||'/';
    const status=root.querySelector('[data-external-status]');
    const library=root.querySelector('[data-external-library]');
    const counts=root.querySelector('[data-external-counts]');
    const collections=root.querySelector('[data-external-collections]');
    const sourceTabs=root.querySelector('[data-external-tabs]');
    const workspace=root.querySelector('[data-external-workspace]');
    const paragraphs=root.querySelector('[data-external-paragraphs]');
    const title=root.querySelector('[data-external-title]');
    const passageTitle=root.querySelector('[data-external-passage-title]');
    const source=root.querySelector('[data-external-source]');
    const kind=root.querySelector('[data-external-kind]');
    const timer=root.querySelector('[data-external-timer]');
    const progress=root.querySelector('[data-external-progress]');
    const questionMode=root.querySelector('[data-external-question-mode]');
    const readingOnly=root.querySelector('[data-external-reading-only]');
    const questionsBox=root.querySelector('[data-external-questions]');
    const questionCount=root.querySelector('[data-external-question-count]');
    const questionOriginLabel=root.querySelector('[data-external-question-mode] .externalReadingQuestionHeader span');
    const questionOriginNote=root.querySelector('[data-external-question-mode] .externalReadingQuestionHeader strong');
    const modeButton=root.querySelector('[data-external-mode]');
    const submit=root.querySelector('[data-external-submit]');
    const finish=root.querySelector('[data-external-finish]');
    const result=root.querySelector('[data-external-result]');
    const score=root.querySelector('[data-external-score]');
    const resultMeta=root.querySelector('[data-external-result-meta]');
    const summary=root.querySelector('[data-external-summary]');
    const sourceNote=root.querySelector('[data-external-source-note]');
    const sourceNoteText=root.querySelector('[data-external-source-note-text]');

    let catalog=null;
    let family='TOEFL_TPO';
    let active=null;
    let state=null;
    let meta=null;
    let storageKey='';
    let tick=null;

    const setText=(el,value)=>{if(el instanceof HTMLElement)el.textContent=String(value??'');};
    const formatTime=s=>String(Math.floor(Math.max(0,s)/60)).padStart(2,'0')+':'+String(Math.floor(Math.max(0,s)%60)).padStart(2,'0');
    const readJson=(key,fallback=null)=>{try{return JSON.parse(localStorage.getItem(key)||'null')??fallback;}catch{return fallback;}};
    const attemptKey=id=>`kianos-english-external-reading-attempt-v1:${id}`;
    const lastKey='kianos-english-external-reading-last-location-v1';
    const endpoint=path=>`${base}__kianos-private/external-reading/${path}`;

    const fetchJson=async url=>{
      const response=await fetch(url,{cache:'no-store'});
      const data=await response.json().catch(()=>({status:'error',error:'External source response is not JSON.'}));
      if(!response.ok||data.status==='error')throw new Error(data.error||data.status||'External Reading unavailable');
      return data;
    };

    const normalizeText=value=>String(value??'').trim().replace(/\s+/g,' ').toLowerCase();
    const normalizeAnswer=value=>{
      if(Array.isArray(value))return value.map(normalizeText).filter(Boolean).sort();
      const raw=normalizeText(value);
      if(!raw)return[];
      return raw.split(/\s*[,;/|]\s*/).map(normalizeText).filter(Boolean).sort();
    };
    const sameAnswer=(actual,formal)=>{
      const left=normalizeAnswer(actual),right=normalizeAnswer(formal);
      return left.length===right.length&&left.every((v,i)=>v===right[i]);
    };

    const save=()=>{
      if(!active||!state||!meta)return;
      try{
        saveEnglishAttempt(localStorage,storageKey,state,meta,{root});
        localStorage.setItem(lastKey,JSON.stringify({
          id:active.object_id,
          title:active.title,
          href:`${base}external-reading/?id=${encodeURIComponent(active.object_id)}`,
          sourceHash:active.content_hash,
          updatedAt:new Date().toISOString()
        }));
      }catch(error){preserveEnglishFailure(root,error);}
    };

    const familyLabel=value=>({
      TOEFL_TPO:'TPO 56–65',
      IELTS_ACADEMIC:'IELTS Academic',
      TOEFL_CURRENT:'TOEFL Current',
      FUTURE_INCREMENTAL:'Long-form'
    }[String(value||'')]||String(value||'External').replaceAll('_',' '));

    const renderFamilyTabs=()=>{
      if(!(sourceTabs instanceof HTMLElement)||!catalog)return;
      const families=[...new Set((catalog.collections||[]).map(group=>group.source_family).filter(Boolean))];
      if(!families.includes(family))family=families[0]||'TOEFL_TPO';
      sourceTabs.innerHTML='';
      for(const value of families){
        const button=document.createElement('button');
        button.type='button';
        button.dataset.externalFamily=value;
        button.textContent=familyLabel(value);
        button.classList.toggle('active',value===family);
        button.addEventListener('click',()=>{
          family=value;
          sourceTabs.querySelectorAll('[data-external-family]').forEach(row=>row.classList.toggle('active',row===button));
          renderCatalog();
        });
        sourceTabs.appendChild(button);
      }
    };
    const renderCatalog=()=>{
      if(!(collections instanceof HTMLElement)||!catalog)return;
      collections.innerHTML='';
      const groups=(catalog.collections||[]).filter(group=>group.source_family===family);
      for(const group of groups){
        const details=document.createElement('details');
        details.open=collections.children.length===0;
        const summary=document.createElement('summary');
        summary.innerHTML='<div><strong></strong><small></small></div><span></span>';
        summary.querySelector('strong').textContent=group.collection;
        summary.querySelector('small').textContent=`${group.passages.length} passages`;
        const debt=group.passages.some(p=>(p.warnings||[]).length);
        summary.querySelector('span').textContent=debt?'source debt retained':'source bound';
        details.appendChild(summary);
        const rows=document.createElement('div');rows.className='externalReadingPassageRows';
        for(const item of group.passages){
          const a=document.createElement('a');
          a.href=`${base}external-reading/?id=${encodeURIComponent(item.object_id)}`;
          a.innerHTML='<span></span><div><strong></strong><small></small></div><b>→</b>';
          a.querySelector('span').textContent=item.test?('T'+item.test+(item.passage_number?' · P'+item.passage_number:'')):(item.passage_number?'P'+item.passage_number:'READ');
          a.querySelector('strong').textContent=item.title||item.object_id;
          const questionLabel=item.question_count>0?(item.question_count+' source questions'):'Reading only';
          a.querySelector('small').textContent=questionLabel+((item.warnings||[]).length?' · source note':'');
          rows.appendChild(a);
        }
        details.appendChild(rows);collections.appendChild(details);
      }
    };

    const renderQuestions=()=>{
      if(!(questionsBox instanceof HTMLElement)||!active||!state)return;
      questionsBox.innerHTML='';
      const rows=active.questions||[];
      setText(questionCount,`${rows.length} questions`);
      rows.forEach((q,index)=>{
        const section=document.createElement('section');
        section.className='portedReadingQuestion is-current';
        section.dataset.question=q.question_id;
        section.innerHTML='<header><span></span><button type="button" class="portedUncertain" aria-pressed="false">Uncertain</button></header><p></p>';
        section.querySelector('header span').textContent=`Question ${q.ordinal||index+1}`;
        section.querySelector(':scope > p').textContent=q.prompt||q.source_text||`Question ${q.ordinal||index+1}`;
        const uncertain=section.querySelector('.portedUncertain');
        uncertain.setAttribute('aria-pressed',String(state.uncertain.includes(q.question_id)));
        uncertain.addEventListener('click',()=>{
          if(state.submitted)return;
          const set=new Set(state.uncertain);
          if(set.has(q.question_id))set.delete(q.question_id);else set.add(q.question_id);
          state.uncertain=[...set];save();renderQuestions();
        });

        if(q.response_kind==='single_choice'&&Object.keys(q.options||{}).length>=2){
          const options=document.createElement('div');options.className='portedReadingOptions';
          for(const [label,text] of Object.entries(q.options)){
            const button=document.createElement('button');button.type='button';button.dataset.option=label;
            button.innerHTML='<b></b><span></span>';button.querySelector('b').textContent=label;button.querySelector('span').textContent=text;
            button.classList.toggle('selected',state.answers[q.question_id]===label);
            button.disabled=Boolean(state.submitted);
            button.addEventListener('click',()=>{if(state.submitted)return;state.answers[q.question_id]=label;save();renderQuestions();});
            options.appendChild(button);
          }
          section.appendChild(options);
        }else{
          const sourceBlock=document.createElement('details');sourceBlock.className='externalSourceQuestion';
          sourceBlock.innerHTML='<summary>原题结构</summary><pre></pre>';
          sourceBlock.querySelector('pre').textContent=q.source_text||q.prompt||'';
          const input=document.createElement('textarea');input.rows=3;input.className='externalReadingFreeText';input.placeholder='按原题要求作答';
          input.value=String(state.answers[q.question_id]||'');input.disabled=Boolean(state.submitted);
          input.addEventListener('input',()=>{state.answers[q.question_id]=input.value;save();});
          section.append(sourceBlock,input);
        }

        if(state.submitted){
          const strip=document.createElement('div');strip.className='portedReadingAnswerStrip';
          strip.innerHTML='<span>你的答案 <b></b></span><span>正式答案 <b></b></span><span>结果 <b></b></span>';
          const bold=[...strip.querySelectorAll('b')];
          bold[0].textContent=Array.isArray(state.answers[q.question_id])?state.answers[q.question_id].join(', '):(state.answers[q.question_id]||'—');
          const formal=state.formalAnswers?.[q.question_id];
          bold[1].textContent=Array.isArray(formal)?formal.join(', '):(formal??'—');
          const outcome=state.results?.[q.question_id]||'unscored';
          bold[2].textContent=outcome==='correct'?'✓':outcome==='unscored'?'需人工复盘':'需复盘';
          section.appendChild(strip);
        }
        questionsBox.appendChild(section);
      });
    };

    const renderState=()=>{
      if(!active||!state)return;
      const requiresQuestions=active.completion_requirement==='QUESTIONS_SUBMITTED';
      const noQuestions=(active.questions||[]).length===0;
      if(requiresQuestions&&state.mode==='READ_ONLY')state.mode='QUESTIONS';
      if(noQuestions)state.mode='READ_ONLY';
      const readOnly=noQuestions||state.mode==='READ_ONLY';
      if(modeButton instanceof HTMLButtonElement){
        modeButton.hidden=requiresQuestions||noQuestions;
        modeButton.setAttribute('aria-pressed',String(readOnly));
        modeButton.textContent=readOnly?'带原题阅读':'只读文章';
      }
      if(questionMode instanceof HTMLElement)questionMode.hidden=readOnly;
      if(readingOnly instanceof HTMLElement)readingOnly.hidden=!readOnly;
      if(submit instanceof HTMLButtonElement)submit.hidden=readOnly||state.submitted;
      if(finish instanceof HTMLButtonElement)finish.hidden=requiresQuestions;
      renderQuestions();
      if(state.submitted&&result instanceof HTMLElement){
        result.hidden=false;
        const outcomes=Object.values(state.results||{});
        const correct=outcomes.filter(v=>v==='correct').length;
        const scoreable=outcomes.filter(v=>v!=='unscored').length;
        setText(score,`${correct} / ${scoreable}`);
        setText(resultMeta,active.question_origin==='CHAT_GENERATED'?'Chat-generated practice · not true-paper calibration':(scoreable<active.questions.length?`${active.questions.length-scoreable} item(s) keep source-native/manual review`:'source-backed result'));
        setText(summary,state.uncertain.length?'保留了 Uncertain；只处理真正值得修的地方。':'做完即可离开；不会自动生成复习债。');
      }else if(result instanceof HTMLElement)result.hidden=true;
      setText(progress,state.stage==='completed'?'Completed':readOnly?'Reading only':`${Object.keys(state.answers||{}).length}/${active.questions.length} answered`);
    };

    const openObject=async id=>{
      const payload=await fetchJson(endpoint('passage?id='+encodeURIComponent(id)));
      active=payload.passage;
      meta={
        task:'external_reading',
        object_id:active.object_id,
        source_hash:active.content_hash,
        snapshot:{
          source_family:active.source_family,
          source_format:active.source_format,
          collection:active.collection,
          test:active.test,
          passage_number:active.passage_number,
          title:active.title,
          paragraphs:active.passage_paragraphs,
          figures:(active.source_figures||[]).map(({figure_id,ordinal,caption,source_url,source_position,figure_note,origin})=>({figure_id,ordinal,caption,source_url,source_position,figure_note,origin})),
          questions:(active.questions||[]).map(({question_id,ordinal,prompt,options,response_kind,origin})=>({question_id,ordinal,prompt,options,response_kind,origin})),
          question_origin:active.question_origin||'SOURCE_NATIVE',
          drill_origin:active.drill_origin||null,
          completion_requirement:active.completion_requirement||'READ_ONLY_OK',
          training_target:active.training_target||null
        }
      };
      storageKey=attemptKey(active.object_id);
      const saved=inspectEnglishAttempt(localStorage,storageKey,meta,{root})||{};
      state={
        version:1,
        startedAt:saved.startedAt||new Date().toISOString(),
        answers:saved.answers||{},
        uncertain:Array.isArray(saved.uncertain)?saved.uncertain:[],
        submitted:saved.submitted===true,
        submittedAt:saved.submittedAt||'',
        results:saved.results||{},
        formalAnswers:saved.formalAnswers||{},
        mode:(active.questions||[]).length===0?'READ_ONLY':(saved.mode||'QUESTIONS'),
        stage:saved.stage||'active'
      };
      save();
      if(library instanceof HTMLElement)library.hidden=true;
      if(workspace instanceof HTMLElement)workspace.hidden=false;
      setText(title,active.title||active.object_id);
      setText(passageTitle,active.title||active.object_id);
      const generated=active.question_origin==='CHAT_GENERATED';
      const nativeKind=active.source_family==='TOEFL_TPO'?'TPO · LEGACY TOEFL'
        :active.source_family==='IELTS_ACADEMIC'?'IELTS · ACADEMIC'
        :active.source_family==='TOEFL_CURRENT'?'TOEFL · CURRENT'
        :active.source_family==='FUTURE_INCREMENTAL'?'EXTERNAL · LONG-FORM'
        :familyLabel(active.source_family);
      setText(kind,generated?(active.drill_origin==='CHAT_GENERATED_ON_EXTERNAL_SOURCE'?'SOURCE + CHAT DRILL':'CHAT · SYNTHETIC'):nativeKind);
      const nativeLocator=String(active.collection||'External')+(active.test?' · Test '+active.test:'')+(active.passage_number?' · Passage '+active.passage_number:'');
      setText(source,generated&&active.drill_origin==='CHAT_GENERATED_SYNTHETIC'?('Chat-generated · '+(active.training_target?.kind||'English drill')):nativeLocator);
      setText(questionOriginLabel,generated?'CHAT-GENERATED DRILL':'SOURCE-NATIVE QUESTIONS');
      setText(questionOriginNote,generated?'题目由 Chat 生成 · 只作训练证据，不冒充原题':'原题身份保留 · 不套考研题型法');
      if(paragraphs instanceof HTMLElement){
        paragraphs.innerHTML='';
        const fallback=(active.passage_paragraphs||[]).map(row=>({type:'paragraph',text:typeof row==='string'?row:(row.text||'')}));
        const blocks=Array.isArray(active.passage_blocks)&&active.passage_blocks.length?active.passage_blocks:fallback;
        for(const block of blocks){
          if(block?.type==='figure'&&block.figure){
            const figure=document.createElement('figure');
            figure.className='externalSourceFigure';
            figure.dataset.figureId=String(block.figure.figure_id||'');
            const url=String(block.figure.source_url||'').trim();
            if(url.startsWith('https://')){
              const img=document.createElement('img');
              img.src=url;
              img.alt=String(block.figure.caption||'Source figure');
              img.loading='lazy';
              img.decoding='async';
              img.referrerPolicy='no-referrer';
              img.addEventListener('error',()=>{img.hidden=true;figure.classList.add('image-missing');});
              figure.appendChild(img);
            }else{
              figure.classList.add('image-missing');
            }
            const caption=document.createElement('figcaption');
            const strong=document.createElement('strong');
            strong.textContent=String(block.figure.caption||'Source figure');
            caption.appendChild(strong);
            if(block.figure.figure_note){
              const note=document.createElement('small');
              note.textContent=String(block.figure.figure_note);
              caption.appendChild(note);
            }
            if(url.startsWith('https://')){
              const link=document.createElement('a');
              link.href=url;link.target='_blank';link.rel='noopener noreferrer';
              link.textContent='Source figure ↗';
              caption.appendChild(link);
            }
            figure.appendChild(caption);
            paragraphs.appendChild(figure);
            continue;
          }
          if(block?.type==='paragraph'){
            const p=document.createElement('p');
            p.textContent=String(block.text||'');
            paragraphs.appendChild(p);
          }
        }
      }
      const warnings=[...new Set(active.warnings||[])];
      const generatedNote=generated?`训练目标：${active.training_target?.note||active.training_target?.kind||'当前 Chat 指定训练'}。题目是 Chat-generated，不是 TOEFL / IELTS / 考研原题。`:'';
      if(sourceNote instanceof HTMLDetailsElement)sourceNote.hidden=!(warnings.length||generatedNote);
      setText(sourceNoteText,generatedNote||(warnings.length?('Source note：'+warnings.join(' · ')+'。系统只做机械或 source-bound 处理，不猜正文。'):''));
      if(tick)clearInterval(tick);
      const update=()=>setText(timer,formatTime((Date.now()-Date.parse(state.startedAt))/1000));
      update();tick=setInterval(update,1000);
      renderState();
    };

    modeButton?.addEventListener('click',()=>{
      if(!state||state.submitted)return;
      state.mode=state.mode==='READ_ONLY'?'QUESTIONS':'READ_ONLY';save();renderState();
    });

    submit?.addEventListener('click',async()=>{
      if(!active||!state||state.submitted||state.mode==='READ_ONLY')return;
      try{
        const payload=await fetchJson(endpoint('answers?id='+encodeURIComponent(active.object_id)));
        if(payload.answers?.content_hash!==active.content_hash)throw new Error('EXTERNAL_READING_ANSWER_REVISION_MISMATCH');
        const formal=payload.answers?.answers||{};
        state.formalAnswers=formal;
        state.results={};
        for(const q of active.questions||[]){
          const answer=formal[q.question_id];
          state.results[q.question_id]=answer==null?'unscored':(sameAnswer(state.answers[q.question_id],answer)?'correct':(state.answers[q.question_id]?'wrong':'unanswered'));
        }
        state.submitted=true;state.submittedAt=new Date().toISOString();state.stage='submitted';save();renderState();
      }catch(error){setText(status,error instanceof Error?error.message:String(error));}
    });

    finish?.addEventListener('click',()=>{
      if(!state)return;
      state.stage='completed';state.completedAt=new Date().toISOString();save();renderState();
      setText(status,'本次阅读已记录。完成不等于 mastery，也不会自动生成复习债。');
    });

    try{
      catalog=await fetchJson(endpoint('catalog'));
      const t=catalog.counts?.toefl||{},i=catalog.counts?.ielts||{},inc=catalog.counts?.incremental||{};
      const incrementalText=(inc.objects||0)>0?('    |    NEW '+(inc.objects||0)+' source(s) · '+(inc.questions||0)+' questions'):'';
      setText(counts,'TPO '+(t.collections||0)+'/10 · '+(t.passages||0)+' passages · '+(t.questions||0)+' questions    |    IELTS '+(i.books||0)+'/3 · '+(i.passages||0)+' passages · '+(i.questions||0)+' questions'+incrementalText);
      setText(status,'External Content ready · 私有 Source / 公共 identity');
      renderFamilyTabs();
      renderCatalog();
      const id=new URLSearchParams(location.search).get('id');
      if(id)await openObject(id);
    }catch(error){
      setText(status,error instanceof Error?error.message:String(error));
      if(collections instanceof HTMLElement)collections.innerHTML='<p class="externalReadingUnavailable">External 私有 Source 尚未编译或当前不可读取。网页不会回退旧资产，也不会凭空造材料。</p>';
    }
  }
</script>

<style>
  .externalReadingHub{display:grid;gap:18px}
  .externalReadingTop{display:flex;justify-content:space-between;gap:24px;align-items:flex-end;padding:10px 0 4px;border-bottom:1px solid var(--study-line)}
  .externalReadingTop>div{display:grid;gap:5px}.externalReadingTop a{width:max-content;text-decoration:none;color:inherit;font-weight:750}
  .externalReadingTop span,.externalReadingOnly>span,.externalReadingQuestionHeader span{font-size:12px;font-weight:850;letter-spacing:.08em;color:var(--study-green)}
  .externalReadingTop h1{margin:0;font-size:32px}.externalReadingTop p{margin:0;max-width:820px;font-size:16px;line-height:1.6;color:var(--study-muted)}
  .externalReadingTop>small{font-size:13px;color:var(--study-muted)}
