---
const base=import.meta.env.BASE_URL;
---
<section class="externalReadingHub" data-external-reading data-base={base}>
  <header class="externalReadingTop">
    <div>
      <a href={`${base}english/`}>‹ English</a>
      <span>EXTERNAL READING · GROWTH</span>
      <h1>额外阅读</h1>
      <p>TPO 学术阅读优先，IELTS Academic 次之。共享阅读工作区，不把它们改造成考研 Reading A。</p>
    </div>
    <small data-external-status>本机导入 · 私人学习状态</small>
  </header>

  <div class="externalReadingSetup">
    <details data-external-import-panel>
      <summary>导入 TPO / IELTS 阅读对象</summary>
      <p>支持 passage-only；有原题时保留 source-native identity。当前不支持的原题型会 fail-closed 为纯阅读，不会被强造为选择题。</p>
      <textarea rows="10" data-external-import-text placeholder='粘贴 kianos.english.external_reading_object.v2 JSON'></textarea>
      <div class="externalReadingImportActions">
        <label>选择 JSON <input type="file" accept=".json,application/json" data-external-import-file /></label>
        <button type="button" data-external-import-apply>导入到本机</button>
      </div>
      <small data-external-import-status></small>
    </details>
    <section class="externalReadingLibrary">
      <header><strong>已导入材料</strong><span data-external-count>0</span></header>
      <div data-external-list><p>还没有导入材料。</p></div>
    </section>
  </div>

  <section class="externalReadingWorkspace" data-external-workspace hidden>
    <header class="portedReadingSessionHeader">
      <a href={`${base}external-reading/`}>‹ 材料库</a>
      <div class="portedReadingHeaderCenter">
        <span data-external-kind>External</span>
        <b data-external-title></b>
        <small data-external-progress>Reading</small>
        <small data-external-timer>00:00</small>
      </div>
      <div class="portedReadingHeaderActions">
        <button type="button" class="submit" data-external-submit hidden>Submit</button>
        <button type="button" data-external-finish>完成本次阅读</button>
      </div>
    </header>

    <div class="externalReadingNotice" data-external-notice hidden></div>

    <div class="portedReadingColumns">
      <article class="portedReadingPassage" data-external-passage>
        <header>
          <span data-external-source></span>
          <h2 data-external-passage-title></h2>
        </header>
        <div data-external-paragraphs></div>
      </article>

      <aside class="portedReadingQuestions externalReadingRight">
        <section data-external-question-mode hidden>
          <header class="externalReadingQuestionHeader">
            <div><span>SOURCE-NATIVE QUESTIONS</span><strong>保留原题型，不套考研题型法。</strong></div>
            <small data-external-question-count></small>
          </header>
          <div data-external-questions></div>
          <section class="portedReadingResultBar" data-external-result hidden>
            <div class="portedReadingResultMain">
              <span>Result</span>
              <strong data-external-score></strong>
            </div>
            <div class="portedReadingResultSummary"><b data-external-summary></b></div>
          </section>
        </section>

        <section class="externalReadingOnly" data-external-reading-only>
          <span>READING GROWTH</span>
          <h2>先把文章读完。</h2>
          <p>这里只训练真实阅读：理解、篇章、速度、词汇与复杂句。没有原题就不造题。</p>
          <label>可选一句笔记
            <textarea rows="5" data-external-note placeholder="只在真的有价值时记。"></textarea>
          </label>
        </section>
      </aside>
    </div>
  </section>
</section>

<script>
  import {
    EXTERNAL_READING_LAST_LOCATION_KEY,
    externalReadingAttemptKey,
    externalReadingSourceHash,
    externalReadingSnapshot,
    importExternalReadingObject,
    listExternalReadingImports,
    readExternalReadingImport
  } from '../lib/englishExternalReading.mjs';
  import {inspectEnglishAttempt,saveEnglishAttempt,preserveEnglishFailure} from '../lib/englishLearnerEvidence.mjs';

  const root=document.querySelector('[data-external-reading]');
  if(root instanceof HTMLElement){
    const base=root.getAttribute('data-base')||'/';
    const status=root.querySelector('[data-external-status]');
    const importText=root.querySelector('[data-external-import-text]');
    const importFile=root.querySelector('[data-external-import-file]');
    const importStatus=root.querySelector('[data-external-import-status]');
    const list=root.querySelector('[data-external-list]');
    const count=root.querySelector('[data-external-count]');
    const workspace=root.querySelector('[data-external-workspace]');
    const passage=root.querySelector('[data-external-paragraphs]');
    const title=root.querySelector('[data-external-title]');
    const passageTitle=root.querySelector('[data-external-passage-title]');
    const source=root.querySelector('[data-external-source]');
    const kind=root.querySelector('[data-external-kind]');
    const timer=root.querySelector('[data-external-timer]');
    const progress=root.querySelector('[data-external-progress]');
    const questionMode=root.querySelector('[data-external-question-mode]');
    const readingOnly=root.querySelector('[data-external-reading-only]');
    const questionsBox=root.querySelector('[data-external-questions]');
    const questionCount=root.querySelector('[data-external-question-count]');
    const submit=root.querySelector('[data-external-submit]');
    const finish=root.querySelector('[data-external-finish]');
    const result=root.querySelector('[data-external-result]');
    const score=root.querySelector('[data-external-score]');
    const summary=root.querySelector('[data-external-summary]');
    const notice=root.querySelector('[data-external-notice]');
    const note=root.querySelector('[data-external-note]');

    let active=null;
    let state=null;
    let meta=null;
    let storageKey='';
    let tick=null;
    const setText=(el,value)=>{if(el instanceof HTMLElement)el.textContent=String(value??'');};
    const formatTime=s=>String(Math.floor(Math.max(0,s)/60)).padStart(2,'0')+':'+String(Math.floor(Math.max(0,s)%60)).padStart(2,'0');
    const normalizeAnswer=value=>Array.isArray(value)?value.map(String).sort():[String(value??'')];
    const sameAnswer=(a,b)=>{
      const left=normalizeAnswer(a).map(x=>x.trim().toLowerCase()).filter(Boolean).sort();
      const right=normalizeAnswer(b).map(x=>x.trim().toLowerCase()).filter(Boolean).sort();
      return left.length===right.length&&left.every((v,i)=>v===right[i]);
    };
    const save=()=>{
      if(!active||!state||!meta)return;
      try{
        saveEnglishAttempt(localStorage,storageKey,state,meta,{root});
        localStorage.setItem(EXTERNAL_READING_LAST_LOCATION_KEY,JSON.stringify({
          id:active.object.object_id,
          title:active.object.content.title||active.object.source.title||active.object.source.source_id,
          href:`${base}external-reading/?id=${encodeURIComponent(active.object.object_id)}`,
          updatedAt:new Date().toISOString()
        }));
      }catch(error){preserveEnglishFailure(root,error);}
    };

    const renderLibrary=()=>{
      try{
        const items=listExternalReadingImports(localStorage);
        setText(count,items.length);
        if(!(list instanceof HTMLElement))return;
        list.innerHTML='';
        if(!items.length){list.innerHTML='<p>还没有导入材料。</p>';return;}
        for(const item of items){
          const a=document.createElement('a');
          a.href=`${base}external-reading/?id=${encodeURIComponent(item.object_id)}`;
          a.className='externalReadingItem';
          const format=item.source?.format==='TOEFL_LEGACY'?'TPO':item.source?.format==='IELTS_ACADEMIC'?'IELTS':'Reading';
          a.innerHTML=`<span>${format}</span><div><strong></strong><small></small></div><b>→</b>`;
          a.querySelector('strong').textContent=item.title||item.object_id;
          a.querySelector('small').textContent=(item.question_count?item.question_count+' source questions · ':'passage-only · ')+(item.source?.source_id||'');
          list.appendChild(a);
        }
      }catch(error){setText(status,error instanceof Error?error.message:String(error));}
    };

    const answerFor=(qid)=>{
      const value=state?.answers?.[qid];
      return value==null?'':value;
    };
    const renderQuestions=()=>{
      if(!(questionsBox instanceof HTMLElement)||!active)return;
      questionsBox.innerHTML='';
      const rows=active.object.questions||[];
      const unsupported=rows.some(q=>q.interaction==='UNSUPPORTED_SOURCE_NATIVE');
      if(unsupported){
        if(questionMode instanceof HTMLElement)questionMode.hidden=true;
        if(readingOnly instanceof HTMLElement)readingOnly.hidden=false;
        if(notice instanceof HTMLElement){
          notice.hidden=false;
          notice.textContent='原题包含当前未适配的 source-native interaction；本次保持纯阅读，不把它硬改成 Reading A。';
        }
        if(submit instanceof HTMLButtonElement)submit.hidden=true;
        return;
      }
      if(!rows.length){
        if(questionMode instanceof HTMLElement)questionMode.hidden=true;
        if(readingOnly instanceof HTMLElement)readingOnly.hidden=false;
        if(submit instanceof HTMLButtonElement)submit.hidden=true;
        return;
      }
      if(questionMode instanceof HTMLElement)questionMode.hidden=false;
      if(readingOnly instanceof HTMLElement)readingOnly.hidden=true;
      if(submit instanceof HTMLButtonElement)submit.hidden=false;
      setText(questionCount,rows.length+' questions');
      rows.forEach((q,index)=>{
        const section=document.createElement('section');
        section.className='portedReadingQuestion is-current';
        section.dataset.question=q.id;
        const header=document.createElement('header');
        header.innerHTML=`<span>Question ${q.ordinal||index+1}</span><button type="button" class="portedUncertain" aria-pressed="false">Uncertain</button>`;
        const p=document.createElement('p');p.textContent=q.prompt;
        section.append(header,p);
        const uncertain=header.querySelector('button');
        if(state.uncertain.includes(q.id))uncertain?.setAttribute('aria-pressed','true');
        uncertain?.addEventListener('click',()=>{
          const set=new Set(state.uncertain);
          if(set.has(q.id))set.delete(q.id);else set.add(q.id);
          state.uncertain=[...set];uncertain.setAttribute('aria-pressed',String(set.has(q.id)));save();
        });
        if(['SINGLE_CHOICE','MULTI_CHOICE'].includes(q.interaction)){
          const options=document.createElement('div');options.className='portedReadingOptions';
          for(const [label,text] of Object.entries(q.options||{})){
            const button=document.createElement('button');button.type='button';button.dataset.option=label;
            button.innerHTML='<b></b><span></span>';button.querySelector('b').textContent=label;button.querySelector('span').textContent=text;
            const selected=Array.isArray(answerFor(q.id))?answerFor(q.id).includes(label):answerFor(q.id)===label;
            button.classList.toggle('selected',selected);
            button.addEventListener('click',()=>{
              if(state.submitted)return;
              if(q.interaction==='MULTI_CHOICE'){
                const set=new Set(Array.isArray(state.answers[q.id])?state.answers[q.id]:[]);
                if(set.has(label))set.delete(label);else set.add(label);
                state.answers[q.id]=[...set];
              }else state.answers[q.id]=label;
              renderQuestions();save();
            });
            options.appendChild(button);
          }
          section.appendChild(options);
        }else if(q.interaction==='TEXT'){
          const input=document.createElement('input');input.type='text';input.className='externalReadingTextAnswer';
          input.value=String(answerFor(q.id)||'');input.placeholder='Your answer';
          input.disabled=Boolean(state.submitted);
          input.addEventListener('input',()=>{state.answers[q.id]=input.value;save();});
          section.appendChild(input);
        }
        if(state.submitted){
          const strip=document.createElement('div');strip.className='portedReadingAnswerStrip';
          strip.innerHTML='<span>你的答案 <b></b></span><span>结果 <b></b></span>';
          strip.querySelectorAll('b')[0].textContent=Array.isArray(state.answers[q.id])?state.answers[q.id].join(', '):(state.answers[q.id]||'—');
          strip.querySelectorAll('b')[1].textContent=state.results[q.id]==='correct'?'✓':'需复盘';
          section.appendChild(strip);
        }
        questionsBox.appendChild(section);
      });
    };

    const renderState=()=>{
      if(!active||!state)return;
      if(note instanceof HTMLTextAreaElement)note.value=state.note||'';
      renderQuestions();
      if(state.submitted&&result instanceof HTMLElement){
        result.hidden=false;
        const correct=Object.values(state.results||{}).filter(v=>v==='correct').length;
        setText(score,correct+' / '+active.object.questions.length);
        setText(summary,state.uncertain.length?'保留 Uncertain；是否深挖由你/Chat 决定。':'做完即可离开，不自动制造复习债。');
      }else if(result instanceof HTMLElement)result.hidden=true;
      setText(progress,state.stage==='completed'?'Completed':active.object.questions.length?'Questions available':'Passage only');
    };

    const openObject=async(id)=>{
      const record=readExternalReadingImport(localStorage,id);
      if(!record)throw new Error('EXTERNAL_READING_IMPORT_NOT_FOUND:'+id);
      const actual=await externalReadingSourceHash(record.object);
      if(actual!==record.source_hash)throw new Error('EXTERNAL_READING_IMPORT_HASH_MISMATCH:'+id);
      active=record;
      meta={task:'external_reading',object_id:id,source_hash:record.source_hash,snapshot:externalReadingSnapshot(record)};
      storageKey=externalReadingAttemptKey(id);
      const saved=inspectEnglishAttempt(localStorage,storageKey,meta,{root})||{};
      state={
        version:1,
        startedAt:saved.startedAt||new Date().toISOString(),
        answers:saved.answers||{},
        uncertain:Array.isArray(saved.uncertain)?saved.uncertain:[],
        submitted:saved.submitted===true,
        submittedAt:saved.submittedAt||'',
        results:saved.results||{},
        note:saved.note||'',
        stage:saved.stage||'active'
      };
      save();
      if(workspace instanceof HTMLElement)workspace.hidden=false;
      const object=record.object;
      setText(title,object.content.title||object.source.title||object.source.source_id);
      setText(passageTitle,object.content.title||object.source.title||object.source.source_id);
      setText(kind,object.source.format==='TOEFL_LEGACY'?'TPO · LEGACY TOEFL':object.source.format==='IELTS_ACADEMIC'?'IELTS · ACADEMIC':'EXTERNAL READING');
      setText(source,(object.source.source_id||'')+(object.source.publication?' · '+object.source.publication:''));
      if(passage instanceof HTMLElement){
        passage.innerHTML='';
        for(const row of object.content.paragraphs){const p=document.createElement('p');p.id=row.id;p.textContent=row.text;passage.appendChild(p);}
      }
      if(tick)clearInterval(tick);
      const updateTimer=()=>setText(timer,formatTime((Date.now()-Date.parse(state.startedAt))/1000));
      updateTimer();tick=setInterval(updateTimer,1000);
      renderState();
    };

    root.querySelector('[data-external-import-apply]')?.addEventListener('click',async()=>{
      try{
        const raw=importText instanceof HTMLTextAreaElement?importText.value:'';
        if(!raw.trim())throw new Error('请先粘贴 JSON 或选择文件。');
        const record=await importExternalReadingObject(localStorage,raw);
        setText(importStatus,'已导入 · '+record.object.object_id);
        renderLibrary();
        location.href=`${base}external-reading/?id=${encodeURIComponent(record.object.object_id)}`;
      }catch(error){setText(importStatus,error instanceof Error?error.message:String(error));}
    });
    importFile?.addEventListener('change',async event=>{
      const file=event.target?.files?.[0];if(!file)return;
      try{const text=await file.text();if(importText instanceof HTMLTextAreaElement)importText.value=text;setText(importStatus,'已读取 '+file.name+'；确认后导入。');}
      catch(error){setText(importStatus,error instanceof Error?error.message:String(error));}
    });
    submit?.addEventListener('click',()=>{
      if(!active||!state||state.submitted)return;
      const rows=active.object.questions||[];
      if(!rows.length||rows.some(q=>q.interaction==='UNSUPPORTED_SOURCE_NATIVE'))return;
      state.results={};
      for(const q of rows)state.results[q.id]=sameAnswer(state.answers[q.id],q.answer)?'correct':(state.answers[q.id]?'wrong':'unanswered');
      state.submitted=true;state.submittedAt=new Date().toISOString();save();renderState();
    });
    note?.addEventListener('input',()=>{if(state&&note instanceof HTMLTextAreaElement){state.note=note.value;save();}});
    finish?.addEventListener('click',()=>{
      if(!state)return;
      state.stage='completed';state.completedAt=new Date().toISOString();save();renderState();setText(status,'本次阅读已记录。完成 ≠ mastery，也不会自动生成复习债。');
    });

    renderLibrary();
    const id=new URLSearchParams(location.search).get('id');
    if(id)openObject(id).catch(error=>setText(status,error instanceof Error?error.message:String(error)));
  }
</script>

<style>
  .externalReadingHub{display:grid;gap:18px}
  .externalReadingTop{display:flex;justify-content:space-between;gap:24px;align-items:flex-end;padding:10px 0 4px;border-bottom:1px solid var(--study-line)}
  .externalReadingTop>div{display:grid;gap:5px}.externalReadingTop a{width:max-content;text-decoration:none;color:inherit;font-weight:750}
  .externalReadingTop span,.externalReadingOnly>span,.externalReadingQuestionHeader span{font-size:12px;font-weight:850;letter-spacing:.08em;color:var(--study-green)}
  .externalReadingTop h1{margin:0;font-size:32px}.externalReadingTop p{margin:0;max-width:760px;font-size:16px;line-height:1.6;color:var(--study-muted)}
  .externalReadingTop>small{font-size:13px;color:var(--study-muted)}
  .externalReadingSetup{display:grid;grid-template-columns:minmax(0,1fr) minmax(360px,.8fr);gap:18px}
  .externalReadingSetup details,.externalReadingLibrary{border:1px solid var(--study-line);border-radius:12px;background:#fff;padding:16px}
  .externalReadingSetup summary{font-size:16px;font-weight:800;cursor:pointer}.externalReadingSetup p{font-size:14px;line-height:1.6;color:var(--study-muted)}
  .externalReadingSetup textarea{box-sizing:border-box;width:100%;padding:12px;border:1px solid var(--study-line);border-radius:9px;font:inherit;font-size:14px;line-height:1.5}
  .externalReadingImportActions{display:flex;gap:10px;align-items:center;margin-top:10px}.externalReadingImportActions label,.externalReadingImportActions button{font:inherit;font-size:13px}
  .externalReadingImportActions button{padding:8px 12px;border:1px solid var(--study-green);border-radius:8px;background:var(--study-green);color:#fff;cursor:pointer}
  .externalReadingLibrary header{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}.externalReadingLibrary header strong{font-size:16px}
  [data-external-list]{display:grid}.externalReadingItem{display:grid;grid-template-columns:52px 1fr auto;gap:12px;align-items:center;padding:12px 2px;border-top:1px solid var(--study-line);color:inherit;text-decoration:none}
  .externalReadingItem>span{font-size:12px;font-weight:850;color:var(--study-green)}.externalReadingItem div{display:grid;gap:3px}.externalReadingItem strong{font-size:15px}.externalReadingItem small{font-size:12px;color:var(--study-muted)}
  .externalReadingWorkspace{display:grid;gap:10px}.externalReadingNotice{padding:10px 12px;border:1px solid var(--study-line);border-radius:8px;font-size:14px;line-height:1.5}
  .externalReadingRight{display:block}.externalReadingQuestionHeader{display:flex;justify-content:space-between;align-items:flex-end;padding:10px 2px 14px}.externalReadingQuestionHeader>div{display:grid;gap:3px}.externalReadingQuestionHeader strong{font-size:15px}
  .externalReadingOnly{display:grid;gap:12px;padding:24px}.externalReadingOnly h2{margin:0;font-size:24px}.externalReadingOnly p{margin:0;font-size:15px;line-height:1.65;color:var(--study-muted)}
  .externalReadingOnly label{display:grid;gap:7px;font-size:14px;font-weight:750}.externalReadingOnly textarea{padding:12px;border:1px solid var(--study-line);border-radius:8px;font:inherit;line-height:1.5}
  .externalReadingTextAnswer{box-sizing:border-box;width:100%;padding:10px 12px;border:1px solid var(--study-line);border-radius:8px;font:inherit;font-size:15px}
  @media(max-width:900px){.externalReadingSetup{grid-template-columns:1fr}.externalReadingTop{align-items:flex-start;flex-direction:column}.externalReadingTop h1{font-size:28px}}
</style>
