---
const { system, block = null } = Astro.props;
const blockId = block?.blockId || '';
const blockIds = (system?.blocks || []).map((row) => row.blockId).filter(Boolean);
---
<span data-xizong-runtime-stage-guard hidden></span>

<script define:vars={{ blockId, blockIds }}>
  const readBlockState = (id) => {
    if (!id) return {};
    try {
      return JSON.parse(localStorage.getItem(`kianos-xizong-astro-v2:xizong:${id}`) || 'null') || {};
    } catch {
      return {};
    }
  };


  const stop = (event) => {
    event.preventDefault();
    event.stopImmediatePropagation();
  };

  const setBlockStatus = (root, message) => {
    const status = root?.querySelector('[data-study-local-status]');
    if (status) status.textContent = message;
  };

  const blockCounts = (root, state) => {
    const total = root?.querySelectorAll('[data-kp-recall-card]').length || 0;
    return {
      total,
      learned: Object.values(state?.learned || {}).filter(Boolean).length,
      recalled: Object.keys(state?.ratings || {}).length
    };
  };

  // Free navigation among orientation/current-learning surfaces is preserved.
  // Later-stage evidence and answer reveal fail closed until the prerequisite
  // formal learning contact actually exists in browser-local learner state.
  if (blockId) {
    const root = document.querySelector('[data-xizong-v6-block]');
    root?.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;

      const state = readBlockState(blockId);
      const counts = blockCounts(root, state);

      const stageTarget = target.closest('[data-stage-target]');
      if (stageTarget) {
        const requested = stageTarget.getAttribute('data-stage-target') || '';

        if (requested === 'kp_recall' && counts.learned <= counts.recalled) {
          stop(event);
          setBlockStatus(root, '先完成当前学习节的原讲义连续学习，再进入本节 Recall');
          return;
        }

        if (requested === 'block_recall' && (!counts.total || counts.learned < counts.total || counts.recalled < counts.total)) {
          stop(event);
          setBlockStatus(root, `Block Recall 需先闭合全部学习节（学习接触 ${counts.learned}/${counts.total} · Recall ${counts.recalled}/${counts.total}）`);
          return;
        }

        if (requested === 'block_complete') {
          const ready = counts.total > 0 && counts.learned >= counts.total && counts.recalled >= counts.total && Boolean(state?.blockRecallDone);
          if (!ready) {
            stop(event);
            setBlockStatus(root, `Block 完成证据未闭合（学习接触 ${counts.learned}/${counts.total} · Recall ${counts.recalled}/${counts.total} · Block Recall ${state?.blockRecallDone ? '完成' : '未完成'}）`);
            return;
          }
        }
      }

      const reveal = target.closest('[data-kp-reveal]');
      if (reveal) {
        const kpId = reveal.closest('[data-kp-id]')?.getAttribute('data-kp-id') || '';
        if (kpId && !state?.learned?.[kpId]) {
          stop(event);
          setBlockStatus(root, '先完成这个 KP 所属学习节的正式原讲义接触，再 Reveal Core');
          return;
        }
      }

      const rating = target.closest('[data-rating]');
      if (rating) {
        const card = rating.closest('[data-kp-id]');
        const kpId = card?.getAttribute('data-kp-id') || '';
        const stage = card?.closest('[data-study-stage]');
        // A hidden button remains programmatically clickable (including 1–4).
        // Guard before both the study writer and the bubbling evidence writer.
        if (!card || card.hidden || stage?.hidden || stage?.getAttribute('data-study-stage') !== 'kp_recall'
          || card.querySelector('[data-kp-answer]')?.hidden !== false
          || card.querySelector('[data-kp-rating]')?.hidden !== false) {
          stop(event);
          setBlockStatus(root, '先主动回忆并 Reveal 核对，再记录这次回忆质量');
          return;
        }
        if (kpId && !state?.learned?.[kpId]) {
          stop(event);
          setBlockStatus(root, '先完成这个 KP 的正式学习，再记录 Recall');
          return;
        }
      }

      const blockRecallDone = target.closest('[data-block-recall-complete]');
      if (blockRecallDone && (!counts.total || counts.learned < counts.total || counts.recalled < counts.total)) {
        stop(event);
        setBlockStatus(root, `Block Recall 完成证据需先走完正式学习接触 + KP Recall（${counts.learned}/${counts.total} · ${counts.recalled}/${counts.total}）`);
        return;
      }

      const blockComplete = target.closest('[data-block-complete]');
      if (blockComplete) {
        const ready = counts.total > 0 && counts.learned >= counts.total && counts.recalled >= counts.total && Boolean(state?.blockRecallDone);
        if (!ready) {
          stop(event);
          setBlockStatus(root, `Block 完成证据未闭合（学习接触 ${counts.learned}/${counts.total} · Recall ${counts.recalled}/${counts.total} · Block Recall ${state?.blockRecallDone ? '完成' : '未完成'}）`);
          return;
        }
      }
    }, true);
  } else if (blockIds.length) {
    const root = document.querySelector('[data-xizong-system-exit]');
    root?.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;

      const startingRecall = Boolean(target.closest('[data-start-recall]'));
      const revealingRecall = Boolean(target.closest('[data-reveal-recall]'));
      const completingRecall = Boolean(target.closest('[data-complete-recall]'));
      const startingSweep = Boolean(target.closest('[data-start-sweep]'));
      if (!startingRecall && !revealingRecall && !completingRecall && !startingSweep) return;

      const completed = blockIds.filter((id) => Boolean(readBlockState(id)?.completed));
      if (completed.length < blockIds.length) {
        stop(event);
        const status = root.querySelector('[data-recall-status]');
        if (status) {
          status.textContent = startingSweep
            ? `进入系统真题前需先完成整个系统（${completed.length}/${blockIds.length} Blocks），再做当前版本的 System Recall。`
            : `System Recall 只在整个系统真实学完后释放（${completed.length}/${blockIds.length} Blocks）；当前先继续 Block 主线。`;
        }
      }
    }, true);
  }
</script>
