---
import { loadXizongSystemCompletionRequirements } from '../lib/xizongLearnerProjection.mjs';
const { system, block = null } = Astro.props;
const blockId = block?.blockId || '';
const blockIds = (system?.blocks || []).map((row) => row.blockId).filter(Boolean);
const prerequisiteIds = [...new Set([
  ...(block?.sourceContact?.hardReadinessBlockIds || []),
  ...(block?.sourceContact?.requiredPriorBlockIds || [])
].map(String).filter(Boolean))];
const prerequisiteRequirements = block ? loadXizongSystemCompletionRequirements(system, prerequisiteIds) : [];
const blockPrerequisites = prerequisiteIds.map((id) => {
  const row = (system?.blocks || []).find((candidate) => candidate.blockId === id);
  return { blockId: id, label: String(row?.label || id), title: String(row?.title || ''), requirement: prerequisiteRequirements.find(requirement => requirement.identity.blockId === id) || null };
});
const blockingVisualGroups = (block?.logicGroups || [])
  .filter((group) => group?.visualRequired === true && /GAP/i.test(String(group?.visualSourceState || '')))
  .map((group) => ({
    groupId: String(group.groupId || ''),
    label: String(group.label || group.groupId || ''),
    visualSourceState: String(group.visualSourceState || ''),
    reviewableFromOriginalSource: /GAP.*NOT_MOUNTED/i.test(String(group.visualSourceState || ''))
  }));
const requirements = block ? [] : loadXizongSystemCompletionRequirements(system);
---
<span data-xizong-runtime-stage-guard hidden></span>

<script type="application/json" data-xizong-completion-input set:html={JSON.stringify({ blockId, blockIds, blockPrerequisites, blockingVisualGroups, requirements }).replace(/</g, String.fromCharCode(92) + 'u003c')}></script>
<script>
  import { sourceContactCompatible, revisionRequiresAction, needsFreshKpRecall } from '../lib/xizongContentRevision.mjs';
  import { inspectXizongSystemCompletion, inspectXizongBlockCompletion } from '../lib/xizongMemoryAutoRelease.mjs';
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(() => {

  const { blockId, blockIds, blockPrerequisites = [], blockingVisualGroups = [], requirements } = JSON.parse(document.querySelector('[data-xizong-completion-input]')?.textContent || '{}');
  const readBlockState = (id) => {
    if (!id) return {};
    try {
      return JSON.parse(localStorage.getItem(`kianos-xizong-astro-v2:xizong:${id}`) || 'null') || {};
    } catch {
      return {};
    }
  };


  const stop = (event) => {
    event.preventDefault();
    event.stopImmediatePropagation();
  };

  const setBlockStatus = (root, message) => {
    const status = root?.querySelector('[data-study-local-status]');
    if (status) status.textContent = message;
  };

  const blockCounts = (root, state) => {
    const ids = [...(root?.querySelectorAll('[data-kp-recall-card]') || [])].map((card) => card.getAttribute('data-kp-id'));
    const total = ids.length;
    return {
      total,
      learned: ids.filter((id) => state?.learned?.[id] === true).length,
      recalled: ids.filter((id) => ['unknown', 'fuzzy', 'known', 'mastered'].includes(state?.ratings?.[id]) && !needsFreshKpRecall(state, id)).length
    };
  };

  const unresolvedVisualGroups = (root, state) => {
    const sourceHash = root?.getAttribute('data-study-source-hash') || '';
    const evidence = Array.isArray(state?.sourceContactEvidence) ? state.sourceContactEvidence : [];
    return (Array.isArray(blockingVisualGroups) ? blockingVisualGroups : []).filter((row) => {
      if (!row?.reviewableFromOriginalSource) return true;
      return !evidence.some((entry) =>
        sourceContactCompatible(state, entry, sourceHash)
        && (Array.isArray(entry?.visual_reviewed_lg_ids) ? entry.visual_reviewed_lg_ids : []).map(String).includes(String(row.groupId || ''))
      );
    });
  };

  const missingPrerequisites = () => (Array.isArray(blockPrerequisites) ? blockPrerequisites : []).filter((row) => {
    const state = readBlockState(row?.blockId || '');
    return !row.requirement || !inspectXizongBlockCompletion(row.requirement, state).complete;
  });

  // Free navigation among orientation/current-learning surfaces is preserved.
  // Later-stage evidence and answer reveal fail closed until the prerequisite
  // formal learning contact actually exists in browser-local learner state.
  if (blockId) {
    const root = document.querySelector('[data-xizong-v6-block]');
    root?.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;
      if (root.inert || root.dataset.xizongStateBlocked === 'true') { stop(event); return; }

      const state = readBlockState(blockId);
      const postChatRecall = root.dataset.postChatRecallAvailable === 'true'
        && state?.recallEntryMode === 'POST_CHAT_RECALL';
      const counts = blockCounts(root, state);
      const visualBlocked = unresolvedVisualGroups(root, state);
      const missing = missingPrerequisites();
      const advancing = Boolean(target.closest('[data-stage-target],[data-stage-next],[data-post-chat-recall],[data-source-contact-done],[data-enter-group],[data-group-lecture-done],[data-kp-reveal],[data-rating],[data-block-recall-reveal],[data-block-recall-complete],[data-block-complete]'));
      if (missing.length && advancing) {
        stop(event);
        setBlockStatus(root, `先完成前置 Block：${missing.map((row) => row.label || row.blockId).join(' / ')}；当前仍可看本块框架。`);
        return;
      }

      const stageTarget = target.closest('[data-stage-target]');
      if (stageTarget) {
        const requested = stageTarget.getAttribute('data-stage-target') || '';

        if (requested === 'kp_recall' && counts.learned <= counts.recalled && !postChatRecall) {
          stop(event);
          setBlockStatus(root, '先完成当前学习节的原讲义连续学习，再进入本节 Recall');
          return;
        }

        if (requested === 'block_recall' && visualBlocked.length) {
          stop(event);
          setBlockStatus(root, `原图门禁未闭合：${visualBlocked.map((row) => row.label || row.groupId).join(' / ')}；全部 LG 真正闭合前不能进入 Block Recall。`);
          return;
        }
        if (requested === 'block_recall' && (!counts.total || counts.learned < counts.total || counts.recalled < counts.total)) {
          stop(event);
          setBlockStatus(root, `Block Recall 需先闭合全部学习节（学习接触 ${counts.learned}/${counts.total} · Recall ${counts.recalled}/${counts.total}）`);
          return;
        }

        if (requested === 'block_complete') {
          if (visualBlocked.length) {
            stop(event);
            setBlockStatus(root, `原图门禁未闭合：${visualBlocked.map((row) => row.label || row.groupId).join(' / ')}；可以继续 Recall，但不能记为 Block 完成。`);
            return;
          }
          const ready = counts.total > 0 && counts.learned >= counts.total && counts.recalled >= counts.total && (state?.blockRecallDone === true);
          if (!ready) {
            stop(event);
            setBlockStatus(root, `Block 完成证据未闭合（学习接触 ${counts.learned}/${counts.total} · Recall ${counts.recalled}/${counts.total} · Block Recall ${state?.blockRecallDone ? '完成' : '未完成'}）`);
            return;
          }
        }
      }

      const reveal = target.closest('[data-kp-reveal]');
      if (reveal) {
        const card = reveal.closest('[data-kp-id]');
        const kpId = card?.getAttribute('data-kp-id') || '';
        const postChatReveal = postChatRecall && state?.stage === 'kp_recall' && card?.hidden === false;
        if (kpId && !state?.learned?.[kpId] && !postChatReveal) {
          stop(event);
          setBlockStatus(root, '先完成这个 KP 所属学习节的正式原讲义接触，再 Reveal Core');
          return;
        }
      }

      const rating = target.closest('[data-rating]');
      if (rating) {
        const card = rating.closest('[data-kp-recall-card]');
        const kpId = card?.getAttribute('data-kp-id') || '';
        if (!kpId || state?.stage !== 'kp_recall' || card?.hidden || card?.querySelector('[data-kp-answer]')?.hidden !== false || card?.dataset.ratingCommitted === 'true' || (state?.learned?.[kpId] !== true && !postChatRecall)) {
          stop(event);
          setBlockStatus(root, postChatRecall
            ? '先 Reveal 当前 Core，再记录本次 Recall'
            : '先完成对应原讲义接触并 Reveal 当前 Core，再记录本次 Recall');
          return;
        }
      }

      const blockReveal = target.closest('[data-block-recall-reveal]');
      if (blockReveal && visualBlocked.length) {
        stop(event);
        setBlockStatus(root, `原图门禁未闭合：${visualBlocked.map((row) => row.label || row.groupId).join(' / ')}；不能核对整块模型。`);
        return;
      }
      if (blockReveal && (!counts.total || counts.learned < counts.total || counts.recalled < counts.total)) { stop(event); return; }
      const blockRecallDone = target.closest('[data-block-recall-complete]');
      if (blockRecallDone && visualBlocked.length) {
        stop(event);
        setBlockStatus(root, `原图门禁未闭合：${visualBlocked.map((row) => row.label || row.groupId).join(' / ')}；不能记录 Block Recall 完成。`);
        return;
      }
      if (blockRecallDone && root.querySelector('[data-block-recall-answer]')?.hidden !== false) { stop(event); return; }
      if (blockRecallDone && (!counts.total || counts.learned < counts.total || counts.recalled < counts.total)) {
        stop(event);
        setBlockStatus(root, `Block Recall 完成证据需先走完正式学习接触 + KP Recall（${counts.learned}/${counts.total} · ${counts.recalled}/${counts.total}）`);
        return;
      }

      const blockComplete = target.closest('[data-block-complete]');
      if (blockComplete) {
        if (visualBlocked.length) {
          stop(event);
          setBlockStatus(root, `原图门禁未闭合：${visualBlocked.map((row) => row.label || row.groupId).join(' / ')}；可以继续 Recall，但不能记为 Block 完成。`);
          return;
        }
        const ready = counts.total > 0 && counts.learned >= counts.total && counts.recalled >= counts.total && (state?.blockRecallDone === true);
        if (!ready) {
          stop(event);
          setBlockStatus(root, `Block 完成证据未闭合（学习接触 ${counts.learned}/${counts.total} · Recall ${counts.recalled}/${counts.total} · Block Recall ${state?.blockRecallDone ? '完成' : '未完成'}）`);
          return;
        }
      }
    }, true);
  } else if (blockIds.length) {
    const root = document.querySelector('[data-xizong-system-exit]');
    const recallEntry = document.querySelector('[data-xizong-system-recall-entry]');
    const recallLock = document.querySelector('[data-xizong-system-recall-lock]');
    const recallLockStatus = document.querySelector('[data-xizong-system-recall-lock-status]');
    const completedBlocks = () => inspectXizongSystemCompletion(requirements, localStorage);
    const syncSystemRelease = () => {
      const check = completedBlocks();
      const completed = { length: check.completed };
      const ready = check.complete;
      if (recallEntry instanceof HTMLElement) recallEntry.hidden = !ready;
      if (root instanceof HTMLElement) root.hidden = !ready;
      if (recallLock instanceof HTMLElement) recallLock.hidden = ready;
      if (recallLockStatus) {
        recallLockStatus.textContent = `当前已完成 ${completed.length}/${blockIds.length} Blocks。完成整个 System 后，这里会释放 System Recall。`;
      }
      return { completed, ready };
    };

    syncSystemRelease();

    root?.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;

      const startingRecall = Boolean(target.closest('[data-start-recall]'));
      const revealingRecall = Boolean(target.closest('[data-reveal-recall]'));
      const completingRecall = Boolean(target.closest('[data-complete-recall]'));
      const startingSweep = Boolean(target.closest('[data-start-sweep]'));
      if (!startingRecall && !revealingRecall && !completingRecall && !startingSweep) return;

      const { completed, ready } = syncSystemRelease();
      if (!ready) {
        stop(event);
        const status = root.querySelector('[data-recall-status]');
        if (status) {
          status.textContent = startingSweep
            ? `进入系统真题前需先完成整个系统（${completed.length}/${blockIds.length} Blocks），再做当前版本的 System Recall。`
            : `System Recall 只在整个系统真实学完后释放（${completed.length}/${blockIds.length} Blocks）；当前先继续 Block 主线。`;
        }
      }
    }, true);
  }

  });
</script>

