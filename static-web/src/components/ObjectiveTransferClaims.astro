---
const { task = '' } = Astro.props;
---
<span data-objective-transfer-runtime data-transfer-task={task} hidden></span>

<script>
  const STORE_KEY = 'kianos-english-objective-transfer-claims-v1';
  const RETURN_SCHEMA = 'kianos.english.objective_review_return.v1';
  const RETURN_MARKER = 'KIANOS_OBJECTIVE_RETURN_V1';
  const HANDOFF_SCHEMA = 'kianos.english.objective_handoff.v1';
  const VALID_TASKS = new Set(['cloze', 'reading_a', 'reading_b']);
  const VALID_SCOPES = new Set(['local', 'shared', 'coupled', 'structure']);
  const VALID_ROUTES = new Set(['lexical', 'reading', 'cloze', 'reading_a', 'reading_b']);
  const VALID_UPDATE_STATES = new Set(['TRANSFER_PENDING', 'CLOSED', 'REOPENED']);

  const readJson = (key, fallback) => {
    try { return JSON.parse(localStorage.getItem(key) || 'null') || fallback; }
    catch { return fallback; }
  };
  const now = () => new Date().toISOString();
  const makeId = (task, seed = '') => {
    const random = globalThis.crypto?.randomUUID?.() || `${Date.now()}-${Math.random().toString(36).slice(2, 9)}`;
    return `${task}:${seed || 'claim'}:${random}`;
  };
  const normalizeStore = (value = {}) => ({
    version: 1,
    claims: Array.isArray(value.claims) ? value.claims : []
  });
  const readStore = () => normalizeStore(readJson(STORE_KEY, {}));
  const activeClaimsFor = (task) => readStore().claims.filter((claim) => claim?.task === task && claim?.status === 'TRANSFER_PENDING');
  const normalizedStatement = (value) => String(value || '').trim().replace(/\s+/g, ' ').toLowerCase();

  const extractReturn = (text) => {
    const raw = String(text || '').trim();
    if (!raw) return null;
    try {
      const direct = JSON.parse(raw);
      if (direct?.schema === RETURN_SCHEMA) return direct;
    } catch {}

    const marked = raw.match(/KIANOS_OBJECTIVE_RETURN_V1[\s\S]*?```(?:json)?\s*([\s\S]*?)```/i);
    if (marked?.[1]) {
      try {
        const parsed = JSON.parse(marked[1].trim());
        if (parsed?.schema === RETURN_SCHEMA) return parsed;
      } catch {}
    }

    const fenced = [...raw.matchAll(/```(?:json)?\s*([\s\S]*?)```/gi)];
    for (const match of fenced) {
      try {
        const parsed = JSON.parse(String(match?.[1] || '').trim());
        if (parsed?.schema === RETURN_SCHEMA) return parsed;
      } catch {}
    }
    return null;
  };

  const normalizeThread = (thread, index) => {
    if (!thread || typeof thread !== 'object') return null;
    const route = String(thread.route || '').trim();
    if (!VALID_ROUTES.has(route)) return null;
    const scope = VALID_SCOPES.has(String(thread.scope || '')) ? String(thread.scope) : 'local';
    return {
      threadId: String(thread.threadId || `t${index + 1}`),
      scope,
      itemIds: Array.isArray(thread.itemIds) ? thread.itemIds.map(String).filter(Boolean).slice(0, 50) : [],
      route,
      summary: String(thread.summary || '').trim().slice(0, 1200),
      repairCompleted: thread.repairCompleted === true,
      repairEvidence: String(thread.repairEvidence || '').trim().slice(0, 1600)
    };
  };

  document.querySelectorAll('[data-objective-transfer-runtime]').forEach((host) => {
    if (!(host instanceof HTMLElement)) return;
    const task = String(host.getAttribute('data-transfer-task') || '');
    if (!VALID_TASKS.has(task)) return;

    const readingMode = task === 'reading_a';
    const root = readingMode
      ? document.querySelector('[data-local-port="reading"]')
      : document.querySelector(`[data-objective-root][data-objective-task="${CSS.escape(task)}"]`);
    if (!(root instanceof HTMLElement)) return;

    const objectId = readingMode
      ? String(root.getAttribute('data-reading-object') || '')
      : String(root.getAttribute('data-objective-object') || '');
    if (!objectId) return;

    const attemptKey = readingMode
      ? `kianos-reading-attempt-v1:${objectId}`
      : String(root.getAttribute('data-objective-storage-key') || '');
    const reviewKey = `kianos-english-objective-review-return-v1:${task}:${objectId}`;
    const handoffKey = `kianos-english-objective-handoff-v1:${task}:${objectId}`;
    const resultSummary = readingMode
      ? root.querySelector('.portedReadingResultSummary')
      : root.querySelector('[data-objective-result-summary]');
    if (!attemptKey || !(resultSummary instanceof HTMLElement)) return;

    const readAttempt = () => readJson(attemptKey, {});
    const readHandoff = () => {
      const value = readJson(handoffKey, null);
      return value?.schema === HANDOFF_SCHEMA && value?.task === task && value?.objectId === objectId ? value : null;
    };
    const problemCount = (attempt) => {
      const uncertain = new Set(attempt?.uncertain || []);
      return Object.keys(attempt?.results || {}).filter((id) =>
        ['wrong', 'unanswered'].includes(attempt?.results?.[id]) || uncertain.has(id)
      ).length;
    };

    let panel = null;
    const ensurePanel = () => {
      if (panel) return panel;
      panel = document.createElement('section');
      panel.className = 'objectiveTransferPanel';
      panel.hidden = true;
      panel.innerHTML = `
        <div class="objectiveTransferHead">
          <div>
            <span>Evidence / Transfer</span>
            <strong data-transfer-title>Chat 复盘回写</strong>
          </div>
          <button type="button" data-transfer-toggle>导入 Chat 返回</button>
        </div>
        <p data-transfer-summary></p>
        <div data-transfer-claims></div>
        <div data-transfer-import hidden>
          <textarea rows="7" data-transfer-input placeholder="把包含 KIANOS_OBJECTIVE_RETURN_V1 的 Chat 回复粘贴到这里；也可只粘贴 JSON。"></textarea>
          <div class="objectiveTransferActions">
            <button type="button" data-transfer-apply>导入</button>
            <button type="button" data-transfer-cancel>取消</button>
            <small data-transfer-status></small>
          </div>
        </div>`;
      resultSummary.appendChild(panel);
      return panel;
    };

    const render = () => {
      const node = ensurePanel();
      const attempt = readAttempt();
      const pending = activeClaimsFor(task);
      const savedReturn = readJson(reviewKey, null);
      const problems = problemCount(attempt);
      node.hidden = !attempt?.submitted || (!problems && !pending.length && !savedReturn);
      if (node.hidden) return;

      const title = node.querySelector('[data-transfer-title]');
      const summary = node.querySelector('[data-transfer-summary]');
      const list = node.querySelector('[data-transfer-claims]');
      if (title) {
        title.textContent = savedReturn
          ? `Chat 返回已保存 · ${savedReturn.threads?.length || 0} thread`
          : problems
            ? '整篇 / 整组诊断后回写'
            : '待迁移能力验证';
      }
      if (summary) {
        summary.textContent = savedReturn
          ? `本次返回已保存到本机。当前 ${pending.length} 个 task-specific claim 仍待新材料验证。`
          : problems
            ? '先整篇 / 整组诊断并完成真正的最小 repair；只有 repair 后仍值得验证的 task-specific procedure 才进入 pending。'
            : `这次是 clean attempt，但有 ${pending.length} 个 pending claim；只有这份新材料真的测到了它，才更新状态。`;
      }
      if (list) {
        list.replaceChildren();
        pending.slice(0, 6).forEach((claim) => {
          const row = document.createElement('div');
          row.className = 'objectiveTransferClaim';
          const id = document.createElement('span');
          id.textContent = claim.claimId || 'claim';
          const statement = document.createElement('strong');
          statement.textContent = claim.statement || '—';
          row.append(id, statement);
          list.appendChild(row);
        });
        if (pending.length > 6) {
          const more = document.createElement('small');
          more.textContent = `另有 ${pending.length - 6} 个 pending claim`;
          list.appendChild(more);
        }
      }
    };

    const persistPair = (nextStore, nextReview) => {
      const oldStore = localStorage.getItem(STORE_KEY);
      const oldReview = localStorage.getItem(reviewKey);
      try {
        localStorage.setItem(STORE_KEY, JSON.stringify(normalizeStore(nextStore)));
        localStorage.setItem(reviewKey, JSON.stringify(nextReview));
        return true;
      } catch {
        try {
          if (oldStore === null) localStorage.removeItem(STORE_KEY);
          else localStorage.setItem(STORE_KEY, oldStore);
          if (oldReview === null) localStorage.removeItem(reviewKey);
          else localStorage.setItem(reviewKey, oldReview);
        } catch {}
        return false;
      }
    };

    const applyReturn = () => {
      const node = ensurePanel();
      const input = node.querySelector('[data-transfer-input]');
      const status = node.querySelector('[data-transfer-status]');
      const rawInput = input?.value || '';
      const payload = extractReturn(rawInput);
      if (!payload) {
        if (status) status.textContent = `没有读到 ${RETURN_MARKER} / ${RETURN_SCHEMA}`;
        return;
      }
      if (String(payload.task || '') !== task || String(payload.objectId || '') !== objectId) {
        if (status) status.textContent = '返回包 task / objectId 与当前页面不匹配，未导入。';
        return;
      }

      const attempt = readAttempt();
      if (!attempt?.submitted) {
        if (status) status.textContent = '当前作答尚未提交，不能导入学习状态。';
        return;
      }
      const handoff = readHandoff();
      const allowedActive = new Set(Array.isArray(handoff?.activeClaimIds) ? handoff.activeClaimIds.map(String) : []);
      const allowedReopen = new Set(Array.isArray(handoff?.reopenCandidateIds) ? handoff.reopenCandidateIds.map(String) : []);
      const currentProblems = problemCount(attempt);

      const threads = (Array.isArray(payload.threads) ? payload.threads : [])
        .map(normalizeThread)
        .filter(Boolean);
      const store = readStore();
      let claims = store.claims.map((claim) => ({ ...claim }));
      const importedAt = now();
      let acceptedUpdates = 0;
      let acceptedClaims = 0;
      let skipped = 0;

      (Array.isArray(payload.claimUpdates) ? payload.claimUpdates : []).forEach((update) => {
        const claimId = String(update?.claimId || '').trim();
        const requested = String(update?.status || '').toUpperCase();
        const evidence = String(update?.evidence || '').trim().slice(0, 1600);
        if (!claimId || !VALID_UPDATE_STATES.has(requested)) { skipped += 1; return; }
        const index = claims.findIndex((claim) => claim?.claimId === claimId && claim?.task === task);
        if (index < 0) { skipped += 1; return; }
        const claim = claims[index];
        const freshObject = String(claim?.sourceObjectId || '') !== objectId;

        if (requested === 'CLOSED') {
          if (!handoff || !allowedActive.has(claimId) || claim.status !== 'TRANSFER_PENDING' || !freshObject || !evidence) { skipped += 1; return; }
          claims[index] = {
            ...claim,
            status: 'CLOSED',
            history: [...(Array.isArray(claim.history) ? claim.history : []), { objectId, decision: 'CLOSED', evidence, at: importedAt }].slice(-20),
            updatedAt: importedAt
          };
          acceptedUpdates += 1;
          return;
        }

        if (requested === 'REOPENED') {
          if (!handoff || !allowedReopen.has(claimId) || claim.status !== 'CLOSED' || !freshObject || currentProblems <= 0 || !evidence) { skipped += 1; return; }
          claims[index] = {
            ...claim,
            status: 'TRANSFER_PENDING',
            history: [...(Array.isArray(claim.history) ? claim.history : []), { objectId, decision: 'REOPENED', evidence, at: importedAt }].slice(-20),
            updatedAt: importedAt
          };
          acceptedUpdates += 1;
          return;
        }

        if (!handoff || !allowedActive.has(claimId) || claim.status !== 'TRANSFER_PENDING') { skipped += 1; return; }
        claims[index] = {
          ...claim,
          history: evidence
            ? [...(Array.isArray(claim.history) ? claim.history : []), { objectId, decision: 'TRANSFER_PENDING', evidence, at: importedAt }].slice(-20)
            : claim.history,
          updatedAt: importedAt
        };
        acceptedUpdates += 1;
      });

      (Array.isArray(payload.newClaims) ? payload.newClaims : []).forEach((newClaim) => {
        const statement = String(newClaim?.statement || '').trim().slice(0, 1200);
        const sourceThreadId = String(newClaim?.sourceThreadId || '').trim();
        const sourceThread = threads.find((thread) => thread.threadId === sourceThreadId) || null;
        if (!statement || !sourceThread || sourceThread.route !== task || !sourceThread.repairCompleted || !sourceThread.repairEvidence) {
          skipped += 1;
          return;
        }

        const explicitId = String(newClaim?.claimId || '').trim();
        const semanticKey = `${task}\u0000${objectId}\u0000${sourceThreadId}\u0000${normalizedStatement(statement)}`;
        const duplicateIndex = claims.findIndex((claim) => {
          if (explicitId && String(claim?.claimId || '') === explicitId) return true;
          const existingKey = `${claim?.task || ''}\u0000${claim?.sourceObjectId || ''}\u0000${claim?.sourceThreadId || ''}\u0000${normalizedStatement(claim?.statement)}`;
          return existingKey === semanticKey;
        });

        if (duplicateIndex >= 0) {
          const existing = claims[duplicateIndex];
          if (existing.status === 'TRANSFER_PENDING') {
            claims[duplicateIndex] = {
              ...existing,
              statement,
              sourceItemIds: sourceThread.itemIds,
              repairEvidence: sourceThread.repairEvidence,
              updatedAt: importedAt
            };
            acceptedClaims += 1;
          } else {
            skipped += 1;
          }
          return;
        }

        claims.push({
          claimId: explicitId || makeId(task, objectId),
          task,
          statement,
          status: 'TRANSFER_PENDING',
          sourceObjectId: objectId,
          sourceThreadId,
          sourceItemIds: sourceThread.itemIds,
          repairEvidence: sourceThread.repairEvidence,
          createdAt: importedAt,
          updatedAt: importedAt,
          history: []
        });
        acceptedClaims += 1;
      });

      const activeClaims = claims.filter((claim) => claim?.status === 'TRANSFER_PENDING');
      const inactiveClaims = claims
        .filter((claim) => claim?.status !== 'TRANSFER_PENDING')
        .sort((a, b) => String(b?.updatedAt || '').localeCompare(String(a?.updatedAt || '')))
        .slice(0, 240);
      claims = [...inactiveClaims, ...activeClaims];

      const nextReview = {
        schema: RETURN_SCHEMA,
        task,
        objectId,
        threads,
        importedAt,
        acceptedUpdates,
        acceptedClaims,
        skipped
      };
      if (!persistPair({ version: 1, claims }, nextReview)) {
        if (status) status.textContent = '本机保存失败，未完成导入；你的粘贴内容已保留，可以重试。';
        return;
      }

      if (input) input.value = '';
      const importBox = node.querySelector('[data-transfer-import]');
      if (importBox instanceof HTMLElement) importBox.hidden = true;
      if (status) status.textContent = `已导入：${acceptedClaims} 个新 pending claim，${acceptedUpdates} 个状态更新；${skipped} 项因证据不足或不匹配被忽略。`;
      root.dispatchEvent(new CustomEvent('kianos:objective-transfer-updated', { bubbles: true }));
      render();
    };

    const node = ensurePanel();
    node.querySelector('[data-transfer-toggle]')?.addEventListener('click', () => {
      const box = node.querySelector('[data-transfer-import]');
      if (box instanceof HTMLElement) box.hidden = !box.hidden;
    });
    node.querySelector('[data-transfer-cancel]')?.addEventListener('click', () => {
      const box = node.querySelector('[data-transfer-import]');
      if (box instanceof HTMLElement) box.hidden = true;
    });
    node.querySelector('[data-transfer-apply]')?.addEventListener('click', applyReturn);

    if (readingMode) {
      root.addEventListener('click', () => window.setTimeout(render, 0));
    } else {
      root.addEventListener('kianos:objective-submitted', render);
      root.addEventListener('click', () => window.setTimeout(render, 0));
    }
    window.addEventListener('storage', (event) => {
      if (event.key === STORE_KEY || event.key === reviewKey || event.key === handoffKey) render();
    });
    render();
  });
</script>

<style>
  .objectiveTransferPanel{display:grid;gap:8px;margin-top:10px;padding:11px 12px;border:1px solid var(--study-line);border-radius:10px;background:color-mix(in srgb,var(--study-green-soft) 58%,#fff)}.objectiveTransferHead{display:flex;align-items:center;justify-content:space-between;gap:12px}.objectiveTransferHead>div{display:grid;gap:2px}.objectiveTransferHead span{color:var(--study-green);font-size:9px;font-weight:850;letter-spacing:.06em;text-transform:uppercase}.objectiveTransferHead strong{font-size:12px}.objectiveTransferHead button,.objectiveTransferActions button{padding:7px 10px;border:1px solid var(--study-line);border-radius:8px;background:#fff;font:inherit;font-size:10px;font-weight:750;cursor:pointer}.objectiveTransferPanel>p{margin:0;color:var(--study-muted);font-size:10px;line-height:1.6}.objectiveTransferClaim{display:grid;grid-template-columns:minmax(88px,.28fr) minmax(0,1fr);gap:8px;padding:6px 0;border-top:1px solid var(--study-line)}.objectiveTransferClaim span{color:var(--study-faint);font-size:8px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.objectiveTransferClaim strong{font-size:10px;line-height:1.45}.objectiveTransferPanel textarea{width:100%;box-sizing:border-box;resize:vertical;padding:9px;border:1px solid var(--study-line);border-radius:8px;background:#fff;font:inherit;font-size:10px;line-height:1.5}.objectiveTransferActions{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:6px}.objectiveTransferActions small{color:var(--study-muted);font-size:9px;line-height:1.45}@media(max-width:700px){.objectiveTransferHead{align-items:flex-start;flex-direction:column}.objectiveTransferClaim{grid-template-columns:1fr}}
</style>