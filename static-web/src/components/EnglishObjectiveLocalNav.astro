---
const { active = 'reading' } = Astro.props;
const base = import.meta.env.BASE_URL;
const items = [
  { key: 'reading', label: 'Reading A', href: `${base}reading/` },
  { key: 'cloze', label: 'Cloze', href: `${base}cloze/` },
  { key: 'part-b', label: 'Part B', href: `${base}reading-b/` }
];
---
<nav class="englishObjectiveLocalNav" aria-label="Objective local navigation">
  {items.map((item) => (
    <a
      class={active === item.key ? 'active' : ''}
      href={item.href}
      aria-current={active === item.key ? 'page' : undefined}
    >
      {item.label}
    </a>
  ))}
</nav>

<style>
  .englishObjectiveLocalNav{
    display:flex;
    align-items:center;
    gap:20px;
    width:min(1180px,100%);
    margin:0 auto 12px;
    min-height:38px;
    border-bottom:1px solid var(--study-line);
    font-family:var(--study-font-cjk);
  }
  .englishObjectiveLocalNav a{
    position:relative;
    display:inline-flex;
    align-items:center;
    min-height:38px;
    color:var(--study-muted);
    font-size:16px;
    font-weight:650;
    line-height:1;
    text-decoration:none;
    white-space:nowrap;
  }
  .englishObjectiveLocalNav a:hover{color:var(--study-ink)}
  .englishObjectiveLocalNav a.active{
    color:var(--study-ink);
    font-weight:700;
  }
  .englishObjectiveLocalNav a.active::after{
    content:'';
    position:absolute;
    right:0;
    bottom:-1px;
    left:0;
    height:2px;
    background:currentColor;
  }
  @media(max-width:700px){
    .englishObjectiveLocalNav{gap:14px;overflow-x:auto}
    .englishObjectiveLocalNav a{font-size:15px}
  }
</style>
