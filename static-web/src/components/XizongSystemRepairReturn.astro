---
const { system } = Astro.props;
const base = import.meta.env.BASE_URL;
const routes = Object.fromEntries((system?.blocks || []).map((block) => [block.blockId, {
  label: block.label,
  title: block.title,
  href: `${base}xizong/${system.systemId}/${block.slug}/`
}]));
const routePayload = JSON.stringify(routes).replace(/</g, '\u003c');
---
<details class="xrr" data-xizong-repair-return={system.systemId} data-practice-href={`${base}xizong/practice/${system.systemId}/`}>
  <summary>
    <span>Wrong / Uncertain 修补</span>
    <strong>Chat 修完后回到对应 Block，再继续真题</strong>
    <small>只走审核过的精确回链；没有就不猜。</small>
  </summary>
  <div class="xrrBody">
    <p>需要集中修补时，用这里把当前 Wrong / Uncertain 交给 Chat。返回计划只接受本轮真实题号；能精确回链的任务会进入 Memory · Repair，并保留对应 Block/KP 回链。原始 Recall 不会被覆盖。</p>
    <div class="xrrActions">
      <button type="button" data-copy-chat>复制 W/U + 返回格式给 Chat</button>
      <button type="button" class="secondary" data-return-sweep>回到当前真题</button>
    </div>
    <label>
      <span>粘贴 typed Chat Return（仅作为故障 fallback）</span>
      <textarea rows="6" data-plan-text placeholder='{"schema":"kianos.xizong.system_wu_return.v1","return_id":"...","system_id":"...","decision":"REPAIR","plan":[{"question_id":"...","status":"wrong","attempt_id":"...","submitted_at":"...","round_id":"...","reason":"...","action":"...","priority":"high"}]}'></textarea>
    </label>
    <div class="xrrApplyRow">
      <button type="button" data-apply-plan>导入 typed Return</button>
      <small data-plan-status>尚未导入。</small>
    </div>
    <div class="xrrList" data-plan-list></div>
  </div>
  <script type="application/json" data-block-routes set:html={routePayload}></script>
</details>

<script>
  import {
    XIZONG_SYSTEM_WU_RETURN_SCHEMA,
    applyXizongSystemWuReturn,
    consumePendingXizongSystemWuReturn,
    currentXizongSystemWuEvidence,
    readXizongSystemWuPendingState
  } from '../lib/xizongSystemWuReturn.mjs';
  import { studyDayAt } from '../lib/studyTimer.mjs';

  const root = document.querySelector('[data-xizong-repair-return]');
  if (root instanceof HTMLElement) {
    const systemId = root.getAttribute('data-xizong-repair-return') || '';
    const repairKey = `kianos:xizong:system-repair-return:${systemId}:v1`;
    const practiceHref = root.getAttribute('data-practice-href') || '';
    const status = root.querySelector('[data-plan-status]');
    const list = root.querySelector('[data-plan-list]');
    let routes = {};
    let data = null;
    try { routes = JSON.parse(root.querySelector('[data-block-routes]')?.textContent || '{}'); } catch {}
    try { data = JSON.parse(document.querySelector('[data-sweep-payload]')?.textContent || 'null'); } catch {}
    const questions = Array.isArray(data?.questions) ? data.questions : [];
    const questionById = new Map(questions.map((q) => [String(q?.questionId || ''), q]).filter(([id]) => id));

    const currentWu = () => {
      try {
        return currentXizongSystemWuEvidence(localStorage, systemId, questions)
          .map((evidence) => ({ evidence, question: questionById.get(evidence.question_id) || null }))
          .filter((row) => row.question);
      } catch {
        return [];
      }
    };

    const render = (plan = [], repairTasks = [], unmapped = []) => {
      if (!list) return;
      list.replaceChildren();
      const taskByQuestion = new Map();
      for (const task of repairTasks || []) {
        for (const questionId of task?.sourceQuestionIds || []) taskByQuestion.set(questionId, task);
      }
      const unmappedSet = new Set(unmapped || []);

      for (const row of plan || []) {
        const q = questionById.get(String(row?.question_id || ''));
        if (!q) continue;
        const task = taskByQuestion.get(q.questionId) || null;
        const article = document.createElement('article');
        const head = document.createElement('div');
        const title = document.createElement('strong');
        title.textContent = `${q.year} · 第 ${q.number} 题`;
        const badge = document.createElement('span');
        badge.textContent = String(row?.status || '').toLowerCase() === 'wrong' ? 'Wrong' : 'Uncertain';
        head.append(title, badge);

        const body = document.createElement('p');
        body.textContent = [row?.action, row?.reason].filter(Boolean).join(' · ') || '按 Chat 计划做最小修补。';
        article.append(head, body);

        const meta = document.createElement('small');
        if (task) {
          meta.textContent = `已加入 Memory · Repair，并保留 ${task.blockId} · ${task.kpId} 的审核回链。`;
          const link = document.createElement('a');
          link.href = task.blockHref || '#';
          link.target = '_blank';
          link.rel = 'noopener';
          link.textContent = '去对应 Block 修补 ↗';
          article.append(meta, link);
        } else if (unmappedSet.has(q.questionId)) {
          meta.textContent = '当前没有审核过的精确 Block/KP 回链：保留题号，不自动猜。';
          article.append(meta);
        } else {
          meta.textContent = '当前未生成 Repair。';
          article.append(meta);
        }
        list.appendChild(article);
      }
    };

    const applyTypedReturn = (value) => applyXizongSystemWuReturn(localStorage, value, {
      questions,
      routes,
      practiceHref,
      now: Date.now()
    });

    const consumePending = () => {
      try {
        const pending = readXizongSystemWuPendingState(localStorage)?.pending_by_system?.[systemId];
        if (!pending) return { status:'no_pending' };
        const result = consumePendingXizongSystemWuReturn(localStorage, {
          systemId,
          questions,
          routes,
          practiceHref,
          now: Date.now(),
          expectedDay: studyDayAt(Date.now())
        });
        const receipt = result?.receipt || null;
        if (receipt?.status === 'APPLIED' || receipt?.status === 'ALREADY_APPLIED') {
          const count = receipt.repair_tasks?.length || 0;
          const unmapped = receipt.unmapped_question_ids?.length || 0;
          if (status) status.textContent = count
            ? `Chat Return 已按当前 W/U 安全应用：生成 ${count} 个 Repair${unmapped ? `；另有 ${unmapped} 题无审核回链，未猜映射` : ''}。`
            : unmapped
              ? `Chat Return 已核对；${unmapped} 题暂无审核回链，没有自动猜 Repair。`
              : 'Chat Return 已核对；当前无需建立 Repair。';
          render(result?.apply_result?.return_packet?.plan || pending.return_packet?.plan || [],
            result?.apply_result?.repair_tasks || [],
            receipt.unmapped_question_ids || []);
        } else if (receipt?.status === 'STALE') {
          if (status) status.textContent = '这份 W/U Return 对应的作答已经变化；未建立 Repair，等待 Chat 按最新 evidence 重判。';
        } else if (receipt?.status === 'REJECTED') {
          if (status) status.textContent = 'W/U Return 未通过当前题目/映射校验；学习状态没有被改动。';
        }
        window.dispatchEvent(new CustomEvent('kianos:xizong-system-wu-return-consumed', {
          detail: {
            system_id: systemId,
            return_id: receipt?.return_id || '',
            status: receipt?.status || ''
          }
        }));
        return result;
      } catch {
        if (status) status.textContent = '待处理 W/U Return 无法安全读取；原学习状态未改动。';
        return { status:'error' };
      }
    };

    root.querySelector('[data-copy-chat]')?.addEventListener('click', async (event) => {
      const wu = currentWu();
      const packet = {
        schema: 'kianos.xizong.system_wu_repair_handoff.v2',
        system: {
          system_id: data?.systemId || systemId,
          canonical_id: data?.canonicalId || '',
          title: data?.title || ''
        },
        wrong_uncertain: wu.map(({ question, evidence }) => ({
          ...evidence,
          year: question.year,
          number: question.number,
          learner_answer: (() => {
            try {
              const sweep = JSON.parse(localStorage.getItem(`kianos:xizong:system-question-sweep:${systemId}:v1`) || 'null');
              return sweep?.results?.[question.questionId]?.selected || [];
            } catch { return []; }
          })(),
          correct_answer: question.correctAnswer,
          stem: question.stem,
          explanation: question.explanation
        })),
        return_contract: {
          schema: XIZONG_SYSTEM_WU_RETURN_SCHEMA,
          system_id: systemId,
          decision: 'NO_ACTION | REPAIR',
          rule: 'Echo exact question_id/status/attempt_id/submitted_at/round_id from wrong_uncertain. Do not return Block/KP mapping; KianOS uses only current reviewed relations.'
        }
      };
      const text = JSON.stringify(packet, null, 2);
      const button = event.currentTarget;
      try {
        await navigator.clipboard.writeText(text);
        const old = button.textContent;
        button.textContent = '已复制，粘给 Chat';
        setTimeout(() => { button.textContent = old; }, 1600);
      } catch { window.prompt('复制给 Chat', text); }
    });

    root.querySelector('[data-apply-plan]')?.addEventListener('click', () => {
      const text = root.querySelector('[data-plan-text]')?.value || '';
      try {
        const parsed = JSON.parse(text);
        if (parsed?.schema !== XIZONG_SYSTEM_WU_RETURN_SCHEMA) {
          throw new Error('Typed System W/U Return required');
        }
        const result = applyTypedReturn(parsed);
        const receipt = result.receipt || {};
        const count = result.repair_tasks?.length || 0;
        const unmapped = receipt.unmapped_question_ids?.length || 0;
        if (status) status.textContent = count
          ? `已安全导入 ${count} 个 Repair${unmapped ? `；${unmapped} 题无审核回链，未猜映射` : ''}。`
          : unmapped
            ? `已核对；${unmapped} 题没有审核回链，未建立 Repair。`
            : '已核对；当前无需 Repair。';
        render(result.return_packet?.plan || [], result.repair_tasks || [], receipt.unmapped_question_ids || []);
      } catch {
        if (status) status.textContent = 'Return 无效、作答已变化，或未能安全保存；没有应用本次计划。';
      }
    });

    root.querySelector('[data-return-sweep]')?.addEventListener('click', () => {
      document.querySelector('[data-question-workspace]')?.scrollIntoView({ behavior:'smooth', block:'start' });
    });

    window.addEventListener('kianos:private-control-consumed', (event) => {
      const detail = event instanceof CustomEvent ? event.detail : null;
      if (detail?.fresh !== true || detail?.target !== 'xizong.system_wu_return') return;
      if (!['APPLIED','IDEMPOTENT'].includes(String(detail?.status || ''))) return;
      window.setTimeout(consumePending, 0);
    });

    const saved = (() => {
      try { return JSON.parse(localStorage.getItem(repairKey) || 'null'); } catch { return null; }
    })();
    if (saved?.return_packet?.plan?.length) {
      if (status) status.textContent = `已保存 ${saved.return_packet.plan.length} 个 W/U 诊断项。`;
      render(saved.return_packet.plan, [], saved.unmapped_question_ids || []);
    }

    // Run after synchronous SystemEvidenceGuard setup. If Current evidence is stale,
    // the guard reloads first and this callback never applies the old W/U Return.
    window.setTimeout(consumePending, 0);
  }
</script>
