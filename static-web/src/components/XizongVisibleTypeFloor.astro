---
<span hidden data-xizong-visible-type-floor></span>

<style is:global>
  @media (min-width:1101px) and (min-height:680px) {
    /* Current UI preference: default-visible learner text must stay comfortably readable.
       Preserve Dense Calm through hierarchy, spacing, local scrolling and tone — not tiny type. */
    body#kianos-workspace.surfaceBody-xizong .xv6BlockWorkspaceShell :is(
      p,
      li,
      td,
      th,
      figcaption
    ) {
      font-size: max(16px, 1em) !important;
    }

    body#kianos-workspace.surfaceBody-xizong .xv6BlockWorkspaceShell :is(
      span,
      small,
      b,
      strong,
      em,
      label,
      button,
      summary,
      code,
      kbd
    ) {
      font-size: max(15px, 1em) !important;
    }

    body#kianos-workspace.surfaceBody-xizong .xv6BlockWorkspaceShell .xv6KpLearnPrompt p,
    body#kianos-workspace.surfaceBody-xizong .xv6BlockWorkspaceShell .xv6KpLearnCore :is(p,li,td,th),
    body#kianos-workspace.surfaceBody-xizong .xv6BlockWorkspaceShell [data-kp-answer] :is(p,li,td,th),
    body#kianos-workspace.surfaceBody-xizong .xv6BlockWorkspaceShell .xv6LearnerAsset p,
    body#kianos-workspace.surfaceBody-xizong .xv6BlockWorkspaceShell .xv6LogicGoal,
    body#kianos-workspace.surfaceBody-xizong .xv6BlockWorkspaceShell .xv6LogicTarget p {
      font-size: max(16px, 1em) !important;
    }
  }
</style>
