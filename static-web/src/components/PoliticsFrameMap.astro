---
// Presentation of an already-selected Current map. No semantic inference.
const { value } = Astro.props;
const nodes = Array.isArray(value?.nodes) ? value.nodes : [];
const edges = Array.isArray(value?.edges) ? value.edges : [];
const byId = new Map(nodes.map(node => [node.id, node]));
if (byId.size !== nodes.length || edges.some(edge => !byId.has(edge.from) || !byId.has(edge.to))) throw new Error('POLITICS_MAP_INVALID_ENDPOINTS');
const incoming = new Map(nodes.map(node => [node.id, 0]));
const levels = new Map(nodes.map(node => [node.id, 0]));
for (const edge of edges) incoming.set(edge.to, incoming.get(edge.to) + 1);
const queue = nodes.filter(node => incoming.get(node.id) === 0).map(node => node.id);
let visited = 0;
while (queue.length) {
  const id = queue.shift(); visited++;
  for (const edge of edges.filter(edge => edge.from === id)) {
    levels.set(edge.to, Math.max(levels.get(edge.to), levels.get(id) + 1));
    incoming.set(edge.to, incoming.get(edge.to) - 1);
    if (incoming.get(edge.to) === 0) queue.push(edge.to);
  }
}
const acyclic = visited === nodes.length;
const ranks = acyclic ? [...new Set(levels.values())].sort((a,b) => a-b) : [0];
const heading = value.title || value.name || value.label;
---
<section class="frameMap" data-frame-map data-map-node-count={nodes.length} data-map-edge-count={edges.length}>
  {heading && <h3>{heading}</h3>}
  <div class="frameGraph" data-frame-graph data-acyclic={String(acyclic)} style={`--graph-ranks:${ranks.length}`}>
    {acyclic && <svg class="frameGraphSvg" data-graph-svg aria-hidden="true" focusable="false"></svg>}
    {ranks.map(rank => {
      const group = acyclic ? nodes.filter(node => levels.get(node.id) === rank) : nodes;
      return <div class="frameGraphRank" data-graph-rank={rank} data-single={String(group.length===1)} style={`--rank-count:${group.length}`}>
        {group.map(node => <article class="frameGraphNode" data-graph-node={node.id}>
          <strong>{node.label}</strong>
          {edges.some(edge => edge.from === node.id) && <div class="frameGraphRelations">
            {edges.filter(edge => edge.from === node.id).map(edge => <p data-graph-edge data-from={edge.from} data-to={edge.to}>
              <span data-graph-relation>{edge.relation}</span><span aria-hidden="true"> → </span><strong>{byId.get(edge.to).label}</strong>
            </p>)}
          </div>}
        </article>)}
      </div>;
    })}
  </div>
  {/* Complete meaning stays visible; long prose must not set connector height. */}
  <div class="frameGraphNotes" aria-label="关系图的完整含义">
    {nodes.filter(node=>node.meaning||node.detail).map(node=><section data-graph-note={node.id}>
      <h4>{node.label}</h4>
      {node.meaning && <p>{node.meaning}</p>}
      {node.detail && <p>{node.detail}</p>}
    </section>)}
  </div>
</section>
<script>
  const ns = 'http://www.w3.org/2000/svg';
  document.querySelectorAll('[data-frame-graph]').forEach(graph => {
    if (!(graph instanceof HTMLElement)) return;
    const svg = graph.querySelector('[data-graph-svg]');
    if (!(svg instanceof SVGElement)) { graph.dataset.graphReady = 'text'; return; }
    let pending = 0;
    const draw = () => {
      pending = 0;
      const box = graph.getBoundingClientRect();
      if (!box.width || !box.height) return;
      svg.replaceChildren();
      if (window.innerWidth <= 700) { graph.dataset.graphReady = 'text'; return; }
      svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
      // Centered vertical ranks have different left offsets. Their offset is
      // NOT evidence of a horizontal graph; use the actual grid tracks.
      const horizontal = getComputedStyle(graph).gridTemplateColumns.trim().split(/\s+/).length > 1;
      const positions = new Map([...graph.querySelectorAll('[data-graph-node]')].map(node => [node.getAttribute('data-graph-node'), {box:node.getBoundingClientRect(),rank:Number(node.closest('[data-graph-rank]').getAttribute('data-graph-rank'))}]));
      graph.querySelectorAll('[data-graph-edge]').forEach(edge => {
        const from = positions.get(edge.getAttribute('data-from'));
        const to = positions.get(edge.getAttribute('data-to'));
        if (!from || !to) return;
        const source=from.box,target=to.box;
        const sx = (horizontal ? source.right + 1 : source.left + source.width / 2) - box.left;
        const sy = (horizontal ? source.top + source.height / 2 : source.bottom + 1) - box.top;
        const tx = (horizontal ? target.left - 3 : target.left + target.width / 2) - box.left;
        const ty = (horizontal ? target.top + target.height / 2 : target.top - 3) - box.top;
        const path = document.createElementNS(ns, 'path');
        const mid = horizontal ? (sx + tx) / 2 : (sy + ty) / 2;
        // A direct edge that skips a rank must not pass through an unrelated
        // intermediate node and visually imply an extra semantic dependency.
        const skipping = to.rank-from.rank > 1;
        const d = skipping ? (horizontal
          ? `M ${sx} ${sy} L ${sx+16} ${sy} L ${sx+16} -12 L ${tx-16} -12 L ${tx-16} ${ty} L ${tx} ${ty}`
          : `M ${sx} ${sy} L ${sx} ${sy+16} L -12 ${sy+16} L -12 ${ty-16} L ${tx} ${ty-16} L ${tx} ${ty}`)
          : (horizontal ? `M ${sx} ${sy} C ${mid} ${sy}, ${mid} ${ty}, ${tx} ${ty}` : `M ${sx} ${sy} C ${sx} ${mid}, ${tx} ${mid}, ${tx} ${ty}`);
        path.setAttribute('d',d);path.setAttribute('data-edge-path','');path.setAttribute('data-from',edge.getAttribute('data-from'));path.setAttribute('data-to',edge.getAttribute('data-to'));path.setAttribute('data-rank-skip',String(skipping));
        const arrow = document.createElementNS(ns, 'path');
        arrow.setAttribute('d', horizontal ? `M ${tx} ${ty} l -7 -4 v 8 z` : `M ${tx} ${ty} l -4 -7 h 8 z`);
        arrow.setAttribute('fill','#658c79');svg.append(path,arrow);
      });
      graph.dataset.graphReady='true';graph.dataset.graphDirection=horizontal?'horizontal':'vertical';
    };
    const schedule = () => { if (!pending) pending = requestAnimationFrame(draw); };
    const observer = new ResizeObserver(schedule);observer.observe(graph);
    graph.querySelectorAll('[data-graph-node]').forEach(node=>observer.observe(node));
    const scope=graph.closest('[data-politics-frame]');
    if(scope)new MutationObserver(schedule).observe(scope,{subtree:true,attributes:true,attributeFilter:['hidden']});
    window.addEventListener('resize',schedule);document.fonts.ready.then(schedule);schedule();
  });
</script>
<style is:global>
:root body.surfaceBody-politics #main-content .frameCognition:has([data-frame-map]){grid-template-columns:1fr}
:root body.surfaceBody-politics #main-content .frameCognition:has([data-frame-map])>.frameCompanion{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:28px;border-left:0;border-top:1px solid var(--study-line);padding:24px 0 0}
:root body.surfaceBody-politics #main-content .frameCognition:has([data-frame-map])>.frameCompanion section+section{margin-top:0}
:root body.surfaceBody-politics #main-content .frameGraphNotes{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:20px 30px;margin-top:28px;padding-top:20px;border-top:1px solid var(--study-line)}
:root body.surfaceBody-politics #main-content .frameGraphNotes h4{font-size:20px;font-weight:700;margin:0 0 8px}
:root body.surfaceBody-politics #main-content .frameGraphNotes p{font-size:19px;line-height:1.8}
:root body.surfaceBody-politics #main-content .frameGraphRelations{font-size:17px;line-height:1.7}
</style>
