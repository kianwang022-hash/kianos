---
---
<span data-xizong-block-workspace-shell hidden></span>

<script>
  const root = document.querySelector('[data-xizong-v6-block]');
  const rail = root?.querySelector('.portedStudyChain');

  if (root instanceof HTMLElement && rail instanceof HTMLElement) {
    root.classList.add('xv6BlockWorkspaceShell');
    rail.dataset.xizongAuxRail = '';
    if (!root.dataset.auxWeight) root.dataset.auxWeight = 'none';

    const outlineToggle = root.querySelector('[data-toggle-outline]');
    const auxToggle = root.querySelector('[data-toggle-chain]');
    if (outlineToggle) outlineToggle.textContent = 'Logic Map';
    if (auxToggle) auxToggle.textContent = '辅助';

    const railHeader = rail.querySelector(':scope > header');
    if (railHeader instanceof HTMLElement) {
      const kicker = railHeader.querySelector(':scope > span');
      const title = railHeader.querySelector(':scope > strong');
      if (kicker) kicker.textContent = 'Attention';
      if (title) title.textContent = '本轮注意力';
    }

    const stages = [...root.querySelectorAll('[data-study-stage]')];
    const syncStage = () => {
      const active = stages.find((node) => !node.hasAttribute('hidden'));
      root.dataset.workspaceStage = active?.getAttribute('data-study-stage') || 'block_learn';
    };
    const observer = new MutationObserver(syncStage);
    stages.forEach((stage) => observer.observe(stage, { attributes: true, attributeFilter: ['hidden'] }));
    syncStage();
  }
</script>

