---
const { b1, html } = Astro.props;
const title = String(b1?.title || 'B1').replace(/^B1\s*[·｜|]\s*/, '');
const kps = b1?.kpRecords || [];
const sections = b1?.sections || [];
---
<section class="portedStudyRuntime portedStudyRuntimeV2" data-local-port="study-runtime" data-study-object={b1.objectId}>
  <header class="portedStudyHeader">
    <div class="portedStudyContextRow">
      <a href="/">‹ 循环系统</a>
      <span>循环系统 › B1</span>
      <div class="portedStudyShellActions">
        <button type="button" data-toggle-outline aria-pressed="false">目录</button>
        <button type="button" data-toggle-chain aria-pressed="false">学习链</button>
      </div>
    </div>
    <div class="portedStudyIdentity">
      <div>
        <span data-study-context-label>西医综合 · Block 1 · Learn · Block 初识</span>
        <h2>{title}</h2>
      </div>
      <div class="portedStudyIdentityMeta">
        <strong data-study-local-status>本机进度 0/{kps.length}</strong>
        <small>Canonical read-only · learner state local-only</small>
      </div>
    </div>
    <nav class="portedStudyTabs" aria-label="Block workspace">
      <button type="button" class="active" data-study-tab="learn">Learn</button>
      <button type="button" data-study-tab="outline">Outline</button>
      <span aria-disabled="true" title="待接 Current Memory surface">Memory</span>
      <span aria-disabled="true" title="待接 Current Review surface">Review</span>
    </nav>
  </header>

  <div class="portedStudyLayout" data-study-layout>
    <aside class="portedStudyOutline" id="content-map">
      <header><span data-study-rail-kicker>Block Map</span><strong data-study-rail-title>连续学习</strong></header>
      <nav data-study-section-rail aria-label="当前 Block 内容导航">
        {sections.map((section, index) => <button type="button" data-section-target={index}><b>{String(index + 1).padStart(2, '0')}</b><span>{section.title}</span><small>{section.kpIds.length} KP</small></button>)}
      </nav>
      <nav class="portedStudyKpRail" data-study-kp-rail aria-label="KP navigation" hidden>
        {kps.map((kp, index) => <button type="button" data-kp-target={index}><b>{kp.kpId}</b><span>{kp.title}</span><small data-kp-state={kp.kpId}>未记录</small></button>)}
      </nav>
      <footer>导航完全由当前 B1 标题与 KP 标记机械生成；不维护第二份知识内容。</footer>
    </aside>

    <main class="portedStudyMain" id="canonical-content">
      <section data-study-panel="learn">
        <section data-study-stage="block_learn">
          <div class="portedStudyLead"><span>Learn · Block 初识</span><strong>先回答这一块解决什么问题，再进入 KP 连续精学。</strong></div>
          <article class="portedStudyArticle portedStudyOrientation markdown" set:html={b1.orientationHtml}></article>
          <footer class="portedStudyStageAction"><span>这里只记录你已经完成本层定位，不代表掌握。</span><button type="button" class="portedPrimaryAction" data-stage-next="kp_learn">进入 KP 精学</button></footer>
        </section>

        <section class="portedKpWorkspace" data-study-stage="kp_learn" hidden>
          <header class="portedKpWorkspaceHeader">
            <div><span>Learn · KP 精学</span><strong data-kp-learn-title>{kps[0]?.kpId} · {kps[0]?.title}</strong></div>
            <div><button type="button" data-kp-prev>‹</button><em data-kp-counter>1 / {kps.length}</em><button type="button" data-kp-next>›</button></div>
          </header>
          <div class="portedKpCards">
            {kps.map((kp, index) => <article class="portedKpCard" data-kp-learn-card={index} hidden={index !== 0}>
              <header><span>{kp.groupTitle || 'B1'}</span><h3>{kp.kpId}｜{kp.title}</h3>{kp.prompt && <p>{kp.prompt}</p>}</header>
              <div class="portedKpCanonical markdown" set:html={kp.detailHtml}></div>
              <footer><span>Current canonical · {kp.kpId}</span><button type="button" data-kp-learned={kp.kpId}>本 KP 已精学</button></footer>
            </article>)}
          </div>
        </section>

        <section class="portedTtsxUnavailable" data-study-stage="ttsx" hidden>
          <span>Learn · 配套题</span>
          <h3>回到原讲义完成配套题</h3>
          <p>当前 B1 Current Markdown 没有暴露可验证的题组 / 页码绑定，因此 Astro 不补造题目，也不把“看过页面”写成题目完成。</p>
          <button type="button" data-stage-next="kp_recall">继续进入 KP Recall</button>
        </section>

        <section class="portedKpWorkspace recall" data-study-stage="kp_recall" hidden>
          <header class="portedKpWorkspaceHeader">
            <div><span>Recall · KP</span><strong data-kp-recall-title>{kps[0]?.kpId} · {kps[0]?.title}</strong></div>
            <div><button type="button" data-recall-prev>‹</button><em data-recall-counter>1 / {kps.length}</em><button type="button" data-recall-next>›</button></div>
          </header>
          <div class="portedKpCards">
            {kps.map((kp, index) => <article class="portedKpRecallCard" data-kp-recall-card={index} data-kp-id={kp.kpId} hidden={index !== 0}>
              <header><span>{kp.groupTitle || 'B1'}</span><h3>{kp.kpId}｜{kp.title}</h3>{kp.prompt && <p>{kp.prompt}</p>}</header>
              <div class="portedRecallPrompt"><strong>先在脑内恢复，再打开 Core。</strong><button type="button" data-kp-reveal>Reveal Core</button></div>
              <div class="portedRecallAnswer markdown" data-kp-answer hidden set:html={kp.detailHtml}></div>
              <footer class="portedRecallRating" data-kp-rating hidden>
                <span>这次回忆质量</span>
                <div>
                  <button type="button" data-rating="unknown">1 · 没记住</button>
                  <button type="button" data-rating="fuzzy">2 · 模糊</button>
                  <button type="button" data-rating="known">3 · 会了</button>
                  <button type="button" data-rating="mastered">4 · 稳定</button>
                </div>
              </footer>
            </article>)}
          </div>
        </section>

        <section class="portedBlockRecall" data-study-stage="block_recall" hidden>
          <header><span>Recall · Block</span><h3>先恢复整块，再按 section 核对</h3><p>{b1.centerQuestion}</p></header>
          <div>{sections.map((section) => <details><summary><strong>{section.title}</strong><small>{section.kpIds.join(' · ')}</small></summary><div class="markdown" set:html={section.html}></div></details>)}</div>
          <footer><span>展开核对不会自动算完成。</span><button type="button" data-block-recall-complete>确认本轮 Block Recall 已完成</button></footer>
        </section>

        <section class="portedBlockComplete" data-study-stage="block_complete" hidden>
          <span>Learn · Block 完成</span><h3 data-block-complete-title>还没有满足本机 First-Pass 检查点</h3>
          <p data-block-complete-detail>需要完成全部 KP 精学、全部 KP Recall 评分，并明确完成一次 Block Recall。</p>
          <button type="button" class="portedPrimaryAction" data-block-complete disabled>确认 Block 第一轮完成</button>
          <small>这里只写浏览器本地 learner state；不会改 Canonical，也不会伪装成旧 Local server progress。</small>
        </section>
      </section>

      <section class="portedStudyOutlinePanel" data-study-panel="outline" hidden>
        <header><span>Outline · Current derived</span><h3>Block 内容地图</h3><p>结构来自当前 B1 的 H2 / KP 标记；没有新增医学语义。</p></header>
        <div class="portedOutlineSectionList">
          {sections.map((section, index) => <section><b>{String(index + 1).padStart(2, '0')}</b><div><strong>{section.title}</strong><p>{section.kpIds.join(' · ')}</p></div><button type="button" data-outline-open={index}>进入</button></section>)}
        </div>
      </section>
    </main>

    <aside class="portedStudyChain" aria-label="Learning Chain">
      <header><span>Learning Chain</span><strong>First-Pass</strong></header>
      <ol>
        <li data-chain-step="block_learn"><button type="button" data-stage-target="block_learn"><i></i><span><b>Block 初识</b><small data-chain-block>待定位</small></span></button></li>
        <li data-chain-step="kp_learn"><button type="button" data-stage-target="kp_learn"><i></i><span><b>KP 精学</b><small data-chain-kp-learn>0/{kps.length}</small></span></button></li>
        <li data-chain-step="ttsx"><button type="button" data-stage-target="ttsx"><i></i><span><b>配套题</b><small>回讲义完成</small></span></button></li>
        <li data-chain-step="kp_recall"><button type="button" data-stage-target="kp_recall"><i></i><span><b>KP Recall</b><small data-chain-kp-recall>0/{kps.length}</small></span></button></li>
        <li data-chain-step="block_recall"><button type="button" data-stage-target="block_recall"><i></i><span><b>Block Recall</b><small data-chain-block-recall>未完成</small></span></button></li>
        <li data-chain-step="block_complete"><button type="button" data-stage-target="block_complete"><i></i><span><b>Block 完成</b><small data-chain-complete>未完成</small></span></button></li>
      </ol>
      <footer>完成状态仅来自本浏览器 learner state；Canonical 始终只读。</footer>
    </aside>
  </div>

  <details class="portedSourceFoot" id="source">
    <summary>Current source</summary><code>{b1.sourcePath}</code><code>sha256:{String(b1.sourceHash).slice(0, 16)}</code>
  </details>
</section>

<script>
  const root = document.querySelector('[data-local-port="study-runtime"]');
  if (root) {
    const objectId = root.getAttribute('data-study-object') || 'xizong:a1:block1';
    const storageKey = `kianos-xizong-astro-v1:${objectId}`;
    const kpLearnCards = [...root.querySelectorAll('[data-kp-learn-card]')];
    const kpRecallCards = [...root.querySelectorAll('[data-kp-recall-card]')];
    const kpRailButtons = [...root.querySelectorAll('[data-kp-target]')];
    const sectionButtons = [...root.querySelectorAll('[data-section-target]')];
    const sections = [...root.querySelectorAll('.portedOutlineSectionList>section')];
    const stages = [...root.querySelectorAll('[data-study-stage]')];
    const tabButtons = [...root.querySelectorAll('[data-study-tab]')];
    const tabPanels = [...root.querySelectorAll('[data-study-panel]')];
    const layout = root.querySelector('[data-study-layout]');
    const kpRail = root.querySelector('[data-study-kp-rail]');
    const sectionRail = root.querySelector('[data-study-section-rail]');
    const railKicker = root.querySelector('[data-study-rail-kicker]');
    const railTitle = root.querySelector('[data-study-rail-title]');
    const contextLabel = root.querySelector('[data-study-context-label]');
    const statusLabel = root.querySelector('[data-study-local-status]');
    const totalKp = kpLearnCards.length;
    let state = { stage: 'block_learn', kpIndex: 0, learned: {}, ratings: {}, blockRecallDone: false, completed: false };
    try { state = { ...state, ...(JSON.parse(localStorage.getItem(storageKey) || 'null') || {}) }; } catch {}

    const save = () => { try { localStorage.setItem(storageKey, JSON.stringify(state)); } catch {} };
    const learnedCount = () => Object.values(state.learned || {}).filter(Boolean).length;
    const recallCount = () => Object.keys(state.ratings || {}).length;
    const canComplete = () => totalKp > 0 && learnedCount() >= totalKp && recallCount() >= totalKp && Boolean(state.blockRecallDone);
    const stageLabel = { block_learn: 'Block 初识', kp_learn: 'KP 精学', ttsx: '配套题', kp_recall: 'KP Recall', block_recall: 'Block Recall', block_complete: 'Block 完成' };

    const syncKpState = () => {
      kpRailButtons.forEach((button, index) => {
        const kpId = kpRecallCards[index]?.getAttribute('data-kp-id') || '';
        const small = button.querySelector('[data-kp-state]');
        const rating = state.ratings?.[kpId];
        const learned = Boolean(state.learned?.[kpId]);
        if (small) small.textContent = rating ? rating : learned ? '已精学' : '未记录';
        button.classList.toggle('active', index === Number(state.kpIndex || 0));
        button.classList.toggle('done', learned || Boolean(rating));
      });
      root.querySelector('[data-chain-kp-learn]')?.replaceChildren(document.createTextNode(`${learnedCount()}/${totalKp}`));
      root.querySelector('[data-chain-kp-recall]')?.replaceChildren(document.createTextNode(`${recallCount()}/${totalKp}`));
      root.querySelector('[data-chain-block-recall]')?.replaceChildren(document.createTextNode(state.blockRecallDone ? '已完成' : '未完成'));
      root.querySelector('[data-chain-complete]')?.replaceChildren(document.createTextNode(state.completed ? '已完成' : '未完成'));
      if (statusLabel) statusLabel.textContent = `本机进度 · 精学 ${learnedCount()}/${totalKp} · Recall ${recallCount()}/${totalKp}`;
      const completeButton = root.querySelector('[data-block-complete]');
      const completeTitle = root.querySelector('[data-block-complete-title]');
      const completeDetail = root.querySelector('[data-block-complete-detail]');
      if (completeButton) completeButton.disabled = !canComplete() || state.completed;
      if (completeTitle) completeTitle.textContent = state.completed ? '本 Block 第一轮已在本机记录完成' : canComplete() ? '本机 First-Pass 检查点已满足' : '还没有满足本机 First-Pass 检查点';
      if (completeDetail) completeDetail.textContent = `KP 精学 ${learnedCount()}/${totalKp} · KP Recall ${recallCount()}/${totalKp} · Block Recall ${state.blockRecallDone ? '完成' : '未完成'}`;
    };

    const setKpIndex = (index) => {
      state.kpIndex = Math.max(0, Math.min(totalKp - 1, Number(index) || 0));
      kpLearnCards.forEach((card, itemIndex) => { card.hidden = itemIndex !== state.kpIndex; });
      kpRecallCards.forEach((card, itemIndex) => { card.hidden = itemIndex !== state.kpIndex; });
      const activeLearn = kpLearnCards[state.kpIndex];
      const activeRecall = kpRecallCards[state.kpIndex];
      const label = activeRecall?.querySelector('h3')?.textContent || activeLearn?.querySelector('h3')?.textContent || '';
      const learnTitle = root.querySelector('[data-kp-learn-title]');
      const recallTitle = root.querySelector('[data-kp-recall-title]');
      const learnCounter = root.querySelector('[data-kp-counter]');
      const recallCounter = root.querySelector('[data-recall-counter]');
      if (learnTitle) learnTitle.textContent = label;
      if (recallTitle) recallTitle.textContent = label;
      if (learnCounter) learnCounter.textContent = `${state.kpIndex + 1} / ${totalKp}`;
      if (recallCounter) recallCounter.textContent = `${state.kpIndex + 1} / ${totalKp}`;
      kpRailButtons.forEach((button, itemIndex) => button.classList.toggle('active', itemIndex === state.kpIndex));
      save(); syncKpState();
    };

    const setStage = (stage) => {
      state.stage = stage || 'block_learn';
      stages.forEach((panel) => { panel.hidden = panel.getAttribute('data-study-stage') !== state.stage; });
      const kpMode = ['kp_learn', 'kp_recall'].includes(state.stage);
      if (kpRail) kpRail.hidden = !kpMode;
      if (sectionRail) sectionRail.hidden = kpMode;
      if (railKicker) railKicker.textContent = kpMode ? 'KP Navigator' : 'Block Map';
      if (railTitle) railTitle.textContent = kpMode ? '连续精学 / Recall' : '连续学习';
      root.querySelectorAll('[data-chain-step]').forEach((item) => item.classList.toggle('viewing', item.getAttribute('data-chain-step') === state.stage));
      if (contextLabel) contextLabel.textContent = `西医综合 · Block 1 · Learn · ${stageLabel[state.stage] || 'Learn'}`;
      setKpIndex(state.kpIndex || 0);
      save();
    };

    const switchTab = (name) => {
      tabButtons.forEach((button) => button.classList.toggle('active', button.dataset.studyTab === name));
      tabPanels.forEach((panel) => { panel.hidden = panel.dataset.studyPanel !== name; });
      if (name === 'learn') setStage(state.stage || 'block_learn');
    };
    tabButtons.forEach((button) => button.addEventListener('click', () => switchTab(button.dataset.studyTab || 'learn')));
    root.querySelectorAll('[data-stage-target],[data-stage-next]').forEach((button) => button.addEventListener('click', () => { switchTab('learn'); setStage(button.getAttribute('data-stage-target') || button.getAttribute('data-stage-next') || 'block_learn'); }));

    root.querySelector('[data-kp-prev]')?.addEventListener('click', () => setKpIndex(state.kpIndex - 1));
    root.querySelector('[data-kp-next]')?.addEventListener('click', () => setKpIndex(state.kpIndex + 1));
    root.querySelector('[data-recall-prev]')?.addEventListener('click', () => setKpIndex(state.kpIndex - 1));
    root.querySelector('[data-recall-next]')?.addEventListener('click', () => setKpIndex(state.kpIndex + 1));
    kpRailButtons.forEach((button, index) => button.addEventListener('click', () => setKpIndex(index)));

    root.querySelectorAll('[data-kp-learned]').forEach((button) => button.addEventListener('click', () => {
      const kpId = button.getAttribute('data-kp-learned') || '';
      state.learned = { ...(state.learned || {}), [kpId]: true };
      button.classList.add('completed'); button.textContent = '已精学'; save(); syncKpState();
      if (learnedCount() >= totalKp) window.setTimeout(() => setStage('ttsx'), 180);
    }));

    kpRecallCards.forEach((card) => {
      const reveal = card.querySelector('[data-kp-reveal]');
      const answer = card.querySelector('[data-kp-answer]');
      const rating = card.querySelector('[data-kp-rating]');
      reveal?.addEventListener('click', () => { if (answer) answer.hidden = false; if (rating) rating.hidden = false; reveal.hidden = true; });
      card.querySelectorAll('[data-rating]').forEach((button) => button.addEventListener('click', () => {
        const kpId = card.getAttribute('data-kp-id') || '';
        const value = button.getAttribute('data-rating') || '';
        state.ratings = { ...(state.ratings || {}), [kpId]: value };
        card.querySelectorAll('[data-rating]').forEach((candidate) => candidate.classList.toggle('selected', candidate === button));
        save(); syncKpState();
        if (state.kpIndex < totalKp - 1) window.setTimeout(() => setKpIndex(state.kpIndex + 1), 160);
      }));
    });

    root.querySelector('[data-block-recall-complete]')?.addEventListener('click', (event) => {
      state.blockRecallDone = true; event.currentTarget.textContent = 'Block Recall 已完成'; event.currentTarget.classList.add('completed'); save(); syncKpState();
    });
    root.querySelector('[data-block-complete]')?.addEventListener('click', (event) => {
      if (!canComplete()) return; state.completed = true; event.currentTarget.textContent = 'Block 第一轮已完成'; save(); syncKpState();
    });

    sectionButtons.forEach((button, index) => button.addEventListener('click', () => {
      switchTab('outline');
      sections[index]?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }));
    root.querySelectorAll('[data-outline-open]').forEach((button) => button.addEventListener('click', () => {
      const index = Number(button.getAttribute('data-outline-open') || 0);
      switchTab('learn'); setStage('block_learn');
      const headings = root.querySelectorAll('[data-study-stage="block_learn"] h2');
      headings[index]?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }));

    const setCollapsed = (kind, collapsed) => {
      layout?.classList.toggle(`${kind}-collapsed`, collapsed);
      const button = root.querySelector(kind === 'outline' ? '[data-toggle-outline]' : '[data-toggle-chain]');
      button?.setAttribute('aria-pressed', String(collapsed));
      try { sessionStorage.setItem(`kianos-static-b1-${kind}-collapsed`, String(collapsed)); } catch {}
    };
    ['outline', 'chain'].forEach((kind) => {
      let collapsed = false; try { collapsed = sessionStorage.getItem(`kianos-static-b1-${kind}-collapsed`) === 'true'; } catch {}
      setCollapsed(kind, collapsed);
      root.querySelector(kind === 'outline' ? '[data-toggle-outline]' : '[data-toggle-chain]')?.addEventListener('click', () => setCollapsed(kind, !layout?.classList.contains(`${kind}-collapsed`)));
    });

    document.addEventListener('keydown', (event) => {
      const target = event.target;
      if (target instanceof HTMLElement && target.closest('input,textarea,select,button,a,[contenteditable="true"]')) return;
      if (!['kp_learn', 'kp_recall'].includes(state.stage)) return;
      if (event.key === 'ArrowLeft') { event.preventDefault(); setKpIndex(state.kpIndex - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); setKpIndex(state.kpIndex + 1); }
      if (state.stage === 'kp_recall' && event.code === 'Space') { event.preventDefault(); kpRecallCards[state.kpIndex]?.querySelector('[data-kp-reveal]')?.click(); }
      if (state.stage === 'kp_recall' && /^[1-4]$/.test(event.key)) {
        const values = ['unknown', 'fuzzy', 'known', 'mastered'];
        kpRecallCards[state.kpIndex]?.querySelector(`[data-rating="${values[Number(event.key) - 1]}"]`)?.click();
      }
    });

    Object.entries(state.learned || {}).forEach(([kpId, done]) => { if (done) { const button = root.querySelector(`[data-kp-learned="${kpId}"]`); if (button) { button.classList.add('completed'); button.textContent = '已精学'; } } });
    kpRecallCards.forEach((card) => {
      const value = state.ratings?.[card.getAttribute('data-kp-id') || ''];
      if (value) card.querySelector(`[data-rating="${value}"]`)?.classList.add('selected');
    });
    if (state.blockRecallDone) { const button = root.querySelector('[data-block-recall-complete]'); if (button) { button.textContent = 'Block Recall 已完成'; button.classList.add('completed'); } }
    setKpIndex(state.kpIndex || 0); setStage(state.stage || 'block_learn'); syncKpState();
  }
</script>
