---
const { task, objectId, taskObject=null } = Astro.props;
const taskContext=JSON.stringify(taskObject).replace(/</g,'\\u003c');
const base = import.meta.env.BASE_URL;
---
<aside
  class="englishExamTaskBridge"
  data-english-exam-task-bridge
  data-task={task}
  data-object-id={objectId}
  data-base={base}
  hidden
>
  <script type="application/json" data-exam-task-context set:html={taskContext}></script>
  <div>
    <span>整卷模考</span>
    <strong data-exam-step-label>当前部分</strong>
    <small data-exam-step-progress></small>
  </div>
  <b data-exam-remaining>180:00</b>
  <div class="englishExamTaskActions">
    <a data-exam-return href="#">查看整卷</a>
    <button type="button" data-exam-complete>完成本部分 →</button>
  </div>
</aside>

<script>
  import { readEnglishExamSession, writeEnglishExamSession, englishExamRemainingMs, captureEnglishExamStep, sealEnglishExamSession, englishExamTaskHref, englishExamTaskKey, englishExamPayload } from '../lib/englishExamSession.mjs';
  const bridge=document.querySelector('[data-english-exam-task-bridge]');
  if(bridge instanceof HTMLElement) {
    const params=new URLSearchParams(location.search), querySession=params.get('exam_session') || '', queryStep=params.get('exam_step') || '';
    const task=bridge.dataset.task || '', objectId=bridge.dataset.objectId || '', base=bridge.dataset.base || '/';
    let context=null;try{context=JSON.parse(bridge.querySelector('[data-exam-task-context]')?.textContent || 'null')}catch{}
    let state=readEnglishExamSession(localStorage);
    const exact=s=>s?.steps.find(row=>row.step_id===queryStep && row.task===task && row.object_id===objectId);
    const home=s=>`${base}english-exam/${encodeURIComponent(s.paper_id)}/`;
    const matching=state?.steps.find(row=>row.task===task && row.object_id===objectId);
    // An ordinary route for the active paper cannot become an answer/review side door.
    if(!querySession && state?.status==='ACTIVE' && matching) location.replace(englishExamTaskHref(matching,{base,sessionId:state.session_id}));
    if(querySession) {
      document.documentElement.dataset.englishExamSession='true';
      const lock=()=>{
        document.querySelectorAll('[data-local-port="reading"],[data-objective-root],[data-translation-runtime],[data-writing-runtime]').forEach(node=>{node.inert=true;});
        const button=bridge.querySelector('[data-exam-complete]');if(button instanceof HTMLButtonElement)button.disabled=true;
      };
      const refresh=()=>{state=readEnglishExamSession(localStorage);return state?.session_id===querySession && exact(state) && state.status==='ACTIVE';};
      if(!refresh()) { lock(); if(state)location.replace(home(state)); }
      else {
        const step=exact(state), index=state.steps.findIndex(row=>row.step_id===queryStep);
        bridge.hidden=false;
        bridge.querySelector('[data-exam-step-label]').textContent=({cloze:'完形填空',reading_a:'阅读理解',reading_b:'新题型',translation:'翻译',writing:step.writing_kind==='small'?'小作文':'大作文'})[task];
        bridge.querySelector('[data-exam-step-progress]').textContent=`第 ${index+1} / ${state.steps.length} 部分`;
        bridge.querySelector('[data-exam-return]').href=home(state);
        let completing=false;
        const complete=()=>{
          if(completing)return;completing=true;
          try {
            if(!refresh())throw new Error('这次整卷已结束；不能继续改写。');
            if(englishExamRemainingMs(state)<=0){lock();writeEnglishExamSession(localStorage,sealEnglishExamSession(state));location.href=home(state);return;}
            const local=JSON.parse(localStorage.getItem(englishExamTaskKey(querySession,task,objectId)) || '{}');
            const next=captureEnglishExamStep(state,{stepId:queryStep,task,objectId,payload:englishExamPayload(task,local,context)});
            writeEnglishExamSession(localStorage,next);
            location.href=next.current_step<next.steps.length?englishExamTaskHref(next.steps[next.current_step],{base,sessionId:querySession,stepIndex:next.current_step}):home(next);
          }catch(e){completing=false;bridge.querySelector('[data-exam-step-progress]').textContent=e.message;}
        };
        const selector=({reading_a:'[data-reading-submit]',cloze:'[data-objective-submit]',reading_b:'[data-objective-submit]',translation:'[data-freeze-first]',writing:'[data-lock-first]'})[task];
        window.addEventListener('click',e=>{const target=e.target instanceof Element?e.target:null;if(!target?.closest('[data-exam-complete]')&&!target?.closest(selector))return;e.preventDefault();e.stopImmediatePropagation();complete();},true);
        const tick=()=>{
          if(!refresh()){lock();location.replace(home(state || {paper_id:'unknown'}));return;}
          const ms=englishExamRemainingMs(state),sec=Math.ceil(ms/1000);
          bridge.querySelector('[data-exam-remaining]').textContent=String(Math.floor(sec/60)).padStart(3,'0')+':'+String(sec%60).padStart(2,'0');
          if(ms<=0){lock();writeEnglishExamSession(localStorage,sealEnglishExamSession(state));location.replace(home(state));}
        };
        window.addEventListener('storage',tick);window.addEventListener('focus',tick);tick();setInterval(tick,1000);
      }
    }
  }
</script>

<style>
  .englishExamTaskBridge{
    position:sticky;top:14px;z-index:145;
    display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:18px;
    max-width:82rem;margin:0 auto 12px;padding:10px 14px;
    border:1px solid rgba(45,83,69,.18);border-radius:11px;
    background:rgba(248,251,249,.97);box-shadow:0 8px 24px rgba(30,52,43,.08);backdrop-filter:blur(12px)
  }
  .englishExamTaskBridge[hidden]{display:none}
  .englishExamTaskBridge>div:first-child{display:grid;gap:2px;min-width:0}
  .englishExamTaskBridge span{font-size:var(--study-type-meta);font-weight:800;letter-spacing:.04em;color:var(--study-green)}
  .englishExamTaskBridge strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:16px;line-height:1.25}
  .englishExamTaskBridge small{font-size:var(--study-type-meta);line-height:1.3;color:var(--study-faint)}
  .englishExamTaskBridge>b{font-size:18px;font-variant-numeric:tabular-nums;color:#31483f}
  .englishExamTaskActions{display:flex;align-items:center;gap:7px}
  .englishExamTaskActions a,.englishExamTaskActions button{
    min-height:38px;padding:7px 11px;border:1px solid var(--study-line);border-radius:8px;background:#fff;color:inherit;
    font:inherit;font-size:var(--study-type-meta);font-weight:750;text-decoration:none;cursor:pointer
  }
  .englishExamTaskActions button{border-color:var(--study-green);background:var(--study-green);color:#fff}
  :global(html[data-english-exam-session="true"] [data-reading-continuous]),
  :global(html[data-english-exam-session="true"] [data-reading-session-actions]),
  :global(html[data-english-exam-session="true"] .portedReadingPassageNavigator),
  :global(html[data-english-exam-session="true"] .objectiveNavigator),
  :global(html[data-english-exam-session="true"] .translationHeader nav),
  :global(html[data-english-exam-session="true"] .writingRuntimeHeader nav){display:none !important}
  @media(max-width:720px){
    .englishExamTaskBridge{top:8px;grid-template-columns:1fr auto}
    .englishExamTaskActions{grid-column:1/-1}
  }
</style>
