---
const { task, objectId } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<aside
  class="englishExamTaskBridge"
  data-english-exam-task-bridge
  data-task={task}
  data-object-id={objectId}
  data-base={base}
  hidden
>
  <div>
    <span>整卷模考</span>
    <strong data-exam-step-label>当前部分</strong>
    <small data-exam-step-progress></small>
  </div>
  <b data-exam-remaining>180:00</b>
  <div class="englishExamTaskActions">
    <a data-exam-return href="#">查看整卷</a>
    <button type="button" data-exam-complete>完成本部分 →</button>
  </div>
</aside>

<script>
  import {
    readEnglishExamSession,
    writeEnglishExamSession,
    englishExamRemainingMs,
    captureEnglishExamStep,
    sealEnglishExamSession,
    englishExamTaskHref,
    englishExamPayload
  } from '../lib/englishExamSession.mjs';
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(() => {


  const bridge = document.querySelector('[data-english-exam-task-bridge]');
  if (bridge instanceof HTMLElement) {
    const params = new URLSearchParams(location.search);
    const querySession = params.get('exam_session') || '';
    const queryStep = params.get('exam_step') || '';
    const task = bridge.getAttribute('data-task') || '';
    const objectId = bridge.getAttribute('data-object-id') || '';
    const base = bridge.getAttribute('data-base') || '/';
    let state = readEnglishExamSession(localStorage);

    const exactStep = () => state?.steps?.find((step) =>
      step.step_id === queryStep && step.task === task && step.object_id === objectId
    ) || null;

    if (querySession && state?.session_id === querySession && state?.status === 'ACTIVE' && exactStep()) {
      bridge.hidden = false;
      document.documentElement.dataset.englishExamSession = 'true';
      const step = exactStep();
      const stepIndex = state.steps.findIndex((row) => row.step_id === step.step_id);
      const label = bridge.querySelector('[data-exam-step-label]');
      const progress = bridge.querySelector('[data-exam-step-progress]');
      const remaining = bridge.querySelector('[data-exam-remaining]');
      const returnLink = bridge.querySelector('[data-exam-return]');
      if (label) label.textContent = ({ cloze: "完形填空", reading_a: "阅读理解", reading_b: "新题型", translation: "翻译", writing: step.writing_kind === "small" ? "小作文" : "大作文" })[task] || "当前部分";
      if (progress) progress.textContent = `第 ${stepIndex + 1} / ${state.steps.length} 部分`;
      if (returnLink instanceof HTMLAnchorElement) {
        returnLink.href = `${base}english-exam/${encodeURIComponent(state.paper_id)}/`;
      }

      const taskStorageKey = () =>
        `kianos-english-exam-task-v1:${state.session_id}:${task}:${objectId}`;

      const readTaskState = () => {
        try { return JSON.parse(localStorage.getItem(taskStorageKey()) || 'null') || {}; }
        catch { return {}; }
      };

      const capturePayload = () => englishExamPayload(task,readTaskState());

      const routeNext = () => {
        if (state.current_step >= state.steps.length) {
          location.href = `${base}english-exam/${encodeURIComponent(state.paper_id)}/`;
          return;
        }
        const next = state.steps[state.current_step];
        location.href = englishExamTaskHref(next, {
          base,
          sessionId: state.session_id,
          stepIndex: state.current_step
        }) || `${base}english-exam/${encodeURIComponent(state.paper_id)}/`;
      };

      let completing = false;
      let sealFailed = false;
      const reportFailure = (wholePaper = false) => {
        if(wholePaper)sealFailed = true;
        bridge.dataset.sealError = wholePaper ? 'true' : 'false';
        if(progress) {
          progress.setAttribute('role','alert');
          progress.textContent = wholePaper
            ? '交卷未成功。原始作答已保留，尚未生成成绩；记录恢复后可重试。'
            : '本部分未交付。原始作答已保留，请在记录恢复后重试。';
        }
        const button=bridge.querySelector('[data-exam-complete]');
        if(button instanceof HTMLButtonElement) {
          button.disabled=false;
          button.textContent=wholePaper ? '重试交卷' : '重试交付本部分';
        }
      };
      const completeStep = () => {
        if (completing) return;
        completing = true;
        try {
          state=readEnglishExamSession(localStorage);
          if(!state || state.session_id!==querySession || state.status!=='ACTIVE') throw new Error('ENGLISH_EXAM_CONTEXT_INVALID_OR_SEALED');
          if (englishExamRemainingMs(state) <= 0) {
            const sealed = sealEnglishExamSession(state,Date.now(),{storage:localStorage});
            writeEnglishExamSession(localStorage, sealed);
            state = sealed;
            location.href = `${base}english-exam/${encodeURIComponent(state.paper_id)}/`;
            return;
          }
          state = captureEnglishExamStep(state, {
            stepId: step.step_id,
            task,
            objectId,
            payload: capturePayload()
          });
          writeEnglishExamSession(localStorage, state);
          routeNext();
        } catch (error) {
          completing = false;
          reportFailure(Boolean(state && englishExamRemainingMs(state)<=0));
        }
      };

      const underlyingSelector = ({
        reading_a: '[data-reading-submit]',
        cloze: '[data-objective-submit]',
        reading_b: '[data-objective-submit]',
        translation: '[data-freeze-first]',
        writing: '[data-lock-first]'
      })[task];

      window.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target : null;
        const own = target?.closest('[data-exam-complete]');
        const underlying = underlyingSelector ? target?.closest(underlyingSelector) : null;
        if (!own && !underlying) return;
        event.preventDefault();
        event.stopPropagation();
        event.stopImmediatePropagation();
        completeStep();
      }, true);

      const renderTime = () => {
        state=readEnglishExamSession(localStorage);
        if(!state) { reportFailure(true); return; }
        if(state.session_id!==querySession || state.status!=='ACTIVE') { location.href=`${base}english-exam/${encodeURIComponent(state.paper_id)}/`;return; }
        const ms = englishExamRemainingMs(state);
        const totalSeconds = Math.max(0, Math.ceil(ms / 1000));
        const minutes = Math.floor(totalSeconds / 60);
        const seconds = totalSeconds % 60;
        if (remaining) remaining.textContent = `${String(minutes).padStart(3, '0')}:${String(seconds).padStart(2, '0')}`;
        if (ms <= 0) {
          document.querySelectorAll('[data-local-port=reading],[data-objective-root],[data-translation-runtime],[data-writing-runtime]').forEach(node=>{node.inert=true;});
          if(sealFailed)return;
          try {
            const sealed=sealEnglishExamSession(state,Date.now(),{storage:localStorage});
            writeEnglishExamSession(localStorage,sealed);
            state=sealed;
            location.href = `${base}english-exam/${encodeURIComponent(state.paper_id)}/`;
          } catch { reportFailure(true); }
        }
      };
      renderTime();
      setInterval(renderTime, 1000);
    } else if(querySession) {
      document.documentElement.dataset.englishExamSession='true';
      document.querySelectorAll('[data-local-port=reading],[data-objective-root],[data-translation-runtime],[data-writing-runtime]').forEach(node=>{node.inert=true;});
      bridge.hidden=false;
      bridge.querySelector('[data-exam-step-label]').textContent='这次模考已封存或不匹配，请返回整卷。';
      bridge.querySelector('[data-exam-complete]').disabled=true;
      bridge.querySelector('[data-exam-return]').setAttribute('href', `${base}english-exam/${encodeURIComponent(state?.paper_id||'')}/`);
    }
  }

  });
</script>

<style>
  .englishExamTaskBridge{
    position:sticky;top:14px;z-index:145;
    display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:18px;
    max-width:82rem;margin:0 auto 12px;padding:10px 14px;
    border:1px solid rgba(45,83,69,.18);border-radius:11px;
    background:rgba(248,251,249,.97);box-shadow:0 8px 24px rgba(30,52,43,.08);backdrop-filter:blur(12px)
  }
  .englishExamTaskBridge[hidden]{display:none}
  .englishExamTaskBridge>div:first-child{display:grid;gap:2px;min-width:0}
  .englishExamTaskBridge span{font-size:var(--study-type-meta);font-weight:800;letter-spacing:.04em;color:var(--study-green)}
  .englishExamTaskBridge strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:16px;line-height:1.25}
  .englishExamTaskBridge small{font-size:var(--study-type-meta);line-height:1.3;color:var(--study-faint)}
  .englishExamTaskBridge>b{font-size:18px;font-variant-numeric:tabular-nums;color:#31483f}
  .englishExamTaskActions{display:flex;align-items:center;gap:7px}
  .englishExamTaskActions a,.englishExamTaskActions button{
    min-height:38px;padding:7px 11px;border:1px solid var(--study-line);border-radius:8px;background:#fff;color:inherit;
    font:inherit;font-size:var(--study-type-meta);font-weight:750;text-decoration:none;cursor:pointer
  }
  .englishExamTaskActions button{border-color:var(--study-green);background:var(--study-green);color:#fff}
  :global(html[data-english-exam-session="true"] [data-reading-continuous]),
  :global(html[data-english-exam-session="true"] [data-reading-session-actions]),
  :global(html[data-english-exam-session="true"] .portedReadingPassageNavigator),
  :global(html[data-english-exam-session="true"] .objectiveNavigator),
  :global(html[data-english-exam-session="true"] .translationHeader nav),
  :global(html[data-english-exam-session="true"] .writingRuntimeHeader nav){display:none !important}
  @media(max-width:720px){
    .englishExamTaskBridge{top:8px;grid-template-columns:1fr auto}
    .englishExamTaskActions{grid-column:1/-1}
  }
</style>
