---
const { block } = Astro.props;
const groups = block?.logicGroups || [];
const kps = block?.kpRecords || [];
const precision = block?.learningCues?.precision || [];
const visuals = block?.learningCues?.visuals || [];

const byAnchor = (rows, key) => Object.fromEntries(rows.reduce((acc, row) => {
  const id = row?.anchor?.[key];
  if (!id) return acc;
  const found = acc.find(([candidate]) => candidate === id);
  if (found) found[1].push(row);
  else acc.push([id, [row]]);
  return acc;
}, []));

const payload = {
  groups: groups.map((group) => group.groupId),
  kps: kps.map((kp) => kp.kpId),
  groupPrecision: byAnchor(precision, 'logic_group_id'),
  kpPrecision: byAnchor(precision, 'kp_id'),
  groupVisuals: byAnchor(visuals, 'logic_group_id'),
  kpVisuals: byAnchor(visuals, 'kp_id')
};
---
<div data-xizong-group-visuals hidden></div>
<div data-xizong-group-precision hidden></div>
<script type="application/json" data-learning-cue-payload set:html={JSON.stringify(payload)}></script>

<script>
  const studyRoot = document.querySelector('[data-xizong-v6-block]');
  const visualRoot = document.querySelector('[data-xizong-group-visuals]');
  const precisionRoot = document.querySelector('[data-xizong-group-precision]');
  const payloadNode = document.querySelector('[data-learning-cue-payload]');
  if (studyRoot && visualRoot && precisionRoot && payloadNode) {
    let payload = { groups: [], kps: [], groupPrecision: {}, kpPrecision: {}, groupVisuals: {}, kpVisuals: {} };
    try { payload = JSON.parse(payloadNode.textContent || '{}'); } catch {}

    const makePrecision = (row) => {
      const el = document.createElement('div');
      el.className = 'xv6LearningCue precision';
      const label = document.createElement('span');
      label.textContent = '以后要精确';
      const text = document.createElement('p');
      text.textContent = row?.cue || '';
      el.append(label, text);
      return el;
    };
    const makeVisual = (row) => {
      const el = document.createElement('div');
      el.className = 'xv6LearningCue visual';
      const label = document.createElement('span');
      label.textContent = `看原图 · ${row?.source_locator || 'Lecture'}`;
      const text = document.createElement('p');
      text.textContent = row?.task || '';
      el.append(label, text);
      return el;
    };

    // KP-level cues stay beside the current KP because they directly help this learning action.
    const learnCards = [...studyRoot.querySelectorAll('[data-kp-learn-card]')];
    learnCards.forEach((card, index) => {
      const kpId = payload.kps?.[index] || '';
      const precisionRows = payload.kpPrecision?.[kpId] || [];
      const visualRows = payload.kpVisuals?.[kpId] || [];
      if (!precisionRows.length && !visualRows.length) return;
      const stack = document.createElement('div');
      stack.className = 'xv6LearningCueStack kp';
      visualRows.forEach((row) => stack.appendChild(makeVisual(row)));
      precisionRows.forEach((row) => stack.appendChild(makePrecision(row)));
      const lecture = card.querySelector('.xv6LectureFirst');
      if (lecture) lecture.insertAdjacentElement('afterend', stack);
      else card.querySelector(':scope > header')?.insertAdjacentElement('afterend', stack);
    });

    // Group visual helps understanding now, so it appears at the section entrance.
    const logicStage = studyRoot.querySelector('[data-study-stage="logic_group"]');
    logicStage?.querySelector('.xv6LogicTarget')?.insertAdjacentElement('afterend', visualRoot);

    // Group precision is a later exactness reminder, so it appears only after the section is learned.
    const closeStage = studyRoot.querySelector('[data-study-stage="group_close"]');
    closeStage?.querySelector('.xv6GroupClosure')?.insertAdjacentElement('afterend', precisionRoot);

    const currentIndex = () => {
      const text = studyRoot.querySelector('[data-logic-counter]')?.textContent || '';
      const match = text.match(/(\d+)\s*\//);
      return Math.max(0, Number(match?.[1] || 1) - 1);
    };
    const render = () => {
      const groupId = payload.groups?.[currentIndex()] || '';
      const visuals = payload.groupVisuals?.[groupId] || [];
      const precisions = payload.groupPrecision?.[groupId] || [];
      visualRoot.replaceChildren();
      precisionRoot.replaceChildren();
      visualRoot.hidden = !visuals.length;
      precisionRoot.hidden = !precisions.length;
      visuals.forEach((row) => visualRoot.appendChild(makeVisual(row)));
      precisions.forEach((row) => precisionRoot.appendChild(makePrecision(row)));
    };

    const counter = studyRoot.querySelector('[data-logic-counter]');
    if (counter) new MutationObserver(render).observe(counter, { childList: true, subtree: true, characterData: true });
    render();
  }
</script>

<style>
  [data-xizong-group-visuals],[data-xizong-group-precision]{margin:.65rem 0}.xv6LearningCueStack{display:grid;gap:6px}.xv6LearningCueStack.kp{margin:.1rem 0 .8rem}.xv6LearningCue{display:grid;grid-template-columns:118px minmax(0,1fr);gap:.55rem;align-items:start;padding:.45rem .1rem}.xv6LearningCue span{font-size:.72rem;font-weight:800;opacity:.68}.xv6LearningCue p{margin:0;font-size:.84rem;line-height:1.55}.xv6LearningCue.precision{border-top:1px solid var(--line,#d9dde5)}.xv6LearningCue.precision span{color:var(--study-green,#286c57)}.xv6LearningCue.visual{padding:.5rem .6rem;border-radius:9px;background:var(--soft,#f5f6f8)}.xv6LearningCue.visual span{white-space:nowrap}@media(max-width:720px){.xv6LearningCue{grid-template-columns:1fr;gap:.15rem}}
</style>