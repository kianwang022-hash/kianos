---
import { attachSourceVisualBundles } from '../lib/xizongSourceVisualAssets.mjs';

const { block } = Astro.props;
const groups = block?.logicGroups || [];
const kps = block?.kpRecords || [];
const precision = block?.learningCues?.precision || [];
const visuals = attachSourceVisualBundles(block?.learningCues?.visuals || []);
const unsupportedKpVisuals = visuals.filter((row) => row?.anchor?.kp_id);
if (unsupportedKpVisuals.length) {
  throw new Error(`CURRENT_XIZONG_KP_VISUAL_UNSUPPORTED:${unsupportedKpVisuals.map((row) => row.id).join(',')}`);
}

const byAnchor = (rows, key) => Object.fromEntries(rows.reduce((acc, row) => {
  const id = row?.anchor?.[key];
  if (!id) return acc;
  const found = acc.find(([candidate]) => candidate === id);
  if (found) found[1].push(row);
  else acc.push([id, [row]]);
  return acc;
}, []));

const payload = {
  groups: groups.map((group) => group.groupId),
  groupPrecision: byAnchor(precision, 'logic_group_id'),
  kpPrecision: byAnchor(precision, 'kp_id'),
  groupVisuals: byAnchor(visuals, 'logic_group_id')
};
---
<div data-xizong-group-visuals hidden></div>
<div data-xizong-group-precision hidden></div>
<script type="application/json" data-learning-cue-payload set:html={JSON.stringify(payload)}></script>

<script>
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(() => {

  const studyRoot = document.querySelector('[data-xizong-v6-block]');
  const visualRoot = document.querySelector('[data-xizong-group-visuals]');
  const precisionRoot = document.querySelector('[data-xizong-group-precision]');
  const payloadNode = document.querySelector('[data-learning-cue-payload]');
  if (studyRoot && visualRoot && precisionRoot && payloadNode) {
    let payload = { groups: [], groupPrecision: {}, kpPrecision: {}, groupVisuals: {} };
    try { payload = JSON.parse(payloadNode.textContent || '{}'); } catch {}

    const makePrecision = (row) => {
      const el = document.createElement('div');
      el.className = 'xv6LearningCue precision';
      el.dataset.precisionCueId = row?.id || '';
      const label = document.createElement('span');
      label.textContent = '以后要精确';
      const text = document.createElement('p');
      text.textContent = row?.cue || '';
      el.append(label, text);
      return el;
    };

    const makeVisual = (row) => {
      const el = document.createElement('div');
      el.className = 'xv6LearningCue visual';
      const bundle = row?.source_visual_bundle || null;
      const assets = Array.isArray(bundle?.assets) ? bundle.assets : [];
      if (assets.length) el.classList.add('hasSourceVisuals');

      const label = document.createElement('span');
      label.textContent = `看原图 · ${row?.source_locator || 'Lecture'}`;
      const text = document.createElement('p');
      text.textContent = row?.task || '';
      el.append(label, text);

      if (assets.length) {
        const gallery = document.createElement('div');
        gallery.className = 'xv6SourceVisualGallery';

        assets.forEach((asset, index) => {
          const figure = document.createElement('figure');
          figure.className = 'xv6SourceVisualFigure';
          if (index === 0 && assets.length > 1) figure.classList.add('primary');
          if (asset?.sourceObjectId) figure.dataset.sourceObject = asset.sourceObjectId;
          if (asset?.sourcePage) figure.dataset.sourcePage = String(asset.sourcePage);

          const link = document.createElement('a');
          link.className = 'xv6SourceVisualLink';
          link.href = asset?.src || '#';
          link.target = '_blank';
          link.rel = 'noreferrer';
          link.title = '打开原讲义裁图';

          const img = document.createElement('img');
          img.src = asset?.src || '';
          img.alt = asset?.alt || asset?.usageLabel || '原讲义裁图';
          img.loading = 'lazy';
          img.decoding = 'async';
          if (asset?.width) img.width = Number(asset.width);
          if (asset?.height) img.height = Number(asset.height);
          link.appendChild(img);

          const caption = document.createElement('figcaption');
          caption.textContent = asset?.usageLabel || (asset?.sourcePage ? `P${asset.sourcePage}` : '原讲义裁图');
          figure.append(link, caption);
          gallery.appendChild(figure);
        });

        const note = document.createElement('small');
        note.className = 'xv6SourceVisualNote';
        note.textContent = '原讲义精确裁图 · 点击图片可放大；这里不替代 MarginNote 连续学习。';
        el.append(gallery, note);
      }

      return el;
    };

    // KP Precision belongs to the exact KP answer context. The answer container is hidden
    // until Reveal, so the clean Recall front cannot leak the precision cue.
    const recallCards = [...studyRoot.querySelectorAll('[data-kp-recall-card][data-kp-id]')];
    recallCards.forEach((card) => {
      const kpId = card.dataset.kpId || '';
      const precisionRows = payload.kpPrecision?.[kpId] || [];
      if (!precisionRows.length) return;
      const answer = card.querySelector('[data-kp-answer]');
      if (!answer) {
        console.error(`CURRENT_XIZONG_KP_PRECISION_ANSWER_SLOT_MISSING:${kpId}`);
        return;
      }
      const stack = document.createElement('div');
      stack.className = 'xv6LearningCueStack kp postReveal';
      stack.dataset.kpPrecision = kpId;
      precisionRows.forEach((row) => stack.appendChild(makePrecision(row)));
      answer.appendChild(stack);
    });

    // Group visual keeps its accepted learning moment: the Logic Group entrance.
    const logicStage = studyRoot.querySelector('[data-study-stage="logic_group"]');
    logicStage?.querySelector('.xv6LogicTarget')?.insertAdjacentElement('afterend', visualRoot);

    // Group precision remains a later exactness reminder after the section is learned.
    const closeStage = studyRoot.querySelector('[data-study-stage="group_close"]');
    closeStage?.querySelector('.xv6GroupClosure')?.insertAdjacentElement('afterend', precisionRoot);

    const currentIndex = () => {
      const text = studyRoot.querySelector('[data-logic-counter]')?.textContent || '';
      const match = text.match(/(\d+)\s*\//);
      return Math.max(0, Number(match?.[1] || 1) - 1);
    };
    const render = () => {
      const groupId = payload.groups?.[currentIndex()] || '';
      const groupVisualRows = payload.groupVisuals?.[groupId] || [];
      const groupPrecisionRows = payload.groupPrecision?.[groupId] || [];
      visualRoot.replaceChildren();
      precisionRoot.replaceChildren();
      visualRoot.hidden = !groupVisualRows.length;
      precisionRoot.hidden = !groupPrecisionRows.length;
      groupVisualRows.forEach((row) => visualRoot.appendChild(makeVisual(row)));
      groupPrecisionRows.forEach((row) => precisionRoot.appendChild(makePrecision(row)));
    };

    const counter = studyRoot.querySelector('[data-logic-counter]');
    if (counter) new MutationObserver(render).observe(counter, { childList: true, subtree: true, characterData: true });
    render();
  }

  });
</script>

<style is:global>
  [data-xizong-group-visuals],[data-xizong-group-precision]{margin:.65rem 0}
  .xv6LearningCueStack{display:grid;gap:6px}
  .xv6LearningCueStack.kp{margin:.1rem 0 .8rem}
  .xv6LearningCueStack.kp.postReveal{margin:.75rem 0 0;padding-top:.15rem}
  .xv6LearningCue{display:grid;grid-template-columns:118px minmax(0,1fr);gap:.55rem;align-items:start;padding:.45rem .1rem}
  .xv6LearningCue span{font-size:.72rem;font-weight:800;opacity:.68}
  .xv6LearningCue p{margin:0;font-size:.84rem;line-height:1.55}
  .xv6LearningCue.precision{border-top:1px solid var(--line,#d9dde5)}
  .xv6LearningCue.precision span{color:var(--study-green,#286c57)}
  .xv6LearningCue.visual{padding:.5rem .6rem;border-radius:9px;background:var(--soft,#f5f6f8)}
  .xv6LearningCue.visual span{white-space:nowrap}
  .xv6LearningCue.visual.hasSourceVisuals{grid-template-columns:1fr;padding:.7rem;gap:.3rem;border:1px solid var(--line,#d9dde5);background:var(--paper,#fff)}
  .xv6LearningCue.visual.hasSourceVisuals>span{white-space:normal}
  .xv6SourceVisualGallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.7rem;margin-top:.4rem}
  .xv6SourceVisualFigure{margin:0;min-width:0;border:1px solid var(--line,#d9dde5);border-radius:10px;overflow:hidden;background:#fff}
  .xv6SourceVisualFigure.primary{grid-column:1/-1}
  .xv6SourceVisualLink{display:block;padding:.35rem;background:#fff}
  .xv6SourceVisualLink img{display:block;width:100%;height:auto;max-height:320px;object-fit:contain;margin:0 auto;background:#fff;cursor:zoom-in}
  .xv6SourceVisualFigure.primary .xv6SourceVisualLink img{max-height:520px}
  .xv6SourceVisualFigure figcaption{padding:.42rem .55rem .5rem;border-top:1px solid var(--line,#d9dde5);font-size:.74rem;line-height:1.35;font-weight:700;opacity:.72}
  .xv6SourceVisualNote{display:block;margin-top:.15rem;font-size:.7rem;line-height:1.45;opacity:.58}
  @media(max-width:720px){
    .xv6LearningCue{grid-template-columns:1fr;gap:.15rem}
    .xv6SourceVisualGallery{grid-template-columns:1fr}
    .xv6SourceVisualFigure.primary{grid-column:auto}
    .xv6SourceVisualLink img,.xv6SourceVisualFigure.primary .xv6SourceVisualLink img{max-height:none}
  }
</style>