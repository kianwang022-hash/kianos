---
const { reading } = Astro.props;
const base = import.meta.env.BASE_URL;
const questions = reading.questions || [];
const questionId = (question, index) => String(question.id || question.question_id || `q${question.ordinal || index + 1}`);
---
<section class="portedReadingSession portedReadingSessionV2" data-local-port="reading" data-reading-object={reading.objectId}>
  <header class="portedReadingSessionHeader">
    <a href={base}>‹ Practice</a>
    <div><span>Reading A</span><b>{reading.title}</b><small data-reading-progress>Q1 / {questions.length}</small></div>
    <div class="portedReadingHeaderActions">
      <button type="button" data-reading-prev aria-label="上一题">‹</button>
      <button type="button" data-reading-next aria-label="下一题">›</button>
      <button type="button" class="submit" data-reading-submit>Submit</button>
      <button type="button" data-reading-retry hidden>Retry</button>
      <button type="button" data-reading-reset>Reset</button>
    </div>
  </header>

  <nav class="portedReadingQuestionNav" aria-label="Question navigation">
    {questions.map((question, index) => <button type="button" class={index === 0 ? 'active' : ''} data-target={questionId(question, index)}>Q{question.ordinal || index + 1}</button>)}
  </nav>

  <section class="portedReadingResultBar" data-reading-result hidden>
    <div><span>Attempt result</span><strong data-reading-score>0 / {questions.length}</strong><small data-reading-result-meta></small></div>
    <div><b data-reading-wrong-count>0 wrong</b><b data-reading-uncertain-count>0 uncertain</b><small>已写入浏览器本地 History / Problem Record</small></div>
  </section>

  <div class="portedReadingColumns">
    <article class="portedReadingPassage" data-reading-passage>
      <div class="portedReadingAnnotate" role="toolbar" aria-label="Reading annotation">
        <span>Annotate · session only</span>
        <button type="button" data-reading-highlight disabled>高亮选区</button>
        <button type="button" data-reading-clear-highlight disabled>清除高亮</button>
        <small data-reading-selection>选择原文后可高亮</small>
      </div>
      <header><span>{reading.paperId || 'English'} · {reading.section}</span><h2>{reading.title}</h2></header>
      {reading.paragraphs.map((paragraph) => <p id={paragraph.id}>{paragraph.text}</p>)}
    </article>

    <aside class="portedReadingQuestions" aria-live="polite">
      {questions.map((question, index) => {
        const id = questionId(question, index);
        return <section class={`portedReadingQuestion ${index === 0 ? 'is-current' : ''}`} data-question={id} data-index={index} data-answer={JSON.stringify(question.answer ?? '')} hidden={index !== 0}>
          <header><span>Question {question.ordinal || index + 1}</span><button type="button" class="portedUncertain" aria-pressed="false">Uncertain</button></header>
          <p>{question.prompt}</p>
          <div class="portedReadingOptions">
            {Object.entries(question.options || {}).map(([label, text]) => <button type="button" data-option={label}><b>{label}</b><span>{String(text)}</span></button>)}
          </div>
          {question.answer && <details class="portedReadingAnswer" data-reading-answer-details hidden><summary>Current answer</summary><div>Answer: <strong>{Array.isArray(question.answer) ? question.answer.join(', ') : question.answer}</strong></div></details>}
        </section>;
      })}
      <footer class="portedReadingQuestionFooter">
        <span>← / → 切题 · A–D 选择 · U uncertain · Submit 后生成 Problem Record</span>
        <strong data-reading-session-count>0 / {questions.length} answered</strong>
      </footer>
    </aside>
  </div>

  <section class="portedReadingAftercare">
    <details data-reading-problem-record>
      <summary>Problem Record <span data-reading-problem-count>0</span></summary>
      <div class="portedReadingProblemGrid">
        <section><span>Wrong / unanswered</span><ul data-reading-wrong-list><li>提交后生成。</li></ul></section>
        <section><span>Uncertain</span><ul data-reading-uncertain-list><li>没有标记。</li></ul></section>
      </div>
    </details>
    <details data-reading-history>
      <summary>History <span data-reading-history-count>0</span></summary>
      <ol data-reading-history-list><li>还没有提交记录。</li></ol>
      <button type="button" data-reading-clear-history>清空本机 History</button>
    </details>
  </section>

  <details class="portedReadingSource"><summary>Current provenance</summary><code>{reading.sourcePaths.passage}</code><code>passage:{reading.sourceHashes.passageOwner.slice(0, 12)}</code><code>questions:{reading.sourceHashes.questionOwner.slice(0, 12)}</code></details>
</section>

<script>
  const root = document.querySelector('[data-local-port="reading"]');
  if (root) {
    const readingKey = root.getAttribute('data-reading-object') || 'reading';
    const storageKey = `kianos-reading-attempt-v1:${readingKey}`;
    const navButtons = [...root.querySelectorAll('.portedReadingQuestionNav button')];
    const questions = [...root.querySelectorAll('[data-question]')];
    const progress = root.querySelector('[data-reading-progress]');
    const sessionCount = root.querySelector('[data-reading-session-count]');
    const prev = root.querySelector('[data-reading-prev]');
    const next = root.querySelector('[data-reading-next]');
    const submit = root.querySelector('[data-reading-submit]');
    const retry = root.querySelector('[data-reading-retry]');
    const reset = root.querySelector('[data-reading-reset]');
    const resultBar = root.querySelector('[data-reading-result]');
    const scoreLabel = root.querySelector('[data-reading-score]');
    const resultMeta = root.querySelector('[data-reading-result-meta]');
    const wrongCount = root.querySelector('[data-reading-wrong-count]');
    const uncertainCount = root.querySelector('[data-reading-uncertain-count]');
    let state = { version: 1, currentIndex: 0, startedAt: new Date().toISOString(), answers: {}, uncertain: [], submitted: false, submittedAt: '', results: {}, history: [] };
    try { state = { ...state, ...(JSON.parse(localStorage.getItem(storageKey) || 'null') || {}) }; } catch {}

    const save = () => { try { localStorage.setItem(storageKey, JSON.stringify(state)); } catch {} };
    const qid = (question) => question.getAttribute('data-question') || '';
    const ordinal = (question) => Number(question.getAttribute('data-index') || 0) + 1;
    const expected = (question) => {
      try {
        const value = JSON.parse(question.getAttribute('data-answer') || '""');
        return Array.isArray(value) ? value.map(String) : value === null || value === undefined ? [] : [String(value)];
      } catch { return []; }
    };
    const sameAnswer = (actual, correct) => {
      const left = (Array.isArray(actual) ? actual : actual ? [actual] : []).map(String).sort();
      const right = (Array.isArray(correct) ? correct : correct ? [correct] : []).map(String).sort();
      return left.length === right.length && left.every((value, index) => value === right[index]);
    };
    const answeredCount = () => Object.values(state.answers || {}).filter(Boolean).length;

    const renderHistory = () => {
      const list = root.querySelector('[data-reading-history-list]');
      const count = root.querySelector('[data-reading-history-count]');
      if (count) count.textContent = String((state.history || []).length);
      if (!list) return;
      list.replaceChildren();
      if (!(state.history || []).length) { const item = document.createElement('li'); item.textContent = '还没有提交记录。'; list.appendChild(item); return; }
      (state.history || []).forEach((attempt) => {
        const item = document.createElement('li');
        const date = attempt.submittedAt ? new Date(attempt.submittedAt).toLocaleString() : '—';
        item.textContent = `${date} · ${attempt.score}/${attempt.total} · wrong ${attempt.wrong?.length || 0} · uncertain ${attempt.uncertain?.length || 0}`;
        list.appendChild(item);
      });
    };

    const renderProblemRecord = () => {
      const wrongList = root.querySelector('[data-reading-wrong-list]');
      const uncertainList = root.querySelector('[data-reading-uncertain-list]');
      const count = root.querySelector('[data-reading-problem-count]');
      const wrong = questions.filter((question) => ['wrong', 'unanswered'].includes(state.results?.[qid(question)])).map((question) => ordinal(question));
      const uncertain = questions.filter((question) => (state.uncertain || []).includes(qid(question))).map((question) => ordinal(question));
      if (count) count.textContent = String(new Set([...wrong, ...uncertain]).size);
      const fill = (list, values, empty) => {
        if (!list) return;
        list.replaceChildren();
        if (!values.length) { const item = document.createElement('li'); item.textContent = empty; list.appendChild(item); return; }
        values.forEach((value) => { const item = document.createElement('li'); item.textContent = `Question ${value}`; list.appendChild(item); });
      };
      fill(wrongList, wrong, state.submitted ? '本次没有错题。' : '提交后生成。');
      fill(uncertainList, uncertain, '没有标记。');
    };

    const setCurrent = (index) => {
      state.currentIndex = Math.max(0, Math.min(questions.length - 1, Number(index) || 0));
      questions.forEach((item, itemIndex) => { const active = itemIndex === state.currentIndex; item.hidden = !active; item.classList.toggle('is-current', active); });
      navButtons.forEach((button, itemIndex) => button.classList.toggle('active', itemIndex === state.currentIndex));
      if (progress) progress.textContent = `Q${state.currentIndex + 1} / ${questions.length}`;
      if (prev) prev.disabled = state.currentIndex <= 0;
      if (next) next.disabled = state.currentIndex >= questions.length - 1;
      save();
    };

    const render = () => {
      questions.forEach((question, index) => {
        const id = qid(question);
        const selected = state.answers?.[id];
        const result = state.results?.[id] || '';
        question.querySelectorAll('[data-option]').forEach((option) => {
          const isSelected = option.getAttribute('data-option') === selected;
          option.classList.toggle('selected', isSelected);
          option.classList.remove('result-correct', 'result-wrong');
          if (state.submitted && isSelected) option.classList.add(result === 'correct' ? 'result-correct' : 'result-wrong');
          option.disabled = Boolean(state.submitted);
        });
        const uncertainButton = question.querySelector('.portedUncertain');
        const isUncertain = (state.uncertain || []).includes(id);
        uncertainButton?.setAttribute('aria-pressed', String(isUncertain));
        uncertainButton?.classList.toggle('active', isUncertain);
        if (uncertainButton) uncertainButton.disabled = Boolean(state.submitted);
        const details = question.querySelector('[data-reading-answer-details]');
        if (details) details.hidden = !state.submitted;
        navButtons[index]?.classList.toggle('answered', Boolean(selected));
        navButtons[index]?.classList.toggle('uncertain', isUncertain);
        navButtons[index]?.classList.remove('result-correct', 'result-wrong', 'result-unanswered');
        if (state.submitted && result) navButtons[index]?.classList.add(`result-${result}`);
      });
      if (sessionCount) sessionCount.textContent = `${answeredCount()} / ${questions.length} answered`;
      if (submit) { submit.hidden = Boolean(state.submitted); submit.disabled = answeredCount() === 0; }
      if (retry) retry.hidden = !state.submitted;
      if (resultBar) resultBar.hidden = !state.submitted;
      if (state.submitted) {
        const correct = Object.values(state.results || {}).filter((value) => value === 'correct').length;
        const wrong = Object.values(state.results || {}).filter((value) => value === 'wrong' || value === 'unanswered').length;
        if (scoreLabel) scoreLabel.textContent = `${correct} / ${questions.length}`;
        if (wrongCount) wrongCount.textContent = `${wrong} wrong / unanswered`;
        if (uncertainCount) uncertainCount.textContent = `${(state.uncertain || []).length} uncertain`;
        if (resultMeta) resultMeta.textContent = state.submittedAt ? new Date(state.submittedAt).toLocaleString() : '';
      }
      renderProblemRecord();
      renderHistory();
      setCurrent(state.currentIndex || 0);
    };

    navButtons.forEach((button, index) => button.addEventListener('click', () => setCurrent(index)));
    prev?.addEventListener('click', () => setCurrent(state.currentIndex - 1));
    next?.addEventListener('click', () => setCurrent(state.currentIndex + 1));

    questions.forEach((question) => {
      const id = qid(question);
      question.querySelectorAll('[data-option]').forEach((option) => option.addEventListener('click', () => {
        if (state.submitted) return;
        state.answers = { ...(state.answers || {}), [id]: option.getAttribute('data-option') || '' };
        save();
        render();
      }));
      const uncertain = question.querySelector('.portedUncertain');
      uncertain?.addEventListener('click', (event) => {
        event.stopPropagation();
        if (state.submitted) return;
        const set = new Set(state.uncertain || []);
        set.has(id) ? set.delete(id) : set.add(id);
        state.uncertain = [...set];
        save();
        render();
      });
    });

    submit?.addEventListener('click', () => {
      if (state.submitted) return;
      const results = {};
      questions.forEach((question) => {
        const id = qid(question);
        const actual = state.answers?.[id];
        const correct = expected(question);
        results[id] = actual ? (sameAnswer(actual, correct) ? 'correct' : 'wrong') : 'unanswered';
      });
      state.results = results;
      state.submitted = true;
      state.submittedAt = new Date().toISOString();
      const score = Object.values(results).filter((value) => value === 'correct').length;
      const attempt = {
        submittedAt: state.submittedAt,
        score,
        total: questions.length,
        wrong: questions.filter((question) => ['wrong', 'unanswered'].includes(results[qid(question)])).map((question) => ordinal(question)),
        uncertain: questions.filter((question) => (state.uncertain || []).includes(qid(question))).map((question) => ordinal(question))
      };
      state.history = [attempt, ...(state.history || [])].slice(0, 8);
      save();
      render();
      root.querySelector('[data-reading-problem-record]')?.setAttribute('open', '');
    });

    const newAttempt = () => {
      state = { ...state, currentIndex: 0, startedAt: new Date().toISOString(), answers: {}, uncertain: [], submitted: false, submittedAt: '', results: {}, history: state.history || [] };
      save();
      render();
    };
    retry?.addEventListener('click', newAttempt);
    reset?.addEventListener('click', newAttempt);
    root.querySelector('[data-reading-clear-history]')?.addEventListener('click', () => { state.history = []; save(); renderHistory(); });

    document.addEventListener('keydown', (event) => {
      const target = event.target;
      if (target instanceof HTMLElement && target.closest('input,textarea,select,button,a,[contenteditable="true"]')) return;
      if (event.key === 'ArrowLeft') { event.preventDefault(); setCurrent(state.currentIndex - 1); return; }
      if (event.key === 'ArrowRight') { event.preventDefault(); setCurrent(state.currentIndex + 1); return; }
      if (state.submitted) return;
      if (event.key.toLowerCase() === 'u') { questions[state.currentIndex]?.querySelector('.portedUncertain')?.click(); return; }
      const choice = event.key.toUpperCase();
      if (/^[A-D]$/.test(choice)) questions[state.currentIndex]?.querySelector(`[data-option="${choice}"]`)?.click();
    });

    const passage = root.querySelector('[data-reading-passage]');
    const addHighlight = root.querySelector('[data-reading-highlight]');
    const clearHighlight = root.querySelector('[data-reading-clear-highlight]');
    const selectionLabel = root.querySelector('[data-reading-selection]');
    let pendingRange = null;
    let highlight = null;
    const highlightName = 'kianos-reading-session-highlight';
    const supportsHighlights = typeof CSS !== 'undefined' && CSS.highlights && typeof Highlight !== 'undefined';
    const captureSelection = () => {
      const selection = window.getSelection?.();
      if (!selection || selection.isCollapsed || !selection.rangeCount || !passage) {
        pendingRange = null;
        if (addHighlight) addHighlight.disabled = true;
        return;
      }
      const range = selection.getRangeAt(0);
      if (!passage.contains(range.commonAncestorContainer)) return;
      pendingRange = range.cloneRange();
      if (addHighlight) addHighlight.disabled = !supportsHighlights;
      if (selectionLabel) selectionLabel.textContent = supportsHighlights ? `已选 ${selection.toString().trim().slice(0, 28)}${selection.toString().trim().length > 28 ? '…' : ''}` : '当前浏览器不支持会话高亮';
    };
    passage?.addEventListener('mouseup', captureSelection);
    passage?.addEventListener('keyup', captureSelection);
    addHighlight?.addEventListener('click', () => {
      if (!pendingRange || !supportsHighlights) return;
      highlight ||= new Highlight();
      highlight.add(pendingRange);
      CSS.highlights.set(highlightName, highlight);
      pendingRange = null;
      window.getSelection?.().removeAllRanges();
      addHighlight.disabled = true;
      if (clearHighlight) clearHighlight.disabled = false;
      if (selectionLabel) selectionLabel.textContent = '已加入会话高亮';
    });
    clearHighlight?.addEventListener('click', () => {
      if (supportsHighlights) CSS.highlights.delete(highlightName);
      highlight = null;
      clearHighlight.disabled = true;
      if (selectionLabel) selectionLabel.textContent = '选择原文后可高亮';
    });

    render();
  }
</script>
