---
const { reading } = Astro.props;
const base = import.meta.env.BASE_URL;
const questions = reading.questions || [];
const navigation = reading.navigation || {};
const questionId = (question, index) => String(question.id || question.question_id || `q${question.ordinal || index + 1}`);
---
<section
  class="portedReadingSession portedReadingSessionV3"
  data-local-port="reading"
  data-reading-object={reading.objectId} data-english-source-hash={reading.sourceHashes?.renderedObject}
  data-reading-base={base}
  data-reading-next-id={navigation.nextId || ''}
>
  <script type="application/json" data-english-task-snapshot set:html={JSON.stringify({evidence:{source_kind:reading.sourceKind||'official',evidence_role:reading.context?.evidence_role||null,semantic_source_hash:reading.sourceHashes?.semanticSource||reading.sourceHashes?.renderedObject||null},paragraphs:reading.paragraphs,questions:reading.questions.map(({id,ordinal,prompt,options})=>({id,ordinal,prompt,options}))}).replace(/</g, "\\u003c")}></script>
  <header class="portedReadingSessionHeader">
    <a href={base}>‹ Practice</a>
    <div class="portedReadingHeaderCenter">
      <span>Reading A</span>
      <b>{reading.title}</b>
      <small data-reading-progress>Q1 / {questions.length}</small>
      <small data-reading-timer>00:00</small>
    </div>
    <div class="portedReadingHeaderActions">
      <button type="button" data-reading-continuous aria-pressed="false">连续练</button>
      <button type="button" data-reading-prev aria-label="上一题">‹</button>
      <button type="button" data-reading-next aria-label="下一题">›</button>
      <button type="button" class="submit" data-reading-submit>Submit</button>
      <button type="button" data-reading-retry hidden>再做一轮</button>
      <button type="button" data-reading-reset>重置</button>
    </div>
  </header>

  <nav class="portedReadingQuestionNav" aria-label="Question navigation">
    {questions.map((question, index) => (
      <button type="button" class={index === 0 ? 'active' : ''} data-target={questionId(question, index)}>
        Q{question.ordinal || index + 1}
      </button>
    ))}
  </nav>

  <section class="portedReadingResultBar" data-reading-result hidden>
    <div class="portedReadingResultMain">
      <span>Result</span>
      <strong data-reading-score>0 / {questions.length}</strong>
      <small data-reading-result-meta></small>
    </div>
    <div class="portedReadingResultSummary">
      <b data-reading-summary></b>
      <div data-reading-review-nav></div>
      <div class="portedReadingSessionActions" data-reading-session-actions hidden>
        <button type="button" data-reading-session-continue>下一篇 →</button>
        <button type="button" data-reading-session-review>结束并统一复盘</button>
        <button type="button" data-reading-session-next-review hidden>下一篇复盘 →</button>
        <button type="button" data-reading-session-finish hidden>结束本次训练</button>
      </div>
    </div>
  </section>

  <div class="portedReadingColumns">
    <article class="portedReadingPassage" data-reading-passage>
      <div class="portedReadingAnnotate" role="toolbar" aria-label="Reading annotation">
        <span>标记 · 可选</span>
        <button type="button" data-reading-highlight disabled>高亮选区</button>
        <button type="button" data-reading-clear-highlight disabled>清除</button>
        <small data-reading-selection>选中文字后可高亮</small>
      </div>
      <header>
        <span>{reading.paperId || 'English'} · {reading.section}</span>
        <h2>{reading.title}</h2>
      </header>
      {reading.paragraphs.map((paragraph) => <p id={paragraph.id}>{paragraph.text}</p>)}
    </article>

    <aside class="portedReadingQuestions" aria-live="polite">
      {questions.map((question, index) => {
        const id = questionId(question, index);
        return (
          <section
            class={`portedReadingQuestion ${index === 0 ? 'is-current' : ''}`}
            data-question={id}
            data-index={index}
            data-answer={JSON.stringify(question.answer ?? '')}
          >
            <header>
              <span>Question {question.ordinal || index + 1}</span>
              <button type="button" class="portedUncertain" aria-pressed="false">Uncertain</button>
            </header>
            <p>{question.prompt}</p>
            <div class="portedReadingOptions">
              {Object.entries(question.options || {}).map(([label, text]) => (
                <button type="button" data-option={label}>
                  <b>{label}</b><span>{String(text)}</span>
                </button>
              ))}
            </div>

            <div class="portedReadingAnswerStrip" data-reading-answer-strip hidden>
              <span>你的答案 <b data-reading-your-answer>—</b></span>
              <span>正式答案 <b data-reading-formal-answer>—</b></span>
            </div>

            <section class="portedReadingRepair" data-reading-repair hidden>
              <header>
                <div>
                  <span>只处理这道</span>
                  <strong data-reading-repair-title></strong>
                </div>
                <small>错因可选，一点即可</small>
              </header>
              <div class="portedReadingCauseRow" aria-label="Quick cause">
                <button type="button" data-cause="没读懂">没读懂</button>
                <button type="button" data-cause="没定位准">没定位准</button>
                <button type="button" data-cause="选项没辨清">选项没辨清</button>
                <button type="button" data-cause="看错/改错">看错 / 改错</button>
              </div>
              <div class="portedReadingRepairActions">
                <button type="button" data-reading-copy-chat>复制给 Chat</button>
                <small data-reading-copy-status>需要深挖时再用，不必每题都分析。</small>
              </div>
            </section>
          </section>
        );
      })}
      <footer class="portedReadingQuestionFooter">
        <span>← / → 切题 · A–D 选择 · U uncertain</span>
        <strong data-reading-session-count>0 / {questions.length} answered</strong>
      </footer>
    </aside>
  </div>

  <details class="portedReadingHistory" data-reading-history>
    <summary>本机记录 <span data-reading-history-count>0</span></summary>
    <ol data-reading-history-list><li>还没有提交记录。</li></ol>
    <button type="button" data-reading-clear-history>清空本机记录</button>
  </details>
 
</section>

<script>
  import {initReadingRuntime} from '../lib/readingRuntime.mjs';
  import {learnerWriterReady} from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(() => initReadingRuntime(document.querySelector('[data-local-port="reading"]')));
</script>
