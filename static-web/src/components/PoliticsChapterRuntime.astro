x 0;background:#f5f8f6}.politicsQuestion span{display:block;margin-bottom:5px;color:var(--study-faint);font-size:10px}.politicsQuestion strong{line-height:1.6}.politicsAnswer{padding:0 3px;color:#33463e;line-height:1.75}.politicsGuide,.politicsClosure,.politicsExplain{margin-top:16px;border:1px solid var(--study-line);border-radius:12px;background:#fff}.politicsGuide summary,.politicsClosure summary,.politicsExplain summary{cursor:pointer;padding:11px 14px;font-size:13px;font-weight:760}.politicsGuideBody{display:grid;gap:8px;padding:0 12px 12px}.politicsGuideBody article{padding:12px;border-radius:10px;background:#f7f8f7}.politicsGuideBody p,.politicsGuideBody li{margin:5px 0;color:var(--study-muted);font-size:13px;line-height:1.6}.politicsGuideBody small{color:var(--study-faint);line-height:1.5}.politicsGuideBody article p span{color:var(--study-green);font-size:10px;font-weight:800}.politicsApplication{background:#fff8e8!important}.politicsSource,.politicsQuiz{margin-top:24px}.politicsSource>header,.politicsQuiz>header{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-bottom:10px}.politicsSource h3,.politicsQuiz h3{margin:0;font-size:19px}.politicsSource>header>span,.politicsQuiz>header>span{color:var(--study-faint);font-size:10px}.politicsSourceHandoff{padding:18px 20px;border:1px solid var(--study-line);border-radius:14px;background:#f8faf9}.politicsSourceHandoff>strong{font-size:15px}.politicsSourceHandoff>p{margin:7px 0 0;color:var(--study-muted);font-size:13px;line-height:1.7}.politicsSourceLocators{margin-top:14px;border-top:1px solid var(--study-line);padding-top:10px}.politicsSourceLocators summary{cursor:pointer;color:var(--study-green);font-size:11px;font-weight:780}.politicsSourceLocators ol{display:grid;gap:7px;margin:10px 0 0;padding-left:22px}.politicsSourceLocators li{color:var(--study-muted);font-size:11px;line-height:1.45}.politicsSourceLocators li div{margin-bottom:2px}.politicsSourceLocators code{font-size:9px;color:var(--study-faint);word-break:break-all}.politicsSourceFallback{padding-top:5px;color:var(--study-faint)!important;font-size:11px!important}.politicsBlocked{padding:16px;border:1px dashed var(--study-line-strong);border-radius:12px;background:#fafbfa}.politicsBlocked p{margin:5px 0 0;color:var(--study-faint);font-size:12px}.politicsClosure>div{padding:0 14px 12px}.politicsClosure p,.politicsClosure li{color:var(--study-muted);font-size:13px;line-height:1.65}.politicsQ{display:none;padding:20px;border:1px solid var(--study-line);border-radius:14px;background:#fff}.politicsQ.active{display:block}.politicsQMeta{display:flex;justify-content:space-between;color:var(--study-faint);font-size:10px}.politicsQ h4{font-size:16px;line-height:1.65}.politicsOptions{display:grid;gap:8px}.politicsOptions button{display:grid;grid-template-columns:28px 1fr;gap:8px;padding:11px 12px;border:1px solid var(--study-line);border-radius:10px;background:#fff;text-align:left;cursor:pointer}.politicsOptions button:hover:not(:disabled),.politicsOptions button.selected{border-color:#9cc4b5;background:#f3f8f6}.politicsOptions button.answer{border-color:#8db9aa;background:#edf7f2}.politicsOptions b{color:var(--study-green)}.politicsActions{display:flex;justify-content:flex-end;gap:8px;margin-top:12px}.politicsActions button,.politicsNextQ{padding:8px 12px;border:1px solid var(--study-line);border-radius:9px;background:#fff;cursor:pointer}.politicsActions .primary{background:var(--study-green);color:#fff;border-color:var(--study-green)}.politicsActions [data-politics-uncertain].active{background:#fff8e8;border-color:#e7d59d}.politicsResult{margin-top:12px;padding:10px 12px;border-radius:9px;font-weight:760}.politicsResult.correct{background:#edf7f2;color:#176b4f}.politicsResult.uncertain{background:#fff8e8;color:#6b4e16}.politicsResult.wrong{background:#fff0ef;color:#8d4944}.politicsRepair{margin-top:10px;padding:13px;border-radius:10px;background:#fff8e8}.politicsRepair li,.politicsRepair p{font-size:12px;line-height:1.6}.politicsRepair a{color:#6b4e16;font-size:12px;font-weight:760}.politicsExplain>p{padding:0 14px 12px;color:var(--study-muted);font-size:12px;line-height:1.65}.politicsNextQ{margin-top:10px}.politicsNextBridge{margin:18px 0 0;padding:12px 14px;border-radius:10px;background:#f5f8f6;color:#36584b;font-size:13px}.politicsChapterClose{margin-top:34px}.politicsCompressionSummary{padding:12px 14px;border-left:4px solid var(--study-green);border-radius:0 10px 10px 0;background:#f5f8f6;color:#36584b;line-height:1.7}.politicsFinalChain{display:grid;gap:7px}.politicsFinalChain span{padding:10px 12px;border-radius:9px;background:#f6f8f7;color:#40544c;font-size:13px}.politicsChapterClose li,.politicsReviewPrompt{color:var(--study-muted);line-height:1.65}.politicsReviewPrompt{margin-top:16px;padding-top:14px;border-top:1px solid var(--study-line)}
  @media(max-width:850px){.politicsStudy{grid-template-columns:1fr}.politicsRail{position:static}.politicsRail nav{grid-template-columns:repeat(2,minmax(0,1fr))}.politicsOrientation,.politicsChapterClose{padding:22px}.politicsUnitHead h2{font-size:23px}}
</style>
