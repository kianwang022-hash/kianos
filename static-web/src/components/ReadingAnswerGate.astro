---
const base = import.meta.env.BASE_URL;
---
<span data-reading-answer-gate data-reading-base={base} hidden></span>

<script>
  import {readEnglishExamSession} from '../lib/englishExamSession.mjs';
  import { learnerWriterReady } from '../lib/browserLearnerWriter.mjs';
  void learnerWriterReady.then(() => {

  const root = document.querySelector('[data-local-port="reading"]');
  const gate = document.querySelector('[data-reading-answer-gate]');

  if (root && gate) {
    const readingKey = root.getAttribute('data-reading-object') || 'reading';
    const basePath = gate.getAttribute('data-reading-base') || '/';
    const answerUrl = `${basePath}reading-answer/${encodeURIComponent(readingKey)}.json`;
    const examSessionId = new URLSearchParams(location.search).get('exam_session') || '';
    const attemptKey = examSessionId
      ? `kianos-english-exam-task-v1:${examSessionId}:reading_a:${readingKey}`
      : `kianos-reading-attempt-v1:${readingKey}`;
    const examMode = Boolean(examSessionId);
    const submit = root.querySelector('[data-reading-submit]');
    const notice = root.querySelector('[data-reading-submit-error]');
    const questions = [...root.querySelectorAll('[data-question]')];
    let ready = root.getAttribute('data-reading-answers-ready') === 'true';
    let loading = null;
    let failure = '';

    const readJson = (key, fallback) => {
      try { return JSON.parse(localStorage.getItem(key) || 'null') || fallback; }
      catch { return fallback; }
    };
    const normalizeAnswer = (value) => Array.isArray(value)
      ? value.map(String)
      : value === null || value === undefined || value === '' ? [] : [String(value)];

    const decorateSubmittedReview = () => {
      const attempt = readJson(attemptKey, {});
      if (!attempt.submitted || attempt.reviewUnlocked === false) return;
      const uncertain = new Set(attempt.uncertain || []);

      questions.forEach((question) => {
        const id = question.getAttribute('data-question') || '';
        let correct = [];
        try { correct = normalizeAnswer(JSON.parse(question.getAttribute('data-answer') || '""')); }
        catch {}
        const selected = String(attempt.answers?.[id] || '');
        const problem = ['wrong', 'unanswered'].includes(attempt.results?.[id]) || uncertain.has(id);
        const formal = question.querySelector('[data-reading-formal-answer]');
        if (formal) formal.textContent = correct.join(', ') || '—';
        if (!problem) return;

        question.querySelectorAll('[data-option]').forEach((option) => {
          const label = option.getAttribute('data-option') || '';
          option.classList.toggle('result-correct', correct.includes(label));
          option.classList.toggle('result-wrong', Boolean(selected && label === selected && !correct.includes(label)));
        });
      });
    };

    const applyAnswers = (payload) => {
      if (!payload || payload.objectId !== readingKey || !payload.answers || typeof payload.answers !== 'object') {
        throw new Error('READING_ANSWER_INVALID');
      }
      // Validate the complete key before changing any question or submitting.
      for (const question of questions) {
        const id = question.getAttribute('data-question') || '';
        const correct = normalizeAnswer(payload.answers[id]);
        if (!correct.length) throw new Error('READING_ANSWER_NOT_READY');
        const labels = [...question.querySelectorAll('[data-option]')].map((option) => option.getAttribute('data-option'));
        if (correct.length !== 1 || !labels.includes(correct[0])) throw new Error('READING_ANSWER_INVALID');
      }
      questions.forEach((question) => {
        const id = question.getAttribute('data-question') || '';
        if (!id || !Object.prototype.hasOwnProperty.call(payload.answers, id)) return;
        question.setAttribute('data-answer', JSON.stringify(payload.answers[id] ?? ''));
      });

      ready = questions.every((question) => {
        try { return normalizeAnswer(JSON.parse(question.getAttribute('data-answer') || '""')).length > 0; }
        catch { return false; }
      });
      if (!ready) return false;

      root.setAttribute('data-reading-answers-ready', 'true');
      decorateSubmittedReview();
      return true;
    };

    const fetchAnswerPayload = async () => {
      const options = { headers: { Accept: 'application/json' } };
      let response = await fetch(answerUrl, options);
      // Published static delivery owns the canonical no-slash JSON path.
      // Astro dev with trailingSlash=always exposes endpoint routes with a
      // trailing slash; retry only a 404 so Stable behavior stays unchanged.
      if (response.status === 404 && !answerUrl.endsWith('/')) {
        response = await fetch(answerUrl + '/', options);
      }
      if (!response.ok) throw new Error(`answer ${response.status}`);
      return response.json();
    };

    const loadAnswers = async () => {
      const activeExam=readEnglishExamSession(localStorage);
      if(root.dataset.englishReadonly==='true' || (activeExam&&!['RELEASED','SCORED'].includes(activeExam.status)&&activeExam.steps.some(s=>s.object_id===readingKey))){failure='READING_ANSWER_RESTRICTED';return false;}
      if (ready) return true;
      if (loading) return loading;
      failure = '';
      const originalText = submit?.textContent || 'Submit';
      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Submitting…';
      }

      loading = fetchAnswerPayload()
        .then(applyAnswers)
        .catch((error) => { failure = error?.message || ''; return false; })
        .finally(() => {
          loading = null;
          if (submit) {
            submit.disabled = false;
            submit.textContent = originalText;
          }
        });
      return loading;
    };

    document.addEventListener('click', async (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const button = target?.closest('[data-reading-submit]');
      if (!button || !root.contains(button) || ready || examMode) return;

      event.preventDefault();
      event.stopImmediatePropagation();
      const ok = await loadAnswers();
      if (ok) {
        if (notice) { notice.hidden = true; notice.textContent = ''; }
        submit?.removeAttribute('title');
        button.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
      } else if (submit) {
        const message = failure === 'READING_ANSWER_NOT_READY'
          ? '本篇标准答案尚未补齐，暂时无法批改。你的作答已保留，无需重做；待内容更新后重试。'
          : failure === 'READING_ANSWER_INVALID'
            ? '本篇标准答案数据异常，暂时无法批改。你的作答已保留，无需重做。'
            : failure === 'READING_ANSWER_RESTRICTED'
              ? '当前练习处于记录保护状态，请回到对应的考试或恢复页面继续。'
              : '暂时无法加载标准答案。你的作答已保留，请稍后重试提交。';
        submit.disabled = false;
        submit.textContent = '重试提交';
        submit.title = message;
        if (notice) { notice.textContent = message; notice.hidden = false; }
      }
    }, true);

    const savedAttempt = readJson(attemptKey, {});
    if (!examMode && savedAttempt.submitted) {
      void loadAnswers().then((ok) => {
        if (!ok) return;
        decorateSubmittedReview();
        // Re-run post-submit listeners after reload now that formal answers exist in the DOM.
        submit?.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
        root.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true }));
      });
    }
  }

  });
</script>
