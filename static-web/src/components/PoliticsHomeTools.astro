---
import { politicsProductCatalog } from '../lib/productCatalog.mjs';
const base = import.meta.env.BASE_URL;
const catalog = politicsProductCatalog(base);
const { firstHref, firstLabel = '开始政治学习' } = Astro.props;
---
<section class="politicsHomeTools" data-politics-home-tools data-base={base} data-has-handoff="false">
  <script type="application/json" data-politics-home-catalog set:html={JSON.stringify(catalog).replace(/</g, '\\u003c')} />
  <a class="politicsContinue" data-politics-continue href={firstHref}>
    <span>Continue</span>
    <strong data-politics-continue-title>{firstLabel}</strong>
    <small data-politics-continue-meta>先选学习单元；之后回到原题、原学习位置。</small>
  </a>
  <section class="politicsHandoff" data-politics-handoff hidden>
    <div>
      <span>需要带回 Chat</span>
      <a class="politicsReviewEntry" data-politics-review-entry href={`${base}politics/review/`}>今日回访 →</a>
      <p data-politics-handoff-summary>今天还没有需要带回 Chat 的政治证据。</p>
    </div>
    <button type="button" data-politics-copy-handoff hidden>Copy Today's Handoff</button>
  </section>
</section>

<script>
  import { politicsReviewPacket, readPoliticsSnapshot, selectPoliticsReview, resolvePoliticsContinue } from '../lib/politicsPracticeState.mjs';
  const root = document.querySelector('[data-politics-home-tools]');
  if (root instanceof HTMLElement) {
    const catalogNode = root.querySelector('[data-politics-home-catalog]');
    const catalog = JSON.parse(catalogNode?.textContent || '{}');
    catalogNode?.remove();
    const base = root.dataset.base || '/';
    const firstHref = root.querySelector('[data-politics-continue]')?.getAttribute('href') || `${base}politics/`;
    const firstTitle = root.querySelector('[data-politics-continue-title]')?.textContent || '开始政治学习';
    const localStudyDay = () => new Date().toLocaleDateString('en-CA');

    const renderContinue = (snapshot) => {
      const target = snapshot.errors.length ? null : resolvePoliticsContinue(catalog, snapshot, base);
      const link = root.querySelector('[data-politics-continue]');
      if (link instanceof HTMLAnchorElement) link.href = target?.href || firstHref;
      const title = root.querySelector('[data-politics-continue-title]');
      const meta = root.querySelector('[data-politics-continue-meta]');
      if (title) title.textContent = target?.title || firstTitle;
      if (meta) meta.textContent = snapshot.errors.length ? '记录未能完整读取，先核对存储。' : target?.detail || '先选学习单元；之后准确回到原位置。';
    };

    const actionableItems = (review) => review.items.filter((item) => item.needsReview);

    const renderHandoff = (snapshot, todayReview) => {
      const handoff = root.querySelector('[data-politics-handoff]');
      const summary = root.querySelector('[data-politics-handoff-summary]');
      const button = root.querySelector('[data-politics-copy-handoff]');
      if (!(handoff instanceof HTMLElement) || !(button instanceof HTMLButtonElement) || !summary) return;

      if (snapshot.errors.length) {
        root.dataset.hasHandoff = 'error';
        handoff.hidden = false;
        button.hidden = true;
        summary.textContent = '回访记录未能完整读取，当前不生成 Handoff；先进入回访核对。';
        return;
      }

      const items = actionableItems(todayReview);
      if (!items.length) {
        root.dataset.hasHandoff = 'false';
        handoff.hidden = true;
        button.hidden = true;
        return;
      }

      const wrong = items.filter((item) => item.outcome === 'WRONG').length;
      const uncertain = items.filter((item) => item.outcome === 'UNCERTAIN').length;
      root.dataset.hasHandoff = 'true';
      handoff.hidden = false;
      button.hidden = false;
      summary.textContent = `今天 ${items.length} 条需要处理 · ${wrong} Wrong · ${uncertain} Uncertain。`;
    };

    const buildActionablePacket = (snapshot, todayReview) => {
      const ids = new Set(actionableItems(todayReview).map((item) => item.id));
      const packet = politicsReviewPacket(catalog, snapshot, { day: localStudyDay(), filter: 'today' });
      return {
        ...packet,
        events: packet.events.filter((event) => ids.has(event?.question_id)),
        review_context: packet.review_context.filter((item) => ids.has(item?.question_id))
      };
    };

    root.querySelector('[data-politics-copy-handoff]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget;
      if (!(button instanceof HTMLButtonElement)) return;
      const snapshot = readPoliticsSnapshot(localStorage);
      const todayReview = selectPoliticsReview(catalog, snapshot, { day: localStudyDay(), filter: 'today' });
      if (snapshot.errors.length || actionableItems(todayReview).length === 0) return;
      const text = JSON.stringify(buildActionablePacket(snapshot, todayReview), null, 2);
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copied';
      } catch {
        window.prompt('Copy Politics Handoff', text);
      }
      window.setTimeout(() => { button.textContent = "Copy Today's Handoff"; }, 1200);
    });

    const update = () => {
      const snapshot = readPoliticsSnapshot(localStorage);
      const allReview = selectPoliticsReview(catalog, snapshot);
      const todayReview = selectPoliticsReview(catalog, snapshot, { day: localStudyDay(), filter: 'today' });
      renderContinue(snapshot);
      renderHandoff(snapshot, todayReview);
      const link = root.querySelector('[data-politics-review-entry]');
      if (link) link.textContent = snapshot.errors.length ? '核对回访记录 →' : allReview.items.length ? `今日回访 · ${allReview.items.length} 题 →` : '回访与讨论 →';
    };
    update(); addEventListener('storage', update); addEventListener('focus', update);
  }
</script>

<style is:global>
  body#kianos-workspace.surfaceBody-politics [data-politics-home-tools][data-has-handoff="false"]{grid-template-columns:minmax(0,1fr)}
  body#kianos-workspace.surfaceBody-politics [data-politics-home-tools] .politicsHandoff[hidden]{display:none}
  body#kianos-workspace.surfaceBody-politics [data-politics-home-tools] .politicsContinue>small{font-size:16px;line-height:1.65}
  body#kianos-workspace.surfaceBody-politics [data-politics-home-tools] .politicsHandoff p{font-size:16px;line-height:1.65}
  body#kianos-workspace.surfaceBody-politics [data-politics-home-tools] .politicsReviewEntry{font-size:15px;line-height:1.5;color:#356c50;text-decoration:none}
  body#kianos-workspace.surfaceBody-politics [data-politics-home-tools] .politicsReviewEntry:hover{text-decoration:underline}
  body#kianos-workspace.surfaceBody-politics [data-politics-home-tools] .politicsHandoff button{font-size:14px;line-height:1.4}
  body#kianos-workspace.surfaceBody-politics [data-politics-home-tools][data-has-handoff="error"] .politicsHandoff{background:#fbfaf4}
  @media(max-width:760px){body#kianos-workspace.surfaceBody-politics [data-politics-home-tools]{grid-template-columns:1fr}}
</style>
