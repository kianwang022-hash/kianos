---
const { firstHref, firstLabel = '开始政治学习' } = Astro.props;
---
<section class="politicsHomeTools" data-politics-home-tools>
  <a class="politicsContinue" data-politics-continue href={firstHref}>
    <span>Continue</span>
    <strong data-politics-continue-title>{firstLabel}</strong>
    <small data-politics-continue-meta>从 Current 章节入口开始；之后自动回到最近打开的章节。</small>
  </a>
  <section class="politicsHandoff">
    <div>
      <span>Daily handoff</span>
      <strong>Wrong / Uncertain</strong>
      <p data-politics-handoff-summary>今天还没有需要带回 Chat 的政治证据。</p>
    </div>
    <button type="button" data-politics-copy-handoff>Copy Today's Handoff</button>
  </section>
</section>

<script>
  const root = document.querySelector('[data-politics-home-tools]');
  if (root instanceof HTMLElement) {
    const lastKey = 'kianos-politics-last-location-v1';
    const evidenceKey = 'kianos-politics-evidence-v1';
    const localStudyDay = () => new Date().toLocaleDateString('en-CA');
    const readJson = (key, fallback) => {
      try { return JSON.parse(localStorage.getItem(key) || 'null') || fallback; } catch { return fallback; }
    };

    const last = readJson(lastKey, null);
    const continueLink = root.querySelector('[data-politics-continue]');
    if (last?.href && continueLink instanceof HTMLAnchorElement) {
      continueLink.href = last.href;
      const title = root.querySelector('[data-politics-continue-title]');
      const meta = root.querySelector('[data-politics-continue-meta]');
      if (title) title.textContent = last.title || `${last.subject || ''} ${last.chapter || ''}`.trim() || '继续政治学习';
      if (meta) meta.textContent = `${last.subject || 'Politics'} · ${last.chapter || ''} · 最近打开`;
    }

    const todayEvents = () => {
      const events = readJson(evidenceKey, []);
      const day = localStudyDay();
      return Array.isArray(events) ? events.filter((event) => event?.study_day === day) : [];
    };

    const buildPacket = () => ({
      schema: 'kianos.politics.return_packet.v1',
      study_day: localStudyDay(),
      exported_at: new Date().toISOString(),
      last_location: readJson(lastKey, null),
      events: todayEvents()
    });

    const renderSummary = () => {
      const summary = root.querySelector('[data-politics-handoff-summary]');
      if (!summary) return;
      const events = todayEvents();
      const wrong = events.filter((event) => event.outcome === 'WRONG').length;
      const uncertain = events.filter((event) => event.outcome === 'UNCERTAIN').length;
      summary.textContent = events.length
        ? `今天 ${events.length} 条需要处理 · ${wrong} Wrong · ${uncertain} Uncertain。`
        : '今天还没有需要带回 Chat 的政治证据。';
    };

    root.querySelector('[data-politics-copy-handoff]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget;
      const text = JSON.stringify(buildPacket(), null, 2);
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copied';
      } catch {
        window.prompt('Copy Politics Handoff', text);
      }
      window.setTimeout(() => { button.textContent = "Copy Today's Handoff"; }, 1200);
    });

    renderSummary();
  }
</script>

<style>
  .politicsHomeTools{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px;margin-top:12px}.politicsContinue,.politicsHandoff{padding:18px 20px;border:1px solid var(--study-line);border-radius:14px;background:#fff;color:inherit}.politicsContinue{display:grid;gap:4px;text-decoration:none}.politicsContinue>span,.politicsHandoff span{color:var(--study-green);font-size:9px;font-weight:850;letter-spacing:.08em;text-transform:uppercase}.politicsContinue strong,.politicsHandoff strong{font-size:18px}.politicsContinue small{color:var(--study-faint);line-height:1.5}.politicsHandoff{display:flex;align-items:center;justify-content:space-between;gap:16px}.politicsHandoff>div{display:grid;gap:4px}.politicsHandoff p{margin:0;color:var(--study-muted);font-size:12px;line-height:1.55}.politicsHandoff button{padding:9px 12px;border:1px solid currentColor;border-radius:9px;background:#fff;color:inherit;font:inherit;font-size:12px;font-weight:760;cursor:pointer;white-space:nowrap}
  @media(max-width:760px){.politicsHomeTools{grid-template-columns:1fr}.politicsHandoff{align-items:stretch;flex-direction:column}.politicsHandoff button{white-space:normal}}
</style>
