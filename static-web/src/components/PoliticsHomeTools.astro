---
import { politicsProductCatalog } from '../lib/productCatalog.mjs';
const base = import.meta.env.BASE_URL;
const catalog = politicsProductCatalog(base);
const { firstHref, firstLabel = '开始政治学习' } = Astro.props;
---
<section class="politicsHomeTools" data-politics-home-tools data-base={base}>
  <script type="application/json" data-politics-home-catalog set:html={JSON.stringify(catalog).replace(/</g, '\\u003c')} />
  <a class="politicsContinue" data-politics-continue href={firstHref}>
    <span>Continue</span>
    <strong data-politics-continue-title>{firstLabel}</strong>
    <small data-politics-continue-meta>先选学习单元；之后回到原题、原学习位置。</small>
  </a>
  <section class="politicsHandoff">
    <div>
      <span>回访与讨论</span>
      <a class="politicsReviewEntry" data-politics-review-entry href={`${base}politics/review/`}>今日回访 →</a>
      <p data-politics-handoff-summary>今天还没有需要带回 Chat 的政治证据。</p>
    </div>
    <button type="button" data-politics-copy-handoff>Copy Today's Handoff</button>
  </section>
</section>

<script>
  import { readPoliticsSnapshot, selectPoliticsReview, resolvePoliticsContinue } from '../lib/politicsPracticeState.mjs';
  const root = document.querySelector('[data-politics-home-tools]');
  if (root instanceof HTMLElement) {
    const catalog = JSON.parse(root.querySelector('[data-politics-home-catalog]').textContent);
    root.querySelector('[data-politics-home-catalog]').remove();
    const base = root.dataset.base || '/';
    const firstHref = root.querySelector('[data-politics-continue]')?.getAttribute('href');
    const firstTitle = root.querySelector('[data-politics-continue-title]')?.textContent;
    const lastKey = 'kianos-politics-last-location-v1';
    const evidenceKey = 'kianos-politics-evidence-v1';
    const localStudyDay = () => new Date().toLocaleDateString('en-CA');
    const readJson = (key, fallback) => {
      try { return JSON.parse(localStorage.getItem(key) || 'null') || fallback; } catch { return fallback; }
    };

    const renderContinue = () => {
      const snapshot = readPoliticsSnapshot(localStorage);
      const target = snapshot.errors.length ? null : resolvePoliticsContinue(catalog, snapshot, base);
      const link = root.querySelector('[data-politics-continue]');
      if (link instanceof HTMLAnchorElement) link.href = target?.href || firstHref;
      root.querySelector('[data-politics-continue-title]').textContent = target?.title || firstTitle;
      root.querySelector('[data-politics-continue-meta]').textContent = snapshot.errors.length ? '记录未能完整读取，先核对存储。' : target?.detail || '先选学习单元；之后准确回到原位置。';
    };

    const todayEvents = () => {
      const events = readJson(evidenceKey, []);
      const day = localStudyDay();
      return Array.isArray(events) ? events.filter((event) => event?.study_day === day) : [];
    };

    const buildPacket = () => ({
      schema: 'kianos.politics.return_packet.v1',
      study_day: localStudyDay(),
      exported_at: new Date().toISOString(),
      last_location: readJson(lastKey, null),
      events: todayEvents()
    });

    const renderSummary = () => {
      const summary = root.querySelector('[data-politics-handoff-summary]');
      if (!summary) return;
      const events = todayEvents();
      const wrong = events.filter((event) => event.outcome === 'WRONG').length;
      const uncertain = events.filter((event) => event.outcome === 'UNCERTAIN').length;
      summary.textContent = events.length
        ? `今天 ${events.length} 条需要处理 · ${wrong} Wrong · ${uncertain} Uncertain。`
        : '今天还没有需要带回 Chat 的政治证据。';
    };

    root.querySelector('[data-politics-copy-handoff]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget;
      const text = JSON.stringify(buildPacket(), null, 2);
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copied';
      } catch {
        window.prompt('Copy Politics Handoff', text);
      }
      window.setTimeout(() => { button.textContent = "Copy Today's Handoff"; }, 1200);
    });

    const update = () => {
      renderContinue(); renderSummary();
      const snapshot = readPoliticsSnapshot(localStorage);
      const review = selectPoliticsReview(catalog, snapshot);
      const link = root.querySelector('[data-politics-review-entry]');
      link.textContent = snapshot.errors.length ? '核对回访记录 →' : review.items.length ? `今日回访 · ${review.items.length} 题 →` : '回访与讨论 →';
      // The active Review view is separate from immutable today's evidence export.
    };
    update(); addEventListener('storage', update); addEventListener('focus', update);
  }
</script>

<style>
  .politicsHomeTools{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px;margin-top:12px}
  .politicsContinue,.politicsHandoff{padding:18px 20px;border:1px solid var(--study-line);border-radius:14px;background:#fff;color:inherit}
  .politicsContinue{display:grid;gap:6px;text-decoration:none}
  .politicsContinue>span,.politicsHandoff span{color:var(--study-green);font-size:16px;line-height:1.4;font-weight:800;letter-spacing:.02em}
  .politicsContinue strong{font-size:20px;line-height:1.45}
  .politicsContinue small{color:var(--study-faint);font-size:17px;line-height:1.6}
  .politicsHandoff{display:flex;align-items:center;justify-content:space-between;gap:16px}
  .politicsHandoff>div{display:grid;gap:6px}
  .politicsReviewEntry{font-size:17px;line-height:1.5;font-weight:700}
  .politicsHandoff p{margin:0;color:var(--study-muted);font-size:17px;line-height:1.6}
  .politicsHandoff button{padding:10px 13px;border:1px solid currentColor;border-radius:9px;background:#fff;color:inherit;font:inherit;font-size:16px;line-height:1.4;font-weight:760;cursor:pointer;white-space:nowrap}
  @media(max-width:760px){.politicsHomeTools{grid-template-columns:1fr}.politicsHandoff{align-items:stretch;flex-direction:column}.politicsHandoff button{white-space:normal}}
</style>
