---
import { politicsProductCatalog } from '../lib/productCatalog.mjs';
import { buildPoliticsMemoryCandidateCatalogCurrent } from '../lib/politicsMemoryCandidates.mjs';
const base = import.meta.env.BASE_URL;
const catalog = politicsProductCatalog(base);
const memoryCatalog = buildPoliticsMemoryCandidateCatalogCurrent();
const { firstHref, firstLabel = '开始政治学习' } = Astro.props;
---
<section class="politicsHomeTools" data-politics-home-tools data-base={base}>
  <script type="application/json" data-politics-home-catalog set:html={JSON.stringify(catalog).replace(/</g, '\\u003c')} />
  <script type="application/json" data-politics-memory-catalog set:html={JSON.stringify(memoryCatalog).replace(/</g, '\\u003c')} />

  <a class="politicsContinueCard" data-politics-continue href={firstHref}>
    <span class="politicsHomeEyebrow">继续学习</span>
    <strong data-politics-continue-title>{firstLabel}</strong>
    <small data-politics-continue-meta>先选科目和章节；之后会准确回到原题或原学习位置。</small>
    <b>继续 →</b>
  </a>

  <section class="politicsTodayCard" aria-labelledby="politics-today-title">
    <header>
      <div>
        <span class="politicsHomeEyebrow">今天</span>
        <h2 id="politics-today-title">今日记录</h2>
      </div>
      <a href={`${base}politics/review/`} data-politics-review-entry>复习 →</a>
    </header>

    <div class="politicsTodayMetrics">
      <div><strong data-politics-today-attempts>0</strong><span>题</span></div>
      <div><strong data-politics-today-wrong>0</strong><span>错题</span></div>
      <div><strong data-politics-today-uncertain>0</strong><span>不确定</span></div>
    </div>

    <p class="politicsTodayQuiet" data-politics-today-quiet>今天还没有做题记录。</p>
  </section>

  <section class="politicsRecentCard" aria-labelledby="politics-recent-title">
    <header>
      <div>
        <span class="politicsHomeEyebrow">最近</span>
        <h2 id="politics-recent-title">学习痕迹</h2>
      </div>
      <a href={`${base}politics/learn/`}>进入学习 →</a>
    </header>
    <div class="politicsRecentList" data-politics-recent-list>
      <p>还没有政治学习记录。第一次进入后，这里会保留最近的位置和题目痕迹。</p>
    </div>
  </section>
</section>

<script>
  import { readPoliticsSnapshot, selectPoliticsReview, resolvePoliticsContinue } from '../lib/politicsPracticeState.mjs';
  import { resolvePoliticsMemoryResume } from '../lib/politicsMemoryRuntime.mjs';
  const root = document.querySelector('[data-politics-home-tools]');
  if (root instanceof HTMLElement) {
    const catalogNode = root.querySelector('[data-politics-home-catalog]');
    const catalog = JSON.parse(catalogNode?.textContent || '{}');
    catalogNode?.remove();
    const memoryCatalogNode = root.querySelector('[data-politics-memory-catalog]');
    const memoryCatalog = JSON.parse(memoryCatalogNode?.textContent || '{}');
    memoryCatalogNode?.remove();
    const base = root.dataset.base || '/';
    const firstHref = root.querySelector('[data-politics-continue]')?.getAttribute('href') || `${base}politics/learn/`;
    const firstTitle = root.querySelector('[data-politics-continue-title]')?.textContent || '选择科目和章节';
    const localStudyDay = () => new Date().toLocaleDateString('en-CA');

    const outcomeLabel = (outcome) => outcome === 'WRONG' ? '错题' : outcome === 'UNCERTAIN' ? '不确定' : '已完成';

    const renderContinue = (snapshot) => {
      const link = root.querySelector('[data-politics-continue]');
      const title = root.querySelector('[data-politics-continue-title]');
      const meta = root.querySelector('[data-politics-continue-meta]');
      let memory = null;
      try {
        memory = resolvePoliticsMemoryResume(localStorage, memoryCatalog, { expectedDay: localStudyDay() });
      } catch {}

      if (memory?.status === 'ACTIVE') {
        if (link instanceof HTMLAnchorElement) {
          link.href = `${base}politics/memory/`;
          link.setAttribute('data-session-ref', memory.plan?.plan_id || memory.plan_id || '');
        }
        if (title) title.textContent = memory.candidate?.prompt
          ? `今日记忆 · ${memory.candidate.prompt}`
          : '今日记忆';
        if (meta) meta.textContent = memory.item?.reason || `Chat 已选择第 ${memory.index + 1} / ${memory.total} 个记忆对象。`;
        return;
      }

      const target = snapshot.errors.length ? null : resolvePoliticsContinue(catalog, snapshot, base);
      if (link instanceof HTMLAnchorElement) {
        link.href = target?.href || firstHref;
        link.removeAttribute('data-session-ref');
      }
      if (title) title.textContent = target?.title || firstTitle;
      if (meta) meta.textContent = snapshot.errors.length
        ? '记录未能完整读取，先进入复习核对。'
        : target?.detail || '先选科目和章节；之后会准确回到原位置。';
    };

    const actionableItems = (review) => review.items.filter((item) => item.needsReview);

    const todayAttemptIds = (snapshot, day) => {
      const ids = new Set();
      for (const unit of Object.values(snapshot.attempts?.units || {})) {
        for (const attempt of Object.values(unit?.attempts || {})) {
          if (attempt?.study_day === day && attempt?.question_id) ids.add(attempt.question_id);
        }
      }
      return ids;
    };

    const renderToday = (snapshot, todayReview) => {
      const day = localStudyDay();
      const items = actionableItems(todayReview);
      const attempts = todayAttemptIds(snapshot, day);
      const wrong = items.filter((item) => item.outcome === 'WRONG').length;
      const uncertain = items.filter((item) => item.outcome === 'UNCERTAIN').length;
      const quiet = root.querySelector('[data-politics-today-quiet]');

      root.querySelector('[data-politics-today-attempts]')?.replaceChildren(snapshot.errors.length ? '—' : String(attempts.size));
      root.querySelector('[data-politics-today-wrong]')?.replaceChildren(snapshot.errors.length ? '—' : String(wrong));
      root.querySelector('[data-politics-today-uncertain]')?.replaceChildren(snapshot.errors.length ? '—' : String(uncertain));

      if (!quiet) return;
      if (snapshot.errors.length) {
        quiet.textContent = '记录未能完整读取，先进入复习核对。';
      } else if (!attempts.size) {
        quiet.textContent = '今天还没有做题记录。';
      } else if (items.length) {
        quiet.textContent = `有 ${items.length} 题值得回看；想复盘时从「复习」一次性导出学习包。`;
      } else {
        quiet.textContent = '今天没有待处理的错题或不确定题。';
      }
    };

    const renderRecent = (snapshot) => {
      const list = root.querySelector('[data-politics-recent-list]');
      if (!(list instanceof HTMLElement)) return;
      const rows = [];
      const seen = new Set();
      const events = [...(snapshot.events || [])]
        .filter((event) => event?.question_id)
        .sort((a, b) => String(b.observed_at || '').localeCompare(String(a.observed_at || '')));
      for (const event of events) {
        if (seen.has(event.question_id)) continue;
        seen.add(event.question_id);
        const q = catalog.questions?.find((candidate) => candidate.id === event.question_id);
        if (!q) continue;
        const currentOutcome = snapshot.meta?.latestOutcome?.[q.id] || event.outcome;
        rows.push({
          title: `${q.subjectLabel} · ${q.chapterTitle}`,
          meta: `第 ${q.number} 题 · ${outcomeLabel(currentOutcome)}`,
          href: `${base}politics/practice/`
        });
        if (rows.length === 3) break;
      }

      if (!rows.length && snapshot.last?.href) {
        rows.push({
          title: snapshot.last.title || '上次学习位置',
          meta: '上次停在这里',
          href: snapshot.last.href
        });
      }

      if (!rows.length) {
        list.innerHTML = '<p>还没有政治学习记录。第一次进入后，这里会保留最近的位置和题目痕迹。</p>';
        return;
      }

      list.replaceChildren(...rows.map((row) => {
        const link = document.createElement('a');
        link.href = row.href;
        const strong = document.createElement('strong');
        strong.textContent = row.title;
        const span = document.createElement('span');
        span.textContent = row.meta;
        link.append(strong, span);
        return link;
      }));
    };



    const publishContinue = () => {
      const link = root.querySelector('[data-politics-continue]');
      const title = root.querySelector('[data-politics-continue-title]');
      if (!(link instanceof HTMLAnchorElement)) return;
      window.dispatchEvent(new CustomEvent('kianos:subject-continue-updated', {
        detail: {
          subject:'politics',
          href:link.getAttribute('href'),
          title:title?.textContent?.trim() || '政治',
          session_ref:link.getAttribute('data-session-ref') || null
        }
      }));
    };

    const update = () => {
      const snapshot = readPoliticsSnapshot(localStorage);
      const allReview = selectPoliticsReview(catalog, snapshot);
      const todayReview = selectPoliticsReview(catalog, snapshot, { day: localStudyDay(), filter: 'today' });
      renderContinue(snapshot);
      renderToday(snapshot, todayReview);
      renderRecent(snapshot);
      const link = root.querySelector('[data-politics-review-entry]');
      if (link) link.textContent = snapshot.errors.length
        ? '核对记录 →'
        : allReview.items.length ? `复习 · ${allReview.items.length} 题 →` : '复习 →';
      publishContinue();
    };

    update();
    addEventListener('storage', update);
    addEventListener('focus', update);
    addEventListener('kianos:politics-memory-plan-updated', update);
    addEventListener('kianos:subject-continue-requested', (event) => {
      const subject = event?.detail?.subject || null;
      if (!subject || subject === 'politics') update();
    });
  }
</script>
