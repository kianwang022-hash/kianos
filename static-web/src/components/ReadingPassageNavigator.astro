---
const { reading } = Astro.props;
const base = import.meta.env.BASE_URL;
const navigation = reading?.navigation || {};
const hrefFor = (id) => id ? `${base}reading/${encodeURIComponent(id)}` : '';
---
{navigation.total > 1 && (
  <aside class="portedReadingPassageNavigator" data-reading-passage-navigator hidden>
    <span>第 {navigation.position} / {navigation.total} 篇</span>
    <div>
      {navigation.previousId && <a href={hrefFor(navigation.previousId)}>← 上一篇</a>}
      {navigation.nextId
        ? <a class="primary" href={hrefFor(navigation.nextId)}>下一篇 →</a>
        : <b>已到最后一篇</b>}
    </div>
  </aside>
)}

<script>
  const passageNavigator = document.querySelector('[data-reading-passage-navigator]');
  const result = document.querySelector('[data-reading-result]');
  if (passageNavigator && result) {
    const sync = () => { passageNavigator.hidden = result.hasAttribute('hidden'); };
    new MutationObserver(sync).observe(result, { attributes: true, attributeFilter: ['hidden'] });
    sync();
  }
</script>
