        "construction_id": "construction:64b2c798c56245fe1793",
        "pattern": "grasp at straws",
        "meaning_cn": "在绝望中抓住任何希望；病急乱投医",
        "definition_en": "to try any possible means out of desperation",
        "usage_note": "表示处境绝望时连很渺茫的办法也尝试；不是一般抓住机会。",
        "boundary": "表示处境绝望时连很渺茫的办法也尝试；不是一般抓住机会。",
        "direction": "R+P",
        "level": "L2"
      }
    ],
    "content_hash": "15ff6d6a7dcb01cde830a14c395d2971fa799ffbfba81c3f924fadb4e0afe680",
    "core_concept": {
      "core_clusters": [
        {
          "label_cn": "抓牢；抓住（机会等）；领会，理解",
          "label_en": "to seize and hold firmly, or to seize an opportunity eagerly; to understand something completely",
          "pos": "verb",
          "sense_ids": [
            "sense:grasp:0baeb7afc52f565c",
            "sense:grasp:c3d41b648533514c"
