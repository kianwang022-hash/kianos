        "pattern": "by + time/deadline",
        "meaning_cn": "不迟于某个时间；截至某时之前",
        "definition_en": "at or before a specified time; no later than the stated deadline",
        "boundary": "by Friday includes any time up to Friday; it does not mean only during Friday.",
