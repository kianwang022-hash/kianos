    {
      "id": "a2-r06-cavity-to-r11-tumor",
      "source": {"block_id": "respiratory-r06", "logic_group_id": "respiratory-r06-lg04", "cue": "空腔鉴别里先保留肿瘤这一支，肺癌正式内容留到 R11。"},
      "target": {"block_id": "respiratory-r11", "logic_group_id": "respiratory-r11-lg02", "cue": "你在 R6 的空腔鉴别见过肿瘤；现在把它放回肺癌的位置、侵犯和影像证据。"},
      "reserve_recall": false
    },
    {
      "id": "a2-r08-ild-to-r09-pulmonary-hypertension",
      "source": {"block_id": "respiratory-r08", "logic_group_id": "respiratory-r08-lg01", "cue": "慢性低氧/结构病可继续走向肺高压和右心负荷；R9 正式展开。"},
      "target": {"block_id": "respiratory-r09", "logic_group_id": "respiratory-r09-lg01", "cue": "你在 ILD 已经见过慢性低氧这个上游；现在正式接到 PVR↑ 和右室重构。"},
      "reserve_recall": true
    },
    {
      "id": "a2-r10-pleural-effusion-to-r07-tb",
      "source": {"block_id": "respiratory-r10", "logic_group_id": "respiratory-r10-lg03", "cue": "结核性胸水这里只学胸膜证据；结核本体仍由 R7 负责。"},
      "target": {"block_id": "respiratory-r07", "logic_group_id": "respiratory-r07-lg05", "cue": "胸水场景曾调用结核证据；回到 R7 时把感染、活动和传染性证据重新分层。"},
      "reserve_recall": false
    },
    {
      "id": "a2-r10-pleural-effusion-to-r11-malignancy",
