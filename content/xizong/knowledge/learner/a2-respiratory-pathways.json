      "target": {"block_id": "respiratory-r11", "logic_group_id": "respiratory-r11-lg04", "cue": "你在胸水鉴别见过恶性证据；现在正式进入肺癌的发现、取材、分期和组织证据。"},
      "reserve_recall": false
    }
  ]
