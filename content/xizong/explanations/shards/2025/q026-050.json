[{"question_id":"xizong-official-2025-n026","truth_gate":"PASS","explanation_status":"APPROVED","question_truth_ref":{"path":"content/xizong/questions/shards/2025/q026-050.json","blob_sha":"23e479f2c6b8d44bff16f66fda236e70274ba070","source_status":"CURRENT_FORMAL_QUESTION_TRUTH"},"exam_target":"重组DNA医学应用","decision_axis":"重组DNA技术可构建表达载体并生产重组蛋白等基因工程药物。","reasoning_chain":["重组DNA技术的核心是把目标DNA片段装入载体，并在宿主细胞中复制或表达。","这使人胰岛素、细胞因子等重组蛋白可以作为基因工程药物生产，因此选C。","中药成分提取、影像改进和体内药物示踪都不是重组DNA技术的直接定义性应用。"],"transfer_rule":"重组DNA医学应用最典型：构建表达系统→生产重组蛋白/基因工程药物。","mapping_decision":"NEEDS_CHAT_MAPPING_REVIEW","upgrade_decision":"NO_CHANGE","review":{"semantic_owner":"Chat","format":"FAST_OWNER","learner_state_included":false,"old_explanation_inherited":false}},{"question_id":"xizong-official-2025-n027","truth_gate":"PASS","explanation_status":"APPROVED","question_truth_ref":{"path":"content/xizong/questions/shards/2025/q026-050.json","blob_sha":"23e479f2c6b8d44bff16f66fda236e70274ba070","source_status":"CURRENT_FORMAL_QUESTION_TRUTH"},"exam_target":"小G蛋白Ras","decision_axis":"Ras是单体小GTP酶，通过GDP/GTP转换作分子开关。","reasoning_chain":["Ras属于单体小G蛋白，也就是小GTP酶家族。","它通过GDP结合的关闭态与GTP结合的激活态切换，充当细胞信号转导的分子开关，因此选B。","异三聚体G蛋白虽然也结合GTP，但结构和分类上不是题目所问的“小G蛋白”。"],"transfer_rule":"小G蛋白高频代表=Ras；本质是GDP/GTP开关。","mapping_decision":"NEEDS_CHAT_MAPPING_REVIEW","upgrade_decision":"NO_CHANGE","review":{"semantic_owner":"Chat","format":"FAST_OWNER","learner_state_included":false,"old_explanation_inherited":false}},{"question_id":"xizong-official-2025-n028","truth_gate":"PASS","explanation_status":"APPROVED","question_truth_ref":{"path":"content/xizong/questions/shards/2025/q026-050.json","blob_sha":"23e479f2c6b8d44bff16f66fda236e70274ba070","source_status":"CURRENT_FORMAL_QUESTION_TRUTH"},"exam_target":"PTEN酶活性","decision_axis":"PTEN主要是脂质磷酸酶，把PIP3去磷酸化为PIP2，抑制PI3K-AKT。","reasoning_chain":["PTEN的经典抑癌作用来自其磷酸酶活性。","它可把PIP3去磷酸化回PIP2，从而拮抗PI3K-AKT促存活/促生长信号，所以选C。","因此PTEN不是激酶、乙酰化酶或硫解酶。"],"transfer_rule":"PTEN=磷酸酶；PI3K做PIP3，PTEN把PIP3去掉磷酸、踩刹车。","mapping_decision":"NEEDS_CHAT_MAPPING_REVIEW","upgrade_decision":"NO_CHANGE","review":{"semantic_owner":"Chat","format":"FAST_OWNER","learner_state_included":false,"old_explanation_inherited":false}},{"question_id":"xizong-official-2025-n029","truth_gate":"PASS","explanation_status":"APPROVED","question_truth_ref":{"path":"content/xizong/questions/shards/2025/q026-050.json","blob_sha":"23e479f2c6b8d44bff16f66fda236e70274ba070","source_status":"CURRENT_FORMAL_QUESTION_TRUTH"},"exam_target":"Mallory-Denk小体组成","decision_axis":"Mallory-Denk小体主要由异常聚集的角蛋白中间丝及相关蛋白构成。","reasoning_chain":["酒精性肝炎的Mallory-Denk小体是肝细胞内嗜酸性胞质包涵体。","其主要成分是异常聚集的角蛋白中间丝及相关蛋白，因此D正确。","它不是变性的线粒体、内质网或过氧化物酶体本身。"],"transfer_rule":"Mallory-Denk小体→角蛋白中间丝聚集。","mapping_decision":"NEEDS_CHAT_MAPPING_REVIEW","upgrade_decision":"NO_CHANGE","review":{"semantic_owner":"Chat","format":"FAST_OWNER","learner_state_included":false,"old_explanation_inherited":false}},{"question_id":"xizong-official-2025-n030","truth_gate":"PASS","explanation_status":"APPROVED","question_truth_ref":{"path":"content/xizong/questions/shards/2025/q026-050.json","blob_sha":"23e479f2c6b8d44bff16f66fda236e70274ba070","source_status":"CURRENT_FORMAL_QUESTION_TRUTH"},"exam_target":"结核结节上皮样细胞来源","decision_axis":"上皮样细胞是受激活巨噬细胞发生形态转变形成的。","reasoning_chain":["结核结节中的上皮样细胞名字像“上皮”，但来源并不是肺泡或鳞状上皮。","它们本质上是被细胞免疫激活后发生形态改变的巨噬细胞，因此选D。","进一步融合还可形成Langhans型多核巨细胞。"],"transfer_rule":"肉芽肿里的上皮样细胞=活化巨噬细胞，不是真正上皮细胞。","mapping_decision":"NEEDS_CHAT_MAPPING_REVIEW","upgrade_decision":"NO_CHANGE","review":{"semantic_owner":"Chat","format":"FAST_OWNER","learner_state_included":false,"old_explanation_inherited":false}},{"question_id":"xizong-official-2025-n031","truth_gate":"PASS","explanation_status":"APPROVED","question_truth_ref":{"path":"content/xizong/questions/shards/2025/q026-050.json","blob_sha":"23e479f2c6b8d44bff16f66fda236e70274ba070","source_status":"CURRENT_FORMAL_QUESTION_TRUTH"},"exam_target":"类风湿小结坏死","decision_axis":"类风湿结节中央为纤维素样坏死，周围有栅栏状组织细胞。","reasoning_chain":["类风湿结节中央的典型病理改变是纤维素样坏死。","其周围常见组织细胞/巨噬细胞呈栅栏状排列，外围再有慢性炎细胞和纤维组织，因此选C。","干酪样坏死更典型见于结核；液化性坏死常见于脓肿等。"],"transfer_rule":"类风湿结节：中央纤维素样坏死 + 周围栅栏状组织细胞。","mapping_decision":"NEEDS_CHAT_MAPPING_REVIEW","upgrade_decision":"NO_CHANGE","review":{"semantic_owner":"Chat","format":"FAST_OWNER","learner_state_included":false,"old_explanation_inherited":false}},{"question_id":"xizong-official-2025-n032","truth_gate":"PASS","explanation_status":"APPROVED","question_truth_ref":{"path":"content/xizong/questions/shards/2025/q026-050.json","blob_sha":"23e479f2c6b8d44bff16f66fda236e70274ba070","source_status":"CURRENT_FORMAL_QUESTION_TRUTH"},"exam_target":"凋亡形态","decision_axis":"凋亡表现细胞固缩、染色质浓缩、膜完整伴出芽和凋亡小体，通常炎症不明显。","reasoning_chain":["凋亡细胞通常发生固缩，染色质浓缩和核碎裂，但细胞膜及细胞器膜总体保持完整。","膜可出现发泡、出芽并形成凋亡小体，所以A完整符合凋亡形态。","细胞肿胀、膜破裂和细胞自溶属于坏死方向。"],"transfer_rule":"凋亡=细胞缩小、膜完整、出芽/凋亡小体；坏死=细胞肿胀、膜破裂。","mapping_decision":"NEEDS_CHAT_MAPPING_REVIEW","upgrade_decision":"NO_CHANGE","review":{"semantic_owner":"Chat","format":"FAST_OWNER","learner_state_included":false,"old_explanation_inherited":false}},{"question_id":"xizong-official-2025-n033","truth_gate":"PASS","explanation_status":"APPROVED","question_truth_ref":{"path":"content/xizong/questions/shards/2025/q026-050.json","blob_sha":"23e479f2c6b8d44bff16f66fda236e70274ba070","source_status":"CURRENT_FORMAL_QUESTION_TRUTH"},"exam_target":"动脉瘤附壁血栓","decision_axis":"动脉瘤内血流紊乱和涡流可形成层状混合血栓。","reasoning_chain":["动脉瘤腔内血流明显紊乱，既有靠壁的血小板/纤维蛋白沉积，也可夹杂红细胞丰富的成分。","这种层状、成分混合的附壁血栓属于混合血栓，因此选B。","白色血栓更强调血小板和纤维蛋白，红色血栓多见于血流缓慢/停滞环境的静脉。"],"transfer_rule":"动脉瘤附壁血栓常是层状混合血栓，抓“血流紊乱+多成分”。","mapping_decision":"NEEDS_CHAT_MAPPING_REVIEW","upgrade_decision":"NO_CHANGE","review":{"semantic_owner":"Chat","format":"FAST_OWNER","learner_state_included":false,"old_explanation_inherited":false}},{"question_id":"xizong-official-2025-n034","truth_gate":"PASS","explanation_status":"APPROVED","question_truth_ref":{"path":"content/xizong/questions/shards/2025/q026-050.json","blob_sha":"23e479f2c6b8d44bff16f66fda236e70274ba070","source_status":"CURRENT_FORMAL_QUESTION_TRUTH"},"exam_target":"白细胞游出部位","decision_axis":"急性炎症中白细胞黏附和穿越血管壁主要发生在毛细血管后小静脉。","reasoning_chain":["急性炎症时白细胞要先滚动、黏附，再穿过血管壁进入组织。","这些步骤最典型发生在毛细血管后小静脉，因为此处内皮黏附分子表达和血流条件最适合白细胞游出，因此选D。","毛细血管主要承担物质交换，并不是白细胞游出的主要经典部位。"],"transfer_rule":"白细胞游出主战场=毛细血管后小静脉。","mapping_decision":"NEEDS_CHAT_MAPPING_REVIEW","upgrade_decision":"NO_CHANGE","review":{"semantic_owner":"Chat","format":"FAST_OWNER","learner_state_included":false,"old_explanation_inherited":false}},{"question_id":"xizong-official-2025-n035","truth_gate":"PASS","explanation_status":"APPROVED","question_truth_ref":{"path":"content/xizong/questions/shards/2025/q026-050.json","blob_sha":"23e479f2c6b8d44bff16f66fda236e70274ba070","source_status":"CURRENT_FORMAL_QUESTION_TRUTH"},"exam_target":"小细胞肺癌病理","decision_axis":"小而胞质少、核深染且核分裂多的肿瘤细胞支持小细胞癌。","reasoning_chain":["按题干与选项，依据上述判断轴确定题源答案。"],"transfer_rule":"SCLC=small blue cells+scant cytoplasm+high mitosis。","mapping_decision":"NEEDS_CHAT_MAPPING_REVIEW","upgrade_decision":"NO_CHANGE","review":{"semantic_owner":"Chat","format":"FAST_OWNER","learner_state_included":false,"old_explanation_inherited":false}},{"question_id":"xizong-official-2025-n036","truth_gate":"PASS","explanation_status":"APPROVED","question_truth_ref":{"path":"content/xizong/questions/shards/2025/q026-050.json","blob_sha":"23e479f2c6b8d44bff16f66fda236e70274ba070","source_status":"CURRENT_FORMAL_QUESTION_TRUTH"},"exam_target":"慢性肝炎碎片状坏死","decision_axis":"界板周围肝细胞坏死并突破界板，传统称碎片状坏死/界面性肝炎。","reasoning_chain":["“肝小叶界板周围”并且“突破界板”是本题的定位关键词。","这种小叶周边界面处的灶性肝细胞坏死传统称碎片状坏死，也叫界面性肝炎，因此选B。","桥接坏死强调坏死带连接门管区和/或中央静脉；点状坏死则只是小叶内散在少数肝细胞坏死。"],"transfer_rule":"突破界板→碎片状坏死/界面性肝炎；形成连接带才叫桥接坏死。","mapping_decision":"NEEDS_CHAT_MAPPING_REVIEW","upgrade_decision":"NO_CHANGE","review":{"semantic_owner":"Chat","format":"FAST_OWNER","learner_state_included":false,"old_explanation_inherited":false}},{"question_id":"xizong-official-2025-n037","truth_gate":"PASS","explanation_status":"APPROVED","question_truth_ref":{"path":"content/xizong/questions/shards/2025/q026-050.json","blob_sha":"23e479f2c6b8d44bff16f66fda236e70274ba070","source_status":"CURRENT_FORMAL_QUESTION_TRUTH"},"exam_target":"胃低黏附性癌","decision_axis":"印戒细胞癌属于胃低黏附性癌，细胞黏附性差并可弥漫浸润。","reasoning_chain":["胃低黏附性癌的核心是肿瘤细胞彼此黏附差，常呈散在或弥漫浸润。","印戒细胞癌是其经典形态类型，因此选B。","管状、乳头状腺癌仍以腺体/乳头结构为主，并不属于低黏附性癌这一代表类型。"],"transfer_rule":"胃低黏附性癌高频代表=印戒细胞癌。","mapping_decision":"NEEDS_CHAT_MAPPING_REVIEW","upgrade_decision":"NO_CHANGE","review":{"semantic_owner":"Chat","format":"FAST_OWNER","learner_state_included":false,"old_explanation_inherited":false}},{"question_id":"xizong-official-2025-n038","truth_gate":"PASS","explanation_status":"APPROVED","question_truth_ref":{"path":"content/xizong/questions/shards/2025/q026-050.json","blob_sha":"23e479f2c6b8d44bff16f66fda236e70274ba070","source_status":"CURRENT_FORMAL_QUESTION_TRUTH"},"exam_target":"脓肿的液化性坏死","decision_axis":"化脓菌释放水解酶导致组织溶解，脓肿中心典型为液化性坏死。","reasoning_chain":["金黄色葡萄球菌属于典型化脓菌，可大量招募中性粒细胞并释放水解酶。","组织在酶作用下被消化成液体性脓液，所以脓肿中心的坏死类型是液化性坏死，选D。","干酪样坏死更典型见结核，凝固性坏死常见于多数实体器官缺血梗死。"],"transfer_rule":"化脓菌脓肿→酶性消化→液化性坏死。","mapping_decision":"NEEDS_CHAT_MAPPING_REVIEW","upgrade_decision":"NO_CHANGE","review":{"semantic_owner":"Chat","format":"FAST_OWNER","learner_state_included":false,"old_explanation_inherited":false}},{"question_id":"xizong-official-2025-n039","truth_gate":"PASS","explanation_status":"APPROVED","question_truth_ref":{"path":"content/xizong/questions/shards/2025/q026-050.json","blob_sha":"23e479f2c6b8d44bff16f66fda236e70274ba070","source_status":"CURRENT_FORMAL_QUESTION_TRUTH"},"exam_target":"淋巴瘤的克隆性","decision_axis":"淋巴瘤是单克隆淋巴细胞异常增殖，克隆性比单一形态更具本质意义。","reasoning_chain":["淋巴瘤的本质是某一淋巴细胞克隆发生恶性增殖，因此“单克隆增殖”最具本质意义，选B。","细胞大小一致、核仁显著或核分裂多都可能在某些亚型出现，但不是定义所有淋巴瘤的共同核心。","诊断时应结合组织结构、免疫表型和克隆性，而不是只凭一个形态词。"],"transfer_rule":"淋巴瘤最本质的病理概念=淋巴细胞单克隆恶性增殖。","mapping_decision":"NEEDS_CHAT_MAPPING_REVIEW","upgrade_decision":"NO_CHANGE","review":{"semantic_owner":"Chat","format":"FAST_OWNER","learner_state_included":false,"old_explanation_inherited":false}},{"question_id":"xizong-official-2025-n040","truth_gate":"PASS","explanation_status":"APPROVED","question_truth_ref":{"path":"content/xizong/questions/shards/2025/q026-050.json","blob_sha":"23e479f2c6b8d44bff16f66fda236e70274ba070","source_status":"CURRENT_FORMAL_QUESTION_TRUTH"},"exam_target":"绒毛膜癌病理","decision_axis":"绒毛膜癌由恶性细胞滋养层和合体滋养层组成，通常无绒毛并常出血坏死。","reasoning_chain":["绒毛膜癌由恶性的细胞滋养层细胞和合体滋养层细胞两种成分构成，因此B正确。","它常有显著出血坏死，但肿瘤自身缺乏真正的绒毛间质和血管，肿瘤细胞直接侵蚀母体血管，因此C中“肿瘤血管丰富”使整项错误。","绒毛膜癌典型无绒毛结构，所以D也错误；肉眼常偏暗红、出血坏死而不是灰白质硬。"],"transfer_rule":"绒毛膜癌“三无”抓手：无绒毛、无间质、无自身血管；由两种恶性滋养层细胞组成。","mapping_decision":"NEEDS_CHAT_MAPPING_REVIEW","upgrade_decision":"NO_CHANGE","review":{"semantic_owner":"Chat","format":"FAST_OWNER","learner_state_included":false,"old_explanation_inherited":false}},{"question_id":"xizong-official-2025-n041","truth_gate":"PASS","explanation_status":"APPROVED","question_truth_ref":{"path":"content/xizong/questions/shards/2025/q026-050.json","blob_sha":"23e479f2c6b8d44bff16f66fda236e70274ba070","source_status":"CURRENT_FORMAL_QUESTION_TRUTH"},"exam_target":"主动脉瓣关闭不全听诊","decision_axis":"AR典型为舒张早期递减型叹气样杂音，前倾呼气更清楚；S1并非典型亢进。","reasoning_chain":["主动脉瓣关闭不全时舒张期主动脉血反流进入左室，典型杂音是高调、叹气样、递减型舒张期杂音，坐位前倾呼气末更清楚。","慢性明显反流还可在心尖部出现Austin-Flint样舒张期杂音，所以B、C、D均可成立。","容量负荷使二尖瓣开放位置改变，第一心音通常减弱而不是亢进，因此错误项是A。"],"transfer_rule":"主闭听诊：舒张期递减叹气样杂音；S1常减弱，重度可有Austin-Flint杂音。","mapping_decision":"NEEDS_CHAT_MAPPING_REVIEW","upgrade_decision":"NO_CHANGE","review":{"semantic_owner":"Chat","format":"FAST_OWNER","learner_state_included":false,"old_explanation_inherited":false}},{"question_id":"xizong-official-2025-n042","truth_gate":"PASS","explanation_status":"APPROVED","question_truth_ref":{"path":"content/xizong/questions/shards/2025/q026-050.json","blob_sha":"23e479f2c6b8d44bff16f66fda236e70274ba070","source_status":"CURRENT_FORMAL_QUESTION_TRUTH"},"exam_target":"异形红细胞提示肾小球血尿","decision_axis":"大量异形红细胞强烈支持肾小球来源血尿。","reasoning_chain":["按题干与选项，依据上述判断轴确定题源答案。"],"transfer_rule":"dysmorphic RBC→glomerular hematuria。","mapping_decision":"NEEDS_CHAT_MAPPING_REVIEW","upgrade_decision":"NO_CHANGE","review":{"semantic_owner":"Chat","format":"FAST_OWNER","learner_state_included":false,"old_explanation_inherited":false}},{"question_id":"xizong-official-2025-n043","truth_gate":"PASS","explanation_status":"APPROVED","question_truth_ref":{"path":"content/xizong/questions/shards/2025/q026-050.json","blob_sha":"23e479f2c6b8d44bff16f66fda236e70274ba070","source_status":"CURRENT_FORMAL_QUESTION_TRUTH"},"exam_target":"肺鳞癌与EGFR","decision_axis":"肺鳞癌与吸烟、中央型生长关系较强，而EGFR驱动突变更常见于肺腺癌。","reasoning_chain":["肺鳞癌与吸烟关系密切，而且多数为中央型，因此A、B符合经典特征。","EGFR驱动突变更常见于肺腺癌，特别是不吸烟者等人群，并不是肺鳞癌的高检出特征。","所以本题明确不符合项是D；不要把肺腺癌的分子特征套到鳞癌。"],"transfer_rule":"肺鳞癌抓吸烟+中央型；EGFR高突变率更偏肺腺癌。","mapping_decision":"NEEDS_CHAT_MAPPING_REVIEW","upgrade_decision":"NO_CHANGE","review":{"semantic_owner":"Chat","format":"FAST_OWNER","learner_state_included":false,"old_explanation_inherited":false}},{"question_id":"xizong-official-2025-n044","truth_gate":"PASS","explanation_status":"APPROVED","question_truth_ref":{"path":"content/xizong/questions/shards/2025/q026-050.json","blob_sha":"23e479f2c6b8d44bff16f66fda236e70274ba070","source_status":"CURRENT_FORMAL_QUESTION_TRUTH"},"exam_target":"COPD持续气流受限","decision_axis":"支气管扩张剂后FEV1/FVC仍低于0.70支持持续性气流受限。","reasoning_chain":["FEV1/FVC<0.70只能说明存在阻塞性通气障碍，关键还要看气流受限是否在支气管扩张后仍持续存在。","吸入支气管扩张剂后FEV1/FVC仍<0.70，才体现COPD“不完全可逆/持续气流受限”的核心，因此选B。","组胺激发试验更用于气道高反应性；RV/TLC升高提示气体潴留/肺气肿但不能替代持续气流受限标准。"],"transfer_rule":"COPD诊断抓“支扩后仍低的一秒率”，不是单次FEV1/FVC低。","mapping_decision":"NEEDS_CHAT_MAPPING_REVIEW","upgrade_decision":"NO_CHANGE","review":{"semantic_owner":"Chat","format":"FAST_OWNER","learner_state_included":false,"old_explanation_inherited":false}},{"question_id":"xizong-official-2025-n045","truth_gate":"PASS","explanation_status":"APPROVED","question_truth_ref":{"path":"content/xizong/questions/shards/2025/q