{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kianos.english.external_public_identity.v1",
  "title": "KianOS External Reading Public Identity",
  "description": "Metadata-only public identity. Copyrighted source bytes and private learner exposure do not belong here.",
  "type": "object",
  "required": [
    "object_id",
    "source_family",
    "source_format",
    "collection",
    "passage_number",
    "question_count",
    "source_owner",
    "source_quality"
  ],
  "properties": {
    "object_id": {
      "type": "string",
      "pattern": "^(tpo[0-9]+-p[0-9]+|ielts[0-9]+-t[0-9]+-p[0-9]+|external-[A-Za-z0-9._:-]+)$"
    },
    "source_family": {
      "enum": [
        "TOEFL_TPO",
        "IELTS_ACADEMIC",
        "PERIODICAL_READING",
        "OTHER_READING"
      ]
    },
    "source_format": {
      "enum": [
        "TOEFL_LEGACY",
        "IELTS_ACADEMIC",
        "ARTICLE",
        "OTHER"
      ]
    },
    "collection": {
      "type": "string",
      "minLength": 1
    },
    "test": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "passage_number": {
      "type": "integer",
      "minimum": 1
    },
    "question_count": {
      "type": "integer",
      "minimum": 0
    },
    "source_owner": {
      "type": "string",
      "minLength": 1
    },
    "source_quality": {
      "enum": [
        "CANDIDATE_NOT_PROVEN_CLEAN",
        "PROVEN_CLEAN",
        "SOURCE_BLOCKED"
      ]
    },
    "known_source_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
