{
  "schema": "kianos.english.external_manifest.v3",
  "status": "IMPORT_ADAPTER_TARGET",
  "owner_path": "content/english/external/",
  "object_schema": "content/english/external/schema.json",
  "learning_owner": "content/english/LEARNING_CONTRACT.md",
  "purpose": "High-quality reading-growth input beyond English-I true papers. Reuse Reading workspace geometry where useful without importing English-I Reading-A question strategy into TOEFL/IELTS material.",
  "source_priority": [
    "legacy TOEFL / TPO academic reading (TPO 56-65)",
    "IELTS Academic reading (IELTS 17-19)",
    "selected periodicals only for additional breadth"
  ],
  "import_policy": {
    "runtime_model": "LOCAL_PRIVATE_IMPORT",
    "content_bytes_in_shared_repo": false,
    "preserve_source_locator": true,
    "preserve_source_kind_and_format": true,
    "allow_passage_only": true,
    "allow_source_native_questions_when_supported": true,
    "unsupported_question_forms": "FAIL_CLOSED",
    "never_invent_questions": true,
    "exposure_truth_owner": "private English material exposure ledger",
    "do_not_build_corpus_for_completeness": true
  },
  "pools": [
    {
      "id": "tpo-56-65",
      "kind": "TPO_READING",
      "range": "56-65",
      "priority": 1,
      "source_format": "TOEFL_LEGACY",
      "status": "IMPORT_WHEN_SELECTED",
      "default_role": "READING_GROWTH",
      "notes": "Primary academic-reading growth pool. Keep legacy TOEFL/TPO source identity. Useful later for TOEFL preparation, but do not apply current English-I Reading-A option strategy unless the task is actually English-I."
    },
    {
      "id": "ielts-17-19",
      "kind": "IELTS_READING",
      "range": "17-19",
      "priority": 2,
      "source_format": "IELTS_ACADEMIC",
      "status": "IMPORT_WHEN_SELECTED",
      "default_role": "READING_GROWTH",
      "notes": "Secondary authoritative reading-growth pool. Preserve IELTS-native task identity when source questions are imported; passage-only use is valid."
    },
    {
      "id": "periodicals",
      "kind": "PERIODICAL_READING",
      "range": "OPEN_ENDED",
      "priority": 3,
      "source_format": "ARTICLE",
      "status": "OPTIONAL_INCREMENTAL",
      "default_role": "READING_GROWTH",
      "notes": "Optional breadth after TPO/IELTS. Questionless reading remains questionless."
    }
  ],
  "exposure_policy": {
    "principle": "Source metadata is not learner exposure testimony.",
    "content_object_may_claim_private_exposure": false,
    "missing_private_record_means": "unknown",
    "ordinary_external_mock_share_material_identity": true,
    "recorded_exposure_cannot_be_erased_by_reimport": true
  },
  "cognition_boundary": {
    "shared_transferable_primitives": [
      "proposition representation",
      "reference and relation tracking",
      "discourse structure",
      "lexical access",
      "reading speed and stamina"
    ],
    "english1_reading_a_strategy_owner": "content/english/modules/reading-a.md",
    "external_source_question_semantics": "source-native only",
    "future_toefl_note": "A future TOEFL-prep layer may add TOEFL-native task semantics without changing English-I Reading-A logic."
  }
}
