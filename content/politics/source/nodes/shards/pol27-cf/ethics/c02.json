    ],
    "markdown_file": "政治资料库/sources/chengfeng/POL27-CF-ETHICS.md",
    "anchor": "POL27-CF-ETHICS-C02-K01-N01-TBL01",
    "volume_id": "POL27-CF-UPPER",
