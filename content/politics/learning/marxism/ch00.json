  "chapter_orientation": {
    "core_problem": "在进入哲学、政治经济学和科学社会主义之前，先要回答：马克思主义究竟是什么、为什么会产生，又为什么能够不断发展而不是停在19世纪？",
    "learner_thesis": "导论不是一串人物和著作名录。第一轮只建立三个位置：马克思主义在怎样的历史与思想条件中形成，它怎样在实践中发展，以及它作为完整理论体系具有怎样的基本特征和现实价值。",
    "reasoning_chain": [
      "先确定马克思主义的内涵和理论构成",
      "再把它的创立放回资本主义发展、工人运动和既有思想成果的历史条件中",
      "理解马克思主义不是一次完成的封闭体系，而是在实践和时代问题中继续发展",
      "最后用基本特征和当代价值回答：为什么今天仍然需要学习马克思主义"
    ],
    "attention_rule": "不要一上来背人物—著作—年份。先把‘为什么产生—形成了什么—为什么能发展—今天为什么仍有解释力’这条线搭起来。",
    "next_chapter_bridge": "导论确定了马克思主义这套理论的身份。第一章开始进入它的世界观和方法论基础：世界到底是什么。"
  },
