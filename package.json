{
  "name": "kianos",
  "private": true,
  "scripts": {
    "setup": "npm --prefix static-web install --no-audit --no-fund",
    "dev": "npm --prefix static-web run dev",
    "build": "npm --prefix static-web run build",
    "preview": "npm --prefix static-web run preview",
    "current:install": "bash static-web/scripts/install-current-macos.sh",
    "current:doctor": "node static-web/scripts/kianos-current-doctor.mjs",
    "current:open": "node static-web/scripts/kianos-current-open.mjs",
    "current:backup": "node static-web/scripts/kianos-current-backup.mjs",
    "current:restore": "node static-web/scripts/kianos-current-restore.mjs",
    "remote:snapshot": "python3 tools/kianos_remote_ops.py snapshot",
    "remote:packet": "python3 tools/kianos_remote_ops.py packet",
    "remote:verify": "python3 tools/kianos_remote_ops.py verify",
    "test:remote-ops": "python3 -m unittest tools/test_kianos_remote_ops.py",
    "repo:doctor": "python3 tools/kianos_repo_doctor.py",
    "test:repo-doctor": "python3 -m unittest tools/test_kianos_repo_doctor.py"
  }
}
